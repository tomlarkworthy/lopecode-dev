// %%
// An allowed act as the fields of its event. The service adds seq, key, by, origin, ray, at, prev, hash and sig.
issueEvent = (view, act, verdict) => {
  const i = issueAt(view.issues, act.id), base = { id: act.id, workflow: i ? i.workflow : verdict.workflow };
  const reason = act.reason || "", refs = act.refs || [];
  if (act.type === "policy") return { type: "policy", policy: act.policy, hashes: act.hashes, ...(act.reason ? { reason: act.reason } : {}) };
  if (act.type === "open") return { type: "opened", ...base, title: act.title, body: act.body || "", kind: act.kind, about: act.about, parent: act.parent || null, labels: act.labels || [], state: verdict.state };
  if (act.type === "comment") return { type: "commented", ...base, body: act.body };
  if (act.type === "label") return { type: "labelled", ...base, add: act.add || [], remove: act.remove || [] };
  if (act.type === "review") return { type: "reviewed", ...base, verdict: act.verdict, body: act.body || "", refs };
  if (act.type === "move") return { type: "moved", ...base, move: verdict.name, from: i.state, to: act.to, reason, refs };
  if (act.type === "swap") return { type: "swapped", ...base, swap: verdict.name, from: { workflow: i.workflow, state: i.state }, to: verdict.to, reason, ...(act.policy ? { policy: act.policy } : {}) };
  return act.remove != null ? { type: "narrowed", ...base, remove: act.remove, reason } : { type: "narrowed", ...base, move: act.move, guard: act.guard, reason };
}
// %%
// Should this event have been refused, by the view before it? null, or why. What issue.verify?guards=true asks of each event.
issueReplay = (view, e) => {
  const type = { opened: "open", commented: "comment", labelled: "label", reviewed: "review", moved: "move", swapped: "swap", narrowed: "narrow", policy: "policy" }[e.type];
  if (!type) return "no such type of event";
  const act = { ...e, type, ...(e.type === "swapped" ? { workflow: e.to.workflow, state: e.to.state } : {}) };
  const i = issueAt(view.issues, e.id);
  if (i && e.workflow !== i.workflow) return "judged under a workflow the issue was not on";
  const v = issueAllowed(view, e.by, act);
  if (!v.allow) return v.why;
  if (e.type === "opened" && (e.workflow !== v.workflow || e.state !== v.state)) return "opened in another workflow or state than its kind's";
  if (e.type === "moved" && (e.move !== v.name || e.from !== i.state)) return "names another move than the one allowed";
  if (e.type === "swapped" && (e.to.workflow !== v.to.workflow || e.to.state !== v.to.state)) return "lands elsewhere than the swap says";
  return null;
}
// %%
// One event against the one before it: its seq, prev, hash and signature. null, or which is wrong.
issueCheck = async (e, prev, seq, keys) => {
  const { hash, sig, ...rest } = e;
  if (e.seq !== seq) return "seq";
  if (e.prev !== prev) return "prev";
  if (hash !== (await sha256(issueCanon(rest)))) return "hash";
  return (await keys.verify(hash, sig)) ? null : "sig";
}
// %%
// A policy checked, as the act that installs it: every guard parses, every state and workflow named is there.
issuePolicyAct = async (policy) => {
  const bad = (m) => {
    throw Object.assign(new Error(m), { status: 400, code: "InvalidPolicy" });
  };
  const name = /^[a-z0-9][a-z0-9-]{0,39}$/, list = (v) => Array.isArray(v) && v.every((s) => typeof s === "string" && name.test(s));
  if (!policy || typeof policy !== "object" || !policy.workflows || typeof policy.workflows !== "object" || !policy.kinds || typeof policy.kinds !== "object") bad("policy: { workflows, kinds }");
  if (JSON.stringify(policy).length > issuesLimits.policy) bad(`policy: ${issuesLimits.policy} characters at most`);
  const names = Object.keys(policy.workflows);
  if (!names.length || names.length > 20 || !names.every((n) => name.test(n))) bad("workflows: 1 to 20, named a-z 0-9 -");
  for (const n of names) {
    const w = policy.workflows[n], at = `workflow ${n}: `;
    if (!w || !list(w.states) || !w.states.length) bad(at + "states");
    if (!w.states.includes(w.start)) bad(at + "start is not one of its states");
    if (!list(w.closed) || !w.closed.every((s) => w.states.includes(s))) bad(at + "closed: a list of its states");
    if (!Array.isArray(w.moves) || !Array.isArray(w.swaps)) bad(at + "moves and swaps are lists");
    const guard = (label, g) => {
      if (typeof g !== "string" || !g || g.length > 2000) bad(at + label + " needs a guard");
      try {
        checkedRule(at + label, g);
      } catch (e) {
        bad(e.message);
      }
    };
    for (const a of ["read", "open", "comment", "label", "review", "narrow"]) guard(a, w[a]);
    for (const m of w.moves) {
      if (!m || !name.test(m.name || "")) bad(at + "a move needs a name");
      if (!(m.from === "*" || [].concat(m.from).every((s) => w.states.includes(s))) || !w.states.includes(m.to)) bad(at + `the move ${m.name} names a state it does not have`);
      guard("the move " + m.name, m.guard);
    }
    for (const s of w.swaps) {
      if (!s || !name.test(s.name || "")) bad(at + "a swap needs a name");
      const target = s.to && issueAt(policy.workflows, s.to.workflow);
      if (!target || !Array.isArray(target.states) || !target.states.includes(s.to.state)) bad(at + `the swap ${s.name} names a workflow or state that is not there`);
      guard("the swap " + s.name, s.guard);
    }
  }
  for (const [k, n] of Object.entries(policy.kinds)) if (!name.test(k) || !issueAt(policy.workflows, n)) bad(`kinds: ${k} names no workflow`);
  const hashes = {};
  for (const n of names) hashes[n] = await sha256(issueCanon(policy.workflows[n]));
  return { type: "policy", policy, hashes };
}
// %%
// A request's body as an act, or a 400.
issueAct = (type, b) => {
  const L = issuesLimits;
  const bad = (m) => {
    throw Object.assign(new Error(m), { status: 400, code: "InvalidRequest" });
  };
  const text = (v, max, label, need) => {
    if (v == null || v === "") return need ? bad(label) : "";
    if (typeof v !== "string" || v.length > max) bad(`${label}: text, ${max} characters at most`);
    return v;
  };
  const name = (v, label, need) => {
    const s = text(v, 60, label, need);
    if (s && !/^[a-z0-9][a-z0-9-]*$/.test(s)) bad(label + ": a-z 0-9 -");
    return s;
  };
  const names = (v, label) => {
    if (v == null) return [];
    if (!Array.isArray(v) || v.length > L.labels) bad(label);
    return [...new Set(v.map((x) => name(x, label, true)))];
  };
  const refs = (v) => {
    if (v == null) return [];
    if (!Array.isArray(v) || v.length > L.refs) bad("refs");
    return v.map((r) => ({ kind: name(r && r.kind, "refs.kind", true), value: text(r && r.value, 500, "refs.value", true) }));
  };
  b = b && typeof b === "object" ? b : {};
  const id = name(b.id, "id", type !== "open"), reason = text(b.reason, L.reason, "reason");
  if (id.length > 40) bad("id: 40 characters at most");
  if (type === "open") {
    if (/^i\d+$/.test(id)) bad("id: i<number> is the service's to give");
    return { type, ...(id ? { id } : {}), title: text(b.title, L.title, "title", true), body: text(b.body, L.body, "body"), kind: name(b.kind, "kind", true), about: name(b.about ?? "brain", "about", true), parent: name(b.parent, "parent") || null, labels: names(b.labels, "labels") };
  }
  if (type === "comment") return { type, id, body: text(b.body, L.body, "body", true) };
  if (type === "label") {
    const add = names(b.add, "add"), remove = names(b.remove, "remove");
    return add.length + remove.length ? { type, id, add, remove } : bad("add or remove");
  }
  if (type === "review") return { type, id, verdict: L.verdicts.includes(b.verdict) ? b.verdict : bad("verdict: " + L.verdicts.join(", ")), body: text(b.body, L.body, "body"), refs: refs(b.refs) };
  if (type === "move") return { type, id, to: name(b.to, "to", true), reason, refs: refs(b.refs) };
  if (type === "swap") return b.swap ? { type, id, swap: name(b.swap, "swap", true), reason } : { type, id, workflow: text(b.workflow, 64, "workflow", true), state: name(b.state, "state", true), reason };
  if (b.remove != null) return Number.isInteger(b.remove) ? { type, id, remove: b.remove, reason } : bad("remove: the number of a guard");
  const guard = text(b.guard, 2000, "guard", true);
  try {
    checkedRule("guard", guard);
  } catch (e) {
    bad(e.message);
  }
  return { type, id, move: name(b.move, "move", true), guard, reason };
}
// %%
issuesApp = {
  const app = new hono.Hono();
  const NS = "/xrpc/com.lopecode.brain.issue.", S = issuesSql, L = issuesLimits, J = JSON.parse;
  const refuse = (status, code, message) => Object.assign(new Error(message), { status, code });
  let made = null, keys = null;
  const schema = () =>
    (made ||= (async () => {
      for (const s of issuesSchema) await sql.exec(s);
    })().catch((e) => {
      made = null;
      throw e;
    }));
  const signer = async () => {
    if (keys) return keys;
    const text = await secrets.ISSUES_SIGNING_KEY;
    if (!text) throw refuse(503, "NotConfigured", "the secret ISSUES_SIGNING_KEY is not set");
    return (keys = await issueKeys(text));
  };
  // Who the core says is calling, and who started the chain: copied into the event, since a log line lasts 7 days.
  // How long the page waits between polls: the setting syncMs, changed with config.set and no deploy.
  const wait = () => Math.max(1000, Number(config.syncMs ?? L.syncMs) || L.syncMs);
  const who = (c) => ({ by: callerFrom(c.req.raw.headers), origin: originFrom(c.req.raw.headers), ray: (c.req.header("x-brain-ray") || c.req.header("cf-ray") || "").slice(0, 64) });
  // The head, the policy with every workflow, and some issues, read in one transaction.
  const load = async (rows) => {
    await schema();
    const [head, meta, found] = await sql.batch([[S.head], [S.meta], rows]);
    const view = { ...issueView(), ...(head.rows[0] ? { seq: head.rows[0].seq, head: head.rows[0].hash } : {}) };
    for (const { k, v } of meta.rows) k === "policy" ? (view.policy = J(v)) : (view.workflows[k.slice(3)] = J(v));
    for (const r of found.rows) view.issues[J(r.issue).id] = J(r.issue);
    return view;
  };
  const metaRows = (view) => [[S.putMeta, "policy", JSON.stringify(view.policy)], ...Object.entries(view.workflows).map(([hash, w]) => [S.putMeta, "wf/" + hash, JSON.stringify(w)])];
  const issueRow = (i) => [S.putIssue, i.id, i.state, i.kind, i.about, i.parent, i.workflow, i.closed ? 1 : 0, i.updated_at, JSON.stringify(i)];
  // One event more. The insert is of seq = head + 1, the table's key: of two writers at one head one fails, reads the
  // head again and writes after the other. The view's row is written in the same transaction.
  // The act with its id, and the verdict that lets it through. A refusal is thrown.
  const judge = (view, by, given) => {
    const act = given.type === "open" && !given.id ? { ...given, id: "i" + (view.seq + 1) } : given, verdict = issueAllowed(view, by, act);
    if (!verdict.allow) throw refuse(verdict.missing ? 404 : 403, verdict.missing ? "NotFound" : "Refused", verdict.why);
    return [act, verdict];
  };
  const append = async (ctx, key, given) => {
    if (typeof key !== "string" || !key || key.length > L.key) throw refuse(400, "InvalidRequest", `key: text, ${L.key} characters at most`);
    const sign = await signer();
    for (let attempt = 0; ; attempt++) {
      const view = await load([S.near, given.id || "", given.parent || ""]);
      const kept = (await sql.exec(S.byKey, key)).rows[0];
      // A key kept: the first event again, to whoever wrote it. Another caller is told its place and no more.
      if (kept) return ((e) => ({ event: e, duplicate: true, mine: issueActor(e.by) === issueActor(ctx.by) }))(J(kept.event));
      // The default policy is written only into an empty record. A record with no policy in its view has lost the view.
      if (!view.policy && view.seq) throw refuse(503, "ViewLost", "the view has no policy: issue.rebuild makes it again from the record");
      if (!view.policy && given.type !== "policy") {
        // Judged first against the default as it would stand: a write it refuses leaves the record empty.
        const first = await issuePolicyAct(issuesDefaultPolicy);
        judge(issueApply(issueView(), { seq: 1, hash: "", type: "policy", policy: first.policy, hashes: first.hashes }), ctx.by, given);
        await append({ by: { caller: "worker:brain-x-issues", via: "" }, origin: ctx.origin, ray: ctx.ray }, "policy/default", first);
        continue;
      }
      const seq = view.seq + 1, [act, verdict] = judge(view, ctx.by, given);
      const e = { seq, key, ...issueEvent(view, act, verdict), by: ctx.by, origin: ctx.origin, ray: ctx.ray, at: Date.now(), prev: view.head };
      e.hash = await sha256(issueCanon(e));
      e.sig = await sign.sign(e.hash);
      issueApply(view, e);
      try {
        await sql.batch([[S.insert, seq, key, e.id || null, e.type, e.at, e.hash, JSON.stringify(e)], ...(e.type === "policy" ? metaRows(view) : [issueRow(view.issues[e.id])])]);
        return { event: e };
      } catch (err) {
        // Another writer took this seq, or this key: go round again. Anything else is an error.
        const head = (await sql.exec(S.head)).rows[0];
        if (attempt >= 5 || ((head ? head.seq : 0) < seq && !(await sql.exec(S.byKey, key)).rows[0])) throw err;
      }
    }
  };
  const run = (fn) => async (c) => {
    try {
      return c.json(await fn(c, c.req.method === "POST" ? (await c.req.json().catch(() => null)) || {} : c.req.query()));
    } catch (e) {
      if (e && e.status) return c.json({ error: e.code, message: e.message }, e.status);
      throw e;
    }
  };
  // Keys under policy/ are the service's own: the default policy's, and each swap of a migration. A caller who took
  // one ahead of an install would hold that issue out of it.
  const callerKey = (key) => (typeof key === "string" && key.startsWith("policy/") ? Promise.reject(refuse(400, "InvalidRequest", "key: policy/ is the service's own")) : key);
  for (const type of ["open", "comment", "label", "review", "move", "swap", "narrow"])
    app.post(NS + type, run(async (c, b) => {
      const r = await append(who(c), await callerKey(b && b.key), issueAct(type, b));
      return { id: r.event.id, seq: r.event.seq, ...(r.duplicate ? { duplicate: true } : {}), ...(r.duplicate && !r.mine ? {} : { event: r.event }) };
    }));
  app.post(NS + "install", run(async (c, b) => {
    const ctx = who(c);
    if (!issueCaller(ctx.by).present) throw refuse(403, "Refused", "the owner, present");
    const key = await callerKey(b.key);
    if (typeof key !== "string" || !key || key.length > L.key) throw refuse(400, "InvalidRequest", `key: text, ${L.key} characters at most`);
    await schema();
    // The key first, before anything else in the body is read: an install sent again is answered as the install it
    // was, whatever has changed since. With another policy in the body it is not that install.
    const again = async (e) => {
      if (e.type !== "policy") throw refuse(400, "InvalidRequest", "key: another event has this key");
      if (issueCanon(e.policy) !== issueCanon((await issuePolicyAct(b.policy)).policy)) throw refuse(400, "InvalidRequest", "key: another policy was installed with this key");
      return { seq: e.seq, hashes: e.hashes, moved: [], left: [], duplicate: true };
    };
    const kept = (await sql.exec(S.byKey, key)).rows[0];
    if (kept) return again(J(kept.event));
    // A migrate names the workflow it moves issues from by a hash the record keeps (issue.policy answers them).
    // Anything else would move nothing and say so to nobody.
    const was = await load([S.near, "", ""]), migrate = [];
    // The workflows are read from the view: one that is lost would have every hash refused as unknown. A lost view is
    // said before the policy is read, so the caller is told to rebuild, not that a policy is wrong.
    if (!was.policy && was.seq) throw refuse(503, "ViewLost", "the view has no policy: issue.rebuild makes it again from the record");
    if (typeof b.reason !== "string" || !b.reason.trim() || b.reason.length > L.reason) throw refuse(400, "InvalidRequest", `reason: text, 1 to ${L.reason} characters: who asked for the install and why`);
    const act = { ...(await issuePolicyAct(b.policy)), reason: b.reason };
    const plain = (v) => !!v && typeof v === "object" && !Array.isArray(v);
    if (b.migrate != null && !plain(b.migrate)) throw refuse(400, "InvalidRequest", "migrate: { HASH: { workflow, states } }");
    for (const [old, to] of Object.entries(b.migrate || {})) {
      if (!issueAt(was.workflows, old)) throw refuse(400, "InvalidRequest", `migrate ${old}: the record keeps no workflow of that hash`);
      if (!plain(to) || typeof to.workflow !== "string" || (to.states != null && !plain(to.states))) throw refuse(400, "InvalidRequest", `migrate ${old}: { workflow, states: { old: new } }`);
      const target = issueAt(act.policy.workflows, to.workflow);
      if (!target) throw refuse(400, "InvalidRequest", `migrate ${old}: the policy has no workflow ${to.workflow}`);
      for (const [from, state] of Object.entries(to.states || {})) {
        if (!was.workflows[old].states.includes(from)) throw refuse(400, "InvalidRequest", `migrate ${old}: the workflow it moves from has no state ${from}`);
        if (typeof state !== "string" || !state) throw refuse(400, "InvalidRequest", `migrate ${old}: states.${from} is the name of a state`);
        // Whether or not an issue is in `from` now: a mistyped state is not installed to wait for one.
        if (!target.states.includes(state)) throw refuse(400, "InvalidRequest", `migrate ${old}: ${to.workflow} has no state ${state}`);
      }
      migrate.push([old, to]);
    }
    // The open issues of each workflow a migrate names, and where each lands. `left`: null, and one that cannot land
    // is a 400; a list, and it is put there with why.
    const planned = async (left) => {
      const plan = [];
      for (const [old, to] of migrate) {
        const target = issueAt(act.policy.workflows, to.workflow);
        for (const row of (await sql.exec(S.onWorkflow, old)).rows) {
          const i = J(row.issue), state = issueAt(to.states, i.state) || i.state, why = target.states.includes(state) ? null : `${i.id} is ${i.state}, and ${to.workflow} has no state ${state}`;
          // Already where it would land (the workflow did not change, nor its state): no event for it.
          if (act.hashes[to.workflow] === old && state === i.state) continue;
          if (why && !left) throw refuse(400, "InvalidRequest", `migrate ${old}: ${why}`);
          why ? left.push({ id: i.id, why }) : plan.push({ id: i.id, from: { workflow: old, state: i.state }, workflow: act.hashes[to.workflow], state });
        }
      }
      return plan;
    };
    // Checked whole before the policy is written: a policy is not left installed with a migration that cannot land.
    await planned(null);
    const r = await append(ctx, key, act), moved = [], left = [];
    // Another install took the key between the look above and this write.
    if (r.duplicate) return again(r.event);
    // Read again now that the policy is written, so an issue opened on an old workflow meanwhile is moved too. Each
    // swap says where it takes its issue from: one closed or moved since is refused and left where it is.
    for (const m of await planned(left)) {
      const swap = await append(ctx, `policy/${r.event.seq}/${m.id}`, { type: "swap", id: m.id, from: m.from, workflow: m.workflow, state: m.state, reason: "policy " + r.event.seq, policy: r.event.seq }).catch((e) => (e && e.status ? { why: e.message } : Promise.reject(e)));
      swap.why || swap.duplicate ? left.push({ id: m.id, why: swap.why || "another event has the key of its swap" }) : moved.push(m.id);
    }
    return { seq: r.event.seq, hashes: r.event.hashes, moved, left };
  }));
  // What a caller is shown of an issue its workflow's read guard refuses.
  const shown = (view, by, i) => (issueAllowed(view, by, { type: "read", id: i.id }).allow ? i : { id: i.id, kind: i.kind, state: i.state, closed: i.closed, parent: i.parent, hidden: true });
  const current = (view) => (view.policy ? Object.fromEntries(Object.values(view.policy.names).map((h) => [h, view.workflows[h]])) : {});
  app.get(NS + "snapshot", run(async (c) => {
    const view = await load([S.all]), { by } = who(c);
    return { seq: view.seq, head: view.head, wait: wait(), policy: view.policy, workflows: view.workflows, issues: Object.values(view.issues).map((i) => shown(view, by, i)).map((i) => (i.closed && !i.hidden ? { ...i, body: undefined, bodyLeftOut: true } : i)) };
  }));
  app.get(NS + "sync", run(async (c, q) => {
    await schema();
    const after = Math.max(0, Number(q.after) || 0), events = (await sql.exec(S.after, after, Math.min(L.page, Math.max(1, Number(q.limit) || L.syncPage)))).rows.map((r) => J(r.event));
    const view = await load(events.length ? [S.all] : [S.near, "", ""]), { by } = who(c);
    // A copy from another record, or from past this one's head: the page starts again from a snapshot.
    const at = !q.head || !after || after > view.seq ? "" : after === view.seq ? view.head : (((await sql.exec(S.one, after)).rows[0] || {}).event || "");
    if (after > view.seq || (q.head && after && (at === view.head ? at : at && J(at).hash) !== q.head)) return { seq: view.seq, wait: wait(), reset: true, events: [] };
    const seen = (e) => e.type === "policy" || !issueAt(view.issues, e.id) || !shown(view, by, view.issues[e.id]).hidden;
    return { seq: view.seq, wait: wait(), events: events.map((e) => (seen(e) ? e : { seq: e.seq, id: e.id, type: e.type, at: e.at, hash: e.hash, hidden: true, issue: shown(view, by, view.issues[e.id]) })) };
  }));
  app.get(NS + "get", run(async (c, q) => {
    const view = await load([S.near, String(q.id || ""), ""]), { by } = who(c), i = issueAt(view.issues, q.id);
    if (!i) throw refuse(404, "NotFound", "no such issue");
    const issue = shown(view, by, i);
    if (issue.hidden) return { issue, children: [], events: [] };
    return { issue, children: Object.values(view.issues).filter((k) => k.parent === i.id).map((k) => shown(view, by, k)).map((k) => (k.hidden ? k : { id: k.id, title: k.title, kind: k.kind, state: k.state, closed: k.closed })), events: (await sql.exec(S.of, i.id)).rows.map((r) => J(r.event)) };
  }));
  app.get(NS + "list", run(async (c, q) => {
    const view = await load([S.all]), { by } = who(c);
    const pass = (i) => (!q.state || i.state === q.state) && (!q.kind || i.kind === q.kind) && (!q.about || i.about === q.about) && (!q.parent || i.parent === q.parent) && (!q.label || (i.labels || []).includes(q.label));
    // What a caller may not read is matched by its state, kind and parent only: a label would say what it is.
    return { issues: Object.values(view.issues).map((i) => shown(view, by, i)).filter(pass).sort((a, b) => (b.updated_at || 0) - (a.updated_at || 0)).slice(0, Math.min(L.page, Math.max(1, Number(q.limit) || 100))).map((i) => (i.hidden ? i : { ...i, body: undefined })) };
  }));
  app.get(NS + "policy", run(async (c, q) => {
    const view = await load([S.near, "", ""]);
    if (q.hash) return issueAt(view.workflows, q.hash) ? { hash: q.hash, workflow: view.workflows[q.hash] } : Promise.reject(refuse(404, "NotFound", "no such workflow"));
    return { policy: view.policy, workflows: current(view) };
  }));
  app.get(NS + "key", run(async () => ({ alg: "Ed25519", key: (await signer()).public })));
  // Every event in order, a page at a time.
  const walk = async (after, each) => {
    for (;;) {
      const rows = (await sql.exec(S.after, after, L.page)).rows;
      if (!rows.length) return;
      for (const r of rows) {
        const e = J(r.event), stop = await each(e);
        if (stop) return stop;
        after = e.seq;
      }
    }
  };
  app.get(NS + "verify", run(async (c, q) => {
    await schema();
    const sign = await signer(), guards = q.guards === "true", view = issueView();
    let seq = guards ? 0 : Math.max(0, Number(q.after) || 0), prev = "", checked = 0;
    if (seq) {
      const at = (await sql.exec(S.one, seq)).rows[0];
      if (!at) throw refuse(404, "NotFound", "no event " + seq);
      prev = J(at.event).hash;
    }
    const bad = await walk(seq, async (e) => {
      const chain = await issueCheck(e, prev, seq + 1, sign);
      if (chain) return { ok: false, seq: seq + 1, why: chain, checked };
      if (guards) {
        const why = issueReplay(view, e) || (e.type === "policy" && issueCanon((await issuePolicyAct(e.policy).catch(() => ({}))).hashes) !== issueCanon(e.hashes) ? "the policy's hashes are not its workflows'" : null);
        if (why) return { ok: false, seq: e.seq, why, checked };
        issueApply(view, e);
      }
      prev = e.hash;
      seq = e.seq;
      checked++;
    });
    return bad || { ok: true, seq, head: prev, checked, guards };
  }));
  app.post(NS + "rebuild", run(async (c) => {
    if (!issueCaller(who(c).by).present) throw refuse(403, "Refused", "the owner, present");
    await schema();
    const view = issueView();
    await walk(0, async (e) => void issueApply(view, e));
    const rows = [...(view.policy ? metaRows(view) : []), ...Object.values(view.issues).map(issueRow)];
    await sql.batch([[S.clearView], [S.clearMeta], ...rows.slice(0, 300)]);
    for (let at = 300; at < rows.length; at += 300) await sql.batch(rows.slice(at, at + 300));
    return { seq: view.seq, issues: Object.keys(view.issues).length };
  }));
  return app;
}
// %%
// The page's copy of the view between visits, one for each Brain's address. A browser may refuse it; the panel then
// starts from a snapshot. A kept copy is used only while its head is still an event of the record (issue.sync's reset).
issuesStore = (brain = "") => ((name) => ({
  name,
  get: () => {
    try {
      return JSON.parse(localStorage.getItem(name));
    } catch (e) {
      return null;
    }
  },
  set: (view) => {
    try {
      localStorage.setItem(name, JSON.stringify(view));
    } catch (e) {}
  }
}))("brain_issues " + brain)
// %%
// The issues, from a copy the page keeps: one snapshot, then the events after it every few seconds. A list and its
// filters are answered from the copy. A write is applied to the copy before it is sent, and withdrawn if refused.
issuesPanel = ({ client, owner = false, by = { caller: "owner", via: "session" }, invalidation, store = issuesStore(String((client && client.base) || "")), every = null } = {}) => {
  const muted = "color:var(--theme-foreground-muted)";
  if (!client || !owner) return htl.html`<i style=${muted}>Sign in as the owner to see the issues.</i>`;
  let base = store.get() || issueView(), pending = [], open = null, wait = issuesLimits.syncMs;
  const detail = new Map();
  const note = htl.html`<span style=${muted}></span>`, list = htl.html`<div></div>`, one = htl.html`<div></div>`;
  const now = () => pending.reduce((v, e) => issueApply(v, e), structuredClone(base));
  // A select whose choices come from the copy: made again when they change, keeping what was chosen.
  const chooser = (label, onInput) => {
    const slot = htl.html`<span></span>`;
    let input = null, have = null;
    const set = (values) => {
      if (have === values.join("\n")) return;
      const was = input ? input.value : values[0];
      have = values.join("\n");
      input = Inputs.select(values, { label, value: values.includes(was) ? was : values[0] });
      if (onInput) input.addEventListener("input", onInput);
      slot.replaceChildren(input);
    };
    return { slot, set, get value() { return input ? input.value : ""; } };
  };
  const state = chooser("State", () => draw()), kind = chooser("Kind", () => draw()), newKind = chooser("Kind"), find = Inputs.text({ label: "Find", placeholder: "title, about or label" });
  const title = Inputs.text({ label: "Title" }), body = Inputs.textarea({ label: "Body", rows: 3 }), about = Inputs.text({ label: "About", value: "brain" }), parent = Inputs.text({ label: "Parent" });
  const snapshot = async () => {
    const s = await client.query("issue.snapshot");
    wait = s.wait || wait;
    base = { seq: s.seq, head: s.head, policy: s.policy, workflows: s.workflows, issues: Object.fromEntries(s.issues.map((i) => [i.id, i])) };
  };
  const sync = async () => {
    const fresh = !base.policy;
    if (fresh) await snapshot();
    const r = await client.query("issue.sync", { after: base.seq, head: base.head, limit: issuesLimits.syncPage });
    wait = r.wait || wait;
    if (r.reset) await snapshot();
    for (const e of r.events) if (e.seq > base.seq) e.hidden ? Object.assign(base, { seq: e.seq, head: e.hash, issues: { ...base.issues, [e.id]: e.issue } }) : issueApply(base, e);
    store.set(base);
    if (fresh || r.reset || r.events.length) draw();
    return r.events.length;
  };
  // act: what issueAllowed judges. sent: the body of the call.
  const send = async (method, act, sent) => {
    const key = crypto.randomUUID(), view = now(), verdict = issueAllowed(view, by, act);
    const local = verdict.allow ? { ...issueEvent(view, act, verdict), seq: view.seq, hash: view.head, key, by, at: Date.now(), pending: true } : null;
    note.textContent = "";
    if (local) pending.push(local), draw();
    try {
      const r = await client.procedure("issue." + method, { ...sent, key });
      pending = pending.filter((e) => e !== local);
      if (r.event && r.event.seq === base.seq + 1) issueApply(base, r.event), store.set(base);
      else await sync();
      detail.delete(act.id);
    } catch (e) {
      pending = pending.filter((x) => x !== local);
      note.textContent = `issue.${method} was refused: ${e.message}`;
    }
    draw();
  };
  const when = (ms) => new Date(ms).toLocaleString();
  const said = (e) => (e.type === "moved" ? `${e.from} → ${e.to}${e.reason ? ": " + e.reason : ""}` : e.type === "swapped" ? `to ${e.to.state}${e.swap ? " by " + e.swap : ""}` : e.type === "reviewed" ? `${e.verdict}${e.body ? ": " + e.body : ""}` : e.type === "labelled" ? [...(e.add || []).map((l) => "+" + l), ...(e.remove || []).map((l) => "-" + l)].join(" ") : e.type === "narrowed" ? (e.remove != null ? "removed guard " + e.remove : `${e.move}: ${e.guard}`) : e.type === "opened" ? e.title : e.body || "");
  const refsOf = (text) => text.split(",").map((s) => s.trim()).filter(Boolean).map((s) => (/^[a-z]+:\/\//.test(s) || !s.includes(":") ? { kind: "url", value: s } : { kind: s.slice(0, s.indexOf(":")), value: s.slice(s.indexOf(":") + 1) }));
  // The open issue is drawn again only when it, its children or its timeline changed: what is being typed is kept.
  let drawn = "";
  const drawOne = () => {
    const view = now(), i = open && view.issues[open];
    const kids = i ? Object.values(view.issues).filter((k) => k.parent === i.id) : [];
    const key = i ? [i.id, i.seq, i.state, i.hidden, (detail.get(i.id) || {}).seq, pending.filter((e) => e.id === i.id).length, ...kids.map((k) => k.id + k.state)].join("|") : "";
    if (key === drawn) return;
    drawn = key;
    if (!i) return one.replaceChildren();
    if (i.hidden) return one.replaceChildren(htl.html`<i style=${muted}>${i.id} is not shown to this caller.</i>`);
    const wf = view.workflows[i.workflow] || { moves: [], swaps: [] }, got = detail.get(i.id);
    if (!got || got.seq !== i.seq) client.query("issue.get", { id: i.id }).then((r) => (detail.set(i.id, { seq: (view.issues[i.id] || i).seq, ...r }), open === i.id && drawOne())).catch(() => null);
    const events = [...((got && got.events) || []), ...pending.filter((e) => e.id === i.id)];
    const reason = Inputs.text({ label: "Reason" }), refs = Inputs.text({ label: "Refs", placeholder: "commit:abc, deploy:brain-x-a@hash" }), comment = Inputs.textarea({ label: "Comment", rows: 2 }), label = Inputs.text({ label: "Label" });
    const verdict = Inputs.select(issuesLimits.verdicts, { label: "Review" }), acts = htl.html`<div style="display:flex;gap:6px;flex-wrap:wrap"></div>`;
    const buttons = () => {
      const moves = [...new Set(wf.moves.filter((m) => m.from === "*" || [].concat(m.from).includes(i.state)).map((m) => m.to))].map((to) => ({ text: to, act: { type: "move", id: i.id, to, reason: reason.value, refs: refsOf(refs.value) }, call: ["move", { id: i.id, to, reason: reason.value, refs: refsOf(refs.value) }] }));
      const swaps = wf.swaps.map((s) => ({ text: "swap: " + s.name, act: { type: "swap", id: i.id, swap: s.name, reason: reason.value }, call: ["swap", { id: i.id, swap: s.name, reason: reason.value }] }));
      acts.replaceChildren(...[...moves, ...swaps].map((b) => {
        const v = issueAllowed(now(), by, b.act);
        return htl.html`<button disabled=${!v.allow} title=${v.allow ? "" : v.why} onclick=${() => send(b.call[0], b.act, b.call[1])}>${b.text}</button>`;
      }));
    };
    // One for each label: issue.label with remove. Disabled where the label guard refuses, as a move's button is.
    const unlabel = (l) => {
      const act = { type: "label", id: i.id, remove: [l] }, v = issueAllowed(view, by, act);
      return Object.assign(htl.html`<button data-remove=${l} disabled=${!v.allow} style="margin-left:2px;padding:0 4px" onclick=${() => send("label", act, { id: i.id, remove: [l] })}>×</button>`, { title: v.allow ? "Remove the label " + l : v.why });
    };
    reason.addEventListener("input", buttons);
    refs.addEventListener("input", buttons);
    buttons();
    one.replaceChildren(htl.html`<div style="border-top:1px solid var(--theme-foreground-faintest);margin-top:12px;padding-top:8px">
      <b>${i.title}</b> <code>${i.id}</code> <span style=${muted}>${i.state} · ${i.kind} · ${i.about}${i.labels.map((l) => htl.html` · ${l}${unlabel(l)}`)}${i.parent ? " · child of " + i.parent : ""}</span>
      <div style="white-space:pre-wrap;margin:6px 0">${(got && got.issue && got.issue.body) || i.body || ""}</div>
      ${kids.length ? htl.html`<div>${kids.map((k) => htl.html`<div><a href="#" onclick=${(ev) => (ev.preventDefault(), (open = k.id), drawOne())}>${k.id}</a> ${k.title || ""} <span style=${muted}>${k.state}</span></div>`)}</div>` : ""}
      <div style="margin:6px 0">${events.map((e) => htl.html`<div style=${e.pending ? muted : ""}><span style=${muted}>${when(e.at)} ${e.by.holder || e.by.caller}</span> <b>${e.type}</b> ${said(e)}${(e.refs || []).map((r) => ` [${r.kind}:${r.value}]`).join("")}</div>`)}</div>
      ${reason}${refs}${acts}
      <div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap;margin-top:6px">${verdict}${Inputs.button("Review", { reduce: () => send("review", { type: "review", id: i.id, verdict: verdict.value, body: comment.value, refs: refsOf(refs.value) }, { id: i.id, verdict: verdict.value, body: comment.value, refs: refsOf(refs.value) }) })}</div>
      ${comment}${Inputs.button("Comment", { reduce: () => comment.value.trim() && send("comment", { type: "comment", id: i.id, body: comment.value }, { id: i.id, body: comment.value }) })}
      <div style="display:flex;gap:8px;align-items:end;flex-wrap:wrap">${label}${Inputs.button("Add label", { reduce: () => label.value.trim() && send("label", { type: "label", id: i.id, add: [label.value.trim()] }, { id: i.id, add: [label.value.trim()] }) })}</div>
    </div>`);
  };
  const draw = () => {
    const view = now(), all = Object.values(view.issues);
    state.set(["", ...new Set(all.map((i) => i.state))]);
    kind.set(["", ...new Set(all.map((i) => i.kind))]);
    newKind.set(Object.keys((view.policy && view.policy.kinds) || { task: 1 }));
    const q = find.value.trim().toLowerCase();
    const rows = all
      .filter((i) => (!state.value || i.state === state.value) && (!kind.value || i.kind === kind.value) && (!q || `${i.title || ""} ${i.about || ""} ${(i.labels || []).join(" ")} ${i.id}`.toLowerCase().includes(q)))
      .sort((a, b) => (b.updated_at || 0) - (a.updated_at || 0))
      .map((i) => ({ id: i.id, title: i.hidden ? "(not shown)" : i.title, state: i.state, kind: i.kind, about: i.about || "", labels: (i.labels || []).join(", "), parent: i.parent || "", changed: i.updated_at ? new Date(i.updated_at) : null }));
    const table = Inputs.table(rows, { multiple: false, layout: "auto", format: { changed: (d) => (d ? d.toLocaleString() : "") } });
    table.addEventListener("input", () => ((open = table.value ? table.value.id : null), drawOne()));
    list.replaceChildren(rows.length ? table : htl.html`<i style=${muted}>No issues${all.length ? " match" : ""}.</i>`);
    if (!note.textContent.includes("refused")) note.textContent = `${all.length} issues at event ${view.seq}${pending.length ? `, ${pending.length} being sent` : ""}.`;
    root.value = view;
    drawOne();
    // A cell that reads issuesView (the value) runs again: the copy changed, whoever changed it.
    root.dispatchEvent(new Event("input"));
  };
  find.addEventListener("input", () => draw());
  const create = () => {
    if (!title.value.trim()) return null;
    const id = "n" + crypto.randomUUID().slice(0, 8), act = { type: "open", id, title: title.value.trim(), body: body.value, kind: newKind.value, about: about.value.trim() || "brain", parent: parent.value.trim() || null, labels: [] };
    const sent = send("open", act, act);
    open = id;
    title.value = body.value = "";
    return sent;
  };
  const root = htl.html`<div>
    <div style="display:flex;gap:12px;flex-wrap:wrap">${state.slot}${kind.slot}${find}</div>
    ${list}${one}
    <details style="margin-top:12px"><summary>New issue</summary>${title}${body}${newKind.slot}${about}${parent}${Inputs.button("Open", { reduce: () => void create() })}</details>
    <div style="display:flex;gap:8px;margin-top:8px;align-items:center">${Inputs.button("Refresh", { reduce: () => sync().catch((e) => (note.textContent = "issue.sync failed: " + e.message)) })}${note}</div>
  </div>`;
  Object.assign(root, { value: base, send, sync, refsOf, show: (id) => ((open = id), drawOne()), form: { title, kind: newKind, open: create }, filters: { state, kind } });
  draw();
  const tick = () => (typeof document === "undefined" || document.visibilityState === "visible") && sync().catch((e) => (note.textContent = "issue.sync failed: " + e.message));
  // The service says how long to wait (its setting syncMs); `every` is a test's own.
  let timer = null, over = false;
  const loop = async () => {
    await tick();
    if (!over) timer = setTimeout(loop, every ?? wait);
  };
  loop();
  if (invalidation) invalidation.then(() => ((over = true), clearTimeout(timer)));
  return root;
}
// %%
md`## Tests

No SQL engine runs in a page. \`issuesFakeSql\` answers for the statements of \`issuesSql\` from three maps, and refuses any other statement. Its insert fails on a \`seq\` or a \`key\` that is kept, as the table's key and its unique index do.`
// %%
issuesFakeSql = () => {
  const events = [], view = new Map(), meta = new Map(), S = issuesSql, hooks = [];
  const row = (rows, changes = 0) => ({ rows, changes });
  const run = async (statement, a) => {
    if (issuesSchema.includes(statement)) return row([]);
    if (statement === S.head) return row(events.length ? [{ seq: events.at(-1).seq, hash: events.at(-1).hash }] : []);
    if (statement === S.byKey) return row(events.filter((e) => e.key === a[0]).map((e) => ({ event: e.event })));
    if (statement === S.insert) {
      // A test's hook stands for another writer that gets in first.
      if (hooks.length) await hooks.shift()();
      if (events.some((e) => e.seq === a[0])) throw new Error("UNIQUE constraint failed: issues_events.seq");
      if (events.some((e) => e.key === a[1])) throw new Error("UNIQUE constraint failed: issues_events.key");
      events.push({ seq: a[0], key: a[1], id: a[2], type: a[3], at: a[4], hash: a[5], event: a[6] });
      return row([], 1);
    }
    if (statement === S.after) return row(events.filter((e) => e.seq > a[0]).slice(0, a[1]).map((e) => ({ event: e.event })));
    if (statement === S.of) return row(events.filter((e) => e.id === a[0]).map((e) => ({ event: e.event })));
    if (statement === S.one) return row(events.filter((e) => e.seq === a[0]).map((e) => ({ event: e.event })));
    if (statement === S.meta) return row([...meta].map(([k, v]) => ({ k, v })));
    if (statement === S.putMeta) return meta.set(a[0], a[1]), row([], 1);
    if (statement === S.near) return row([...view.values()].filter((r) => r.id === a[0] || r.parent === a[0] || r.id === a[1] || (a[1] && r.parent === a[1])).map((r) => ({ issue: r.issue })));
    if (statement === S.all) return row([...view.values()].map((r) => ({ issue: r.issue })));
    if (statement === S.putIssue) return view.set(a[0], { id: a[0], parent: a[4], workflow: a[5], closed: a[6], issue: a[8] }), row([], 1);
    if (statement === S.onWorkflow) return row([...view.values()].filter((r) => r.workflow === a[0] && !r.closed).map((r) => ({ issue: r.issue })));
    if (statement === S.clearView) return view.clear(), row([]);
    if (statement === S.clearMeta) return meta.clear(), row([]);
    throw new Error("issuesFakeSql: " + statement);
  };
  return { run, events, view, meta, hooks };
}
// %%
issuesRig = async () => {
  const db = issuesFakeSql();
  const pair = await crypto.subtle.generateKey({ name: "Ed25519" }, true, ["sign", "verify"]);
  const jwk = JSON.stringify(await crypto.subtle.exportKey("jwk", pair.privateKey)), keys = await issueKeys(jwk);
  const sim = await simulate(issues_service, { sql: db.run, stored: { ISSUES_SIGNING_KEY: jwk } });
  const X = "/xrpc/com.lopecode.brain.issue.";
  let n = 0;
  const as = (who, via = "", more = {}) => async (path, body) => {
    const r = await sim.fetch("https://issues.internal" + X + path, {
      method: body === undefined ? "GET" : "POST",
      headers: { "x-brain-caller": who, "x-brain-via": via, ...more, ...(body === undefined ? {} : { "content-type": "application/json" }) },
      body: body === undefined ? undefined : JSON.stringify({ key: "k" + ++n, ...(path === "install" ? { reason: "a test" } : {}), ...body })
    });
    return { status: r.status, data: await r.json() };
  };
  // An event a holder of the key and the database could write past the service: chained and signed, judged by nobody.
  const forge = async (fields, by = { caller: "token:a", via: "" }) => {
    const head = db.events.at(-1), e = { seq: head.seq + 1, key: "forged" + ++n, ...fields, by, origin: by, ray: "", at: Date.now(), prev: head.hash };
    e.hash = await sha256(issueCanon(e));
    e.sig = await keys.sign(e.hash);
    db.events.push({ seq: e.seq, key: e.key, id: e.id, type: e.type, at: e.at, hash: e.hash, event: JSON.stringify(e) });
    return e;
  };
  const rig = { db, sim, keys, as, forge, owner: as("owner", "session"), a: as("token:a"), b: as("token:b"), worker: as("worker:brain-x-echo"), member: as("did:plc:other", "session") };
  // An issue taken to in-review: opened and made ready by the owner, implemented by token a.
  rig.inReview = async (id, more = {}) => {
    await rig.owner("open", { id, title: id, kind: "task", ...more });
    await rig.owner("move", { id, to: "triaged", reason: "real" });
    await rig.owner("move", { id, to: "ready" });
    await rig.a("move", { id, to: "in-progress" });
    return rig.a("move", { id, to: "in-review", refs: [{ kind: "commit", value: "abc" }] });
  };
  return rig;
}
// %%
test_issues_chain_is_signed_and_a_break_is_found = {
  const rig = await issuesRig();
  const opened = (await rig.owner("open", { title: "First", kind: "task" })).data;
  await rig.owner("comment", { id: opened.id, body: "one" });
  await rig.a("comment", { id: opened.id, body: "two" });
  // Event 1 is the default policy, written by the Worker before the first write.
  const events = rig.db.events.map((e) => JSON.parse(e.event));
  expect(events.map((e) => [e.seq, e.type, e.by.caller])).toEqual([[1, "policy", "worker:brain-x-issues"], [2, "opened", "owner"], [3, "commented", "owner"], [4, "commented", "token:a"]]);
  expect(opened).toMatchObject({ id: "i2", seq: 2 });
  expect(events.map((e) => e.prev)).toEqual(["", ...events.slice(0, 3).map((e) => e.hash)]);
  expect((await rig.owner("verify")).data).toEqual({ ok: true, seq: 4, head: events[3].hash, checked: 4, guards: false });
  expect((await rig.owner("verify?after=2")).data).toMatchObject({ ok: true, checked: 2 });
  // The public key alone checks a signature.
  const pub = await issueKeys((await rig.member("key")).data.key);
  expect([await pub.verify(events[1].hash, events[1].sig), await pub.verify(events[1].hash, events[2].sig)]).toEqual([true, false]);
  // A changed body: its hash no longer matches. A removed event: the next one's prev does not.
  const kept = rig.db.events[2].event;
  rig.db.events[2].event = kept.replace('"one"', '"ONE"');
  expect((await rig.owner("verify")).data).toMatchObject({ ok: false, seq: 3, why: "hash" });
  rig.db.events[2].event = kept;
  rig.db.events.splice(2, 1);
  expect((await rig.owner("verify")).data).toMatchObject({ ok: false, seq: 3, why: "seq" });
  return "4 events; a changed one and a removed one are found";
}
// %%
test_issues_a_key_writes_once_and_two_writers_make_one_chain = {
  const rig = await issuesRig();
  const first = (await rig.owner("open", { key: "same", title: "Once", kind: "task", id: "once" })).data;
  const again = (await rig.owner("open", { key: "same", title: "Once, retried", kind: "task", id: "once" })).data;
  expect([first.seq, again.seq, again.duplicate, again.event.title]).toEqual([2, 2, true, "Once"]);
  expect((await rig.owner("open", { title: "Taken", kind: "task", id: "once" })).data.message).toBe("an issue has this id");
  // Another caller with the same key is told the event's place and not the event.
  expect((await rig.a("comment", { key: "same", id: "anything", body: "x" })).data).toEqual({ id: "once", seq: 2, duplicate: true });
  // Another writer takes seq 3 between this write's read of the head and its insert.
  rig.db.hooks.push(() => rig.forge({ id: "once", type: "commented", workflow: first.event.workflow, body: "got in first" }));
  const late = (await rig.owner("comment", { id: "once", body: "second" })).data;
  expect(late.seq).toBe(4);
  expect(late.event.prev).toBe(JSON.parse(rig.db.events[2].event).hash);
  // Two at once.
  const both = await Promise.all([rig.a("comment", { id: "once", body: "x" }), rig.b("comment", { id: "once", body: "y" })]);
  expect(both.map((r) => r.data.seq).sort((a, b) => a - b)).toEqual([5, 6]);
  expect((await rig.owner("verify")).data).toMatchObject({ ok: true, seq: 6, checked: 6 });
  expect((await rig.owner("comment", { id: "once" })).status).toBe(400);
  expect((await rig.owner("comment", { key: "", id: "once", body: "x" })).status).toBe(400);
  expect((await rig.member("comment", { id: "nope", body: "x" })).status).toBe(404);
  return "one event for one key; a write that lost its seq is written after the winner";
}
// %%
test_issues_default_policy_review_approval_and_children = {
  const rig = await issuesRig(), ref = [{ kind: "commit", value: "abc" }];
  await rig.owner("open", { id: "t1", title: "Task", kind: "task" });
  // Triage needs a reason; a Worker may not triage; an implementer needs a ref to submit.
  expect((await rig.owner("move", { id: "t1", to: "triaged" })).data).toMatchObject({ error: "Refused", message: "the guard of triage refuses" });
  expect((await rig.worker("move", { id: "t1", to: "triaged", reason: "real" })).status).toBe(403);
  expect((await rig.owner("move", { id: "t1", to: "done" })).data.message).toBe("no move from open to done");
  await rig.owner("move", { id: "t1", to: "triaged", reason: "real" });
  await rig.owner("move", { id: "t1", to: "ready" });
  await rig.a("move", { id: "t1", to: "in-progress" });
  expect((await rig.a("move", { id: "t1", to: "in-review" })).status).toBe(403);
  expect((await rig.b("move", { id: "t1", to: "in-review", refs: ref })).status).toBe(403);
  expect((await rig.a("move", { id: "t1", to: "in-review", refs: ref })).data.event).toMatchObject({ move: "submit", from: "in-progress", to: "in-review" });
  // The implementer neither reviews nor passes. Without a passing review nobody passes.
  expect((await rig.a("review", { id: "t1", verdict: "pass" })).data.message).toBe("the workflow's review guard refuses");
  expect((await rig.b("move", { id: "t1", to: "done" })).status).toBe(403);
  await rig.b("review", { id: "t1", verdict: "changes", body: "no test" });
  expect((await rig.b("move", { id: "t1", to: "done" })).status).toBe(403);
  // Sent back, the implementer is still token a, and the reviews start again.
  await rig.b("move", { id: "t1", to: "in-progress" });
  expect((await rig.b("move", { id: "t1", to: "in-review", refs: ref })).status).toBe(403);
  await rig.a("move", { id: "t1", to: "in-review", refs: ref });
  expect((await rig.b("move", { id: "t1", to: "done" })).status).toBe(403);
  await rig.b("review", { id: "t1", verdict: "pass" });
  expect((await rig.a("move", { id: "t1", to: "done" })).status).toBe(403);
  expect((await rig.b("move", { id: "t1", to: "done" })).data.event.move).toBe("pass");
  // Revert is the owner present, with a reason and a ref. A token of the owner is not present.
  expect((await rig.a("move", { id: "t1", to: "reverted", reason: "broke", refs: ref })).status).toBe(403);
  expect((await rig.as("owner", "delegation:d1", { "x-brain-holder": "secret:laptop" })("move", { id: "t1", to: "reverted", reason: "broke", refs: ref })).status).toBe(403);
  expect((await rig.as("owner", "session", { "x-brain-tab": "0" })("move", { id: "t1", to: "reverted", reason: "broke", refs: ref })).status).toBe(403);
  expect((await rig.owner("move", { id: "t1", to: "reverted", reason: "broke", refs: ref })).status).toBe(200);
  // Two tokens are two delegations of the owner, with one holder: two actors. One of them twice is one.
  const d1 = rig.as("owner", "delegation:d1", { "x-brain-holder": "secret", "x-brain-tab": "0" }), d2 = rig.as("owner", "delegation:d2", { "x-brain-holder": "secret", "x-brain-tab": "0" });
  await rig.owner("open", { id: "t3", title: "By tokens", kind: "task" });
  await d1("move", { id: "t3", to: "triaged", reason: "real" });
  await d1("move", { id: "t3", to: "ready" });
  await d1("move", { id: "t3", to: "in-progress" });
  await d1("move", { id: "t3", to: "in-review", refs: ref });
  expect((await d1("review", { id: "t3", verdict: "pass" })).status).toBe(403);
  expect((await d2("review", { id: "t3", verdict: "pass" })).status).toBe(200);
  expect((await d2("move", { id: "t3", to: "done" })).data.event).toMatchObject({ move: "pass", by: { caller: "owner", via: "delegation:d2", holder: "secret", tab: false } });
  // Major: a pass leads to awaiting-approval, and only the owner present approves.
  await rig.inReview("t2", { labels: ["major"] });
  await rig.b("review", { id: "t2", verdict: "pass" });
  expect((await rig.b("move", { id: "t2", to: "done" })).status).toBe(403);
  await rig.b("move", { id: "t2", to: "awaiting-approval" });
  expect((await rig.b("move", { id: "t2", to: "done" })).status).toBe(403);
  expect((await rig.owner("move", { id: "t2", to: "done" })).data.event.move).toBe("approve");
  // Taking major off is the owner present: a token cannot take the approval away during review.
  await rig.inReview("t4", { labels: ["major", "ui"] });
  expect((await rig.a("label", { id: "t4", remove: ["major"] })).data.message).toBe("the workflow's label guard refuses");
  expect((await rig.a("label", { id: "t4", remove: ["ui"], add: ["api"] })).status).toBe(200);
  await rig.b("review", { id: "t4", verdict: "pass" });
  expect((await rig.b("move", { id: "t4", to: "done" })).status).toBe(403);
  expect((await rig.owner("label", { id: "t4", remove: ["major"] })).status).toBe(200);
  // A block stands beside a pass, until the work is sent back and submitted again.
  await rig.owner("review", { id: "t4", verdict: "block", body: "leaks" });
  expect((await rig.b("move", { id: "t4", to: "done" })).data.message).toBe("the guard of pass refuses");
  await rig.b("move", { id: "t4", to: "in-progress" });
  await rig.a("move", { id: "t4", to: "in-review", refs: ref });
  await rig.b("review", { id: "t4", verdict: "pass" });
  expect((await rig.b("move", { id: "t4", to: "done" })).data.event.move).toBe("pass");
  // A parent is not ready, and not submitted, while a child is open.
  await rig.owner("open", { id: "p", title: "Parent", kind: "task" });
  expect((await rig.owner("open", { id: "c", title: "Child", kind: "task", parent: "nope" })).status).toBe(404);
  await rig.owner("open", { id: "c", title: "Child", kind: "task", parent: "p" });
  await rig.owner("move", { id: "p", to: "triaged", reason: "real" });
  expect((await rig.owner("move", { id: "p", to: "ready" })).status).toBe(403);
  await rig.owner("move", { id: "c", to: "rejected", reason: "not needed" });
  expect((await rig.owner("move", { id: "p", to: "ready" })).status).toBe(200);
  expect((await rig.owner("get?id=p")).data.children).toEqual([{ id: "c", title: "Child", kind: "task", state: "rejected", closed: true }]);
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true, guards: true });
  return "reviewer is not the implementer; major waits for the owner and is the owner's to take off; a block stops a pass; a parent waits for its children";
}
// %%
test_issues_swaps_and_guards_of_one_issue = {
  const rig = await issuesRig();
  // Opened by token a, which so goes on reading it once it is a security issue.
  await rig.a("open", { id: "s1", title: "Leak", kind: "bug" });
  const hashes = (await rig.owner("policy")).data.policy.names;
  // The listed swap needs its guard (the label), and no owner.
  expect((await rig.a("swap", { id: "s1", swap: "escalate" })).data.message).toBe("the guard of escalate refuses");
  await rig.a("label", { id: "s1", add: ["security"] });
  expect((await rig.worker("label", { id: "s1", add: ["x"] })).status).toBe(403);
  // A guard added to one move of this issue, by whoever may triage. It only narrows.
  expect((await rig.a("narrow", { id: "s1", move: "triage", guard: "caller.present" })).status).toBe(200);
  expect((await rig.a("narrow", { id: "s1", move: "triage", guard: "caller.(" })).status).toBe(400);
  expect((await rig.a("narrow", { id: "s1", move: "nope", guard: "true" })).status).toBe(403);
  expect((await rig.a("move", { id: "s1", to: "triaged", reason: "real" })).data.message).toBe("this issue's guard 4 on triage refuses");
  const swapped = (await rig.a("swap", { id: "s1", swap: "escalate", reason: "leaks a key" })).data.event;
  expect(swapped).toMatchObject({ type: "swapped", swap: "escalate", from: { workflow: hashes.task, state: "open" }, to: { workflow: hashes.security, state: "triaged" } });
  // Security lists no swap out: back to task is the owner present.
  expect((await rig.a("swap", { id: "s1", workflow: "task", state: "open" })).data.message).toBe("a swap the workflow does not list needs the owner, present");
  expect((await rig.owner("swap", { id: "s1", workflow: "task", state: "nope" })).status).toBe(403);
  expect((await rig.owner("swap", { id: "s1", workflow: "task", state: "open" })).data.event).toMatchObject({ swap: null, to: { workflow: hashes.task, state: "open" } });
  // The issue's own guard came along through both swaps. Only the owner present removes it.
  expect((await rig.a("move", { id: "s1", to: "triaged", reason: "real" })).status).toBe(403);
  expect((await rig.a("narrow", { id: "s1", remove: 4 })).data.message).toBe("the owner, present");
  expect((await rig.owner("narrow", { id: "s1", remove: 9 })).status).toBe(404);
  expect((await rig.owner("narrow", { id: "s1", remove: 4 })).status).toBe(200);
  expect((await rig.a("move", { id: "s1", to: "triaged", reason: "real" })).status).toBe(200);
  // A guard on reject does not stand in the way of the owner's own reject, which is another move to the same state.
  await rig.owner("open", { id: "s2", title: "Unwanted", kind: "task" });
  expect((await rig.a("narrow", { id: "s2", move: "reject", guard: "false" })).status).toBe(200);
  const guard = (await rig.owner("get?id=s2")).data.issue.extra[0].n;
  expect((await rig.a("move", { id: "s2", to: "rejected", reason: "no" })).data.message).toBe(`this issue's guard ${guard} on reject refuses`);
  expect((await rig.owner("move", { id: "s2", to: "rejected", reason: "no" })).data.event.move).toBe("owner-reject");
  // "constructor" is a name like any other: no issue, no parent, no workflow until one is made.
  expect((await rig.owner("get?id=constructor")).status).toBe(404);
  expect((await rig.owner("policy?hash=constructor")).status).toBe(404);
  expect((await rig.owner("open", { title: "x", kind: "task", parent: "constructor" })).status).toBe(404);
  expect((await rig.owner("open", { title: "x", kind: "constructor" })).data.message).toBe("no workflow for the kind constructor");
  expect((await rig.owner("swap", { id: "s1", workflow: "constructor", state: "open" })).data.message).toBe("no such workflow or state");
  expect((await rig.owner("open", { id: "constructor", title: "Named so", kind: "task" })).status).toBe(200);
  expect((await rig.owner("get?id=constructor")).data.issue.title).toBe("Named so");
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true });
  return "a listed swap by a token; an unlisted one by the owner present; a guard of one issue, on one move";
}
// %%
test_issues_policy_is_installed_by_the_owner_and_migrates = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "f1", title: "Slow page", kind: "feedback" });
  await rig.owner("open", { id: "f2", title: "Closed", kind: "feedback" });
  await rig.owner("move", { id: "f2", to: "closed" });
  const was = (await rig.owner("policy")).data.policy.names;
  const flow = { states: ["new", "seen", "closed"], start: "new", closed: ["closed"], read: "true", open: "true", comment: "true", label: "true", review: "false", narrow: "false", moves: [{ name: "see", from: "new", to: "seen", guard: 'caller.kind == "token"' }], swaps: [] };
  const policy = { kinds: { feedback: "feedback" }, workflows: { feedback: flow } };
  // Counted here, not written by hand: the policies and the installs this cell sees refused, and the installs it sees accepted.
  let policies = 0, refusals = 0;
  const accepted = [];
  const no = async (sent) => {
    const r = await sent;
    expect(r.status).toBeGreaterThanOrEqual(400);
    refusals++;
    return r;
  };
  const yes = async (on, body) => {
    const r = await on.owner("install", body);
    expect(r.status).toBe(200);
    accepted.push([on, body, r.data]);
    return r.data;
  };
  expect((await no(rig.a("install", { policy }))).data.message).toBe("the owner, present");
  expect((await no(rig.as("owner", "delegation:d1")("install", { policy }))).status).toBe(403);
  const bad = (change) => rig.owner("install", { policy: { ...policy, workflows: { feedback: { ...flow, ...change } } } }).then((r) => (policies++, [r.status, r.data.error]));
  expect(await bad({ review: "caller.(" })).toEqual([400, "InvalidPolicy"]);
  expect(await bad({ start: "nope" })).toEqual([400, "InvalidPolicy"]);
  expect(await bad({ moves: [{ name: "see", from: "new", to: "gone", guard: "true" }] })).toEqual([400, "InvalidPolicy"]);
  expect(await bad({ swaps: [{ name: "x", to: { workflow: "task", state: "open" }, guard: "true" }] })).toEqual([400, "InvalidPolicy"]);
  // A migrate that cannot land is refused whole, before the policy is written: no workflow of that name, or no such state.
  const events = rig.db.events.length;
  expect((await no(rig.owner("install", { policy, migrate: { [was.feedback]: { workflow: "nope" } } }))).status).toBe(400);
  expect((await no(rig.owner("install", { policy, migrate: { [was.feedback]: { workflow: "feedback" } } }))).data).toEqual({ error: "InvalidRequest", message: `migrate ${was.feedback}: f1 is open, and feedback has no state open` });
  // Nor under a key that another kind of event holds (k1 is the key f1 was opened with).
  expect((await no(rig.owner("install", { key: "k1", policy }))).data).toEqual({ error: "InvalidRequest", message: "key: another event has this key" });
  // Nor with a migrate from something that is not a hash the record keeps: a workflow's name is not one.
  const to = { workflow: "feedback", states: { open: "new" } };
  expect((await no(rig.owner("install", { policy, migrate: { feedback: to } }))).data.message).toBe("migrate feedback: the record keeps no workflow of that hash");
  // Keys under policy/ are the service's own: a caller cannot take the key of a swap ahead of an install.
  expect((await rig.a("comment", { key: "policy/5/f1", id: "f1", body: "claim" })).data).toEqual({ error: "InvalidRequest", message: "key: policy/ is the service's own" });
  expect((await no(rig.owner("install", { key: "policy/default", policy }))).status).toBe(400);
  // Nor with a states that names a state the old workflow lacks or maps one to no state's name, or a migrate that is no map.
  expect((await no(rig.owner("install", { policy, migrate: { [was.feedback]: { workflow: "feedback", states: { opne: "new" } } } }))).data.message).toBe(`migrate ${was.feedback}: the workflow it moves from has no state opne`);
  for (const state of ["", null, { a: 1 }, 7]) expect((await no(rig.owner("install", { policy, migrate: { [was.feedback]: { workflow: "feedback", states: { open: state } } } }))).data.message).toBe(`migrate ${was.feedback}: states.open is the name of a state`);
  // A state the new workflow lacks, mapped from a state no open issue is in (f2 at closed is closed): refused all the same.
  expect((await no(rig.owner("install", { policy, migrate: { [was.feedback]: { workflow: "feedback", states: { open: "new", closed: "nwe" } } } }))).data.message).toBe(`migrate ${was.feedback}: feedback has no state nwe`);
  // An entry with no workflow is told the shape.
  expect((await no(rig.owner("install", { policy, migrate: { [was.feedback]: { states: { open: "new" } } } }))).data.message).toBe(`migrate ${was.feedback}: { workflow, states: { old: new } }`);
  for (const migrate of [was.feedback, [to], { [was.feedback]: "feedback" }, { [was.feedback]: null }, { [was.feedback]: { workflow: "feedback", states: "open" } }]) expect((await no(rig.owner("install", { policy, migrate }))).status).toBe(400);
  expect([rig.db.events.length, (await rig.owner("policy")).data.policy.names]).toEqual([events, was]);
  const nothing = await rig.sim.fetch("https://issues.internal/xrpc/com.lopecode.brain.issue.install", { method: "POST", headers: { "x-brain-caller": "owner", "x-brain-via": "session", "content-type": "application/json" }, body: "null" });
  expect(nothing.status).toBe(400);
  refusals++;
  const installed = await yes(rig, { key: "v2", policy, migrate: { [was.feedback]: to } });
  expect(installed).toMatchObject({ seq: 5, moved: ["f1"], left: [] });
  expect(installed.hashes.feedback).not.toBe(was.feedback);
  // The open issue moved with an event of its own that cites the policy; the closed one stays on the workflow it was closed under.
  const moved = (await rig.owner("get?id=f1")).data;
  expect(moved.issue).toMatchObject({ state: "new", workflow: installed.hashes.feedback });
  expect(moved.events.at(-1)).toMatchObject({ type: "swapped", swap: null, policy: 5, to: { workflow: installed.hashes.feedback, state: "new" } });
  expect((await rig.owner("get?id=f2")).data.issue).toMatchObject({ state: "closed", workflow: was.feedback });
  expect((await rig.owner("policy?hash=" + was.feedback)).data.workflow.states).toEqual(["open", "closed"]);
  expect(Object.keys((await rig.owner("policy")).data.workflows)).toEqual([installed.hashes.feedback]);
  // The new guards hold now, and a kind the policy does not name is not opened.
  expect((await rig.owner("move", { id: "f1", to: "seen" })).status).toBe(403);
  expect((await rig.a("move", { id: "f1", to: "seen" })).status).toBe(200);
  expect((await rig.owner("open", { title: "x", kind: "task" })).data.message).toBe("no workflow for the kind task");
  expect((await rig.owner("install", { key: "v2", policy })).data).toMatchObject({ seq: 5, duplicate: true, moved: [], left: [] });
  // The key again with another policy is not that install.
  expect((await no(rig.owner("install", { key: "v2", policy: { ...policy, workflows: { feedback: { ...flow, narrow: "true" } } } }))).data.message).toBe("key: another policy was installed with this key");
  // The whole policy is compared, not its workflows alone: the same workflows with another kinds is another policy.
  expect((await no(rig.owner("install", { key: "v2", policy: { ...policy, kinds: { feedback: "feedback", bug: "feedback" } } }))).data.message).toBe("key: another policy was installed with this key");
  expect(Object.keys((await rig.owner("policy")).data.policy.kinds)).toEqual(["feedback"]);
  // The same policy under a new key, migrating the workflow onto itself: a policy event, and no event for f1, which is where it would land.
  // An empty migrate, and one whose workflow has no open issue, move nothing.
  const same = await yes(rig, { key: "v2-again", policy, migrate: { [installed.hashes.feedback]: { workflow: "feedback" }, [was.feedback]: to } });
  expect([same, rig.db.events.length]).toEqual([{ seq: 8, hashes: installed.hashes, moved: [], left: [] }, 8]);
  expect(await yes(rig, { key: "v2-empty", policy, migrate: {} })).toMatchObject({ seq: 9, moved: [], left: [] });
  // Within one workflow, an issue is moved to another state by a migrate that maps its state (f1 is at seen).
  expect(await yes(rig, { key: "v2-new", policy, reason: "seen is new again", migrate: { [installed.hashes.feedback]: { workflow: "feedback", states: { seen: "new" } } } })).toMatchObject({ seq: 10, moved: ["f1"], left: [] });
  // The reason is in the policy event, under its hash. The default policy has none; an install with none is refused.
  expect(rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.type === "policy").map((e) => [e.seq, e.reason])).toEqual([[1, undefined], [5, "a test"], [8, "a test"], [9, "a test"], [10, "seen is new again"]]);
  for (const reason of [undefined, null, "", "  ", 7, { a: 1 }, "x".repeat(issuesLimits.reason + 1)]) expect((await no(rig.owner("install", { key: "v2-why", policy, reason }))).data.message).toBe(`reason: text, 1 to ${issuesLimits.reason} characters: who asked for the install and why`);
  expect(rig.db.events.length).toBe(11);
  // The default policy was written once, into the empty record, and is not written again: not after an install, not
  // when the view is lost, not after a rebuild. A second one written past the service is named by the replay.
  const byWorker = () => rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.type === "policy").map((e) => [e.seq, e.by.caller]);
  expect(byWorker()).toEqual([[1, "worker:brain-x-issues"], [5, "owner"], [8, "owner"], [9, "owner"], [10, "owner"]]);
  rig.db.meta.clear();
  expect((await rig.a("comment", { id: "f1", body: "x" })).data).toMatchObject({ error: "ViewLost" });
  // An install says the same, with a migrate or without: the hashes a migrate names are read from the view.
  expect((await no(rig.owner("install", { key: "lost", policy, migrate: { [installed.hashes.feedback]: { workflow: "feedback" } } }))).data).toMatchObject({ error: "ViewLost" });
  expect((await no(rig.owner("install", { key: "lost", policy }))).data).toMatchObject({ error: "ViewLost" });
  // A lost view is said before the policy is read: a malformed policy is not answered 400 while the view needs a rebuild.
  expect((await no(rig.owner("install", { key: "lost", policy: "not a policy" }))).data).toMatchObject({ error: "ViewLost" });
  // An install sent again is answered from its key alone, a lost view or not.
  expect((await rig.owner("install", { key: "v2", policy, migrate: { [was.feedback]: to } })).data).toMatchObject({ seq: 5, duplicate: true });
  expect(rig.db.events.length).toBe(11);
  await rig.owner("rebuild", {});
  expect((await rig.a("comment", { id: "f1", body: "x" })).status).toBe(200);
  expect(Object.keys((await rig.owner("policy")).data.policy.kinds)).toEqual(["feedback"]);
  expect(byWorker().length).toBe(5);
  const again = await issuePolicyAct(issuesDefaultPolicy);
  const forged = await rig.forge({ type: "policy", policy: again.policy, hashes: again.hashes }, { caller: "worker:brain-x-issues", via: "" });
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: false, seq: forged.seq, why: "the owner, present" });
  rig.db.events.pop();
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true });
  // The policy shown in the prose installs as it is written, and its listed swap lands.
  const example = await yes(rig, { key: "example", policy: issuesExamplePolicy });
  expect(Object.keys(example.hashes)).toEqual(["task", "security"]);
  expect(issuesExampleText).toContain('swaps: [{"name":"escalate","to":{"workflow":"security","state":"open"}');
  await rig.a("open", { id: "e1", title: "From the example", kind: "bug", labels: ["security"] });
  expect((await rig.a("swap", { id: "e1", swap: "escalate" })).data.event.to).toEqual({ workflow: example.hashes.security, state: "open" });
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true });
  // A first write that the default policy would refuse writes nothing, the default included; the owner's install is then event 1.
  const empty = await issuesRig();
  expect((await empty.a("comment", { id: "nope", body: "x" })).status).toBe(404);
  expect((await empty.owner("open", { title: "x", kind: "nope" })).status).toBe(403);
  expect((await empty.owner("open", { title: "x", kind: "task", parent: "nope" })).status).toBe(404);
  expect(empty.db.events.length).toBe(0);
  expect((await yes(empty, { key: "first", policy: issuesExamplePolicy })).seq).toBe(1);
  expect(empty.db.events.map((e) => JSON.parse(e.event).by.caller)).toEqual(["owner"]);
  // Every install this cell saw accepted, sent again as it was (its migrate too, whatever has moved since): the
  // install it was, nothing moved, no event written.
  for (const [on, body, first] of accepted) {
    const events = on.db.events.length;
    expect((await on.owner("install", body)).data).toEqual({ seq: first.seq, hashes: first.hashes, moved: [], left: [], duplicate: true });
    expect(on.db.events.length).toBe(events);
  }
  return `installed by the owner present; ${policies} policies and ${refusals} installs refused; 1 open issue migrated, and not again onto where it is; ${accepted.length} installs sent again and answered as before; the example installs; a refused first write leaves the record empty`;
}
// %%
test_issues_hidden_from_who_may_not_read = {
  const rig = await issuesRig();
  await rig.a("open", { id: "sec", title: "Key in a log", body: "the key is …", kind: "security" });
  await rig.a("open", { id: "pub", title: "Typo", kind: "bug" });
  const stub = { id: "sec", kind: "security", state: "open", closed: false, parent: null, hidden: true };
  // The opener and the owner read it; another token and a Worker are told that it is there and no more.
  expect((await rig.a("get?id=sec")).data.issue.title).toBe("Key in a log");
  expect((await rig.owner("get?id=sec")).data.events.length).toBe(1);
  expect((await rig.b("get?id=sec")).data).toEqual({ issue: stub, children: [], events: [] });
  expect((await rig.b("snapshot")).data.issues.map((i) => i.title || i.hidden)).toEqual([true, "Typo"]);
  expect((await rig.worker("list")).data.issues.find((i) => i.id === "sec")).toEqual(stub);
  const synced = (await rig.b("sync?after=1")).data;
  expect(synced.events.map((e) => [e.seq, e.id, e.hidden || e.title])).toEqual([[2, "sec", true], [3, "pub", "Typo"]]);
  expect(JSON.stringify(synced)).not.toContain("the key is");
  expect((await rig.a("sync?after=1")).data.events[0].body).toBe("the key is …");
  // Nor does a caller who may not read it act on it.
  expect((await rig.b("comment", { id: "sec", body: "me too" })).status).toBe(404);
  expect((await rig.b("move", { id: "sec", to: "triaged", reason: "x" })).status).toBe(404);
  expect((await rig.a("comment", { key: "said", id: "sec", body: "more: the key is in the log of 3 May" })).status).toBe(200);
  // The key of a write is not a way round the read guard: token b learns the event's place and nothing it says.
  const guessed = (await rig.b("comment", { key: "said", id: "pub", body: "x" })).data;
  expect(guessed).toEqual({ id: "sec", seq: 4, duplicate: true });
  expect((await rig.a("comment", { key: "said", id: "sec", body: "again" })).data.event.body).toContain("3 May");
  // Nor does it open a child of it, which would hold the issue back from ready. Its opener does.
  expect((await rig.b("open", { title: "Me too", kind: "bug", parent: "sec" })).data).toEqual({ error: "NotFound", message: "no such parent" });
  expect((await rig.worker("open", { title: "Me too", kind: "bug", parent: "sec" })).status).toBe(404);
  expect((await rig.a("open", { id: "kid", title: "A part of it", kind: "bug", parent: "sec" })).status).toBe(200);
  // A token of the owner is not the owner present: it reads the security issue it opened and no other.
  const d1 = rig.as("owner", "delegation:d1", { "x-brain-holder": "secret", "x-brain-tab": "0" });
  expect((await d1("get?id=sec")).data.issue).toEqual(stub);
  expect((await rig.member("list")).status).toBe(200);
  return "a security issue: 2 readers, 2 callers shown a stub";
}
