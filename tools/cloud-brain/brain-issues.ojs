test_issues_resign_signs_the_record_with_the_key_held = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "s1", title: "One", kind: "feedback" });
  await rig.owner("comment", { id: "s1", body: "two" });
  // The record as another key left it: every sig is of the right hash and by a key the Worker does not hold.
  const other = await issueKeys(JSON.stringify(await crypto.subtle.exportKey("jwk", (await crypto.subtle.generateKey({ name: "ECDSA", namedCurve: "P-256" }, true, ["sign", "verify"])).privateKey)));
  for (const r of rig.db.events) r.event = JSON.stringify({ ...JSON.parse(r.event), sig: await other.sign(r.hash) });
  const hashes = rig.db.events.map((r) => r.hash);
  expect((await rig.owner("verify")).data).toMatchObject({ ok: false, seq: 1, why: "sig" });
  expect((await rig.a("resign", {})).status).toBe(403);
  expect((await rig.owner("resign", {})).data).toEqual({ seq: 3, signed: 3 });
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true, checked: 3 });
  expect(rig.db.events.map((r) => JSON.parse(r.event).hash)).toEqual(hashes);
}
