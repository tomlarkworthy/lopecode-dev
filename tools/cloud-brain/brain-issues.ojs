test_issues_declares_what_it_needs = {
  const { meta } = await issues_service.emit();
  expect(meta).toMatchObject({ worker: "brain-x-issues", role: "recipe", module: "@tomlarkworthy/brain-issues", resources: ["blobs", "sql"], secrets: ["ISSUES_SIGNING_KEY"] });
  const methods = Object.keys(meta.access).sort().map((m) => m.replace("com.lopecode.brain.issue.", ""));
  expect(methods).toEqual(["attach", "attachment", "comment", "cost", "get", "install", "key", "label", "link", "list", "lock", "locks", "move", "narrow", "open", "policy", "rebuild", "resign", "review", "runs", "snapshot", "swap", "sync", "verify"]);
  const let_in = (who) => decide(meta.access["com.lopecode.brain.issue.open"], { caller: callerOf({ caller: who }), request: {} }).allow;
  expect(["owner", "token:a", "worker:brain-x-echo", "deployer", "did:plc:other", "anonymous"].map(let_in)).toEqual([true, true, true, true, false, false]);
  // The default policy passes its own check.
  expect(Object.keys((await issuePolicyAct(issuesDefaultPolicy)).hashes)).toEqual(["task", "security", "feedback", "project"]);
  // Without the key a write is refused and says which secret.
  const bare = await simulate(issues_service, { sql: issuesFakeSql().run });
  const r = await bare.fetch("https://issues.internal/xrpc/com.lopecode.brain.issue.open", { method: "POST", headers: { "x-brain-caller": "owner", "x-brain-via": "session", "content-type": "application/json" }, body: JSON.stringify({ key: "k", title: "x", kind: "task" }) });
  expect([r.status, (await r.json()).message]).toEqual([503, "the secret ISSUES_SIGNING_KEY is not set"]);
  return methods.length + " methods";
}
// %%
// The reference is the text of the prose cells as the module's source has it (referenceOf in cloudflare-iac): a hole in
// one of them is printed as it is written and never filled. So the prose states each value, and this holds it to the cells.
test_issues_reference_states_each_value_and_has_no_hole = {
  const sim = await simulate(issues_service, { sql: issuesFakeSql().run });
  const got = await sim.fetch("https://issues.internal/xrpc/com.lopecode.brain.getSource?part=reference", { headers: { "x-brain-caller": "anonymous" } });
  expect(got.status).toBe(200);
  const text = await got.text();
  expect(text).toContain("| `issue.open` |");
  expect(text.split("$" + "{").length - 1).toBe(0);
  const ticked = (l) => l.map((k) => "`" + k + "`").join(", ");
  const L = issuesLimits;
  const stated = [
    "under `" + issuesStoreName("ADDRESS") + "`",
    "`kind` is one the policy names (" + ticked(Object.keys(issuesDefaultPolicy.kinds)) + " in the default)",
    "`verdict`: " + ticked(L.verdicts) + ".",
    "`{ key, id, " + L.cost.join(", ") + " }`. Required",
    "each a name, `a-z 0-9 -`, " + L.role + " at most; `round`, a whole number, 1 to " + L.rounds + "; `how`: " + ticked(L.hows) + " (",
    "text of 1 to " + L.costText + " characters; `usage`",
    "`?id=&role=&how=&round=&after=<seq>&limit=" + L.page + "`",
    "`role`: a name, `a-z 0-9 -`, " + L.role + " at most; `how`: one of " + ticked(L.hows) + "; `round`: `first` (round 1), `later` (any round after it) or a whole number, 1 to " + L.rounds + "; `after`",
    "`limit`: a whole number, 1 to " + L.page + ", " + L.page + " when left out",
    "`rel`: " + ticked(L.rels.filter((r) => r !== "part-of")).replace(/, (`[a-z]+`)$/, ", $1,") + " and",
    "text of 1 to " + L.reason + " characters",
    "&limit=" + L.syncPage + "`",
    "`syncMs` (" + L.syncMs + ")",
    "After " + (L.rebuildRounds + 1) + " writes",
    "not empty, " + L.attachment + " bytes at most",
    "An issue has " + L.attachments + " at most",
    "`name`: `a-z 0-9 -`, 1 to " + L.lockName + ". `who`: `a-z A-Z 0-9 . _ -`, 1 to " + L.lockWho + ". `seconds`: " + L.lockMin + " to " + L.lockMax + ", " + L.lockSeconds + " when left out.",
    "`?history=N`, 0 to " + L.lockHistory + ", 0 when left out",
    "the newest " + L.lockHistory + " kept",
    "| " + issuesDefaultPolicy.workflows.task.states.join(" → ") + ". Listed swap",
    "```js\n" + issuesExampleText + "\n```"
  ];
  for (const s of stated) expect(text).toContain(s);
  return stated.length + " values stated, no hole";
}
// %%
// The texts the panel draws of a run and of an issue's totals, with no page.
test_issues_cost_is_said_as_a_line = {
  expect([0, 1, 12, 999, 1000, 12345, 123456, 1234567, 628778702].map((n) => issueCount(n))).toEqual(["0", "1", "12", "999", "1,000", "12,345", "123,456", "1,234,567", "628,778,702"]);
  expect([issueCount(0, "run"), issueCount(1, "run"), issueCount(1000, "request")]).toEqual(["0 runs", "1 run", "1,000 requests"]);
  const usage = { input: 61, cacheWrite: 141873, cacheRead: 3561349, output: 17885, requests: 29, advisor: { calls: 2, input: 5, output: 6 } };
  const run = { role: "implementer", round: 2, how: "resumed", outcome: "in-review", seconds: 410, context: 201310 };
  // The line of the spec, "The page (R5)".
  expect(issueRunSaid({ ...run, usage, replaced: 1203 })).toBe("implementer round 2, resumed, in-review · 410 s · context 201,310 · billed in 61, written 141,873, read 3,561,349, out 17,885, 29 requests · advisor 2 calls · replaces 1203");
  // With no usage it says so. An advisor that was not called is left out. A usd of 0 is one that was reported.
  expect(issueRunSaid(run)).toBe("implementer round 2, resumed, in-review · 410 s · context 201,310 · no usage");
  expect(issueRunSaid({ ...run, seconds: 0, context: 0, usd: 0, usage: { ...usage, requests: 1, advisor: { calls: 0, input: 0, output: 0 } } })).toBe("implementer round 2, resumed, in-review · 0 s · context 0 · billed in 61, written 141,873, read 3,561,349, out 17,885, 1 request · $0");
  expect(issueRunSaid({ ...run, usd: 0.25, usage: { ...usage, advisor: { calls: 1, input: 0, output: 0 } } })).toContain("29 requests · advisor 1 call · $0.25");
  // The totals: of no run, of runs with no usage, and of runs of which some have one.
  expect(issueCostSaid(issueCost([]))).toBe("0 runs · 0 s · no usage");
  expect(issueCostSaid(issueCost([run]))).toBe("1 run · 410 s · no usage");
  expect(issueCostSaid(issueCost([run, { ...run, round: 3, seconds: 1000, usage, usd: 0.1 }, { ...run, round: 4, usage, usd: 0.2 }]))).toBe("3 runs · 1,820 s · 2 with a usage: in 122, written 283,746, read 7,122,698, out 35,770, 58 requests · advisor 4 calls · $0.3 of 2 runs");
  return "a run and the totals as text: with a usage and with none, one request and many, what it replaces";
}
// %%
// R5 of plan/cloud-brain-run-cost-is-part-of-the-issue-model.md: the page shows a run as a line of the issue, and the
// totals of the open issue.
test_issues_panel_draws_a_run_and_the_totals = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "r1", title: "Costed", kind: "task" });
  await rig.owner("open", { id: "r0", title: "No run", kind: "task" });
  // It waits for an answer, with no body and no comment: the block shows its last event.
  await rig.owner("open", { id: "q1", title: "Asked", kind: "task", labels: ["needs-owner"] });
  const usage = { input: 61, cacheWrite: 141873, cacheRead: 3561349, output: 17885, requests: 29, advisor: { calls: 2, input: 5, output: 6 } };
  const run = (id, role, round, more) => ({ id, role, round, how: "fresh", outcome: "in-review", seconds: 410, context: 201310, ...more });
  const first = (await rig.a("cost", run("r1", "implementer", 1))).data.seq;
  expect((await rig.a("cost", run("r1", "reviewer", 1, { how: "light", outcome: "pass", seconds: 90, context: 5000, usage: { ...usage, requests: 1, advisor: { calls: 0, input: 0, output: 0 } }, usd: 0.25 }))).status).toBe(200);
  expect((await rig.a("cost", run("q1", "implementer", 1))).status).toBe(200);
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const client = { query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok), procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok) };
  let end = null;
  const panel = issuesPanel({ client, owner: true, every: 1e9, listen: false, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null } });
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  const lines = () => [...panel.querySelectorAll('[data-event="cost"]')].map((d) => d.textContent), total = () => panel.querySelector("[data-cost]");
  try {
    await panel.sync();
    panel.show("r1");
    // The totals are of the row, drawn with the issue. The events are issue.get's, drawn when it has answered.
    expect([total().dataset.cost, total().textContent]).toEqual(["2", "cost 2 runs · 500 s · 1 with a usage: in 61, written 141,873, read 3,561,349, out 17,885, 1 request · $0.25 of 1 run"]);
    expect(await until(() => lines().length === 2)).toBe(true);
    // A run's line has the role and the seconds. One with no usage says so.
    expect(lines().map((t) => t.slice(t.indexOf(" cost ") + 1))).toEqual([
      "cost implementer round 1, fresh, in-review · 410 s · context 201,310 · no usage",
      "cost reviewer round 1, light, pass · 90 s · context 5,000 · billed in 61, written 141,873, read 3,561,349, out 17,885, 1 request · $0.25"
    ]);
    // R2 on the page: the run written again with its usage. Its line says which event it replaces, and the totals are
    // still of two runs.
    expect((await rig.a("cost", run("r1", "implementer", 1, { usage }))).data.event.replaced).toBe(first);
    await panel.sync();
    expect(await until(() => lines().length === 3)).toBe(true);
    expect(lines()[2].slice(lines()[2].indexOf(" cost ") + 1)).toBe(`cost implementer round 1, fresh, in-review · 410 s · context 201,310 · billed in 61, written 141,873, read 3,561,349, out 17,885, 29 requests · advisor 2 calls · replaces ${first}`);
    expect([total().dataset.cost, total().textContent]).toEqual(["2", "cost 2 runs · 500 s · 2 with a usage: in 122, written 283,746, read 7,122,698, out 35,770, 30 requests · advisor 2 calls · $0.25 of 1 run"]);
    // An issue with no run has no such line.
    panel.show("r0");
    expect([total(), panel.textContent.includes("No run")]).toEqual([null, true]);
    // What a run cost is not the last thing said of a waiting issue: the block shows the event before it.
    const row = () => panel.attention.querySelector('[data-attention="q1"]');
    expect(await until(() => !!row() && !!row().querySelector("[data-said]"))).toBe(true);
    expect([...row().querySelectorAll("[data-said]")].map((d) => d.dataset.said)).toEqual(["opened"]);
  } finally {
    end();
  }
  return "2 runs as lines of the open issue with its totals; a run written again says what it replaces; no line of totals with no run";
}
// %%
test_issues_panel_draws_and_applies_a_write_before_the_answer = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "p1", title: "Shown first", kind: "task" });
  const held = [];
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const client = {
    query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok),
    // Each write waits until the test lets it go.
    procedure: (name, body) => new Promise((go) => held.push(go)).then(() => rig.owner(name.replace("issue.", ""), body)).then(ok)
  };
  const kept = {};
  let end = null, inputs = 0;
  const panel = issuesPanel({ client, owner: true, every: 1e9, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: (v) => (kept.view = JSON.parse(JSON.stringify(v))) } });
  panel.addEventListener("input", (e) => e.target === panel && inputs++);
  expect(issuesPanel({ client, owner: false }).textContent).toContain("Sign in as the owner");
  await panel.sync();
  expect(panel.textContent).toContain("Shown first");
  expect(panel.textContent).toContain("1 issues at event 2");
  // A new issue is in the table before the service has answered, and is the service's once it has.
  const act = { type: "open", id: "p2", title: "Typed now", body: "", kind: "task", about: "brain", parent: null, labels: [] };
  const sent = panel.send("open", act, act);
  expect(panel.textContent).toContain("Typed now");
  expect([panel.value.issues.p2.state, rig.db.view.has("p2"), panel.textContent.includes("1 being sent")]).toEqual(["open", false, true]);
  held.shift()();
  await sent;
  expect([rig.db.view.has("p2"), panel.value.seq, kept.view.issues.p2.title]).toEqual([true, 3, "Typed now"]);
  // A move the guard refuses is not drawn; one the service refuses is withdrawn and said.
  const bad = panel.send("move", { type: "move", id: "p2", to: "triaged", reason: "real" }, { id: "p2", to: "triaged" });
  expect(panel.value.issues.p2.state).toBe("triaged");
  held.shift()();
  await bad;
  expect(panel.value.issues.p2.state).toBe("open");
  expect(panel.textContent).toContain("issue.move was refused: the guard of triage refuses");
  // The form: a title typed, the kind chosen from the policy's, Open.
  const kinds = panel.form.kind.slot.querySelector("select");
  expect([panel.form.kind.value, [...kinds.options].map((o) => o.textContent)]).toEqual(["task", ["bug", "task", "feedback", "security", "feature", "project"]]);
  kinds.selectedIndex = 0;
  kinds.dispatchEvent(new Event("input", { bubbles: true }));
  expect(panel.form.kind.value).toBe("bug");
  panel.form.title.value = "From the form";
  const typed = panel.form.open();
  expect(panel.textContent).toContain("From the form");
  held.shift()();
  await typed;
  expect([...rig.db.view.values()].map((r) => JSON.parse(r.issue)).find((i) => i.title === "From the form")).toMatchObject({ kind: "bug", about: "brain", state: "open" });
  // A filter is answered from the copy.
  const select = panel.filters.kind.slot.querySelector("select");
  expect([...select.options].map((o) => o.textContent)).toEqual(["", "task", "bug"]);
  select.selectedIndex = 2;
  select.dispatchEvent(new Event("input", { bubbles: true }));
  expect([panel.filters.kind.value, panel.textContent.includes("Shown first"), panel.textContent.includes("From the form")]).toEqual(["bug", false, true]);
  // What another caller wrote arrives with the next sync.
  await rig.a("comment", { id: "p1", body: "from elsewhere" });
  const before = inputs;
  expect(await panel.sync()).toBe(1);
  expect(panel.value.issues.p1.comments).toBe(1);
  // A cell that reads viewof issuesView is told.
  expect(inputs).toBeGreaterThan(before);
  // A link is drawn in the issue that says it and in the one it is said of.
  const link = { id: "p2", to: "p1", rel: "cause" }, linking = panel.send("link", { type: "link", ...link }, link);
  held.shift()();
  await linking;
  panel.show("p2");
  expect(panel.querySelector('[data-link="p1"]').textContent).toContain("cause");
  panel.show("p1");
  expect(panel.querySelector('[data-link="p2"]').textContent).toContain("cause of");
  // A ref typed as an address is a url, whole; NAME:VALUE is a ref of that kind.
  expect(panel.refsOf("https://example.com/pr/1, commit:abc, notes.txt")).toEqual([{ kind: "url", value: "https://example.com/pr/1" }, { kind: "commit", value: "abc" }, { kind: "url", value: "notes.txt" }]);
  end();
  // The kept copy is one for each Brain's address. A copy of another record is not built on: the service answers reset
  // to a head it does not have at that seq, and the panel starts from a snapshot.
  const other = await issuesRig();
  await other.owner("open", { id: "elsewhere", title: "Of another Brain", kind: "task" });
  await other.owner("comment", { id: "elsewhere", body: "x" });
  const stale = (await other.owner("snapshot")).data, cache = { view: { seq: stale.seq, head: stale.head, policy: stale.policy, workflows: stale.workflows, issues: Object.fromEntries(stale.issues.map((i) => [i.id, i])) } };
  let end2 = null;
  const second = issuesPanel({ client, owner: true, every: 1e9, invalidation: new Promise((r) => (end2 = r)), store: { get: () => cache.view, set: (v) => (cache.view = v) } });
  expect(second.textContent).toContain("Of another Brain");
  await second.sync();
  expect([second.textContent.includes("Of another Brain"), second.textContent.includes("Shown first"), Object.keys(second.value.issues).includes("elsewhere")]).toEqual([false, true, false]);
  end2();
  expect([issuesStore("https://a.example").name, issuesStore("https://b.example").name]).toEqual(["brain_issues2 https://a.example", "brain_issues2 https://b.example"]);
  return "drawn from a snapshot; a write shown before its answer; a refusal withdrawn; another record's copy dropped";
}
// %%
// The State filter starts at the work that is not finished: every issue whose workflow does not count its state as
// closed. Asked by the owner in a note on the panel (fb-a2l7nb492m), who wanted "NOT DONE and NOT rejected" at load.
test_issues_panel_lists_the_open_work_at_load = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "w1", title: "Still to do", kind: "task" });
  await rig.owner("open", { id: "w2", title: "Turned down", kind: "task" });
  await rig.owner("open", { id: "w3", title: "A note answered", kind: "feedback" });
  await rig.owner("open", { id: "w4", title: "Being looked at", kind: "task" });
  const moved = [await rig.owner("move", { id: "w2", to: "rejected", reason: "not real" }), await rig.owner("move", { id: "w3", to: "closed", reason: "answered" }), await rig.owner("move", { id: "w4", to: "triaged", reason: "real" })];
  expect(moved.map((r) => r.status)).toEqual([200, 200, 200]);
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const client = { query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok), procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok) };
  let end = null;
  const panel = issuesPanel({ client, owner: true, every: 1e9, listen: false, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => {} } });
  await panel.sync();
  const titles = ["Still to do", "Turned down", "A note answered", "Being looked at"], shown = () => titles.map((t) => panel.list.textContent.includes(t));
  // The select is made again when the states of the copy change, so it is found at each use.
  const options = (of = panel) => [...of.filters.state.slot.querySelector("select").options].map((o) => o.textContent), choose = (text, of = panel) => {
    const select = of.filters.state.slot.querySelector("select");
    select.selectedIndex = [...select.options].findIndex((o) => o.textContent === text);
    select.dispatchEvent(new Event("input", { bubbles: true }));
  };
  // At load: the first choice, and the two that are not closed. The count under the table is of the whole copy.
  expect(options()).toEqual(["open work", "every issue", "open", "rejected", "closed", "triaged"]);
  expect([panel.filters.state.value, shown()]).toEqual([issuesOpenWork, [true, false, false, true]]);
  expect(panel.textContent).toContain("4 issues at event");
  // "closed" is what each workflow says of its own states: a move to one takes the row out, with no call.
  await panel.send("move", { type: "move", id: "w1", to: "rejected", reason: "not real either" }, { id: "w1", to: "rejected", reason: "not real either" });
  expect([panel.filters.state.value, options(), shown()]).toEqual([issuesOpenWork, ["open work", "every issue", "rejected", "closed", "triaged"], [false, false, false, true]]);
  // Every issue, and one state, are still there to choose.
  choose(issuesEveryIssue);
  expect([panel.filters.state.value, shown()]).toEqual(["", [true, true, true, true]]);
  choose("rejected");
  expect(shown()).toEqual([true, true, false, false]);
  // The choice is kept when the states change: a sync that brings a new one does not put the filter back.
  await rig.owner("move", { id: "w4", to: "ready", reason: "no parts" });
  await panel.sync();
  expect([panel.filters.state.value, options().includes("ready")]).toEqual(["rejected", true]);
  end();
  // A later policy may name a state all (a state is a-z 0-9 -). No two choices read the same, and each gives its own rows.
  const copy = { seq: 1, head: "h", policy: { seq: 1 }, workflows: {}, issues: [{ id: "a1", title: "At a state named all", kind: "task", state: "all", closed: false, labels: [] }, { id: "a2", title: "At another state", kind: "task", state: "open", closed: false, labels: [] }] };
  let end2 = null;
  const later = issuesPanel({ client: { query: async (name) => (name === "issue.snapshot" ? copy : { events: [] }), procedure: async () => ({}) }, owner: true, every: 1e9, listen: false, invalidation: new Promise((r) => (end2 = r)), store: { get: () => null, set: () => {} } });
  await later.sync();
  const rows = () => ["At a state named all", "At another state"].map((t) => later.list.textContent.includes(t));
  expect([options(later), new Set(options(later)).size]).toEqual([["open work", "every issue", "all", "open"], 4]);
  choose("all", later);
  expect([later.filters.state.value, rows()]).toEqual(["all", [true, false]]);
  choose(issuesEveryIssue, later);
  expect([later.filters.state.value, rows()]).toEqual(["", [true, true]]);
  end2();
  return "open work at load; every issue and one state on choice; a state named all is one choice of its own";
}
// %%
test_issues_panel_removes_a_label = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "l1", title: "Labelled", kind: "task", labels: ["needs-owner", "major"] });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const client = { query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok), procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok) };
  const panelOf = (by) => {
    let end = null;
    const panel = issuesPanel({ client, owner: true, ...(by ? { by } : {}), every: 1e9, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null } });
    return Object.assign(panel, { end });
  };
  const remover = (panel, l) => [...panel.querySelectorAll("button")].find((b) => b.dataset.remove === l);
  const panel = panelOf();
  await panel.sync();
  panel.show("l1");
  // Each label of the open issue has its own button; pressing it sends issue.label with remove.
  expect([!!remover(panel, "needs-owner"), !!remover(panel, "major")]).toEqual([true, true]);
  expect(remover(panel, "needs-owner").disabled).toBe(false);
  remover(panel, "needs-owner").click();
  expect(panel.value.issues.l1.labels).toEqual(["major"]);
  for (let n = 0; n < 200 && JSON.parse(rig.db.view.get("l1").issue).labels.length > 1; n++) await new Promise((r) => setTimeout(r, 10));
  expect(JSON.parse(rig.db.view.get("l1").issue).labels).toEqual(["major"]);
  await panel.sync();
  expect([panel.value.issues.l1.labels, !!remover(panel, "needs-owner"), !!remover(panel, "major")]).toEqual([["major"], false, true]);
  panel.end();
  // A caller the label guard refuses has the button disabled, and its tooltip is the refusal: major is the owner present.
  const token = panelOf({ caller: "token:a", via: "" });
  await token.sync();
  token.show("l1");
  expect([remover(token, "major").disabled, remover(token, "major").title]).toEqual([true, "the workflow's label guard refuses"]);
  token.end();
  return "a button for each label; needs-owner removed in the copy and in the record; major refused to a token";
}
// %%
test_issues_panel_shows_the_policy_in_force = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "q1", title: "Before any install", kind: "task" });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const client = { query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok), procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok) };
  const kept = {};
  const panelOf = (store) => {
    let end = null;
    const panel = issuesPanel({ client, owner: true, every: 1e9, invalidation: new Promise((r) => (end = r)), store });
    return Object.assign(panel, { end });
  };
  const panel = panelOf({ get: () => null, set: (v) => (kept.view = JSON.parse(JSON.stringify(v))) });
  // Before the first answer the copy has no policy, and the line says nothing.
  expect(panel.policy.textContent).toBe("");
  await panel.sync();
  // The default policy is event 1 and has no reason.
  expect(panel.policy.textContent).toBe("Policy of event 1, the default.");
  // An install by someone else arrives with issue.sync: its seq and its reason.
  const installed = (await rig.owner("install", { key: "v2", policy: { kinds: issuesDefaultPolicy.kinds, workflows: issuesDefaultPolicy.workflows }, reason: "a second reviewer for security" })).data;
  expect(installed.seq).toBe(3);
  expect(await panel.sync()).toBe(1);
  expect(panel.policy.textContent).toBe("Policy of event 3: a second reviewer for security");
  expect(panel.textContent).toContain("Policy of event 3: a second reviewer for security");
  // The line is not the note: a refusal said there leaves it.
  await panel.send("move", { type: "move", id: "q1", to: "triaged", reason: "real" }, { id: "q1", to: "triaged" });
  expect([panel.textContent.includes("issue.move was refused"), panel.policy.textContent]).toEqual([true, "Policy of event 3: a second reviewer for security"]);
  panel.end();
  // A panel opened later has it from issue.snapshot, and one drawn from the kept copy has it before any call.
  const later = panelOf({ get: () => null, set: () => null });
  await later.sync();
  expect(later.policy.textContent).toBe("Policy of event 3: a second reviewer for security");
  later.end();
  const cached = panelOf({ get: () => kept.view, set: () => null });
  expect(cached.policy.textContent).toBe("Policy of event 3: a second reviewer for security");
  cached.end();
  // An install from before a reason was required has none and is not the default (on cb4, event 17).
  const { reason, ...bare } = kept.view.policy;
  const old = panelOf({ get: () => ({ ...kept.view, policy: { ...bare, seq: 17 } }), set: () => null });
  expect(old.policy.textContent).toBe("Policy of event 17, installed with no reason recorded.");
  old.end();
  return "the default policy, event 1; an install's seq and reason from issue.sync, from issue.snapshot and from the kept copy; an install with no reason is not called the default";
}
// %%
test_issues_panel_lists_what_waits_for_the_owner = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "w0", title: "Nobody waits", kind: "task" });
  await rig.owner("open", { id: "w1", title: "Asks the owner", kind: "task", labels: ["needs-owner"] });
  await rig.a("comment", { id: "w1", body: "Two ways to do it: which?" });
  await rig.owner("open", { id: "w2", title: "Was answered", kind: "task", labels: ["needs-owner"] });
  await rig.owner("move", { id: "w2", to: "rejected", reason: "no" });
  await rig.inReview("w5", { labels: ["needs-owner"] });
  await rig.inReview("w3", { labels: ["major"] });
  await rig.b("review", { id: "w3", verdict: "pass" });
  await rig.b("move", { id: "w3", to: "awaiting-approval" });
  await rig.owner("open", { id: "w4", title: "A leak", kind: "security" });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const clientOf = (as) => ({ query: (name, params = {}) => as(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok), procedure: (name, body) => as(name.replace("issue.", ""), body).then(ok) });
  const panelOf = (as, by) => {
    let end = null;
    const panel = issuesPanel({ client: clientOf(as), owner: true, ...(by ? { by } : {}), every: 1e9, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null } });
    return Object.assign(panel, { end });
  };
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  const panel = panelOf(rig.owner);
  // The block shows one issue. `row` reads it and moves nothing: panel.scrub(id) shows another.
  const row = (id, p = panel) => [...p.attention.querySelectorAll("[data-attention]")].find((r) => r.dataset.attention === id);
  const button = (id, name, value) => [...row(id).querySelectorAll("button")].find((b) => b.dataset[name] === value);
  const type = (id, text) => {
    const input = row(id).querySelector("input");
    input.value = text;
    input.dispatchEvent(new Event("input", { bubbles: true }));
  };
  const record = (id, type) => rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.id === id && e.type === type).at(-1);
  // With nothing in the copy the block says so.
  expect(panel.attention.textContent).toContain("For your attention");
  expect(panel.attention.textContent).toContain("Nothing waits");
  await panel.sync();
  // The open issues labelled needs-owner, at awaiting-approval or of kind security: the approval, the answers by id,
  // the security report. Not the plain task, and not the rejected one that still has the label.
  expect([panel.waiting(), panel.shown()]).toEqual([["w3", "w1", "w5", "w4"], "w3"]);
  // The last comment comes with issue.get; an approval shows the review that passed.
  expect(await until(() => row("w3").textContent.includes("reviewed pass"))).toBe(true);
  // The buttons are the moves the owner may make. One that needs a reason is disabled until the box has text; one no
  // text would allow (a pass with no review) is not there.
  expect([button("w3", "to", "done").disabled, button("w3", "to", "rejected").disabled]).toEqual([false, true]);
  panel.scrub("w5");
  expect([!!button("w5", "to", "done"), !!button("w5", "to", "in-progress"), !!button("w5", "to", "rejected")]).toEqual([false, false, true]);
  panel.scrub("w1");
  expect(await until(() => row("w1").textContent.includes("Two ways to do it: which?"))).toBe(true);
  expect(button("w1", "to", "triaged").disabled).toBe(true);
  type("w1", "Take the first way");
  expect([button("w1", "to", "triaged").disabled, button("w1", "to", "rejected").disabled]).toEqual([false, false]);
  // Comment sends the text of the box as issue.comment, and the box is emptied when the service has taken it.
  button("w1", "say", "comment").click();
  expect(await until(() => (record("w1", "commented") || {}).body === "Take the first way" && row("w1").querySelector("input").value === "" && button("w1", "say", "comment").disabled)).toBe(true);
  expect(await until(() => row("w1").textContent.includes("Take the first way"))).toBe(true);
  // What is typed in one row is kept when another caller's event draws that row again.
  panel.scrub("w5");
  type("w5", "half a line");
  await rig.a("comment", { id: "w5", body: "more from the implementer" });
  await panel.sync();
  expect(await until(() => row("w5").textContent.includes("more from the implementer"))).toBe(true);
  expect(row("w5").querySelector("input").value).toBe("half a line");
  // A move takes the text as its reason. An approved issue is closed and leaves the block.
  panel.scrub("w3");
  type("w3", "ship it");
  button("w3", "to", "done").click();
  expect(await until(() => !panel.waiting().includes("w3") && JSON.parse(rig.db.view.get("w3").issue).state === "done")).toBe(true);
  expect(record("w3", "moved")).toMatchObject({ move: "approve", to: "done", reason: "ship it" });
  // The issue that was after the approved one is shown in its place. Taking needs-owner off is one press, and the issue leaves the block.
  expect(panel.shown()).toBe("w1");
  button("w1", "off", "needs-owner").click();
  expect(await until(() => !panel.waiting().includes("w1") && JSON.parse(rig.db.view.get("w1").issue).labels.length === 0)).toBe(true);
  expect([panel.waiting(), panel.shown(), !!row("w5")]).toEqual([["w5", "w4"], "w5", true]);
  panel.end();
  // An issue this caller may not read is listed with no title, no box and no button.
  const token = panelOf(rig.a, { caller: "token:a", via: "" });
  await token.sync();
  token.scrub("w4");
  const hidden = row("w4", token);
  expect([hidden.textContent.includes("A leak"), hidden.textContent.includes("not shown"), hidden.querySelectorAll("input, button").length]).toEqual([false, true, 0]);
  token.end();
  return "4 of 6 issues listed, approval first; a comment, an approval with its reason and needs-owner taken off, each one press; a hidden issue has no controls";
}
// %%
test_issues_panel_attention_rows_say_what_is_asked = {
  const rig = await issuesRig();
  // Opened in an order that is neither the block's nor the ids'.
  await rig.owner("open", { id: "s1", title: "A leak", kind: "security" });
  await rig.owner("open", { id: "q3", title: "Asked later", kind: "task", body: "The body of q3" });
  await rig.owner("open", { id: "q2", title: "Second question", kind: "task", body: "Which of the two readings?\nMore of the body.", labels: ["needs-owner"] });
  await rig.owner("open", { id: "q1", title: "First question", kind: "task", labels: ["needs-owner"] });
  await rig.inReview("a1", { labels: ["major"] });
  await rig.b("review", { id: "a1", verdict: "pass", body: "tests run: 12 pass" });
  await rig.b("move", { id: "a1", to: "awaiting-approval" });
  await rig.b("comment", { id: "q3", body: "an earlier remark" });
  await rig.a("comment", { id: "q3", body: "Keep the old rows or drop them?" });
  await rig.a("label", { id: "q3", add: ["needs-owner"] });
  await rig.b("comment", { id: "q3", body: "a later remark" });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const held = [];
  let hold = false;
  const client = {
    query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok),
    // While `hold` is set each write waits until the test sends it on, or fails it as a network that dropped it.
    procedure: (name, body) => (hold ? new Promise((go, fail) => held.push({ name, go, fail: () => fail(new Error("Failed to fetch")) })) : Promise.resolve()).then(() => rig.owner(name.replace("issue.", ""), body).then(ok))
  };
  let end = null;
  const panel = issuesPanel({ client, owner: true, every: 1e9, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null } });
  // The block shows one issue. `row` reads it and moves nothing: panel.scrub(id) shows another.
  const row = (id) => [...panel.attention.querySelectorAll("[data-attention]")].find((r) => r.dataset.attention === id);
  const box = (id) => row(id).querySelector("input");
  const buttons = (id) => [...row(id).querySelectorAll("button")];
  const button = (id, name, value) => buttons(id).find((b) => b.dataset[name] === value);
  const sending = (id) => buttons(id).filter((b) => b.disabled && b.title === "Being sent.").length;
  const type = (id, text) => {
    box(id).value = text;
    box(id).dispatchEvent(new Event("input", { bubbles: true }));
  };
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  const kept = (id) => JSON.parse(rig.db.view.get(id).issue);
  const said = (id, body) => rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.id === id && e.type === "commented" && e.body === body).length;
  const ask = (id) => row(id).querySelector("[data-ask]").textContent;
  await panel.sync();
  // The order: what waits for an approval, then what waits for an answer, then the security reports; by id inside each.
  expect(panel.waiting()).toEqual(["a1", "q1", "q2", "q3", "s1"]);
  expect([...panel.attention.querySelectorAll("[data-heading]")].map((h) => h.textContent)).toEqual(["To approve (1)", "To answer (3)", "Security (1)"]);
  // Each issue as it is shown: its group, the id leading, then the line that says what is asked, and what is under it
  // once issue.get has answered. Under it: the review that passed, the comment the label was put on with, the body of an issue opened with the label.
  const each = {};
  for (const id of panel.waiting()) {
    panel.scrub(id);
    expect(await until(() => id === "s1" || !!row(id).querySelector("[data-said]"))).toBe(true);
    const r = row(id);
    each[id] = { group: r.dataset.group, lead: [r.firstElementChild.tagName, r.firstElementChild.textContent, r.children[1].hasAttribute("data-ask")], ask: ask(id), text: r.textContent, buttons: buttons(id).map((b) => [b.dataset.asked || "", b.dataset.to || b.dataset.off || "", b.textContent]) };
  }
  expect(Object.values(each).map((r) => r.group)).toEqual(["approve", "answer", "answer", "answer", "security"]);
  expect(Object.values(each).map((r) => r.lead)).toEqual([["CODE", "a1", true], ["CODE", "q1", true], ["CODE", "q2", true], ["CODE", "q3", true], ["CODE", "s1", true]]);
  expect([each.a1.ask, each.q1.ask, each.s1.ask]).toEqual(["Approve it, or reject it with a reason.", "Answer it: type the answer, then press Answer.", "A security report: read it, then move it."]);
  // A button is named for the move, not for the state it leads to, and the one asked for is marked and comes first.
  const named = (id, to) => each[id].buttons.find((b) => b[1] === to)[2];
  expect([named("a1", "done"), named("a1", "rejected"), named("q1", "triaged"), named("q1", "closed"), named("q1", "needs-owner")]).toEqual(["approve", "reject", "triage", "close", "take needs-owner off"]);
  expect([each.a1.buttons[0], each.q1.buttons[0], each.s1.buttons.filter((b) => b[0]).length]).toEqual([["approve", "done", "approve"], ["answer", "", "Answer"], 0]);
  expect(each.a1.text).toContain("pass: tests run: 12 pass");
  expect([each.q3.text.includes("Keep the old rows or drop them?"), each.q3.text.includes("a later remark"), each.q3.text.includes("an earlier remark")]).toEqual([true, true, false]);
  expect([each.q2.text.includes("Which of the two readings?"), each.q1.text.includes("opened")]).toEqual([true, true]);
  // Answer needs text. One press is the comment and the label taken off; a second press before the answer sends nothing.
  panel.scrub("q1");
  expect(button("q1", "asked", "answer").disabled).toBe(true);
  hold = true;
  const b1 = box("q1");
  type("q1", "Take the first way");
  expect(button("q1", "asked", "answer").disabled).toBe(false);
  button("q1", "asked", "answer").click();
  button("q1", "asked", "answer").click();
  expect([held.map((h) => h.name), sending("q1") === buttons("q1").length]).toEqual([["issue.comment"], true]);
  held.shift().go();
  expect(await until(() => held.length === 1)).toBe(true);
  expect([held[0].name, said("q1", "Take the first way"), kept("q1").labels]).toEqual(["issue.label", 1, ["needs-owner"]]);
  held.shift().go();
  // The press has ended when its box is emptied: that is after the service's answer, which is after the row has left.
  expect(await until(() => !panel.waiting().includes("q1") && kept("q1").labels.length === 0 && b1.value === "")).toBe(true);
  expect(said("q1", "Take the first way")).toBe(1);
  // The comment dropped by the network: nothing is written, and the row has its box, its text and armed buttons.
  panel.scrub("q2");
  const b2 = box("q2");
  type("q2", "the second reading");
  button("q2", "asked", "answer").click();
  held.shift().fail();
  expect(await until(() => sending("q2") === 0 && panel.textContent.includes("issue.comment was refused"))).toBe(true);
  expect([box("q2") === b2, b2.value, said("q2", "the second reading"), kept("q2").labels, button("q2", "asked", "answer").disabled, held.length]).toEqual([true, "the second reading", 0, ["needs-owner"], false, 0]);
  // The comment taken and the label dropped, with another caller's comment arriving between: the answer is recorded
  // once, the box is emptied so a second press is not a second comment, and the row is back for the label alone.
  button("q2", "asked", "answer").click();
  held.shift().go();
  expect(await until(() => held.length === 1 && said("q2", "the second reading") === 1)).toBe(true);
  await rig.a("comment", { id: "q2", body: "said while it was sent" });
  await panel.sync();
  // The label's press had taken q2 out of the block, and q3 was shown in its place: refused, q2 is the one shown again.
  expect([panel.waiting(), panel.shown()]).toEqual([["a1", "q3", "s1"], "q3"]);
  held.shift().fail();
  expect(await until(() => panel.shown() === "q2" && sending("q2") === 0 && panel.textContent.includes("issue.label was refused") && row("q2").textContent.includes("said while it was sent"))).toBe(true);
  expect([box("q2") === b2, b2.value, said("q2", "the second reading"), kept("q2").labels, button("q2", "asked", "answer").disabled, button("q2", "off", "needs-owner").disabled]).toEqual([true, "", 1, ["needs-owner"], true, false]);
  hold = false;
  // Approve is one press of the button that says so.
  panel.scrub("a1");
  button("a1", "asked", "approve").click();
  expect(await until(() => !panel.waiting().includes("a1") && kept("a1").state === "done")).toBe(true);
  expect([panel.waiting(), panel.shown()]).toEqual([["q2", "q3", "s1"], "q2"]);
  expect([...panel.attention.querySelectorAll("[data-heading]")].map((h) => h.textContent)).toEqual(["To answer (2)", "Security (1)"]);
  end();
  return "5 rows: approvals, answers, security, by id; the id first, then what is asked; buttons named for the move, the asked one first; Answer is a comment and the label off in one press";
}
// %%
test_issues_panel_says_when_a_newer_one_is_deployed = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "d1", title: "Any", kind: "task" });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const A = "a".repeat(64), B = "b".repeat(64);
  // getInfo is the kernel's, for anyone: what a Worker runs now. The rest is the tracker's. One client a panel,
  // each with its own count of getInfo calls, counted when the call is made.
  const kernel = () => {
    const k = { asked: [], running: A, down: false };
    k.client = {
      query: (name, params = {}) => (name === "getInfo" ? (k.asked.push(params.worker), k.down ? Promise.reject(new Error("getInfo 502")) : Promise.resolve({ name: params.worker, hash: k.running })) : rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok)),
      procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok)
    };
    return k;
  };
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  const press = (text, root) => [...root.querySelectorAll("button")].find((b) => b.textContent.trim() === text).click();
  const none = { get: () => null, set: () => null };
  // A panel that does not listen, for everything that counts calls or reads what check() answers: a listening
  // panel hears every visibilitychange and focus of the page the test runs in (another test's, or the owner coming
  // back to the tab), and each one is a call more and makes the counted call no longer the last.
  const k = kernel();
  let end = null, reloads = 0;
  const panel = issuesPanel({ client: k.client, owner: true, every: 1e9, invalidation: new Promise((r) => (end = r)), store: none, joined: A, reload: () => reloads++, listen: false });
  await panel.sync();
  // The Worker runs what the page joined: asked, the panel says nothing.
  expect([k.asked.length, await panel.check(), k.asked, panel.newer.textContent, panel.newer.querySelectorAll("button").length]).toEqual([0, false, ["brain-x-issues"], "", 0]);
  // A deploy while the page is open. Nothing on the page changes until it asks again.
  k.running = B;
  await new Promise((r) => setTimeout(r, 30));
  expect([k.asked.length, panel.newer.textContent]).toEqual([1, ""]);
  // Refresh asks: one line with both hashes, and a button that loads the page again.
  press("Refresh", panel);
  expect(await until(() => panel.newer.textContent !== "")).toBe(true);
  expect(k.asked.length).toBe(2);
  expect(panel.newer.textContent).toContain("A newer panel is deployed: brain-x-issues is bbbbbbbbbbbb, this page has aaaaaaaaaaaa.");
  expect(panel.textContent).toContain("A newer panel is deployed");
  press("Reload", panel.newer);
  expect(reloads).toBe(1);
  // An answer that fails leaves the line as it was.
  k.down = true;
  expect(await panel.check()).toBe(true);
  expect(panel.newer.textContent).toContain("A newer panel is deployed");
  // The Worker put back to what the page has: the line goes.
  k.down = false;
  k.running = A;
  expect(await panel.check()).toBe(false);
  expect([panel.newer.textContent, k.asked.length]).toEqual(["", 4]);
  end();
  // With no hash to compare (a copy opened from a file) getInfo is never asked, and such a panel does not listen.
  const k2 = kernel();
  let end2 = null;
  const local = issuesPanel({ client: k2.client, owner: true, every: 1e9, invalidation: new Promise((r) => (end2 = r)), store: none });
  await local.sync();
  press("Refresh", local);
  globalThis.dispatchEvent(new Event("focus"));
  expect(await local.check()).toBe(false);
  expect([k2.asked.length, local.newer.textContent]).toEqual([0, ""]);
  end2();
  // A panel that listens, as the page's does. Other events of the page reach it too, so nothing here is an exact
  // count while it listens: each step sets what the Worker runs, sends one event and waits for the line that
  // any question asked after the step ends in.
  const h = kernel();
  let end4 = null;
  const heard = issuesPanel({ client: h.client, owner: true, every: 1e9, invalidation: new Promise((r) => (end4 = r)), store: none, joined: A, reload: () => null });
  await heard.sync();
  // It asks when it is made.
  expect(await until(() => h.asked.length >= 1)).toBe(true);
  expect([h.asked[0], heard.newer.textContent]).toEqual(["brain-x-issues", ""]);
  // The tab shown again asks: the line comes.
  h.running = B;
  document.dispatchEvent(new Event("visibilitychange"));
  expect(await until(() => heard.newer.textContent !== "")).toBe(true);
  expect(heard.newer.textContent).toContain("brain-x-issues is bbbbbbbbbbbb, this page has aaaaaaaaaaaa.");
  // The window given the focus asks: the line goes.
  h.running = A;
  globalThis.dispatchEvent(new Event("focus"));
  expect(await until(() => heard.newer.textContent === "")).toBe(true);
  // A panel that has ended asks no more. The count is read after it ended: from then no event reaches it.
  end4();
  await new Promise((r) => setTimeout(r, 0));
  const ended = h.asked.length;
  document.dispatchEvent(new Event("visibilitychange"));
  globalThis.dispatchEvent(new Event("focus"));
  await new Promise((r) => setTimeout(r, 30));
  expect(h.asked.length).toBe(ended);
  // From here the page's side is a function, as the page passes it, and getInfo can be slow. This panel does not
  // listen either.
  const C = "c".repeat(64);
  // Each getInfo takes the next [milliseconds, hash] of `answers`; with none left it answers `running` at once.
  const answers = [];
  let asked2 = 0, running = A;
  const client2 = {
    query: (name, params = {}) => {
      if (name !== "getInfo") return rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok);
      asked2++;
      const [ms, hash] = answers.shift() || [0, running];
      return new Promise((r) => setTimeout(() => r({ name: params.worker, hash }), ms));
    },
    procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok)
  };
  // What the page has is read at each question: the page's own record of what it loaded moves when the page deploys.
  let has = A, end3 = null;
  const panel2 = issuesPanel({ client: client2, owner: true, every: 1e9, invalidation: new Promise((r) => (end3 = r)), store: none, joined: () => has, reload: () => null, listen: false });
  await panel2.sync();
  expect([asked2, await panel2.check(), asked2, panel2.newer.textContent]).toEqual([0, false, 1, ""]);
  // The page itself deploys B and loads it: the Worker runs B and so does the page. No line.
  running = has = B;
  expect([await panel2.check(), panel2.newer.textContent]).toEqual([false, ""]);
  // Someone else deploys C: the line names what the page has now, B, not what it had when it opened.
  running = C;
  expect(await panel2.check()).toBe(true);
  expect(panel2.newer.textContent).toContain("A newer panel is deployed: brain-x-issues is cccccccccccc, this page has bbbbbbbbbbbb.");
  // The page loads C while a question is on its way: the answer is compared with what the page has when it lands.
  answers.push([60, C]);
  const late = panel2.check();
  has = C;
  expect([await late, panel2.newer.textContent]).toEqual([false, ""]);
  // Two questions at once (a tab shown again sends visibilitychange and focus together). The first is answered B
  // after 150 ms, the second C at once: the line is for the question asked last, whichever answer lands last.
  answers.push([150, B], [0, C]);
  const both = [panel2.check(), panel2.check()];
  expect(await Promise.all(both)).toEqual([false, false]);
  expect(panel2.newer.textContent).toBe("");
  // The other way round: the first answered C late, the second B at once. The line stays.
  answers.push([150, C], [0, B]);
  expect(await Promise.all([panel2.check(), panel2.check()])).toEqual([true, true]);
  expect(panel2.newer.textContent).toContain("brain-x-issues is bbbbbbbbbbbb, this page has cccccccccccc.");
  // With nothing known of what the page has, nothing is asked.
  const before2 = asked2;
  has = null;
  expect([await panel2.check(), asked2]).toEqual([false, before2]);
  end3();
  // What the page passes: its own record of the module it loaded from the Worker, and the deployer's list until there is one.
  const listed = { modules: [{ module: "@tomlarkworthy/brain-issues", worker: "brain-x-issues", hash: A }] };
  const loaded = { "@tomlarkworthy/brain-ai": { worker: "brain-x-ai", hash: C }, "@tomlarkworthy/brain-issues": { worker: "brain-x-issues", hash: B } };
  expect([issuesJoinedAt(listed, loaded), issuesJoinedAt(listed, {}), issuesJoinedAt(listed), issuesJoinedAt(null, loaded), issuesJoinedAt(null, {})]).toEqual([B, A, A, B, null]);
  expect([issuesJoinedAt({ modules: [{ module: "@tomlarkworthy/brain-ai", worker: "brain-x-ai", hash: B }, { module: "@tomlarkworthy/brain-issues", worker: "brain-x-issues", hash: A }] }), issuesJoinedAt({ error: "the deployer answered 500", modules: [] })]).toEqual([A, null]);
  return "nothing said while the hashes agree; a line and Reload after a deploy, on Refresh, on the tab shown and on focus; a failed answer changes nothing; the line compares with what the page has when the answer lands; of two questions at once the one asked last decides";
}
// %%
test_issues_panel_keeps_the_caret_in_a_row_box = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "c1", title: "Typed in", kind: "task", labels: ["needs-owner"] });
  await rig.owner("open", { id: "c2", title: "Beside it", kind: "task", labels: ["needs-owner"] });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  // `got` has the id of each issue.get that was answered, written a task after the answer: the panel has drawn it by then.
  const got = [], gets = (id) => got.filter((x) => x === id).length;
  const client = { query: (name, params = {}) => { const r = rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok); if (name === "issue.get") r.then(() => setTimeout(() => got.push(params.id), 0), () => null); return r; }, procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok) };
  let end = null;
  const panel = issuesPanel({ client, owner: true, every: 1e9, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null } });
  const row = (id) => [...panel.attention.querySelectorAll("[data-attention]")].find((r) => r.dataset.attention === id);
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  // The caret is the document's: the panel has to be in it.
  document.body.append(panel);
  try {
    await panel.sync();
    // c1 is the issue shown, from here to the end: showing another would take its box out of the document.
    expect(await until(() => row("c1").textContent.includes("opened") && gets("c2") === 1)).toBe(true);
    const box = row("c1").querySelector("input");
    box.focus();
    box.value = "half a line";
    box.setSelectionRange(2, 6);
    const caret = () => [row("c1").querySelector("input") === box, box.value, document.activeElement === box, box.selectionStart, box.selectionEnd];
    expect(caret()).toEqual([true, "half a line", true, 2, 6]);
    // Another caller's comment on the issue being typed in: its row is made again by the sync, and once more when issue.get answers.
    await rig.a("comment", { id: "c1", body: "said meanwhile" });
    await panel.sync();
    expect(caret()).toEqual([true, "half a line", true, 2, 6]);
    expect(await until(() => row("c1").textContent.includes("said meanwhile"))).toBe(true);
    expect(caret()).toEqual([true, "half a line", true, 2, 6]);
    // An event on the issue after it, whose row is made again out of the document when issue.get answers: the order is as it was.
    await rig.a("comment", { id: "c2", body: "and here" });
    await panel.sync();
    expect(await until(() => gets("c2") === 2)).toBe(true);
    expect([panel.waiting(), panel.shown()]).toEqual([["c1", "c2"], "c1"]);
    expect(caret()).toEqual([true, "half a line", true, 2, 6]);
    // An issue that comes to wait before it: the place is one further on, and the issue shown is the same.
    await rig.owner("open", { id: "c0", title: "Came later", kind: "task", labels: ["needs-owner"] });
    await panel.sync();
    expect([panel.waiting(), panel.shown(), panel.attention.querySelector("[data-scrub=place]").textContent]).toEqual([["c0", "c1", "c2"], "c1", "2 of 3"]);
    expect(caret()).toEqual([true, "half a line", true, 2, 6]);
  } finally {
    end();
    panel.remove();
  }
  return "the box of the shown issue keeps the caret and the selection when its row is made again, and when an issue comes to wait before it";
}
// %%
test_issues_panel_a_second_press_writes_once = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "d1", title: "Pressed twice", kind: "task", labels: ["needs-owner"] });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const held = [];
  let refuse = false;
  const client = {
    query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok),
    // Each write waits until the test lets it go.
    procedure: (name, body) => new Promise((go) => held.push(go)).then(() => (refuse ? Promise.reject(new Error("not now")) : rig.owner(name.replace("issue.", ""), body).then(ok)))
  };
  let end = null;
  const panel = issuesPanel({ client, owner: true, every: 1e9, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null } });
  const row = () => [...panel.attention.querySelectorAll("[data-attention]")].find((r) => r.dataset.attention === "d1");
  const buttons = () => [...row().querySelectorAll("button")];
  const comment = () => buttons().find((b) => b.dataset.say === "comment");
  const type = (text) => {
    const input = row().querySelector("input");
    input.value = text;
    input.dispatchEvent(new Event("input", { bubbles: true }));
  };
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  const said = (body) => rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.id === "d1" && e.type === "commented" && e.body === body).length;
  await panel.sync();
  expect(await until(() => row().textContent.includes("opened"))).toBe(true);
  type("once only");
  expect(buttons().length).toBeGreaterThan(2);
  comment().click();
  // Until the service answers, every button of the row is disabled, and a second press sends nothing.
  expect(buttons().map((b) => b.disabled).includes(false)).toBe(false);
  comment().click();
  for (const b of buttons()) b.click();
  expect(held.length).toBe(1);
  // What is typed meanwhile is kept, and does not arm the buttons.
  type("once only, and more");
  expect(buttons().map((b) => b.disabled).includes(false)).toBe(false);
  held.shift()();
  expect(await until(() => said("once only") === 1 && !comment().disabled)).toBe(true);
  expect([row().querySelector("input").value, held.length, said("once only")]).toEqual(["once only, and more", 0, 1]);
  // The row sends again once the service has answered: a refusal keeps the text and arms the buttons too.
  refuse = true;
  comment().click();
  expect(comment().disabled).toBe(true);
  held.shift()();
  expect(await until(() => !comment().disabled)).toBe(true);
  expect([row().querySelector("input").value, panel.textContent.includes("issue.comment was refused: not now"), said("once only, and more")]).toEqual(["once only, and more", true, 0]);
  refuse = false;
  comment().click();
  comment().click();
  expect(held.length).toBe(1);
  held.shift()();
  expect(await until(() => said("once only, and more") === 1 && row().querySelector("input").value === "" && comment().disabled)).toBe(true);
  expect(rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.id === "d1" && e.type === "commented").length).toBe(2);
  end();
  return "a second press of Comment before the answer sends nothing; one event for each line; the row sends again after an answer and after a refusal";
}
// %%
test_issues_panel_a_refused_write_gives_the_row_back = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "r1", title: "Label kept", kind: "task", labels: ["needs-owner"] });
  await rig.owner("open", { id: "r2", title: "Move refused", kind: "task", labels: ["needs-owner"] });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const held = [];
  const client = {
    query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok),
    // Each write waits until the test sends it on, or fails it as a network that dropped it.
    procedure: (name, body) => new Promise((go, fail) => held.push({ go, fail: () => fail(new Error("Failed to fetch")) })).then(() => rig.owner(name.replace("issue.", ""), body).then(ok))
  };
  let end = null;
  const panel = issuesPanel({ client, owner: true, every: 1e9, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null } });
  const row = (id) => [...panel.attention.querySelectorAll("[data-attention]")].find((r) => r.dataset.attention === id);
  const box = (id) => row(id).querySelector("input");
  const buttons = (id) => [...row(id).querySelectorAll("button")];
  const button = (id, name, value) => buttons(id).find((b) => b.dataset[name] === value);
  const sending = (id) => buttons(id).filter((b) => b.disabled && b.title === "Being sent.").length;
  const type = (id, text) => {
    box(id).value = text;
    box(id).dispatchEvent(new Event("input", { bubbles: true }));
  };
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  const kept = (id) => JSON.parse(rig.db.view.get(id).issue);
  const said = (id, body) => rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.id === id && e.type === "commented" && e.body === body).length;
  await panel.sync();
  expect([panel.waiting(), panel.shown()]).toEqual([["r1", "r2"], "r1"]);
  expect(await until(() => row("r1").textContent.includes("opened"))).toBe(true);
  // − needs-owner takes the issue out of the block at the press. The network drops the write: the row is back with
  // the same box and its text, and its buttons are armed, not left at "Being sent.".
  const b1 = box("r1");
  type("r1", "a line I was writing");
  button("r1", "off", "needs-owner").click();
  // While the write is on its way the issue after it is shown. Refused, the issue of the press is shown again.
  expect([!!row("r1"), held.length, panel.waiting(), panel.shown()]).toEqual([false, 1, ["r2"], "r2"]);
  held.shift().fail();
  expect(await until(() => panel.shown() === "r1" && sending("r1") === 0)).toBe(true);
  expect([box("r1") === b1, b1.value, sending("r1"), button("r1", "off", "needs-owner").disabled, button("r1", "say", "comment").disabled]).toEqual([true, "a line I was writing", 0, false, false]);
  expect(panel.textContent).toContain("issue.label was refused: Failed to fetch");
  // The same after a sync, and nothing was written.
  await panel.sync();
  expect([box("r1") === b1, b1.value, sending("r1"), button("r1", "off", "needs-owner").disabled, kept("r1").labels]).toEqual([true, "a line I was writing", 0, false, ["needs-owner"]]);
  // A move that closes the issue, refused, with another caller's comment arriving while the write is on its way: the row
  // that comes back is a new one, with the same box.
  panel.scrub("r2");
  expect(await until(() => row("r2").textContent.includes("opened"))).toBe(true);
  const b2 = box("r2");
  type("r2", "because of X");
  button("r2", "to", "rejected").click();
  expect([!!row("r2"), held.length, panel.shown()]).toEqual([false, 1, "r1"]);
  await rig.a("comment", { id: "r2", body: "said while it was sent" });
  await panel.sync();
  expect([!!row("r2"), panel.shown()]).toEqual([false, "r1"]);
  held.shift().fail();
  expect(await until(() => panel.shown() === "r2" && sending("r2") === 0 && row("r2").textContent.includes("said while it was sent"))).toBe(true);
  expect([box("r2") === b2, b2.value, sending("r2"), button("r2", "to", "rejected").disabled, kept("r2").state]).toEqual([true, "because of X", 0, false, "open"]);
  expect(panel.textContent).toContain("issue.move was refused: Failed to fetch");
  // Two issues send on their own, the second pressed after the owner went on to it, and the answers come in the other
  // order: each row is armed by its own answer, and a comment that is taken does not change which issue is shown.
  panel.scrub("r1");
  type("r1", "first pressed");
  button("r1", "say", "comment").click();
  expect([held.length, sending("r1") === buttons("r1").length]).toEqual([1, true]);
  panel.scrub("r2");
  type("r2", "second pressed");
  button("r2", "say", "comment").click();
  expect([held.length, sending("r2") === buttons("r2").length]).toEqual([2, true]);
  held.pop().go();
  expect(await until(() => said("r2", "second pressed") === 1 && b2.value === "" && sending("r2") === 0)).toBe(true);
  expect(panel.shown()).toBe("r2");
  panel.scrub("r1");
  expect([said("r1", "first pressed"), b1.value, sending("r1") === buttons("r1").length]).toEqual([0, "first pressed", true]);
  panel.scrub("r2");
  held.pop().go();
  expect(await until(() => said("r1", "first pressed") === 1 && b1.value === "")).toBe(true);
  expect(panel.shown()).toBe("r2");
  panel.scrub("r1");
  expect(await until(() => sending("r1") === 0)).toBe(true);
  expect([box("r1") === b1, said("r1", "first pressed"), said("r2", "second pressed"), held.length]).toEqual([true, 1, 1, 0]);
  panel.scrub("r2");
  expect(box("r2") === b2).toBe(true);
  // The press that was refused is made again and taken: the label is off and the row stays out.
  panel.scrub("r1");
  button("r1", "off", "needs-owner").click();
  held.shift().go();
  expect(await until(() => !panel.waiting().includes("r1") && kept("r1").labels.length === 0)).toBe(true);
  await panel.sync();
  expect([panel.waiting(), panel.shown(), !!row("r2")]).toEqual([["r2"], "r2", true]);
  end();
  return "a refused label removal and a refused move give the row back with its box, its text and armed buttons; two rows answered out of order each take their own answer";
}
// %%
// R1, R2, R3 and the box of R7 of plan/cloud-brain-owner-acts-on-what-waits-for-him.md.
test_issues_panel_attention_shows_one_issue = {
  const rig = await issuesRig();
  const long = Array.from({ length: 30 }, (_, k) => `line ${k + 1} of the ask`).join("\n");
  const approval = async (id) => {
    await rig.inReview(id, { labels: ["major"] });
    await rig.b("review", { id, verdict: "pass", body: "tests run: 12 pass" });
    await rig.b("move", { id, to: "awaiting-approval" });
  };
  // Opened in an order that is neither the block's nor the ids'.
  await rig.owner("open", { id: "s1", title: "A leak", kind: "security" });
  await rig.owner("open", { id: "q3", title: "Asked later", kind: "task" });
  await rig.owner("open", { id: "q2", title: "Second question", kind: "task", body: "Which of the two readings?", labels: ["needs-owner"] });
  await rig.owner("open", { id: "q1", title: "First question", kind: "task", labels: ["needs-owner"] });
  await approval("a1");
  await rig.a("comment", { id: "q3", body: long });
  await rig.a("label", { id: "q3", add: ["needs-owner"] });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const client = { query: (name, params = {}) => rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok), procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok) };
  let end = null;
  const panel = issuesPanel({ client, owner: true, every: 1e9, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null } });
  // Read only: none of these moves the block.
  const drawn = () => [...panel.attention.querySelectorAll("[data-attention]")];
  const ids = () => drawn().map((r) => r.dataset.attention);
  const control = (name) => panel.attention.querySelector(`[data-scrub="${name}"]`);
  const place = () => control("place").textContent;
  const ends = () => [control("back").disabled, control("forward").disabled];
  const heads = () => [...panel.attention.querySelectorAll("[data-heading]")].map((h) => [h.textContent, h.getAttribute("aria-current")]);
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  try {
    // Nothing waits: no issue, and nothing to press.
    expect([ids(), panel.waiting(), panel.shown(), panel.attention.textContent.includes("Nothing waits for you."), ends()]).toEqual([[], [], null, true, [true, true]]);
    await panel.sync();
    // R1: five wait and one is in the block, the first. R2: the place, the ends, the count of each group.
    expect(panel.waiting()).toEqual(["a1", "q1", "q2", "q3", "s1"]);
    expect([ids(), panel.shown(), place(), ends(), panel.attention.textContent.includes("Nothing waits")]).toEqual([["a1"], "a1", "1 of 5", [true, false], false]);
    expect(heads()).toEqual([["To approve (1)", "true"], ["To answer (3)", null], ["Security (1)", null]]);
    // Forward four times shows each in order, and no other issue's text, box or buttons.
    const walk = [];
    for (let k = 0; k < 4; k++) {
      control("forward").click();
      walk.push([ids().join(), panel.shown(), place(), ends().join(), heads().filter((h) => h[1]).map((h) => h[0]).join(), panel.attention.querySelectorAll("input").length]);
    }
    expect(walk).toEqual([["q1", "q1", "2 of 5", "false,false", "To answer (3)", 1], ["q2", "q2", "3 of 5", "false,false", "To answer (3)", 1], ["q3", "q3", "4 of 5", "false,false", "To answer (3)", 1], ["s1", "s1", "5 of 5", "false,true", "Security (1)", 1]]);
    // A press at an end shows the same issue.
    control("forward").click();
    expect([ids(), place()]).toEqual([["s1"], "5 of 5"]);
    for (let k = 0; k < 6; k++) control("back").click();
    expect([ids(), place(), ends()]).toEqual([["a1"], "1 of 5", [true, false]]);
    // scrub shows an issue by id, and answers what is shown; an id that does not wait changes nothing.
    expect([panel.scrub("q3"), ids(), place()]).toEqual(["q3", ["q3"], "4 of 5"]);
    expect([panel.scrub("nobody"), panel.scrub(""), panel.scrub(), panel.shown(), ids()]).toEqual(["q3", "q3", "q3", "q3", ["q3"]]);
    // R3: an ask of 30 lines is whole, and nothing in the block has a height limit or scrolls.
    expect(await until(() => drawn()[0].textContent.includes("line 30 of the ask"))).toBe(true);
    expect(drawn()[0].querySelectorAll("[data-said]").length).toBeGreaterThan(0);
    expect([...panel.attention.querySelectorAll("*")].filter((n) => n.style.maxHeight || n.style.overflow || n.style.overflowY).length).toBe(0);
    // R7: what is typed in a box is there when its issue is shown again, in the same box.
    panel.scrub("q1");
    const box = drawn()[0].querySelector("input");
    box.value = "half a line";
    box.dispatchEvent(new Event("input", { bubbles: true }));
    control("forward").click();
    expect([ids(), panel.attention.contains(box), drawn()[0].querySelector("input").value]).toEqual([["q2"], false, ""]);
    control("back").click();
    expect([ids(), drawn()[0].querySelector("input") === box, box.value, drawn()[0].querySelector("[data-asked=answer]").disabled]).toEqual([["q1"], true, "half a line", false]);
    // An issue that comes to wait before the shown one: the same issue is shown, one place further on.
    await approval("a0");
    await panel.sync();
    expect([panel.waiting(), ids(), place(), drawn()[0].querySelector("input") === box, heads()]).toEqual([["a0", "a1", "q1", "q2", "q3", "s1"], ["q1"], "3 of 6", true, [["To approve (2)", null], ["To answer (3)", "true"], ["Security (1)", null]]]);
    // The shown issue stops waiting: the one that was after it is shown, at the same place.
    await rig.owner("label", { id: "q1", remove: ["needs-owner"] });
    await panel.sync();
    expect([panel.waiting(), ids(), place()]).toEqual([["a0", "a1", "q2", "q3", "s1"], ["q2"], "3 of 5"]);
    // The last one stops waiting while it is shown: the one that is now last.
    panel.scrub("s1");
    await rig.owner("move", { id: "s1", to: "rejected", reason: "not a leak" });
    await panel.sync();
    expect([panel.waiting(), ids(), place(), ends(), heads()]).toEqual([["a0", "a1", "q2", "q3"], ["q3"], "4 of 4", [false, true], [["To approve (2)", null], ["To answer (2)", "true"]]]);
  } finally {
    end();
  }
  return "of five waiting issues one is in the block; back and forward with the place and the count of each group; a 30-line ask with no height limit; the box of an issue keeps its text while another is shown";
}
// %%
// The panel's half of R4 and R5 of plan/cloud-brain-owner-acts-on-what-waits-for-him.md: what the block shows, read
// by another module, and a text put in the box of an issue with nothing sent.
test_issues_attention_part_says_what_is_shown = {
  const rig = await issuesRig();
  const long = Array.from({ length: 30 }, (_, k) => `line ${k + 1} of the ask`).join("\n");
  await rig.owner("open", { id: "s1", title: "A leak", kind: "security" });
  await rig.owner("open", { id: "q3", title: "Asked later", kind: "task" });
  await rig.owner("open", { id: "q2", title: "Second question", kind: "task", body: "Which of the two readings?", labels: ["needs-owner"] });
  await rig.owner("open", { id: "q1", title: "First question", kind: "task", labels: ["needs-owner"] });
  await rig.owner("open", { id: "w0", title: "Nobody waits", kind: "task" });
  await rig.inReview("a1", { labels: ["major"] });
  await rig.b("review", { id: "a1", verdict: "pass", body: "tests run: 12 pass" });
  await rig.b("move", { id: "a1", to: "awaiting-approval" });
  await rig.a("comment", { id: "q3", body: long });
  await rig.a("label", { id: "q3", add: ["needs-owner"] });
  await rig.b("comment", { id: "q3", body: "a later remark" });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  const held = [], writes = [];
  let hold = false;
  const clientOf = (as) => ({
    query: (name, params = {}) => as(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok),
    // Every write the panel sends is counted. While `hold` is set it waits until the test sends it on or drops it.
    procedure: (name, body) => (writes.push(name), hold ? new Promise((go, fail) => held.push({ name, go, fail: () => fail(new Error("Failed to fetch")) })) : Promise.resolve()).then(() => as(name.replace("issue.", ""), body).then(ok))
  });
  const ends = [];
  const panelOf = (as, by) => issuesPanel({ client: clientOf(as), owner: true, ...(by ? { by } : {}), every: 1e9, invalidation: new Promise((r) => ends.push(r)), store: { get: () => null, set: () => null } });
  const until = async (fn) => {
    for (let n = 0; n < 300 && !fn(); n++) await new Promise((r) => setTimeout(r, 10));
    return fn();
  };
  const thrown = (fn) => {
    try {
      return fn(), null;
    } catch (e) {
      return e.message;
    }
  };
  const panel = panelOf(rig.owner), part = issuesAttention(panel);
  // Read only: the row in the block, and the box of it.
  const row = () => panel.attention.querySelector("[data-attention]");
  const box = () => row().querySelector("input");
  try {
    // Nothing waits: nothing is shown, and no id has a box.
    expect([part.shown(), thrown(() => part.draft("q2", "B"))]).toEqual([null, "attention draft: q2 does not wait for the owner"]);
    await panel.sync();
    // The first, an approval: what is asked is the line of its group, and what it is asked about is the review that passed.
    expect(await until(() => !!part.shown().about)).toBe(true);
    expect(part.shown()).toEqual({ id: "a1", title: "a1", state: "awaiting-approval", kind: "task", group: "approve", ask: "Approve it, or reject it with a reason.", about: "pass: tests run: 12 pass", place: 1, of: 5 });
    // It follows scrub and the block's own buttons. An answer: the comment the label was put on with, all 30 lines,
    // not the remark made after it.
    panel.scrub("q3");
    expect(await until(() => !!part.shown().about)).toBe(true);
    expect(part.shown()).toEqual({ id: "q3", title: "Asked later", state: "open", kind: "task", group: "answer", ask: "Answer it: type the answer, then press Answer.", about: long, place: 4, of: 5 });
    panel.scrub("q2");
    expect(await until(() => !!part.shown().about)).toBe(true);
    expect([part.shown().id, part.shown().about, part.shown().place]).toEqual(["q2", "Which of the two readings?", 3]);
    // A security report is asked about nothing in particular: `about` is null, as for an issue opened with the label and no body.
    panel.attention.querySelector("[data-scrub=forward]").click();
    panel.attention.querySelector("[data-scrub=forward]").click();
    expect(await until(() => !!row().querySelector("[data-said]"))).toBe(true);
    expect(part.shown()).toEqual({ id: "s1", title: "A leak", state: "open", kind: "security", group: "security", ask: "A security report: read it, then move it.", about: null, place: 5, of: 5 });
    panel.scrub("q1");
    expect(await until(() => !!row().querySelector("[data-said]"))).toBe(true);
    expect([part.shown().id, part.shown().about]).toEqual(["q1", null]);
    // A draft: the text is in the box of that issue, the issue is shown, its buttons are armed, and nothing was sent.
    const events = rig.db.events.length;
    expect(part.draft("q2", "B")).toEqual({ id: "q2", drafted: true });
    const b2 = box();
    expect([part.shown().id, row().dataset.attention, b2.value, row().querySelector("[data-asked=answer]").disabled, row().querySelector("[data-say=comment]").disabled, rig.db.events.length - events, writes]).toEqual(["q2", "q2", "B", false, false, 0, []]);
    // A box that has text is not written over, by a second draft or over what the owner typed: the text is in the refusal.
    expect([thrown(() => part.draft("q2", "C")), b2.value]).toEqual(['attention draft: the box of q2 has text already: "B"', "B"]);
    panel.scrub("q1");
    const b1 = box();
    b1.value = "his own words";
    b1.dispatchEvent(new Event("input", { bubbles: true }));
    expect([thrown(() => part.draft("q1", "C")), b1.value, part.shown().id]).toEqual(['attention draft: the box of q1 has text already: "his own words"', "his own words", "q1"]);
    // An id that does not wait (none, unknown, an open issue nobody asked about), and a text that is none: nothing is
    // put anywhere and the block stays where it was.
    expect([thrown(() => part.draft("nobody", "C")), thrown(() => part.draft("w0", "C")), thrown(() => part.draft(undefined, "C")), thrown(() => part.draft("q3", "")), thrown(() => part.draft("q3", " \n ")), thrown(() => part.draft("q3", 5)), thrown(() => part.draft("q3")), part.shown().id]).toEqual([
      "attention draft: nobody does not wait for the owner", "attention draft: w0 does not wait for the owner", "attention draft: undefined does not wait for the owner",
      "attention draft: no text", "attention draft: no text", "attention draft: no text", "attention draft: no text", "q1"
    ]);
    // The box is one line: line breaks in the text become spaces.
    expect(part.draft("q3", "  first line\r\n second line\n\nthird ")).toEqual({ id: "q3", drafted: true });
    expect([part.shown().id, box().value]).toEqual(["q3", "first line second line third"]);
    // Another caller's event on a drafted issue draws its row again: the same box with the draft.
    await rig.a("comment", { id: "q2", body: "said after the draft" });
    await panel.sync();
    panel.scrub("q2");
    expect(await until(() => row().textContent.includes("said after the draft"))).toBe(true);
    expect([box() === b2, b2.value, row().querySelector("[data-asked=answer]").disabled]).toEqual([true, "B", false]);
    // A press of the owner's that takes an issue out of the block, on its way: the issue does not wait, so no draft.
    // Dropped by the network, the issue is back, and a draft goes in its emptied box.
    panel.scrub("q1");
    b1.value = "";
    b1.dispatchEvent(new Event("input", { bubbles: true }));
    hold = true;
    row().querySelector("[data-off=needs-owner]").click();
    expect([held.map((h) => h.name), panel.waiting().includes("q1"), thrown(() => part.draft("q1", "C")), b1.value]).toEqual([["issue.label"], false, "attention draft: q1 does not wait for the owner", ""]);
    held.shift().fail();
    expect(await until(() => part.shown().id === "q1" && panel.textContent.includes("issue.label was refused") && !row().querySelector("[data-off=needs-owner]").disabled)).toBe(true);
    hold = false;
    expect([part.draft("q1", "C"), box() === b1, b1.value, row().querySelector("[data-asked=answer]").disabled]).toEqual([{ id: "q1", drafted: true }, true, "C", false]);
    // The draft is sent by a press, and by nothing before it: the one write so far is the owner's label, and the
    // press of Answer sends the comment with the drafted text.
    expect(writes).toEqual(["issue.label"]);
    row().querySelector("[data-asked=answer]").click();
    expect(await until(() => !panel.waiting().includes("q1") && b1.value === "")).toBe(true);
    expect([writes, rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.id === "q1" && e.type === "commented").map((e) => e.body)]).toEqual([["issue.label", "issue.comment", "issue.label"], ["C"]]);
    // A caller who is not shown an issue has no box for it: it is said to be hidden, and nothing more of it.
    const token = panelOf(rig.a, { caller: "token:a", via: "" }), theirs = issuesAttention(token);
    await token.sync();
    token.scrub("s1");
    expect(theirs.shown()).toEqual({ id: "s1", title: null, state: "open", kind: "security", group: "hidden", ask: "", about: null, place: token.waiting().indexOf("s1") + 1, of: token.waiting().length });
    expect(thrown(() => theirs.draft("s1", "C"))).toBe("attention draft: s1 is not shown to this caller and has no box");
    // What the page has in the panel's place when nobody is signed in, and nothing at all: nothing shown, no draft.
    for (const none of [issuesPanel({ store: { get: () => null, set: () => null } }), null]) {
      const p = issuesAttention(none);
      expect([p.shown(), thrown(() => p.draft("q2", "B"))]).toEqual([null, "attention draft: no panel of the owner on this page"]);
    }
  } finally {
    for (const end of ends) end();
  }
  return "what the block shows as data: id, title, state, kind, group, the ask and what it is about, the place; a draft is put in an empty box of a waiting issue, shows it, arms its buttons and sends nothing";
}
// %%
// The page's own block is in the plugin set once the cell that offers it has run. Reads only: what it shows depends on who is signed in.
test_issues_attention_is_offered_by_name = {
  issues_attention;
  const set = plugins.get("attention");
  try {
    const parts = await set.next().value;
    expect(parts.filter((p) => p && typeof p.shown === "function" && typeof p.draft === "function").length).toBeGreaterThan(0);
  } finally {
    set.return();
  }
  return "plugins.get(\"attention\") has a part with shown and draft";
}
// %%
// R1 and R8 of plan/cloud-brain-locks-held-in-the-cluster.md: a lock is a call, it is listed, and how long it was held is read back.
test_issues_lock_is_taken_listed_and_released = {
  const rig = await issuesRig(), L = issuesLimits, t0 = Date.now();
  const took = await rig.a("lock", { name: "probe-x", who: "w1", seconds: 30 });
  expect(took.status).toBe(200);
  expect(took.data).toEqual({ held: true, name: "probe-x", who: "w1", n: 1, taken: took.data.taken, until: took.data.taken + 30000 });
  expect(took.data.taken >= t0 && took.data.taken <= Date.now()).toBe(true);
  const listed = (await rig.b("locks")).data;
  expect([listed.locks, listed.ended, listed.history]).toEqual([[{ name: "probe-x", who: "w1", n: 1, taken: took.data.taken, until: took.data.until }], [], []]);
  expect(listed.now >= took.data.taken).toBe(true);
  // With no seconds the lock is for the limit's default. A Worker of the Brain takes one as a token does.
  const plain = (await rig.worker("lock", { name: "cb4", who: "lk-1" })).data;
  expect(plain.until - plain.taken).toBe(L.lockSeconds * 1000);
  const bad = [{ name: "Probe", who: "a" }, { name: "x".repeat(L.lockName + 1), who: "a" }, { who: "a" }, { name: "p", who: "" }, { name: "p" }, { name: "p", who: "a b" }, { name: "p", who: "w".repeat(L.lockWho + 1) }, { name: "p", who: "a", seconds: L.lockMin - 1 }, { name: "p", who: "a", seconds: L.lockMax + 1 }, { name: "p", who: "a", seconds: "60" }, { name: "p", who: "a", renew: "true" }, { name: "p", who: "a", renew: true, release: true }, { name: "p", who: "a", force: true }];
  for (const body of bad) expect([body, (await rig.a("lock", body)).status]).toEqual([body, 400]);
  expect([(await rig.a("locks?history=x")).status, (await rig.a("locks?history=" + (L.lockHistory + 1))).status]).toEqual([400, 400]);
  // A refused call made no row.
  expect([...rig.db.locks.keys()]).toEqual(["probe-x", "cb4"]);
  const t1 = Date.now(), gone = await rig.a("lock", { name: "probe-x", who: "w1", release: true });
  expect([gone.status, gone.data]).toEqual([200, { held: false, name: "probe-x", who: "w1", n: 1, taken: took.data.taken, ended: gone.data.ended, how: "released" }]);
  expect(gone.data.ended >= t1 && gone.data.ended <= Date.now()).toBe(true);
  const after = (await rig.a("locks?history=50")).data;
  expect([after.locks.map((l) => l.name), after.ended, after.history]).toEqual([["cb4"], [], [{ name: "probe-x", who: "w1", n: 1, taken: took.data.taken, ended: gone.data.ended, how: "released" }]]);
  // history=0 and none asked: no rows. The lock wrote no event, so the signed record is as it was: empty.
  expect([(await rig.a("locks?history=0")).data.history, (await rig.a("locks")).data.history, rig.db.events.length]).toEqual([[], [], 0]);
  return "taken for 30 s and for the default, listed, released; " + bad.length + " bad bodies are 400; no event written";
}
// %%
// R2: a held name is refused to every taker, the holder's own name and token among them, and of 20 takers of a free name one holds it.
test_issues_lock_held_is_refused_to_every_taker = {
  const rig = await issuesRig();
  const first = (await rig.a("lock", { name: "land", who: "a" })).data;
  const holder = { who: "a", taken: first.taken, until: first.until };
  const other = await rig.b("lock", { name: "land", who: "b" }), again = await rig.a("lock", { name: "land", who: "a" });
  // The status and the holder are read through the app: a refusal is thrown, and run spreads its body.
  expect([other.status, other.data]).toEqual([409, { held: false, holder, error: "Held", message: "land is held by a" }]);
  expect([again.status, again.data]).toEqual([409, other.data]);
  expect([rig.db.locks.get("land").n, rig.db.history.length]).toEqual([1, 0]);
  // 20 at once for one free name, each under a name of its own. The fake runs a batch a statement at a time, so this
  // shows the rule (a write that changed a row, or the 409) and not that brain-db runs the batch as one step.
  const many = await Promise.all(Array.from({ length: 20 }, (_, i) => (i % 2 ? rig.a : rig.b)("lock", { name: "probe-x", who: "w" + (i + 1), seconds: 30 })));
  const won = many.filter((r) => r.status === 200 && r.data.held === true), lost = many.filter((r) => r.status === 409);
  expect([won.length, lost.length, rig.db.locks.get("probe-x").n]).toEqual([1, 19, 1]);
  expect([...new Set(lost.map((r) => r.data.holder.who))]).toEqual([won[0].data.who]);
  // No other refusal of the Worker gained a field: a 400 is error and message.
  expect(Object.keys((await rig.a("lock", { name: "land" })).data).sort()).toEqual(["error", "message"]);
  return "409 with the holder to another name and to the holder's own; 1 of 20 takers holds a free name";
}
// %%
// R4, the next taker and the reader: a lock past its until is in `ended` for a reader and is taken over by the next take.
test_issues_lock_past_its_until_is_taken_over = {
  const rig = await issuesRig();
  const first = (await rig.a("lock", { name: "land", who: "a", seconds: 5 })).data;
  const live = (await rig.b("locks")).data;
  expect([live.locks.map((l) => l.who), live.ended]).toEqual([["a"], []]);
  // The holder died: its lock's end is in the past. A test does not wait for it (the prose above).
  const past = first.taken - 1000;
  Object.assign(rig.db.locks.get("land"), { taken: past - 5000, until: past });
  const read = (await rig.b("locks?history=10")).data;
  expect([read.locks, read.ended, read.history]).toEqual([[], [{ name: "land", who: "a", n: 1, taken: past - 5000, until: past }], []]);
  const took = await rig.b("lock", { name: "land", who: "b" });
  expect([took.status, took.data]).toEqual([200, { held: true, name: "land", who: "b", n: 2, taken: took.data.taken, until: took.data.until, over: { who: "a", until: past } }]);
  const after = (await rig.a("locks?history=10")).data;
  // The history row's end is the lock's own until, not the time of the take that wrote it.
  expect([after.locks.map((l) => [l.who, l.n]), after.ended, after.history]).toEqual([[["b", 2]], [], [{ name: "land", who: "a", n: 1, taken: past - 5000, ended: past, how: "expired" }]]);
  // The dead holder's release, late: the lock is b's, and stays.
  const late = await rig.a("lock", { name: "land", who: "a", release: true });
  expect([late.status, late.data.holder.who, rig.db.locks.get("land").who]).toEqual([403, "b", "b"]);
  return "an ended lock is in ended, not in locks; the next take answers over and writes how: expired";
}
// %%
// R4, the rest of the table "A lock past its until": what each call answers for such a row, and for an emptied one.
test_issues_lock_past_its_until_each_call = {
  const rig = await issuesRig(), row = () => rig.db.locks.get("land");
  const end = () => {
    const past = Date.now() - 60000;
    Object.assign(row(), { taken: past - 5000, until: past });
    return past;
  };
  await rig.a("lock", { name: "land", who: "a" });
  // The holder's renew of its ended lock: renewed, n as it was, over with its own name, no history row.
  let past = end();
  const renewed = await rig.a("lock", { name: "land", who: "a", seconds: 60, renew: true });
  expect([renewed.status, renewed.data]).toEqual([200, { held: true, name: "land", who: "a", n: 1, taken: past - 5000, until: renewed.data.until, over: { who: "a", until: past } }]);
  expect([renewed.data.until > Date.now(), rig.db.history.length]).toEqual([true, 0]);
  // A renew of a live lock: no over. Another's renew, by name or by token, is 409 with the holder and changes nothing.
  const live = (await rig.a("lock", { name: "land", who: "a", seconds: 1800, renew: true })).data;
  expect([live.over, live.until > renewed.data.until, live.n]).toEqual([undefined, true, 1]);
  const others = [await rig.b("lock", { name: "land", who: "b", renew: true }), await rig.b("lock", { name: "land", who: "a", renew: true })];
  expect(others.map((r) => [r.status, r.data.error, r.data.held, r.data.holder.who])).toEqual([[409, "Held", false, "a"], [409, "Held", false, "a"]]);
  expect(row().until).toBe(live.until);
  // A take under the holder's own name and token, of its ended lock: a take as anyone's, n up, how: expired with the old until.
  past = end();
  const retook = (await rig.a("lock", { name: "land", who: "a" })).data;
  expect([retook.n, retook.over, rig.db.history.map((h) => [h.who, h.n, h.ended, h.how])]).toEqual([2, { who: "a", until: past }, [["a", 1, past, "expired"]]]);
  // A release by another of an ended lock is 403 with the holder, as for a live one. The holder's own is 200.
  past = end();
  const notMine = await rig.b("lock", { name: "land", who: "a", release: true });
  expect([notMine.status, notMine.data.error, notMine.data.holder]).toEqual([403, "Refused", { who: "a", taken: past - 5000, until: past }]);
  const t = Date.now(), released = await rig.a("lock", { name: "land", who: "a", release: true });
  expect([released.status, released.data.how, released.data.n, released.data.ended >= t]).toEqual([200, "released", 2, true]);
  expect(rig.db.history.map((h) => h.how)).toEqual(["expired", "released"]);
  // The emptied row: in neither list, and no renew takes it, nor a name that has no row.
  const empty = (await rig.a("locks")).data;
  expect([empty.locks, empty.ended, { ...row() }]).toEqual([[], [], { name: "land", who: "", actor: "", n: 2, taken: past - 5000, until: 0 }]);
  const free = [await rig.a("lock", { name: "land", who: "a", renew: true }), await rig.a("lock", { name: "never", who: "a", renew: true }), await rig.a("lock", { name: "land", who: "a", release: true })];
  expect(free.map((r) => [r.status, r.data.error, r.data.held, r.data.holder])).toEqual(Array(3).fill([409, "NotHeld", false, null]));
  expect([row().who, rig.db.locks.has("never")]).toEqual(["", false]);
  // The next take of it is a take of a free name: no over, no history row, n one above.
  const next = (await rig.b("lock", { name: "land", who: "b" })).data;
  expect([next.held, next.n, "over" in next, rig.db.history.length]).toEqual([true, 3, false, 2]);
  return "renew, take and release of an ended lock by its holder; 409 and 403 to another; an emptied row is free and keeps n";
}
// %%
// R5: a release by anyone but the holder is refused and names the holder, and the lock stays. The owner present ends one.
test_issues_lock_release_is_the_holders = {
  const rig = await issuesRig();
  const mine = (await rig.a("lock", { name: "land", who: "lk-1" })).data, holder = { who: "lk-1", taken: mine.taken, until: mine.until };
  // Another name; the holder's name from the reviewer's token; a Worker.
  const tries = [await rig.a("lock", { name: "land", who: "other", release: true }), await rig.b("lock", { name: "land", who: "lk-1", release: true }), await rig.worker("lock", { name: "land", who: "lk-1", release: true })];
  expect(tries.map((r) => [r.status, r.data.error, r.data.holder])).toEqual(Array(3).fill([403, "Refused", holder]));
  expect([(await rig.a("locks")).data.locks.map((l) => l.who), rig.db.history.length]).toEqual([["lk-1"], 0]);
  // force is the owner's in their own tab: not a token's, not the owner's token's.
  const viaToken = rig.as("owner", "delegation:abc");
  const forced = [await rig.a("lock", { name: "land", release: true, force: true }), await viaToken("lock", { name: "land", release: true, force: true })];
  expect(forced.map((r) => [r.status, r.data.message, "holder" in r.data])).toEqual(Array(2).fill([403, "the owner, present", false]));
  expect(rig.db.locks.get("land").who).toBe("lk-1");
  const t = Date.now(), ended = await rig.owner("lock", { name: "land", release: true, force: true });
  expect([ended.status, ended.data]).toEqual([200, { held: false, name: "land", who: "lk-1", n: 1, taken: mine.taken, ended: ended.data.ended, how: "forced" }]);
  expect(ended.data.ended >= t).toBe(true);
  // The holder's release after it: nothing is held, and nothing is written.
  const late = await rig.a("lock", { name: "land", who: "lk-1", release: true }), none = await rig.owner("lock", { name: "land", release: true, force: true });
  expect([late.status, late.data.holder, none.status, none.data.error]).toEqual([409, null, 409, "NotHeld"]);
  expect((await rig.a("locks?history=5")).data.history.map((h) => [h.name, h.who, h.how])).toEqual([["land", "lk-1", "forced"]]);
  return "403 with the holder to another name, another token and a Worker; force is the owner present";
}
