    // Taking a link off needs only that it is there: it narrows what is shown, whatever the other issue is by now.
    if (act.remove) return !(i.links || []).some((l) => l.rel === act.rel && l.to === act.to) ? no("no such link", true) : test(wf.link ?? wf.label, issue) ? { allow: true } : no("the workflow's link guard refuses");
    const tw = issueAt(view.workflows, t && t.workflow) || {};
