    for (const [name, hash] of Object.entries(e.hashes)) view.workflows[hash] = e.policy.workflows[name];
    return view;
  }
  const actor = issueActor(e.by);
  const closed = (i) => (((issueAt(view.workflows, i.workflow) || {}).closed || []).includes(i.state));
  if (e.type === "opened") {
    const i = { id: e.id, title: e.title, body: e.body, kind: e.kind, about: e.about, parent: e.parent || null, labels: e.labels || [], state: e.state, workflow: e.workflow, opener: actor, by: {}, reviews: [], extra: [], links: [], linked: [], closed: false, comments: 0, opened_at: e.at, updated_at: e.at, seq: e.seq };
    view.issues[e.id] = { ...i, closed: closed(i) };
    return view;
  }
  const i = issueAt(view.issues, e.id);
  if (!i || i.hidden) return view;
  // What a run cost is not work on the issue: updated_at, which issue.list is ordered by, is left.
  if (e.type !== "cost") i.updated_at = e.at;
  i.seq = e.seq;
  // One run for a role and round: the last cost event of it stands, whole.
  if (e.type === "cost") i.runs = [...(i.runs || []).filter((r) => r !== issueRunOf(i, e)), { ...Object.fromEntries(issuesLimits.cost.filter((k) => e[k] !== undefined).map((k) => [k, e[k]])), seq: e.seq, at: e.at }];
  if (e.type === "commented") i.comments++;
  if (e.type === "labelled") i.labels = [...new Set([...i.labels.filter((l) => !(e.remove || []).includes(l)), ...(e.add || [])])];
  if (e.type === "attached") i.attachments = [...(i.attachments || []), { name: e.name, mimeType: e.mimeType, size: e.size, sha256: e.sha256, seq: e.seq }];
  if (e.type === "reviewed") i.reviews.push({ actor, verdict: e.verdict });
  if (e.type === "moved") Object.assign(i, { state: e.to, by: { ...i.by, [e.move]: actor }, reviews: [] });
  if (e.type === "swapped") {
    Object.assign(i, { workflow: e.to.workflow, state: e.to.state, reviews: [] });
    // A swap can change who reads the issue. A link is read with either issue, so one to an issue now read by another
    // rule is dropped from both: it would name this issue to those who no longer read it.
    const read = (x) => (issueAt(view.workflows, x.workflow) || {}).read, other = (id) => issueAt(view.issues, id);
    const apart = (id) => !!other(id) && read(other(id)) !== read(i);
    for (const l of (i.links || []).filter((l) => apart(l.to))) other(l.to).linked = (other(l.to).linked || []).filter((x) => !(x.rel === l.rel && x.id === i.id));
    for (const l of (i.linked || []).filter((l) => apart(l.id))) other(l.id).links = (other(l.id).links || []).filter((x) => !(x.rel === l.rel && x.to === i.id));
