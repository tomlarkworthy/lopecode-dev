test_issues_declares_what_it_needs = {
  const { meta } = await issues_service.emit();
  expect(meta).toMatchObject({ worker: "brain-x-issues", role: "recipe", module: "@tomlarkworthy/brain-issues", resources: ["sql"], secrets: ["ISSUES_SIGNING_KEY"] });
  const methods = Object.keys(meta.access).sort().map((m) => m.replace("com.lopecode.brain.issue.", ""));
  expect(methods).toEqual(["comment", "get", "install", "key", "label", "list", "move", "narrow", "open", "policy", "rebuild", "review", "snapshot", "swap", "sync", "verify"]);
  const let_in = (who) => decide(meta.access["com.lopecode.brain.issue.open"], { caller: callerOf({ caller: who }), request: {} }).allow;
  expect(["owner", "token:a", "worker:brain-x-echo", "did:plc:other", "anonymous"].map(let_in)).toEqual([true, true, true, false, false]);
  // The default policy passes its own check.
  expect(Object.keys((await issuePolicyAct(issuesDefaultPolicy)).hashes)).toEqual(["task", "security", "feedback"]);
  // Without the key a write is refused and says which secret.
  const bare = await simulate(issues_service, { sql: issuesFakeSql().run });
  const r = await bare.fetch("https://issues.internal/xrpc/com.lopecode.brain.issue.open", { method: "POST", headers: { "x-brain-caller": "owner", "x-brain-via": "session", "content-type": "application/json" }, body: JSON.stringify({ key: "k", title: "x", kind: "task" }) });
  expect([r.status, (await r.json()).message]).toEqual([503, "the secret ISSUES_SIGNING_KEY is not set"]);
  return methods.length + " methods";
}
