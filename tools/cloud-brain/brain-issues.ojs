issueCount = (n, of = "") => String(n).replace(/\B(?=(\d{3})+(?!\d))/g, ",") + (of ? " " + of + (n === 1 ? "" : "s") : "")
// %%
// The sums of a usage, or of the totals of some runs, as text: the same five words in a run's line and in the totals.
issueUsageSaid = (u) => `in ${issueCount(u.input)}, written ${issueCount(u.cacheWrite)}, read ${issueCount(u.cacheRead)}, out ${issueCount(u.output)}, ${issueCount(u.requests, "request")}${u.advisor.calls ? ` · advisor ${issueCount(u.advisor.calls, "call")}` : ""}`
// %%
// A run as one line of text: a cost event, or a run of an issue's row. No I/O. usd is what the run reported, as it was
// sent. `replaced` is of the event alone.
issueRunSaid = (e) => [`${e.role} round ${e.round}, ${e.how}, ${e.outcome}`, issueCount(e.seconds) + " s", "context " + issueCount(e.context), e.usage ? "billed " + issueUsageSaid(e.usage) : "no usage", ...(e.usd !== undefined ? ["$" + e.usd] : []), ...(e.replaced ? ["replaces " + e.replaced] : [])].join(" · ")
// %%
// The totals of some runs (issueCost) as one line of text. No I/O.
issueCostSaid = (c) => [issueCount(c.runs, "run"), issueCount(c.seconds) + " s", c.billed ? `${issueCount(c.billed)} with a usage: ${issueUsageSaid(c)}` : "no usage", ...(c.usdRuns ? [`$${c.usd} of ${issueCount(c.usdRuns, "run")}`] : [])].join(" · ")
// %%
// The view after one more event. No I/O: the service, issue.rebuild, issue.verify and the page all make the view with it.
issueApply = (view, e) => {
  view.seq = e.seq;
