test_issues_rebuild_and_replay_judge_the_record = {
  const rig = await issuesRig();
  await rig.inReview("r1");
  await rig.owner("open", { id: "r2", title: "Other", kind: "feedback", labels: ["ui"] });
  const before = (await rig.owner("snapshot")).data;
  expect((await rig.a("rebuild", {})).status).toBe(403);
  rig.db.view.clear();
  rig.db.meta.clear();
  expect((await rig.owner("rebuild", {})).data).toEqual({ seq: before.seq, issues: 2 });
  expect((await rig.owner("snapshot")).data).toEqual(before);
  expect((await rig.owner("sync?after=99")).data).toMatchObject({ reset: true, wait: 5000 });
  expect((await rig.as("owner", "session", { "x-brain-settings": encodeURIComponent(JSON.stringify({ syncMs: 20000 })) })("sync?after=0")).data.wait).toBe(20000);
  // A closed issue's body is left out of a snapshot and is in issue.get.
  await rig.owner("move", { id: "r2", to: "closed" });
  expect((await rig.owner("snapshot")).data.issues.find((i) => i.id === "r2")).toMatchObject({ bodyLeftOut: true });
  // A move written past the service, chained and signed: the chain holds, and the replay names it.
  const wf = before.issues.find((i) => i.id === "r1").workflow;
  const forged = await rig.forge({ id: "r1", type: "moved", workflow: wf, move: "pass", from: "in-review", to: "done", reason: "", refs: [] });
  expect((await rig.owner("verify")).data).toMatchObject({ ok: true, seq: forged.seq });
  expect((await rig.owner("verify?guards=true")).data).toEqual({ ok: false, seq: forged.seq, why: "the guard of pass refuses", checked: forged.seq - 1 });
  return "the view made again equals the view kept; a forged pass is named";
}
// %%
test_issues_migrate_moves_what_is_still_there = {
  const rig = await issuesRig();
  for (const id of ["aaaaaaaaaa1", "aaaaaaaaaa2", "gone"]) await rig.owner("open", { id, title: id, kind: "feedback" });
  const { policy: was, workflows: flows } = (await rig.owner("policy")).data, old = was.names.feedback;
  const flow = { states: ["new", "closed"], start: "new", closed: ["closed"], read: "true", open: "true", comment: "true", label: "true", review: "false", narrow: "false", moves: [{ name: "close", from: "new", to: "closed", guard: "true" }], swaps: [] };
  const policy = { kinds: { feedback: "feedback" }, workflows: { feedback: flow } };
  // Another writer, past the service, with its row of the view: what a second caller does while an install runs.
  const other = async (fields) => {
    const e = await rig.forge(fields, { caller: "owner", via: "session" }), row = rig.db.view.get(e.id);
    const i = issueApply({ ...issueView(), workflows: flows, issues: row ? { [e.id]: JSON.parse(row.issue) } : {} }, e).issues[e.id];
    rig.db.view.set(i.id, { id: i.id, parent: i.parent, workflow: i.workflow, closed: i.closed ? 1 : 0, issue: JSON.stringify(i) });
  };
  // As the policy is written, "late" is opened on the old workflow. As the first swap is written, "gone" is closed.
  rig.db.hooks.push(
    () => other({ id: "late", type: "opened", workflow: old, title: "late", body: "", kind: "feedback", about: "brain", parent: null, labels: [], state: "open" }),
    () => null,
    () => other({ id: "gone", type: "moved", workflow: old, move: "close", from: "open", to: "closed", reason: "", refs: [] })
  );
  // A key at the limit: the swaps are keyed from the policy's seq, so two ids alike to their last letter are two events.
  const installed = (await rig.owner("install", { key: "k".repeat(issuesLimits.key - 8), policy, migrate: { [old]: { workflow: "feedback", states: { open: "new" } } } })).data;
  expect(installed).toMatchObject({ moved: ["aaaaaaaaaa1", "aaaaaaaaaa2", "late"], left: [{ id: "gone", why: "the issue is no longer where this swap takes it from" }] });
  const now = Object.fromEntries((await rig.owner("list")).data.issues.map((i) => [i.id, [i.state, i.workflow === installed.hashes.feedback, i.closed]]));
  expect(now).toEqual({ aaaaaaaaaa1: ["new", true, false], aaaaaaaaaa2: ["new", true, false], late: ["new", true, false], gone: ["closed", false, true] });
  const swaps = rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.type === "swapped");
  expect(swaps.map((e) => e.key)).toEqual(["aaaaaaaaaa1", "aaaaaaaaaa2", "late"].map((id) => `policy/${installed.seq}/${id}`));
  expect(swaps[0].from).toEqual({ workflow: old, state: "open" });
  // A swap written past the service that names another place than the issue was in is named by the replay.
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true });
  const forged = await rig.forge({ id: "late", type: "swapped", workflow: installed.hashes.feedback, swap: null, from: { workflow: installed.hashes.feedback, state: "closed" }, to: { workflow: installed.hashes.feedback, state: "new" }, reason: "" }, { caller: "owner", via: "session" });
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: false, seq: forged.seq, why: "the issue is no longer where this swap takes it from" });
  return "3 moved, 1 closed meanwhile and left; 1 opened meanwhile and moved";
}
