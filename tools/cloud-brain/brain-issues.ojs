test_issues_rebuild_and_replay_judge_the_record = {
  const rig = await issuesRig();
  await rig.inReview("r1");
  await rig.owner("open", { id: "r2", title: "Other", kind: "feedback", labels: ["ui"] });
  const before = (await rig.owner("snapshot")).data;
  expect((await rig.a("rebuild", {})).status).toBe(403);
  rig.db.view.clear();
  rig.db.meta.clear();
  expect((await rig.owner("rebuild", {})).data).toEqual({ seq: before.seq, issues: 2 });
  expect((await rig.owner("snapshot")).data).toEqual(before);
  expect((await rig.owner("sync?after=99")).data).toMatchObject({ reset: true, wait: 5000 });
  expect((await rig.as("owner", "session", { "x-brain-settings": encodeURIComponent(JSON.stringify({ syncMs: 20000 })) })("sync?after=0")).data.wait).toBe(20000);
  // A closed issue's body is left out of a snapshot and is in issue.get.
  await rig.owner("move", { id: "r2", to: "closed", reason: "read" });
  expect((await rig.owner("snapshot")).data.issues.find((i) => i.id === "r2")).toMatchObject({ bodyLeftOut: true });
  // A move written past the service, chained and signed: the chain holds, and the replay names it.
  const wf = before.issues.find((i) => i.id === "r1").workflow;
  const forged = await rig.forge({ id: "r1", type: "moved", workflow: wf, move: "pass", from: "in-review", to: "done", reason: "", refs: [] });
  expect((await rig.owner("verify")).data).toMatchObject({ ok: true, seq: forged.seq });
  expect((await rig.owner("verify?guards=true")).data).toEqual({ ok: false, seq: forged.seq, why: "the guard of pass refuses", checked: forged.seq - 1 });
  return "the view made again equals the view kept; a forged pass is named";
}
// %%
test_issues_rebuild_keeps_a_write_made_while_it_runs = {
  const rig = await issuesRig(), S = issuesSql;
  await rig.inReview("r1");
  await rig.owner("open", { id: "r2", title: "Other", kind: "feedback" });
  const head = rig.db.events.length, quiet = async () => ((await rig.owner("rebuild", {})), (await rig.owner("snapshot")).data);
  // After the rebuild has read the record and before it writes the view: a comment, a new issue, a move.
  rig.db.before.push([S.clearView, async () => {
    await rig.a("comment", { id: "r1", body: "while it ran" });
    await rig.owner("open", { id: "r3", title: "Opened meanwhile", kind: "task" });
    await rig.owner("move", { id: "r2", to: "closed", reason: "read" });
  }]);
  expect((await rig.owner("rebuild", {})).data).toEqual({ seq: head + 3, issues: 3 });
  expect(rig.db.before.length).toBe(0);
  const during = (await rig.owner("snapshot")).data, at = (id) => during.issues.find((i) => i.id === id);
  expect([during.seq, at("r1").comments, at("r3").title, at("r2").closed]).toEqual([head + 3, 1, "Opened meanwhile", true]);
  expect((await rig.a("comment", { id: "r3", body: "it is there" })).status).toBe(200);
  // The same view as a rebuild nothing interrupts.
  const after = (await rig.owner("snapshot")).data;
  expect(await quiet()).toEqual(after);
  // A policy installed meanwhile is the policy in force after it.
  let installed = null;
  rig.db.before.push([S.clearView, async () => void (installed = (await rig.owner("install", { key: "meanwhile", policy: issuesExamplePolicy })).data)]);
  await rig.owner("rebuild", {});
  const policy = (await rig.owner("policy")).data;
  expect([policy.policy.seq, policy.policy.names]).toEqual([installed.seq, installed.hashes]);
  expect(await quiet()).toMatchObject({ policy: policy.policy });
  // A record that another writer adds to at every read of its head: refused after 6 writes of the view, not run for ever.
  const wf = at("r1").workflow, writes = () => rig.db.events.length;
  for (let n = 0; n < 8; n++) rig.db.before.push([S.head, () => rig.forge({ id: "r1", type: "commented", workflow: wf, body: "again " + n })]);
  const was = writes();
  expect((await rig.owner("rebuild", {})).data).toMatchObject({ error: "Busy" });
  expect([writes() - was, rig.db.before.length]).toEqual([6, 2]);
  rig.db.before.length = 0;
  // The view it left holds every event but the last, and the next rebuild has that one too.
  expect((await rig.owner("snapshot")).data.issues.find((i) => i.id === "r1").comments).toBe(1 + 5);
  expect((await quiet()).issues.find((i) => i.id === "r1").comments).toBe(1 + 6);
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true });
  return "3 writes and an install made while a rebuild ran are in the view it left; a record that never rests is refused";
}
// %%
test_issues_migrate_moves_what_is_still_there = {
  const rig = await issuesRig();
  for (const id of ["aaaaaaaaaa1", "aaaaaaaaaa2", "gone"]) await rig.owner("open", { id, title: id, kind: "feedback" });
  const { policy: was, workflows: flows } = (await rig.owner("policy")).data, old = was.names.feedback;
  const flow = { states: ["new", "closed"], start: "new", closed: ["closed"], read: "true", open: "true", comment: "true", label: "true", review: "false", narrow: "false", moves: [{ name: "close", from: "new", to: "closed", guard: "true" }], swaps: [] };
  const policy = { kinds: { feedback: "feedback" }, workflows: { feedback: flow } };
  // Another writer, past the service, with its row of the view: what a second caller does while an install runs.
  const other = async (fields) => {
    const e = await rig.forge(fields, { caller: "owner", via: "session" }), row = rig.db.view.get(e.id);
    const i = issueApply({ ...issueView(), workflows: flows, issues: row ? { [e.id]: JSON.parse(row.issue) } : {} }, e).issues[e.id];
    rig.db.view.set(i.id, { id: i.id, parent: i.parent, workflow: i.workflow, closed: i.closed ? 1 : 0, issue: JSON.stringify(i) });
  };
  // As the policy is written, "late" is opened on the old workflow. As the first swap is written, "gone" is closed.
  rig.db.hooks.push(
    () => other({ id: "late", type: "opened", workflow: old, title: "late", body: "", kind: "feedback", about: "brain", parent: null, labels: [], state: "open" }),
    () => null,
    () => other({ id: "gone", type: "moved", workflow: old, move: "close", from: "open", to: "closed", reason: "read", refs: [] })
  );
  // A key at the limit: the swaps are keyed from the policy's seq, so two ids alike to their last letter are two events.
  const installed = (await rig.owner("install", { key: "k".repeat(issuesLimits.key - 8), policy, migrate: { [old]: { workflow: "feedback", states: { open: "new" } } } })).data;
  expect(installed).toMatchObject({ moved: ["aaaaaaaaaa1", "aaaaaaaaaa2", "late"], left: [{ id: "gone", why: "the issue is no longer where this swap takes it from" }] });
  const now = Object.fromEntries((await rig.owner("list")).data.issues.map((i) => [i.id, [i.state, i.workflow === installed.hashes.feedback, i.closed]]));
  expect(now).toEqual({ aaaaaaaaaa1: ["new", true, false], aaaaaaaaaa2: ["new", true, false], late: ["new", true, false], gone: ["closed", false, true] });
  const swaps = rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.type === "swapped");
  expect(swaps.map((e) => e.key)).toEqual(["aaaaaaaaaa1", "aaaaaaaaaa2", "late"].map((id) => `policy/${installed.seq}/${id}`));
  expect(swaps[0].from).toEqual({ workflow: old, state: "open" });
  // A swap written past the service that names another place than the issue was in is named by the replay.
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true });
  const forged = await rig.forge({ id: "late", type: "swapped", workflow: installed.hashes.feedback, swap: null, from: { workflow: installed.hashes.feedback, state: "closed" }, to: { workflow: installed.hashes.feedback, state: "new" }, reason: "" }, { caller: "owner", via: "session" });
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: false, seq: forged.seq, why: "the issue is no longer where this swap takes it from" });
  return "3 moved, 1 closed meanwhile and left; 1 opened meanwhile and moved";
}
// %%
test_issues_migration_puts_back_links_under_one_rule = {
  const rig = await issuesRig();
  for (const [id, kind] of [["x1", "task"], ["x2", "task"], ["x3", "task"], ["f1", "feedback"], ["p1", "project"]]) await rig.owner("open", { id, title: id, kind });
  // Two tasks; a feedback and a task; a task that is closed before the install; a task and a project.
  for (const [id, rel, to] of [["x1", "related", "x2"], ["f1", "duplicate", "x2"], ["x3", "cause", "x1"], ["x2", "related", "p1"]]) expect((await rig.owner("link", { id, to, rel })).status).toBe(200);
  await rig.owner("move", { id: "x3", to: "closed", reason: "answered" });
  // An install that changes who reads a task and a feedback, to one rule, and moves the open issues of both.
  const { policy: was, workflows: flows } = (await rig.owner("policy")).data, read = 'caller.kind in ["owner", "token"]';
  const policy = { kinds: was.kinds, workflows: Object.fromEntries(Object.entries(was.names).map(([n, h]) => [n, n === "task" || n === "feedback" ? { ...flows[h], read } : flows[h]])) };
  const installed = (await rig.owner("install", { key: "narrow", reason: "a test", policy, migrate: { [was.names.task]: { workflow: "task" }, [was.names.feedback]: { workflow: "feedback" } } })).data;
  expect(installed).toMatchObject({ moved: ["x1", "x2", "f1"], left: [] });
  // Each issue was swapped alone, and each swap dropped the links to an issue then read by another rule. The two whose
  // ends both came under the new rule are put back, each by an event of the install; the record has them.
  const same = (a, b) => expect([...a].map((l) => JSON.stringify(l)).sort()).toEqual([...b].map((l) => JSON.stringify(l)).sort());
  same(installed.relinked, [{ id: "x1", rel: "related", to: "x2" }, { id: "f1", rel: "duplicate", to: "x2" }]);
  const got = async (id) => (await rig.owner("get?id=" + id)).data.issue;
  expect((await got("x1")).links).toEqual([{ rel: "related", to: "x2" }]);
  expect((await got("f1")).links).toEqual([{ rel: "duplicate", to: "x2" }]);
  same((await got("x2")).linked, [{ rel: "related", id: "x1" }, { rel: "duplicate", id: "f1" }]);
  const put = rig.db.events.map((e) => JSON.parse(e.event)).filter((e) => e.type === "linked" && e.seq > installed.seq);
  expect(put.map((e) => e.key)).toEqual([0, 1].map((n) => `policy/${installed.seq}/link/${n}`));
  // The two that stay off, with why: x3 is closed and so not moved, p1 is a project and its workflow did not change.
  // Both are still read by everyone, which the two tasks no longer are.
  const why = "the two issues are not read by the same rule";
  same(installed.unlinked, [{ id: "x3", rel: "cause", to: "x1", why }, { id: "x2", rel: "related", to: "p1", why }]);
  expect([(await got("x3")).links, (await got("x1")).linked, (await got("x2")).links, (await got("p1")).linked]).toEqual([[], [], [], []]);
  // The same install with no change to who reads: no link is dropped, so none is put back.
  await rig.owner("open", { id: "x4", title: "x4", kind: "task" });
  await rig.owner("link", { id: "x4", to: "x1", rel: "related" });
  const now = (await rig.owner("policy")).data;
  const again = { kinds: now.policy.kinds, workflows: Object.fromEntries(Object.entries(now.policy.names).map(([n, h]) => [n, n === "task" ? { ...now.workflows[h], comment: read } : now.workflows[h]])) };
  expect((await rig.owner("install", { key: "comment", reason: "a test", policy: again, migrate: { [now.policy.names.task]: { workflow: "task" } } })).data).toMatchObject({ moved: ["x1", "x2", "x4"], relinked: [], unlinked: [] });
  expect((await got("x4")).links).toEqual([{ rel: "related", to: "x1" }]);
  // The view made again from the record is the same, and the record replays under its guards.
  const before = await Promise.all(["x1", "x2", "x3", "x4", "f1", "p1"].map(got));
  await rig.owner("rebuild", {});
  expect(await Promise.all(["x1", "x2", "x3", "x4", "f1", "p1"].map(got))).toEqual(before);
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true, guards: true });
  return "2 links put back after both ends moved; 2 left off with why; none touched when who reads did not change";
}
// %%
test_issues_attachments_are_kept_by_hash_and_read_with_the_issue = {
  const rig = await issuesRig(), kept = rig.sim.blobs, L = issuesLimits;
  // An empty record: nothing to attach to, and neither a policy nor bytes are written.
  expect([(await rig.a("attach", { id: "none", name: "a.txt", text: "x" })).status, rig.db.events.length, kept.size]).toEqual([404, 0, 0]);
  await rig.owner("open", { id: "t1", title: "Task", kind: "task" });
  await rig.owner("open", { id: "s1", title: "Report", kind: "security" });
  const hash = await issueBytes.hash(new TextEncoder().encode("a diff\n"));
  // A token attaches under the comment guard. The event names the hash and the size; the bytes are not in it.
  const made = await rig.a("attach", { id: "t1", name: "fix.diff", mimeType: "text/x-diff", text: "a diff\n" });
  expect(made.status).toBe(200);
  expect(made.data.event).toMatchObject({ type: "attached", id: "t1", name: "fix.diff", mimeType: "text/x-diff", size: 7, sha256: hash });
  expect(JSON.stringify(made.data.event)).not.toContain("a diff");
  const listed = { name: "fix.diff", mimeType: "text/x-diff", size: 7, sha256: hash, seq: made.data.seq };
  expect((await rig.b("get?id=t1")).data.issue.attachments).toEqual([listed]);
  expect((await rig.b("list")).data.issues.find((i) => i.id === "t1").attachments).toEqual([listed]);
  expect((await rig.b("attachment?id=t1&name=fix.diff")).data).toEqual({ id: "t1", ...listed, text: "a diff\n" });
  // Bytes that are not text go in and come out as base64.
  const png = btoa(String.fromCharCode(0x89, 0x50, 0x4e, 0x47, 0xff, 0x00));
  expect((await rig.a("attach", { id: "t1", name: "shot.png", mimeType: "image/png", base64: png })).status).toBe(200);
  const shot = (await rig.owner("attachment?id=t1&name=shot.png")).data;
  expect([shot.base64, shot.text, shot.size, shot.mimeType]).toEqual([png, undefined, 6, "image/png"]);
  expect(kept.size).toBe(2);
  // A key sent again is the write it was, to its writer; another caller is told its place. Nothing is kept again.
  const again = { key: "mine", id: "t1", name: "again.txt", text: "once" };
  const first = await rig.a("attach", again), second = await rig.a("attach", again), other = await rig.b("attach", again);
  expect([first.status, second.data.duplicate, second.data.seq === first.data.seq, other.data.duplicate, other.data.event]).toEqual([200, true, true, true, undefined]);
  expect((await rig.a("get?id=t1")).data.issue.attachments.map((a) => a.name)).toEqual(["fix.diff", "shot.png", "again.txt"]);
  expect(kept.size).toBe(3);
  // Each of these is refused, and none of them leaves bytes kept.
  const big = "x".repeat(L.attachment + 1), wide = "é".repeat(L.attachment / 2 + 1);
  const refused = [
    [{ id: "t1", name: "fix.diff", text: "another" }, 403, "the issue has an attachment of this name"],
    [{ id: "nope", name: "a.txt", text: "x1" }, 404, "no such issue"],
    [{ id: "s1", name: "a.txt", text: "x2" }, 404, "no such issue"],
    [{ id: "t1", name: "../up", text: "x3" }, 400, "name: A-Z a-z 0-9 . _ -, the first not a dot"],
    [{ id: "t1", name: ".dot", text: "x4" }, 400, "name: A-Z a-z 0-9 . _ -, the first not a dot"],
    [{ id: "t1", text: "x5" }, 400, "name"],
    [{ id: "t1", name: "a.txt", mimeType: "html", text: "x6" }, 400, "mimeType: type/subtype"],
    [{ id: "t1", name: "a.txt", text: "x7", base64: "eDc=" }, 400, "text or base64: one of them, a string"],
    [{ id: "t1", name: "a.txt" }, 400, "text or base64: one of them, a string"],
    [{ id: "t1", name: "a.txt", text: 7 }, 400, "text or base64: one of them, a string"],
    [{ id: "t1", name: "a.txt", text: "" }, 400, "text or base64: the bytes, not empty"],
    [{ id: "t1", name: "a.txt", base64: "not base64!" }, 400, "base64: not base64"],
    [{ id: "t1", name: "a.txt", text: big }, 400, L.attachment + " bytes at most"],
    [{ id: "t1", name: "a.txt", text: wide }, 400, `${L.attachment + 2} bytes, ${L.attachment} at most`]
  ];
  for (const [body, status, message] of refused) {
    const r = await rig.a("attach", body);
    expect([body.name, body.id, r.status, r.data.message]).toEqual([body.name, body.id, status, message]);
  }
  expect(kept.size).toBe(3);
  // The limit itself is taken.
  expect((await rig.a("attach", { id: "t1", name: "full.txt", text: "x".repeat(L.attachment) })).data.event.size).toBe(L.attachment);
  // An issue read by the owner present and its opener: its attachment is theirs to read. The same bytes as t1's are
  // kept once, and the token that reads them on t1 is told of nothing on s1, by name or in the issue.
  expect((await rig.owner("attach", { id: "s1", name: "notes.txt", text: "a diff\n" })).data.event).toMatchObject({ mimeType: "text/plain", sha256: hash });
  expect(kept.size).toBe(4);
  expect((await rig.owner("attachment?id=s1&name=notes.txt")).data.text).toBe("a diff\n");
  const hidden = await rig.a("attachment?id=s1&name=notes.txt"), lacking = await rig.a("attachment?id=t1&name=nope");
  expect([hidden.status, hidden.data, lacking.status, lacking.data]).toEqual([404, { error: "NotFound", message: "no such attachment" }, 404, { error: "NotFound", message: "no such attachment" }]);
  expect((await rig.a("get?id=s1")).data.issue).toEqual({ id: "s1", kind: "security", state: "open", closed: false, parent: null, hidden: true });
  // At most 20 an issue.
  await rig.owner("open", { id: "t2", title: "Many", kind: "task" });
  for (let n = 0; n < L.attachments; n++) expect((await rig.a("attach", { id: "t2", name: "n" + n, text: "n" + n })).status).toBe(200);
  expect((await rig.a("attach", { id: "t2", name: "one-more", text: "one more" })).data).toEqual({ error: "Refused", message: "an issue has at most 20 attachments" });
  expect(kept.size).toBe(4 + L.attachments);
  // The record judges again, and the view made again from it lists the same attachments.
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true, guards: true });
  const before = (await rig.owner("snapshot")).data;
  rig.db.view.clear();
  rig.db.meta.clear();
  await rig.owner("rebuild", {});
  expect((await rig.owner("snapshot")).data).toEqual(before);
  // Bytes changed in the bucket are not answered as the attachment, nor are bytes that are gone.
  const at = [...kept.keys()].find((k) => k.endsWith("a/" + shot.sha256));
  kept.set(at, new Uint8Array([1, 2, 3]));
  expect((await rig.owner("attachment?id=t1&name=shot.png")).data).toEqual({ error: "BytesChanged", message: "the bytes kept for shot.png are not the ones the record names" });
  kept.delete(at);
  expect((await rig.owner("attachment?id=t1&name=shot.png")).data).toEqual({ error: "BytesNotKept", message: "the bytes of shot.png are not kept" });
  // An attachment written past the service under a name the issue has: the chain holds, and the replay names it.
  const forged = await rig.forge({ id: "t1", type: "attached", workflow: before.issues.find((i) => i.id === "t1").workflow, name: "fix.diff", mimeType: "text/plain", size: 1, sha256: "00" });
  expect((await rig.owner("verify?guards=true")).data).toEqual({ ok: false, seq: forged.seq, why: "the issue has an attachment of this name", checked: forged.seq - 1 });
  return `${before.issues.reduce((n, i) => n + (i.attachments || []).length, 0)} attachments in ${4 + L.attachments} blobs; ${refused.length} refusals kept none`;
}
// %%
test_issues_attach_guard_is_the_policys_when_it_has_one = {
  const rig = await issuesRig();
  const flows = (attach) => Object.fromEntries(Object.entries(issuesExamplePolicy.workflows).map(([n, w]) => [n, { ...w, attach }]));
  // A guard that does not parse refuses the install, as any other guard does.
  expect((await rig.owner("install", { policy: { ...issuesExamplePolicy, workflows: flows("((") } })).status).toBe(400);
  expect((await rig.owner("install", { policy: { ...issuesExamplePolicy, workflows: flows("caller.present") } })).status).toBe(200);
  await rig.owner("open", { id: "g1", title: "Guarded", kind: "bug" });
  // comment is "true" in this policy: it is attach that refuses the token.
  expect((await rig.a("comment", { id: "g1", body: "said" })).status).toBe(200);
  expect((await rig.a("attach", { id: "g1", name: "a.txt", text: "x" })).data).toEqual({ error: "Refused", message: "the workflow's attach guard refuses" });
  expect(rig.sim.blobs.size).toBe(0);
  expect((await rig.owner("attach", { id: "g1", name: "a.txt", text: "x" })).status).toBe(200);
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true });
  return "attach is refused to a token that may comment; the owner present attaches";
}
// %%
// R1 of plan/cloud-brain-run-cost-is-part-of-the-issue-model.md: a cost whose field is missing, of another type or not
// known is refused with the field's name, and the record's head does not move.
test_issues_cost_is_refused_by_its_shape_and_writes_nothing = {
  const rig = await issuesRig(), L = issuesLimits;
  await rig.owner("open", { id: "c1", title: "Costed", kind: "task" });
  const usage = { input: 61, cacheWrite: 141873, cacheRead: 3561349, output: 17885, requests: 29, advisor: { calls: 2, input: 90210, output: 4410 } };
  const run = { id: "c1", role: "implementer", round: 1, how: "fresh", outcome: "in-review", seconds: 410, context: 201310 };
  const head = () => [rig.db.events.length, rig.db.events.at(-1).hash], before = head();
  const { role, context, ...noRole } = run, noContext = { ...noRole, role };
  const whole = (k, from) => `${k}: a whole number, ${from} or more`, text = (k) => `${k}: text, 1 to ${L.costText} characters`;
  const all = "usage: all of { input, cacheWrite, cacheRead, output, requests, advisor: { calls, input, output } }, whole numbers, and nothing else";
  const fields = "not a field of issue.cost, which are " + L.cost.join(", ");
  const refused = [
    // The six of the spec's table.
    [noRole, "role: a name, a-z 0-9 -, 30 at most"],
    [{ ...run, round: "2" }, "round: a whole number, 1 to 1000"],
    [{ ...run, seconds: 1.5 }, whole("seconds", 0)],
    [{ ...run, usage: { input: 1, cacheWrite: 1, cacheRead: 1, output: 1, requests: 1 } }, all],
    [{ ...noContext, tokens: 201310 }, "tokens: " + fields],
    [{ ...run, how: "warm" }, "how: fresh, resumed, light"],
    // The values next to the ones that pass.
    [noContext, whole("context", 0)],
    [{ ...run, round: 0 }, "round: a whole number, 1 to 1000"],
    [{ ...run, round: 1001 }, "round: a whole number, 1 to 1000"],
    [{ ...run, seconds: -1 }, whole("seconds", 0)],
    [{ ...run, context: null }, whole("context", 0)],
    [{ ...run, role: "Implementer" }, "role: a name, a-z 0-9 -, 30 at most"],
    [{ ...run, role: "r".repeat(L.role + 1) }, "role: a name, a-z 0-9 -, 30 at most"],
    [{ ...run, outcome: "" }, "outcome: a name, a-z 0-9 -, 30 at most"],
    [{ ...run, how: undefined }, "how: fresh, resumed, light"],
    [{ ...run, tools: "12" }, whole("tools", 0)],
    [{ ...run, event: 0 }, whole("event", 1)],
    [{ ...run, of: 2.5 }, whole("of", 1)],
    // The light reviewer's lines had "agent": null: refused, so the script that enters them leaves a null out.
    [{ ...run, agent: null }, text("agent")],
    [{ ...run, session: "" }, text("session")],
    [{ ...run, token: "t".repeat(L.costText + 1) }, text("token")],
    [{ ...run, usage: { ...usage, advisor: { calls: 2, input: 1 } } }, all],
    [{ ...run, usage: { ...usage, output: "17885" } }, all],
    [{ ...run, usage: { ...usage, reasoning: 5 } }, all],
    [{ ...run, usage: null }, all],
    [{ ...run, usd: -0.01 }, "usd: a number, 0 or more"],
    [{ ...run, usd: "0.41" }, "usd: a number, 0 or more"],
    [{ ...run, backfilled: false }, "backfilled: true, or left out"],
    [{ ...run, light: true, resumed: false }, "light, resumed: " + fields]
  ];
  for (const [body, message] of refused) {
    const r = await rig.a("cost", body);
    expect([message, r.status, r.data]).toEqual([message, 400, { error: "InvalidRequest", message }]);
  }
  // The body is checked before the issue is looked for: an issue that is not there answers 400 for a bad body.
  expect([(await rig.a("cost", { ...noContext, id: "none" })).status, (await rig.a("cost", { ...run, id: "none" })).status]).toEqual([400, 404]);
  // What a run made is in the record before its cost: the head is event 2 here.
  for (const k of ["event", "of"]) expect((await rig.a("cost", { ...run, [k]: 3 })).data).toEqual({ error: "Refused", message: k + ": the seq of an event before this one" });
  expect(head()).toEqual(before);
  // Every field at once is taken, and the event has them as fields.
  const full = { ...run, tools: 77, event: 2, of: 2, agent: "a1b2", session: "s-9", token: "impl-e1c780", usage, usd: 0, backfilled: true };
  const made = (await rig.a("cost", full)).data;
  expect(made.event).toMatchObject({ type: "cost", seq: 3, ...full });
  expect(Object.keys(made.event).sort()).toEqual([...L.cost, "at", "by", "hash", "id", "key", "origin", "prev", "ray", "seq", "sig", "type", "workflow"].sort());
  expect(rig.db.events.length).toBe(before[0] + 1);
  return `${refused.length} bodies answered 400 and nothing written; one with every field written`;
}
// %%
// R2 and R8 of the same spec: a run is an issue, a role and a round, a second event for one takes its place and says
// which it replaced, a key writes once, and verify?guards=true judges replaced.
test_issues_cost_run_is_replaced_by_the_next_of_its_role_and_round = {
  const rig = await issuesRig();
  await rig.inReview("c1");
  const usage = { input: 61, cacheWrite: 141873, cacheRead: 3561349, output: 17885, requests: 29, advisor: { calls: 2, input: 90210, output: 4410 } };
  const run = { id: "c1", role: "implementer", round: 1, how: "fresh", outcome: "in-review", seconds: 410, context: 201310, event: 6 };
  const row = async () => (await rig.b("get?id=c1")).data.issue, was = await row();
  expect(Object.hasOwn(was, "runs")).toBe(false);
  // The run, written with no usage.
  const first = (await rig.a("cost", { key: "cost/c1/implementer/1", ...run })).data;
  expect([first.event.type, Object.hasOwn(first.event, "replaced")]).toEqual(["cost", false]);
  const { id, ...fields } = run, one = await row();
  expect(one.runs).toEqual([{ ...fields, seq: first.seq, at: first.event.at }]);
  // seq moves, so the page asks again. updated_at, which issue.list is ordered by, does not.
  expect([one.seq, one.updated_at, one.state, one.comments]).toEqual([first.seq, was.updated_at, was.state, was.comments]);
  // The same with an event a minute later, applied to a copy of the row: the two times above may be one millisecond.
  const copy = issueApply({ ...issueView(), issues: { c1: structuredClone(was) } }, { ...first.event, seq: 99, at: was.updated_at + 60000 }).issues.c1;
  expect([copy.updated_at, copy.seq, copy.runs]).toEqual([was.updated_at, 99, [{ ...fields, seq: 99, at: was.updated_at + 60000 }]]);
  // The same key again writes nothing: to its writer the first event, to another caller its place.
  const events = rig.db.events.length;
  expect((await rig.a("cost", { key: "cost/c1/implementer/1", ...run, seconds: 9 })).data).toEqual({ id: "c1", seq: first.seq, duplicate: true, event: first.event });
  expect((await rig.b("cost", { key: "cost/c1/implementer/1", ...run })).data).toEqual({ id: "c1", seq: first.seq, duplicate: true });
  expect([rig.db.events.length, (await row()).runs[0].seconds]).toEqual([events, 410]);
  // The same run again, whole, with its usage, under another key: it takes the first one's place and names it.
  const second = (await rig.a("cost", { key: "cost/c1/implementer/1/2", ...run, usage })).data;
  expect(second.event).toMatchObject({ type: "cost", replaced: first.seq, usage });
  expect((await row()).runs).toEqual([{ ...fields, usage, seq: second.seq, at: second.event.at }]);
  // Another role, and another round of the first, are other runs. The first keeps its place in the list when it is
  // written a third time only by its seq: the list is in the order of the events in force.
  const review = (await rig.b("cost", { id: "c1", role: "reviewer", round: 1, how: "light", outcome: "pass", seconds: 320, context: 90000, usd: 0.41 })).data;
  const later = (await rig.a("cost", { ...run, round: 2, how: "resumed" })).data;
  expect([Object.hasOwn(review.event, "replaced"), Object.hasOwn(later.event, "replaced")]).toEqual([false, false]);
  const third = (await rig.owner("cost", { ...run, usage, seconds: 411 })).data;
  expect(third.event.replaced).toBe(second.seq);
  const kept = (await row()).runs;
  expect(kept.map((r) => [r.role, r.round, r.how, r.seq])).toEqual([["reviewer", 1, "light", review.seq], ["implementer", 2, "resumed", later.seq], ["implementer", 1, "fresh", third.seq]]);
  // The row is what issue.list and issue.snapshot answer, and what issue.rebuild makes again from the record.
  const listed = (await rig.b("list")).data.issues.find((i) => i.id === "c1"), before = (await rig.owner("snapshot")).data;
  expect([listed.runs, before.issues.find((i) => i.id === "c1").runs]).toEqual([kept, kept]);
  rig.db.view.clear();
  rig.db.meta.clear();
  await rig.owner("rebuild", {});
  expect((await rig.owner("snapshot")).data).toEqual(before);
  // A Worker of the Brain may comment under the default policy, and may not label: it writes no cost.
  expect((await rig.worker("comment", { id: "c1", body: "said" })).status).toBe(200);
  expect((await rig.worker("cost", run)).data).toEqual({ error: "Refused", message: "the workflow's cost guard refuses" });
  // Every event of this record was allowed, and each cost names the run it replaced.
  const head = rig.db.events.at(-1).seq;
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true, seq: head, checked: head, guards: true });
  // A cost written past the service, chained and signed: one that names a run it does not replace, one that names
  // none where the issue has the run, and one that names one where the issue has none. The chain holds each time.
  const wf = was.workflow, why = "names another run than the one it replaces";
  for (const [more, ok] of [[{ replaced: first.seq }, false], [{}, false], [{ replaced: third.seq }, true], [{ round: 9, replaced: third.seq }, false], [{ round: 9 }, true]]) {
    const forged = await rig.forge({ id: "c1", type: "cost", workflow: wf, ...fields, ...more });
    expect((await rig.owner("verify")).data).toMatchObject({ ok: true, seq: forged.seq });
    expect((await rig.owner("verify?guards=true")).data).toEqual(ok ? { ok: true, seq: forged.seq, head: forged.hash, checked: forged.seq, guards: true } : { ok: false, seq: forged.seq, why, checked: forged.seq - 1 });
    rig.db.events.pop();
  }
  return "a run written twice is one run, the second event names the first; a key writes once; a wrong replaced fails the replay";
}
// %%
test_issues_cost_guard_is_the_policys_when_it_has_one = {
  const rig = await issuesRig();
  const flows = (cost) => Object.fromEntries(Object.entries(issuesExamplePolicy.workflows).map(([n, w]) => [n, { ...w, cost }]));
  const run = { id: "g1", role: "reviewer", round: 1, how: "light", outcome: "pass", seconds: 1, context: 1 };
  // A guard that does not parse refuses the install, as any other guard does.
  expect((await rig.owner("install", { policy: { ...issuesExamplePolicy, workflows: flows("((") } })).status).toBe(400);
  expect((await rig.owner("install", { policy: { ...issuesExamplePolicy, workflows: flows("caller.present") } })).status).toBe(200);
  await rig.owner("open", { id: "g1", title: "Guarded", kind: "bug" });
  // label lets a token in under this policy: it is cost that refuses it.
  expect((await rig.a("label", { id: "g1", add: ["ui"] })).status).toBe(200);
  expect((await rig.a("cost", run)).data).toEqual({ error: "Refused", message: "the workflow's cost guard refuses" });
  expect((await rig.owner("cost", run)).status).toBe(200);
  expect((await rig.owner("verify?guards=true")).data).toMatchObject({ ok: true });
  // With no cost guard, label is the guard: the token writes one, and a Worker of the Brain, which label refuses, does not.
  const other = await issuesRig();
  await other.owner("install", { policy: issuesExamplePolicy });
  await other.owner("open", { id: "g1", title: "Guarded", kind: "bug" });
  expect((await other.a("cost", run)).status).toBe(200);
  expect((await other.worker("cost", run)).data).toEqual({ error: "Refused", message: "the workflow's cost guard refuses" });
  return "cost is refused to a token that may label; with no cost guard whoever may label writes one";
}
// %%
// R3 of the same spec: issue.get answers the totals of the issue's runs, and the same for each role.
test_issues_cost_totals_are_in_get_with_each_role = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "c0", title: "No run", kind: "task" });
  await rig.owner("open", { id: "c1", title: "Costed", kind: "task" });
  const zero = { runs: 0, seconds: 0, billed: 0, input: 0, cacheWrite: 0, cacheRead: 0, output: 0, requests: 0, advisor: { calls: 0, input: 0, output: 0 } };
  expect([issueCost(undefined), issueCost([])]).toEqual([zero, zero]);
  // An issue with no run has the totals, each 0, and no role.
  const none = (await rig.b("get?id=c0")).data;
  expect([Object.keys(none), none.cost]).toEqual([["issue", "children", "events", "cost"], { ...zero, byRole: {} }]);
  const u = (n) => ({ input: n, cacheWrite: 10 * n, cacheRead: 100 * n, output: 2 * n, requests: n, advisor: { calls: n, input: 3 * n, output: 4 * n } });
  const run = (role, round, more) => ({ id: "c1", role, round, how: "fresh", outcome: "in-review", seconds: 100 * round, context: 5, ...more });
  // Two runs with a usage and a usd, one with a usage alone, one with neither, and one with a usd of 0 whose role is
  // a name every object has.
  for (const body of [run("implementer", 1, { usage: u(1) }), run("implementer", 2), run("reviewer", 1, { how: "light", usage: u(5), usd: 0.1 }), run("reviewer", 2, { how: "light", usage: u(7), usd: 0.2 }), run("constructor", 1, { usd: 0 })])
    expect((await rig.a("cost", body)).status).toBe(200);
  const sums = (n) => ({ input: n, cacheWrite: 10 * n, cacheRead: 100 * n, output: 2 * n, requests: n, advisor: { calls: n, input: 3 * n, output: 4 * n } });
  const byRole = { implementer: { runs: 2, seconds: 300, billed: 1, ...sums(1) }, reviewer: { runs: 2, seconds: 300, billed: 2, ...sums(12), usd: 0.3, usdRuns: 2 }, constructor: { ...zero, runs: 1, seconds: 100, usd: 0, usdRuns: 1 } };
  // The sums are of the runs that have a usage (billed); usd is of the runs that have one, and 0.1 + 0.2 reads 0.3.
  const got = (await rig.b("get?id=c1")).data;
  expect(got.cost).toEqual({ runs: 5, seconds: 700, billed: 3, ...sums(13), usd: 0.3, usdRuns: 3, byRole });
  expect(Object.keys(got.cost.byRole)).toEqual(["implementer", "reviewer", "constructor"]);
  // The totals are what issueCost makes of the row's runs, with no I/O.
  expect(issueCost(got.issue.runs)).toEqual({ runs: 5, seconds: 700, billed: 3, ...sums(13), usd: 0.3, usdRuns: 3 });
  // R2: the run written without a usage, written again with one: still five runs, one more of them billed.
  expect((await rig.a("cost", run("implementer", 2, { usage: u(2) }))).data.event.replaced).toBe(5);
  const again = (await rig.b("get?id=c1")).data.cost;
  expect([again.runs, again.billed, again.input, again.byRole.implementer]).toEqual([5, 4, 15, { runs: 2, seconds: 300, billed: 2, ...sums(3) }]);
  // The other issue's totals did not move.
  expect((await rig.b("get?id=c0")).data.cost.runs).toBe(0);
  return "an issue's totals: 5 runs, 3 then 4 billed, 3 roles; an issue with no run has totals of 0";
}
// %%
// R4 of the same spec: one call reads the runs of every issue the caller reads, for a role, a kind of run or a round,
// a page at a time, with the totals of all that match.
test_issues_runs_answers_what_a_caller_reads_a_page_at_a_time = {
  const rig = await issuesRig(), L = issuesLimits;
  await rig.a("open", { id: "sec", title: "Key in a log", kind: "security" });
  await rig.owner("open", { id: "p1", title: "One", kind: "task" });
  await rig.owner("open", { id: "p2", title: "Two", kind: "task" });
  const zero = { runs: 0, seconds: 0, billed: 0, input: 0, cacheWrite: 0, cacheRead: 0, output: 0, requests: 0, advisor: { calls: 0, input: 0, output: 0 } };
  expect((await rig.b("runs")).data).toEqual({ runs: [], total: zero, more: false });
  const usage = { input: 1, cacheWrite: 2, cacheRead: 3, output: 4, requests: 5, advisor: { calls: 6, input: 7, output: 8 } };
  const run = (id, role, round, how, more) => ({ id, role, round, how, outcome: "pass", seconds: 10, context: 1, ...more });
  const sent = [run("p1", "implementer", 1, "fresh"), run("p1", "reviewer", 1, "light", { usage }), run("sec", "implementer", 1, "fresh"), run("p2", "implementer", 1, "fresh"), run("p1", "implementer", 2, "resumed"), run("p2", "implementer", 3, "resumed")];
  const made = [];
  for (const body of sent) made.push((await rig.a("cost", body)).data.event);
  const row = (n) => ({ ...sent[n], seq: made[n].seq, at: made[n].at }), rows = (...ns) => ns.map(row);
  // Each run with its issue's id, in the order of the events. The security issue is read by its opener and by the
  // owner present: its run is in no answer to another token or to a Worker, nor in their totals.
  const all = (await rig.b("runs")).data;
  expect(all).toEqual({ runs: rows(0, 1, 3, 4, 5), total: { ...zero, runs: 5, seconds: 50, billed: 1, ...usage }, more: false });
  expect((await rig.worker("runs")).data).toEqual(all);
  for (const who of [rig.a, rig.owner]) expect((await who("runs")).data).toEqual({ runs: rows(0, 1, 2, 3, 4, 5), total: { ...all.total, runs: 6, seconds: 60 }, more: false });
  expect([(await rig.b("runs?id=sec")).data, (await rig.a("runs?id=sec")).data.runs, (await rig.b("runs?id=none")).data]).toEqual([{ runs: [], total: zero, more: false }, rows(2), { runs: [], total: zero, more: false }]);
  expect(JSON.stringify((await rig.b("runs?role=implementer&round=first")).data)).not.toContain('"sec"');
  // One role, one kind of run, one round, one issue, and several of them at once. A value left empty asks for nothing,
  // and a name that is not a filter's is not read.
  const asked = async (q) => (await rig.b("runs?" + q)).data.runs.map((r) => made.findIndex((e) => e.seq === r.seq));
  const found = [];
  for (const q of ["role=implementer", "role=reviewer", "role=nobody", "how=resumed", "how=light", "round=first", "round=later", "round=1", "round=2", "round=3", "round=4", "id=p1", "id=p2&round=later", "role=implementer&how=resumed&round=later", "role=implementer&how=light", "id=&role=&how=&round=&after=&limit=", "rol=reviewer"]) found.push([q, await asked(q)]);
  expect(found).toEqual([["role=implementer", [0, 3, 4, 5]], ["role=reviewer", [1]], ["role=nobody", []], ["how=resumed", [4, 5]], ["how=light", [1]], ["round=first", [0, 1, 3]], ["round=later", [4, 5]], ["round=1", [0, 1, 3]], ["round=2", [4]], ["round=3", [5]], ["round=4", []], ["id=p1", [0, 1, 4]], ["id=p2&round=later", [5]], ["role=implementer&how=resumed&round=later", [4, 5]], ["role=implementer&how=light", []], ["id=&role=&how=&round=&after=&limit=", [0, 1, 3, 4, 5]], ["rol=reviewer", [0, 1, 3, 4, 5]]]);
  // More runs than the limit: `more`, and the totals are of all that match, on every page. The next page is asked for
  // with the seq of the last run read.
  const page = async (q) => ((d) => [d.runs.map((r) => made.findIndex((e) => e.seq === r.seq)), d.total.runs, d.more])((await rig.b("runs?" + q)).data);
  expect([await page("limit=2"), await page(`limit=2&after=${made[1].seq}`), await page(`limit=2&after=${made[4].seq}`), await page(`limit=2&after=${made[5].seq}`)]).toEqual([[[0, 1], 5, true], [[3, 4], 5, true], [[5], 5, false], [[], 5, false]]);
  expect([await page("limit=5"), await page("limit=4"), await page("role=implementer&limit=1"), await page(`role=implementer&limit=3&after=${made[0].seq}`), await page("limit=1&after=0")]).toEqual([[[0, 1, 3, 4, 5], 5, false], [[0, 1, 3, 4], 5, true], [[0], 4, true], [[3, 4, 5], 4, false], [[0], 5, true]]);
  // A value that is not one of a field's is refused, not read as no filter: the answer would be every run.
  const whole = (k, from, to) => `${k}: a whole number, ${from} to ${to}`, round = `round: first, later, or a whole number, 1 to ${L.rounds}`;
  const refused = [["how=warm", "how: " + L.hows.join(", ")], ["round=abc", round], ["round=0", round], ["round=" + (L.rounds + 1), round], ["round=1.5", round], ["round=-1", round], ["after=-1", "after: a whole number, 0 or more"], ["after=x", "after: a whole number, 0 or more"], ["after=1.5", "after: a whole number, 0 or more"], ["limit=0", whole("limit", 1, L.page)], ["limit=" + (L.page + 1), whole("limit", 1, L.page)], ["limit=2.5", whole("limit", 1, L.page)], ["limit=all", whole("limit", 1, L.page)], ["role=Implementer", `role: a name, a-z 0-9 -, ${L.role} at most`], ["role=" + "r".repeat(L.role + 1), `role: a name, a-z 0-9 -, ${L.role} at most`]];
  for (const [q, message] of refused) expect([q, (await rig.b("runs?" + q)).status, (await rig.b("runs?" + q)).data]).toEqual([q, 400, { error: "InvalidRequest", message }]);
  // The limit left out is the most a page has, and the most is taken.
  expect((await page("limit=" + L.page))[2]).toBe(false);
  // A run written again is read once, at its new place.
  const again = (await rig.a("cost", { ...sent[0], seconds: 11 })).data.event;
  const after = (await rig.b("runs")).data;
  expect([after.runs.map((r) => r.seq), after.total.runs, after.total.seconds]).toEqual([[made[1].seq, made[3].seq, made[4].seq, made[5].seq, again.seq], 5, 51]);
  // The reads wrote nothing: the record is the policy, three issues, six runs and the one written again.
  expect(rig.db.events.length).toBe(11);
  return `6 runs on 3 issues: 5 to a token that does not read one issue; ${found.length} queries, 9 pages, ${refused.length} refused`;
}
// %%
test_issues_panel_saves_an_attachment_once_a_press = {
  const rig = await issuesRig();
  await rig.owner("open", { id: "p1", title: "With files", kind: "task" });
  await rig.a("attach", { id: "p1", name: "notes.md", mimeType: "text/markdown", text: "# notes" });
  await rig.a("attach", { id: "p1", name: "b.bin", mimeType: "application/octet-stream", base64: btoa(String.fromCharCode(255, 0)) });
  const ok = (r) => (r.status < 400 ? r.data : Promise.reject(new Error(r.data.message)));
  // The test's client: it counts the asks for an attachment, holds one until `go`, and refuses when told to.
  let asks = 0, hold = null, refuse = false, last = null;
  const ask = async (name, params) => {
    if (name === "issue.attachment") {
      asks++;
      await hold;
      if (refuse) throw new Error("gone");
    }
    return rig.owner(name.replace("issue.", "") + "?" + new URLSearchParams(params)).then(ok);
  };
  const client = { query: (name, params = {}) => (name === "issue.attachment" ? (last = ask(name, params)) : ask(name, params)), procedure: (name, body) => rig.owner(name.replace("issue.", ""), body).then(ok) };
  const saved = [];
  let end = null;
  const panel = issuesPanel({ client, owner: true, every: 1e9, listen: false, invalidation: new Promise((r) => (end = r)), store: { get: () => null, set: () => null }, save: (name, bytes) => saved.push([name, [...bytes]]) });
  await panel.sync();
  panel.show("p1");
  const lines = () => [...panel.querySelectorAll("[data-attachment]")], name = (n) => lines().find((d) => d.dataset.attachment === n).querySelector("a");
  expect(lines().map((d) => d.textContent.replace(/\s+/g, " ").trim())).toEqual(["attached notes.md text/markdown · 7 bytes", "attached b.bin application/octet-stream · 2 bytes"]);
  // The panel's own turn after an answer (its save, then the name is free again) is done once a task has passed.
  const settled = async () => (await last.catch(() => null), new Promise((r) => setTimeout(r)));
  // Two presses before the answer: one ask, one file.
  let go = null;
  hold = new Promise((r) => (go = r));
  name("notes.md").click();
  name("notes.md").click();
  expect([asks, panel.fetchOne("p1", { name: "notes.md" }), saved.length]).toEqual([1, null, 0]);
  go();
  await settled();
  expect([asks, saved]).toEqual([1, [["notes.md", [...new TextEncoder().encode("# notes")]]]]);
  // The name is free after the answer: a press asks again. Bytes that are not text are saved as they were attached.
  hold = null;
  name("notes.md").click();
  await settled();
  name("b.bin").click();
  await settled();
  expect([asks, saved.length, saved[2]]).toEqual([3, 3, ["b.bin", [255, 0]]]);
  // A refused read saves nothing, says so, and leaves the name to be pressed again.
  refuse = true;
  name("b.bin").click();
  await settled();
  expect([asks, saved.length, panel.textContent.includes("issue.attachment was refused: gone")]).toEqual([4, 3, true]);
  refuse = false;
  name("b.bin").click();
  await settled();
  expect([asks, saved.length]).toEqual([5, 4]);
  end();
  return "two presses ask once; a refused read saves nothing and the name can be pressed again";
}
