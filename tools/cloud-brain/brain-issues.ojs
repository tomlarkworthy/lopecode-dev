  };
}
// %%
// JSON with keys sorted and no whitespace: what an event's hash and a workflow's hash are taken of.
issueCanon = {
  const canon = (v) =>
    v === null || typeof v !== "object"
      ? JSON.stringify(v ?? null)
      : Array.isArray(v)
        ? "[" + v.map(canon).join(",") + "]"
        : "{" + Object.keys(v).filter((k) => v[k] !== undefined).sort().map((k) => JSON.stringify(k) + ":" + canon(v[k])).join(",") + "}";
  return canon;
}
// %%
// An ECDSA P-256 key from its JWK as text. Two signatures of one hash differ. With the private part (d) it signs; the public part alone checks.
issueKeys = async (text) => {
  const jwk = typeof text === "string" ? JSON.parse(text) : text, pub = { kty: jwk.kty, crv: jwk.crv, x: jwk.x, y: jwk.y };
  const curve = { name: "ECDSA", namedCurve: "P-256" }, alg = { name: "ECDSA", hash: "SHA-256" };
  const b64 = (bytes) => btoa(String.fromCharCode(...new Uint8Array(bytes))).replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
  const un = (s) => Uint8Array.from(atob(String(s).replace(/-/g, "+").replace(/_/g, "/")), (c) => c.charCodeAt(0));
  const enc = (s) => new TextEncoder().encode(s);
  const priv = jwk.d ? await crypto.subtle.importKey("jwk", { ...pub, d: jwk.d }, curve, false, ["sign"]) : null;
  const key = await crypto.subtle.importKey("jwk", pub, curve, false, ["verify"]);
  return {
    public: pub,
    sign: async (hash) => b64(await crypto.subtle.sign(alg, priv, enc(hash))),
    verify: async (hash, sig) => crypto.subtle.verify(alg, key, un(sig), enc(hash)).catch(() => false)
  };
}
// %%
issueView = () => ({ seq: 0, head: "", policy: null, workflows: {}, issues: {} })
// %%
// map[key] for a key a caller wrote: its own entries only, so "constructor" names no issue and no workflow.
issueAt = (map, key) => (map && typeof key === "string" && Object.hasOwn(map, key) ? map[key] : undefined)
// %%
// Who acted, as one name: the delegation a call was under, or else the caller. The holder is not it: on cb4 on
// 2026-10-10 every token's call arrived with the holder "secret", so two tokens would have been one actor.
issueActor = (by) => (by && /^delegation:/.test(by.via || "") ? by.via : (by && by.caller) || "anonymous")
// %%
// What a guard reads about who acts, from an event's `by`.
issueCaller = (by) => {
  const c = callerOf(by);
  return { id: c.id, kind: c.kind, via: (by && by.via) || "", holder: c.holder, delegation: c.delegation, actor: issueActor(by), present: c.id === "owner" && !!by && by.via === "session" && by.tab !== false };
}
// %%
// The issues at the other end of an issue's links: what a swap of it may change.
issueEnds = (i) => [...new Set([...(i.links || []).map((l) => l.to), ...(i.linked || []).map((l) => l.id)])]
// %%
// The run an issue keeps for a role and a round: what a cost event of that role and round replaces.
issueRunOf = (i, e) => ((i && i.runs) || []).find((r) => r.role === e.role && r.round === e.round)
// %%
// The totals of some runs: of one issue (issue.get), of one role of it, of every run a query matches (issue.runs).
// No I/O. The token sums are of the runs that have a usage, which `billed` counts. usd is the sum of what the runs
// that have one reported, to a millionth; with no such run it is left out, with usdRuns.
issueCost = (runs) => {
  const all = runs || [], billed = all.filter((r) => r.usage), paid = all.filter((r) => r.usd !== undefined);
  const sum = (rows, of) => rows.reduce((n, r) => n + of(r), 0);
  return {
    runs: all.length,
    seconds: sum(all, (r) => r.seconds),
    billed: billed.length,
    ...Object.fromEntries(["input", "cacheWrite", "cacheRead", "output", "requests"].map((k) => [k, sum(billed, (r) => r.usage[k])])),
    advisor: Object.fromEntries(["calls", "input", "output"].map((k) => [k, sum(billed, (r) => r.usage.advisor[k])])),
    ...(paid.length ? { usd: Math.round(sum(paid, (r) => r.usd) * 1e6) / 1e6, usdRuns: paid.length } : {})
