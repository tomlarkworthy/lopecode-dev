  }
  if (act.type === "narrow" && act.remove != null) return i.extra.some((x) => x.n === act.remove) ? present() : no("no such guard", true);
  if (act.type === "narrow" && !wf.moves.some((m) => m.name === act.move)) return no("the workflow has no move " + act.move);
