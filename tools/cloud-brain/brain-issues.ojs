// %%
// The page's copy of the view between visits, one for each Brain's address. A browser may refuse it; the panel then
// starts from a snapshot. A kept copy is used only while its head is still an event of the record (issue.sync's reset).
issuesStore = (brain = "") => ((name) => ({
  name,
  get: () => {
    try {
      return JSON.parse(localStorage.getItem(name));
    } catch (e) {
      return null;
    }
  },
  set: (view) => {
    try {
      localStorage.setItem(name, JSON.stringify(view));
    } catch (e) {}
  }
}))(issuesStoreName(brain))
// %%
// The key of the page's copy. A cell of its own: issuesStore names localStorage, which a test with no browser cannot read.
// brain_issues2 since 2026-10-12: a copy kept under the first name was made by an issueApply that knew no cost event.
issuesStoreName = (brain = "") => "brain_issues2 " + brain
// %%
// The first choice of the panel's State filter. Not a state's name: a state has no space in it.
issuesOpenWork = "open work"
// %%
// The text of the choice for every issue, whose value is "". A space in it for the same reason: a state may be named all.
issuesEveryIssue = "every issue"
