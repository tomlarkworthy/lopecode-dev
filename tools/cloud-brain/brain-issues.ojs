issueAllowed = (view, by, act) => {
  const caller = issueCaller(by), no = (why, missing) => ({ allow: false, why, ...(missing ? { missing: true } : {}) });
  const present = () => (caller.present ? { allow: true } : no("the owner, present"));
  // The first policy of a Brain is the default one, written by the Worker itself.
  if (act.type === "policy") return !view.seq && !view.policy && caller.id === "worker:brain-x-issues" ? { allow: true } : present();
  if (!view.policy) return no("no policy is installed");
  const facts = (i) => {
    const kids = Object.values(view.issues).filter((k) => k.parent === i.id);
    return { id: i.id, kind: i.kind, about: i.about, state: i.state, labels: i.labels, parent: i.parent || "", opener: i.opener, major: i.labels.includes("major"), by: i.by, reviews: i.reviews, links: i.links || [], children: { total: kids.length, open: kids.filter((k) => !k.closed).length } };
  };
  const refs = act.refs || [];
  const event = { type: act.type, rel: act.rel || "", to: typeof act.to === "string" ? act.to : "", reason: act.reason || "", refs, refKinds: refs.map((r) => r.kind), verdict: act.verdict || "", add: act.add || [], remove: Array.isArray(act.remove) ? act.remove : [] };
  const test = (guard, issue) => typeof guard === "string" && decide({ allow: guard }, { caller, issue, event }).allow;
  if (act.type === "open") {
    const hash = issueAt(view.policy.names, issueAt(view.policy.kinds, act.kind)), wf = issueAt(view.workflows, hash);
    if (!wf) return no("no workflow for the kind " + act.kind);
    if (issueAt(view.issues, act.id)) return no("an issue has this id");
    // A parent the caller may not read is no parent: a child holds its parent back from ready and from review.
    const p = act.parent ? issueAt(view.issues, act.parent) : null;
    if (act.parent && (!p || p.hidden || !test((issueAt(view.workflows, p.workflow) || {}).read, facts(p)))) return no("no such parent", true);
    const issue = facts({ id: act.id, kind: act.kind, about: act.about, state: wf.start, labels: act.labels || [], parent: act.parent, opener: caller.actor, by: {}, reviews: [] });
    return test(wf.open, issue) ? { allow: true, workflow: hash, state: wf.start } : no("the workflow's open guard refuses");
  }
