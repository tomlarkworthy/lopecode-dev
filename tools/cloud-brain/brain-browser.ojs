        const cdp = await connect(b.sessionId);
        if (!cdp) {
          if (!(await alive(b.sessionId))) (await end(b.sessionId, "browser ended", at, false), out.ended.push(b.sessionId), out.closed.push(...mine.map((p) => p.name)));
          continue;
        }
        try {
          // The command that keeps the browser up. It also shows which tabs are gone.
          const targets = new Set((await cdp.send("Target.getTargets")).targetInfos.map((t) => t.targetId));
          let open = 0;
          for (const p of mine) {
            if (targets.has(p.targetId)) open++;
            else if (p.own) (await end(b.sessionId, "page ended", at), out.ended.push(b.sessionId), out.closed.push(p.name));
            else (await rows.delete("page/" + p.name), await tomb(p.name, "page ended", at), out.closed.push(p.name));
          }
          // With no page: a browser of a page's own, and a second shared browser made when two starts crossed, close now.
          // The shared browser stays for the time that was bought.
          if (!open && (b.own ? at - b.opened > L.startGrace * 1000 : b !== first) && (await rows.get("browser/" + b.sessionId))) (await end(b.sessionId, "not needed", at), out.ended.push(b.sessionId));
          const now = await rows.get("browser/" + b.sessionId);
          if (now) (await rows.put("browser/" + b.sessionId, await meter(now, at)), out.kept++);
        } catch (e) {
          // A browser that takes a connection and answers no command for 10 s is closed. (2026-10-08: three tabs of a large notebook did this.)
          if (e && e.error === "Timeout") (await end(b.sessionId, "browser stopped answering", Date.now()), out.ended.push(b.sessionId), out.closed.push(...mine.map((p) => p.name)));
          else if (!(e && e.gone)) throw e;
        } finally {
          cdp.close();
        }
      }
      // Rows with nothing behind them: a page whose browser has no row, a reservation that was not finished.
      const have = new Set((await browsers()).map((b) => b.sessionId));
      for (const p of await pages())
        if (p.pending ? at - p.opened > L.startGrace * 1000 : !have.has(p.sessionId)) (await rows.delete("page/" + p.name), await tomb(p.name, "browser ended", at), out.closed.push(p.name));
      for (const r of await rows.list("ended/")) if (at - r.value.at > 86400000) await rows.delete(r.key);
      for (const r of await rows.list("usage/")) if (r.key < "usage/" + day(at - 62 * 86400000)) await rows.delete(r.key);
      // Rows of the daily limit that this service had until 2026-10-08.
      for (const prefix of ["bought/", "ledger/"]) for (const r of await rows.list(prefix)) await rows.delete(r.key);
      return out;
    }
  };
}
// %%
browserApp = {
  const app = new hono.Hono();
  const NS = "/xrpc/com.lopecode.brain.browser.";
  const fail = (c, status, error, message) => c.json({ error, message }, status);
  // The core names the caller and who started the chain. This service records them and decides nothing.
  const by = (c) => c.req.header("x-brain-caller") || "anonymous";
  const origin = (c) => c.req.header("x-brain-origin") || "";
  const body = async (c) => {
    const b = await c.req.json().catch(() => null);
    return b && typeof b === "object" ? b : {};
  };
  const answer = (fn) => async (c) => {
    try {
      const out = await fn(c);
      if (out instanceof Response) return out;
      // What the call bought, for the core: it charged the price of the seconds asked for and gives back the difference.
      return typeof out.costUsd === "number" ? c.json(out, 200, { "x-brain-cost": out.costUsd.toFixed(6) }) : c.json(out);
    } catch (e) {
      if (e && e.status) return fail(c, e.status, e.error, e.message);
      throw e;
    }
  };
  // seconds is in the query string: a rule, and later a price, reads request.params and not the body.
  app.post(NS + "open", answer(async (c) => browserOps.open({ ...(await body(c)), seconds: c.req.query("seconds") }, by(c), origin(c))));
  app.post(NS + "extend", answer(async (c) => browserOps.extend({ seconds: c.req.query("seconds"), name: c.req.query("name") }, by(c), origin(c))));
  app.post(NS + "run", answer(async (c) => browserOps.run({ ...(await body(c)), seconds: c.req.query("seconds") }, by(c), origin(c))));
  app.get(NS + "list", answer(() => browserOps.list()));
  app.get(NS + "status", answer((c) => browserOps.status(c.req.query("name"))));
  app.post(NS + "close", answer(async (c) => browserOps.close(await body(c))));
  app.post(NS + "goto", answer(async (c) => browserOps.goto(await body(c))));
  app.post(NS + "eval", answer(async (c) => browserOps.eval(await body(c))));
  app.get(NS + "text", answer((c) => browserOps.text({ name: c.req.query("name"), selector: c.req.query("selector") })));
  app.get(NS + "screenshot", answer(async (c) => {
    const data = await browserOps.screenshot({ name: c.req.query("name"), fullPage: c.req.query("fullPage") === "true", selector: c.req.query("selector") });
    return new Response(Uint8Array.from(atob(data), (ch) => ch.charCodeAt(0)), { headers: { "content-type": "image/png", "cache-control": "no-store" } });
  }));
  app.get(NS + "logs", answer((c) => browserOps.logs({ name: c.req.query("name") })));
  app.get(NS + "liveView", answer((c) => browserOps.liveView({ name: c.req.query("name") })));
  app.post(NS + "settings", answer(async (c) => browserOps.settings(await body(c))));
  return app;
}
// %%
browserPanel = ({ client, owner = false } = {}) => {
  if (!client || !owner) return Object.assign(htl.html`<i style="color:var(--theme-foreground-muted)">Sign in to a Brain as the owner to see its browser pages.</i>`, { value: null });
  const box = htl.html`<div></div>`, meterBox = htl.html`<div style="margin:6px 0"></div>`, note = htl.html`<div style="color:var(--theme-foreground-muted);margin-top:6px;white-space:pre-wrap;overflow-wrap:anywhere"></div>`, picture = htl.html`<div></div>`;
  let table = null;
  const say = (text) => void (note.textContent = text);
  const el = htl.html`<div></div>`;
  const tabs = Inputs.number({ label: "Pages at most", min: 1, max: 32, step: 1, width: "8em" });
  const draw = async () => {
    const s = await client.query("browser.status");
    el.value = s;
    table = Inputs.table(s.pages.map((p) => ({ name: p.name, url: p.url, age: p.age, idle: p.idle, by: p.by })), { multiple: false, required: false, layout: "auto" });
    const up = s.browsers.find((b) => !b.own);
    box.replaceChildren(s.pages.length ? table : htl.html`<i style="color:var(--theme-foreground-muted)">No pages.</i>`, htl.html`<div style="color:var(--theme-foreground-muted);font-size:12px">${up ? `The browser is paid for ${up.remaining} s more.` : "No browser is up."}</div>`);
    const u = s.usage;
    meterBox.replaceChildren(htl.html`${u.usedSeconds} browser-seconds used today (UTC), ${u.monthUsedSeconds} this month. Charges are in Spending.`);
    tabs.value = s.settings.maxTabs;
  };
  const run = (what, fn) => async () => {
    try {
      say(what + "…");
      say((await fn()) || "");
      await draw();
    } catch (e) {
      say(`${what} failed: ${(e && e.message) || e}`);
    }
  };
  const picked = () => {
    const row = table && table.value;
    if (!row) throw new Error("choose a row");
    return row.name;
  };
  const show = (bytes) => void picture.replaceChildren(htl.html`<img style="max-width:100%;border:1px solid var(--theme-foreground-faintest)" src=${URL.createObjectURL(new Blob([bytes], { type: "image/png" }))}>`);
  const paid = (r) => (r.bought ? `${r.bought} s bought, $${r.costUsd}` : "no time bought");
  draw().catch((e) => say("browser.status failed: " + ((e && e.message) || e)));
  const name = Inputs.text({ label: "Name", placeholder: "docs", width: "12em" }), url = Inputs.text({ label: "URL", placeholder: "https://example.com/", width: "30em" });
  const seconds = Inputs.number({ label: "Seconds", value: 60, min: 1, step: 1, width: "8em" });
  const expression = Inputs.text({ label: "Expression", placeholder: "document.title", width: "30em" });
  const refresh = Inputs.button("Refresh", { reduce: run("Refresh", async () => "") });
  const open = Inputs.button("Open", { reduce: run("Open", async () => ((r) => (r.existing ? "it was open; " : `open in ${r.ms} ms; `) + paid(r))(await client.procedure("browser.open", { name: name.value, url: url.value }, { params: { seconds: seconds.value } }))) });
  const extend = Inputs.button("Extend", { reduce: run("Extend", async () => paid(await client.procedure("browser.extend", {}, { params: { seconds: seconds.value } }))) });
  const close = Inputs.button("Close", { reduce: run("Close", async () => void (await client.procedure("browser.close", { name: picked() }))) });
  const closeAll = Inputs.button("Close all", { reduce: run("Close all", async () => void (await client.procedure("browser.close", { all: true }))) });
  const picture1 = Inputs.button("Screenshot", { reduce: run("Screenshot", async () => void show(await client.query("browser.screenshot", { name: picked() }))) });
  const once = Inputs.button("Run once", {
    reduce: run("Run", async () => {
      const r = await client.procedure("browser.run", { url: url.value, expression: expression.value || undefined, screenshot: true }, { params: { seconds: Math.min(seconds.value, 120) } });
      if (r.screenshot) show(Uint8Array.from(atob(r.screenshot), (ch) => ch.charCodeAt(0)));
      return JSON.stringify({ ...r, screenshot: undefined }, null, 1).slice(0, 2000);
    })
  });
  const save = Inputs.button("Save limits", { reduce: run("Save", async () => void (await client.procedure("browser.settings", { maxTabs: tabs.value }))) });
  const rowOf = (...items) => htl.html`<div style="display:flex;gap:8px;flex-wrap:wrap;margin:8px 0">${items}</div>`;
  el.append(box, meterBox, rowOf(refresh, close, closeAll, picture1), name, url, seconds, expression, rowOf(open, once, extend), tabs, rowOf(save), note, picture);
  return el;
}
// %%
md`## Tests

The tests run the emitted Worker in the tab against \`browserFake\`: the HTTP paths of the Browser Run binding and enough CDP for this service. A page of the fake is a title, a text and a few elements. The fake does not render, and its screenshot is the PNG signature followed by the parameters of the capture.`
// %%
browserFake = ({ sites = {} } = {}) => {
  const sessions = new Map(), stores = new Map();
  const stats = { acquired: 0, connects: 0, deleted: [], commands: [], params: [] };
  let n = 0;
  const fake = { sessions, stats, sites, refuse: null, onAcquire: null };
  fake.session = (startTime = Date.now()) => {
    const id = "s" + ++n;
    sessions.set(id, { id, startTime, targets: new Map(), contexts: new Set(), sockets: new Set() });
    sessions.get(id).targets.set("t0-" + id, { id: "t0-" + id, contextId: "default", url: "about:blank" });
    return id;
  };
  // The browser is gone: a crash, or Browser Run's own idle timer.
  fake.kill = (id) => {
    const s = sessions.get(id);
    if (!s) return false;
    sessions.delete(id);
    for (const k of [...s.sockets]) k.end();
    return true;
  };
  // The browser takes connections and answers nothing.
  fake.wedge = (id) => void (sessions.get(id).wedged = true);
  fake.targets = (id) => [...sessions.get(id).targets.values()].filter((t) => t.contextId !== "default");
  const storage = (contextId, origin) => {
    const key = contextId + " " + origin;
    if (!stores.has(key)) stores.set(key, new Map());
    const m = stores.get(key);
    return { getItem: (k) => (m.has(k) ? m.get(k) : null), setItem: (k, v) => void m.set(k, String(v)) };
  };
  const load = (t, url, scripts) => {
    const site = sites[url] || { title: "Page " + url, text: "text of " + url };
    const quiet = () => {};
    const console = { log: quiet, info: quiet, warn: quiet, error: quiet, debug: quiet };
    const window = { scrollX: 0, scrollY: 0 };
    const document = {
      title: site.title, readyState: "complete", body: { innerText: site.text },
      querySelector: (sel) => (site.elements && sel in site.elements ? { innerText: site.elements[sel], getBoundingClientRect: () => ({ x: 10, y: 20, width: 30, height: 40 }) } : null)
    };
    t.url = url;
    t.site = site;
    t.scope = { window, document, location: { href: url }, localStorage: storage(t.contextId, url.startsWith("http") ? new URL(url).origin : url), console, addEventListener: quiet };
    for (const s of scripts) evaluate(t, s);
  };
  const evaluate = (t, expression) => new Function(...Object.keys(t.scope), "return (" + expression + "\n)")(...Object.values(t.scope));
  const thrown = (e) => ({ result: { type: "object", subtype: "error" }, exceptionDetails: { text: "Uncaught", lineNumber: 0, columnNumber: 4, exception: { description: String(e) } } });
  const socket = (s) => {
    const listeners = { message: [], close: [] }, attached = new Map(), objects = new Map();
    let open = true;
    const emit = (type, e) => setTimeout(() => listeners[type].forEach((f) => f(e)), 0);
    const say = (m) => open && emit("message", { data: JSON.stringify(m) });
    const target = (sessionId) => {
      const a = attached.get(sessionId);
      if (!a || !s.targets.has(a.target.id)) throw new Error("Session with given id not found.");
      return a;
    };
    const handle = async ({ method, params = {}, sessionId }) => {
      stats.commands.push(method);
      stats.params.push(params);
      if (method === "Browser.getVersion") return { product: "Fake/1" };
      if (method === "Target.getTargets") return { targetInfos: [...s.targets.values()].map((t) => ({ targetId: t.id, type: "page", url: t.url, browserContextId: t.contextId })) };
      if (method === "Target.createBrowserContext") {
        const id = "c" + ++n;
        s.contexts.add(id);
        return { browserContextId: id };
      }
      if (method === "Target.disposeBrowserContext") {
        if (!s.contexts.delete(params.browserContextId)) throw new Error("Failed to find context with id " + params.browserContextId);
        for (const t of [...s.targets.values()]) if (t.contextId === params.browserContextId) s.targets.delete(t.id);
        return {};
      }
      if (method === "Target.createTarget") {
        if (!s.contexts.has(params.browserContextId)) throw new Error("Failed to find browser context with id " + params.browserContextId);
        const t = { id: "t" + ++n, contextId: params.browserContextId, size: [params.width, params.height] };
        load(t, params.url, []);
        s.targets.set(t.id, t);
        return { targetId: t.id };
      }
      if (method === "Target.attachToTarget") {
        const t = s.targets.get(params.targetId);
        if (!t) throw new Error("No target with given id found");
        const id = "a" + ++n;
        attached.set(id, { target: t, scripts: [] });
        return { sessionId: id };
      }
      if (method === "Target.closeTarget") return { success: s.targets.delete(params.targetId) };
      const a = target(sessionId), t = a.target;
      if (method === "Page.enable") return {};
      if (method === "Page.addScriptToEvaluateOnNewDocument") return a.scripts.push(params.source), { identifier: String(a.scripts.length) };
      if (method === "Page.navigate") {
        const site = sites[params.url] || {};
        if (site.fail) return { frameId: "f", errorText: site.fail };
        load(t, params.url, a.scripts);
        if (!site.never) setTimeout(() => say({ method: "Page.loadEventFired", params: {}, sessionId }), site.ms || 0);
        return { frameId: "f" };
      }
      if (method === "Runtime.evaluate") {
        try {
          let v = evaluate(t, params.expression);
          if (params.awaitPromise) v = await v;
          if (v === undefined) return { result: { type: "undefined" } };
          // An object is a handle unless the value is asked for. The handle is good on this connection.
          if (params.returnByValue || v === null || (typeof v !== "object" && typeof v !== "function")) return { result: { type: typeof v, value: v } };
          const objectId = "o" + ++n;
          objects.set(objectId, v);
          return { result: { type: "object", ...(v instanceof Promise ? { subtype: "promise" } : {}), objectId } };
        } catch (e) {
          return thrown(e);
        }
      }
      if (method === "Runtime.callFunctionOn") {
        if (!objects.has(params.objectId)) throw new Error("Could not find object with given id");
        try {
          const v = evaluate(t, params.functionDeclaration).apply(objects.get(params.objectId), (params.arguments || []).map((a) => a.value));
          return { result: v === undefined ? { type: "undefined" } : { type: typeof v, value: v } };
        } catch (e) {
          return thrown(e);
        }
      }
      if (method === "Page.getLayoutMetrics") return { cssContentSize: { x: 0, y: 0, width: 1280, height: 3000 } };
      if (method === "Page.captureScreenshot") {
        const bytes = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, ...new TextEncoder().encode(JSON.stringify(params).padEnd(t.site.shotBytes || 0, " "))];
        let text = "";
        for (let i = 0; i < bytes.length; i += 8192) text += String.fromCharCode.apply(null, bytes.slice(i, i + 8192));
        return { data: btoa(text) };
      }
      throw new Error("the fake does not know " + method);
    };
    const k = {
      accept() {},
      addEventListener: (type, f) => void (listeners[type] && listeners[type].push(f)),
      send(text) {
        const m = JSON.parse(text);
        if (!open || s.wedged) return;
        Promise.resolve().then(() => handle(m)).then((result) => say({ id: m.id, result }), (e) => say({ id: m.id, error: { message: String((e && e.message) || e) } }));
      },
      close() {
        open = false;
        s.sockets.delete(k);
      },
      end() {
        if (!open) return;
        emit("close", { code: 1006, reason: "browser ended" });
        s.sockets.delete(k);
        setTimeout(() => (open = false), 0);
      }
    };
    s.sockets.add(k);
    return k;
  };
  fake.fetch = async (request) => {
    const u = new URL(request.url), method = request.method, json = (v, status = 200) => new Response(JSON.stringify(v), { status, headers: { "content-type": "application/json" } });
    if (u.pathname === "/v1/sessions") return json({ sessions: [...sessions.values()].map((s) => ({ sessionId: s.id, startTime: s.startTime })) });
    if (u.pathname === "/v1/devtools/browser" && method === "POST") {
      if (fake.refuse) return json({ success: false, errors: [{ message: fake.refuse }] }, 429);
      stats.acquired++;
      const id = fake.session();
      if (fake.onAcquire) await fake.onAcquire(id);
      return json({ sessionId: id });
    }
    const m = u.pathname.match(/^\/v1\/devtools\/browser\/([^/]+)(\/json\/list)?$/);
    const s = m && sessions.get(m[1]);
    if (!m) return json({ error: "no such path " + u.pathname }, 404);
    if (!s) return json({ success: false, errors: [{ message: "session not found" }] }, 404);
    if (m[2]) return json([...s.targets.values()].map((t) => ({ id: t.id, url: t.url, devtoolsFrontendUrl: `https://live.example/${s.id}/${t.id}` })));
    if (method === "DELETE") return stats.deleted.push(s.id), fake.kill(s.id), json({ status: "closed" });
    // A browser cannot answer 101 with a Response, and drops the Upgrade header of a Request. A GET of the session is the connect.
    stats.connects++;
    return { status: 101, webSocket: socket(s) };
  };
  return fake;
}
// %%
browserRig = async ({ sites = {} } = {}) => {
  const fake = browserFake({ sites });
  const sim = await simulate(browser_service, { browser: fake.fetch });
  const X = "https://brain.internal/xrpc/com.lopecode.brain.browser.";
  const as = (who, origin = who) => {
    const headers = { "content-type": "application/json", "x-brain-caller": who, "x-brain-context": "for " + who, "x-brain-origin": origin };
    const read = async (r) => ({ status: r.status, cost: r.headers.get("x-brain-cost"), data: (r.headers.get("content-type") || "").includes("json") ? await r.json() : new Uint8Array(await r.arrayBuffer()) });
    const query = (params) => (Object.keys(params).length ? "?" + new URLSearchParams(params) : "");
    return {
      get: async (m, params = {}) => read(await sim.fetch(X + m + query(params), { headers })),
      post: async (m, body = {}, params = {}) => read(await sim.fetch(X + m + query(params), { method: "POST", body: JSON.stringify(body), headers }))
    };
  };
  const owner = as("owner");
  const keys = (prefix) => [...sim.rows.keys()].filter((k) => k.startsWith(prefix)).sort();
  const session = () => (keys("browser/")[0] || "").slice("browser/".length);
  return {
    sim, fake, rows: sim.rows, as, owner, keys, session, tick: () => sim.scheduled(),
    open: async (name, url = "https://a.example/", more = {}, params = {}) => (await owner.post("open", { name, url, ...more }, params)).data,
    // The time the shared browser is paid to, in seconds from now; and a way to move it, since the Worker reads the clock.
    paid: () => Math.round((sim.rows.get("paid/" + session()) - Date.now()) / 1000),
    setPaid: (seconds, sid = session()) => sim.rows.set("paid/" + sid, Date.now() + seconds * 1000),
    // What the core would charge for a call: the price of the method with this query string.
    price: async (method, params = {}) => {
      const rule = (await browser_service.emit()).meta.access["com.lopecode.brain.browser." + method];
      for (let micro = 0; micro <= 20000; micro += 25) if (decide({ allow: `(${rule.price}) < ${(micro + 12) / 1e6}` }, { caller: callerOf({ caller: "owner" }), request: { params } }).allow) return micro / 1e6;
      return null;
    }
  };
}
// %%
test_browser_declares_what_it_needs = {
  const { meta, parts } = await browser_service.emit();
  expect(meta).toMatchObject({ worker: "brain-x-browser", role: "recipe", module: "@tomlarkworthy/brain-browser", resources: ["browser", "rows"], secrets: [], paths: [], calls: [], crons: ["* * * * *"] });
  expect(meta.bindings).toContainEqual({ type: "browser", name: "X_CF_BROWSER_RUN" });
  expect(parts[0].text).toContain('__rt.platform.workers.fetch("cf-browser-run"');
  // Who the rule of each method lets through before the owner changes it.
  const callers = { owner: { caller: "owner", via: "session" }, token: { caller: "token:laptop" }, granted: { caller: "did:plc:ada" }, worker: { caller: "worker:brain-x-reader" }, anyone: { caller: "anonymous" } };
  const through = (rule, params = {}) => Object.entries(callers).filter(([, w]) => decide(rule, { caller: callerOf(w), request: { method: "", path: "", verb: "POST", params } }).allow).map(([n]) => n).join(" ");
  const N = "com.lopecode.brain.browser.";
  for (const m of ["open", "extend", "run", "list", "status", "close", "goto", "eval", "text", "screenshot", "logs"]) expect([m, through(meta.access[N + m])]).toEqual([m, "owner token granted"]);
  // The limits and the Live View link: the owner's own session, and the owner cannot put a different rule.
  for (const m of ["settings", "liveView"]) expect([m, through(meta.access[N + m]), meta.access[N + m].fixed]).toEqual([m, "owner", true]);
  // A Worker gets in when the owner puts a rule that names it. The core also needs the method in that Worker's calls.
  // The seconds a call buys are in the query string, so a rule can read them.
  const rule = { allow: 'caller.trusted || (caller.worker == "brain-x-reader" && int(request.params.seconds) <= 30)' };
  expect([through(rule, { seconds: "30" }), through(rule, { seconds: "31" })]).toEqual(["owner token granted worker", "owner token granted"]);
  return Object.keys(meta.access).length + " methods";
}
// %%
test_browser_open_makes_a_tab_and_reuses_it_by_name = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha" } } });
  const a = await rig.open("a");
  expect(a).toMatchObject({ name: "a", open: true, url: "https://a.example/", by: "owner", loaded: true, cold: true, existing: false, credential: null, bought: 60, costUsd: 0.0015 });
  // The same name gives the same tab. A second name is a second tab in the same browser.
  expect(await rig.open("a", "https://other.example/")).toMatchObject({ existing: true, url: "https://a.example/", title: "A" });
  const b = (await rig.as("token:laptop", "did:plc:ada").post("open", { name: "b", url: "https://a.example/" })).data;
  expect(b).toMatchObject({ cold: false, by: "token:laptop", origin: "did:plc:ada" });
  expect([rig.fake.stats.acquired, rig.fake.sessions.size, rig.keys("browser/").length, rig.keys("page/")]).toEqual([1, 1, 1, ["page/a", "page/b"]]);
  const sid = rig.session();
  expect(rig.fake.targets(sid).map((t) => t.size)).toEqual([[1280, 800], [1280, 800]]);
  // Each page has its own storage, for the same origin. Two pages opened with one label share it.
  const ev = async (name, expression) => (await rig.owner.post("eval", { name, expression })).data;
  await ev("a", 'localStorage.setItem("k", "one")');
  expect([(await ev("a", 'localStorage.getItem("k")')).value, (await ev("b", 'localStorage.getItem("k")')).value]).toEqual(["one", null]);
  await rig.open("c", "https://a.example/", { shared: "team" });
  await rig.open("d", "https://a.example/", { shared: "team" });
  await ev("c", 'localStorage.setItem("k", "two")');
  expect((await ev("d", 'localStorage.getItem("k")')).value).toBe("two");
  expect(new Set(rig.fake.targets(sid).map((t) => t.contextId)).size).toBe(3);
  // Closing one of the two leaves the other its storage. Closing a page leaves the browser.
  expect((await rig.owner.post("close", { name: "c" })).data).toEqual({ closed: ["c"] });
  expect((await ev("d", 'localStorage.getItem("k")')).value).toBe("two");
  expect((await rig.owner.get("list")).data.pages.map((p) => p.name)).toEqual(["a", "b", "d"]);
  expect((await rig.owner.get("status", { name: "c" })).data).toMatchObject({ open: false, closed: "closed" });
  expect((await rig.owner.get("status", { name: "nobody" })).status).toBe(404);
  // A page with its own browser, which closes with the page.
  expect(await rig.open("solo", "https://a.example/", { own: true })).toMatchObject({ own: true, cold: true, bought: 60 });
  expect((await rig.owner.get("status")).data.browsers.map((x) => [x.own, x.pages])).toEqual([[null, ["a", "b", "d"]], ["solo", ["solo"]]]);
  await rig.owner.post("close", { name: "solo" });
  expect([rig.fake.sessions.size, rig.keys("browser/").length]).toEqual([1, 1]);
  // close all closes the browsers at once.
  expect((await rig.owner.post("close", { all: true })).data.closed.sort()).toEqual(["a", "b", "d"]);
  expect([rig.fake.sessions.size, rig.keys("browser/"), rig.keys("page/"), rig.keys("paid/")]).toEqual([0, [], [], []]);
  return "one browser, 4 tabs, 3 contexts; one browser of its own";
}
// %%
test_browser_time_is_bought_before_it_is_used = {
  const rig = await browserRig();
  const near = (got, want) => (Math.abs(got - want) <= 3 ? want : got);
  // open starts the browser and buys its seconds. The number is in the query string. The answer says what was bought, for the core.
  const first = await rig.owner.post("open", { name: "a", url: "https://a.example/" }, { seconds: 100 }), a = first.data;
  expect([a.bought, a.costUsd, first.cost, near(Math.round((a.paidUntil - Date.now()) / 1000), 100)]).toEqual([100, 0.0025, "0.002500", 100]);
  // Time that is already bought covers a second page: nothing more is bought, and the core gives the price back.
  const second = await rig.owner.post("open", { name: "b", url: "https://a.example/" }, { seconds: 60 });
  expect([second.data.bought, second.cost, second.data.paidUntil]).toEqual([0, "0.000000", a.paidUntil]);
  const ran = await rig.owner.post("run", { url: "https://a.example/" }, { seconds: 30 });
  expect([ran.data.bought, ran.cost, ran.data.cold]).toEqual([0, "0.000000", false]);
  // A page that needs more buys the difference.
  const c = await rig.as("token:laptop", "did:plc:ada").post("open", { name: "c", url: "https://a.example/" }, { seconds: 150 });
  expect([near(c.data.bought, 50), c.cost, near(rig.paid(), 150)]).toEqual([50, c.data.costUsd.toFixed(6), 150]);
  // extend adds to the time the browser has.
  const before = rig.rows.get("paid/" + rig.session());
  const more = await rig.owner.post("extend", {}, { seconds: 45 });
  expect([more.data, more.cost]).toEqual([{ paidUntil: before + 45000, bought: 45, costUsd: 0.001125 }, "0.001125"]);
  // A refusal is not 2xx, so the core gives the whole price back.
  for (const seconds of [0, 601, 1.5, "x"]) expect([seconds, (await rig.owner.post("extend", {}, { seconds })).status]).toEqual([seconds, 400]);
  expect((await rig.owner.post("extend", {})).status).toBe(400);
  expect((await rig.owner.post("open", { name: "z", url: "https://a.example/" }, { seconds: 9 })).data.message).toBe("seconds: a whole number from 10 to 600. The setting is maxSeconds.");
  // Use of a page does not add time. When the time has passed, the next call closes the browser with its pages open.
  await rig.owner.post("eval", { name: "a", expression: "1" });
  expect(rig.rows.get("paid/" + rig.session())).toBe(more.data.paidUntil);
  rig.setPaid(-1);
  const late = await rig.owner.post("eval", { name: "a", expression: "1" });
  expect([late.status, late.data.message, rig.fake.sessions.size, rig.keys("browser/"), rig.keys("page/")]).toEqual([410, "page a is closed: time ran out", 0, [], []]);
  expect((await rig.owner.get("status", { name: "b" })).data).toMatchObject({ open: false, closed: "time ran out" });
  expect((await rig.owner.post("extend", {}, { seconds: 10 })).data).toEqual({ error: "NotFound", message: "no browser is up. open starts one." });
  // The tick does the same when no call comes.
  await rig.open("d");
  rig.setPaid(-1);
  await rig.tick();
  expect([rig.fake.sessions.size, (await rig.owner.get("status", { name: "d" })).data.closed]).toEqual([0, "time ran out"]);
  // A browser with time left and no page stays up.
  await rig.open("e");
  await rig.owner.post("close", { name: "e" });
  await rig.tick();
  expect([rig.fake.sessions.size, rig.paid() > 50]).toEqual([1, true]);
  return "bought 100, covered 2, extended 45, closed when the time ran out";
}
// %%
test_browser_price_is_the_seconds_a_call_asks_for = {
  const rig = await browserRig();
  // The core reads the price from the query string. With no seconds, the price is for the number the method then uses.
  expect([await rig.price("open", { seconds: "100" }), await rig.price("open"), await rig.price("run", { seconds: "30" }), await rig.price("run"), await rig.price("extend", { seconds: "45" })]).toEqual([0.0025, 0.0015, 0.00075, 0.00075, 0.001125]);
  expect([(await rig.open("a")).bought, (await rig.owner.post("close", { all: true })).status, (await rig.owner.post("run", { url: "https://a.example/" })).data.bought]).toEqual([60, 200, 30]);
  // extend has no number of its own: with no seconds its price cannot be decided, and the core refuses the call.
  const rule = (await browser_service.emit()).meta.access["com.lopecode.brain.browser.extend"];
  expect(decide({ allow: `(${rule.price}) >= 0.0` }, { caller: callerOf({ caller: "owner" }), request: { params: {} } }).error).not.toBe(null);
  // The methods that buy no time have no price.
  const access = (await browser_service.emit()).meta.access;
  expect(Object.keys(access).filter((k) => access[k].price).map((k) => k.split(".").pop()).sort()).toEqual(["extend", "open", "run"]);
  // The answer never says more than the price: a call buys the seconds it asked for at most.
  const burst = await Promise.all([1, 2, 3].map((i) => rig.owner.post("open", { name: "p" + i, url: "https://a.example/" }, { seconds: 20 })));
  expect(burst.every((r) => Number(r.cost) <= 0.0005)).toBe(true);
  // Browser Run starts no browser: the call is not 2xx, and no row is left.
  await rig.owner.post("close", { all: true });
  rig.fake.refuse = "rate limit";
  const none = await rig.owner.post("open", { name: "d", url: "https://a.example/" });
  expect([none.status, none.data.error, none.cost, rig.keys("page/"), rig.keys("starting/"), rig.keys("browser/")]).toEqual([502, "BrowserUnavailable", null, [], [], []]);
  rig.fake.refuse = null;
  // One browser lives maxSession at most.
  expect((await rig.owner.post("settings", { maxSession: 100 })).data).toEqual({ maxTabs: 8, maxSeconds: 600, maxSession: 100 });
  await rig.open("e");
  expect((await rig.owner.post("extend", {}, { seconds: 41 })).data).toMatchObject({ error: "SessionLimit" });
  expect((await rig.owner.post("extend", {}, { seconds: 39 })).data.bought).toBe(39);
  for (const bad of [{ maxTabs: 0 }, { maxTabs: 33 }, { maxSession: 10 }, { maxSeconds: 5 }]) expect((await rig.owner.post("settings", bad)).status).toBe(400);
  // The rows of the daily limit that the service had before the core's prices are removed by the tick.
  rig.rows.set("bought/2026-10-08", 165);
  rig.rows.set("ledger/x", { seconds: 1 });
  await rig.tick();
  expect([rig.keys("bought/"), rig.keys("ledger/")]).toEqual([[], []]);
  return "open 60 s $0.0015, run 30 s $0.00075; no price for the rest";
}
// %%
test_browser_eval_gives_a_value_or_what_the_page_threw = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha" } } });
  await rig.open("a");
  const ev = async (body) => rig.owner.post("eval", { name: "a", ...body });
  expect((await ev({ expression: "document.title" })).data).toEqual({ value: "A", type: "string" });
  expect((await ev({ expression: "({ n: [1, 2] })" })).data).toEqual({ value: { n: [1, 2] }, type: "object" });
  expect((await ev({ expression: "Promise.resolve({ n: 1 + 1 })" })).data).toEqual({ value: { n: 2 }, type: "object" });
  expect((await ev({ expression: "new Promise((yes) => setTimeout(() => yes(7), 300))" })).data).toEqual({ value: 7, type: "number" });
  expect((await ev({ expression: "undefined" })).data).toEqual({ value: null, type: "null" });
  // What the page throws is a result with status 200.
  const thrown = await ev({ expression: '(() => { throw new Error("boom"); })()' });
  expect([thrown.status, thrown.data.thrown.message, thrown.data.thrown.column]).toEqual([200, "Error: boom", 4]);
  expect((await ev({ expression: 'Promise.reject(new Error("later"))' })).data.thrown.message).toMatch(/^Error: later/);
  // A promise that does not settle: the call stops at the timeout and the page stays open.
  const slow = await ev({ expression: "new Promise(() => {})", timeout: 300 });
  expect([slow.status, slow.data]).toEqual([504, { error: "Timeout", message: "the promise did not settle in 300 ms" }]);
  expect((await ev({ expression: "1 + 1" })).data.value).toBe(2);
  // No command waits on the promise: its result has a place in the page, and that place is read.
  expect(rig.fake.stats.params.filter((p) => p.awaitPromise === true).length).toBe(0);
  expect((await ev({ expression: "Object.keys(window).filter((k) => k.startsWith('__brainEval')).length" })).data.value).toBe(1);
  // A value too large to give back.
  const big = await ev({ expression: '"x".repeat(300000)' });
  expect([big.status, big.data.error, big.data.message]).toEqual([413, "TooLarge", "the value is 300002 characters of JSON. The limit is 262144."]);
  expect((await ev({})).status).toBe(400);
  expect((await rig.owner.post("eval", { name: "nobody", expression: "1" })).status).toBe(404);
  return "value, promise, thrown, timeout, too large";
}
// %%
test_browser_text_screenshot_logs_and_goto = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha body", elements: { "#main": "the main part" } }, "https://big.example/": { title: "Big", text: "y".repeat(100500), shotBytes: 2100000 }, "https://down.example/": { fail: "net::ERR_NAME_NOT_RESOLVED" } } });
  await rig.open("a");
  expect((await rig.owner.get("text", { name: "a" })).data).toEqual({ text: "alpha body", truncated: false });
  expect((await rig.owner.get("text", { name: "a", selector: "#main" })).data.text).toBe("the main part");
  expect((await rig.owner.get("text", { name: "a", selector: "#none" })).status).toBe(404);
  // A screenshot is PNG bytes. The fake puts the parameters of the capture after the signature.
  const said = (bytes) => JSON.parse(new TextDecoder().decode(bytes.slice(8)));
  const png = (await rig.owner.get("screenshot", { name: "a" })).data;
  expect([...png.slice(0, 4)]).toEqual([0x89, 0x50, 0x4e, 0x47]);
  expect(said(png)).toEqual({ format: "png" });
  expect(said((await rig.owner.get("screenshot", { name: "a", fullPage: "true" })).data).clip).toEqual({ x: 0, y: 0, width: 1280, height: 3000, scale: 1 });
  expect(said((await rig.owner.get("screenshot", { name: "a", selector: "#main" })).data).clip).toEqual({ x: 10, y: 20, width: 30, height: 40, scale: 1 });
  // Console calls are kept in the page, from before its own scripts, and are read by a later call.
  await rig.owner.post("eval", { name: "a", expression: 'console.log("one", { two: 2 })' });
  await rig.owner.post("eval", { name: "a", expression: 'console.error("x".repeat(600))' });
  const logs = (await rig.owner.get("logs", { name: "a" })).data.logs;
  expect(logs.map((l) => [l.level, l.text.length])).toEqual([["log", 13], ["error", 500]]);
  expect(logs[0].text).toBe('one {"two":2}');
  // goto loads a different address in the same tab. The log starts again with the document.
  expect((await rig.owner.post("goto", { name: "a", url: "https://big.example/" })).data).toMatchObject({ url: "https://big.example/", loaded: true });
  expect((await rig.owner.get("status", { name: "a" })).data.url).toBe("https://big.example/");
  expect((await rig.owner.get("logs", { name: "a" })).data.logs).toEqual([]);
  const text = (await rig.owner.get("text", { name: "a" })).data;
  expect([text.text.length, text.truncated]).toEqual([100000, true]);
  const large = await rig.owner.get("screenshot", { name: "a" });
  expect([large.status, large.data.error]).toEqual([413, "TooLarge"]);
  // An address that does not load: goto says so and the page stays; open leaves no page.
  const down = await rig.owner.post("goto", { name: "a", url: "https://down.example/" });
  expect([down.status, down.data.error, down.data.message]).toEqual([502, "NavigationFailed", "https://down.example/: net::ERR_NAME_NOT_RESOLVED"]);
  expect((await rig.owner.post("open", { name: "b", url: "https://down.example/" })).status).toBe(502);
  expect(rig.keys("page/")).toEqual(["page/a"]);
  expect(rig.fake.targets(rig.session()).length).toBe(1);
  // The Live View link of the tab.
  expect((await rig.owner.get("liveView", { name: "a" })).data.url).toMatch(/^https:\/\/live\.example\/s\d+\/t\d+$/);
  return "text, 3 screenshots, 2 log lines, goto, live view";
}
