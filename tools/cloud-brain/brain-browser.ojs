      // A start that died holds the lock. If Browser Run had made its browser, that one has no row and gets no command,
      // and Browser Run closes it after keepAlive. This service closes only the sessions it has a row for.
      for (const r of await rows.list("starting/")) if (at - r.value.at >= L.startGrace * 1000) await rows.delete(r.key);
      const all = await browsers(), first = all[0], paid = await paidUntil();
