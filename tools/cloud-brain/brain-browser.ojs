  const shut = async (p, reason, cdp) => {
    const at = Date.now();
    const c = cdp && !cdp.isClosed() ? cdp : p.targetId ? await connect(p.sessionId) : null;
    if (c) {
      await c.send("Target.closeTarget", { targetId: p.targetId }).catch(() => null);
