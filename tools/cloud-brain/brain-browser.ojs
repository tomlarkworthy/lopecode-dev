      return { name: p.name, url: t.devtoolsFrontendUrl };
    },
    // One page for one job: open, wait for load, read, close. It needs bought time for the whole of its timeout.
    // The tab closes when the job throws or runs out of time.
    run: async (q, by, origin) => {
      const url = allowed(q.url), timeout = Math.min(Math.max(Number(q.timeout) || L.runTimeout, 5000), L.maxTimeout), t0 = Date.now();
