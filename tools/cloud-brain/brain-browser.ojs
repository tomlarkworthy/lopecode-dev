      const r = await cdp.send("Runtime.evaluate", { expression: String(expression), returnByValue: false, awaitPromise: false, userGesture: true, timeout }, sid, timeout + 2000);
      if (r.exceptionDetails) return thrown(r.exceptionDetails);
