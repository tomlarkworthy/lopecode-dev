  // No command stays unanswered for long: a promise is given a place in the page for its result, and that place is read
  // every 100 to 500 ms. (2026-10-08: with Runtime.evaluate left waiting on a promise, calls from a second request failed.)
  const evaluate = async (cdp, sid, expression, { awaitPromise = true, timeout = L.evalTimeout } = {}) => {
    const thrown = (d) => ({ thrown: { message: String((d.exception && (d.exception.description || d.exception.value)) || d.text || "error").slice(0, 2000), line: d.lineNumber, column: d.columnNumber } });
    const sized = (value) => {
