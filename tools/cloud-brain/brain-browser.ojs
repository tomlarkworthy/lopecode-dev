test_browser_each_call_is_a_new_connection_to_the_same_tab = {
  const rig = await browserRig();
  await rig.open("a");
  const before = rig.fake.stats.connects;
  await rig.owner.post("eval", { name: "a", expression: "(window.kept = 41, true)" });
  expect((await rig.owner.post("eval", { name: "a", expression: "window.kept + 1" })).data.value).toBe(42);
  expect(rig.fake.stats.connects - before).toBe(2);
  expect([...rig.fake.sessions.values()][0].sockets.size).toBe(0);
  // Two calls at once, each with its own connection, one of them waiting on a promise.
  const both = await Promise.all([rig.owner.post("eval", { name: "a", expression: "new Promise((yes) => setTimeout(() => yes(window.kept), 400))" }), rig.owner.get("text", { name: "a" })]);
  expect(both.map((r) => [r.status, r.data.value])).toEqual([[200, 41], [200, undefined]]);
  return "2 calls, 2 connections, state kept in the tab";
}
// %%
test_browser_run_closes_its_tab = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha" }, "https://down.example/": { fail: "net::ERR_FAILED" } } });
  const left = () => [rig.keys("page/"), rig.fake.sessions.size ? rig.fake.targets(rig.session()).length : 0];
  const ok = (await rig.owner.post("run", { url: "https://a.example/", expression: "document.title", text: true, screenshot: true, logs: true, wait: "document.readyState == 'complete'" })).data;
  expect(ok).toMatchObject({ url: "https://a.example/", loaded: true, cold: true, value: "A", type: "string", text: "alpha", truncated: false, logs: [] });
  expect(atob(ok.screenshot).slice(1, 4)).toBe("PNG");
  expect(left()).toEqual([[], 0]);
  // An error of the page is a result. A refusal and a failed load are errors. The tab is closed each time.
  expect((await rig.owner.post("run", { url: "https://a.example/", expression: "nothing.here" })).data.thrown.message).toMatch(/ReferenceError/);
  expect((await rig.owner.post("run", { url: "https://down.example/" })).data.error).toBe("NavigationFailed");
  expect([left(), rig.fake.stats.acquired]).toEqual([[[], 0], 1]);
  // Five runs at once with no browser up start one browser.
  await rig.owner.post("close", { all: true });
  const burst = await Promise.all([1, 2, 3, 4, 5].map(() => rig.owner.post("run", { url: "https://a.example/", expression: "document.title" })));
  expect(burst.map((r) => r.data.value)).toEqual(["A", "A", "A", "A", "A"]);
  expect([rig.fake.stats.acquired, rig.fake.sessions.size, burst.filter((r) => r.data.cold).length]).toEqual([2, 1, 1]);
  expect([left(), rig.keys("starting/")]).toEqual([[[], 0], []]);
  // The browser stays for the time that was bought, then the tick closes it.
  await rig.tick();
  expect(rig.fake.sessions.size).toBe(1);
  rig.setPaid(-1);
  await rig.tick();
  expect([rig.fake.sessions.size, rig.keys("browser/")]).toEqual([0, []]);
  return "3 single runs and a burst of 5 on one browser; nothing left open";
}
// %%
test_browser_run_stops_at_its_timeout = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha" }, "https://never.example/": { title: "N", text: "", never: true } } });
  const t0 = Date.now();
  const [waited, hung, never] = await Promise.all([
    rig.owner.post("run", { url: "https://a.example/", wait: "window.never", timeout: 5000 }),
    rig.owner.post("run", { url: "https://a.example/", expression: "new Promise(() => {})", timeout: 5000 }),
    // A page whose load event does not come: the run goes on at half of its time with loaded false.
    rig.owner.post("run", { url: "https://never.example/", expression: "document.title", timeout: 5000 })
  ]);
  expect([waited.status, waited.data.message]).toEqual([504, "wait was not true in 5000 ms"]);
  expect([hung.status, hung.data.error]).toEqual([504, "Timeout"]);
  expect(never.data).toMatchObject({ loaded: false, value: "N" });
  expect(Date.now() - t0 < 7000).toBe(true);
  expect([rig.keys("page/"), rig.fake.targets(rig.session()).length]).toEqual([[], 0]);
  return "a wait, a promise and a load that do not end: 5 s each, no tab left";
}
// %%
test_browser_tick_makes_rows_and_sessions_agree = {
  const rig = await browserRig();
  // The session of a different Worker of the account is in the list. It is not this service's, and it stays.
  const theirs = rig.fake.session(Date.now() - 600000);
  await rig.open("a");
  expect(await rig.tick()).toBeUndefined();
  expect([rig.fake.sessions.has(theirs), rig.fake.stats.commands.filter((c) => c === "Target.getTargets").length]).toEqual([true, 1]);
  // A start that died after Browser Run made the browser: a lock row and a session with no row. The tick removes the lock.
  // The session has no row, so it is left for Browser Run's idle limit, like the session of another Worker.
  const orphan = rig.fake.session(Date.now() - 40000);
  rig.rows.set("starting/shared", { at: Date.now() - 41000 });
  await rig.tick();
  expect([rig.fake.sessions.has(orphan), rig.fake.sessions.has(theirs), rig.keys("starting/")]).toEqual([true, true, []]);
  rig.fake.kill(orphan);
  // The rows that the service had before 2026-10-08 are removed.
  for (const k of ["bought/2026-10-08", "ledger/x", "paid/s1"]) rig.rows.set(k, 1);
  await rig.tick();
  expect([rig.keys("bought/"), rig.keys("ledger/"), rig.keys("paid/"), rig.paid() > 500]).toEqual([[], [], [], true]);
  // A second browser, as two starts that crossed leave. No new page goes to it, and the tick closes it when it has no page.
  const browserRow = (sid) => rig.rows.set("browser/" + sid, { sessionId: sid, opened: Date.now(), counted: Date.now(), by: "owner" });
  const second = rig.fake.session();
  browserRow(second);
  await rig.open("b");
  expect((await rig.owner.get("status")).data.browsers.map((b) => b.pages)).toEqual([["a", "b"], []]);
  await rig.tick();
  expect([rig.fake.sessions.has(second), rig.keys("browser/").length]).toEqual([false, 1]);
  // A call that finds a start in progress waits for the browser row and does not start a second browser.
  await rig.owner.post("close", { all: true });
  rig.rows.set("starting/shared", { at: Date.now() });
  const before = rig.fake.stats.acquired;
  setTimeout(() => browserRow(rig.fake.session()), 300);
  expect(await rig.open("c")).toMatchObject({ cold: false, loaded: true });
  expect(rig.fake.stats.acquired).toBe(before);
  rig.rows.delete("starting/shared");
  // The browser ends by itself (a crash, Browser Run's timer). The next call says so and does not wait.
  await rig.open("d");
  rig.fake.kill(rig.session());
  const call = await rig.owner.post("eval", { name: "c", expression: "1" });
  expect([call.status, call.data]).toEqual([410, { error: "PageClosed", message: "page c is closed: browser ended" }]);
  expect((await rig.owner.get("status", { name: "d" })).data).toMatchObject({ open: false, closed: "browser ended" });
  expect([rig.keys("browser/"), rig.keys("page/")]).toEqual([[], []]);
  // The same when the tick is first to see it. A new open starts a new browser.
  expect((await rig.open("e")).cold).toBe(true);
  rig.fake.kill(rig.session());
  await rig.tick();
  expect((await rig.owner.get("status", { name: "e" })).data.closed).toBe("browser ended");
  // The browser ends during a call.
  await rig.open("f");
  const during = rig.owner.post("eval", { name: "f", expression: "new Promise(() => {})" });
  await new Promise((r) => setTimeout(r, 150));
  rig.fake.kill(rig.session());
  expect((await during).data.message).toBe("page f is closed: browser ended");
  // One tab is gone and the browser is up.
  await rig.open("g");
  await rig.open("h");
  rig.fake.sessions.get(rig.session()).targets.delete(rig.rows.get("page/g").targetId);
  expect((await rig.owner.post("eval", { name: "g", expression: "1" })).data.message).toBe("page g is closed: page ended");
  expect((await rig.owner.post("eval", { name: "h", expression: "1 + 1" })).data.value).toBe(2);
  // Browser time that was used is counted once for the browser, and not for each tab.
  rig.rows.set(rig.keys("browser/")[0], { ...rig.rows.get(rig.keys("browser/")[0]), counted: Date.now() - 100000 });
  const used = (await rig.owner.get("status")).data.usage.usedSeconds;
  expect(used >= 100 && used <= 110 ? "about 100" : used).toBe("about 100");
  await rig.tick();
  const after = (await rig.owner.get("status")).data.usage.usedSeconds;
  expect(after - used >= 0 && after - used <= 1 ? "the same" : [used, after]).toBe("the same");
  return "another Worker's session kept; a dead start, a second browser, a dead browser and a dead tab handled";
}
