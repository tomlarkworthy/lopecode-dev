  const shot = async (cdp, sid, { fullPage, selector } = {}) => {
    let clip;
    if (selector) {
      const r = await evaluate(cdp, sid, `(() => { const e = document.querySelector(${JSON.stringify(String(selector))}); if (!e) return null; const b = e.getBoundingClientRect(); return { x: b.x + window.scrollX, y: b.y + window.scrollY, width: b.width, height: b.height, scale: 1 }; })()`);
