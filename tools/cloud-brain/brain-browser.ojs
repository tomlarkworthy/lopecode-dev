test_browser_that_stops_answering_is_closed = {
  const rig = await browserRig();
  await rig.open("a");
  rig.fake.wedge(rig.session());
  // The tick waits 10 s for its command, then closes the browser. The page says why. A call waits 10 s the same way and answers Timeout.
  await rig.tick();
  expect([rig.fake.sessions.size, rig.keys("browser/"), (await rig.owner.get("status", { name: "a" })).data.closed]).toEqual([0, [], "browser stopped answering"]);
  return "closed by the tick after 10 s";
}
// %%
test_browser_refuses_urls_and_too_many_pages = {
  const refused = ["file:///etc/passwd", "javascript:alert(1)", "chrome://version", "about:blank", "data:text/html,x", "http://localhost:8080/", "http://x.localhost/", "https://db.internal/", "https://printer.local/", "http://127.0.0.1/", "http://10.1.2.3/", "http://172.16.0.1/", "http://192.168.1.1/", "http://169.254.169.254/latest/meta-data", "http://[::1]/", "http://[fd00::1]/", "http://[fe80::1]/", "http://0.0.0.0/", "not a url"];
  for (const u of refused) expect([u, browserRefusal(u) !== null]).toEqual([u, true]);
  for (const u of ["https://example.com/", "http://example.com:8080/x", "https://cb4.endpointservices.workers.dev/", "https://172.32.0.1/", "https://internal.example.com/"]) expect([u, browserRefusal(u)]).toEqual([u, null]);
  const rig = await browserRig();
  for (const m of ["open", "goto", "run"]) {
    const r = await rig.owner.post(m, { name: "a", url: "http://169.254.169.254/" });
    expect([m, r.status, r.data.error]).toEqual([m, 400, "UrlRefused"]);
  }
  expect(rig.fake.stats.acquired).toBe(0);
  expect((await rig.owner.post("open", { name: "bad name", url: "https://a.example/" })).status).toBe(400);
  // The limit of pages, and the setting that moves it.
  await rig.owner.post("settings", { maxTabs: 2 });
  await rig.open("a");
  await rig.open("b");
  const third = await rig.owner.post("open", { name: "c", url: "https://a.example/" });
  expect([third.status, third.data.error, third.data.message]).toEqual([429, "TooManyPages", "2 pages are open. That is the limit. The setting is maxTabs."]);
  expect((await rig.owner.post("run", { url: "https://a.example/" })).data.error).toBe("TooManyPages");
  return refused.length + " addresses refused; 2 pages at most";
}
// %%
test_browser_each_caller_has_its_own_browsers = {
  const rig = await browserRig({ paid: 0 }), A = "https://a.example/";
  const reader = rig.as("worker:brain-x-reader", "owner"), R = "worker:brain-x-reader/default";
  // Bought time runs down by the clock while the test runs: what is left is the amount less the seconds the test
  // has taken so far, as in test_browser_time_is_bought_by_extend_alone.
  const began = Date.now(), near = (got, want) => (got <= want + 1 && got >= want - 2 - (Date.now() - began) / 1000 ? want : got);
  // Two callers, the same browser name: two browsers, each with its own time and its own pages.
  expect([(await rig.owner.post("extend", {}, { seconds: 100 })).data.cold, (await reader.post("extend", {}, { seconds: 50 })).data.cold]).toEqual([true, true]);
  expect([rig.fake.sessions.size, near(rig.paid(), 100), near(rig.paid(R), 50), rig.session() !== rig.session(R)]).toEqual([2, 100, 50, true]);
  await rig.open("a");
  expect((await reader.post("open", { name: "a", url: A })).data).toMatchObject({ existing: false, by: "worker:brain-x-reader", origin: "owner" });
  expect([(await rig.owner.get("list")).data.pages.length, (await reader.get("list")).data.pages.map((p) => p.by)]).toEqual([1, ["worker:brain-x-reader"]]);
  // No parameter names an owner. The caller is the owner, as the core named it.
  await rig.open("only-owner");
  expect([(await reader.get("status", { name: "only-owner", owner: "owner" })).status, (await reader.post("close", { name: "only-owner", owner: "owner" }, { owner: "owner" })).status, (await reader.get("list", { owner: "owner" })).data.pages.map((p) => p.name)]).toEqual([404, 404, ["a"]]);
  // One caller, two names: two browsers. A tab name is for one browser. Time bought for one is not time for the other.
  const inB = { browser: "b" }, OB = "owner/b";
  expect((await rig.owner.post("open", { name: "a", url: A, ...inB })).data).toMatchObject({ error: "NoTime", message: "no browser time is bought for browser b. browser.extend?seconds=N buys N seconds." });
  expect((await rig.owner.post("extend", {}, { seconds: 30, ...inB })).data).toMatchObject({ added: 30, cold: true });
  expect((await rig.owner.post("open", { name: "a", url: A, ...inB })).data.existing).toBe(false);
  expect([rig.fake.sessions.size, near(rig.paid(), 100), near(rig.paid(OB), 30), rig.keys("page/", OB)]).toEqual([3, 100, 30, ["page/a"]]);
  const mine = (await rig.owner.get("status")).data;
  expect(Object.keys(mine.mine[0]).sort()).toEqual(["browser", "owner", "pages", "paidUntil", "remaining", "up"]);
  expect([mine.owner, mine.browser, mine.mine.map((b) => [b.browser, b.up, b.pages.length]).sort()]).toEqual(["owner", "default", [["b", true, 1], ["default", true, 2]]]);
  // Purchases made at one time for two browsers: each browser gets its own.
  const burst = await Promise.all([0, 1, 2, 3, 4, 5, 6, 7].map((i) => rig.owner.post("extend", {}, { seconds: 50, ...(i % 2 ? inB : {}) })));
  expect([burst.every((r) => r.status === 200), near(rig.paid(), 300), near(rig.paid(OB), 230)]).toEqual([true, 300, 230]);
  // The owner's session sees each browser of each owner.
  expect((await rig.owner.get("all")).data.browsers.map((b) => [b.owner, b.browser, b.up, b.pages]).sort()).toEqual([["owner", "b", true, ["a"]], ["owner", "default", true, ["a", "only-owner"]], ["worker:brain-x-reader", "default", true, ["a"]]]);
  // One browser's time runs out: it closes, by a call or by the tick. The others stay.
  rig.setPaid(-1, OB);
  expect([(await rig.owner.post("eval", { name: "a", expression: "1", ...inB })).data.error, (await rig.owner.post("eval", { name: "a", expression: "1 + 1" })).data.value, rig.fake.sessions.size]).toEqual(["NoTime", 2, 2]);
  // The tick of one browser fails (its row is broken here). The tick still closes the browser after it.
  const sid = rig.session(), row = rig.rows.get("browser/" + sid), failed = [], error = console.error;
  rig.rows.set("browser/" + sid, null);
  rig.setPaid(-1, R);
  console.error = (...a) => failed.push(a[1]);
  await rig.tick().finally(() => (console.error = error));
  rig.rows.set("browser/" + sid, row);
  expect(failed).toEqual(["owner/default"]);
  expect([rig.fake.sessions.size, rig.keys("browser/", R), rig.keys("browser/").length, (await reader.get("status", { name: "a" })).data.closed]).toEqual([1, [], 1, "time ran out"]);
  // The limits count browsers that are up: for one owner, and for all. The seconds of an extend that starts no browser stay bought.
  await rig.owner.post("settings", { maxPerOwner: 2 });
  await rig.owner.post("extend", {}, { seconds: 20, browser: "b" });
  const third = await rig.owner.post("extend", {}, { seconds: 20, browser: "c" });
  expect([third.status, third.data, near(rig.paid("owner/c"), 20), rig.fake.sessions.size]).toEqual([429, { error: "TooManyBrowsers", message: "owner has 2 browsers up. That is the limit. The setting is maxPerOwner." }, 20, 2]);
  await rig.owner.post("settings", { maxBrowsers: 2 });
  expect((await reader.post("extend", {}, { seconds: 20 })).data.message).toBe("2 browsers are up. That is the limit. The setting is maxBrowsers.");
  // end closes the browser of any owner. Its rule lets the owner's own session through and no other caller (see the first test).
  expect((await rig.owner.post("end", { owner: "owner", browser: "b" })).data).toEqual({ closed: [], browser: "b" });
  expect([rig.fake.sessions.size, (await reader.post("extend", {}, { seconds: 10 })).status, rig.fake.sessions.size]).toEqual([1, 200, 2]);
  expect((await rig.owner.post("extend", {}, { seconds: 20, browser: "bad name" })).data).toEqual({ error: "InvalidRequest", message: "browser: 1 to 40 letters, digits, - and _" });
  // A call with no caller has no owner, so it gets no browser, whatever rule let it in.
  const nobody = await rig.as("anonymous").post("extend", {}, { seconds: 10 });
  expect([nobody.status, nobody.data.error, rig.keys("", "anonymous/default")]).toEqual([401, "AuthRequired", []]);
  return "3 browsers of 2 owners: own time, own pages, own end";
}
// %%
test_browser_a_turn_does_not_reach_the_browsers_of_its_callers_own_session = {
  const A = "https://a.example/", V = "via:owner/default", X = "https://brain.internal/xrpc/com.lopecode.brain.browser.cdp";
  const rig = await browserRig({ sites: { [A]: { title: "A", text: "alpha" } } });
  const session = rig.as("owner", "owner", "session"), turn = rig.as("owner", "did:plc:ada", "turn:7");
  const kept = 'localStorage.getItem("brain_session")';
  // The owner's own tab keeps the rows it had, b/owner/default/. Its page holds a session, as brain.ts page up leaves one.
  await session.post("open", { name: "brain", url: A });
  await session.post("eval", { name: "brain", expression: 'localStorage.setItem("brain_session", "secret")' });
  expect([rig.keys("page/"), (await session.post("eval", { name: "brain", expression: kept })).data.value]).toEqual([["page/brain"], "secret"]);
  // A turn of the owner, a call through a PDS, a portal and a call under a delegation have the caller owner, and a
  // different owner of browsers.
  for (const via of ["turn:7", "jwt", "portal:p1", "delegation:0a1b"]) {
    const other = rig.as("owner", "owner", via);
    const got = [(await other.get("list")).data, (await other.get("status", { name: "brain" })).status, (await other.post("eval", { name: "brain", expression: kept })).data.error, (await other.get("text", { name: "brain" })).data.error, (await other.post("close", { name: "brain" })).status, (await other.post("close", { all: true })).data];
    expect([via, ...got]).toEqual([via, { pages: [] }, 404, "NoTime", "NoTime", 404, { closed: [], browser: "default" }]);
  }
  // With time of its own the turn has a browser of its own. The page of the session is not in it.
  expect((await turn.post("extend", {}, { seconds: 60 })).data).toMatchObject({ browser: "default", added: 60, cold: true });
  expect([rig.fake.sessions.size, rig.keys("browser/", V).length, rig.session() !== rig.session(V)]).toEqual([2, 1, true]);
  for (const [m, body] of [["eval", { expression: kept }], ["goto", { url: A }], ["close", {}]]) expect([m, (await turn.post(m, { name: "brain", ...body })).status]).toEqual([m, 404]);
  // The same page name in the turn's browser is a different tab with its own storage.
  expect((await turn.post("open", { name: "brain", url: A })).data).toMatchObject({ existing: false, by: "owner", origin: "did:plc:ada" });
  expect((await turn.post("eval", { name: "brain", expression: kept })).data).toEqual({ value: null, type: "null" });
  const mine = (await turn.get("status")).data;
  expect([mine.owner, mine.mine.map((b) => [b.owner, b.browser, b.pages])]).toEqual(["via:owner", [["via:owner", "default", ["brain"]]]]);
  // Each turn of the caller has those browsers. The socket of a turn is on them too.
  expect((await rig.as("owner", "owner", "turn:8").get("list")).data.pages.map((p) => p.name)).toEqual(["brain"]);
  const socket = await rig.sim.fetch(X, { headers: { "x-brain-caller": "owner", "x-brain-origin": "owner", "x-brain-via": "turn:7", upgrade: "websocket" } });
  expect([(await socket.json()).status, rig.fake.sessions.get(rig.session(V)).sockets.size, rig.fake.sessions.get(rig.session()).sockets.size]).toEqual([101, 1, 0]);
  expect((await session.post("eval", { name: "brain", expression: kept })).data.value).toBe("secret");
  // A token, a Worker that calls as its author, and a call with no via keep the caller's own name.
  for (const [who, via] of [["token:laptop", "token"], ["did:plc:ada", "worker:brain-m-1-x"], ["did:plc:bob", undefined]]) expect([who, (await rig.as(who, who, via).get("status")).data.owner]).toEqual([who, who]);
  // A call with no caller has no browser, however it arrived.
  expect([(await rig.as("anonymous", "anonymous", "turn:1").post("extend", {}, { seconds: 10 })).status, rig.keys("", "via:anonymous/default")]).toEqual([401, []]);
  // The limit of browsers for one owner counts the two apart.
  await session.post("settings", { maxPerOwner: 1 });
  expect([(await session.post("extend", {}, { seconds: 20, browser: "b" })).data.message, (await turn.post("extend", {}, { seconds: 20, browser: "b" })).data.message]).toEqual(["owner has 1 browsers up. That is the limit. The setting is maxPerOwner.", "via:owner has 1 browsers up. That is the limit. The setting is maxPerOwner."]);
  // The owner's session sees the turn's browser and ends it. The tick closes one whose time ran out.
  expect((await session.get("all")).data.browsers.filter((b) => b.up).map((b) => [b.owner, b.browser, b.pages]).sort()).toEqual([["owner", "default", ["brain"]], ["via:owner", "default", ["brain"]]]);
  expect((await session.post("end", { owner: "via:owner", browser: "default" })).data).toEqual({ closed: ["brain"], browser: "default" });
  expect([rig.fake.sessions.size, rig.keys("browser/", V)]).toEqual([1, []]);
  expect((await turn.post("open", { name: "again", url: A })).data).toMatchObject({ cold: true });
  rig.setPaid(-1, V);
  await rig.tick();
  expect([rig.fake.sessions.size, rig.keys("browser/", V), rig.keys("browser/").length, (await turn.get("status", { name: "again" })).data.closed]).toEqual([1, [], 1, "time ran out"]);
  // The browser of a call under a delegation is kept under the delegation.
  const heldAs = rig.as("owner", "owner", "delegation:0a1b");
  await heldAs.post("extend", {}, { seconds: 60 });
  expect([rig.keys("browser/", "d:0a1b/default").length, (await heldAs.get("status")).data.owner]).toEqual([1, "d:0a1b"]);
  return "turn, jwt and portal: browsers of via:owner; the session's page was not reached";
}
// %%
test_browser_cdp_is_the_socket_of_the_callers_own_browser = {
  const rig = await browserRig({ paid: 0 }), X = "https://brain.internal/xrpc/com.lopecode.brain.browser.cdp";
  const ask = async (who, upgrade = true) => {
    const r = await rig.sim.fetch(X, { headers: { "x-brain-caller": who, "x-brain-origin": who, ...(upgrade ? { upgrade: "websocket" } : {}) } });
    return { status: r.status, data: await r.json() };
  };
  // A GET that is not an upgrade starts nothing. With no time, the call is refused before a socket is asked for.
  expect([(await ask("owner", false)).status, (await ask("owner")).data.error, rig.fake.stats.acquired, rig.fake.stats.connects]).toEqual([426, "NoTime", 0, 0]);
  rig.setPaid(60);
  rig.setPaid(60, "worker:brain-x-reader/default");
  // With time the browser starts, and what Browser Run answers is the answer. The fake cannot make a Response with
  // status 101 in a tab, so here the answer comes as JSON.
  const mine = await ask("owner"), theirs = await ask("worker:brain-x-reader");
  expect([mine.data.status, theirs.data.status, rig.fake.sessions.size]).toEqual([101, 101, 2]);
  // Each caller's socket is on its own browser.
  const sockets = (scope) => rig.fake.sessions.get(rig.session(scope)).sockets.size;
  expect([sockets("owner/default"), sockets("worker:brain-x-reader/default")]).toEqual([1, 1]);
  // The browser dies and its row is still here: the next call starts a new browser and answers with its socket.
  const dead = rig.session("owner/default");
  rig.fake.kill(dead);
  const again = await ask("owner"), now = rig.session("owner/default");
  expect([again.data.status, now !== dead, sockets("owner/default")]).toEqual([101, true, 1]);
  expect((await ask("anonymous")).status).toBe(401);
  return "426 with no upgrade, 409 with no time, one socket on each caller's own browser";
}
// %%
test_browser_panel_shows_pages_and_the_usage = {
  const calls = [];
  const status = { browser: "default", browsers: [{ session: "s1" }], remaining: 42, pages: [{ name: "docs", url: "https://example.com/", age: 12, idle: 3, by: "owner" }], usage: { usedSeconds: 61, monthUsedSeconds: 600, includedSeconds: 36000 }, settings: { maxTabs: 8, maxBrowsers: 10, maxPerOwner: 3 } };
  const fleet = { browsers: [{ owner: "owner", browser: "default", up: true, remaining: 42, pages: ["docs"] }, { owner: "worker:brain-x-reader", browser: "default", up: true, remaining: 9, pages: [] }] };
  const client = { query: async (name, params) => (calls.push([name, params]), name === "browser.all" ? fleet : { ...status, browser: params.browser }), procedure: async (name, input, opts) => (calls.push([name, input, opts]), { existing: false, ms: 5, added: 60, costUsd: 0.0015 }) };
  const el = browserPanel({ client, owner: true });
  await new Promise((r) => setTimeout(r, 0));
  expect([...el.querySelectorAll("button")].map((b) => b.textContent)).toEqual(["Refresh", "Close", "Close browser", "Screenshot", "Add time", "Open", "Run once", "End chosen browser", "Save limits"]);
  expect(el.textContent).toContain("42 s of browser time are bought for default. The browser is up.");
  // The price is on the page before the button is pressed.
  expect(el.textContent).toContain("60 s costs $0.0015, charged to your day. It is not given back.");
  expect(el.textContent).toContain("61 browser-seconds used today (UTC) by all browsers, 600 this month. Charges are in Spending.");
  // The seconds go in the query string.
  [...el.querySelectorAll("button")].find((b) => b.textContent === "Add time").click();
  await new Promise((r) => setTimeout(r, 0));
  expect(calls.find((c) => c[0] === "browser.extend")).toEqual(["browser.extend", {}, { params: { seconds: "60", browser: "default" } }]);
  // Each call names the browser. The table of all browsers has each owner's.
  expect(calls[0]).toEqual(["browser.status", { browser: "default" }]);
  expect(el.textContent).toContain("worker:brain-x-reader");
  expect(el.textContent).toContain("60 s added, $0.0015");
  // A name that is typed is drawn, and the buttons act on the browser that is shown.
  const which = el.querySelector("input[type=text]"), closeAll = () => ([...el.querySelectorAll("button")].find((b) => b.textContent === "Close browser").click(), new Promise((r) => setTimeout(r, 0)));
  which.value = "b";
  which.dispatchEvent(new Event("input", { bubbles: true }));
  await new Promise((r) => setTimeout(r, 0));
  expect(el.textContent).toContain("bought for b.");
  await closeAll();
  expect(calls.filter((c) => c[0] === "browser.close").pop()).toEqual(["browser.close", { all: true, browser: "b" }, undefined]);
  expect(browserPanel({ client, owner: false }).textContent).toMatch(/Sign in to a Brain as the owner/);
  return "1 page, 2 browsers, 9 buttons";
}
