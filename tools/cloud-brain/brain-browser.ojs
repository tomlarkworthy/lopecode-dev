      }
    } catch (e) {
      if (e.gone || e.status) throw e;
      return { thrown: { message: String(e.message || e) } };
    }
  };
  const readText = async (cdp, sid, selector) => {
    const r = await evaluate(cdp, sid, `(() => { const e = ${selector ? `document.querySelector(${JSON.stringify(String(selector))})` : "document.body"}; return e ? { text: String(e.innerText || "").slice(0, ${L.textChars + 1}) } : { missing: true }; })()`);
    if (r.thrown) throw stop(400, "InvalidRequest", r.thrown.message);
    if (r.value.missing) throw stop(404, "NotFound", `no element matches ${selector}`);
    return { text: r.value.text.slice(0, L.textChars), truncated: r.value.text.length > L.textChars };
  };
