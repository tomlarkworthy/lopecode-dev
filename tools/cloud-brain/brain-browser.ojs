        const v = await cdp.send("Runtime.callFunctionOn", { objectId: o.objectId, functionDeclaration: "function () { return this; }", returnByValue: true }, sid);
        return v.exceptionDetails ? thrown(v.exceptionDetails) : sized(v.result.value);
