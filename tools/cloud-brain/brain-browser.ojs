        const loaded = await navigate(m.cdp, m.sid, url, L.loadTimeout);
        return { ...view(m.page), loaded, cold: m.cold, ms: Date.now() - t0, existing: false };
      } catch (e) {
        await shut(m.page, "not opened", m.cdp).catch(() => null);
        if (e && e.gone) throw stop(503, "BrowserUnavailable", "the browser closed the connection as the page loaded. Try again.");
        throw e;
      } finally {
        m.cdp.close();
      }
    },
    // The one method that buys time, and the one with a price. It adds the seconds, then starts the browser when it is down.
    // The seconds stay bought when the start fails: the next call that needs the browser starts it.
    extend: async (q) => {
      const n = browserSeconds(q.seconds);
      if (n === null) throw stop(400, "InvalidRequest", `seconds: a whole number from ${L.minSeconds} to ${L.maxSeconds}, given one time in the query string`);
      const u = await expire(Date.now());
      await rows.append("paid", { t: Date.now(), n, u }, 1000);
      const paid = await paidUntil(), { cold } = await theBrowser();
      return { browser: label, paidUntil: paid, added: n, costUsd: Number((n * L.dollarsPerSecond).toFixed(6)), cold };
    },
    list: async () => (await expire(Date.now()), { pages: (await pages()).filter((p) => !p.pending).map((p) => view(p)) }),
    status: async (page) => {
      const at = Date.now();
      await expire(at);
      if (page) {
        const p = await rows.get("page/" + page);
        if (p && !p.pending) return { ...view(p, at), paidUntil: await paidUntil() };
        const t = await rows.get("ended/" + page);
        if (!t) throw stop(404, "NotFound", `no page ${page}`);
        return { name: page, open: false, closed: t.closed, at: t.at };
      }
      const ps = (await pages()).filter((p) => !p.pending), paid = await paidUntil();
      const up = (await browsers()).map((b) => ({ session: b.sessionId, opened: b.opened, age: Math.round((at - b.opened) / 1000), pages: ps.filter((p) => p.sessionId === b.sessionId).map((p) => p.name) }));
      // returned: false says that time which is bought is not given back, used or not. mine: each browser of this owner.
      return { owner, browser: name, browsers: up, paidUntil: paid, remaining: Math.max(0, Math.round((paid - at) / 1000)), returned: false, pages: ps.map((p) => view(p, at)), mine: (await summary(at)).filter((b) => b.owner === owner).map(({ counted, ...b }) => b), usage: await usage(at), settings: await settings(), limits: L };
    },
    // Closing a page keeps the browser. close { all: true } ends it; the time stays bought, and the next open inside it starts a browser.
    close: async (q) => {
      const closed = [];
      if (q.all === true) {
        for (const b of await browsers()) closed.push(...(await end(b.sessionId, "closed", Date.now())));
        for (const p of await pages()) (await rows.delete("page/" + p.name), closed.push(p.name));
        return { closed, browser: name };
      }
      const p = await rows.get("page/" + named(q.name));
      if (!p || p.pending) throw await missing(q.name);
      await shut(p, "closed");
      return { closed: [p.name] };
    },
    goto: async (q) => {
      const url = allowed(q.url);
      return withPage(named(q.name), async ({ cdp, sid, page }) => {
        const t0 = Date.now();
        await cdp.send("Page.enable", {}, sid);
        await cdp.send("Page.addScriptToEvaluateOnNewDocument", { source: hook }, sid);
        const loaded = await navigate(cdp, sid, url, L.loadTimeout);
        await rows.put("page/" + page.name, { ...page, url });
        return { name: page.name, url, loaded, ms: Date.now() - t0 };
      });
    },
    eval: async (q) => {
      if (typeof q.expression !== "string" || !q.expression) throw stop(400, "InvalidRequest", "expression");
      const timeout = Math.min(Math.max(Number(q.timeout) || L.evalTimeout, 100), L.maxTimeout);
      return withPage(named(q.name), ({ cdp, sid }) => evaluate(cdp, sid, q.expression, { awaitPromise: q.awaitPromise, timeout }));
    },
    text: async (q) => withPage(named(q.name), ({ cdp, sid }) => readText(cdp, sid, q.selector)),
    screenshot: async (q) => withPage(named(q.name), ({ cdp, sid }) => shot(cdp, sid, q)),
    logs: async (q) => withPage(named(q.name), async ({ cdp, sid }) => ({ logs: await readLogs(cdp, sid) })),
    liveView: async (q) => {
      await timed();
      const p = await rows.get("page/" + named(q.name));
      if (!p || p.pending) throw await missing(q.name);
      const r = await http(`/v1/devtools/browser/${p.sessionId}/json/list`);
      const t = Array.isArray(r.body) ? r.body.find((x) => x.id === p.targetId) : null;
      if (!t || !t.devtoolsFrontendUrl) throw stop(502, "BrowserUnavailable", "Browser Run gave no Live View link for the page");
      return { name: p.name, url: t.devtoolsFrontendUrl };
    },
    // The browser's own CDP socket, for the caller that owns the browser. Browser Run's answer to the upgrade is passed
    // on as it is: this service relays no frame and holds no connection. The socket closes when the browser ends.
    cdp: async () => {
      await timed();
      // A browser that died while its row is still here: its rows go and one new browser is started, as open does.
      for (let attempt = 0; ; attempt++) {
        const { browser: b } = await theBrowser();
        const r = await browser.fetch("/v1/devtools/browser/" + b.sessionId, { headers: { Upgrade: "websocket" } }).catch(() => null);
        if (r && r.webSocket) return r;
        if (attempt || (await alive(b.sessionId))) throw stop(502, "BrowserUnavailable", "Browser Run gave no socket for the browser: " + (r ? r.status : "no answer"));
        await end(b.sessionId, "browser ended", Date.now(), false);
      }
    },
    // One page for one job: open, wait for load, read, close. It needs bought time for the whole of its timeout.
    // The tab closes when the job throws or runs out of time.
    run: async (q, by, origin) => {
      const url = allowed(q.url), timeout = Math.min(Math.max(Number(q.timeout) || L.runTimeout, 5000), L.maxTimeout), t0 = Date.now();
      const left = () => Math.max(1, t0 + timeout - Date.now());
      const name = "run-" + Math.random().toString(36).slice(2, 10);
      const m = await make({ name, url }, by, origin, timeout);
      try {
        // The load event gets half of the time at most, so that a page that never fires it can still be read.
        const out = { url, loaded: await navigate(m.cdp, m.sid, url, Math.min(L.loadTimeout, timeout / 2)), cold: m.cold };
        if (q.wait) {
          for (;;) {
            const r = await evaluate(m.cdp, m.sid, q.wait, { timeout: left() }).catch((e) => (e.error === "Timeout" ? null : Promise.reject(e)));
            if (r && r.value) break;
            if (left() <= 250) throw stop(504, "Timeout", `wait was not true in ${timeout} ms`);
            await sleep(250);
          }
        }
        if (q.expression) Object.assign(out, await evaluate(m.cdp, m.sid, q.expression, { timeout: left() }));
        if (q.text) Object.assign(out, await readText(m.cdp, m.sid, q.text === true ? null : q.text));
        if (q.screenshot) out.screenshot = await shot(m.cdp, m.sid, q.screenshot === true ? {} : q.screenshot);
        if (q.logs) out.logs = await readLogs(m.cdp, m.sid);
        return { ...out, ms: Date.now() - t0 };
      } catch (e) {
        if (e && e.gone) throw stop(502, "BrowserUnavailable", "the browser closed during the run");
        throw e;
      } finally {
        await shut(m.page, "run ended", m.cdp).catch(() => null);
        m.cdp.close();
      }
    },
    // The part of the tick for one browser. ids: the sessions Browser Run lists, or null when it did not answer.
    tick: async (at, ids, out) => {
      for (const r of await rows.list("starting/")) if (at - r.value.at >= L.startGrace * 1000) await rows.delete(r.key);
      const ups = await browsers(), first = ups[0], paid = await paidUntil();
      for (const b of ups) {
        const mine = (await pages()).filter((p) => p.sessionId === b.sessionId);
        const reason = ids && !ids.has(b.sessionId) ? "browser ended" : paid <= at ? "time ran out" : null;
        if (reason) {
          await end(b.sessionId, reason, at, reason !== "browser ended");
          out.ended.push(b.sessionId);
          out.closed.push(...mine.map((p) => p.name));
          continue;
        }
        const cdp = await connect(b.sessionId);
        if (!cdp) {
          if (!(await alive(b.sessionId))) (await end(b.sessionId, "browser ended", at, false), out.ended.push(b.sessionId), out.closed.push(...mine.map((p) => p.name)));
          continue;
        }
        try {
          // The command that keeps the browser up. It also shows which tabs are gone.
          const targets = new Set((await cdp.send("Target.getTargets")).targetInfos.map((t) => t.targetId));
          let open = 0;
          for (const p of mine) {
            if (targets.has(p.targetId)) open++;
            else (await rows.delete("page/" + p.name), await tomb(p.name, "page ended", at), out.closed.push(p.name));
          }
          // With no page, a second browser made when two starts crossed closes now. The first stays for the time that was bought.
          if (!open && b !== first && (await rows.get("browser/" + b.sessionId))) (await end(b.sessionId, "not needed", at), out.ended.push(b.sessionId));
          const now = await rows.get("browser/" + b.sessionId);
          if (now) (await rows.put("browser/" + b.sessionId, await meter(now, at)), out.kept++);
        } catch (e) {
          // A browser that takes a connection and answers no command for 10 s is closed. (2026-10-08: three tabs of a large notebook did this.)
          if (e && e.error === "Timeout") (await end(b.sessionId, "browser stopped answering", Date.now()), out.ended.push(b.sessionId), out.closed.push(...mine.map((p) => p.name)));
          else if (!(e && e.gone)) throw e;
        } finally {
          cdp.close();
        }
      }
      // Rows with nothing behind them: a page whose browser has no row, a reservation that was not finished.
      const have = new Set((await browsers()).map((b) => b.sessionId));
      for (const p of await pages())
        if (p.pending ? at - p.opened > L.startGrace * 1000 : !have.has(p.sessionId)) (await rows.delete("page/" + p.name), await tomb(p.name, "browser ended", at), out.closed.push(p.name));
    }
  };
  };
  // owner, browser, paidUntil, remaining, up and pages of each browser that has a row.
  const summary = async (at) => {
    const by = new Map();
    for (const r of await everything()) {
      const k = r.owner + "/" + r.browser, b = by.get(k) || { owner: r.owner, browser: r.browser, paidUntil: 0, up: false, pages: [], counted: [] };
      if (r.key === "paid") b.paidUntil = paidTo(r.value);
      if (r.key.startsWith("browser/")) (b.up = true), b.counted.push(r.value.counted);
      if (r.key.startsWith("page/") && !r.value.pending) b.pages.push(r.value.name);
      by.set(k, b);
    }
    // A browser whose time ran out and that has no page is not listed.
    return [...by.values()].filter((b) => b.up || b.pages.length || b.paidUntil > at).map((b) => ({ ...b, remaining: Math.max(0, Math.round((b.paidUntil - at) / 1000)) }));
  };
  // Browser-seconds that this service's browsers ran, as the tick counted them, for all owners. What was charged is in the core: quota.ledger.
  const usage = async (at) => {
    const live = (await summary(at)).flatMap((b) => b.counted).reduce((n, c) => n + Math.max(0, at - c) / 1000, 0), month = day(at).slice(0, 7);
    const before = (await all.list("usage/" + month)).filter((r) => r.key !== "usage/" + day(at)).reduce((n, r) => n + r.value.seconds, 0);
    const today = ((await all.get("usage/" + day(at))) || { seconds: 0 }).seconds + live;
    return { day: day(at), usedSeconds: Math.round(today), monthUsedSeconds: Math.round(before + today), includedSeconds: L.includedSeconds };
  };
  return {
    one,
    // Each browser of each owner. For the owner's own session.
    all: async () => ({ browsers: (await summary(Date.now())).map(({ counted, ...b }) => b) }),
    settings: async (q) => {
      const s = await settings(), bounds = { maxTabs: [1, 32], maxBrowsers: [1, 100], maxPerOwner: [1, 100] };
      for (const [k, [lo, hi]] of Object.entries(bounds)) {
        if (q[k] === undefined) continue;
        if (!Number.isInteger(q[k]) || q[k] < lo || q[k] > hi) throw stop(400, "InvalidRequest", `${k}: a whole number from ${lo} to ${hi}`);
        s[k] = q[k];
      }
      await all.put("settings", s);
      return s;
    },
    // Once a minute. For each browser: closes it when its time ran out, or sends it one command to keep it up, and makes the rows agree with Browser Run.
    tick: async () => {
      const at = Date.now(), out = { closed: [], ended: [], kept: 0, failed: [] }, DAY = 86400000;
      const live = await sessions(), ids = live ? new Set(live.map((x) => x.sessionId)) : null;
      const found = await everything(), busy = new Set(found.filter((r) => /^(browser|page|starting)\//.test(r.key)).map((r) => r.owner + "/" + r.browser));
      // One browser's error does not stop the tick of the others.
      for (const k of busy) await one(...k.split("/")).tick(at, ids, out).catch((e) => (out.failed.push(k), console.error("browser tick", k, e && e.message)));
      // What a browser that is over leaves goes after 24 h: why its pages closed, and its purchases.
      for (const r of found) if (r.key.startsWith("ended/") ? at - r.value.at > DAY : r.key === "paid" && paidTo(r.value) < at - DAY) await all.delete(`b/${r.owner}/${r.browser}/${r.key}`);
      for (const r of await all.list("usage/")) if (r.key < "usage/" + day(at - 62 * DAY)) await all.delete(r.key);
      // Rows from before 2026-10-08, when the service had one browser: its session is closed and the rows go.
      for (const r of await all.list("browser/")) await http("/v1/devtools/browser/" + r.value.sessionId, "DELETE").catch(() => null);
      for (const prefix of ["browser/", "page/", "ended/", "starting/", "paid", "bought/", "ledger/"]) for (const r of await all.list(prefix)) await all.delete(r.key);
      return out;
    }
  };
}
// %%
browserApp = {
  const app = new hono.Hono();
  const NS = "/xrpc/com.lopecode.brain.browser.";
  // The core names the caller and who started the chain. This service records them and decides nothing.
  const by = (c) => c.req.header("x-brain-caller") || "anonymous";
  const origin = (c) => c.req.header("x-brain-origin") || "";
  const body = async (c) => {
    const b = await c.req.json().catch(() => null);
    return b && typeof b === "object" ? b : {};
  };
  const answer = (fn) => async (c) => {
    try {
      const out = await fn(c);
      return out instanceof Response ? out : c.json(out);
    } catch (e) {
      if (e && e.status) return c.json({ error: e.error, message: e.message, ...e.more }, e.status);
      throw e;
    }
  };
  // Who owns the browser. A call that is not the person's own tab (an LLM turn, a PDS JWT, a portal, a call under a
  // delegation) owns browsers apart from that person's, because a page in a person's browser can hold their session.
  // The core names no caller via:… or d:….
  const who = (c) => keeperOf(c.req.raw.headers);
  // The browser is the one the caller owns under the name in `browser`, in the query string or in the body. "default" when absent.
  const mine = (c, q = {}) => browserOps.one(who(c), c.req.query("browser") || q.browser || "default");
  const post = (m) => app.post(NS + m, answer(async (c) => ((q) => mine(c, q)[m](q, by(c), origin(c)))(await body(c))));
  // seconds is in the query string, where the price reads it. Given two times, the last counts, for the core and here.
  app.post(NS + "extend", answer((c) => mine(c).extend({ seconds: new URL(c.req.url).searchParams.getAll("seconds").pop() })));
  ["open", "run", "close", "goto", "eval"].forEach(post);
  app.get(NS + "list", answer((c) => mine(c).list()));
  app.get(NS + "status", answer((c) => mine(c).status(c.req.query("name"))));
  app.get(NS + "text", answer((c) => mine(c).text({ name: c.req.query("name"), selector: c.req.query("selector") })));
  app.get(NS + "screenshot", answer(async (c) => {
    const data = await mine(c).screenshot({ name: c.req.query("name"), fullPage: c.req.query("fullPage") === "true", selector: c.req.query("selector") });
    return new Response(Uint8Array.from(atob(data), (ch) => ch.charCodeAt(0)), { headers: { "content-type": "image/png", "cache-control": "no-store" } });
  }));
  app.get(NS + "logs", answer((c) => mine(c).logs({ name: c.req.query("name") })));
  app.get(NS + "liveView", answer((c) => mine(c).liveView({ name: c.req.query("name") })));
  // A WebSocket that carries CDP. A GET that is not an upgrade starts nothing.
  app.get(NS + "cdp", answer((c) => {
    if ((c.req.header("upgrade") || "").toLowerCase() !== "websocket") return c.json({ error: "UpgradeRequired", message: "browser.cdp is a WebSocket: send Upgrade: websocket" }, 426);
    return mine(c).cdp();
  }));
  // For the owner's own session, by the rule of each: every browser, the end of any one, and the limits.
  app.get(NS + "all", answer(() => browserOps.all()));
  app.post(NS + "end", answer(async (c) => ((q) => browserOps.one(String(q.owner || ""), q.browser).close({ all: true }))(await body(c))));
  app.post(NS + "settings", answer(async (c) => browserOps.settings(await body(c))));
  return app;
}
// %%
browserPanel = ({ client, owner = false } = {}) => {
  if (!client || !owner) return Object.assign(htl.html`<i style="color:var(--theme-foreground-muted)">Sign in to a Brain as the owner to see its browser pages.</i>`, { value: null });
  const box = htl.html`<div></div>`, meterBox = htl.html`<div style="margin:6px 0"></div>`, note = htl.html`<div style="color:var(--theme-foreground-muted);margin-top:6px;white-space:pre-wrap;overflow-wrap:anywhere"></div>`, picture = htl.html`<div></div>`;
  let table = null;
  const say = (text) => void (note.textContent = text);
  const el = htl.html`<div></div>`;
  const limits = { maxTabs: Inputs.number({ label: "Pages in a browser", min: 1, max: 32, step: 1, width: "8em" }), maxBrowsers: Inputs.number({ label: "Browsers up", min: 1, max: 100, step: 1, width: "8em" }), maxPerOwner: Inputs.number({ label: "Browsers of one owner", min: 1, max: 100, step: 1, width: "8em" }) };
  // The browser that the buttons act on: one of the owner's own, by its name. The table under it is each browser of each owner.
  const which = Inputs.text({ label: "Browser", value: "default", width: "12em" }), fleet = htl.html`<div style="margin:6px 0"></div>`;
  // The buttons act on the browser that is shown, which is the last one drawn, and not on a name that is typed and not drawn yet.
  let fleetTable = null, shown = "default";
  const B = () => ({ browser: shown });
  const draw = async () => {
    const s = await client.query("browser.status", { browser: which.value || "default" });
    el.value = s;
    shown = s.browser;
    const every = (await client.query("browser.all")).browsers;
    fleetTable = Inputs.table(every.map((b) => ({ owner: b.owner, browser: b.browser, up: b.up, remaining: b.remaining, pages: b.pages.join(" ") })), { multiple: false, required: false, layout: "auto" });
    fleet.replaceChildren(every.length ? fleetTable : htl.html`<i style="color:var(--theme-foreground-muted)">No browser has time.</i>`);
    table = Inputs.table(s.pages.map((p) => ({ name: p.name, url: p.url, age: p.age, idle: p.idle, by: p.by })), { multiple: false, required: false, layout: "auto" });
    box.replaceChildren(s.pages.length ? table : htl.html`<i style="color:var(--theme-foreground-muted)">No pages.</i>`, htl.html`<div style="color:var(--theme-foreground-muted);font-size:12px">${s.remaining ? `${s.remaining} s of browser time are bought for ${s.browser}.` : `No browser time is bought for ${s.browser}. Add time first.`} ${s.browsers.length ? "The browser is up." : "It is not up."}</div>`);
    const u = s.usage;
    meterBox.replaceChildren(htl.html`${u.usedSeconds} browser-seconds used today (UTC) by all browsers, ${u.monthUsedSeconds} this month. Charges are in Spending.`);
    for (const k in limits) limits[k].value = s.settings[k];
  };
  const run = (what, fn) => async () => {
    try {
      say(what + "…");
      say((await fn()) || "");
      await draw();
    } catch (e) {
      say(`${what} failed: ${(e && e.message) || e}`);
    }
  };
  const picked = () => {
    const row = table && table.value;
    if (!row) throw new Error("choose a row");
    return row.name;
  };
  const show = (bytes) => void picture.replaceChildren(htl.html`<img style="max-width:100%;border:1px solid var(--theme-foreground-faintest)" src=${URL.createObjectURL(new Blob([bytes], { type: "image/png" }))}>`);
  const redraw = () => draw().catch((e) => say("browser.status failed: " + ((e && e.message) || e)));
  which.addEventListener("input", redraw);
  redraw();
  const name = Inputs.text({ label: "Name", placeholder: "docs", width: "12em" }), url = Inputs.text({ label: "URL", placeholder: "https://example.com/", width: "30em" });
  // The price is on the button before it is pressed. Time that is bought is not given back.
  const rate = browserLimits.dollarsPerSecond, dollars = (n) => "$" + Number(((Number(n) || 0) * rate).toFixed(6));
  const seconds = Inputs.number({ label: "Seconds to add", value: 60, min: browserLimits.minSeconds, max: browserLimits.maxSeconds, step: 1, width: "8em" });
  const cost = htl.html`<span style="align-self:center;color:var(--theme-foreground-muted)"></span>`;
  const priced = () => void (cost.textContent = `${seconds.value} s costs ${dollars(seconds.value)}, charged to your day. It is not given back.`);
  seconds.addEventListener("input", priced);
  priced();
  const expression = Inputs.text({ label: "Expression", placeholder: "document.title", width: "30em" });
  const refresh = Inputs.button("Refresh", { reduce: run("Refresh", async () => "") });
  const open = Inputs.button("Open", { reduce: run("Open", async () => ((r) => (r.existing ? "it was open" : `open in ${r.ms} ms`))(await client.procedure("browser.open", { name: name.value, url: url.value, ...B() }))) });
  const extend = Inputs.button("Add time", { reduce: run("Add time", async () => ((r) => `${r.added} s added, $${r.costUsd}`)(await client.procedure("browser.extend", {}, { params: { seconds: String(seconds.value), ...B() } }))) });
  const close = Inputs.button("Close", { reduce: run("Close", async () => void (await client.procedure("browser.close", { name: picked(), ...B() }))) });
  const closeAll = Inputs.button("Close browser", { reduce: run("Close browser", async () => void (await client.procedure("browser.close", { all: true, ...B() }))) });
  const endOne = Inputs.button("End chosen browser", {
    reduce: run("End", async () => {
      const row = fleetTable && fleetTable.value;
      if (!row) throw new Error("choose a browser in the table of all browsers");
      await client.procedure("browser.end", { owner: row.owner, browser: row.browser });
    })
  });
  const picture1 = Inputs.button("Screenshot", { reduce: run("Screenshot", async () => void show(await client.query("browser.screenshot", { name: picked(), ...B() }))) });
  const once = Inputs.button("Run once", {
    reduce: run("Run", async () => {
      const r = await client.procedure("browser.run", { url: url.value, expression: expression.value || undefined, screenshot: true, ...B() });
      if (r.screenshot) show(Uint8Array.from(atob(r.screenshot), (ch) => ch.charCodeAt(0)));
      return JSON.stringify({ ...r, screenshot: undefined }, null, 1).slice(0, 2000);
    })
  });
  const save = Inputs.button("Save limits", { reduce: run("Save", async () => void (await client.procedure("browser.settings", Object.fromEntries(Object.entries(limits).map(([k, i]) => [k, i.value]))))) });
  const rowOf = (...items) => htl.html`<div style="display:flex;gap:8px;flex-wrap:wrap;margin:8px 0">${items}</div>`;
  el.append(which, box, rowOf(refresh, close, closeAll, picture1), seconds, rowOf(extend, cost), name, url, expression, rowOf(open, once), fleet, rowOf(endOne), meterBox, ...Object.values(limits), rowOf(save), note, picture);
  return el;
}
// %%
md`## Tests

The tests run the emitted Worker in the tab against \`browserFake\`: the HTTP paths of the Browser Run binding and enough CDP for this service. A page of the fake is a title, a text and a few elements. The fake does not render, and its screenshot is the PNG signature followed by the parameters of the capture.`
// %%
browserFake = ({ sites = {} } = {}) => {
  const sessions = new Map(), stores = new Map();
  const stats = { acquired: 0, connects: 0, deleted: [], commands: [], params: [] };
  let n = 0;
  const fake = { sessions, stats, sites, refuse: null, onAcquire: null };
  fake.session = (startTime = Date.now()) => {
    const id = "s" + ++n;
    sessions.set(id, { id, startTime, targets: new Map(), contexts: new Set(), sockets: new Set() });
    sessions.get(id).targets.set("t0-" + id, { id: "t0-" + id, contextId: "default", url: "about:blank" });
    return id;
  };
  // The browser is gone: a crash, or Browser Run's own idle timer.
  fake.kill = (id) => {
    const s = sessions.get(id);
    if (!s) return false;
    sessions.delete(id);
    for (const k of [...s.sockets]) k.end();
    return true;
  };
  // The browser takes connections and answers nothing.
  fake.wedge = (id) => void (sessions.get(id).wedged = true);
  fake.targets = (id) => [...sessions.get(id).targets.values()].filter((t) => t.contextId !== "default");
  const storage = (contextId, origin) => {
    const key = contextId + " " + origin;
    if (!stores.has(key)) stores.set(key, new Map());
    const m = stores.get(key);
    return { getItem: (k) => (m.has(k) ? m.get(k) : null), setItem: (k, v) => void m.set(k, String(v)) };
  };
  const load = (t, url, scripts) => {
    const site = sites[url] || { title: "Page " + url, text: "text of " + url };
    const quiet = () => {};
    const console = { log: quiet, info: quiet, warn: quiet, error: quiet, debug: quiet };
    const window = { scrollX: 0, scrollY: 0 };
    const document = {
      title: site.title, readyState: "complete", body: { innerText: site.text },
      querySelector: (sel) => (site.elements && sel in site.elements ? { innerText: site.elements[sel], getBoundingClientRect: () => ({ x: 10, y: 20, width: 30, height: 40 }) } : null)
    };
    t.url = url;
    t.site = site;
    t.scope = { window, document, location: { href: url }, localStorage: storage(t.contextId, url.startsWith("http") ? new URL(url).origin : url), console, addEventListener: quiet };
    for (const s of scripts) evaluate(t, s);
  };
  const evaluate = (t, expression) => new Function(...Object.keys(t.scope), "return (" + expression + "\n)")(...Object.values(t.scope));
  const thrown = (e) => ({ result: { type: "object", subtype: "error" }, exceptionDetails: { text: "Uncaught", lineNumber: 0, columnNumber: 4, exception: { description: String(e) } } });
  const socket = (s) => {
    const listeners = { message: [], close: [] }, attached = new Map(), objects = new Map();
    let open = true;
    const emit = (type, e) => setTimeout(() => listeners[type].forEach((f) => f(e)), 0);
    const say = (m) => open && emit("message", { data: JSON.stringify(m) });
    const target = (sessionId) => {
      const a = attached.get(sessionId);
      if (!a || !s.targets.has(a.target.id)) throw new Error("Session with given id not found.");
      return a;
    };
    const handle = async ({ method, params = {}, sessionId }) => {
      stats.commands.push(method);
      stats.params.push(params);
      if (method === "Browser.getVersion") return { product: "Fake/1" };
      if (method === "Target.getTargets") return { targetInfos: [...s.targets.values()].map((t) => ({ targetId: t.id, type: "page", url: t.url, browserContextId: t.contextId })) };
      if (method === "Target.createBrowserContext") {
        const id = "c" + ++n;
        s.contexts.add(id);
        return { browserContextId: id };
      }
      if (method === "Target.disposeBrowserContext") {
        if (!s.contexts.delete(params.browserContextId)) throw new Error("Failed to find context with id " + params.browserContextId);
        for (const t of [...s.targets.values()]) if (t.contextId === params.browserContextId) s.targets.delete(t.id);
        return {};
      }
      if (method === "Target.createTarget") {
        if (!s.contexts.has(params.browserContextId)) throw new Error("Failed to find browser context with id " + params.browserContextId);
        const t = { id: "t" + ++n, contextId: params.browserContextId, size: [params.width, params.height] };
        load(t, params.url, []);
        s.targets.set(t.id, t);
        return { targetId: t.id };
      }
      if (method === "Target.attachToTarget") {
        const t = s.targets.get(params.targetId);
        if (!t) throw new Error("No target with given id found");
        const id = "a" + ++n;
        attached.set(id, { target: t, scripts: [] });
        return { sessionId: id };
      }
      if (method === "Target.closeTarget") return { success: s.targets.delete(params.targetId) };
      const a = target(sessionId), t = a.target;
      if (method === "Page.enable") return {};
      if (method === "Page.addScriptToEvaluateOnNewDocument") return a.scripts.push(params.source), { identifier: String(a.scripts.length) };
      if (method === "Page.navigate") {
        const site = sites[params.url] || {};
        if (site.fail) return { frameId: "f", errorText: site.fail };
        load(t, params.url, a.scripts);
        if (!site.never) setTimeout(() => say({ method: "Page.loadEventFired", params: {}, sessionId }), site.ms || 0);
        return { frameId: "f" };
      }
      if (method === "Runtime.evaluate") {
        try {
          let v = evaluate(t, params.expression);
          if (params.awaitPromise) v = await v;
          if (v instanceof Promise) v.catch(() => {});
          if (v === undefined) return { result: { type: "undefined" } };
          // An object is a handle unless the value is asked for. The handle is good on this connection.
          if (params.returnByValue || v === null || (typeof v !== "object" && typeof v !== "function")) return { result: { type: typeof v, value: v } };
          const objectId = "o" + ++n;
          objects.set(objectId, v);
          return { result: { type: "object", ...(v instanceof Promise ? { subtype: "promise" } : {}), objectId } };
        } catch (e) {
          return thrown(e);
        }
      }
      if (method === "Runtime.callFunctionOn") {
        if (!objects.has(params.objectId)) throw new Error("Could not find object with given id");
        try {
          const v = evaluate(t, params.functionDeclaration).apply(objects.get(params.objectId), (params.arguments || []).map((a) => a.value));
          return { result: v === undefined ? { type: "undefined" } : { type: typeof v, value: v } };
        } catch (e) {
          return thrown(e);
        }
      }
      if (method === "Page.getLayoutMetrics") return { cssContentSize: { x: 0, y: 0, width: 1280, height: 3000 } };
      if (method === "Page.captureScreenshot") {
        const bytes = [0x89, 0x50, 0x4e, 0x47, 0x0d, 0x0a, 0x1a, 0x0a, ...new TextEncoder().encode(JSON.stringify(params).padEnd(t.site.shotBytes || 0, " "))];
        let text = "";
        for (let i = 0; i < bytes.length; i += 8192) text += String.fromCharCode.apply(null, bytes.slice(i, i + 8192));
        return { data: btoa(text) };
      }
      throw new Error("the fake does not know " + method);
    };
    const k = {
      accept() {},
      addEventListener: (type, f) => void (listeners[type] && listeners[type].push(f)),
      send(text) {
        const m = JSON.parse(text);
        if (!open || s.wedged) return;
        Promise.resolve().then(() => handle(m)).then((result) => say({ id: m.id, result }), (e) => say({ id: m.id, error: { message: String((e && e.message) || e) } }));
      },
      close() {
        open = false;
        s.sockets.delete(k);
      },
      end() {
        if (!open) return;
        emit("close", { code: 1006, reason: "browser ended" });
        s.sockets.delete(k);
        setTimeout(() => (open = false), 0);
      }
    };
    s.sockets.add(k);
    return k;
  };
  fake.fetch = async (request) => {
    const u = new URL(request.url), method = request.method, json = (v, status = 200) => new Response(JSON.stringify(v), { status, headers: { "content-type": "application/json" } });
    if (u.pathname === "/v1/sessions") return json({ sessions: [...sessions.values()].map((s) => ({ sessionId: s.id, startTime: s.startTime })) });
    if (u.pathname === "/v1/devtools/browser" && method === "POST") {
      if (fake.refuse) return json({ success: false, errors: [{ message: fake.refuse }] }, 429);
      stats.acquired++;
      const id = fake.session();
      if (fake.onAcquire) await fake.onAcquire(id);
      return json({ sessionId: id });
    }
    const m = u.pathname.match(/^\/v1\/devtools\/browser\/([^/]+)(\/json\/list)?$/);
    const s = m && sessions.get(m[1]);
    if (!m) return json({ error: "no such path " + u.pathname }, 404);
    if (!s) return json({ success: false, errors: [{ message: "session not found" }] }, 404);
    if (m[2]) return json([...s.targets.values()].map((t) => ({ id: t.id, url: t.url, devtoolsFrontendUrl: `https://live.example/${s.id}/${t.id}` })));
    if (method === "DELETE") return stats.deleted.push(s.id), fake.kill(s.id), json({ status: "closed" });
    // A browser cannot answer 101 with a Response, and drops the Upgrade header of a Request. A GET of the session is the connect.
    stats.connects++;
    return { status: 101, webSocket: socket(s) };
  };
  return fake;
}
// %%
// paid: the seconds of browser time that are bought when the test starts. 0 for none.
browserRig = async ({ sites = {}, paid = 600 } = {}) => {
  const fake = browserFake({ sites });
  const sim = await simulate(browser_service, { browser: fake.fetch });
  // The rows of one browser: "owner/default" unless a test names a different owner and browser.
  const K = (key, scope = "owner/default") => `b/${scope}/${key}`;
  const rows = { get: (k, sc) => sim.rows.get(K(k, sc)), set: (k, v, sc) => sim.rows.set(K(k, sc), v), delete: (k, sc) => sim.rows.delete(K(k, sc)) };
  const setPaid = (seconds, scope) => rows.set("paid", [{ t: Date.now(), n: seconds }], scope);
  if (paid) setPaid(paid);
  const X = "https://brain.internal/xrpc/com.lopecode.brain.browser.";
  const as = (who, origin = who, via) => {
    const headers = { "content-type": "application/json", "x-brain-caller": who, "x-brain-context": "for " + who, "x-brain-origin": origin, ...(via ? { "x-brain-via": via } : {}) };
    const read = async (r) => ({ status: r.status, data: (r.headers.get("content-type") || "").includes("json") ? await r.json() : new Uint8Array(await r.arrayBuffer()) });
    const query = (params) => (Object.keys(params).length ? "?" + new URLSearchParams(params) : "");
    return {
      get: async (m, params = {}) => read(await sim.fetch(X + m + query(params), { headers })),
      post: async (m, body = {}, params = {}) => read(await sim.fetch(X + m + query(params), { method: "POST", body: JSON.stringify(body), headers }))
    };
  };
  const owner = as("owner");
  const keys = (prefix, scope) => [...sim.rows.keys()].filter((k) => k.startsWith(K(prefix, scope))).map((k) => k.slice(K("", scope).length)).sort();
  const session = (scope) => (keys("browser/", scope)[0] || "").slice("browser/".length);
  return {
    sim, fake, rows, as, owner, keys, session, tick: () => sim.scheduled(),
    open: async (name, url = "https://a.example/", more = {}, params = {}) => (await owner.post("open", { name, url, ...more }, params)).data,
    // The time that is bought, in seconds from now; and a way to move it, since the Worker reads the clock.
    paid: (scope) => Math.round(((rows.get("paid", scope) || []).reduce((until, e) => Math.max(until, e.t) + e.n * 1000, 0) - Date.now()) / 1000),
    setPaid,
    // What the core charges for a call: the price of the method with this query string, in USD. null when the method has none.
    price: async (method, params = {}) => {
      const rule = (await browser_service.emit()).meta.access["com.lopecode.brain.browser." + method];
      if (!rule.price) return null;
      const context = { caller: callerOf({ caller: "owner" }), request: { params } };
      if (decide({ allow: `(${rule.price}) >= 0.0` }, context).allow !== true) return "undecided";
      for (let micro = 0; micro <= 100000; micro += 25) if (decide({ allow: `(${rule.price}) < ${(micro + 12) / 1e6}` }, context).allow) return micro / 1e6;
      return "more";
    }
  };
}
// %%
test_browser_declares_what_it_needs = {
  const { meta, parts } = await browser_service.emit();
  expect(meta).toMatchObject({ worker: "brain-x-browser", role: "recipe", module: "@tomlarkworthy/brain-browser", resources: ["browser", "rows"], secrets: [], paths: [], calls: [], crons: ["* * * * *"] });
  expect(meta.bindings).toContainEqual({ type: "browser", name: "X_CF_BROWSER_RUN" });
  expect(parts[0].text).toContain('__rt.platform.workers.fetch("cf-browser-run"');
  // Who the rule of each method lets through before the owner changes it.
  const callers = { owner: { caller: "owner", via: "session" }, token: { caller: "token:laptop" }, granted: { caller: "did:plc:ada" }, worker: { caller: "worker:brain-x-reader" }, anyone: { caller: "anonymous" } };
  const through = (rule, params = {}) => Object.entries(callers).filter(([, w]) => decide(rule, { caller: callerOf(w), request: { method: "", path: "", verb: "POST", params } }).allow).map(([n]) => n).join(" ");
  const N = "com.lopecode.brain.browser.";
  // A Worker of the Brain is let through: the service is for each process of the Brain. (A recipe Worker also names the method in its calls.)
  for (const m of ["open", "extend", "run", "list", "status", "close", "goto", "eval", "text", "screenshot", "logs", "cdp"]) expect([m, through(meta.access[N + m])]).toEqual([m, "owner token granted worker"]);
  // The limits, the Live View link, and the two methods that reach the browsers of each owner: the owner's own session, and the owner cannot put a different rule.
  for (const m of ["settings", "liveView", "all", "end"]) expect([m, through(meta.access[N + m]), meta.access[N + m].fixed]).toEqual([m, "owner", true]);
  // One method has a price, and it is built from the limits.
  expect(Object.keys(meta.access).filter((k) => meta.access[k].price).map((k) => [k.slice(N.length), meta.access[k].price])).toEqual([["extend", browserPrice]]);
  expect(browserPrice).toContain(`* ${browserLimits.dollarsPerSecond} `);
  return Object.keys(meta.access).length + " methods";
}
// %%
test_browser_open_makes_a_tab_and_reuses_it_by_name = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha" } } });
  const a = await rig.open("a");
  expect(a).toMatchObject({ name: "a", open: true, url: "https://a.example/", by: "owner", loaded: true, cold: true, existing: false, credential: null });
  // The same name gives the same tab. A second name is a second tab in the same browser.
  expect(await rig.open("a", "https://other.example/")).toMatchObject({ existing: true, url: "https://a.example/", title: "A" });
  const b = (await rig.as("owner", "did:plc:ada").post("open", { name: "b", url: "https://a.example/" })).data;
  expect(b).toMatchObject({ cold: false, by: "owner", origin: "did:plc:ada" });
  expect([rig.fake.stats.acquired, rig.fake.sessions.size, rig.keys("browser/").length, rig.keys("page/")]).toEqual([1, 1, 1, ["page/a", "page/b"]]);
  const sid = rig.session();
  expect(rig.fake.targets(sid).map((t) => t.size)).toEqual([[1280, 800], [1280, 800]]);
  // Each page has its own storage, for the same origin. Two pages opened with one label share it.
  const ev = async (name, expression) => (await rig.owner.post("eval", { name, expression })).data;
  await ev("a", 'localStorage.setItem("k", "one")');
  expect([(await ev("a", 'localStorage.getItem("k")')).value, (await ev("b", 'localStorage.getItem("k")')).value]).toEqual(["one", null]);
  await rig.open("c", "https://a.example/", { shared: "team" });
  await rig.open("d", "https://a.example/", { shared: "team" });
  await ev("c", 'localStorage.setItem("k", "two")');
  expect((await ev("d", 'localStorage.getItem("k")')).value).toBe("two");
  expect(new Set(rig.fake.targets(sid).map((t) => t.contextId)).size).toBe(3);
  // Closing one of the two leaves the other its storage. Closing a page leaves the browser.
  expect((await rig.owner.post("close", { name: "c" })).data).toEqual({ closed: ["c"] });
  expect((await ev("d", 'localStorage.getItem("k")')).value).toBe("two");
  expect((await rig.owner.get("list")).data.pages.map((p) => p.name)).toEqual(["a", "b", "d"]);
  expect((await rig.owner.get("status", { name: "c" })).data).toMatchObject({ open: false, closed: "closed" });
  expect((await rig.owner.get("status", { name: "nobody" })).status).toBe(404);
  // close all closes the browser at once. The time stays bought (some is left; how much depends on how long this test took), and the next open starts a browser.
  expect((await rig.owner.post("close", { all: true })).data.closed.sort()).toEqual(["a", "b", "d"]);
  expect([rig.fake.sessions.size, rig.keys("browser/"), rig.keys("page/"), rig.paid() > 0]).toEqual([0, [], [], true]);
  expect(await rig.open("e")).toMatchObject({ cold: true, existing: false });
  return "one browser, 4 tabs, 3 contexts";
}
// %%
test_browser_time_is_bought_by_extend_alone = {
  const rig = await browserRig({ paid: 0 }), A = { url: "https://a.example/" };
  // Bought time runs down by the clock while the test runs: what is left is the amount less the seconds the test
  // has taken so far, however slow the machine. A fixed tolerance failed on a slow run (96 for 100, 2026-10-10).
  const began = Date.now(), near = (got, want) => (got <= want + 1 && got >= want - 2 - (Date.now() - began) / 1000 ? want : got);
  // With no time bought, each method that uses the browser says so, and no browser starts.
  for (const [m, body] of [["open", { name: "a", ...A }], ["run", A], ["goto", { name: "a", ...A }], ["eval", { name: "a", expression: "1" }]]) {
    const r = await rig.owner.post(m, body);
    expect([m, r.status, r.data]).toEqual([m, 409, { error: "NoTime", message: "no browser time is bought for browser default. browser.extend?seconds=N buys N seconds.", paidUntil: 0 }]);
  }
  for (const m of ["text", "screenshot", "logs", "liveView"]) expect([m, (await rig.owner.get(m, { name: "a" })).data.error]).toEqual([m, "NoTime"]);
  expect([(await rig.owner.get("list")).data, (await rig.owner.get("status")).data.remaining, (await rig.owner.post("close", { all: true })).status, rig.fake.stats.acquired]).toEqual([{ pages: [] }, 0, 200, 0]);
  // extend adds its seconds from now and starts the browser.
  const first = (await rig.as("owner", "did:plc:ada").post("extend", {}, { seconds: 100 })).data;
  expect([first.added, first.costUsd, first.cold, near(Math.round((first.paidUntil - Date.now()) / 1000), 100), rig.fake.sessions.size]).toEqual([100, 0.0025, true, 100, 1]);
  // A second one adds to the time that is bought.
  expect((await rig.owner.post("extend", {}, { seconds: 45 })).data).toEqual({ browser: "default", paidUntil: first.paidUntil + 45000, added: 45, costUsd: 0.001125, cold: false });
  // The other methods use the time and add none.
  await rig.open("a");
  await rig.owner.post("run", A);
  await rig.owner.post("eval", { name: "a", expression: "1" });
  expect(rig.fake.stats.acquired).toBe(1);
  expect((await rig.owner.get("status")).data).toMatchObject({ paidUntil: first.paidUntil + 45000, returned: false, browsers: [{ pages: ["a"] }] });
  // run needs time for the whole of its timeout.
  expect([(await rig.owner.post("run", { ...A, timeout: 120000 })).status, (await rig.owner.post("extend", {}, { seconds: 10 })).status]).toEqual([200, 200]);
  rig.setPaid(60);
  expect((await rig.owner.post("run", { ...A, timeout: 90000 })).data.message).toMatch(/^the call needs 90 s of browser time and (59|60) s are bought for browser default\. browser\.extend\?seconds=N buys N seconds\.$/);
  // When the time has passed, the next call closes the browser with its pages open.
  rig.setPaid(-1);
  const late = await rig.owner.post("eval", { name: "a", expression: "1" });
  expect([late.status, late.data.error, rig.fake.sessions.size, rig.keys("browser/"), rig.keys("page/")]).toEqual([409, "NoTime", 0, [], []]);
  expect((await rig.owner.get("status", { name: "a" })).data).toMatchObject({ open: false, closed: "time ran out" });
  // Time that had passed is not added to: a purchase counts from now.
  expect(near(Math.round(((await rig.owner.post("extend", {}, { seconds: 20 })).data.paidUntil - Date.now()) / 1000), 20)).toBe(20);
  // The tick closes the browser when no call comes. A browser with time left and no page stays up.
  await rig.tick();
  expect(rig.fake.sessions.size).toBe(1);
  rig.setPaid(-1);
  await rig.tick();
  expect([rig.fake.sessions.size, rig.keys("browser/")]).toEqual([0, []]);
  return "no time, 100 s, 45 s more, closed when it ran out";
}
// %%
test_browser_price_is_what_extend_adds = {
  const rig = await browserRig({ paid: 0 });
  const X = "https://brain.internal/xrpc/com.lopecode.brain.browser.extend", headers = { "x-brain-caller": "owner", "x-brain-origin": "owner" };
  const added = () => (rig.rows.get("paid") || []).reduce((n, e) => n + e.n, 0);
  // Each query string: what the core charges, and what the service then adds. The core reads the last value of a name that is given two times.
  const cases = { "": 0, "?seconds=": 0, "?seconds=60": 60, "?seconds=10": 10, "?seconds=3600": 3600, "?seconds=0060": 60, "?seconds=9": 0, "?seconds=3601": 0, "?seconds=99999": 0, "?seconds=-60": 0, "?seconds=1.5": 0, "?seconds=6e1": 0, "?seconds=x": 0, "?seconds=%2060": 0, "?seconds=1e999": 0, "?seconds=60&seconds=x": 0, "?seconds=x&seconds=60": 60, "?seconds=60&seconds=20": 20, "?other=60": 0 };
  for (const [query, want] of Object.entries(cases)) {
    const before = added(), price = await rig.price("extend", Object.fromEntries(new URLSearchParams(query)));
    const r = await rig.sim.fetch(X + query, { method: "POST", headers });
    expect([query, price, r.status, added() - before]).toEqual([query, Number((want * 0.000025).toFixed(6)), want ? 200 : 400, want]);
  }
  // Purchases made at one time all count.
  rig.setPaid(0);
  const t0 = Date.now(), burst = await Promise.all(Array.from({ length: 12 }, () => rig.owner.post("extend", {}, { seconds: 50 })));
  expect([burst.filter((r) => r.status === 200).length, Math.round((Math.max(...burst.map((r) => r.data.paidUntil)) - t0) / 1000), rig.fake.sessions.size]).toEqual([12, 600, 1]);
  // The row keeps 1000 purchases. One more, with all of them still bought, adds its seconds like the rest.
  rig.rows.set("paid", Array.from({ length: 1000 }, (_, i) => ({ t: t0, n: 10, u: i ? t0 + i * 10000 : 0 })));
  const more = await rig.owner.post("extend", {}, { seconds: 10 });
  expect([more.status, rig.rows.get("paid").length, Math.round((more.data.paidUntil - t0) / 1000)]).toEqual([200, 1000, 10010]);
  return Object.keys(cases).length + " query strings: charged is added; 12 at once add 600 s; 1001 in a row all count";
}
// %%
test_browser_gives_no_time_that_was_not_bought = {
  const rig = await browserRig({ paid: 0, sites: { "https://down.example/": { fail: "net::ERR_FAILED" } } });
  const bought = () => (rig.rows.get("paid") || []).reduce((n, e) => n + e.n, 0), down = { url: "https://down.example/" };
  // Calls that fail, before any time is bought: no time, no browser.
  for (let i = 0; i < 3; i++) for (const [m, body] of [["open", { name: "a", ...down }], ["run", down], ["eval", { name: "a", expression: "1" }]]) expect((await rig.owner.post(m, body)).status).toBe(409);
  for (const seconds of ["x", "5", "99999"]) expect((await rig.owner.post("extend", {}, { seconds })).status).toBe(400);
  expect([bought(), rig.paid() <= 0, rig.fake.stats.acquired]).toEqual([0, true, 0]);
  // Browser Run starts no browser: extend fails after its price was charged. The seconds are bought, and they are all that is bought.
  rig.fake.refuse = "rate limit";
  const none = await rig.owner.post("extend", {}, { seconds: 60 });
  expect([none.status, none.data.error, bought(), rig.keys("browser/"), rig.keys("starting/")]).toEqual([502, "BrowserUnavailable", 60, [], []]);
  rig.fake.refuse = null;
  // The next call that needs the browser starts it inside that time. Calls that fail there add nothing.
  const until = rig.paid();
  for (const [m, body] of [["open", { name: "a", ...down }], ["run", down], ["open", { name: "bad name", ...down }], ["eval", { name: "nobody", expression: "1" }]]) expect((await rig.owner.post(m, body)).status).toBeGreaterThanOrEqual(400);
  expect([bought(), rig.paid() <= until, rig.fake.stats.acquired, rig.keys("page/")]).toEqual([60, true, 1, []]);
  return "60 s bought, 60 s had";
}
// %%
test_browser_eval_gives_a_value_or_what_the_page_threw = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha" } } });
  await rig.open("a");
  const ev = async (body) => rig.owner.post("eval", { name: "a", ...body });
  expect((await ev({ expression: "document.title" })).data).toEqual({ value: "A", type: "string" });
  expect((await ev({ expression: "({ n: [1, 2] })" })).data).toEqual({ value: { n: [1, 2] }, type: "object" });
  expect((await ev({ expression: "Promise.resolve({ n: 1 + 1 })" })).data).toEqual({ value: { n: 2 }, type: "object" });
  expect((await ev({ expression: "new Promise((yes) => setTimeout(() => yes(7), 300))" })).data).toEqual({ value: 7, type: "number" });
  expect((await ev({ expression: "undefined" })).data).toEqual({ value: null, type: "null" });
  // What the page throws is a result with status 200.
  const thrown = await ev({ expression: '(() => { throw new Error("boom"); })()' });
  expect([thrown.status, thrown.data.thrown.message, thrown.data.thrown.column]).toEqual([200, "Error: boom", 4]);
  expect((await ev({ expression: 'Promise.reject(new Error("later"))' })).data.thrown.message).toMatch(/^Error: later/);
  // A promise that does not settle: the call stops at the timeout and the page stays open.
  const slow = await ev({ expression: "new Promise(() => {})", timeout: 300 });
  expect([slow.status, slow.data]).toEqual([504, { error: "Timeout", message: "the promise did not settle in 300 ms" }]);
  expect((await ev({ expression: "1 + 1" })).data.value).toBe(2);
  // No command waits on the promise: its result has a place in the page, and that place is read.
  expect(rig.fake.stats.params.filter((p) => p.awaitPromise === true).length).toBe(0);
  expect((await ev({ expression: "Object.keys(window).filter((k) => k.startsWith('__brainEval')).length" })).data.value).toBe(1);
  // A value too large to give back.
  const big = await ev({ expression: '"x".repeat(300000)' });
  expect([big.status, big.data.error, big.data.message]).toEqual([413, "TooLarge", "the value is 300002 characters of JSON. The limit is 262144."]);
  expect((await ev({})).status).toBe(400);
  expect((await rig.owner.post("eval", { name: "nobody", expression: "1" })).status).toBe(404);
  return "value, promise, thrown, timeout, too large";
}
// %%
test_browser_text_screenshot_logs_and_goto = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha body", elements: { "#main": "the main part" } }, "https://big.example/": { title: "Big", text: "y".repeat(100500), shotBytes: 2100000 }, "https://down.example/": { fail: "net::ERR_NAME_NOT_RESOLVED" } } });
  await rig.open("a");
  expect((await rig.owner.get("text", { name: "a" })).data).toEqual({ text: "alpha body", truncated: false });
  expect((await rig.owner.get("text", { name: "a", selector: "#main" })).data.text).toBe("the main part");
  expect((await rig.owner.get("text", { name: "a", selector: "#none" })).status).toBe(404);
  // A screenshot is PNG bytes. The fake puts the parameters of the capture after the signature.
  const said = (bytes) => JSON.parse(new TextDecoder().decode(bytes.slice(8)));
  const png = (await rig.owner.get("screenshot", { name: "a" })).data;
  expect([...png.slice(0, 4)]).toEqual([0x89, 0x50, 0x4e, 0x47]);
  expect(said(png)).toEqual({ format: "png" });
  expect(said((await rig.owner.get("screenshot", { name: "a", fullPage: "true" })).data).clip).toEqual({ x: 0, y: 0, width: 1280, height: 3000, scale: 1 });
  expect(said((await rig.owner.get("screenshot", { name: "a", selector: "#main" })).data).clip).toEqual({ x: 10, y: 20, width: 30, height: 40, scale: 1 });
  // Console calls are kept in the page, from before its own scripts, and are read by a later call.
  await rig.owner.post("eval", { name: "a", expression: 'console.log("one", { two: 2 })' });
  await rig.owner.post("eval", { name: "a", expression: 'console.error("x".repeat(600))' });
  const logs = (await rig.owner.get("logs", { name: "a" })).data.logs;
  expect(logs.map((l) => [l.level, l.text.length])).toEqual([["log", 13], ["error", 500]]);
  expect(logs[0].text).toBe('one {"two":2}');
  // goto loads a different address in the same tab. The log starts again with the document.
  expect((await rig.owner.post("goto", { name: "a", url: "https://big.example/" })).data).toMatchObject({ url: "https://big.example/", loaded: true });
  expect((await rig.owner.get("status", { name: "a" })).data.url).toBe("https://big.example/");
  expect((await rig.owner.get("logs", { name: "a" })).data.logs).toEqual([]);
  const text = (await rig.owner.get("text", { name: "a" })).data;
  expect([text.text.length, text.truncated]).toEqual([100000, true]);
  const large = await rig.owner.get("screenshot", { name: "a" });
  expect([large.status, large.data.error]).toEqual([413, "TooLarge"]);
  // An address that does not load: goto says so and the page stays; open leaves no page.
  const down = await rig.owner.post("goto", { name: "a", url: "https://down.example/" });
  expect([down.status, down.data.error, down.data.message]).toEqual([502, "NavigationFailed", "https://down.example/: net::ERR_NAME_NOT_RESOLVED"]);
  expect((await rig.owner.post("open", { name: "b", url: "https://down.example/" })).status).toBe(502);
  expect(rig.keys("page/")).toEqual(["page/a"]);
  expect(rig.fake.targets(rig.session()).length).toBe(1);
  // The Live View link of the tab.
  expect((await rig.owner.get("liveView", { name: "a" })).data.url).toMatch(/^https:\/\/live\.example\/s\d+\/t\d+$/);
  return "text, 3 screenshots, 2 log lines, goto, live view";
}
// %%
test_browser_each_call_is_a_new_connection_to_the_same_tab = {
  const rig = await browserRig();
  await rig.open("a");
  const before = rig.fake.stats.connects;
  await rig.owner.post("eval", { name: "a", expression: "(window.kept = 41, true)" });
  expect((await rig.owner.post("eval", { name: "a", expression: "window.kept + 1" })).data.value).toBe(42);
  expect(rig.fake.stats.connects - before).toBe(2);
  expect([...rig.fake.sessions.values()][0].sockets.size).toBe(0);
  // Two calls at once, each with its own connection, one of them waiting on a promise.
  const both = await Promise.all([rig.owner.post("eval", { name: "a", expression: "new Promise((yes) => setTimeout(() => yes(window.kept), 400))" }), rig.owner.get("text", { name: "a" })]);
  expect(both.map((r) => [r.status, r.data.value])).toEqual([[200, 41], [200, undefined]]);
  return "2 calls, 2 connections, state kept in the tab";
}
// %%
test_browser_run_closes_its_tab = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha" }, "https://down.example/": { fail: "net::ERR_FAILED" } } });
  const left = () => [rig.keys("page/"), rig.fake.sessions.size ? rig.fake.targets(rig.session()).length : 0];
  const ok = (await rig.owner.post("run", { url: "https://a.example/", expression: "document.title", text: true, screenshot: true, logs: true, wait: "document.readyState == 'complete'" })).data;
  expect(ok).toMatchObject({ url: "https://a.example/", loaded: true, cold: true, value: "A", type: "string", text: "alpha", truncated: false, logs: [] });
  expect(atob(ok.screenshot).slice(1, 4)).toBe("PNG");
  expect(left()).toEqual([[], 0]);
  // An error of the page is a result. A refusal and a failed load are errors. The tab is closed each time.
  expect((await rig.owner.post("run", { url: "https://a.example/", expression: "nothing.here" })).data.thrown.message).toMatch(/ReferenceError/);
  expect((await rig.owner.post("run", { url: "https://down.example/" })).data.error).toBe("NavigationFailed");
  expect([left(), rig.fake.stats.acquired]).toEqual([[[], 0], 1]);
  // Five runs at once with no browser up start one browser.
  await rig.owner.post("close", { all: true });
  const burst = await Promise.all([1, 2, 3, 4, 5].map(() => rig.owner.post("run", { url: "https://a.example/", expression: "document.title" })));
  expect(burst.map((r) => r.data.value)).toEqual(["A", "A", "A", "A", "A"]);
  expect([rig.fake.stats.acquired, rig.fake.sessions.size, burst.filter((r) => r.data.cold).length]).toEqual([2, 1, 1]);
  expect([left(), rig.keys("starting/")]).toEqual([[[], 0], []]);
  // The browser stays for the time that was bought, then the tick closes it.
  await rig.tick();
  expect(rig.fake.sessions.size).toBe(1);
  rig.setPaid(-1);
  await rig.tick();
  expect([rig.fake.sessions.size, rig.keys("browser/")]).toEqual([0, []]);
  return "3 single runs and a burst of 5 on one browser; nothing left open";
}
// %%
test_browser_run_stops_at_its_timeout = {
  const rig = await browserRig({ sites: { "https://a.example/": { title: "A", text: "alpha" }, "https://never.example/": { title: "N", text: "", never: true } } });
  const t0 = Date.now();
  const [waited, hung, never] = await Promise.all([
    rig.owner.post("run", { url: "https://a.example/", wait: "window.never", timeout: 5000 }),
    rig.owner.post("run", { url: "https://a.example/", expression: "new Promise(() => {})", timeout: 5000 }),
    // A page whose load event does not come: the run goes on at half of its time with loaded false.
    rig.owner.post("run", { url: "https://never.example/", expression: "document.title", timeout: 5000 })
  ]);
  expect([waited.status, waited.data.message]).toEqual([504, "wait was not true in 5000 ms"]);
  expect([hung.status, hung.data.error]).toEqual([504, "Timeout"]);
  expect(never.data).toMatchObject({ loaded: false, value: "N" });
  expect(Date.now() - t0 < 7000).toBe(true);
  expect([rig.keys("page/"), rig.fake.targets(rig.session()).length]).toEqual([[], 0]);
  return "a wait, a promise and a load that do not end: 5 s each, no tab left";
}
// %%
test_browser_tick_makes_rows_and_sessions_agree = {
  const rig = await browserRig();
  // The session of a different Worker of the account is in the list. It is not this service's, and it stays.
  const theirs = rig.fake.session(Date.now() - 600000);
  await rig.open("a");
  expect(await rig.tick()).toBeUndefined();
  expect([rig.fake.sessions.has(theirs), rig.fake.stats.commands.filter((c) => c === "Target.getTargets").length]).toEqual([true, 1]);
  // A start that died after Browser Run made the browser: a lock row and a session with no row. The tick removes the lock.
  // The session has no row, so it is left for Browser Run's idle limit, like the session of another Worker.
  const orphan = rig.fake.session(Date.now() - 40000);
  rig.rows.set("starting/shared", { at: Date.now() - 41000 });
  await rig.tick();
  expect([rig.fake.sessions.has(orphan), rig.fake.sessions.has(theirs), rig.keys("starting/")]).toEqual([true, true, []]);
  rig.fake.kill(orphan);
  // The rows that the service had before 2026-10-08 are removed.
  // So are the rows of the one browser that it had until then, and that browser is closed.
  const old = rig.fake.session();
  for (const k of ["bought/2026-10-08", "ledger/x", "paid/s1", "paid", "page/x", "ended/x"]) rig.sim.rows.set(k, 1);
  rig.sim.rows.set("browser/" + old, { sessionId: old });
  await rig.tick();
  expect([[...rig.sim.rows.keys()].filter((k) => !/^(b|usage)\/|^settings$/.test(k)), rig.fake.sessions.has(old), rig.paid() > 0]).toEqual([[], false, true]);
  // A second browser, as two starts that crossed leave. No new page goes to it, and the tick closes it when it has no page.
  const browserRow = (sid) => rig.rows.set("browser/" + sid, { sessionId: sid, opened: Date.now(), counted: Date.now(), by: "owner" });
  const second = rig.fake.session();
  browserRow(second);
  await rig.open("b");
  expect((await rig.owner.get("status")).data.browsers.map((b) => b.pages)).toEqual([["a", "b"], []]);
  await rig.tick();
  expect([rig.fake.sessions.has(second), rig.keys("browser/").length]).toEqual([false, 1]);
  // A call that finds a start in progress waits for the browser row and does not start a second browser.
  await rig.owner.post("close", { all: true });
  rig.rows.set("starting/shared", { at: Date.now() });
  const before = rig.fake.stats.acquired;
  setTimeout(() => browserRow(rig.fake.session()), 300);
  expect(await rig.open("c")).toMatchObject({ cold: false, loaded: true });
  expect(rig.fake.stats.acquired).toBe(before);
  rig.rows.delete("starting/shared");
  // The browser ends by itself (a crash, Browser Run's timer). The next call says so and does not wait.
  await rig.open("d");
  rig.fake.kill(rig.session());
  const call = await rig.owner.post("eval", { name: "c", expression: "1" });
  expect([call.status, call.data]).toEqual([410, { error: "PageClosed", message: "page c is closed: browser ended" }]);
  expect((await rig.owner.get("status", { name: "d" })).data).toMatchObject({ open: false, closed: "browser ended" });
  expect([rig.keys("browser/"), rig.keys("page/")]).toEqual([[], []]);
  // The same when the tick is first to see it. A new open starts a new browser.
  expect((await rig.open("e")).cold).toBe(true);
  rig.fake.kill(rig.session());
  await rig.tick();
  expect((await rig.owner.get("status", { name: "e" })).data.closed).toBe("browser ended");
  // The browser ends during a call.
  await rig.open("f");
  const during = rig.owner.post("eval", { name: "f", expression: "new Promise(() => {})" });
  await new Promise((r) => setTimeout(r, 150));
  rig.fake.kill(rig.session());
  expect((await during).data.message).toBe("page f is closed: browser ended");
  // One tab is gone and the browser is up.
  await rig.open("g");
  await rig.open("h");
  rig.fake.sessions.get(rig.session()).targets.delete(rig.rows.get("page/g").targetId);
  expect((await rig.owner.post("eval", { name: "g", expression: "1" })).data.message).toBe("page g is closed: page ended");
  expect((await rig.owner.post("eval", { name: "h", expression: "1 + 1" })).data.value).toBe(2);
  // Browser time that was used is counted once for the browser, and not for each tab.
  // Measured as a difference: the seconds this test has itself run are in the day's count, and they were what a
  // bound of 100 to 110 failed on (111, 2026-10-10).
  // Each bound is widened by the seconds that passed between its two reads: a live browser's time goes on counting.
  const secs = (t) => (Date.now() - t) / 1000;
  const t1 = Date.now(), usedBefore = (await rig.owner.get("status")).data.usage.usedSeconds;
  const row = rig.rows.get(rig.keys("browser/")[0]);
  rig.rows.set(rig.keys("browser/")[0], { ...row, counted: row.counted - 100000 });
  const total = (await rig.owner.get("status")).data.usage.usedSeconds, used = total - usedBefore;
  expect(used >= 99 && used <= 101 + 2 * secs(t1) ? "about 100" : used).toBe("about 100");
  const t2 = Date.now();
  await rig.tick();
  const after = (await rig.owner.get("status")).data.usage.usedSeconds;
  expect(after - total >= 0 && after - total <= 1 + 2 * secs(t2) ? "the same" : [total, after]).toBe("the same");
  return "another Worker's session kept; a dead start, a second browser, a dead browser and a dead tab handled";
}
