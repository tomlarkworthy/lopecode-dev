test_browser_that_stops_answering_is_closed = {
  const rig = await browserRig();
  await rig.open("a");
  rig.fake.wedge(rig.session());
  // The tick waits 10 s for its command, then closes the browser. The page says why. A call waits 10 s the same way and answers Timeout.
  await rig.tick();
  expect([rig.fake.sessions.size, rig.keys("browser/"), (await rig.owner.get("status", { name: "a" })).data.closed]).toEqual([0, [], "browser stopped answering"]);
  return "closed by the tick after 10 s";
}
