  const withPage = async (name, fn) => {
    await timed();
    const p = await rows.get("page/" + name);
    if (!p || p.pending) throw await missing(String(name));
    const cdp = await connect(p.sessionId);
    if (!cdp) return lost(p.sessionId, name, why);
