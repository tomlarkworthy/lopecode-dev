    } catch (e) {
      if (e && e.gone) return lost(p.sessionId, name, "the socket closed: " + cdp.closedWhy());
      throw e;
    } finally {
      cdp.close();
    }
  };
  const navigate = async (cdp, sid, url, timeout) => {
    const loaded = cdp.until((m) => m.method === "Page.loadEventFired" && m.sessionId === sid, timeout);
    const r = await cdp.send("Page.navigate", { url }, sid, timeout + 5000);
    if (r && r.errorText) throw stop(502, "NavigationFailed", `${url}: ${r.errorText}`);
