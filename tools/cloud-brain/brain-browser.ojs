      await cdp.send("Runtime.callFunctionOn", { objectId: o.objectId, arguments: [{ value: key }], functionDeclaration: "function (k) { window[k] = { done: false }; this.then((v) => { window[k] = { done: true, value: v }; }, (e) => { window[k] = { done: true, error: String((e && e.stack) || e) }; }); }" }, sid);
