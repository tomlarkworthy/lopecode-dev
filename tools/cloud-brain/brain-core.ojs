test_the_log_line_of_a_priced_call_has_its_price = {
  const rig = await coreRig();
  await rig.owner("price.put", { target: "com.lopecode.brain.echo.say", price: "0.25" });
  await rig.owner("quota.put", { who: "owner", daily: 0.3 });
  const lines = await logged(async () => {
    await rig.owner("echo.say", {}, { "x-brain-ray": "ray-price-1" });
    await rig.owner("echo.say", {}, { "x-brain-ray": "ray-price-2" });
  });
  const mine = lines.filter((l) => l.at === "call" && String(l.ray).startsWith("ray-price-")).sort((a, b) => (a.ray < b.ray ? -1 : 1));
  expect(mine.map((l) => [l.status, l.error, l.price, l.rule, l.by])).toEqual([[200, null, 0.25, "allow", "manifest"], [402, "OutOfCredits", 0.25, "allow", "manifest"]]);
  return "200 then 402, each with the price";
}
// %%
test_a_delegation_is_made_in_a_persons_own_session_for_a_worker_the_owner_deployed = {
  const rig = await coreRig();
  const ADA = "did:plc:ada", B = "com.lopecode.brain.";
  await rig.as("kernel", "")("people.sync", { people: [{ did: ADA, methods: [B + "echo.read"] }] });
  await rig.deployer("service.register", { worker: "brain-m-ada-notes", role: "member", author: ADA, keyHash: "ada", paths: [], secrets: [], methods: {} });
  const make = (as, more = {}) => as("delegation.create", { name: "push", holder: { worker: "brain-x-echo" }, scope: ["echo.say"], ...more });
  // The owner in their session. Not a turn, a PDS call, a Worker or nobody; nor a DID that is not a member.
  const made = await make(rig.owner, { note: "orders, pushed to echo.say", daily: 0.5 });
  expect(made.data).toMatchObject({ name: "push", from: "owner", holder: { worker: "brain-x-echo" }, scope: [B + "echo.say"], caps: [], until: null, daily: 0.5, parent: null, by: "session" });
  expect(made.data.id).toMatch(/^[0-9a-f]{12}$/);
  for (const as of [rig.as("owner", "turn:7"), rig.as("owner", "jwt"), rig.as("owner", "delegation:" + made.data.id), rig.worker, rig.anonymous, rig.as("did:plc:stranger")]) expect((await make(as, { name: "other" })).status).toBe(401);
  // What is refused: a second of the name, a member's Worker, a secret or a DID holder, a cap, a part of a name, and
  // what only a session reaches.
  const bad = [{}, { name: "Push 2" }, { name: "a", holder: { worker: "brain-m-ada-notes" } }, { name: "a", holder: { worker: "brain-x-none" } }, { name: "a", holder: { secret: "x" } }, { name: "a", holder: { did: ADA } }, { name: "a", caps: ["session"] }, { name: "a", scope: ["ech*"] }, { name: "a", scope: [] }, { name: "a", scope: ["secret.get"] }, { name: "a", scope: ["delegation.*"] }, { name: "a", scope: ["infra.apply"] }, { name: "a", until: 5 }, { name: "a", daily: -1 }];
  for (const more of bad) expect([JSON.stringify(more), (await make(rig.owner, more)).status]).toEqual([JSON.stringify(more), 400]);
  // A member makes one for what they may call: the list every member has, a member's method, and their grant.
  const ada = rig.as(ADA);
  expect((await make(ada, { scope: ["echo.read", "blob.*", "m.0a.shop.receive", "*"] })).data).toMatchObject({ from: ADA, scope: [B + "echo.read", B + "blob.*", B + "m.0a.shop.receive", B + "*"] });
  expect([(await make(ada, { name: "more", scope: ["echo.say"] })).status, (await make(ada, { name: "more", scope: ["echo.*"] })).status]).toEqual([403, 403]);
  // The owner reads all, a member their own; each revokes their own, and the owner any.
  const list = async (as) => (await as("delegation.list")).data.delegations.map((d) => [d.from, d.name, d.spentToday]).sort();
  expect([await list(rig.owner), await list(ada)]).toEqual([[[ADA, "push", 0], ["owner", "push", 0]], [[ADA, "push", 0]]]);
  expect((await rig.as("owner", "turn:7")("delegation.list")).status).toBe(401);
  expect((await ada("delegation.revoke", { id: made.data.id })).data).toEqual({ revoked: false });
  const hers = (await ada("delegation.list")).data.delegations[0].id;
  expect([(await rig.owner("delegation.revoke", { id: hers })).data, (await rig.owner("delegation.revoke", { id: "nope" })).data, await list(ada)]).toEqual([{ revoked: true, id: hers }, { revoked: false }, []]);
  return "made by a session, for a system Worker";
}
// %%
test_a_token_is_a_delegation_with_a_secret_holder_that_the_kernel_resolves = {
  const heard = [], B = "com.lopecode.brain.", ADA = "did:plc:ada";
  const hear = async (request) => {
    if (request.url.endsWith(".getInfo")) return Response.json({ name: "brain-x-shop", hash: "h", calls: [] });
    heard.push(Object.fromEntries(["caller", "via", "tab", "holder", "origin", "origin-tab", "hops"].map((h) => [h, request.headers.get("x-brain-" + h)])));
    return Response.json({ ok: true });
  };
  const config = {}, rig = await coreRig({ config, workers: { shop: hear } }), kernel = rig.as("kernel", "");
  await rig.deployer("service.register", { worker: "brain-x-shop", role: "recipe", paths: [], secrets: [], hash: "h", keyHash: await sha256("shop-key"), methods: { [B + "shop.receive"]: { type: "procedure", who: "owner" }, [B + "shop.tab"]: { type: "procedure", who: "anyone", allow: "caller.session" }, [B + "shop.paid"]: { type: "procedure", who: "owner", price: "0.04" } } });
  await kernel("people.sync", { people: [{ did: ADA, methods: [] }] });
  const make = (body) => rig.owner("delegation.create", { holder: { secret: true }, ...body });
  // The secret is answered once. The row has its hash, and no list has the secret.
  const t = (await make({ name: "laptop", scope: ["shop.receive", "shop.tab", "shop.paid"], daily: 0.05 })).data;
  expect([/^[0-9a-f]{64}$/.test(t.secret), t.holder, t.caps, t.from]).toEqual([true, { secret: await sha256(t.secret) }, [], "owner"]);
  expect(JSON.stringify([(await rig.owner("delegation.list")).data, [...rig.sim.rows]])).not.toContain(t.secret);
  // The kernel asks whose secret it was sent. Nobody else does, and a hash nobody made gives nothing.
  expect((await kernel("delegation.resolve", { sha256: t.holder.secret })).data.delegation).toMatchObject({ id: t.id, name: "laptop", from: "owner", scope: [B + "shop.receive", B + "shop.tab", B + "shop.paid"] });
  expect([(await rig.owner("delegation.resolve", { sha256: t.holder.secret })).status, (await rig.worker("delegation.resolve", { sha256: t.holder.secret })).status, (await kernel("delegation.resolve", { sha256: "0".repeat(64) })).data, (await kernel("delegation.resolve", {})).data]).toEqual([401, 401, { delegation: null }, { delegation: null }]);
  // The kernel passes the call on with the id. It is the owner's, and not in their tab, whatever else the kernel said.
  const sent = (id) => (m, body) => rig.as("token:laptop", "session")(m, body, { "x-brain-delegation": id });
  expect((await sent(t.id)("shop.receive", {})).status).toBe(200);
  expect(heard.at(-1)).toMatchObject({ caller: "owner", via: "delegation:" + t.id, tab: "0", holder: "secret:laptop", origin: "owner", "origin-tab": "0" });
  // A rule reads the token's name, as it did of a token made before.
  await rig.owner("rule.put", { target: B + "shop.tab", allow: 'caller.token == "laptop" && caller.holder == "secret:laptop"' });
  expect((await sent(t.id)("shop.tab", {})).status).toBe(200);
  await rig.owner("rule.put", { target: B + "shop.tab", allow: "caller.session" });
  // Not the session guard of a rule or of the core, not out of its scope, and never a delegation method.
  expect([(await sent(t.id)("shop.tab", {})).status, (await sent(t.id)("rule.list")).status, (await sent(t.id)("delegation.list")).status, (await sent("0123456789ab")("shop.receive", {})).status]).toEqual([401, 403, 403, 401]);
  // Only the kernel's key sends the header: from a Worker it is not read, and the Worker is itself.
  expect((await rig.send("https://core.internal", { "x-brain-key": "echo-key", "x-brain-delegation": t.id })("shop.receive", {})).status).toBe(401);
  // The owner pays, and daily is the most it spends in a day.
  expect([(await sent(t.id)("shop.paid", {})).status, (await sent(t.id)("shop.paid", {})).status, (await rig.owner("quota.list")).data.accounts.map((a) => [a.who, a.spent])]).toEqual([200, 402, [["owner", 0.04]]]);
  // Caps are a secret holder's. With session it is the owner's own tab. unattended goes with the other two.
  expect([(await make({ name: "x", scope: ["*"], caps: ["unattended", "deploy"] })).status, (await make({ name: "x", scope: ["*"], caps: ["root"] })).status, (await make({ name: "x", scope: ["*"], caps: ["deploy", "deploy"] })).status, (await rig.owner("delegation.create", { name: "x", holder: { worker: "brain-x-echo" }, scope: ["*"], caps: ["session"] })).status, (await make({ name: "x", scope: ["secret.get"] })).status, (await rig.as(ADA)("delegation.create", { name: "x", holder: { secret: true }, scope: ["static.get"] })).status]).toEqual([400, 400, 400, 400, 400, 403]);
  const button = (await make({ name: "button", scope: ["shop.*"], caps: ["deploy", "unattended", "session"], until: Date.now() + 3600000, note: "sign-in link" })).data;
  expect([(await sent(button.id)("shop.tab", {})).status, heard.at(-1).tab, heard.at(-1)["origin-tab"], (await sent(button.id)("delegation.create", { name: "y", holder: { secret: true }, scope: ["*"] })).status]).toEqual([200, "1", "1", 403]);
  // The cap session and *: an ordinary method is reached, not in the owner's tab; a session method is not reached.
  const short = (await make({ name: "short", scope: ["com.lopecode.*", "com.*"], caps: ["session"] })).data;
  expect([(await sent(short.id)("shop.receive", {})).status, (await sent(short.id)("shop.tab", {})).status, (await sent(short.id)("config.list")).status]).toEqual([200, 401, 401]);
  await rig.owner("delegation.revoke", { id: short.id });
  const star = (await make({ name: "star", scope: ["*"], caps: ["session"] })).data, named = (await make({ name: "named", scope: ["*", "shop.tab"], caps: ["session"] })).data;
  expect([(await sent(star.id)("shop.receive", {})).status, heard.at(-1).tab, (await sent(star.id)("shop.tab", {})).status, (await sent(star.id)("config.list")).status, (await sent(named.id)("shop.tab", {})).status]).toEqual([200, "0", 401, 401, 200]);
  for (const d of [star, named]) await rig.owner("delegation.revoke", { id: d.id });
  // A link made only to deploy names no method, so it reaches none here.
  const ship = (await make({ name: "ship", scope: [], caps: ["deploy"] })).data;
  expect([ship.scope, (await sent(ship.id)("shop.receive", {})).status]).toEqual([[], 403]);
  // A name is one of the maker's, until it is revoked. Revoked, the hash finds nothing.
  expect((await make({ name: "laptop", scope: ["*"] })).status).toBe(400);
  expect((await rig.owner("delegation.revoke", { id: t.id })).data).toEqual({ revoked: true, id: t.id });
  expect([(await kernel("delegation.resolve", { sha256: t.holder.secret })).data, (await sent(t.id)("shop.receive", {})).status, (await make({ name: "laptop", scope: ["*"] })).status]).toEqual([{ delegation: null }, 401, 200]);
  // A token from before: the kernel hands over the hash it has. The same hash again is the same row; a name that
  // is taken is kept apart; nobody but the kernel does it.
  const HASH = await sha256("made-before"), old = { sha256: HASH, name: "laptop", scope: [B + "shop.receive"], caps: ["deploy"], until: null, created: 5, note: "sign-in link" };
  const moved = (await kernel("delegation.adopt", old)).data;
  expect([moved.name, moved.from, moved.holder, moved.caps, moved.created, moved.by, (await kernel("delegation.adopt", old)).data.id, (await kernel("delegation.resolve", { sha256: HASH })).data.delegation.id]).toEqual(["laptop-" + moved.id.slice(0, 4), "owner", { secret: HASH }, ["deploy"], 5, "moved", moved.id, moved.id]);
  expect([(await sent(moved.id)("shop.receive", {})).status, (await rig.owner("delegation.adopt", old)).status, (await kernel("delegation.adopt", { ...old, caps: ["root"] })).status]).toEqual([200, 401, 400]);
  await rig.owner("delegation.revoke", { id: moved.id });
  // Ended, it is refused, and it goes when the owner makes another.
  config.clockSkewMs = 2 * 3600000;
  expect((await sent(button.id)("shop.receive", {})).status).toBe(403);
  await make({ name: "next", scope: ["*"] });
  expect([(await rig.owner("delegation.list")).data.delegations.map((d) => d.name).sort(), (await kernel("delegation.resolve", { sha256: button.holder.secret })).data]).toEqual([["laptop", "next", "ship"], { delegation: null }]);
  return "a secret holder: resolved by the kernel only, the owner's call, the owner's tab with the cap session";
}
// %%
test_a_worker_calls_under_a_delegation_as_who_made_it_and_not_in_their_tab = {
  const heard = [], B = "com.lopecode.brain.", ADA = "did:plc:ada";
  const hear = (worker) => async (request) => {
    if (request.url.endsWith(".getInfo")) return Response.json({ name: "brain-x-" + worker, hash: "h", calls: [] });
    heard.push({ worker, ...Object.fromEntries(["caller", "via", "tab", "holder", "origin", "origin-via", "origin-tab", "origin-holder", "hops", "context", "member"].map((h) => [h, request.headers.get("x-brain-" + h)])) });
    return Response.json({ ok: true });
  };
  const config = {}, rig = await coreRig({ config, workers: { shop: hear("shop"), sink: hear("sink") } });
  await rig.deployer("service.register", { worker: "brain-x-shop", role: "recipe", paths: [], secrets: [], hash: "h", keyHash: await sha256("shop-key"), methods: { [B + "shop.receive"]: { type: "procedure", who: "owner" }, [B + "shop.tab"]: { type: "procedure", who: "anyone", allow: "caller.session" }, [B + "shop.paid"]: { type: "procedure", who: "owner", price: "0.04" }, [B + "shop.whose"]: { type: "procedure", who: "anyone", allow: 'caller.holder == "worker:brain-x-echo" && caller.delegation != "" && caller.kind == "owner"' } } });
  await rig.deployer("service.register", { worker: "brain-x-sink", role: "recipe", paths: [], secrets: [], hash: "h", keyHash: await sha256("sink-key"), methods: { [B + "sink.take"]: { type: "procedure", who: "anyone", allow: "origin.session" }, [B + "sink.any"]: { type: "procedure", who: "anyone" } } });
  await rig.as("kernel", "")("people.sync", { people: [{ did: ADA, methods: [B + "shop.receive"] }] });
  const d = (await rig.owner("delegation.create", { name: "push", holder: { worker: "brain-x-echo" }, scope: ["shop.*", "rule.put", "sink.any"], daily: 0.05 })).data;
  const held = (id, hops) => rig.send("https://core.internal", { "x-brain-key": "echo-key", "x-brain-as": id, ...(hops === undefined ? {} : { "x-brain-hops": String(hops) }), "x-brain-caller": "did:plc:forged", "x-brain-via": "session", "x-brain-context": "c1.forged.forged" });
  const echo = held(d.id);
  // The call is the owner's, not in their tab, with the holder named. It begins a chain: origin is the owner too.
  expect((await echo("shop.receive", {})).status).toBe(200);
  expect(heard.at(-1)).toMatchObject({ worker: "shop", caller: "owner", via: "delegation:" + d.id, tab: "0", holder: "worker:brain-x-echo", origin: "owner", "origin-via": "delegation:" + d.id, "origin-tab": "0", "origin-holder": "worker:brain-x-echo", hops: "1" });
  // A rule reads the holder and the delegation. caller.session is false, and so is the core's own session guard.
  expect([(await echo("shop.whose", {})).status, (await echo("shop.tab", {})).status, (await echo("rule.put", { target: B + "shop.receive", allow: "true" })).status]).toEqual([200, 401, 401]);
  // Not in the scope; never a holder's, whatever the scope; a path; another Worker with the same id; no such id.
  const wide = (await rig.owner("delegation.create", { name: "wide", holder: { worker: "brain-x-echo" }, scope: ["*"] })).data;
  expect([(await echo("echo.say", {})).status, (await held(wide.id)("secret.get?name=X")).status, (await held(wide.id)("delegation.list")).status, (await held(wide.id)("delegation.create", { name: "x", holder: { worker: "brain-x-echo" }, scope: ["*"] })).status, (await held(wide.id)("/hooks/echo")).status]).toEqual([403, 403, 403, 403, 403]);
  expect([(await rig.send("https://core.internal", { "x-brain-key": "shop-key", "x-brain-as": d.id })("shop.receive", {})).status, (await held("0123456789ab")("shop.receive", {})).status, (await held("../route/brain")("shop.receive", {})).status]).toEqual([403, 403, 403]);
  // The kernel cannot name a delegation: x-brain-as is read from a Worker's key only.
  expect((await rig.as("anonymous", "")("shop.receive", {}, { "x-brain-as": d.id })).status).toBe(401);
  // It is not held to the holder's own calls: the scope is the bound. Without x-brain-as the same Worker is.
  await rig.owner("calls.setMode", { mode: "enforce" });
  expect([(await echo("shop.receive", {})).status, (await rig.worker("shop.receive", {})).status]).toEqual([200, 403]);
  // A Worker that answers such a call and calls on: the origin is the owner under the delegation, not in their tab,
  // and the chain is as long as it was.
  const on = rig.send("https://core.internal", { "x-brain-key": "shop-key", "x-brain-context": heard.at(-1).context });
  await rig.owner("calls.setMode", { mode: "report" });
  expect([(await on("sink.take", {})).status, (await on("sink.any", {})).status]).toEqual([401, 200]);
  expect(heard.at(-1)).toMatchObject({ worker: "sink", caller: "worker:brain-x-shop", tab: "0", origin: "owner", "origin-via": "delegation:" + d.id, "origin-tab": "0", "origin-holder": "worker:brain-x-echo", hops: "1" });
  // A chain from the owner's session is in their tab all the way, as before.
  await rig.owner("shop.receive", {});
  expect(heard.at(-1)).toMatchObject({ caller: "owner", via: "session", tab: "1", holder: null, "origin-tab": "1", hops: "0" });
  expect((await rig.send("https://core.internal", { "x-brain-key": "shop-key", "x-brain-context": heard.at(-1).context })("sink.take", {})).status).toBe(200);
  // A holder that pushes on says how long the chain is; the ninth is refused.
  expect([(await held(d.id, 7)("shop.receive", {})).status, heard.at(-1).hops, (await held(d.id, 8)("shop.receive", {})).status, (await held(d.id, -1)("shop.receive", {})).status, (await held(d.id, "x")("shop.receive", {})).status]).toEqual([200, "8", 403, 403, 403]);
  // Money: the owner pays, and the delegation's daily amount is the most it spends in a day.
  expect([(await echo("shop.paid", {})).status, (await echo("shop.paid", {})).status]).toEqual([200, 402]);
  expect((await rig.owner("quota.list")).data.accounts.map((a) => [a.who, a.spent])).toEqual([["owner", 0.04]]);
  // The ledger has the one charge once.
  expect(((l) => [l.total, l.byWho, l.charges.length])((await rig.owner("quota.ledger")).data)).toEqual([0.04, [{ who: "owner", cost: 0.04 }], 1]);
  // A call the owner's own allowance refuses is not in the delegation's count.
  const poor = (await rig.owner("delegation.create", { name: "poor", holder: { worker: "brain-x-echo" }, scope: ["shop.paid"], daily: 1 })).data;
  await rig.owner("quota.put", { who: "owner", daily: 0.05 });
  expect([(await held(poor.id)("shop.paid", {})).status, (await rig.owner("delegation.list")).data.delegations.find((x) => x.name === "poor").spentToday]).toEqual([402, 0]);
  await rig.owner("quota.put", { who: "owner", daily: null });
  await rig.owner("delegation.revoke", { id: poor.id });
  expect((await rig.owner("delegation.list")).data.delegations.map((x) => [x.name, x.spentToday]).sort()).toEqual([["push", 0.04], ["wide", 0]]);
  // A member's: the caller is the member, and what the member may not call now, it does not reach.
  const ada = (await rig.as(ADA)("delegation.create", { name: "mine", holder: { worker: "brain-x-echo" }, scope: ["shop.receive"] })).data;
  expect((await held(ada.id)("shop.receive", {})).status).toBe(200);
  expect(heard.at(-1)).toMatchObject({ caller: ADA, via: "delegation:" + ada.id, tab: "0", origin: ADA, member: "1" });
  await rig.as("kernel", "")("people.sync", { people: [{ did: ADA, methods: [] }] });
  expect((await held(ada.id)("shop.receive", {})).status).toBe(403);
  await rig.as("kernel", "")("people.sync", { people: [] });
  expect((await held(ada.id)("shop.receive", {})).status).toBe(403);
  // Added again, they have no delegation: what they made went when they were removed.
  await rig.as("kernel", "")("people.sync", { people: [{ did: ADA, methods: [B + "shop.receive"] }] });
  expect([(await held(ada.id)("shop.receive", {})).status, (await rig.as(ADA)("delegation.list")).data.delegations]).toEqual([403, []]);
  // Ended, and revoked: the next call is refused.
  const brief = (await rig.owner("delegation.create", { name: "brief", holder: { worker: "brain-x-echo" }, scope: ["shop.receive"], until: Date.now() + 60000 })).data;
  expect((await held(brief.id)("shop.receive", {})).status).toBe(200);
  expect((await rig.owner("delegation.revoke", { id: d.id })).data.revoked).toBe(true);
  expect([(await echo("shop.receive", {})).status, (await held(wide.id)("shop.receive", {})).status]).toEqual([403, 200]);
  config.clockSkewMs = 120000;
  expect([(await held(brief.id)("shop.receive", {})).status, (await held(wide.id)("shop.receive", {})).status]).toEqual([403, 200]);
  return heard.length + " calls heard";
}
// %%
import {cloudflare, rows, workers, deployer, config, hono, decide, callerOf, ruleExpression, checkedRule, cel, settings, simulate, sha256, xrpc, backend, logged, matches, may, MEMBER, neverHeld, scoped} from "@tomlarkworthy/cloudflare-iac"
// %%
import {expect} from "@tomlarkworthy/jest-expect-standalone"
// %%
import {plugins} from "@tomlarkworthy/plugin-registry"
