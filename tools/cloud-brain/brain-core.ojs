test_a_members_worker_spends_its_authors_credits = {
  const rig = await memberCoreRig(), { A, W } = rig;
  rig.sim.env.X_B = { fetch: rig.hear("b") };
  const P = "com.lopecode.brain.";
  await rig.deployer("service.register", { worker: "brain-x-b", role: "recipe", methods: { [P + "b.who"]: { type: "procedure", who: "owner", price: "0.04" } }, paths: [], secrets: [], hash: "h", keyHash: await sha256("b-key") });
  await rig.sync([{ did: A, methods: [P + "b.who"] }]);
  const todo = rig.send("https://core.internal", { "x-brain-key": "todo-key" });
  expect([(await todo("b.who", {})).status, (await todo("b.who", {})).status, (await todo("b.who", {})).status]).toEqual([200, 200, 402]);
  const day = (await rig.owner("quota.list")).data.accounts;
  expect(day.map((a) => [a.who, a.spent])).toEqual([[A, 0.08], ["owner", 0]]);
  expect((await rig.owner("quota.ledger")).data.charges[0]).toMatchObject({ who: A, caller: A, origin: `${A} (worker:${W})`, counted: true });
  return "the author pays";
}
// %%
test_one_log_line_a_call_with_these_keys_and_no_secret = {
  const rig = await coreRig();
  const KEYS = ["at", "by", "caller", "delegation", "error", "holder", "method", "ms", "origin", "price", "ray", "rule", "status", "via", "worker"];
  const ray = (n) => ({ "x-brain-ray": "ray-keys-" + n });
  const lines = await logged(async () => {
    // Secret-looking text in a parameter, a header, a body, a path and a method name nobody declared.
    await rig.owner("echo.say?code=SEKRET-PARAM", { password: "SEKRET-BODY" }, { ...ray(1), "x-api-key": "SEKRET-HEADER", cookie: "s=SEKRET-COOKIE" });
    await rig.anonymous("echo.say", { n: 1 }, ray(2));
    await rig.owner("rule.put", { target: "com.lopecode.brain.echo.read", allow: "caller.session" }, ray(3));
    await rig.owner("/not/declared/SEKRET-PATH", undefined, ray(8));
    await rig.anonymous("echo.read?token=SEKRET-PARAM", undefined, ray(4));
    await rig.as("owner", "token")("echo.key", undefined, ray(5));
    await rig.worker("nobody.SEKRET-NSID", {}, ray(6));
    await rig.owner("/hooks/echo?sig=SEKRET-PARAM", "SEKRET-BODY", ray(7));
  });
  const mine = lines.filter((l) => l.at === "call" && String(l.ray).startsWith("ray-keys-")).sort((a, b) => (a.ray < b.ray ? -1 : 1));
  expect(mine.length).toBe(8);
  for (const l of mine) expect(Object.keys(l).sort()).toEqual(KEYS);
  expect(JSON.stringify(mine)).not.toMatch(/SEKRET|password|code=|token=|sig=/);
  const pick = (l) => [l.caller, l.via, l.origin, l.method, l.worker, l.status, l.error, l.rule, l.by];
  expect(mine.map(pick)).toEqual([
    ["owner", "session", "owner", "echo.say", "brain-x-echo", 200, null, "allow", "manifest"],
    ["anonymous", "", "anonymous", "echo.say", "brain-x-echo", 401, "AuthRequired", "deny", "manifest"],
    ["owner", "session", "owner", "rule.put", "brain-core", 200, null, "allow", "core"],
    ["anonymous", "", "anonymous", "echo.read", "brain-x-echo", 401, "AuthRequired", "deny", "owner"],
    ["owner", "token", "owner", "echo.key", "brain-x-echo", 200, null, "allow", "fixed"],
    ["worker:brain-x-echo", "", "worker:brain-x-echo", "(unknown)", "brain-core", 501, "MethodNotImplemented", "", "core"],
    ["owner", "session", "owner", "/hooks/echo", "brain-x-echo", 200, null, "allow", "manifest"],
    ["owner", "session", "owner", "(unknown)", "brain-core", 404, null, "", "core"]
  ]);
  expect(mine.every((l) => typeof l.ms === "number" && l.price === null)).toBe(true);
  return mine.length + " lines, " + KEYS.length + " keys each";
}
