test_the_logged_method_is_named_by_what_is_declared_not_by_the_status = {
  const rig = await coreRig();
  await rig.owner("calls.setMode", { mode: "enforce" });
  const lines = await logged(async () => {
    // A method of the core that answers 404 keeps its name. A name nobody declared, refused before routing, does not.
    await rig.owner("rule.put", { target: "com.lopecode.brain.nobody.x", allow: "true" }, { "x-brain-ray": "ray-name-1" });
    await rig.worker("nobody.SEKRET-NSID", {}, { "x-brain-ray": "ray-name-2" });
  });
  const mine = lines.filter((l) => l.at === "call" && String(l.ray).startsWith("ray-name-")).sort((a, b) => (a.ray < b.ray ? -1 : 1));
  expect(mine.map((l) => [l.method, l.status, l.by])).toEqual([["rule.put", 404, "core"], ["(unknown)", 403, "calls"]]);
  return "rule.put 404 by name, an undeclared name 403 as (unknown)";
}
// %%
test_a_posted_body_reaches_the_service_whole = {
  const rig = await coreRig();
  // With a content-length the core reads the body before it sends it on (bodyOf); without one it passes the stream.
  const body = JSON.stringify({ text: "x".repeat(5000) });
  expect((await rig.owner("echo.say", body, { "content-length": String(body.length) })).status).toBe(200);
  expect((await rig.owner("echo.say", body)).status).toBe(200);
  expect(rig.seen.slice(-2).map((s) => s.body)).toEqual([body, body]);
  return "5013 characters in, 5013 out, both ways";
}
