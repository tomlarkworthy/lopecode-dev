test_settings_are_stored_by_the_owner_and_sent_with_each_forwarded_call = {
  const got = [], logged = [];
  const workers = {
    conf: async (request) => {
      if (new URL(request.url).pathname === "/xrpc/_config") return Response.json({ worker: "brain-x-conf", read: [{ key: "pollMs", value: 60000, from: "stored" }] });
      got.push(JSON.parse(decodeURIComponent(request.headers.get("x-brain-settings"))));
      return Response.json({ ok: true });
    }
  };
  // settingsMs 0: this instance reads the rows on every call, as another instance does after 60 s.
  const rig = await coreRig({ config: { settingsMs: 0 }, workers });
  await rig.deployer("service.register", { worker: "brain-x-conf", role: "recipe", methods: { "com.lopecode.brain.conf.go": { type: "procedure", who: "owner" } }, paths: [], secrets: [], keyHash: "conf" });
  const set = (who, body) => who("config.set", body);
  const S = { worker: "brain-x-conf", key: "pollMs", value: 60000 };
  // The owner's own session, and nobody else: a member, a token, a Worker, a caller with no account.
  for (const who of [rig.as("did:plc:member"), rig.as("token:laptop", ""), rig.as("owner", "turn:1"), rig.worker, rig.anonymous]) expect((await set(who, S)).status).toBe(401);
  expect((await rig.as("did:plc:member")("config.list")).status).toBe(401);
  expect((await rig.anonymous("config.get?worker=brain-x-conf")).status).toBe(401);
  await rig.owner("conf.go", {});
  expect(got.pop()).toEqual({});
  const log = console.log;
  console.log = (line) => void (line && line.at === "config" ? logged.push(line) : null);
  try {
    expect((await set(rig.owner, S)).data).toEqual({ ...S, old: null });
    expect((await set(rig.owner, { ...S, value: 45000 })).data).toEqual({ ...S, value: 45000, old: 60000 });
  } finally {
    console.log = log;
  }
  expect(logged.map((l) => [l.worker, l.key, l.old, l.value, l.by])).toEqual([["brain-x-conf", "pollMs", null, 60000, "owner"], ["brain-x-conf", "pollMs", 60000, 45000, "owner"]]);
  await rig.owner("conf.go", {});
  expect(got.pop()).toEqual({ pollMs: 45000 });
  // A name set at deploy, a name that is not one, a value that is not plain, a Worker that takes none.
  const refused = (await rig.owner("config.list")).data.protected;
  expect(refused.length).toBe(12);
  for (const key of refused) expect((await set(rig.owner, { ...S, key })).status).toBe(400);
  for (const body of [{ ...S, key: "a.b" }, { ...S, key: "__proto__" }, { ...S, value: { a: 1 } }, { ...S, value: "x".repeat(501) }, { ...S, value: [1] }]) expect((await set(rig.owner, body)).status).toBe(400);
  for (const worker of ["brain", "brain-core", "brain-deployer", "brain-x-none"]) expect((await set(rig.owner, { ...S, worker })).status).toBe(404);
  const seen = (await rig.owner("config.get?worker=brain-x-conf")).data;
  expect(seen.values).toEqual({ pollMs: 45000 });
  expect(seen.changes.map((c) => [c.by, c.key, c.old, c.value])).toEqual([["owner", "pollMs", null, 60000], ["owner", "pollMs", 60000, 45000]]);
  expect(seen.read).toEqual([{ key: "pollMs", value: 60000, from: "stored" }]);
  expect((await rig.owner("config.list")).data.workers).toEqual([{ worker: "brain-x-conf", values: { pollMs: 45000 } }]);
  // null removes the key, and the Worker is sent none.
  expect((await set(rig.owner, { ...S, value: null })).data).toEqual({ ...S, value: null, old: 45000 });
  await rig.owner("conf.go", {});
  expect(got.pop()).toEqual({});
  expect((await rig.owner("config.list")).data.workers).toEqual([]);
  // 8 KB as sent: text that is not ASCII is six bytes a character in the header.
  for (let i = 0; i < 2; i++) expect((await set(rig.owner, { ...S, key: "note" + i, value: "é".repeat(500) })).status).toBe(200);
  expect((await set(rig.owner, { ...S, key: "note2", value: "é".repeat(500) })).status).toBe(400);
  // A Worker that is removed takes its settings and their log with it.
  await rig.deployer("service.unregister", { worker: "brain-x-conf" });
  expect((await rig.owner("config.list")).data.workers).toEqual([]);
  await rig.deployer("service.register", { worker: "brain-x-conf", role: "recipe", methods: { "com.lopecode.brain.conf.go": { type: "procedure", who: "owner" } }, paths: [], secrets: [], keyHash: "conf" });
  expect((await rig.owner("config.get?worker=brain-x-conf")).data).toMatchObject({ values: {}, changes: [] });
  // The default: an instance keeps the rows 60 s, and config.set drops its copy, so the next call carries the change.
  const kept = await coreRig({ workers });
  await kept.deployer("service.register", { worker: "brain-x-conf", role: "recipe", methods: { "com.lopecode.brain.conf.go": { type: "procedure", who: "owner" } }, paths: [], secrets: [], keyHash: "conf" });
  await kept.owner("conf.go", {});
  expect(got.pop()).toEqual({});
  await set(kept.owner, S);
  await kept.owner("conf.go", {});
  expect(got.pop()).toEqual({ pollMs: 60000 });
  return "set, sent, changed, removed; 5 callers and 22 requests refused";
}
