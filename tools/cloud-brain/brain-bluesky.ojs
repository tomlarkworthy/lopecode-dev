test_bluesky_strangers_are_limited_over_all = {
  const rig = await blueskyRig();
  for (let i = 0; i < 25; i++) rig.say("did:plc:s" + i, "hi");
  await rig.poll();
  expect(rig.net.sent.length).toBe(20);
  expect(rig.sim.inbox.length).toBe(0);
  return "20 answers an hour over all DIDs";
