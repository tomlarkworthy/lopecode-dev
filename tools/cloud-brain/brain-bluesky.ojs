test_bluesky_reads_direct_messages_sent_after_it_started = {
  const rig = await blueskyRig({ known: ["did:plc:ada"] });
  rig.say("did:plc:ada", "from last week", { at: Date.now() - 7 * 86400000 });
  rig.net.groups.set("g-ada", { name: "Friends", members: ["did:plc:ada", "did:plc:third"] });
  rig.say("did:plc:ada", "to a group the owner is not in", { convo: "g-ada" });
  rig.net.events.push({ n: rig.net.events.length + 1, log: { $type: "chat.bsky.convo.defs#logBeginConvo", rev: "r", convoId: "c-did:plc:ada" } });
  rig.net.events.push({ n: rig.net.events.length + 1, log: { $type: "chat.bsky.convo.defs#logCreateMessage", rev: "r", convoId: "c-did:plc:ada", message: { $type: "chat.bsky.convo.defs#deletedMessageView", id: "gone", rev: "r", sender: { did: "did:plc:ada" }, sentAt: new Date().toISOString() } } });
  const id = rig.say("did:plc:ada", "look", { embed: { $type: "app.bsky.embed.record#view", record: { $type: "app.bsky.embed.record#viewRecord", uri: "at://did:plc:x/app.bsky.feed.post/3k" } } });
  expect(await rig.poll()).toEqual({ configured: true, events: 5, taken: 1 });
  expect(rig.bodies()).toEqual([["bluesky", "bsky:" + id, "did:plc:ada", "look\n[post: at://did:plc:x/app.bsky.feed.post/3k]"]]);
  // A stranger in a group is not answered there either.
  rig.net.groups.set("g-zed", { name: "Strangers", members: ["did:plc:zed", "did:plc:third"] });
  rig.say("did:plc:zed", "hi all", { convo: "g-zed" });
  await rig.poll();
  expect(rig.net.sent).toEqual([]);
  return "1 entry of 5 events: old, group, begin and deleted are passed over";
}
