// %%
test_bluesky_tick_and_poll_deliver_once = {
  const rig = await blueskyRig({ known: ["did:plc:ada"], pageSize: 2 });
  for (const t of ["one", "two", "three", "four", "five"]) rig.say("did:plc:ada", t);
  // The tick and a tab's poll at the same moment: one of them reads, the other finds a poll running.
  const [, polled] = await Promise.all([rig.tick(), rig.poll()]);
  expect(rig.bodies().map((b) => b[3])).toEqual(["one", "two", "three", "four", "five"]);
  expect(rig.rows.get("cursor")).toBe("5");
  expect(rig.net.asked.filter((a) => a.nsid.endsWith("getLog")).length).toBe(4);
  expect(polled.skipped === "a poll is running" ? "tick" : "page").toBe(rig.rows.get("polled").by);
  // The cursor is kept between calls: the next one asks for what follows it and finds nothing.
  rig.net.asked.length = 0;
  expect(await rig.poll()).toEqual({ configured: true, events: 0, taken: 0 });
  expect(rig.net.asked.map((a) => a.nsid)).toEqual(["chat.bsky.convo.getLog"]);
  // A page read twice, as when a poll stops before it keeps the cursor, appends nothing twice.
  rig.rows.set("cursor", "2");
  expect(await rig.poll()).toEqual({ configured: true, events: 3, taken: 3 });
  expect(rig.sim.inbox.length).toBe(5);
  expect(rig.rows.get("cursor")).toBe("5");
  return "5 messages over 3 pages, read 1.6 times, 5 entries";
}
