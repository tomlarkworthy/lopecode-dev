test_bluesky_no_tab_notice_once_an_hour_each = {
  const rig = await blueskyRig({ held: false, known: ["did:plc:ada"] });
  rig.say("did:plc:owner", "anyone there?");
  rig.say("did:plc:ada", "hi");
  rig.say("did:plc:ada", "hello?");
  await rig.poll();
  const notice = "No Brain tab is open, so this waits until one is. https://brain.example/";
  expect(rig.net.sent.map((s) => [s[0], s[1]])).toEqual([["did:plc:owner", notice], ["did:plc:ada", notice]]);
  rig.say("did:plc:ada", "now?");
  await rig.poll();
  expect(rig.net.sent.length).toBe(2);
  rig.rows.set("quiet/did:plc:ada", Date.now() - 3600001);
  rig.say("did:plc:ada", "and now?");
  await rig.poll();
  expect(rig.net.sent.length).toBe(3);
  expect(rig.sim.inbox.length).toBe(5);
  return "1 notice per person for 4 messages, another after an hour";
}
// %%
test_bluesky_split_keeps_graphemes_whole = {
  const family = "👨‍👩‍👧‍👦";
  const parts = blueskySplit(family.repeat(2500));
  expect(parts.map((p) => [...new Intl.Segmenter().segment(p)].length)).toEqual([400, 400, 400, 400, 400, 400, 100]);
  expect(parts.every((p) => new TextEncoder().encode(p).length <= 10000)).toBe(true);
  expect(parts.join("")).toBe(family.repeat(2500));
  // Cut where the text pauses, when a pause falls in the second half of what fits.
  const prose = ("word ".repeat(150).trim() + "\n\n").repeat(3).trim();
  expect(blueskySplit(prose).map((p) => p.length)).toEqual([749, 749, 749]);
  expect(blueskySplit("a".repeat(1500) + " b").map((p) => p.length)).toEqual([1000, 502]);
  expect(blueskySplit("  short  ")).toEqual(["short"]);
  expect(blueskySplit("   ")).toEqual([]);
  const text = "é see https://a.example/x?y=1, and (http://b.example).";
  expect(blueskyFacets(text).map((f) => [f.features[0].uri, new TextDecoder().decode(new TextEncoder().encode(text).slice(f.index.byteStart, f.index.byteEnd))])).toEqual([["https://a.example/x?y=1", "https://a.example/x?y=1"], ["http://b.example", "http://b.example"]]);
  return "1000 graphemes and 10000 bytes a message";
}
