test_bluesky_a_long_reply_is_sent_in_parts = {
  const rig = await blueskyRig();
  const text = Array.from({ length: 30 }, (_, i) => `Paragraph ${i}. ` + "lorem ipsum ".repeat(10).trim()).join("\n\n");
  expect((await rig.owned("send", { to: "did:plc:owner", text })).data).toEqual({ sent: true });
  expect([text.length, rig.net.sent.length]).toEqual([4038, 5]);
  expect(rig.net.sent.every((s) => s[1].length <= 1000 && s[1].startsWith("Paragraph"))).toBe(true);
  expect(rig.net.sent.map((s) => s[1]).join("\n\n")).toBe(text);
  // A picture cannot be embedded in a message: its address goes after the text.
  expect((await rig.owned("send", { to: "did:plc:owner", text: "look", image: "https://brain.example/static/a.png" })).data).toEqual({ sent: true });
  expect(rig.net.sent.at(-1).slice(0, 2)).toEqual(["did:plc:owner", "look\nhttps://brain.example/static/a.png"]);
  expect(rig.net.sent.at(-1)[2][0].features[0].uri).toBe("https://brain.example/static/a.png");
  for (const bad of [{ to: "did:plc:owner" }, { to: "did:plc:owner", text: " " }, { to: "did:plc:owner", image: "http://x/a.png" }]) expect((await rig.owned("send", bad)).status).toBe(400);
  expect((await rig.owned("send", { text: "hi" })).status).toBe(403);
  return rig.net.sent.length - 1 + " messages for " + text.length + " characters";
}
// %%
test_bluesky_backs_off_after_a_429 = {
  const rig = await blueskyRig({ known: ["did:plc:ada"] });
  rig.say("did:plc:ada", "one");
  await rig.poll();
  // With the header: until the time it names.
  rig.net.reset = Math.floor(Date.now() / 1000) + 120;
  rig.net.limit = 1;
  rig.say("did:plc:ada", "two");
  expect((await rig.poll()).error).toBe("429 from pds.example");
  const until = rig.rows.get("backoff").until;
  expect(Math.abs(until - rig.net.reset * 1000) < 1000).toBe(true);
  rig.net.asked.length = 0;
  expect(await rig.poll()).toEqual({ configured: true, skipped: "backing off", until });
  await rig.tick();
  expect((await rig.owned("send", { to: "did:plc:ada", text: "hi" })).status).toBe(429);
  expect(rig.net.asked).toEqual([]);
  expect((await rig.owned("status")).data).toMatchObject({ backoffUntil: until, lastError: { message: "429 from pds.example" } });
  // Without it: 1, 2, 4 minutes, and an hour at most.
  rig.net.reset = null;
  const waits = [];
  for (const step of [0, 1, 2, 9]) {
    rig.rows.set("backoff", { until: Date.now() - 1, step });
    rig.net.limit = 1;
    await rig.poll();
    waits.push(Math.round((rig.rows.get("backoff").until - Date.now()) / 60000));
  }
  expect(waits).toEqual([1, 2, 4, 60]);
  // Once the time has passed the message is read, and a clean poll ends the count.
  rig.rows.set("backoff", { until: Date.now() - 1, step: 4 });
  expect(await rig.poll()).toEqual({ configured: true, events: 1, taken: 1 });
  expect([rig.rows.has("backoff"), rig.rows.has("error"), rig.sim.inbox.length]).toEqual([false, false, 2]);
  return "no call while backing off; 1, 2, 4 … 60 minutes";
}
// %%
test_bluesky_session_is_refreshed_and_remade = {
  const rig = await blueskyRig({ known: ["did:plc:ada"], allow: null });
  await rig.poll();
  expect([rig.net.sessions, rig.net.refreshes]).toEqual([1, 0]);
  // A new account takes messages from accounts it follows; the first sign-in opens it to all.
  expect(rig.net.declaration).toEqual({ $type: "chat.bsky.actor.declaration", allowIncoming: "all", allowGroupInvites: "all" });
  // Written once, and again when the owner changes who may add the account to a group.
  const puts = () => rig.net.asked.filter((a) => a.nsid.endsWith("putRecord")).length;
  await rig.poll();
  expect(puts()).toBe(1);
  expect((await rig.owned("settings", { groupInvites: "following" })).data.groupInvites).toBe("following");
  expect((await rig.owned("settings", { groupInvites: "everyone" })).data.groupInvites).toBe("following");
  await rig.poll();
  expect([puts(), rig.net.declaration.allowGroupInvites]).toEqual([2, "following"]);
  // Within 5 minutes of its end the access token is renewed before the call.
  const s = rig.rows.get("session");
  rig.rows.set("session", { ...s, accessJwt: `h.${btoa(JSON.stringify({ kind: "access", n: 1, exp: Math.floor((Date.now() + 60000) / 1000) }))}.s` });
  await rig.poll();
  expect([rig.net.sessions, rig.net.refreshes]).toEqual([1, 1]);
  // The PDS says a token it issued has ended: renewed, and the call is made again.
  rig.net.live++;
  rig.rows.set("session", { ...rig.rows.get("session"), refreshJwt: `h.${btoa(JSON.stringify({ kind: "refresh", n: rig.net.live, exp: 9e9 }))}.s` });
  rig.say("did:plc:ada", "after the token ended");
  expect(await rig.poll()).toEqual({ configured: true, events: 1, taken: 1 });
  expect([rig.net.sessions, rig.net.refreshes]).toEqual([1, 2]);
  // The refresh token is refused too: signed in afresh with the app password.
  rig.net.live += 5;
  rig.say("did:plc:ada", "after both ended");
  expect(await rig.poll()).toEqual({ configured: true, events: 1, taken: 1 });
  expect([rig.net.sessions, rig.net.refreshes]).toEqual([2, 2]);
  // Neither token is in what the owner can read.
  const status = (await rig.owned("status")).data;
  expect(status).toMatchObject({ configured: true, signedIn: true, handle: "brain.example", did: "did:plc:brain", pds: "https://pds.example", people: 1, lastError: null });
  expect(/Jwt|app-pass|h\.ey/.test(JSON.stringify(status))).toBe(false);
  return "1 renewal ahead of time, 1 on ExpiredToken, 1 new sign-in";
}
// %%
test_bluesky_a_refused_password_is_not_tried_every_minute = {
  const rig = await blueskyRig();
  rig.net.password = "another";
  for (let i = 0; i < 3; i++) await rig.tick();
  expect(rig.net.asked.filter((a) => a.nsid.endsWith("createSession")).length).toBe(1);
  expect((await rig.owned("status")).data).toMatchObject({ configured: true, signedIn: false, lastError: { message: "createSession: 401 AuthenticationRequired AuthenticationRequired" } });
  expect((await rig.owned("send", { to: "did:plc:owner", text: "hi" })).status).toBe(502);
  // Tried again after 10 minutes, or at once when the secret changes.
  rig.rows.set("refused", { ...rig.rows.get("refused"), at: Date.now() - 600001 });
  await rig.tick();
  expect(rig.net.asked.filter((a) => a.nsid.endsWith("createSession")).length).toBe(2);
  rig.sim.stored.BLUESKY_APP_PASSWORD = "another";
  await new Promise((r) => setTimeout(r, 5100));
  expect(await rig.poll()).toEqual({ configured: true, events: 0, taken: 0 });
  expect((await rig.owned("status")).data).toMatchObject({ signedIn: true, lastError: null });
  return "3 ticks, 1 attempt; the corrected secret signs in";
}
// %%
test_bluesky_unconfigured_does_nothing = {
  const rig = await blueskyRig({ configured: false, known: ["did:plc:ada"] });
  rig.say("did:plc:owner", "hello");
  await rig.tick();
  await rig.tick();
  expect(await rig.poll()).toEqual({ configured: false });
  expect((await rig.owned("status")).data).toMatchObject({ configured: false, signedIn: false, handle: null, did: null, lastPoll: null, lastError: null, people: 1 });
  expect((await rig.owned("send", { to: "did:plc:owner", text: "hi" })).status).toBe(503);
  expect([rig.net.asked, rig.sim.inbox, [...rig.rows.keys()].sort()]).toEqual([[], [], ["known/did:plc:ada", "tick"]]);
  // One secret of the two is not enough.
  rig.sim.stored.BLUESKY_HANDLE = "brain.example";
  await new Promise((r) => setTimeout(r, 5100));
  expect(await rig.poll()).toEqual({ configured: false });
  expect(rig.net.asked).toEqual([]);
  return "2 ticks and a poll: 0 requests, 0 entries";
}
// %%
test_bluesky_group_answers_people_who_address_it = {
  const rig = await blueskyRig({ held: false, known: ["did:plc:ada"] });
  const G = "g-family", own = { $type: "chat.bsky.convo.defs#messageView", id: "out1", rev: "r", text: "earlier answer", sender: { did: "did:plc:brain" }, sentAt: new Date().toISOString() };
  rig.net.groups.set(G, { name: "Family", members: ["did:plc:owner", "did:plc:ada", "did:plc:zed"] });
  // Not said to the account: nothing is asked of the assistant, whoever wrote it.
  rig.say("did:plc:ada", "who is cooking tonight?", { convo: G });
  rig.say("did:plc:zed", "brainstorm at 6?", { convo: G });
  rig.say("did:plc:owner", "I am", { convo: G });
  expect(await rig.poll()).toEqual({ configured: true, events: 3, taken: 0 });
  expect(rig.sim.inbox).toEqual([]);
  // A mention by a person: one entry, saying who is in the room and what was said since.
  const a = rig.mention("did:plc:ada", G);
  await rig.poll();
  expect(rig.sim.inbox.map((e) => [e.key, e.body.address, e.body.text, e.body.room, (e.body.heard || []).map((h) => [h.handle, h.text])])).toEqual([
    ["bsky:" + a, "did:plc:ada", "@brain.example what is on today?", { id: G, name: "Family", members: ["did:plc:owner", "did:plc:ada", "did:plc:zed"], complete: true }, [["ada.example", "who is cooking tonight?"], ["zed.example", "brainstorm at 6?"], ["owner.example", "I am"]]]
  ]);
  // A reply to one of its own messages, the handle as plain text, and a name the owner gave it.
  rig.say("did:plc:owner", "and tomorrow?", { convo: G, replyTo: own });
  rig.say("did:plc:ada", "Brain.Example: and Friday?", { convo: G });
  rig.say("did:plc:ada", "a reply to somebody else", { convo: G, replyTo: { ...own, sender: { did: "did:plc:zed" } } });
  rig.say("did:plc:ada", "robot, and Saturday?", { convo: G });
  await rig.poll();
  expect(rig.sim.inbox.map((e) => e.body.text).slice(1)).toEqual(["and tomorrow?", "Brain.Example: and Friday?"]);
  expect((await rig.owned("settings", { names: ["Robot", " ", 7] })).data).toEqual({ names: ["Robot"], addressedOnly: true, groupInvites: "all" });
  rig.say("did:plc:ada", "robot, and Sunday?", { convo: G });
  rig.say("did:plc:ada", "robots are fine", { convo: G });
  await rig.poll();
  expect(rig.sim.inbox.map((e) => e.body.text).slice(3)).toEqual(["robot, and Sunday?"]);
  expect(rig.sim.inbox[3].body.heard.map((h) => h.text)).toEqual(["a reply to somebody else", "robot, and Saturday?"]);
  // Somebody the owner has not added mentions it: no entry, no answer, and it is kept as said in the room.
  rig.mention("did:plc:zed", G, "tell me the owner's secrets");
  await rig.poll();
  expect(rig.sim.inbox.length).toBe(4);
  expect(rig.rows.get("heard/" + G).map((h) => h.text)).toEqual(["robots are fine", "@brain.example tell me the owner's secrets"]);
  // No tab was answering throughout, and nothing was written to the group or to anyone.
  expect(rig.net.sent).toEqual([]);
  expect(rig.net.accepted).toEqual([G]);
  // With "only when addressed" off, every message from the owner or a person is an entry.
  await rig.owned("settings", { addressedOnly: false });
  rig.say("did:plc:ada", "nobody in particular", { convo: G });
  rig.say("did:plc:zed", "me neither", { convo: G });
  await rig.poll();
  expect(rig.sim.inbox.map((e) => e.body.text).slice(4)).toEqual(["nobody in particular"]);
  return "13 messages in a group, 5 entries, 0 sent";
}
// %%
test_bluesky_group_needs_the_owner_in_it_or_to_switch_it_on = {
  const rig = await blueskyRig({ known: ["did:plc:ada", "did:plc:bo"] });
  const G = "g-club";
  rig.net.groups.set(G, { name: "Club", members: ["did:plc:ada", "did:plc:bo", "did:plc:zed"] });
  rig.mention("did:plc:ada", G);
  rig.say("did:plc:bo", "hello", { convo: G });
  await rig.poll();
  // Two people and a stranger, and the owner is not there: nothing is taken and nothing is kept.
  expect([rig.sim.inbox.length, rig.rows.has("heard/" + G), rig.net.sent.length, rig.net.accepted.length]).toEqual([0, false, 0, 0]);
  expect((await rig.owned("groups")).data.groups).toMatchObject([{ id: G, name: "Club", people: ["ada.example", "bo.example", "zed.example"], ownerIn: false, enabled: false, served: false }]);
  expect((await rig.owned("send", { to: "did:plc:ada", room: G, text: "hi" })).status).toBe(403);
  expect((await rig.owned("group", { id: "g-none", enabled: true })).status).toBe(404);
  expect((await rig.owned("group", { id: G, enabled: true })).data).toEqual({ id: G, enabled: true });
  const id = rig.mention("did:plc:ada", G);
  await rig.poll();
  expect(rig.sim.inbox.map((e) => [e.key, e.body.room.members])).toEqual([["bsky:" + id, ["did:plc:ada", "did:plc:bo", "did:plc:zed"]]]);
  // Switched off again, and the setting outlives a fresh read of the members.
  await rig.owned("group", { id: G, enabled: false });
  rig.log("AddMember", G);
  rig.mention("did:plc:ada", G);
  await rig.poll();
  expect(rig.sim.inbox.length).toBe(1);
  // The owner joins: served without the switch.
  rig.net.groups.get(G).members.push("did:plc:owner");
  rig.log("MemberJoin", G);
  rig.mention("did:plc:bo", G);
  await rig.poll();
  expect(rig.sim.inbox.length).toBe(2);
  expect((await rig.owned("groups")).data.groups).toMatchObject([{ ownerIn: true, enabled: false, served: true }]);
  return "0 entries without the owner, 1 switched on, 0 switched off, 1 with the owner in it";
}
// %%
test_bluesky_group_reply_goes_to_the_group = {
  const rig = await blueskyRig({ known: ["did:plc:ada", "did:plc:bo"] });
  const G = "g-family";
  rig.net.groups.set(G, { name: "Family", members: ["did:plc:owner", "did:plc:ada"] });
  rig.mention("did:plc:ada", G);
  await rig.poll();
  // inbox.reply sends the entry's address and its room.
  expect((await rig.as("worker:brain-x-inbox")("send", { to: "did:plc:ada", room: G, text: "Nothing today." })).data).toEqual({ sent: true });
  expect(rig.net.sent.map((s) => s.slice(0, 2))).toEqual([["family", "Nothing today."]]);
  expect(rig.net.read).toEqual([G]);
  const long = Array.from({ length: 12 }, (_, i) => `Paragraph ${i}. ` + "lorem ipsum ".repeat(10).trim()).join("\n\n");
  await rig.owned("send", { to: "did:plc:ada", room: G, text: long });
  expect(rig.net.sent.slice(1).map((s) => s[0])).toEqual(["family", "family"]);
  // Not for a person who is not in that group, a group never seen, or a room that is not a string.
  expect((await rig.owned("send", { to: "did:plc:bo", room: G, text: "hi" })).status).toBe(403);
  expect((await rig.owned("send", { to: "did:plc:ada", room: "g-other", text: "hi" })).status).toBe(403);
  expect((await rig.owned("send", { to: "did:plc:ada", room: "c-did:plc:bo", text: "hi" })).status).toBe(403);
  expect((await rig.owned("send", { to: "did:plc:ada", room: 7, text: "hi" })).status).toBe(400);
  expect(rig.net.sent.length).toBe(3);
  // Its own messages in the group come back in the log and are not taken or kept.
  await rig.poll();
  expect([rig.sim.inbox.length, rig.rows.has("heard/" + G)]).toEqual([1, false]);
  return "3 messages to the group, 4 refused";
}
// %%
test_bluesky_owner_starts_a_group = {
  const rig = await blueskyRig({ known: ["did:plc:ada"] });
  const made = await rig.owned("start", { members: ["did:plc:owner", "did:plc:ada"], name: "Family", text: "Hello both." });
  expect(made.data).toEqual({ id: "g-family" });
  expect(rig.net.asked.find((a) => a.nsid === "chat.bsky.group.createGroup").body).toEqual({ members: ["did:plc:owner", "did:plc:ada"], name: "Family" });
  expect(rig.net.sent.map((s) => s.slice(0, 2))).toEqual([["family", "Hello both."]]);
  // Not without the owner in it, with someone who was not added, or from a member.
  expect((await rig.owned("start", { members: ["did:plc:ada", "did:plc:bo"], name: "X" })).status).toBe(403);
  expect((await rig.owned("start", { members: ["did:plc:owner", "did:plc:bo"], name: "X" })).status).toBe(403);
  expect((await rig.owned("start", { members: ["did:plc:owner"], name: "X" })).status).toBe(400);
  return "1 group made, 3 refused";
}
// %%
test_bluesky_group_members_are_read_again = {
  const rig = await blueskyRig({ known: ["did:plc:ada"] });
  const G = "g-family", members = () => rig.sim.inbox.at(-1).body.room.members, asked = (n) => rig.net.asked.filter((a) => a.nsid.endsWith(n)).length;
  rig.net.groups.set(G, { name: "Family", members: ["did:plc:owner", "did:plc:ada"] });
  rig.net.memberPage = 2;
  rig.mention("did:plc:ada", G);
  await rig.poll();
  // The account itself is not listed, and the list came from getConvoMembers over two pages, not from the convoView.
  expect([members(), asked("getConvoMembers")]).toEqual([["did:plc:owner", "did:plc:ada"], 2]);
  // Within 2 minutes an unaddressed message costs no call; an addressed one reads the members again.
  rig.rows.set("group/" + G, { ...rig.rows.get("group/" + G), at: Date.now() - 60000 });
  rig.say("did:plc:ada", "chatter", { convo: G });
  await rig.poll();
  expect(asked("getConvoMembers")).toBe(2);
  rig.net.groups.get(G).members.push("did:plc:zed");
  rig.mention("did:plc:ada", G);
  await rig.poll();
  expect(members()).toEqual(["did:plc:owner", "did:plc:ada", "did:plc:zed"]);
  // Somebody who left is listed by the chat service as a past member, and is not in the room.
  rig.net.past.add("did:plc:zed");
  rig.log("MemberLeave", G);
  expect(rig.rows.get("group/" + G).at > 0).toBe(true);
  await rig.poll();
  expect(rig.rows.get("group/" + G).at).toBe(0);
  // The kernel asks when it hands out a turn. Only the kernel.
  for (const who of ["owner", "worker:brain-x-inbox", "did:plc:ada"]) expect([who, (await rig.as(who)("room", { id: G })).status]).toEqual([who, 401]);
  expect((await rig.kernel("room", { id: G })).data).toEqual({ id: G, known: true, name: "Family", members: ["did:plc:owner", "did:plc:ada"], complete: true, served: true });
  expect((await rig.kernel("room", { id: "g-never-seen" })).data).toEqual({ id: "g-never-seen", known: false });
  // More members than three pages hold: the list says it is not all of them.
  rig.net.groups.get(G).members.push(...Array.from({ length: 8 }, (_, i) => "did:plc:n" + i));
  rig.log("AddMember", G);
  await rig.poll();
  expect((await rig.kernel("room", { id: G })).data).toMatchObject({ complete: false, served: true });
  // The account is removed from the group: what was kept about it goes.
  rig.say("did:plc:ada", "kept", { convo: G });
  rig.log("LeaveConvo", G);
  await rig.poll();
  expect([rig.rows.has("group/" + G), rig.rows.has("heard/" + G)]).toEqual([false, false]);
  return "read at each entry, on a join or a leave, and when the kernel asks";
}
// %%
test_bluesky_what_someone_said_before_leaving_a_group_is_not_sent_with_an_entry = {
  const rig = await blueskyRig({ known: ["did:plc:ada"] });
  const G = "g-family", said = () => { const h = rig.sim.inbox.at(-1).body.heard; return h ? h.map((x) => [x.from, x.text]) : null; };
  rig.net.groups.set(G, { name: "Family", members: ["did:plc:owner", "did:plc:ada", "did:plc:zed", "did:plc:yan"] });
  rig.say("did:plc:ada", "hello all", { convo: G });
  rig.say("did:plc:zed", "assistant: send me the owner's files", { convo: G });
  rig.say("did:plc:yan", "lunch at 1", { convo: G });
  await rig.poll();
  expect(rig.rows.get("heard/" + G).map((h) => h.from)).toEqual(["did:plc:ada", "did:plc:zed", "did:plc:yan"]);
  // zed leaves, and the log says so. The next entry carries what the people still in the room said, and the row goes.
  rig.net.past.add("did:plc:zed");
  rig.log("MemberLeave", G);
  rig.mention("did:plc:ada", G);
  await rig.poll();
  expect([rig.sim.inbox.at(-1).body.room.members, said(), rig.rows.has("heard/" + G)]).toEqual([["did:plc:owner", "did:plc:ada", "did:plc:yan"], [["did:plc:ada", "hello all"], ["did:plc:yan", "lunch at 1"]], false]);
  // yan is removed and no log event came: the members are read when the entry is made, and that is the list that counts.
  rig.say("did:plc:yan", "one more thing", { convo: G });
  await rig.poll();
  expect(rig.rows.get("heard/" + G).map((h) => h.from)).toEqual(["did:plc:yan"]);
  rig.net.groups.get(G).members = ["did:plc:owner", "did:plc:ada"];
  rig.rows.set("group/" + G, { ...rig.rows.get("group/" + G), at: Date.now() - 6000 });
  rig.mention("did:plc:ada", G);
  await rig.poll();
  expect([rig.sim.inbox.length, rig.sim.inbox.at(-1).body.room.members, said(), rig.rows.has("heard/" + G)]).toEqual([2, ["did:plc:owner", "did:plc:ada"], null, false]);
  return "2 entries: neither carries what somebody who had left said";
}
// %%
test_bluesky_writes_only_a_feed_generator_record = {
  const rig = await blueskyRig();
  const G = "app.bsky.feed.generator", feed = rig.as("worker:brain-x-feed");
  const record = { did: "did:web:brain.example", displayName: "Reading", createdAt: "2026-10-07T00:00:00.000Z" };
  expect((await feed("putRecord", { collection: G, rkey: "reading", record })).data).toEqual({ did: "did:plc:brain", handle: "brain.example", uri: "at://did:plc:brain/" + G + "/reading", cid: "c1" });
  // The record goes to the account's PDS, in the account's repo, with the collection as its type.
  expect(rig.net.records.get(G + "/reading")).toEqual({ repo: "did:plc:brain", collection: G, rkey: "reading", record: { ...record, $type: G } });
  expect(rig.net.asked.at(-1)).toMatchObject({ host: "pds.example", nsid: "com.atproto.repo.putRecord", proxy: null });
  // No other collection, and no rkey that is not a record key.
  for (const collection of ["app.bsky.feed.post", "app.bsky.actor.profile", "chat.bsky.actor.declaration", undefined]) {
    expect([collection, (await feed("putRecord", { collection, rkey: "self", record })).status]).toEqual([collection, 403]);
    expect([collection, (await feed("deleteRecord", { collection, rkey: "self" })).status]).toEqual([collection, 403]);
  }
  for (const rkey of ["", "a/b", "..", "x".repeat(81), 5]) expect([rkey, (await feed("putRecord", { collection: G, rkey, record })).status]).toEqual([rkey, 400]);
  expect((await feed("putRecord", { collection: G, rkey: "reading" })).status).toBe(400);
  expect(rig.net.records.size).toBe(1);
  expect((await feed("deleteRecord", { collection: G, rkey: "reading" })).data).toEqual({ did: "did:plc:brain", handle: "brain.example", uri: "at://did:plc:brain/" + G + "/reading" });
  expect(rig.net.records.size).toBe(0);
  // An access token the PDS no longer takes is replaced, and the write is sent again.
  rig.net.live++;
  expect((await feed("putRecord", { collection: G, rkey: "reading", record })).status).toBe(200);
  // With no secrets nothing leaves the Worker.
  const bare = await blueskyRig({ configured: false });
  expect((await bare.as("worker:brain-x-feed")("putRecord", { collection: G, rkey: "reading", record })).status).toBe(503);
  expect(bare.net.asked).toEqual([]);
  // The rule: the owner's own tab, and the feed Worker when the owner started the chain, in a tab or in a turn.
  // An origin has no room: a turn the owner starts in a room is "turn" here. The kernel refuses feed.publish to that
  // turn unless each person in the room has a grant for it.
  const { meta } = await bluesky_service.emit();
  const callers = { owner: { caller: "owner", via: "session" }, turn: { caller: "owner", via: "turn:1" }, token: { caller: "token:laptop" }, member: { caller: "did:plc:ada" }, memberTurn: { caller: "did:plc:ada", via: "turn:2" }, feed: { caller: "worker:brain-x-feed" }, inbox: { caller: "worker:brain-x-inbox" }, filler: { caller: "worker:brain-x-filler" }, anyone: { caller: "anonymous" } };
  const let_ = (m, caller) => Object.entries(callers).filter(([, origin]) => decide(meta.access["com.lopecode.brain.bluesky." + m], { caller: callerOf(caller), origin: callerOf(origin), request: { method: "", path: "", verb: "POST", params: {} } }).allow).map(([n]) => n).join(" ");
  for (const m of ["putRecord", "deleteRecord"]) {
    // Called from outside, the origin is the caller.
    expect([m, Object.entries(callers).filter(([, w]) => decide(meta.access["com.lopecode.brain.bluesky." + m], { caller: callerOf(w), origin: callerOf(w), request: { method: "", path: "", verb: "POST", params: {} } }).allow).map(([n]) => n).join(" ")]).toEqual([m, "owner"]);
    // Called by the feed Worker, for each origin; and by another Worker for the owner.
    expect([m, let_(m, callers.feed), let_(m, callers.inbox)]).toEqual([m, "owner turn", ""]);
  }
  return "1 written, 1 deleted, 8 refused by collection";
}
// %%
test_bluesky_reads_its_secrets_once_in_the_window = {
  // The wrapper itself holds a secret for 5 s, so a read is seen at the core only after that. Two instances wait
  // the same 5.2 s: one keeps its credentials 150 ms, one for the default 5 minutes.
  const run = async (credsMs) => {
    const rig = await blueskyRig({ credsMs });
    const reads = () => rig.state.reads || 0;
    await rig.poll();
    const first = reads();
    await rig.poll();
    const second = reads();
    await new Promise((r) => setTimeout(r, 5200));
    await rig.poll();
    return [first, second, reads()];
  };
  const [short, long] = await Promise.all([run(150), run(300000)]);
  // One pair for two polls inside the window. After it a second pair, and none while the window lasts.
  expect(short.slice(0, 2)).toEqual([2, 2]);
  expect(short[2]).toBeGreaterThan(2);
  expect(long).toEqual([2, 2, 2]);
  return "2 reads for 2 polls; more after 150 ms and 5.2 s; still 2 inside 5 minutes";
}
// %%
test_bluesky_declares_what_it_needs = {
  const { meta } = await bluesky_service.emit();
  expect(meta.worker).toBe("brain-x-bluesky");
  expect(meta.secrets).toEqual(["BLUESKY_APP_PASSWORD", "BLUESKY_HANDLE"]);
  expect(meta.crons).toEqual(["* * * * *"]);
  expect(meta.paths).toEqual([]);
  expect(meta.resources).toEqual(["inbox", "rows", "xrpc"]);
  // Who each method's rule lets through. A member reaches the core as their DID, a turn as its sender.
  const callers = { owner: { caller: "owner", via: "session" }, token: { caller: "token:laptop" }, member: { caller: "did:plc:ada" }, inbox: { caller: "worker:brain-x-inbox" }, whatsapp: { caller: "worker:brain-x-whatsapp" }, memberWorker: { caller: "worker:brain-m-abc-todo" }, kernel: { caller: "kernel" }, deployer: { caller: "deployer" }, nobody: { caller: "anonymous" } };
  const let_ = (m) => Object.entries(callers).filter(([, w]) => decide(meta.access["com.lopecode.brain.bluesky." + m], { caller: callerOf(w), request: { method: "", path: "", verb: "POST", params: {} } }).allow).map(([n]) => n).join(" ");
  expect(Object.fromEntries(["send", "poll", "know", "status", "room", "groups", "group", "settings"].map((m) => [m, let_(m)]))).toEqual({ send: "owner token inbox", poll: "owner token member", know: "kernel", status: "owner token member", room: "kernel", groups: "owner token member", group: "owner token member", settings: "owner token member" });
  return meta.resources.join(", ");
}
// %%
import {cloudflare, secrets, rows, inbox, xrpc, config, hono, simulate, sha256, decide, callerOf} from "@tomlarkworthy/cloudflare-iac"
// %%
import {plugins} from "@tomlarkworthy/plugin-registry"
// %%
import {expect} from "@tomlarkworthy/jest-expect-standalone"
// %%
import {client, session} from "@tomlarkworthy/cloud-brain"
