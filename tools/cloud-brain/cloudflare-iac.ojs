// %%
// Makes each kind of call to the core, after a wait, so two requests can overlap.
fx_chain = cloudflare.Service(
  "chain",
  async (request) => {
    const q = new URL(request.url).searchParams;
    if (q.get("wait")) await new Promise((r) => setTimeout(r, Number(q.get("wait"))));
    await xrpc.query("com.lopecode.brain.fx.who", { tag: q.get("tag") || "" });
    if (q.get("all")) {
      await secrets.FX_CHAIN;
      await sql.exec("SELECT 1");
      await inbox.append({ key: "k" });
      await xrpc.fetch("com.lopecode.brain.fx.raw", { method: "POST", body: "b" });
    }
    return new Response("ok");
  },
  { calls: ["com.lopecode.brain.fx.who", "com.lopecode.brain.fx.raw"], crons: ["* * * * *"], scheduled: async () => void (await xrpc.query("com.lopecode.brain.fx.who", { tag: "cron" })) }
)
// %%
test_the_wrapper_passes_the_origin_reference_on = {
  const heard = [];
  const core = async (request) => {
    const u = new URL(request.url), nsid = u.pathname.replace("/xrpc/com.lopecode.brain.", "");
    heard.push({ nsid, context: request.headers.get("x-brain-context"), tag: u.searchParams.get("tag") });
    return Response.json(nsid === "secret.get" ? { name: "FX_CHAIN", value: "v" } : nsid === "db.sql" ? { results: [{ rows: [], changes: 0 }] } : { ok: true });
  };
  const sim = await simulate(fx_chain, { core });
  const ask = (query, headers = {}) => sim.fetch("https://chain.internal/?" + query, { headers });
  const took = () => heard.splice(0).map((h) => [h.nsid, h.context]);
  const O = { "x-brain-context": "c-owner", "x-brain-origin": "owner", "x-brain-origin-via": "session" }, M = { "x-brain-context": "c-member", "x-brain-origin": "did:plc:m" };
  // Every call made while the Worker answers one carries the reference that came with it.
  await ask("all=1", O);
  expect(took()).toEqual([["fx.who", "c-owner"], ["secret.get", "c-owner"], ["db.sql", "c-owner"], ["inbox.append", "c-owner"], ["fx.raw", "c-owner"]]);
  // A call that came with none passes none on. The secret is asked again: it was held for the owner.
  await ask("all=1");
  expect(took()).toEqual([["fx.who", null], ["secret.get", null], ["db.sql", null], ["inbox.append", null], ["fx.raw", null]]);
  // Held for 5 s for one origin; another origin asks again.
  await ask("all=1", O);
  expect(took().map((h) => h[0])).toEqual(["fx.who", "db.sql", "inbox.append", "fx.raw"]);
  await ask("all=1", M);
  expect(took().filter((h) => h[0] === "secret.get")).toEqual([["secret.get", "c-member"]]);
  // The schedule answers nobody.
  await sim.scheduled();
  expect(heard.splice(0)).toEqual([{ nsid: "fx.who", context: null, tag: "cron" }]);
  // Two at once. A browser has no AsyncLocalStorage, so under simulate neither passes a reference on: none, never the other's.
  await Promise.all([ask("wait=30&tag=slow", O), ask("wait=5&tag=fast", M)]);
  expect(heard.splice(0).map((h) => [h.tag, h.context])).toEqual([["fast", null], ["slow", null]]);
  // The schedule while a call is answered does not take that call's reference.
  await Promise.all([ask("wait=20&tag=slow", O), sim.scheduled()]);
  expect(heard.splice(0).map((h) => [h.tag, h.context])).toEqual([["cron", null], ["slow", null]]);
  await ask("tag=after", M);
  expect(took()).toEqual([["fx.who", "c-member"]]);
  return "passed on; none for a schedule; none when two overlap";
}
