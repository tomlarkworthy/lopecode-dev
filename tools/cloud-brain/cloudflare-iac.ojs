// Names two bindings and its own key as secrets, and lists what a Hono service is handed as env.
fx_reach = cloudflare.Service(
  "fxreach",
  new hono.Hono().get("/", async (c) => c.json({ env: Object.keys(c.env), SQL: typeof (await secrets.SQL), CORE: typeof (await secrets.CORE), BRAIN_KEY: typeof (await secrets.BRAIN_KEY), T: await secrets.T }))
)
// %%
test_a_service_reads_its_secrets_and_no_other_binding = {
  const sim = await simulate(fx_reach, { secrets: { T: "bound", BRAIN_KEY: "k" } });
  // Every name read is in the manifest, which the approval page lists.
  expect(sim.emitted.meta.secrets).toEqual(["BRAIN_KEY", "CORE", "SQL", "T"]);
  expect(typeof sim.env.SQL).toBe("object");
  const got = await (await sim.fetch("https://fxreach.internal/")).json();
  // The database and the core are bindings, and BRAIN_KEY is the Worker's own key: named as secrets, they read as unset.
  expect(got).toEqual({ env: ["BRAIN_INFO"], SQL: "undefined", CORE: "undefined", BRAIN_KEY: "undefined", T: "bound" });
  // SQL and CORE are asked of the core as any secret that is not bound, and the core holds none of that name.
  expect(sim.calls.filter((c) => c.nsid === "com.lopecode.brain.secret.get").map((c) => c.data.name)).toEqual(["SQL", "CORE"]);
  // A name that is not in the manifest is not answered from a binding and not asked of the core.
  const bare = await simulate(fx_reach, { secrets: { T: "bound" }, info: { secrets: [] } });
  expect((await (await bare.fetch("https://fxreach.internal/")).json()).T).toBe(undefined);
  expect(bare.calls).toEqual([]);
  return got.env.join(" ");
}
