test_a_service_declared_with_the_old_name_emits_the_same = {
  const [o, n] = [await fx_named_old.emit(), await fx_named_new.emit()];
  expect(o.meta).toEqual(n.meta);
  expect(o.parts.map((p) => p.path)).toEqual(n.parts.map((p) => p.path));
  // The cell's own text is part of worker.js, so the word and the cell's name differ there and nowhere else.
  const same = (text) => text.replaceAll("fx_named_old", "fx_named").replaceAll("fx_named_new", "fx_named").replace("cloudflare.Worker(", "cloudflare.Service(");
  expect(same(o.parts[0].text)).toBe(same(n.parts[0].text));
  expect(o.hash === n.hash).toBe(false);
  return "same meta, same code but for the word";
}
