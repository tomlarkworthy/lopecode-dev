      return new Response(r.body, { status: r.status, statusText: r.statusText, headers, webSocket: r.webSocket });
    };
    const self = {
      async fetch(request, env, ctx) {
        ENV = env;
        return stamp(await self.answer(request, env, ctx));
      },
      async answer(request, env, ctx) {
        const url = new URL(request.url);
        const role = info().role || "recipe";
        const edge = role === "kernel" || role === "deployer" || role === "guard";
        const inside = url.hostname.endsWith(".internal");
        // x-brain-guard: the header a deployer from before 2026-10-08 sends.
        const keyed = !inside && !!env.BRAIN_KEY && (request.headers.get("x-brain-deployer") === env.BRAIN_KEY || request.headers.get("x-brain-guard") === env.BRAIN_KEY);
        // Only the kernel and the deployer answer the internet. Every other Worker answers bindings, and the deployer
        // presenting that Worker's own key. A caller on the internet cannot name itself.
        if (!inside) {
          const headers = new Headers(request.headers);
          for (const name of [...headers.keys()]) if (name.startsWith("x-brain-")) headers.delete(name);
          if (keyed) headers.set("x-brain-caller", "deployer");
          request = new Request(request, { headers });
          // A browser drops cookie from a Request it builds; under simulate() put it back.
          if (env.__sim) Object.defineProperty(request, "headers", { value: headers });
        }
        // A Worker with a scheduled function is ticked by an alarm on its rows object as well as by its cron, once a
        // minute, starting from the first request to its own address. Measured 2026-10-05: cron triggers set through
        // the API had run 0 times after 30 minutes, and a rollback was missed.
        if (inside && takesSettings() && request.headers.has("x-brain-settings")) (stored = settingsFrom(request.headers.get("x-brain-settings"))), (storedAt = Date.now());
        // What this instance has read from config since it started, and where each value comes from. For the core's config.get.
        if (inside && url.pathname === "/xrpc/_config") return json({ worker: info().name, read: [...configRead].sort().map((key) => ({ key, ...configOf(key) })) });
        if (keyed && url.pathname === "/__tick") {
          // GET: when the alarm is next due and how its last call went.
          if (request.method === "GET") return json(await rowsCall("armInfo"));
          const service = await load();
          if (service.options.scheduled) await settingsForTick();
          if (service.options.scheduled) await during(null, async () => service.options.scheduled({ alarm: true }, ctx));
          return json({ ok: true });
        }
        if (!inside && !armed && env.ROWS && !env.__sim) {
          armed = true;
          ctx.waitUntil(load().then((s) => (s.options.scheduled ? rowsCall("arm", url.origin) : null)).catch(() => void (armed = false)));
        }
        if (url.pathname === "/xrpc/_health")
          return inside || edge || keyed ? json({ ok: true, name: info().name, hash: info().hash }) : new Response("not found", { status: 404 });
        const asked = url.searchParams.get("worker");
        // Every Worker describes itself: its manifest, and the module it was emitted from. Both are public; a
        // Worker that does not answer the internet is reached for them through the kernel and the core.
        const describes = url.pathname === "/xrpc/com.lopecode.brain.getInfo" ? "info" : url.pathname === "/xrpc/com.lopecode.brain.getSource" ? "source" : null;
        // part=reference: the module's prose cells, which hold its method tables, as text.
        if (describes === "source" && url.searchParams.get("part") === "reference" && request.method === "GET" && (!asked || asked === info().name) && (inside || edge || keyed))
          return new Response(referenceOf(source ? source.text : ""), { headers: { "content-type": "text/plain; charset=utf-8", "access-control-allow-origin": "*" } });
        if (describes && request.method === "GET" && (!asked || asked === info().name) && (inside || edge || keyed))
          return new Response(JSON.stringify(describes === "info" ? info() : { worker: info().name, hash: info().hash, module: source ? source.module : null, text: source ? source.text : null }), {
            headers: { "content-type": "application/json", "access-control-allow-origin": "*" }
          });
        if (!inside && !edge && !keyed) return new Response("not found", { status: 404 });
        try {
          const fn = (await load()).fn;
          // Headers named x-brain- were removed above from a call that did not come over a binding.
          const context = request.headers.get("x-brain-context");
          // The ray: cf-ray on a call from the internet, x-brain-ray on a call over a binding, which has no cf-ray.
          const ray = (request.headers.get("x-brain-ray") || request.headers.get("cf-ray") || "").slice(0, 64);
          const store = context || ray ? { context, origin: request.headers.get("x-brain-origin") || "", via: request.headers.get("x-brain-origin-via") || "", ray } : null;
          const out = await during(store, async () =>
            typeof fn?.fetch === "function"
              ? // Not env: it holds every binding. The manifest is the one thing a service reads from it (the core, its hash).
                await fn.fetch(request, { BRAIN_INFO: info() }, ctx)
              : await fn(request, { caller: request.headers.get("x-brain-caller") || "anonymous", ctx, info: info(), source })
          );
          if (!(out instanceof Response)) throw new Error("the function did not return a Response");
          return out;
        } catch (e) {
          // The line that says where a call that answered 500 threw: Workers Logs keeps it with the trace of the call.
          // The error's name and the frames of its stack. Not its message: a message can quote what the caller sent
          // (JSON.parse: Unexpected token 'S', "SEKRET" is not valid JSON).
          const frames = String(e?.stack || "").split("\n").filter((l) => /^\s+at /.test(l)).join("\n").slice(0, 2000);
          console.error({ at: "throw", worker: info().name || "", ray: (request.headers.get("x-brain-ray") || request.headers.get("cf-ray") || "").slice(0, 64), error: String(e?.name || "Error").slice(0, 80), stack: frames });
          return json({ error: "InternalServerError", message: String(e?.message || e) }, 500);
        }
      },
      async scheduled(event, env, ctx) {
        ENV = env;
        const service = await load();
        if (service.options.scheduled) await settingsForTick();
        if (service.options.scheduled) await during(null, async () => service.options.scheduled(event, ctx));
      }
    };
    return self;
  };
  class Rows {
    constructor(state, env) {
      this.storage = state.storage;
      this.env = env;
    }
    // Calls the Worker this object belongs to, on its own address, with that Worker's key, and sets the next alarm.
    async alarm() {
      const origin = await this.storage.get("__tick_origin");
      await this.storage.setAlarm(Date.now() + 60000);
      if (!origin) return;
      const at = Date.now();
      const last = await globalThis
        .fetch(origin + "/__tick", { method: "POST", headers: { "x-brain-deployer": this.env.BRAIN_KEY || "" } })
        .then(async (r) => ({ at, status: r.status, body: r.ok ? undefined : (await r.text()).slice(0, 120) }), (e) => ({ at, error: String((e && e.message) || e) }));
      await this.storage.put("__tick_last", last);
    }
    async fetch(request) {
      const { op, key, value } = await request.json();
      const s = this.storage;
      if (op === "get") return Response.json({ value: (await s.get(key)) ?? null });
      if (op === "put") return await s.put(key, value), Response.json({ value: true });
      if (op === "delete") return Response.json({ value: await s.delete(key) });
      if (op === "list")
        return Response.json({ value: [...(await s.list({ prefix: key }))].filter(([k]) => !k.startsWith("__tick_")).map(([key, value]) => ({ key, value })) });
      if (op === "armInfo") return Response.json({ value: { origin: (await s.get("__tick_origin")) ?? null, alarm: await s.getAlarm(), last: (await s.get("__tick_last")) ?? null, now: Date.now() } });
      if (op === "arm") {
        await s.put("__tick_origin", key);
        if ((await s.getAlarm()) === null) await s.setAlarm(Date.now() + 60000);
        return Response.json({ value: true });
      }
      if (op === "putIfAbsent") {
        if ((await s.get(key)) !== undefined) return Response.json({ value: false });
        return await s.put(key, value), Response.json({ value: true });
      }
      if (op === "increment") {
        const n = ((await s.get(key)) || 0) + 1;
        return await s.put(key, n), Response.json({ value: n });
      }
      if (op === "append") {
        const list = [...((await s.get(key)) || []), value.item].slice(-(value.max || 1000));
        return await s.put(key, list), Response.json({ value: list.length });
      }
      if (op === "deletePrefix") {
        const keys = [...(await s.list({ prefix: key })).keys()].filter((k) => !k.startsWith("__tick_"));
        for (let i = 0; i < keys.length; i += 128) await s.delete(keys.slice(i, i + 128));
        return Response.json({ value: keys.length });
      }
      return Response.json({ value: null }, { status: 400 });
    }
  }
  return { platform, fetch, serve, Rows };
}
// %%
// Compatibility flags the wrapper needs. The deployer sets them on every Worker; a service does not declare them.
wrapperFlags = ["nodejs_als"]
// %%
// Names a chased cell may not depend on: they exist only in a notebook.
notebookOnly = new Set([
  "md", "html", "svg", "tex", "htl", "dot", "mermaid", "Inputs", "Plot", "d3", "width", "now", "invalidation",
  "visibility", "DOM", "Files", "Generators", "Promises", "FileAttachment", "Mutable", "require", "Library",
  "SQLite", "DuckDBClient", "vl", "aq", "Arrow", "L", "topojson", "_", "@variable", "viewof", "main", "runtime"
])
// %%
sha256 = async (text) =>
  [...new Uint8Array(await crypto.subtle.digest("SHA-256", new TextEncoder().encode(text)))]
    .map((b) => b.toString(16).padStart(2, "0"))
    .join("")
// %%
// What a deploy is compared by. The deployer recomputes it from what it was sent.
partsHash = (parts, meta) => sha256(JSON.stringify({ parts, meta }))
// %%
// What a deploy sends for an emitted service: its module's source and that module's attached files, as this page holds
// them. The deployer distils that; the parts made here are for the tests and for showing a hash before a deploy.
asSource = (emitted, doc = globalThis.document) => {
  const names = /new Map\(\[([^\]]*)\]\.map\(\(name\)/.exec(emitted.source.text);
  const files = {};
  for (const name of names ? JSON.parse("[" + names[1] + "]") : []) {
    const node = doc && doc.getElementById(emitted.source.module + "/" + name);
    if (node) files[name] = node.textContent;
  }
  return { module: emitted.source.module, source: emitted.source.text, files };
}
// %%
// Walks the runtime's variable graph from the cell holding `service` and writes a plain ES module.
emit = async (service) => {
  // An imported name is an alias variable whose one input lives in the exporting module.
  const follow = (v) => {
    while ((v._inputs || []).length === 1 && v._inputs[0]._module && v._inputs[0]._module !== v._module)
      v = v._inputs[0];
    return v;
  };
  // Another module's import of the service holds the same value, and can come first in the runtime's order:
  // on 2026-10-06 09:30 the core was emitted with the page's module as its source.
  const held = [...runtime._variables].find((v) => v._value === service);
  if (!held) throw new Error(`cloudflare.Service("${service.name}") is not the value of a cell`);
  const root = follow(held);
  const refuse = (cell, why) => {
    throw new Error(`cannot deploy "${service.name}": cell "${cell}" ${why}`);
  };
  const seen = new Map(), cells = [], libs = new Map(), used = new Set(), secretNames = new Set();
  const taken = new Set(["fetch"]);
  const ident = (name) => {
    let id = name.replace(/[^A-Za-z0-9_$]/g, "_");
    if (/^[0-9]/.test(id)) id = "_" + id;
    while (taken.has(id)) id += "_";
    taken.add(id);
    return id;
  };
  const visit = (v0, from) => {
    const v = follow(v0);
    if (seen.has(v)) return seen.get(v);
    const name = v._name;
    const value = v._value;
    const kind = value != null ? value[platformTag] : undefined;
    let ref;
    if (kind === "quickjs") {
      used.add(kind);
      ref = "__quickjs";
    } else if (kind === "browser") {
      used.add(kind);
      ref = "__browser";
    } else if (kind === "cloudflareApi") {
      used.add(kind);
      ref = "__cloudflareApi";
    } else if (kind) {
      used.add(kind);
      ref = "__rt.platform." + kind;
    } else if (value != null && libraries.has(value)) {
      const lib = libraries.get(value);
      libs.set(lib.name, lib.text);
      ref = "__lib_" + lib.name.replace(/[^A-Za-z0-9_$]/g, "_");
    } else if (v._module === runtime._builtin || v._type === 2) {
      if (notebookOnly.has(name) || typeof globalThis[name] === "undefined")
        refuse(from, `depends on ${name}, which exists only in a notebook`);
      ref = name;
    } else {
      if (!name) refuse(from, "depends on an unnamed cell");
      if (/^(viewof|mutable|initial) /.test(name)) refuse(name.replace(/^\w+ /, ""), "is a viewof or mutable cell");
      const def = v._definition;
      if (typeof def !== "function") refuse(name, "has no definition");
      if (/Generator/.test(def.constructor.name)) refuse(name, "is a generator");
      for (const i of v._inputs || [])
        if (/^(viewof|mutable|initial) /.test(i._name || "")) refuse(name, "is a viewof or mutable cell");
      const text = String(def);
      const deps = (v._inputs || []).map((i) => visit(i, name));
      // Secret names are read from the parsed source, so a computed name cannot be bound.
      if (deps.includes("__rt.platform.secrets")) {
        const ast = acorn.parse("(" + text + ")", { ecmaVersion: "latest" });
        const fn = ast.body[0].expression;
        deps.forEach((d, i) => {
          const param = fn.params[i];
          if (d !== "__rt.platform.secrets" || !param || param.type !== "Identifier") return;
          acorn_walk.fullAncestor(ast, (node, ancestors) => {
            if (node.type !== "Identifier" || node.name !== param.name || node === param) return;
            const parent = ancestors[ancestors.length - 2];
            const member = parent.type === "MemberExpression" && parent.object === node;
            const key = !member
              ? null
              : !parent.computed
              ? parent.property.name
              : parent.property.type === "Literal"
              ? parent.property.value
              : null;
            if (typeof key !== "string" || !secretName.test(key)) refuse(name, "reads a secret by a computed name");
            secretNames.add(key);
          });
        });
      }
      ref = ident(name);
      cells.push({ id: ref, name, text, deps });
    }
    seen.set(v, ref);
    return ref;
  };
  const rootRef = visit(root, service.name);

  const role = service.options.role || "recipe";
  // A system Worker is routed like a recipe and deployed like the core: under probation, and not by a recipe's rules.
  const worker = role === "recipe" ? "brain-x-" + service.name : role === "kernel" ? "brain" : role === "system" ? "brain-" + service.name : "brain-" + role;
  const lines = [`// ${worker}: emitted by @tomlarkworthy/cloudflare-iac. Edit the notebook, not this file.`];
  for (const name of libs.keys())
    lines.push(`import * as __lib_${name.replace(/[^A-Za-z0-9_$]/g, "_")} from "./lib/${name}.js";`);
  // The module the service's cell is in, as source. The Worker serves it, and it is part of what is hashed, so
  // what runs and what it was made from are deployed and put back together.
  const source = await moduleSource(root._module);
  if (source) lines.push(`import __source from "./source.js";`);
  // The interpreter's WebAssembly is a part of the Worker. Cloudflare compiles it at upload.
  if (used.has("quickjs")) lines.push(`import __quickjs_wasm from "./quickjs.wasm";`, `const __quickjs = { module: async () => __quickjs_wasm };`);
  // The wrapper holds the origin of the call being answered in AsyncLocalStorage. The deployer sets the flag nodejs_als.
  lines.push(`import { AsyncLocalStorage as __als } from "node:async_hooks";`);
  lines.push(`const __rt = (${String(workerRuntime)})(__als);`, `const fetch = __rt.fetch;`);
  // The browser cell is written here and not in the wrapper, so a Worker that does not use it is emitted as before.
  // The binding has the name the wrapper's workers cell reads for "cf-browser-run".
  if (used.has("browser")) lines.push(`const __browser = { fetch: (path, init = {}) => __rt.platform.workers.fetch("cf-browser-run", new Request("https://browser.internal" + path, init)) };`);
  // The same for the Cloudflare API cell. CF_TOKEN is the token the deployer minted for this Worker and bound to it alone.
  const groups = [...new Set(service.options.cloudflare || [])].sort();
  if (used.has("cloudflareApi") && !groups.length) refuse(service.name, "uses cloudflareApi and declares no Cloudflare permissions: add cloudflare: [\"GROUP\"] to the service's options");
  if (used.has("cloudflareApi")) lines.push(`const __cloudflareApi = { fetch: async (path, init = {}) => fetch("https://api.cloudflare.com/client/v4/accounts/" + __rt.platform.config.account + path, { ...init, headers: { "content-type": "application/json", ...(init.headers || {}), authorization: "Bearer " + (await __rt.platform.secrets.CF_TOKEN) } }) };`);
  lines.push(`const __init = async () => {`);
  for (const c of cells) lines.push(`  const ${c.id} = await (${c.text})(${c.deps.join(", ")});`);
  lines.push(`  return ${rootRef};`, `};`, `export default __rt.serve(__init, ${source ? "__source" : "null"});`);
  if (used.has("rows") && (role === "deployer" || role === "guard")) lines.push(`export const Rows = __rt.Rows;`);
  // A cell value of the tab is never copied: every chased cell is evaluated again on the Worker from its source.

  const parts = [
    { path: "worker.js", text: lines.join("\n") + "\n" },
    ...[...libs].map(([name, text]) => ({ path: `lib/${name}.js`, text })),
    ...(source ? [{ path: "source.js", text: "export default " + JSON.stringify(source) + ";\n" }] : []),
    ...(used.has("quickjs") ? [{ path: "quickjs.wasm", base64: await quickjsWasmText() }] : [])
  ];
  const resources = [...used].filter((k) => !["cloudflare", "secrets", "config", "quickjs", "log", "cloudflareApi"].includes(k)).sort();
  const meta = {
    worker,
    role,
    module: source ? source.module : null,
    // The methods of other services this one calls. A name, never a Worker.
    calls: [...(service.options.calls || [])].sort(),
    crons: service.options.crons || [],
    // The alarm that ticks a scheduled Worker calls it on its own address, which needs this flag.
    flags: [...new Set([...(service.options.flags || []), ...(service.options.scheduled ? ["global_fetch_strictly_public"] : [])])],
    methods: Object.keys(service.options.methods || {}).sort(),
    access: Object.fromEntries(
      Object.entries(service.options.methods || {}).sort().map(([nsid, m]) => [nsid, { type: m.type || "procedure", who: m.who || "owner", ...(m.allow ? { allow: checkedRule(nsid, m.allow) } : {}), ...(m.price ? { price: checkedRule(nsid, m.price) } : {}), ...(m.fixed ? { fixed: true } : {}) }])
    ),
    paths: (service.options.paths || []).map((p) => ({ ...p, ...(p.allow ? { allow: checkedRule(p.path, p.allow) } : {}), ...(p.price ? { price: checkedRule(p.path, p.price) } : {}) })),
    secrets: [...secretNames].sort(),
    resources,
    // Cloudflare permission groups. The deployer mints a token of exactly these and binds it to this Worker as CF_TOKEN.
    cloudflare: groups,
    bindings: [
      // Only the kernel's and the core's named secrets are bound. A recipe reads its secrets through the core.
      ...(role === "kernel" || role === "core" || role === "deployer" ? [...secretNames].sort().map((name) => ({ type: "secret_text", name })) : []),
      ...(used.has("rows") ? [role === "deployer" ? { type: "durable_object_namespace", name: "ROWS", class_name: "Rows" } : { type: "d1", name: "SQL" }] : []),
      ...(used.has("database") ? [{ type: "d1", name: "DB", own: true }] : []),
      ...(used.has("blobs") ? [{ type: "r2_bucket", name: "BLOBS", bucket_name: "brain-blobs" }] : []),
      ...(used.has("inbox") || used.has("xrpc") || used.has("sql") || used.has("core") || (secretNames.size && (role === "recipe" || role === "system")) ? [{ type: "service", name: "CORE", service: "brain-core" }] : []),
      ...(used.has("deployer") ? [{ type: "service", name: "DEPLOYER", service: "brain-deployer" }] : []),
      ...(used.has("assets") ? [{ type: "assets", name: "ASSETS" }] : []),
      ...(used.has("browser") ? [{ type: "browser", name: "X_CF_BROWSER_RUN" }] : [])
    ]
  };
  const hash = await partsHash(parts, meta);
  return { name: service.name, parts, meta, hash, source, info: { name: worker, hash, ...meta, bindings: undefined } };
}
// %%
// A module of this page as { module, text }: its name and the source the exporter writes for it. Null for a module
// the page cannot name.
moduleSource = async (module) => {
  let name = [...(runtime.mains || [])].find(([, m]) => m === module)?.[0] || null;
  if (!name) {
    const loader = [...runtime._variables].find((v) => v._value === module && /^module @/.test(v._name || ""));
    name = loader ? loader._name.slice("module ".length) : null;
  }
  if (!name) return null;
  try {
    return { module: name, text: (await exportModuleJS(name)).source };
  } catch {
    return null;
  }
}
// %%
// Runs the emitted module in the tab with every Cloudflare binding replaced by a recording fake.
simulate = async (service, { secrets = {}, stored = {}, fetch, config = {}, info = {}, core, deployer, guard, assets, workers = {}, rows, blobs, sql, browser } = {}) => {
  const emitted = await service.emit();
  const url = (text) => URL.createObjectURL(new Blob([text], { type: "text/javascript" }));
  let main = emitted.parts[0].text;
  for (const part of emitted.parts.slice(1)) {
    if (part.base64 == null) main = main.split(`"./${part.path}"`).join(JSON.stringify(url(part.text)));
    // A browser cannot import WebAssembly as a module, so the import becomes a compile.
    else main = main.replace(/^import (\w+) from "\.\/quickjs\.wasm";$/m, (_, name) => `const ${name} = await WebAssembly.compile(Uint8Array.from(atob(${JSON.stringify(part.base64)}), (c) => c.charCodeAt(0)));`);
  }
  // A browser has no node:async_hooks. The wrapper then holds one call at a time (see workerRuntime).
  main = main.replace(/^import \{ AsyncLocalStorage as __als \} from "node:async_hooks";$/m, "const __als = null;");
  const mod = await import(url(main));
  const sim = { emitted, inbox: [], rows: rows || new Map(), blobs: blobs || new Map(), requests: [], calls: [] };
  const reply = (value, status = 200) => new Response(JSON.stringify(value), { status, headers: { "content-type": "application/json" } });
  // The same rows for both stores: the deployer's Durable Object and every other Worker's D1.
  const rowsOp = (op, key, value) => {
    const r = sim.rows;
    if (op === "get") return r.has(key) ? r.get(key) : null;
    if (op === "put") return r.set(key, value), true;
    if (op === "delete") return r.delete(key);
    if (op === "putIfAbsent") return r.has(key) ? false : (r.set(key, value), true);
    if (op === "increment") return r.set(key, (r.get(key) || 0) + 1), r.get(key);
    if (op === "append") return r.set(key, [...(r.get(key) || []), value.item].slice(-(value.max || 1000))), r.get(key).length;
    if (op === "deletePrefix") return [...r.keys()].filter((k) => k.startsWith(key)).map((k) => r.delete(k)).length;
    return [...r].filter(([k]) => k.startsWith(key)).sort(([a], [b]) => (a < b ? -1 : 1)).map(([key, value]) => ({ key, value }));
  };
  const env = {
    ...secrets,
    BRAIN_INFO: { ...JSON.parse(JSON.stringify(emitted.info)), ...info },
    BRAIN_CONFIG: config,
    ASSETS: { fetch: async (request) => (assets ? assets(request) : new Response("no asset", { status: 404 })) },
    __sim: {
      fetch: async (input, init) => {
        const request = new Request(input, init);
        sim.requests.push({ method: request.method, url: request.url });
        if (!fetch) throw new Error("simulate: outbound fetch to " + request.url + " and no fake was given");
        return fetch(request);
      }
    },
    CORE: {
      fetch: async (request) => {
        if (core) return core(request);
        const nsid = new URL(request.url).pathname.replace("/xrpc/", "");
        const data = request.method === "POST" ? await request.json() : Object.fromEntries(new URL(request.url).searchParams);
        if (nsid === "com.lopecode.brain.inbox.append") {
          const seen = sim.inbox.find((e) => e.key === data.key);
          if (seen) return reply({ id: seen.id, duplicate: true });
          sim.inbox.push({ id: sim.inbox.length + 1, ...data });
          return reply({ id: sim.inbox.length });
        }
        // db.sql as brain-db would answer it, with no check: the test's sql function is the database.
        if (nsid === "com.lopecode.brain.db.sql" && sql) {
          const results = [];
          for (const [statement, ...args] of data.statements) results.push(await sql(statement, args));
          return reply({ results });
        }
        sim.calls.push({ nsid, data });
        // `stored` are the secrets brain-db would hand this Worker; `secrets` are bound keys.
        if (nsid === "com.lopecode.brain.secret.get") return data.name in stored ? reply({ name: data.name, value: stored[data.name] }) : reply({ error: "NotFound", message: "no such secret" }, 404);
        return reply({ error: "MethodNotImplemented", message: nsid }, 501);
      }
    },
    DEPLOYER: { fetch: async (request) => (deployer || guard ? (deployer || guard)(request) : reply({ error: "NoDeployer" }, 501)) },
    BLOBS: {
      get: async (key) => (sim.blobs.has(key) ? { arrayBuffer: async () => sim.blobs.get(key).buffer } : null),
      put: async (key, bytes) => void sim.blobs.set(key, new Uint8Array(bytes)),
      head: async (key) => (sim.blobs.has(key) ? {} : null),
      delete: async (key) => void sim.blobs.delete(key)
    },
    ...(emitted.meta.role === "deployer" ? {} : { SQL: { sim: async (op, key, value) => rowsOp(op, key, value) } }),
    // No SQL engine runs in a page: a test gives sql(statement, args) => { rows, changes } and answers for its statements.
    DB: { sim: async (statement, args) => (sql ? sql(statement, args) : Promise.reject(new Error("simulate was given no sql function"))) },
    ROWS: { idFromName: (name) => name, get: () => ({ fetch: async (request) => (({ op, key, value }) => reply({ value: rowsOp(op, key, value) }))(await request.json()) }) }
  };
  for (const [name, handler] of Object.entries(workers))
    env["X_" + name.toUpperCase().replace(/[^A-Z0-9]/g, "_")] = { fetch: async (request) => handler(request) };
  // browser(request) answers as the Browser Run binding. For an upgrade it gives { status: 101, webSocket }.
  if (browser) env.X_CF_BROWSER_RUN = { fetch: async (request) => browser(request) };
  sim.env = env;
  sim.fetch = (request, init) => {
    const req = request instanceof Request ? request : new Request(request, init);
    if (init && init.headers) Object.defineProperty(req, "headers", { value: new Headers(init.headers) });
    return mod.default.fetch(req, env, { waitUntil: simWaits.hold });
  };
  sim.scheduled = (event = { scheduledTime: Date.now() }) => mod.default.scheduled(event, env, { waitUntil: simWaits.hold });
  return sim;
}
// %%
// What simulated Workers gave to waitUntil and has not ended. done() waits for all of it.
simWaits = {
  const open = new Set();
  const hold = (p) => {
    const q = Promise.resolve(p).then(() => null, () => null).then(() => void open.delete(q));
    open.add(q);
  };
  const done = async () => {
    while (open.size) await Promise.all([...open]);
  };
  return { hold, done };
}
// %%
// For a test: the objects given to console.log and console.error while fn ran. Lines of other tests running at the
// same time are in the list too, so a test filters by a name of its own.
logged = {
  const taps = new Set(), was = { log: console.log, error: console.error };
  for (const level of ["log", "error"]) console[level] = (...args) => (taps.forEach((t) => t.push(args[0])), was[level].apply(console, args));
  invalidation.then(() => Object.assign(console, was));
  return async (fn) => {
    const lines = [];
    taps.add(lines);
    try {
      await fn();
      // What a simulated Worker handed to waitUntil: the core writes its line after the answer.
      await simWaits.done();
    } finally {
      taps.delete(lines);
    }
    return lines.filter((l) => l && typeof l === "object");
  };
}
// %%
md`## Fixtures and tests

Cells named \`fx_*\` exist for the tests. Three of them are services the emit must refuse.`
// %%
fx_double = (x) => x * 2
// %%
fx_base = 7
// %%
fx_logging_service = cloudflare.Service("fxlog", async (request) => {
  log({ at: "fx.seen", n: 1, worker: "forged", ray: "forged" });
  await xrpc.fetch("com.lopecode.brain.fx.next");
  // A body that is not JSON: the error's message quotes it.
  if (new URL(request.url).pathname === "/throw") await request.json();
  return new Response("ok");
})
// %%
fx_cloudflare_undeclared = cloudflare.Service("fxcf", async () => cloudflareApi.fetch("/workers/scripts"))
// %%
fx_cloudflare_declared = cloudflare.Service("fxcfd", async () => cloudflareApi.fetch("/workers/observability/telemetry/keys", { method: "POST", body: "{}" }), {
  cloudflare: ["Workers Tail Read", "Workers Observability Read", "Workers Tail Read"]
})
// %%
test_log_writes_the_workers_name_and_the_ray_and_the_ray_goes_on = {
  const heard = [];
  const sim = await simulate(fx_logging_service, { secrets: { BRAIN_KEY: "k" }, core: async (request) => (heard.push(request.headers.get("x-brain-ray")), Response.json({})) });
  let status;
  const lines = await logged(async () => {
    await sim.fetch("https://fxlog.internal/x", { headers: { "x-brain-ray": "ray-fx-1" } });
    status = (await sim.fetch("https://fxlog.internal/throw", { method: "POST", body: "SEKRET-BODY", headers: { "x-brain-ray": "ray-fx-2" } })).status;
  });
  const mine = lines.filter((l) => String(l.ray).startsWith("ray-fx-"));
  // What the service gave, with this Worker's name and the ray of the call: a service cannot write another's.
  expect(mine[0]).toEqual({ at: "fx.seen", n: 1, worker: "brain-x-fxlog", ray: "ray-fx-1" });
  // A throw is a 500 and one error line: the error's name and where, and not its message, which here quotes the body.
  expect(status).toBe(500);
  const thrown = mine.find((l) => l.at === "throw");
  expect(Object.keys(thrown).sort()).toEqual(["at", "error", "ray", "stack", "worker"]);
  expect(thrown).toMatchObject({ worker: "brain-x-fxlog", ray: "ray-fx-2", error: "SyntaxError" });
  expect(JSON.stringify(mine)).not.toMatch(/SEKRET/);
  // The ray goes with each call the Worker makes to the core.
  expect(heard).toEqual(["ray-fx-1", "ray-fx-2"]);
  // log is not a resource: nothing is bound for it.
  expect((await fx_logging_service.emit()).meta.resources).toEqual(["xrpc"]);
  return mine.length + " lines";
}
// %%
test_cloudflareApi_needs_a_declared_permission_and_sends_the_bound_token = {
  let refused = null;
  try { await fx_cloudflare_undeclared.emit(); } catch (e) { refused = e.message; }
  expect(refused).toMatch("uses cloudflareApi and declares no Cloudflare permissions");
  const { meta } = await fx_cloudflare_declared.emit();
  expect([meta.cloudflare, meta.resources, meta.secrets]).toEqual([["Workers Observability Read", "Workers Tail Read"], [], []]);
  // A service that declares none has an empty list, and the list is part of the hash.
  expect((await fx_logging_service.emit()).meta.cloudflare).toEqual([]);
  const seen = [];
  const sim = await simulate(fx_cloudflare_declared, { secrets: { CF_TOKEN: "minted-9" }, config: { account: "acct" }, fetch: async (request) => (seen.push([request.method, request.url, request.headers.get("authorization")]), Response.json({ success: true })) });
  expect((await sim.fetch("https://fxcfd.internal/x")).status).toBe(200);
  expect(seen).toEqual([["POST", "https://api.cloudflare.com/client/v4/accounts/acct/workers/observability/telemetry/keys", "Bearer minted-9"]]);
  return meta.cloudflare.join(", ");
}
// %%
// Hono 4.13.12 as one ES module. Import it to route a service: it travels to the Worker as lib/hono.js.
hono = library("hono", FileAttachment("hono.js"))
// %%
md`## Distilling in the deployer

A deploy is module source. The deployer runs it in QuickJS with \`distilIn\`, which loads the module into an Observable runtime, computes the service's cell and calls this module's \`emit\` on it. The sandbox has no network and no bindings: one host call gives it module text, attachment text and SHA-256. It has 64 MB of memory and a 1 MB stack, and source that does not end is stopped: QuickJS asks the host once per 10,000 loop turns and calls, and the 100,001st time the distil fails with "the source ran past the limit of the sandbox and was stopped". That is 1.2 s of \`for (;;) {}\` on a laptop (2026-10-09); a count and not a time, because a Worker's clock does not move while it computes.

| | |
|---|---|
| \`quickjs\` | platform cell. \`quickjs.module()\` is the interpreter's WebAssembly: a part of the Worker, an attachment in the notebook |
| \`quickjsLib\` | \`quickjs-emscripten-core\` 0.32.0 as one module; \`quickjsLib.load(wasm)\` |
| \`distillerData\` | what distilling needs and a running Worker does not: this module's source, the Observable runtime, acorn 8.18.0, acorn-walk 8.3.5, \`hono.js\`, \`cel.js\` |
| \`distilIn(interpreter, data, { module, source, cell, sources, files })\` | \`interpreter()\` gives a new QuickJS instance. \`{ parts, meta, hash }\`. \`cell\` defaults to the one cell named \`*_service\`. \`sources\` are other modules by name; \`files\` are the module's attachments by name |

An import of a module that is neither \`module\`, in \`sources\`, nor this one fails by name. The imports of a service that are never computed (the test library, the plugin registry) are never loaded.`
// %%
quickjs = {
  let made;
  return {
    [platformTag]: "quickjs",
    module: () => (made ??= quickjsWasmText().then((b64) => WebAssembly.compile(Uint8Array.from(atob(b64), (c) => c.charCodeAt(0)))))
  };
}
// %%
quickjsWasmText = () => FileAttachment("quickjs.wasm.b64").text()
// %%
quickjsLib = library("quickjs", FileAttachment("quickjs.js"))
// %%
distillerData = library(
  "distiller-data",
  "export default " +
    JSON.stringify({
      modules: {
        "observable-runtime": await FileAttachment("observable-runtime.js").text(),
        acorn: await FileAttachment("acorn.js").text(),
        "acorn-walk": await FileAttachment("acorn-walk.js").text(),
        "@tomlarkworthy/cloudflare-iac": (await exportModuleJS("@tomlarkworthy/cloudflare-iac")).source
      },
      content: {
        "@tomlarkworthy/cloudflare-iac/hono.js": await FileAttachment("hono.js").text(),
        "@tomlarkworthy/cloudflare-iac/cel.js": await FileAttachment("cel.js").text()
      },
      // Not read when distilling. The deployer hands these to a page, which needs them to emit a deployer for a new Brain.
      files: {
        "quickjs.js": await FileAttachment("quickjs.js").text(),
        "quickjs.wasm.b64": await FileAttachment("quickjs.wasm.b64").text()
      }
    }) +
    ";\n"
)
// %%
// Self-contained: the deployer carries it as text. The two inner functions are run inside QuickJS, so they name
// nothing but globals of the sandbox.
distilIn = async (interpreter, data, { module, source, cell = null, sources = {}, files = {} }) => {
  // Before anything else in the sandbox: the few names the runtime and emit touch that QuickJS does not have.
  const prelude = function () {
    const host = globalThis.__hostCall;
    globalThis.window = globalThis;
    globalThis.lopecode = { contentSync: (id) => ({ status: 200, mime: "text/javascript", bytes: host("content", id) }) };
    globalThis.Blob = class Blob {
      constructor(parts) {
        this.__t = parts.map((p) => (p && p.__t != null ? p.__t : String(p))).join("");
      }
      async text() {
        return this.__t;
      }
    };
    // A cell that names one of these is copied to the Worker as text and runs there; here they only have to exist.
    for (const n of ["Request", "Response", "Headers", "URLSearchParams", "AbortController", "WebSocket", "FormData", "File", "ReadableStream", "WritableStream", "TransformStream", "DecompressionStream", "CompressionStream", "WebAssembly"])
      globalThis[n] = class {
        constructor() {
          throw new Error(n + " is not available while distilling");
        }
      };
    for (const n of ["fetch", "atob", "btoa", "structuredClone", "queueMicrotask"])
      globalThis[n] = () => {
        throw new Error(n + " is not available while distilling");
      };
    globalThis.URL = class URL {
      constructor() {
        throw new Error("URL is not available while distilling");
      }
      static createObjectURL(b) {
        return host("register", b.__t);
      }
      static revokeObjectURL() {}
    };
    // A module written by the exporter spells a dynamic import importShim(, and so does this cell once it has been
    // through the exporter: written plainly here, the line below became a function that calls itself.
    globalThis.importShim = new Function("spec", "return imp" + "ort(spec)");
    globalThis.console = { log: () => {}, error: () => {}, warn: () => {} };
    globalThis.setImmediate = (f) => {
      Promise.resolve().then(f);
    };
    globalThis.setTimeout = (f) => {
      Promise.resolve().then(f);
      return 0;
    };
    globalThis.clearTimeout = () => {};
    globalThis.TextEncoder = class TextEncoder {
      encode(s) {
        const o = [];
        for (const ch of String(s)) {
          const c = ch.codePointAt(0);
          if (c < 0x80) o.push(c);
          else if (c < 0x800) o.push(0xc0 | (c >> 6), 0x80 | (c & 63));
          else if (c < 0x10000) o.push(0xe0 | (c >> 12), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));
          else o.push(0xf0 | (c >> 18), 0x80 | ((c >> 12) & 63), 0x80 | ((c >> 6) & 63), 0x80 | (c & 63));
        }
        return new Uint8Array(o);
      }
    };
    globalThis.TextDecoder = class TextDecoder {
      decode(b) {
        b = b instanceof Uint8Array ? b : new Uint8Array(b || []);
        let s = "", i = 0;
        while (i < b.length) {
          const c = b[i++];
          let p = c;
          if (c >= 0xf0) p = ((c & 7) << 18) | ((b[i++] & 63) << 12) | ((b[i++] & 63) << 6) | (b[i++] & 63);
          else if (c >= 0xe0) p = ((c & 15) << 12) | ((b[i++] & 63) << 6) | (b[i++] & 63);
          else if (c >= 0xc0) p = ((c & 31) << 6) | (b[i++] & 63);
          s += String.fromCodePoint(p);
        }
        return s;
      }
    };
    globalThis.crypto = {
      subtle: {
        digest: async (alg, bytes) => {
          const b = new Uint8Array(bytes.buffer || bytes);
          let h = "";
          for (let i = 0; i < b.length; i++) h += (b[i] < 16 ? "0" : "") + b[i].toString(16);
          const hex = host("sha256hex", h);
          const out = new Uint8Array(hex.length / 2);
          for (let i = 0; i < out.length; i++) out[i] = parseInt(hex.slice(i * 2, i * 2 + 2), 16);
          return out.buffer;
        }
      }
    };
  };
  const main = async function (name, cell) {
    const host = globalThis.__hostCall;
    const { Runtime } = await import("observable-runtime");
    const runtime = new Runtime({});
    runtime.fileAttachments = (find) => (n) => {
      const r = find(n);
      if (!r) throw new Error("no attachment " + n);
      return { url: async () => r.url, text: async () => host("blobText", r.url) };
    };
    const define = (await import("/" + name + ".js?v=4")).default;
    // Every cell that could be the service is computed; a test cell named *_service is not one.
    const wanted = (n) => (cell ? n === cell : /_service$/.test(n || "") && !/^test_/.test(n));
    const found = [], failed = [];
    let waiting = 0, done;
    const settled = new Promise((a) => (done = a));
    const settle = () => --waiting || done();
    const module = runtime.module(define, (n) => {
      if (!wanted(n)) return undefined;
      waiting++;
      return { fulfilled: (v) => (v && v.emit && found.push([n, v]), settle()), rejected: (e) => (failed.push(n + ": " + String((e && e.message) || e)), settle()) };
    });
    runtime.mains = new Map([[name, module]]);
    if (!waiting) throw new Error(cell ? name + " has no cell " + cell : name + " has no cell named *_service");
    await settled;
    if (failed.length && !found.length) throw new Error(failed.join("; "));
    if (!found.length) throw new Error(cell ? cell + " is not a service in " + name : "no cell named *_service holds a service in " + name);
    if (found.length > 1) throw new Error(name + " has " + found.length + " services (" + found.map((f) => f[0]).join(", ") + "): name the cell");
    const e = await found[0][1].emit();
    // The deployer holds what distilling needs; it does not hold what distilling the deployer needs.
    if (e.meta.role === "deployer") throw new Error("the deployer is not distilled by a deployer");
    return JSON.stringify({ parts: e.parts, meta: e.meta, hash: e.hash });
  };
  const one = (lines) => lines.join("\n");
  const stubs = {
    "@tomlarkworthy/runtime-sdk": one(['export default function define(runtime, observer) { const main = runtime.module(); main.variable(observer("runtime")).define("runtime", [], () => runtime); return main; }']),
    // The source is an input here, so the exporter answers with what was submitted.
    "@tomlarkworthy/exporter-3": one(['export default function define(runtime, observer) { const main = runtime.module(); main.variable(observer("exportModuleJS")).define("exportModuleJS", [], () => async (name) => ({ source: globalThis.__hostCall("source", name) })); return main; }']),
    "@tomlarkworthy/acorn-8-11-3": one(['import * as acorn from "acorn"; import * as acorn_walk from "acorn-walk";', 'export default function define(runtime, observer) { const main = runtime.module(); main.variable(observer("acorn")).define("acorn", [], () => acorn); main.variable(observer("acorn_walk")).define("acorn_walk", [], () => acorn_walk); return main; }'])
  };
  const sourceOf = (name) => (name === module ? source : sources[name] != null ? sources[name] : data.modules[name]);
  // SHA-256 over bytes given as hex. A host call from QuickJS cannot await, so crypto.subtle is no use.
  const sha = (hex) => {
    const K = new Uint32Array(64);
    for (let c = 2, n = 0; n < 64; c++) {
      let prime = true;
      for (let d = 2; d * d <= c; d++) if (c % d === 0) prime = false;
      if (prime) K[n++] = (Math.cbrt(c) % 1) * 2 ** 32;
    }
    const len = hex.length / 2, total = (((len + 8) >> 6) + 1) << 6;
    const m = new Uint8Array(total);
    for (let i = 0; i < len; i++) m[i] = parseInt(hex.substr(i * 2, 2), 16);
    m[len] = 0x80;
    const dv = new DataView(m.buffer);
    dv.setUint32(total - 8, Math.floor((len * 8) / 2 ** 32));
    dv.setUint32(total - 4, (len * 8) >>> 0);
    const h = new Uint32Array([0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]);
    const w = new Uint32Array(64), r = (x, n) => (x >>> n) | (x << (32 - n));
    for (let o = 0; o < total; o += 64) {
      for (let i = 0; i < 16; i++) w[i] = dv.getUint32(o + i * 4);
      for (let i = 16; i < 64; i++) w[i] = (w[i - 16] + (r(w[i - 15], 7) ^ r(w[i - 15], 18) ^ (w[i - 15] >>> 3)) + w[i - 7] + (r(w[i - 2], 17) ^ r(w[i - 2], 19) ^ (w[i - 2] >>> 10))) >>> 0;
      let [a, b, c, d, e, f, g, hh] = h;
      for (let i = 0; i < 64; i++) {
        const t1 = (hh + (r(e, 6) ^ r(e, 11) ^ r(e, 25)) + ((e & f) ^ (~e & g)) + K[i] + w[i]) >>> 0;
        const t2 = ((r(a, 2) ^ r(a, 13) ^ r(a, 22)) + ((a & b) ^ (a & c) ^ (b & c))) >>> 0;
        hh = g; g = f; f = e; e = (d + t1) >>> 0; d = c; c = b; b = a; a = (t1 + t2) >>> 0;
      }
      h[0] += a; h[1] += b; h[2] += c; h[3] += d; h[4] += e; h[5] += f; h[6] += g; h[7] += hh;
    }
    return [...h].map((x) => x.toString(16).padStart(8, "0")).join("");
  };
  const blobs = new Map();
  const load = (spec) => {
    if (spec.startsWith("blob:")) return blobs.get(spec);
    if (data.modules[spec] != null && spec[0] !== "@") return data.modules[spec];
    const m = /^\/(@[^/]+\/[^/.]+)\.js(\?.*)?$/.exec(spec);
    const text = m && m[1] !== module && stubs[m[1]] ? stubs[m[1]] : m ? sourceOf(m[1]) : null;
    if (text == null) throw new Error("no source for " + (m ? m[1] : spec));
    return text;
  };
  const hostCall = (name, arg) => {
    if (name === "content") {
      const id = decodeURIComponent(arg), own = module + "/";
      return id.startsWith(own) && files[id.slice(own.length)] != null ? files[id.slice(own.length)] : data.content[id] != null ? data.content[id] : "";
    }
    if (name === "register") {
      const url = "blob:distil/" + blobs.size;
      blobs.set(url, arg);
      return url;
    }
    if (name === "blobText") return blobs.get(arg);
    if (name === "sha256hex") return sha(arg);
    if (name === "source") return sourceOf(arg) || "";
    throw new Error("no host call " + name);
  };
  // A new instance of the interpreter for each distil, dropped whole afterwards. Freeing a runtime after a failed
  // run aborts the instance (seen 2026-10-06: "Assertion failed: list_empty(&rt->gc_obj_list)"), and nothing of
  // one distil should be reachable from the next.
  const quickjs = await interpreter();
  const rt = quickjs.newRuntime();
  // Source that does not end is stopped. QuickJS asks once per 10,000 loop turns and calls. The limit is a count
  // because a Worker's clock stands still while it computes. Measured 2026-10-09: for (;;) {} is stopped at 100,000
  // in 1.2 s; acorn parsing 700 KB, 465 ms of work, asks 2,250 times. A distil is 130 to 300 ms of a Worker's CPU.
  const ASKS = 100000;
  let asks = 0;
  rt.setInterruptHandler(() => ++asks > ASKS);
  rt.setMemoryLimit(64 * 1024 * 1024);
  rt.setMaxStackSize(1024 * 1024);
  rt.setModuleLoader((name) => load(name), (base, name) => name);
  const vm = rt.newContext();
  vm.newFunction("__hostCall", (a, b) => vm.newString(hostCall(vm.getString(a), vm.getString(b)))).consume((f) => vm.setProp(vm.global, "__hostCall", f));
  const run = (code, file) => {
    const r = vm.evalCode(code, file, { type: "global" });
    if (r.error) {
      const e = vm.dump(r.error);
      throw new Error(file + ": " + ((e && e.message) || JSON.stringify(e)));
    }
  };
  run("(" + String(prelude) + ")()", "prelude.js");
  run("(" + String(main) + ")(" + JSON.stringify(module) + ", " + JSON.stringify(cell) + ").then((v) => { globalThis.__result = v; }, (e) => { globalThis.__error = String((e && e.message) || e); });", "main.js");
  for (;;) {
    const p = rt.executePendingJobs();
    if (asks > ASKS) throw new Error("the source ran past the limit of the sandbox and was stopped");
    if (p.error) {
      const e = vm.dump(p.error);
      throw new Error((e && e.message) || JSON.stringify(e));
    }
    if (!p.value) break;
  }
  const read = (k) => vm.dump(vm.getProp(vm.global, k));
  const failed = read("__error"), result = read("__result");
  if (failed) throw new Error(failed);
  if (!result) throw new Error("the sandbox stopped with no answer");
  return JSON.parse(result);
}
