  "conf",
  async () => Response.json({ pollMs: config.pollMs ?? 30000, owner: config.owner }),
  { crons: ["* * * * *"], scheduled: async () => void (await rows.put("ticked", config.pollMs ?? 30000)) }
)
// %%
test_stored_settings_show_through_config_and_never_replace_a_bound_key = {
  const sim = await simulate(fx_conf, { config: { owner: "did:plc:owner" } });
  const S = (o) => ({ "x-brain-settings": encodeURIComponent(JSON.stringify(o)) });
  const ask = async (url, headers = {}) => (await sim.fetch(url, { headers })).json();
  expect(await ask("https://conf.internal/")).toEqual({ pollMs: 30000, owner: "did:plc:owner" });
  // The core's word with a call: read with no deploy. owner was bound at deploy and is not replaced.
  expect(await ask("https://conf.internal/", S({ pollMs: 60000, owner: "did:plc:evil" }))).toEqual({ pollMs: 60000, owner: "did:plc:owner" });
  // Kept by the instance for a call that carries none, and for its clock.
  expect((await ask("https://conf.internal/")).pollMs).toBe(60000);
  await sim.scheduled();
  expect(sim.rows.get("ticked")).toBe(60000);
  // What it has read, and where each value is from.
  expect((await ask("https://conf.internal/xrpc/_config")).read).toEqual([{ key: "owner", value: "did:plc:owner", from: "deploy" }, { key: "pollMs", value: 60000, from: "stored" }]);
  // Removed: the default again. Not a list, not text that is not JSON.
  expect((await ask("https://conf.internal/", S({}))).pollMs).toBe(30000);
  expect((await sim.fetch("https://conf.internal/", { headers: { "x-brain-settings": "%5B1%5D" } }).then((r) => r.json())).pollMs).toBe(30000);
  // From the internet the header is removed before it is read, and _config is not answered.
  expect((await sim.fetch("https://conf.example.workers.dev/", { headers: { ...S({ pollMs: 1 }), "x-brain-deployer": "k" } })).status).toBe(404);
  // A Worker that only its clock has run reads the core's row itself, once.
  const cold = await simulate(fx_conf, { rows: new Map([["config/brain-x-conf", { pollMs: 45000 }]]) });
  await cold.scheduled();
  expect(cold.rows.get("ticked")).toBe(45000);
  cold.rows.set("config/brain-x-conf", { pollMs: 1 });
  await cold.scheduled();
  expect(cold.rows.get("ticked")).toBe(45000);
  return "60000 from the core, owner kept, 45000 read by the clock";
}
