test_ai_models_is_cloudflares_list_and_the_service_declares_one_permission = {
  const rig = await aiRig();
  const r = await rig.sim.fetch("https://ai.internal/xrpc/com.lopecode.brain.ai.models?search=bge&per_page=5", { headers: { "x-brain-caller": "owner" } });
  expect([r.status, (await r.json()).result.map((m) => m.name)]).toEqual([200, ["@cf/baai/bge-small-en-v1.5"]]);
  expect(rig.seen[0].url).toBe("https://api.cloudflare.com/client/v4/accounts/acct/ai/models/search?search=bge&per_page=5");
  expect(aiModels.map(aiRates)).toEqual([{ input: 0.027e-6, output: 0.201e-6 }, { input: 0.0202e-6, output: null }, null, null]);
  const { meta } = await ai_service.emit();
  expect([meta.worker, meta.cloudflare, meta.resources, meta.secrets, meta.calls]).toEqual(["brain-x-ai", ["Workers AI Read"], [], [], []]);
  const N = "com.lopecode.brain.ai.";
  expect(Object.keys(meta.access).filter((k) => meta.access[k].price).map((k) => k.slice(N.length))).toEqual(["run"]);
  // The owner, a token and an account the kernel passed for the method, and a Worker of the Brain; not a stranger.
  const ask = (m, who) => decide(meta.access[N + m], { caller: callerOf(who), origin: callerOf(who), request: { params: { usd: "0.001" } } }).allow;
  for (const m of ["run", "models"]) expect([m, ask(m, { caller: "owner", via: "session" }), ask(m, { caller: "token:laptop" }), ask(m, { caller: "did:plc:ada" }), ask(m, { caller: "worker:brain-x-snapshot" }), ask(m, { caller: "anonymous" })]).toEqual([m, true, true, true, true, false]);
  return meta.cloudflare[0];
}
// %%
test_ai_panel_lists_priced_text_models_and_runs_one = {
  const asked = [];
  const client = {
    query: async (name, params) => (asked.push([name, params]), { result: aiModels }),
    procedure: async (name, body, opts) => (asked.push([name, body, opts]), { result: { response: "Hi.", usage: { neurons: 0.0965 } } })
  };
  const el = aiPanel({ client, owner: true });
  await el.ready;
  expect(asked[0]).toEqual(["ai.models", { task: "Text Generation", per_page: 100 }]);
  // Only the models priced by the token are offered, the cheapest input first: two of the four.
  expect([...el.querySelectorAll("select option")].map((o) => o.textContent.split(" ")[0])).toEqual(["@cf/baai/bge-small-en-v1.5", "@cf/meta/llama-3.2-1b-instruct"]);
  el.querySelector("select").selectedIndex = 1;
  el.querySelector("select").dispatchEvent(new Event("input", { bubbles: true }));
  let heard = 0;
  el.addEventListener("input", () => heard++);
  // A key in a box of the panel is not a new value of the panel.
  el.querySelector("textarea").dispatchEvent(new Event("input", { bubbles: true }));
  expect(heard).toBe(0);
  // usd is what the box shows: out of range is not sent, and any number in range is, with no step.
  const box = [...el.querySelectorAll("input")].find((i) => i.type === "number"), calls = asked.length;
  for (const bad of ["5", "0", "-1", ""]) {
    box.value = bad;
    await el.run();
    expect([bad, asked.length, el.textContent.includes("from 0.000001 to 1")]).toEqual([bad, calls, true]);
  }
  box.value = "0.00123";
  await el.run();
  expect([asked.at(-1)[2].params.usd, el.textContent.includes("usd 0.00123 was sent")]).toEqual([0.00123, true]);
  expect(heard).toBe(1);
  box.value = "0.0005";
  await el.run();
  expect(asked.at(-1)).toEqual(["ai.run", { messages: [{ role: "user", content: "Say hi in five words." }] }, { params: { model: "@cf/meta/llama-3.2-1b-instruct", usd: 0.0005 } }]);
  expect([el.querySelector("pre").textContent, el.value.result.response]).toEqual(["Hi.", "Hi."]);
  expect(heard).toBe(2);
  expect(aiPanel({ client, owner: false }).value).toBe(null);
  return el.textContent.includes("0.097 neurons") ? "ran" : el.textContent;
}
