// %%
// Stands in for the table database under simulate: answers sqlMaster and EXPLAIN from sqlPlanFixture and records the rest.
sqlFakeDatabase = ({ master = sqlPlanFixture.master, plans = sqlPlanFixture.plans } = {}) => {
  const ran = [];
  const run = (statement, args) => {
    if (statement === sqlMaster) return { rows: master, changes: 0 };
    if (statement.startsWith("EXPLAIN ")) {
      const p = plans[statement.slice(8)];
      if (!p) throw new Error("no plan recorded for: " + statement.slice(8));
      return { rows: p.map(([opcode, p1, p2, p3, p5]) => ({ opcode, p1, p2, p3, p5 })), changes: 0 };
    }
    ran.push([statement, ...args]);
    return { rows: [], changes: 1 };
  };
  return { run, ran };
}
// %%
test_sql_text_rules = {
  const kind = (s) => ((r) => r.refused ? "refused" : r.kind + (r.names ? " " + r.names.join(",") : ""))(sqlShape(s));
  expect(["SELECT 1", "  select 1", "WITH x AS (SELECT 1) DELETE FROM t", "REPLACE INTO t VALUES (1)", "INSERT INTO t VALUES (?1)"].map(kind)).toEqual(Array(5).fill("data"));
  expect(kind("CREATE TABLE IF NOT EXISTS Metrics_Calls (t INTEGER)")).toBe("schema metrics_calls");
  expect(kind("create unique index if not exists metrics_i on metrics_calls (t)")).toBe("schema metrics_i,metrics_calls");
  expect([kind("DROP TABLE IF EXISTS metrics_calls"), kind("DROP INDEX metrics_i \n"), kind("ALTER TABLE metrics_calls ADD COLUMN ms REAL")]).toEqual(["schema metrics_calls", "schema metrics_i", "schema metrics_calls"]);
  const refused = [
    "SELECT 1; DROP TABLE t", "SELECT ';'", "SELECT 1;", "PRAGMA table_info(t)", "EXPLAIN SELECT 1", "/* x */ PRAGMA table_info(t)", "ATTACH DATABASE 'x' AS y", "VACUUM", "ANALYZE", "BEGIN",
    "CREATE TABLE metrics_x AS SELECT * FROM t", "CREATE TABLE main.metrics_x (a)", 'CREATE TABLE "metrics_x" (a)', "CREATE TEMP TABLE metrics_x (a)", "CREATE VIRTUAL TABLE metrics_x USING fts5(a)",
    "CREATE VIEW metrics_v AS SELECT 1", "CREATE TRIGGER metrics_t AFTER INSERT ON metrics_calls BEGIN SELECT 1 END", "DROP VIEW metrics_v", "DROP TABLE metrics_calls, t", "DROP TABLE metrics_calls -- x",
    "ALTER TABLE metrics_calls RENAME TO t", "ALTER TABLE metrics_calls DROP COLUMN t", "ALTER TABLE metrics_calls RENAME COLUMN a TO b", "CREATE\u00a0TABLE metrics_x (a)", "", 42
  ];
  expect(refused.filter((s) => kind(s) !== "refused")).toEqual([]);
  return refused.length + " refused";
}
// %%
test_sql_needs_are_read_from_real_plans = {
  const { master, plans } = sqlPlanFixture;
  const says = (s, opts) => sqlSignature(sqlNeeds(plans[s], master, opts));
  // The self-test's own expectations hold on the recorded plans.
  expect(sqlSelfTest.statements.filter(([s, expected]) => says(s) !== expected)).toEqual([]);
  expect(says("SELECT c.t, d.v FROM metrics_calls c JOIN library_docs d ON d.k = c.worker")).toBe("r:library_docs r:metrics_calls");
  expect(says("INSERT INTO metrics_faults SELECT 1, v FROM library_docs")).toBe("r:library_docs w:metrics_faults");
  expect(says("INSERT INTO metrics_calls (t, worker, n) VALUES (?1, ?2, ?3) ON CONFLICT (t, worker) DO UPDATE SET n = n + excluded.n")).toBe("w:metrics_calls");
  // A DELETE with no WHERE opens nothing: it is a Clear of the table and of its index.
  expect(plans["DELETE FROM library_docs"].map((o) => o[0])).not.toContain("OpenWrite");
  expect(says("DELETE FROM library_docs")).toBe("w:library_docs");
  expect(says("SELECT 1")).toBe("");
  expect(says("SELECT name FROM sqlite_master")).toBe("refused: sqlite_master");
  expect(says("SELECT * FROM json_each('[1]')")).toBe("refused: the opcode VOpen is not one this check reads");
  // A schema statement read as data is refused; read as schema, it names what it reads and drops.
  expect(says("CREATE TABLE metrics_daily (d TEXT PRIMARY KEY, n INTEGER)")).toBe("refused: ReadCookie belongs to a schema statement");
  expect(says("DROP TABLE metrics_faults")).toBe("refused: sqlite_master");
  expect(sqlSignature(sqlNeeds([["Destroy", 11, 2, 0, 0]], master))).toBe("refused: a drop outside a schema statement");
  expect(says("CREATE TABLE metrics_daily (d TEXT PRIMARY KEY, n INTEGER)", { schema: true })).toBe("");
  expect(says("CREATE INDEX metrics_docs_v ON library_docs (v)", { schema: true })).toBe("r:library_docs");
  expect(says("DROP TABLE metrics_faults", { schema: true })).toBe("x:metrics_faults");
  expect([sqlNeeds(plans["DROP TABLE metrics_faults"], master, { schema: true }).changes, sqlNeeds(plans["CREATE TABLE IF NOT EXISTS metrics_calls (t INTEGER)"], master, { schema: true }).changes]).toEqual([true, false]);
  // A root page sqlite_master does not list, another database, and an opcode not on the list.
  expect(sqlSignature(sqlNeeds([["OpenRead", 0, 99, 0, 0]], master))).toBe("refused: root page 99 is no table");
  expect(sqlSignature(sqlNeeds([["OpenRead", 0, 10, 1, 0]], master))).toBe("refused: a database other than the main one");
  expect(sqlSignature(sqlNeeds([["Init", 0, 1, 0, 0], ["OpenAnyOtherWay", 0, 10, 0, 0]], master))).toBe("refused: the opcode OpenAnyOtherWay is not one this check reads");
  // Every opcode D1 gave for the recorded statements is one the lists hold or sqlNeeds reads, bar the virtual table's.
  const seen = new Set(Object.values(plans).flat().map((o) => o[0]));
  expect([...seen].filter((o) => !sqlOpcodes.safe.has(o) && !sqlOpcodes.schema.has(o)).sort()).toEqual(["Clear", "Destroy", "OpenRead", "OpenWrite", "VColumn", "VFilter", "VNext", "VOpen"]);
  expect([sqlPrefix({ kind: "did", did: "did:plc:a" }, "worker:brain-m-0123456789-todo"), sqlPrefix({ kind: "did", did: "did:plc:a" }, "session"), sqlPrefix({ kind: "did", did: "did:plc:a" }, "worker:brain-x-metrics")]).toEqual(["m_0123456789_todo_", null, null]);
  expect([sqlPrefix({ kind: "worker", worker: "brain-x-metrics" }), sqlPrefix({ kind: "worker", worker: "brain-x-My-Thing" }), sqlPrefix({ kind: "worker", worker: "brain-db" }), sqlPrefix({ kind: "did" })]).toEqual(["metrics_", "my_thing_", "db_", null]);
  return seen.size + " opcodes in " + Object.keys(plans).length + " plans";
}
// %%
test_db_sql_decides_by_table_from_the_plan = {
  const db = sqlFakeDatabase();
  const sim = await simulate(db_service, { sql: db.run });
  const as = (who, via = "") => async (statements, path = "sql") => {
    const r = await sim.fetch("https://db.internal/xrpc/com.lopecode.brain.db." + path, { method: "POST", headers: { "x-brain-caller": who, "x-brain-via": via, "content-type": "application/json" }, body: JSON.stringify(path === "sql" ? { statements } : statements) });
    return { status: r.status, data: await r.json() };
  };
  const metrics = as("worker:brain-x-metrics"), library = as("worker:brain-x-library"), owner = as("owner", "session");
  const upsert = "INSERT INTO metrics_calls (t, worker, n) VALUES (?1, ?2, ?3) ON CONFLICT (t, worker) DO UPDATE SET n = n + excluded.n";
  // Its own tables: read, upsert, a write fed by a read. The self-test's setup ran first, once.
  const ok = await metrics([["SELECT t, n FROM metrics_calls WHERE t >= ?1", 0], [upsert, 1, "a", 2], [upsert, 2, "b", 3], ["INSERT INTO metrics_faults SELECT t, worker FROM metrics_calls"]]);
  expect([ok.status, ok.data.results.length, ok.data.explained]).toEqual([200, 4, 3]);
  expect(db.ran.slice(0, 4).map((s) => s[0])).toEqual(sqlSelfTest.setup);
  expect(db.ran.slice(4)).toEqual([["SELECT t, n FROM metrics_calls WHERE t >= ?1", 0], [upsert, 1, "a", 2], [upsert, 2, "b", 3], ["INSERT INTO metrics_faults SELECT t, worker FROM metrics_calls"]]);
  // The same statements again: no plan is read, and the setup is not run again.
  expect((await metrics([[upsert, 3, "c", 4]])).data.explained).toBe(0);
  expect(db.ran.length).toBe(9);
  // Another Worker's table: not read, not written, not cleared, and nothing of the batch runs.
  const no = async (who, statements) => ((r) => [r.status, r.data.message])(await who(statements));
  expect(await no(metrics, [["SELECT c.t, d.v FROM metrics_calls c JOIN library_docs d ON d.k = c.worker"]])).toEqual([403, "statement 1: no read on library_docs"]);
  expect(await no(metrics, [[upsert, 1, "a", 2], ["INSERT INTO metrics_faults SELECT 1, v FROM library_docs"]])).toEqual([403, "statement 2: no read on library_docs"]);
  expect(await no(metrics, [["DELETE FROM library_docs"]])).toEqual([403, "statement 1: no write on library_docs"]);
  expect(await no(metrics, [["UPDATE library_docs SET v = ?1", "x"]])).toEqual([403, "statement 1: no write on library_docs"]);
  expect(await no(library, [["SELECT t, n FROM metrics_calls WHERE t >= ?1", 0]])).toEqual([403, "statement 1: no read on metrics_calls"]);
  expect(await no(as("did:plc:friend", "jwt"), [["SELECT t, n FROM metrics_calls WHERE t >= ?1", 0]])).toEqual([403, "statement 1: no read on metrics_calls"]);
  expect(await no(metrics, [["SELECT name FROM sqlite_master"]])).toEqual([403, "statement 1: sqlite_master"]);
  expect(await no(metrics, [["SELECT * FROM json_each('[1]')"]])).toEqual([403, "statement 1: the opcode VOpen is not one this check reads"]);
  expect((await metrics([["SELECT 1; DELETE FROM library_docs"]])).status).toBe(400);
  expect((await metrics([["PRAGMA table_info(library_docs)"]])).status).toBe(400);
  expect((await metrics([])).status).toBe(400);
  expect(db.ran.length).toBe(9);
  // Schema: under its own prefix only, and an index only on its own table.
  expect((await metrics([["CREATE TABLE metrics_daily (d TEXT PRIMARY KEY, n INTEGER)"], ["CREATE INDEX metrics_faults_t ON metrics_faults (t)"]])).status).toBe(200);
  expect(sim.rows.get("sql/schema")).toMatchObject({ by: "worker:brain-x-metrics" });
  expect(await no(library, [["CREATE TABLE metrics_daily (d TEXT PRIMARY KEY, n INTEGER)"]])).toEqual([403, "statement 1: metrics_daily does not have this caller's prefix, library_"]);
  expect(await no(metrics, [["CREATE INDEX metrics_docs_v ON library_docs (v)"]])).toEqual([403, "statement 1: library_docs does not have this caller's prefix, metrics_"]);
  expect(await no(library, [["DROP TABLE metrics_faults"]])).toEqual([403, "statement 1: metrics_faults does not have this caller's prefix, library_"]);
  expect((await metrics([["DROP TABLE metrics_faults"]])).status).toBe(200);
  // A CREATE that finds its table changes nothing, so no plan is forgotten for it.
  const before = sim.rows.get("sql/schema").at;
  expect((await metrics([["CREATE TABLE IF NOT EXISTS metrics_calls (t INTEGER)"]])).status).toBe(200);
  expect(sim.rows.get("sql/schema").at).toBe(before);
  // A rule opens one table for one op. Only the owner's own session sets one, and it does not open schema statements.
  expect([(await metrics({ table: "library_docs", allow: "true" }, "sqlGrant")).status, (await as("token:laptop", "token")({ table: "library_docs", allow: "true" }, "sqlGrant")).status]).toEqual([401, 401]);
  expect((await owner({ table: "library_docs", allow: 'resource.op == "read" && caller.worker == "brain-x-metrics"' }, "sqlGrant")).status).toBe(200);
  expect((await metrics([["SELECT c.t, d.v FROM metrics_calls c JOIN library_docs d ON d.k = c.worker"]])).status).toBe(200);
  expect(await no(metrics, [["DELETE FROM library_docs"]])).toEqual([403, "statement 1: no write on library_docs"]);
  expect(await no(metrics, [["CREATE INDEX metrics_docs_v ON library_docs (v)"]])).toEqual([403, "statement 1: library_docs does not have this caller's prefix, metrics_"]);
  // The owner is not checked: no plan is read, and a statement the check has no plan for runs.
  expect((await owner([["SELECT anything FROM anywhere"], ["PRAGMA table_info(library_docs)"]])).status).toBe(200);
  expect(db.ran.at(-1)).toEqual(["PRAGMA table_info(library_docs)"]);
  const tables = await sim.fetch("https://db.internal/xrpc/com.lopecode.brain.db.sqlTables", { headers: { "x-brain-caller": "owner" } });
  expect((await tables.json()).tables.filter((t) => t.rule).map((t) => [t.table, t.type])).toEqual([["library_docs", "table"]]);
  return db.ran.length + " statements run";
}
// %%
test_db_sql_refuses_everything_when_the_plans_read_differently = {
  // A database whose plans open tables in a way the check does not read: here, the read is given another name.
  const renamed = Object.fromEntries(Object.entries(sqlPlanFixture.plans).map(([s, p]) => [s, p.map((o) => (o[0] === "OpenRead" ? ["OpenReadV2", ...o.slice(1)] : o))]));
  const db = sqlFakeDatabase({ plans: renamed });
  const sim = await simulate(db_service, { sql: db.run });
  const call = async (who, statements) => {
    const r = await sim.fetch("https://db.internal/xrpc/com.lopecode.brain.db.sql", { method: "POST", headers: { "x-brain-caller": who, "content-type": "application/json" }, body: JSON.stringify({ statements }) });
    return { status: r.status, data: await r.json() };
  };
  const refused = await call("worker:brain-x-metrics", [["INSERT INTO metrics_calls (t, worker, n) VALUES (?1, ?2, ?3) ON CONFLICT (t, worker) DO UPDATE SET n = n + excluded.n", 1, "a", 2]]);
  expect([refused.status, refused.data.error]).toEqual([503, "SqlCheckFailed"]);
  expect(refused.data.message).toContain("SELECT v FROM db_selftest_a: expected r:db_selftest_a, the plan says refused: the opcode OpenReadV2 is not one this check reads");
  expect(db.ran.map((s) => s[0])).toEqual(sqlSelfTest.setup);
  // The owner and the key-value tables do not pass through the check.
  expect((await call("owner", [["SELECT 1"]])).status).toBe(200);
  const put = await sim.fetch("https://db.internal/xrpc/com.lopecode.brain.db.put", { method: "POST", headers: { "x-brain-caller": "owner", "content-type": "application/json" }, body: JSON.stringify({ db: "site", table: "posts", key: "a", value: 1 }) });
  expect(put.status).toBe(200);
  return refused.data.message.length + " characters of reason";
}
// %%
test_db_declares_what_it_needs = {
  const { meta } = await db_service.emit();
  expect(meta).toMatchObject({ worker: "brain-db", role: "system", module: "@tomlarkworthy/brain-db", resources: ["database", "rows"], secrets: [] });
  expect(Object.entries(meta.access).filter(([m]) => m.includes(".db.")).map(([m, r]) => m.replace("com.lopecode.brain.db.", "") + " " + r.who).sort()).toEqual(["delete workers", "get anyone", "increment workers", "list anyone", "put workers", "setRule owner", "sql workers", "sqlGrant owner", "sqlTables owner", "tables owner"]);
  // Every secret method is fixed at the core.
  expect(Object.entries(meta.access).filter(([, r]) => r.fixed).map(([m]) => m.replace("com.lopecode.brain.", "")).sort()).toEqual(["secret.copy", "secret.delete", "secret.get", "secret.list", "secret.put", "secret.setRule"]);
  return Object.keys(meta.access).length + " methods";
}
