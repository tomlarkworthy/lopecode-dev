    "ALTER TABLE metrics_faults ADD COLUMN ms REAL": [["Init",0,41,0,0],["Null",0,1,2,0],["OpenEphemeral",1,0,1,0],["OpenRead",0,1,0,0],["Rewind",0,12,0,0],["Column",0,0,8,0],["Ne",9,11,8,82],["Column",0,1,8,0],["Ne",10,11,8,82],["Rowid",0,2,0,0],["Insert",1,1,2,0],["Next",0,5,0,1],["OpenWrite",0,1,0,0],["Rewind",1,33,0,0],["Rowid",1,2,0,0],["NotExists",0,32,2,0],["Column",0,0,3,0],["Column",0,1,4,0],["Column",0,2,5,0],["Column",0,3,6,0],["Column",0,4,14,0],["Function",1,13,12,0],["Concat",15,12,8,0],["Column",0,4,16,0],["Column",0,4,22,0],["Function",1,21,20,0],["Function",0,20,19,0],["Add",19,18,17,0],["Function",0,16,12,0],["Concat",12,8,7,0],["MakeRecord",3,5,11,0],["Insert",0,11,2,0],["Next",1,14,0,0],["ReadCookie",0,12,2,0],["AddImm",12,-2,0,0],["IfPos",12,37,0,0],["SetCookie",0,2,3,0],["SetCookie",0,1,23,0],["ParseSchema",0,0,0,3],["ParseSchema",1,0,0,3],["Halt",0,0,0,0],["Transaction",0,1,22,1],["String8",0,9,0,0],["String8",0,10,0,0],["String8",0,13,0,0],["String8",0,15,0,0],["Integer",1,18,0,0],["String8",0,21,0,0],["Goto",0,1,0,0]]
