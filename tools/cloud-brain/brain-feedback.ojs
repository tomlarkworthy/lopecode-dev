// Three notes of the owner's, 2026-10-11 20:31 to 20:40 CEST, had no kind and no File (page-feedback-filed-twice-never-arrived).
test_feedback_a_note_made_with_no_kind_is_a_feedback_note = {
  const rig = feedbackRig(), app = rig.app(), anchor = { module: "@tomlarkworthy/cloud-brain", cell: "healthView", surface: "element", frac: { fx: 0.5, fy: 0.5 } };
  const plain = rig.store.create, until = async (f) => { for (let i = 0; i < 100 && !f(); i++) await new Promise((r) => setTimeout(r, 10)); return !!f(); };
  // As annotate creates a plain note: no fields, and the record has no kind.
  expect(rig.store.create(anchor).kind).toBe(undefined);
  const back = app.byDefault();
  expect(rig.store.create.byDefault).toBe("feedback");
  const a = rig.store.create(anchor), el = app.note(a.id);
  expect([a.kind, el.querySelector("[data-feedback]").dataset.feedback, !!el.querySelector("textarea"), [...el.querySelectorAll("button")].map((b) => b.textContent)]).toEqual(["feedback", "draft", true, ["File"]]);
  // It files as a note of the kind does.
  ((box) => ((box.value = "The Health chart is not useful."), box.dispatchEvent(new Event("input", { bubbles: true }))))(el.querySelector("textarea"));
  el.querySelector("button").click();
  expect(await until(() => el.querySelector("[data-feedback=open]"))).toBe(true);
  expect([rig.calls.filter((c) => c[0] === "issue.open").map((c) => [c[1].id, c[1].labels]), rig.store.get(a.id).issue]).toEqual([[["fb-" + a.id, ["annotation"]]], "fb-" + a.id]);
  // Empty fields and a box alone are no kind; another kind and a source of the caller's own are left as they are.
  expect([rig.store.create(anchor, {}).kind, rig.store.create(anchor, undefined).kind, rig.store.create(anchor, null).kind]).toEqual(["feedback", "feedback", "feedback"]);
  expect(rig.store.create(anchor, { box: { w: 300 } })).toMatchObject({ kind: "feedback", box: { w: 300 } });
  expect([rig.store.create(anchor, { kind: "switchboard" }).kind, rig.store.create(anchor, { src: "1 + 1" }).kind]).toEqual(["switchboard", undefined]);
  // The cell ran again: the app before puts its own back, the next one is over the store's own, and takes that away in turn.
  back();
  expect([rig.store.create === plain, rig.store.create(anchor).kind]).toEqual([true, undefined]);
  const one = app.byDefault(), two = rig.app().byDefault();
  one();
  expect(rig.store.create(anchor).kind).toBe("feedback");
  two();
  expect(rig.store.create(anchor).kind).toBe(undefined);
  return "a note created with no kind is a feedback note with File, and files; another kind is left; taken away, a plain note is plain";
}
// %%
// The reviewer of page-feedback-filed-twice-never-arrived, 2026-10-11, read and not run: a draft's text is in a Map of the app.
// A note is a cell of the runtime and annotate keeps none elsewhere, so a reload takes the note with its text.
test_feedback_a_draft_is_kept_over_a_rebuild_and_a_reload = {
  const rig = feedbackRig(), anchor = { module: "@tomlarkworthy/brain-issues", cell: "issuesView", surface: "element", frac: { fx: 0.5, fy: 0.5 } }, box = { dx: 5, dy: 6, w: 300 };
  const type = (el, text) => ((t) => ((t.value = text), t.dispatchEvent(new Event("input", { bubbles: true }))))(el.querySelector("textarea"));
  const until = async (f) => { for (let i = 0; i < 100 && !f(); i++) await new Promise((r) => setTimeout(r, 10)); return !!f(); };
  const app = rig.app(), a = rig.store.create(anchor, { kind: "feedback", box }), el = app.note(a.id);
  // Nothing typed: nothing kept.
  expect(rig.kept.get()).toBe(null);
  type(el, "The list is too long\nto read.");
  expect(rig.kept.get()).toEqual({ [a.id]: { text: "The list is too long\nto read.", anchor, box } });
  // The cell ran again (a deploy changed one of its inputs): the note is still a cell, and the new app draws its text.
  const rebuilt = rig.app();
  expect(rebuilt.note(a.id).querySelector("textarea").value).toBe("The list is too long\nto read.");
  await rebuilt.sync();
  expect(rig.cells.size).toBe(1);
  // The page was loaded again: no cell is left. The first ask places the note where it was, with its text, and sends nothing but the list.
  rig.reload();
  const loaded = rig.app(), from = rig.calls.length;
  await loaded.sync();
  expect([rig.store.all().map((n) => [n.kind, n.anchor, n.box, n.draft, n.issue]), rig.calls.slice(from).map((c) => c[0])]).toEqual([[["feedback", anchor, box, a.id, undefined]], ["issue.list"]]);
  const b = rig.store.all()[0], el2 = loaded.note(b.id);
  expect([b.id === a.id, el2.querySelector("textarea").value, [...el2.querySelectorAll("button")].map((x) => x.textContent)]).toEqual([false, "The list is too long\nto read.", ["File"]]);
  // A later ask, and a second app on that page, place no second one.
  await loaded.sync();
  await rig.app().sync();
  expect(rig.cells.size).toBe(1);
  // Typed on: kept under the name it had, so there is one copy and the next load has the later text.
  type(el2, "The list is too long.");
  expect(rig.kept.get()).toEqual({ [a.id]: { text: "The list is too long.", anchor, box } });
  rig.reload();
  const third = rig.app();
  await third.sync();
  const c = rig.store.all()[0], el3 = third.note(c.id);
  expect([rig.cells.size, c.draft, el3.querySelector("textarea").value]).toEqual([1, a.id, "The list is too long."]);
  // Filed: the issue is named for the note the text was first typed in, the copy goes, and the next load places the issue's note alone.
  el3.querySelector("button").click();
  expect(await until(() => el3.querySelector("[data-feedback=open]"))).toBe(true);
  expect([rig.calls.filter((x) => x[0] === "issue.open").map((x) => [x[1].key, x[1].id, x[1].title]), rig.kept.get()]).toEqual([[["annotation/" + a.id, "fb-" + a.id, "The list is too long."]], {}]);
  rig.reload();
  await rig.app().sync();
  expect(rig.store.all().map((n) => [n.issue, n.draft])).toEqual([["fb-" + a.id, undefined]]);
  return "typed text is kept with its anchor and box; a new app on the page draws it; after a reload the note is placed again with it, once, and files under its first name";
}
// %%
test_feedback_a_kept_draft_goes_with_its_note_and_a_bad_copy_places_nothing = {
  const anchor = { cell: "services", surface: "element", frac: { fx: 0.1, fy: 0.2 } };
  const type = (el, text) => ((t) => ((t.value = text), t.dispatchEvent(new Event("input", { bubbles: true }))))(el.querySelector("textarea"));
  const until = async (f) => { for (let i = 0; i < 100 && !f(); i++) await new Promise((r) => setTimeout(r, 10)); return !!f(); };
  const rig = feedbackRig(), app = rig.app(), a = rig.store.create(anchor, { kind: "feedback" }), el = app.note(a.id);
  // The text taken out again, and spaces alone: no copy.
  type(el, "x");
  type(el, "");
  type(el, "  \n ");
  expect(rig.kept.get()).toEqual({});
  // The note's own x on a draft: the copy goes with it, and the next load places nothing.
  type(el, "Not this after all.");
  expect(Object.keys(rig.kept.get())).toEqual([a.id]);
  rig.store.remove(a.id);
  await app.gone();
  expect(rig.kept.get()).toEqual({});
  rig.reload();
  await rig.app().sync();
  expect(rig.cells.size).toBe(0);
  // The same on a note placed again after a reload and never drawn.
  const b = rig.store.create(anchor, { kind: "feedback" });
  type(app.note(b.id), "Nor this.");
  rig.reload();
  const loaded = rig.app();
  await loaded.sync();
  expect(rig.store.all().map((n) => n.draft)).toEqual([b.id]);
  rig.store.remove(rig.store.all()[0].id);
  await loaded.gone();
  expect([rig.kept.get(), rig.cells.size]).toEqual([{}, 0]);
  // A refused issue.open keeps the copy: the text is there after a reload.
  const c = rig.store.create(anchor, { kind: "feedback" }), elc = app.note(c.id);
  rig.client.refuse = "not now";
  type(elc, "Refused once.");
  elc.querySelector("button").click();
  expect(await until(() => elc.textContent.includes("issue.open was refused: not now"))).toBe(true);
  expect(rig.kept.get()[c.id].text).toBe("Refused once.");
  rig.client.refuse = null;
  // Another tab filed it while this page had it as a draft placed again: the next ask makes that note the issue's, and places no second.
  rig.reload();
  const tab = rig.app();
  await tab.sync();
  const d = rig.store.all()[0], eld = tab.note(d.id);
  expect([rig.cells.size, d.draft, eld.querySelector("textarea").value]).toEqual([1, c.id, "Refused once."]);
  await rig.client.procedure("issue.open", { id: "fb-" + c.id, title: "Refused once.", body: feedbackBody("Refused once.", { anchor, box: d.box }), kind: "feedback", about: "brain", labels: ["annotation"] });
  await tab.sync();
  expect([rig.store.all().map((n) => [n.id, n.issue]), tab.of.get(d.id), eld.querySelector("[data-feedback]").dataset.feedback, !!eld.querySelector("textarea"), rig.kept.get()]).toEqual([[[d.id, "fb-" + c.id]], "fb-" + c.id, "open", false, {}]);
  // A copy that is not what this module wrote places nothing and stops nothing.
  const anchor2 = { cell: "x" };
  for (const bad of ["text", 7, [1], { x: null }, { x: "s" }, { x: { text: 5, anchor: anchor2 } }, { x: { text: "  ", anchor: anchor2 } }, { x: { text: "t" } }, { x: { text: "t", anchor: "s" } }, { x: { text: "t", anchor: null } }]) {
    const r = feedbackRig();
    r.kept.set(bad);
    await r.app().sync();
    expect([JSON.stringify(bad), r.cells.size]).toEqual([JSON.stringify(bad), 0]);
  }
  // A browser that refuses the read or the write, and an app given no copy: a draft is typed and filed as before.
  for (const kept of [{ get: () => { throw new Error("refused"); }, set: () => { throw new Error("refused"); } }, undefined]) {
    const r = feedbackRig(), one = r.app({ kept });
    await one.sync();
    const n = r.store.create(anchor, { kind: "feedback" }), eln = one.note(n.id);
    type(eln, "Typed with no copy.");
    eln.querySelector("button").click();
    expect(await until(() => eln.querySelector("[data-feedback=open]"))).toBe(true);
    expect([r.cells.size, r.calls.filter((x) => x[0] === "issue.open").map((x) => x[1].id)]).toEqual([1, ["fb-" + n.id]]);
  }
  return "an emptied or removed draft leaves no copy; a refusal keeps it; a draft filed elsewhere becomes that issue's note; a copy of another shape places nothing";
}
// %%
// The copy is in this browser: a name of the test's own, taken away after.
test_feedback_kept_is_one_item_of_the_browser_for_an_address = {
  const k = feedbackKept("test " + Math.random().toString(36).slice(2)), ls = (() => { try { return globalThis.localStorage || null; } catch (e) { return null; } })();
  expect([k.name.startsWith("brain_feedback_drafts test "), feedbackKept("https://a.example").name, feedbackKept().name]).toEqual([true, "brain_feedback_drafts https://a.example", "brain_feedback_drafts "]);
  if (!ls) {
    k.set({ a: { text: "x" } });
    expect(k.get()).toBe(null);
    return "no storage here: a write is dropped and a read is null";
  }
  try {
    expect(k.get()).toBe(null);
    k.set({ a: { text: "x", anchor: { cell: "c" } } });
    expect([feedbackKept(k.name.slice("brain_feedback_drafts ".length)).get(), JSON.parse(ls.getItem(k.name))]).toEqual([{ a: { text: "x", anchor: { cell: "c" } } }, { a: { text: "x", anchor: { cell: "c" } } }]);
    // Nothing left to keep: the item is taken away, not written empty.
    k.set({});
    expect([ls.getItem(k.name), k.get()]).toEqual([null, null]);
    ls.setItem(k.name, "{not json");
    expect(k.get()).toBe(null);
  } finally {
    ls.removeItem(k.name);
  }
  return "one item for an address, read by any app on it; an empty copy is removed; text that is not JSON reads as none";
}
// %%
// feedbackSync asks every 30 s, and each ask drew every note again: a box being typed in was put in the place of a new one.
test_feedback_an_ask_leaves_a_draft_box_as_it_is = {
  const rig = feedbackRig(), anchor = { cell: "services", surface: "element", frac: { fx: 0.1, fy: 0.2 } };
  await rig.client.procedure("issue.open", { id: "fb-other", title: "Other", body: feedbackBody("Other", { anchor }), kind: "feedback", about: "brain", labels: ["annotation"] });
  const app = rig.app();
  await app.sync();
  const a = rig.store.create(anchor, { kind: "feedback" }), el = app.note(a.id), box = el.querySelector("textarea");
  const other = app.note([...app.of.keys()][0]), drawn = other.firstElementChild;
  box.value = "Half a sentence";
  box.dispatchEvent(new Event("input", { bubbles: true }));
  // Another caller's event on another note, read by the next ask: that note is drawn again, the draft's box is the same element.
  rig.say("fb-other", { type: "moved", from: "open", to: "triaged", reason: "Real." }, { state: "triaged" });
  await app.sync();
  expect([other.firstElementChild === drawn, other.querySelector("b").textContent, el.querySelector("textarea") === box, box.value]).toEqual([false, "triaged", true, "Half a sentence"]);
  return "an ask draws the notes of issues again and leaves the box of a draft, with its caret, as it is";
}
// %%
test_feedback_load_places_a_note_for_each_labeled_issue = {
  const rig = feedbackRig(), anchor = { module: "@tomlarkworthy/cloud-brain", cell: "services", surface: "element", frac: { fx: 0.1, fy: 0.2 } };
  await rig.client.procedure("issue.open", { id: "fb-one", title: "One", body: feedbackBody("One", { anchor, box: { dx: 5, dy: 6, w: 300 } }), kind: "feedback", about: "brain", labels: ["annotation"] });
  await rig.client.procedure("issue.open", { id: "by-hand", title: "Labeled by hand", body: "no anchor", kind: "feedback", about: "brain", labels: ["annotation"] });
  await rig.client.procedure("issue.open", { id: "other", title: "Not a note", body: feedbackBody("x", { anchor }), kind: "feedback", about: "brain", labels: [] });
  const app = rig.app();
  await app.sync();
  expect(rig.store.all()).toEqual([{ id: "a2t1", anchor, kind: "feedback", issue: "fb-one", box: { dx: 5, dy: 6, w: 300 } }]);
  // A second ask reads nothing again and places nothing again.
  const before = rig.calls.length;
  await app.sync();
  expect([rig.calls.slice(before).map((c) => c[0]), rig.cells.size]).toEqual([["issue.list"], 1]);
  // Progress: a comment by the loop is read on the next ask, and drawn.
  const el = app.note("a2t1");
  rig.say("fb-one", { type: "commented", body: "Looking at the Services table now." });
  await app.sync();
  // A comment is read and is not drawn: the note is the request and the latest state.
  expect([rig.calls.slice(-1)[0], el.querySelector("[data-feedback-asked]").textContent, el.querySelector("b").textContent, el.textContent.includes("Looking at the Services table now.")]).toEqual([["issue.get", { id: "fb-one" }], "One", "open", false]);
  rig.say("fb-one", { type: "linked", rel: "cause", to: "services-table-width" }, { links: [{ rel: "cause", to: "services-table-width" }] });
  await app.sync();
  expect(el.textContent.includes("services-table-width")).toBe(false);
  // The label taken off elsewhere: the note leaves this page too, with no call of its own.
  rig.issues.get("fb-one").issue.labels = [];
  const calls = rig.calls.length;
  await app.sync();
  expect([rig.cells.size, app.of.size, rig.calls.slice(calls).map((c) => c[0])]).toEqual([0, 0, ["issue.list", "issue.get"]]);
  return "one note for the issue with the label and an anchor; none for a body without one; progress is read when updated_at moves";
}
// %%
test_feedback_done_then_remove_takes_the_label_off = {
  const rig = feedbackRig(), anchor = { cell: "services", surface: "element", frac: { fx: 0.1, fy: 0.2 } };
  for (const id of ["fb-done", "fb-open"]) await rig.client.procedure("issue.open", { id, title: id, body: feedbackBody(id, { anchor }), kind: "feedback", about: "brain", labels: ["annotation"] });
  const app = rig.app();
  await app.sync();
  const idOf = (iss) => [...app.of].find(([, i]) => i === iss)[0], el = app.note(idOf("fb-done"));
  expect(el.querySelector("button")).toBe(null);
  rig.say("fb-done", { type: "moved", from: "open", to: "closed", reason: "The table scrolls sideways now: brain-x-page 1a2b3c." }, { state: "closed", closed: true });
  await app.sync();
  expect([el.querySelector("[data-feedback]").dataset.feedback, el.querySelector("b").textContent, el.querySelector("[data-feedback-reason]").textContent]).toEqual(["done", "Done", "The table scrolls sideways now: brain-x-page 1a2b3c."]);
  // Remove: the cell goes, the label goes, and the next ask places nothing.
  el.querySelector("button").click();
  for (let i = 0; i < 100 && rig.issues.get("fb-done").issue.labels.length; i++) await new Promise((r) => setTimeout(r, 10));
  expect(rig.calls.filter((c) => c[0] === "issue.label")).toEqual([["issue.label", { key: "annotation/fb-done/removed", id: "fb-done", remove: ["annotation"] }]]);
  await app.sync();
  expect(rig.store.all().map((a) => a.issue)).toEqual(["fb-open"]);
  // The note of an open issue closed with annotate's own x: no call, hidden here, and back on the next load.
  rig.store.remove(idOf("fb-open"));
  await app.gone();
  await app.sync();
  expect([rig.calls.filter((c) => c[0] === "issue.label").length, rig.cells.size, [...app.hidden]]).toEqual([1, 0, ["fb-open"]]);
  const reloaded = rig.app();
  await reloaded.sync();
  expect(rig.store.all().map((a) => a.issue)).toEqual(["fb-open"]);
  return "a closed issue reads Done with its reason; Remove takes the label off once; an open one comes back on the next load";
}
// %%
// The loop closes a feedback issue when it is gathered into a project (fb-a2kw99i9wy, events 862 to 866 on cb4).
test_feedback_a_gathered_note_follows_what_it_is_part_of = {
  const rig = feedbackRig(), anchor = { cell: "services", surface: "element", frac: { fx: 0.1, fy: 0.2 } };
  await rig.client.procedure("issue.open", { id: "fb-dash", title: "Dashboards", body: feedbackBody("we should have a better abstraction for dashboards", { anchor }), kind: "feedback", about: "brain", labels: ["annotation"] });
  await rig.client.procedure("issue.open", { id: "proj", title: "Dashboards share a series", body: "a spec", kind: "project", about: "brain", labels: [] });
  rig.say("proj", { type: "moved", from: "open", to: "spec-review", reason: "The spec is written." }, { state: "spec-review" });
  rig.say("fb-dash", { type: "moved", from: "open", to: "closed", reason: "In the spec of a-name-that-was-refused." }, { state: "closed", closed: true });
  rig.say("fb-dash", { type: "linked", rel: "part-of", to: "proj" }, { parent: "proj" });
  rig.say("fb-dash", { type: "commented", body: "The project is proj." });
  const app = rig.app();
  await app.sync();
  const id = [...app.of.keys()][0], el = app.note(id), labels = () => rig.calls.filter((c) => c[0] === "issue.label").length;
  const reads = (from) => rig.calls.slice(from).map((c) => c[0] + (c[1].id ? " " + c[1].id : ""));
  // Closed, and the project it is part of is not: not Done, no Remove, and the project's state is what it reads.
  expect([el.querySelector("[data-feedback]").dataset.feedback, el.querySelector("b").textContent, el.querySelector("button"), el.querySelector("[data-feedback-reason]")]).toEqual(["gathered", "spec-review", null, null]);
  expect([el.querySelector("code").textContent, el.querySelector("[data-feedback-asked]").textContent, el.textContent.includes("The project is proj.")]).toEqual(["proj", "we should have a better abstraction for dashboards", false]);
  // The project is read again on each ask, though nothing listed moved; its last event is drawn when it is the later one.
  let from = rig.calls.length;
  await app.sync();
  expect(reads(from)).toEqual(["issue.list", "issue.get proj"]);
  rig.say("proj", { type: "moved", from: "spec-review", to: "building", reason: "The owner approved the spec." }, { state: "building" });
  await app.sync();
  expect([el.querySelector("b").textContent, el.querySelector("code").textContent, el.textContent.includes("The owner approved the spec."), el.querySelector("button")]).toEqual(["building", "proj", false, null]);
  // The box's x on it: hidden here, the label stays, and it is back on the next load.
  rig.store.remove(id);
  await app.gone();
  expect([labels(), [...app.hidden], rig.issues.get("fb-dash").issue.labels]).toEqual([0, ["fb-dash"], ["annotation"]]);
  const loaded = rig.app();
  await loaded.sync();
  const id2 = [...loaded.of.keys()][0], el2 = loaded.note(id2);
  expect([rig.store.all().map((a) => a.issue), el2.querySelector("b").textContent]).toEqual([["fb-dash"], "building"]);
  // The project is done: the note reads Done with the project's reason, and Remove takes the label off.
  rig.say("proj", { type: "moved", from: "building", to: "done", reason: "The dashboards share one series: brain-x-page 4d5e6f." }, { state: "done", closed: true });
  await loaded.sync();
  expect([el2.querySelector("[data-feedback]").dataset.feedback, el2.querySelector("b").textContent, el2.querySelector("[data-feedback-reason]").textContent]).toEqual(["done", "Done", "proj done: The dashboards share one series: brain-x-page 4d5e6f."]);
  el2.querySelector("button").click();
  for (let i = 0; i < 100 && rig.issues.get("fb-dash").issue.labels.length; i++) await new Promise((r) => setTimeout(r, 10));
  expect([labels(), rig.cells.size]).toEqual([1, 0]);
  // A link said of another issue is followed the same way; one that cannot be read is not done.
  await rig.client.procedure("issue.open", { id: "fb-dup", title: "Dup", body: feedbackBody("Dup", { anchor }), kind: "feedback", about: "brain", labels: ["annotation"] });
  await rig.client.procedure("issue.open", { id: "task", title: "A task", body: "", kind: "task", about: "brain", labels: [] });
  rig.say("fb-dup", { type: "moved", from: "open", to: "closed", reason: "The same report." }, { state: "closed", closed: true, links: [{ rel: "cause", to: "task" }, { rel: "related", to: "nowhere" }] });
  const open = (t) => feedbackProgress(rig.issues.get("fb-dup"), feedbackFollows(rig.issues.get("fb-dup").issue).map((f) => t[f]));
  expect(feedbackFollows(rig.issues.get("fb-dup").issue)).toEqual(["task", "nowhere"]);
  const shut = { issue: { id: "x", state: "done", closed: true }, events: [] };
  expect([open({}).done, open({ task: shut }).done, open({ task: shut, nowhere: { issue: { id: "nowhere", state: "open", closed: false, hidden: true }, events: [] } }).done, open({ task: shut, nowhere: shut }).done]).toEqual([false, false, false, true]);
  expect([feedbackFollows({ closed: false, parent: "proj" }), feedbackFollows(null)]).toEqual([[], []]);
  return "a closed note whose project is open reads gathered with the project's state and has no Remove; Done and Remove when the project is closed";
}
// %%
// The loop closed fb-a2kw99i9wy 15.5 s before it linked it (events 863, 865), and writes a cost comment after every round.
test_feedback_a_close_waits_for_its_link_and_a_cost_comment_is_not_progress = {
  const rig = feedbackRig(), anchor = { cell: "services", surface: "element", frac: { fx: 0.1, fy: 0.2 } };
  for (const id of ["fb-late", "fb-alone"]) await rig.client.procedure("issue.open", { id, title: id, body: feedbackBody(id, { anchor }), kind: "feedback", about: "brain", labels: ["annotation"] });
  await rig.client.procedure("issue.open", { id: "proj", title: "A project", body: "", kind: "project", about: "brain", labels: [] });
  for (const id of ["fb-late", "fb-alone"]) rig.say(id, { type: "moved", from: "open", to: "closed", reason: "In the spec of proj." }, { state: "closed", closed: true });
  const closedAt = rig.at(), app = rig.app();
  rig.setNow(closedAt + 15000);
  await app.sync();
  const idOf = (iss) => [...app.of].find(([, i]) => i === iss)[0], late = app.note(idOf("fb-late")), alone = app.note(idOf("fb-alone"));
  const reads = (el) => [el.querySelector("[data-feedback]").dataset.feedback, el.querySelector("b").textContent, el.querySelector("button"), (el.querySelector("[data-feedback-reason]") || {}).textContent];
  // Closed a moment ago with a reason and nothing else: not Done yet, no Remove, and the x only hides it.
  expect([reads(late), reads(alone)]).toEqual([["closed", "closed", null, "In the spec of proj."], ["closed", "closed", null, "In the spec of proj."]]);
  expect(late.querySelector("[data-feedback-wait]").textContent.includes(new Date(closedAt + feedbackLimits.waitMs).toLocaleTimeString())).toBe(true);
  rig.store.remove(idOf("fb-alone"));
  await app.gone();
  expect([rig.calls.filter((c) => c[0] === "issue.label").length, [...app.hidden]]).toEqual([0, ["fb-alone"]]);
  // The link arrives on a later ask: gathered, and it never read Done.
  rig.say("fb-late", { type: "linked", rel: "part-of", to: "proj" }, { parent: "proj" });
  rig.setNow(closedAt + 45000);
  await app.sync();
  expect([reads(late), late.querySelector("code").textContent]).toEqual([["gathered", "open", null, undefined], "proj"]);
  // Nothing was linked to the other within the wait: Done by its own reason, with Remove. One ms before, not.
  const of = (ms) => ((p) => [p.done, p.settling, p.gathered])(feedbackProgress(rig.issues.get("fb-alone"), [], { now: closedAt + ms }));
  expect([of(feedbackLimits.waitMs - 1), of(feedbackLimits.waitMs)]).toEqual([[false, true, false], [true, false, false]]);
  rig.setNow(closedAt + feedbackLimits.waitMs);
  const loaded = rig.app();
  await loaded.sync();
  const el = loaded.note([...loaded.of].find(([, i]) => i === "fb-alone")[0]);
  expect([reads(el).slice(0, 2), !!el.querySelector("button"), reads(el)[3], el.querySelector("[data-feedback-wait]")]).toEqual([["done", "Done"], true, "In the spec of proj.", null]);
  // The loop's cost record after a round is not what the note says of the project: the event before it is.
  rig.say("proj", { type: "moved", from: "open", to: "awaiting-approval", reason: "pass (review round 2)." }, { state: "awaiting-approval" });
  rig.say("proj", { type: "commented", body: 'cost {"role":"reviewer","round":2,"tokens":106356}' });
  rig.say("fb-late", { type: "commented", body: 'cost {"role":"implementer","round":1}' });
  await app.sync();
  expect([late.textContent.includes("cost {"), feedbackProgress(app.tickets.get("fb-late"), [rig.issues.get("proj")]).last.text, late.querySelector("b").textContent]).toEqual([false, "proj: pass (review round 2).", "awaiting-approval"]);
  // An open issue that is part of another reads no state of it, and asks for nothing more.
  await rig.client.procedure("issue.open", { id: "fb-open", title: "open", body: feedbackBody("open", { anchor }), kind: "feedback", about: "brain", labels: ["annotation"] });
  rig.say("fb-open", { type: "linked", rel: "part-of", to: "proj" }, { parent: "proj" });
  expect([feedbackFollows(rig.issues.get("fb-open").issue), feedbackProgress(rig.issues.get("fb-open")).links]).toEqual([[], ["part of proj"]]);
  return "a close with a reason alone is not Done for " + feedbackLimits.waitMs / 60000 + " min; a link made after it gives gathered; a cost comment is not shown";
}
// %%
// With annotate's own store, under a kind of the test's own: this page may have no kind feedback registered.
test_feedback_cells_stay_in_this_module_with_annotates_store = {
  const rig = feedbackRig(), limits = { ...feedbackLimits, kind: "feedbacktest" }, app = feedbackApp({ client: rig.client, store: a2Store, limits });
  const until = async (f) => { for (let i = 0; i < 200 && !(await f()); i++) await new Promise((r) => setTimeout(r, 25)); return !!(await f()); };
  const off = plugins.add("annotate-kinds", { ...app.kind, note: () => "1 + 1" });
  const mine = () => a2Store.all().filter((a) => a.kind === limits.kind);
  try {
    expect(await until(() => a2Store.kindOf(limits.kind))).toBe(true);
    const anchor = { module: "@tomlarkworthy/cloud-brain", cell: "services", surface: "element", frac: { fx: 0.5, fy: 0.5 } };
    await rig.client.procedure("issue.open", { id: "fb-real", title: "Real", body: feedbackBody("Real", { anchor, box: { dx: 7, dy: 8, w: 300 } }), kind: "feedback", about: "brain", labels: ["annotation"] });
    await app.sync();
    expect(mine().map((a) => [a.issue, a.home, a.anchor.module, a.box])).toEqual([["fb-real", limits.home, "@tomlarkworthy/cloud-brain", { dx: 7, dy: 8, w: 300 }]]);
    const id = mine()[0].id;
    // Moving the box writes the record again; it stays in this module, and the issue stays on it.
    a2Store.patch(id, { box: { dx: 9, dy: 9, w: 300 } });
    await a2Store.refresh();
    expect(mine().map((a) => [a.issue, a.home, a.box.dx])).toEqual([["fb-real", limits.home, 9]]);
    // A second app (the cell ran again) finds the note by what the record keeps.
    const again = feedbackApp({ client: rig.client, store: a2Store, limits });
    await again.sync();
    expect([again.of.get(id), mine().length]).toEqual(["fb-real", 1]);
    // Closed, then removed with the store's own remove (the box's x): the label comes off.
    rig.say("fb-real", { type: "moved", from: "open", to: "closed", reason: "done" }, { state: "closed", closed: true });
    await app.sync();
    a2Store.remove(id);
    await app.gone();
    expect([mine().length, rig.issues.get("fb-real").issue.labels, rig.calls.filter((c) => c[0] === "issue.label").length]).toEqual([0, [], 1]);
    // A draft the browser kept from before a reload is placed again in annotate's own store: here, with its name and its box.
    let copy = { a2was: { text: "Typed before the reload.", anchor, box: { dx: 3, dy: 4, w: 280 } } };
    const loaded = feedbackApp({ client: rig.client, store: a2Store, limits, kept: { get: () => copy, set: (all) => void (copy = all) } });
    await loaded.sync();
    await a2Store.refresh();
    expect(mine().map((a) => [a.draft, a.issue, a.home, a.anchor.module, a.box])).toEqual([["a2was", undefined, limits.home, "@tomlarkworthy/cloud-brain", { dx: 3, dy: 4, w: 280 }]]);
    expect(loaded.note(mine()[0].id).querySelector("textarea").value).toBe("Typed before the reload.");
    await loaded.sync();
    expect(mine().length).toBe(1);
    a2Store.remove(mine()[0].id);
    await loaded.gone();
    expect([mine().length, copy]).toEqual([0, {}]);
    return "placed in " + limits.home + " for a note about another module; kept there after a move; removed with the label";
  } finally {
    for (const a of mine()) a2Store.remove(a.id);
    off();
  }
}
// %%
test_feedback_near_reads_under_the_anchor_and_a_kept_note_without_its_label_goes = {
  // The anchor is what is resolved, not the record, whose cell is the note itself.
  const asked = [], el = { closest: (s) => s === ".observablehq", textContent: "Services" }, layer = { closest: () => true, textContent: "the note" };
  const doc = { elementsFromPoint: (x, y) => (asked.push([x, y]), [layer, el]) };
  expect([feedbackNear({ cell: "annotation_x_note", anchor: { cell: "services" } }, { resolve: (a) => (asked.push(a), { kind: "point", x: 3, y: 4 }), doc }), asked]).toEqual(["Services", [{ cell: "services" }, [3, 4]]]);
  expect(feedbackNear({ anchor: {} }, { resolve: () => ({ kind: "rects", rects: [{ left: 10, top: 20 }] }), doc })).toBe("Services");
  expect(feedbackNear({ anchor: {} }, { resolve: () => { throw new Error("gone"); }, doc })).toBe("");
  // A note kept from before, whose issue lost the label while no page was open: read once, then taken away.
  const rig = feedbackRig();
  await rig.client.procedure("issue.open", { id: "fb-old", title: "Old", body: feedbackBody("Old", { anchor: { cell: "x" } }), kind: "feedback", about: "brain", labels: [] });
  const a = rig.store.create({ cell: "x" }, { kind: "feedback", issue: "fb-old" });
  const app = rig.app();
  await app.sync();
  expect([rig.cells.size, app.of.size, rig.calls.slice(1).map((c) => c[0])]).toEqual([0, 0, ["issue.list", "issue.get"]]);
  return "near resolves the anchor; a kept note of an issue with no label is removed on the first ask";
}
// %%
test_feedback_is_off_away_from_the_owners_page = {
  expect(feedbackOn).toBe(!!brainOrigin && !brainPortal && !!(brainWho && brainWho.owner) && !/[#&]verify=/.test(location.hash));
  // The default kind of a note is set on the owner's page and nowhere else.
  expect([feedbackDefault === "off", a2Store.create.byDefault]).toEqual(feedbackOn ? [false, feedbackLimits.kind] : [true, undefined]);
  if (feedbackOn) return "on: this is the Brain's address with the owner signed in";
  expect([feedback, feedbackSync, feedbackNote("x").textContent]).toEqual([null, "off", "Feedback notes are for the owner, signed in at the Brain's address."]);
  expect(feedbackKind.startsWith("off: ")).toBe(true);
  return "off here (" + feedbackKind.slice(5) + "): no kind registered, no call made";
}
