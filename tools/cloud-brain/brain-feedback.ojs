test_feedback_body_keeps_the_anchor_and_says_where = {
  const anchor = { module: "@tomlarkworthy/brain-issues", cell: "issuesView", pid: "_p1", surface: "text", quote: { prefix: "For ", exact: "your attention", suffix: "" } };
  const body = feedbackBody("  The count is wrong.\nIt says 3.  ", { anchor, box: { dx: 1, dy: 2, w: 280 } });
  expect(body.startsWith("The count is wrong.\nIt says 3.\n\nAnnotated on the Brain's page: module `@tomlarkworthy/brain-issues`, cell `issuesView`, at the text \"your attention\".\n\n")).toBe(true);
  expect(feedbackParse(body)).toEqual({ text: "The count is wrong.\nIt says 3.", anchor, box: { dx: 1, dy: 2, w: 280 } });
  // Text that has a fence of its own, and a body nobody wrote this way.
  const fence = "`".repeat(3);
  expect(feedbackParse(feedbackBody(`see ${fence}annotation\n{"anchor":1}\n${fence}`, { anchor: { cell: "x" } })).anchor).toEqual({ cell: "x" });
  expect([feedbackParse("plain"), feedbackParse(`${fence}annotation\nnot json\n${fence}`), feedbackParse(`${fence}annotation\n{"box":{}}\n${fence}`), feedbackParse(undefined)]).toEqual([null, null, null, null]);
  expect([feedbackWhere({}), feedbackWhere({ quote: { exact: "foo" } }), feedbackWhere({}, " Services\n table ")]).toEqual(["Annotated on the Brain's page: no cell.", "Annotated on the Brain's page: at the text \"foo\", no cell.", "Annotated on the Brain's page: on the element that reads \"Services table\", no cell."]);
  return "the text, the sentence and the anchor go into a body and come back; a body without an anchor is null";
}
// %%
test_feedback_file_opens_an_issue_and_the_note_shows_it = {
  const rig = feedbackRig(), app = rig.app();
  const a = rig.store.create({ module: "@tomlarkworthy/brain-issues", cell: "issuesView", surface: "element", frac: { fx: 0.5, fy: 0.5 } }, { kind: "feedback" });
  const el = app.note(a.id), press = (name) => [...el.querySelectorAll("button")].find((b) => b.textContent === name).click();
  const until = async (f) => { for (let i = 0; i < 100 && !f(); i++) await new Promise((r) => setTimeout(r, 10)); return !!f(); };
  expect(el.querySelector("[data-feedback]").dataset.feedback).toBe("draft");
  // Nothing written: nothing is sent.
  press("File");
  expect(await until(() => el.textContent.includes("Write something first."))).toBe(true);
  expect(rig.calls).toEqual([]);
  const type = (text) => ((box) => ((box.value = text), box.dispatchEvent(new Event("input", { bubbles: true }))))(el.querySelector("textarea"));
  // A refusal is said in the note, the text is kept, and the note is still a draft.
  rig.client.refuse = "not now";
  type("The table is too wide\non a phone.");
  press("File");
  expect(await until(() => el.textContent.includes("issue.open was refused: not now"))).toBe(true);
  expect([el.querySelector("textarea").value, app.of.size]).toEqual(["The table is too wide\non a phone.", 0]);
  rig.client.refuse = null;
  press("File");
  expect(await until(() => el.querySelector("[data-feedback=open]"))).toBe(true);
  const sent = rig.calls.filter((c) => c[0] === "issue.open").at(-1)[1];
  expect(sent).toMatchObject({ key: "annotation/a2t1", id: "fb-a2t1", title: "The table is too wide", kind: "feedback", about: "brain-x-issues", labels: ["annotation"] });
  expect(feedbackParse(sent.body)).toEqual({ text: "The table is too wide\non a phone.", anchor: a.anchor, box: a.box });
  expect(sent.body.includes("Annotated on the Brain's page: module `@tomlarkworthy/brain-issues`, cell `issuesView`, on the element that reads \"Services table\".")).toBe(true);
  expect([el.textContent.includes("open"), el.textContent.includes("fb-a2t1"), el.textContent.includes("on a phone."), rig.store.get(a.id).issue, !!el.querySelector("textarea")]).toEqual([true, true, true, "fb-a2t1", false]);
  // A second app on the same page (the cell ran again) takes the filed note as its own and places no second one.
  const again = rig.app();
  await again.sync();
  expect([again.of.get(a.id), rig.cells.size]).toEqual(["fb-a2t1", 1]);
  return "an empty note sends nothing; a refusal keeps the text; File sends issue.open with the anchor and the note shows the issue";
}
