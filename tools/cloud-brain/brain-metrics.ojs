md`# brain-metrics

Call counts, latency and errors for a Cloud Brain, and the charts that read them.

| | |
|---|---|
| Worker | \`brain-x-metrics\` |
| \`metrics.record\` | procedure, \`worker:brain-core\`. Stores one batch. |
| \`metrics.query\` | query, anyone. \`since\`, \`until\` (ms), \`step\` (ms, at least 60000). At most 8 days. |
| Storage | \`sql\`: two tables in the Brain's table database, reached through \`brain-db\`. \`metrics_calls(t, worker, version, method, caller, status, n, ms, max)\`, one row per minute and combination, and \`metrics_faults(t, worker, version, method, caller, status, ms)\`. Rows older than 14 days are deleted. |

The core counts every call it answers or forwards and sends a batch every 10 s, or at once after a fault. A fault is a status of 500 or above, except 501, which is the answer to a name no service declares. A batch:

\`\`\`js
{ from, to,                                                   // ms
  buckets: [{ worker, version, method, caller, status, n, ms, max }],  // ms is the sum over n calls
  errors:  [{ t, worker, version, method, caller, status, ms }] }      // faults
\`\`\`

\`version\` is the first 12 characters of the hash of the Worker that answered, read from the \`x-brain-served-by\` header every Worker adds to its responses. \`caller\` is \`owner\`, \`anonymous\`, \`token\`, \`did\`, \`deployer\` or \`worker:NAME\`. \`method\` is the name after \`com.lopecode.brain.\`, a declared path, or \`(unknown)\` for a name no service declares. Calls to \`metrics.*\` are not counted.

Not counted: calls that do not pass through the core (the deployer's health checks, a Worker's own \`fetch\` to the internet, sign-in on the kernel). Counts held by a core isolate that stops before its next call are lost, up to 10 s of them.`
// %%
metrics_service = cloudflare.Service("metrics", metricsApp, {
  methods: {
    "com.lopecode.brain.metrics.record": { type: "procedure", who: "worker:brain-core" },
    "com.lopecode.brain.metrics.query": { type: "query", who: "anyone" }
  }
})
// %%
metrics_announce = {
  plugins.add("workers", metrics_service, { invalidation });
  return "announced metrics_service";
}
// %%
metricsApp = {
  const app = new hono.Hono();
  const NS = "/xrpc/com.lopecode.brain.metrics.";
  const fail = (c, status, error, message) => c.json({ error, message }, status);
  const DAY = 86400000, MINUTE = 60000, KEEP = 14;
  // Made by the first call an instance answers. A call is counted into the row of its minute.
  let ready = null, pruned = 0;
  // One call each: brain-db reads the plan of every statement of a batch before it runs any, and an index cannot
  // be planned on a table the same batch makes.
  const schema = () =>
    (ready ??= (async () => {
      for (const s of metricsSchema) await sql.exec(s);
    })().catch((e) => {
      ready = null;
      throw e;
    }));
  app.post(NS + "record", async (c) => {
    const b = await c.req.json().catch(() => null);
    if (!b || !Array.isArray(b.buckets)) return fail(c, 400, "InvalidRequest", "buckets");
    await schema();
    const t = Math.floor((Number(b.from) || Date.now()) / MINUTE) * MINUTE;
    const writes = [];
    for (const x of b.buckets.slice(0, 500))
      writes.push([metricsSql.count, t, String(x.worker), String(x.version || ""), String(x.method), String(x.caller), Number(x.status) || 0, Number(x.n) || 0, Number(x.ms) || 0, Number(x.max) || 0]);
    for (const x of (b.errors || []).slice(0, 50))
      writes.push([metricsSql.fault, Number(x.t) || t, String(x.worker), String(x.version || ""), String(x.method), String(x.caller), Number(x.status) || 0, Number(x.ms) || 0]);
    if (writes.length) await sql.batch(writes);
    return c.json({ stored: b.buckets.length });
  });
  app.get(NS + "query", async (c) => {
    const until = Number(c.req.query("until")) || Date.now();
    const since = Number(c.req.query("since")) || until - 3600000;
    const step = Math.max(MINUTE, Math.floor((Number(c.req.query("step")) || MINUTE) / MINUTE) * MINUTE);
    if (!(until > since) || until - since > 8 * DAY) return fail(c, 400, "InvalidRequest", "since and until, at most 8 days apart");
    await schema();
    // Once a day for each instance: delete what is past KEEP.
    if (Date.now() - pruned > DAY) {
      pruned = Date.now();
      await sql.batch([[metricsSql.pruneCalls, pruned - KEEP * DAY], [metricsSql.pruneFaults, pruned - KEEP * DAY]]);
    }
    // A minute is in the range when any of it is.
    const from = Math.floor(since / MINUTE) * MINUTE;
    const [series, errors] = await sql.batch([[metricsSql.series, from, until, step], [metricsSql.faults, since, until]]);
    return c.json({ since, until, step, series: series.rows, errors: errors.rows });
  });
  return app;
}
// %%
metricsSchema = [
  "CREATE TABLE IF NOT EXISTS metrics_calls (t INTEGER NOT NULL, worker TEXT NOT NULL, version TEXT NOT NULL, method TEXT NOT NULL, caller TEXT NOT NULL, status INTEGER NOT NULL, n INTEGER NOT NULL, ms REAL NOT NULL, max REAL NOT NULL, PRIMARY KEY (t, worker, version, method, caller, status)) WITHOUT ROWID",
  "CREATE TABLE IF NOT EXISTS metrics_faults (t INTEGER NOT NULL, worker TEXT NOT NULL, version TEXT NOT NULL, method TEXT NOT NULL, caller TEXT NOT NULL, status INTEGER NOT NULL, ms REAL NOT NULL)",
  "CREATE INDEX IF NOT EXISTS metrics_faults_t ON metrics_faults (t)"
]
// %%
metricsSql = ({
  count:
    "INSERT INTO metrics_calls (t, worker, version, method, caller, status, n, ms, max) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7, ?8, ?9) ON CONFLICT (t, worker, version, method, caller, status) DO UPDATE SET n = n + excluded.n, ms = ms + excluded.ms, max = MAX(max, excluded.max)",
  fault: "INSERT INTO metrics_faults (t, worker, version, method, caller, status, ms) VALUES (?1, ?2, ?3, ?4, ?5, ?6, ?7)",
  series:
    // D1 binds a number as a float, and t / 300000.0 does not round down: the step is cast.
    "SELECT (t / CAST(?3 AS INTEGER)) * CAST(?3 AS INTEGER) AS t, worker, version, method, caller, status, SUM(n) AS n, SUM(ms) AS ms, MAX(max) AS max FROM metrics_calls WHERE t >= ?1 AND t <= ?2 GROUP BY 1, worker, version, method, caller, status ORDER BY 1",
  faults: "SELECT t, worker, version, method, caller, status, ms FROM metrics_faults WHERE t >= ?1 AND t <= ?2 ORDER BY t DESC LIMIT 500",
  pruneCalls: "DELETE FROM metrics_calls WHERE t < ?1",
  pruneFaults: "DELETE FROM metrics_faults WHERE t < ?1"
})
// %%
md`## Dashboard

\`metricsData\` is the answer of \`metrics.query\` for the chosen range, in 60 steps. Without a Brain (a local copy of the notebook) it is \`sampleMetrics()\`, and the heading says so. Each chart is a function of that answer:

| | |
|---|---|
| \`healthStrip(data)\` | one row per Worker, one cell per step, coloured by the share of calls that were faults |
| \`requestsChart(data)\` | calls per step, stacked by Worker |
| \`latencyChart(data)\` | mean (line) and slowest (dot) call per step, by Worker, in ms |
| \`errorsChart(data)\` | calls per step that returned 400 or above, by status |
| \`methodTable(data, { link })\` | one row per Worker, version and method: calls, refused (4xx and 501), faults, mean and max ms |
| \`errorTable(data)\` | the faults, newest first, with a search box |
| \`dashboard(panels)\` | lays out \`[{ title, body, wide }]\` in a grid |`
// %%
brainOrigin = location.protocol === "https:" && !/observableusercontent\.com$|^localhost$/.test(location.hostname) ? location.origin : null
// %%
// Sends the session the Brain's page keeps for this origin.
metricsClient = brainOrigin
  ? xrpcClient(brainOrigin, {
      namespace: "com.lopecode.brain",
      headers: () => {
        try {
          const token = globalThis.localStorage.getItem("brain_session");
          return token ? { authorization: "Bearer " + token } : {};
        } catch {
          return {};
        }
      }
    })
  : null
// %%
viewof metricsRange = Inputs.radio(new Map([["1 hour", 3600000], ["6 hours", 6 * 3600000], ["24 hours", 24 * 3600000], ["7 days", 7 * 24 * 3600000]]), { value: 3600000, label: "Range" })
// %%
viewof metricsRefresh = Inputs.button("Refresh")
// %%
metricsData = {
  metricsRefresh;
  const until = Date.now(), since = until - metricsRange, step = Math.max(60000, Math.round(metricsRange / 60 / 60000) * 60000);
  if (!metricsClient) return { ...sampleMetrics({ since, until, step }), sample: true };
  try {
    return await metricsClient.query("metrics.query", { since, until, step });
  } catch (e) {
    return { since, until, step, series: [], errors: [], error: String((e && e.message) || e) };
  }
}
// %%
metricsBoard = dashboard([
  { title: "Health", body: healthStrip(metricsData, { width }), wide: true },
  { title: "Calls", body: requestsChart(metricsData, { width: width / 2 - 24 }) },
  { title: "Latency, ms", body: latencyChart(metricsData, { width: width / 2 - 24 }) },
  { title: "Calls that failed", body: errorsChart(metricsData, { width: width / 2 - 24 }) },
  { title: "By method", body: methodTable(metricsData) },
  { title: "Faults", body: errorTable(metricsData), wide: true }
], { note: metricsData.sample ? "Sample data: this copy of the notebook is not served by a Brain." : metricsData.error ? "metrics.query failed: " + metricsData.error : `${metricsData.batches} batches, ${d3.sum(metricsData.series, (d) => d.n)} calls` })
// %%
// Sums series rows that share the named fields.
rollup = (series, keys) => {
  const out = new Map();
  for (const d of series) {
    const k = keys.map((key) => d[key]).join("|");
    const m = out.get(k) || { ...Object.fromEntries(keys.map((key) => [key, d[key]])), n: 0, ms: 0, max: 0, e4: 0, e5: 0 };
    out.set(k, { ...m, n: m.n + d.n, ms: m.ms + d.ms, max: Math.max(m.max, d.max), e4: m.e4 + ((d.status >= 400 && d.status < 500) || d.status === 501 ? d.n : 0), e5: m.e5 + (d.status >= 500 && d.status !== 501 ? d.n : 0) });
  }
  return [...out.values()];
}
// %%
chartBase = (data, { width = 640, height = 200 } = {}) => ({
  width,
  height,
  marginLeft: 44,
  style: { background: "transparent", color: "var(--theme-foreground)", fontSize: "11px" },
  x: { type: "time", domain: [new Date(data.since), new Date(data.until)], label: null }
})
// %%
requestsChart = (data, options = {}) => {
  const rows = rollup(data.series, ["t", "worker"]);
  return Plot.plot({
    ...chartBase(data, options),
    y: { label: "calls", grid: true },
    color: { legend: true },
    marks: [
      Plot.rectY(rows, Plot.stackY({ x1: (d) => new Date(d.t), x2: (d) => new Date(d.t + data.step), y: "n", fill: "worker", insetRight: 1, tip: true })),
      Plot.ruleY([0])
    ]
  });
}
// %%
latencyChart = (data, options = {}) => {
  const rows = rollup(data.series, ["t", "worker"]).map((d) => ({ ...d, at: new Date(d.t + data.step / 2), mean: d.ms / d.n }));
  return Plot.plot({
    ...chartBase(data, options),
    y: { label: "ms", grid: true, type: rows.some((d) => d.max > 2000) ? "sqrt" : "linear" },
    color: { legend: true },
    marks: [
      Plot.line(rows, { x: "at", y: "mean", z: "worker", stroke: "worker" }),
      Plot.dot(rows, { x: "at", y: "max", stroke: "worker", r: 1.5, tip: true }),
      Plot.ruleY([0])
    ]
  });
}
// %%
errorsChart = (data, options = {}) => {
  const rows = rollup(data.series.filter((d) => d.status >= 400), ["t", "status"]).map((d) => ({ ...d, status: String(d.status) }));
  if (!rows.length) return htl.html`<div style="color:var(--theme-foreground-muted)">None in this range.</div>`;
  return Plot.plot({
    ...chartBase(data, options),
    y: { label: "calls", grid: true },
    color: { legend: true, type: "ordinal", scheme: "YlOrRd" },
    marks: [
      Plot.rectY(rows, Plot.stackY({ x1: (d) => new Date(d.t), x2: (d) => new Date(d.t + data.step), y: "n", fill: "status", insetRight: 1, tip: true })),
      Plot.ruleY([0])
    ]
  });
}
// %%
healthStrip = (data, options = {}) => {
  const rows = rollup(data.series, ["t", "worker"]).map((d) => ({ ...d, share: d.e5 / d.n }));
  const names = [...new Set(rows.map((d) => d.worker))].sort();
  return Plot.plot({
    ...chartBase(data, { ...options, height: 40 + 22 * Math.max(1, names.length) }),
    marginLeft: 130,
    y: { domain: names, label: null },
    color: { domain: [0, 1], range: ["#2e9e5b", "#e5484d"], legend: true, label: "share of calls that were faults", tickFormat: "%" },
    marks: [Plot.barX(rows, { x1: (d) => new Date(d.t), x2: (d) => new Date(d.t + data.step), y: "worker", fill: "share", insetRight: 1, title: (d) => `${d.worker}\n${d.n} calls, ${d.e5} failed` })]
  });
}
// %%
// link(worker, label) makes a Worker's name a link; it answers null for a Worker it does not know.
methodTable = (data, { link = null } = {}) =>
  Inputs.table(
    rollup(data.series, ["worker", "version", "method"]).map((d) => ({ worker: d.worker, version: d.version, method: d.method, calls: d.n, refused: d.e4, faults: d.e5, "mean ms": Math.round(d.ms / d.n), "max ms": d.max })).sort((a, b) => b.calls - a.calls),
    { select: false, rows: 12, layout: "auto", format: link ? { worker: (v) => link(v, v) || v } : {} }
  )
// %%
errorTable = (data) => {
  const rows = data.errors.map((e) => ({ at: new Date(e.t), worker: e.worker, version: e.version || "", method: e.method, caller: e.caller, status: e.status, ms: e.ms }));
  if (!rows.length) return htl.html`<div style="color:var(--theme-foreground-muted)">None in this range.</div>`;
  const search = Inputs.search(rows, { placeholder: "worker, method, caller, status" });
  const box = htl.html`<div></div>`;
  const draw = () => box.replaceChildren(Inputs.table(search.value, { select: false, rows: 12, layout: "auto", format: { at: (d) => d.toISOString().slice(0, 19).replace("T", " ") } }));
  search.addEventListener("input", draw);
  draw();
  return htl.html`<div>${search}${box}</div>`;
}
// %%
// A grid of titled panels. wide: true spans the row.
dashboard = (panels, { note = "" } = {}) => htl.html`<div style="font:13px/1.45 var(--sans-serif, system-ui, sans-serif);color:var(--theme-foreground)">
  ${note ? htl.html`<div style="color:var(--theme-foreground-muted);margin-bottom:8px">${note}</div>` : ""}
  <div style="display:grid;grid-template-columns:repeat(auto-fit,minmax(320px,1fr));gap:12px">
    ${panels.map((p) => htl.html`<div style=${`border:1px solid var(--theme-foreground-faintest);border-radius:6px;padding:10px 12px;min-width:0;overflow:auto;${p.wide ? "grid-column:1/-1;" : ""}`}>
      <div style="font-weight:600;margin-bottom:6px">${p.title}</div>${p.body}</div>`)}
  </div>
</div>`
// %%
// A made-up answer of metrics.query, the same every time for the same range.
sampleMetrics = ({ since = 0, until = 3600000, step = 60000 } = {}) => {
  const workers = [["brain-core", "inbox.list", 40, 0], ["brain-x-page", "/", 90, 0], ["brain-x-proxy", "proxy.fetch", 420, 0.06], ["brain-x-whatsapp", "/hooks/whatsapp", 120, 0]];
  const series = [], errors = [];
  let seed = 7;
  const rnd = () => ((seed = (seed * 16807) % 2147483647) - 1) / 2147483646;
  for (let t = Math.floor(since / step) * step; t < until; t += step)
    for (const [worker, method, ms, bad] of workers) {
      const n = Math.round(rnd() * 8);
      if (!n) continue;
      const failed = Math.min(n, Math.round(n * bad * 4 * rnd()));
      if (n - failed) series.push({ t, worker, version: "0123456789ab", method, caller: "owner", status: 200, n: n - failed, ms: Math.round((n - failed) * ms * (0.6 + rnd())), max: Math.round(ms * (1.5 + rnd())) });
      if (failed) {
        series.push({ t, worker, version: "0123456789ab", method, caller: "owner", status: 502, n: failed, ms: failed * ms * 3, max: ms * 4 });
        errors.push({ t, worker, method, caller: "owner", status: 502, ms: ms * 3 });
      }
    }
  return { since, until, step, series, errors: errors.reverse() };
}
// %%
md`## Tests`
// %%
// No SQL engine runs in a page, so this stands in for the database under simulate: it holds the two tables and
// answers the six statements of metricsSql by what they are for. The statements themselves are run by a Brain.
metricsFakeSql = () => {
  const calls = new Map(), faults = [], seen = [];
  const run = (statement, a) => {
    seen.push(statement);
    if (metricsSchema.includes(statement)) return { rows: [], changes: 0 };
    if (statement === metricsSql.count) {
      const key = a.slice(0, 6).join("|"), had = calls.get(key);
      calls.set(key, { t: a[0], worker: a[1], version: a[2], method: a[3], caller: a[4], status: a[5], n: (had ? had.n : 0) + a[6], ms: (had ? had.ms : 0) + a[7], max: Math.max(had ? had.max : 0, a[8]) });
      return { rows: [], changes: 1 };
    }
    if (statement === metricsSql.fault) return faults.push({ t: a[0], worker: a[1], version: a[2], method: a[3], caller: a[4], status: a[5], ms: a[6] }), { rows: [], changes: 1 };
    if (statement === metricsSql.series) {
      const out = new Map();
      for (const r of calls.values()) {
        if (r.t < a[0] || r.t > a[1]) continue;
        const t = Math.floor(r.t / a[2]) * a[2], key = [t, r.worker, r.version, r.method, r.caller, r.status].join("|"), had = out.get(key);
        out.set(key, { ...r, t, n: (had ? had.n : 0) + r.n, ms: (had ? had.ms : 0) + r.ms, max: Math.max(had ? had.max : 0, r.max) });
      }
      return { rows: [...out.values()].sort((x, y) => x.t - y.t), changes: 0 };
    }
    if (statement === metricsSql.faults) return { rows: faults.filter((f) => f.t >= a[0] && f.t <= a[1]).sort((x, y) => y.t - x.t).slice(0, 500), changes: 0 };
    if (statement === metricsSql.pruneCalls || statement === metricsSql.pruneFaults) return { rows: [], changes: 0 };
    throw new Error("a statement metricsSql does not hold: " + statement);
  };
  return { run, calls, faults, seen };
}
// %%
test_metrics_record_and_query = {
  const db = metricsFakeSql();
  const sim = await simulate(metrics_service, { secrets: { BRAIN_KEY: "k" }, sql: db.run });
  const X = "https://metrics.internal/xrpc/com.lopecode.brain.metrics.";
  const post = (body) => sim.fetch(X + "record", { method: "POST", headers: { "content-type": "application/json", "x-brain-caller": "worker:brain-core" }, body: JSON.stringify(body) });
  const T = Date.UTC(2026, 9, 6, 8, 0, 0);
  const bucket = (status, n, ms) => ({ worker: "brain-x-a", method: "a.go", caller: "owner", status, n, ms, max: ms });
  expect((await post({ nope: 1 })).status).toBe(400);
  expect(db.seen).toEqual([]);
  await post({ from: T + 1000, to: T + 9000, buckets: [bucket(200, 2, 30)], errors: [] });
  // The tables are made once, by the first call that stores anything.
  expect(db.seen.slice(0, 3)).toEqual(metricsSchema);
  await post({ from: T + 20000, to: T + 29000, buckets: [bucket(200, 1, 10), bucket(500, 1, 70)], errors: [{ t: T + 21000, worker: "brain-x-a", method: "a.go", caller: "owner", status: 500, ms: 70 }] });
  await post({ from: T + 400000, to: T + 409000, buckets: [bucket(200, 5, 50)], errors: [] });
  expect(db.seen.filter((s) => metricsSchema.includes(s)).length).toBe(3);
  // Two batches in one minute are one row for each status; nothing of the service is in rows.
  expect([...db.calls.values()].map((r) => [r.t - T, r.status, r.n, r.ms, r.max])).toEqual([[0, 200, 3, 40, 30], [0, 500, 1, 70, 70], [360000, 200, 5, 50, 50]]);
  expect([...sim.rows.keys()]).toEqual([]);
  expect(sim.emitted.meta.resources).toEqual(["sql"]);
  const q = await (await sim.fetch(`${X}query?since=${T}&until=${T + 600000}&step=300000`, { headers: { "x-brain-caller": "owner" } })).json();
  expect(q.series.map((s) => [s.t - T, s.status, s.n, s.ms])).toEqual([[0, 200, 3, 40], [0, 500, 1, 70], [300000, 200, 5, 50]]);
  expect(q.errors).toMatchObject([{ status: 500, ms: 70 }]);
  // Outside the range, nothing; more than 8 days, refused.
  expect((await (await sim.fetch(`${X}query?since=${T + 3600000}&until=${T + 7200000}`)).json()).series).toEqual([]);
  expect((await sim.fetch(`${X}query?since=${T}&until=${T + 9 * 86400000}`)).status).toBe(400);
  return q.series.length + " series rows";
}
// %%
test_metrics_charts_draw = {
  const data = sampleMetrics({ since: 0, until: 3600000, step: 60000 });
  const totals = rollup(data.series, ["worker"]);
  expect(totals.map((t) => t.worker).sort()).toEqual(["brain-core", "brain-x-page", "brain-x-proxy", "brain-x-whatsapp"]);
  expect(d3.sum(totals, (t) => t.n)).toBe(d3.sum(data.series, (d) => d.n));
  // A chart with a legend is a figure holding more than one svg.
  const marks = (el, sel) => Math.max(...[el, ...el.querySelectorAll("svg")].map((n) => n.querySelectorAll(sel).length));
  expect(marks(requestsChart(data), "rect")).toBeGreaterThan(50);
  expect(marks(latencyChart(data), "path")).toBeGreaterThan(3);
  expect(marks(errorsChart(data), "rect")).toBeGreaterThan(0);
  expect(errorsChart({ ...data, series: [] }).textContent).toBe("None in this range.");
  expect(marks(healthStrip(data), "rect")).toBeGreaterThan(50);
  expect(methodTable(data).querySelectorAll("tbody tr").length).toBe(4);
  expect(dashboard([{ title: "a", body: "x" }, { title: "b", body: "y", wide: true }]).querySelectorAll("div[style*=border]").length).toBe(2);
  return "drawn";
}
// %%
import {cloudflare, sql, hono, simulate} from "@tomlarkworthy/cloudflare-iac"
// %%
import {xrpcClient} from "@tomlarkworthy/xrpc-client"
// %%
import {plugins} from "@tomlarkworthy/plugin-registry"
// %%
import {expect} from "@tomlarkworthy/jest-expect-standalone"
