test_infra_is_for_the_owner_session_only = {
  const rig = await kernelRig();
  expect((await rig.call("infra.getState")).status).toBe(401);
  expect((await rig.call("infra.apply", { session: rig.other, body: {} })).status).toBe(403);
  expect(rig.toDeployer.length).toBe(0);
  expect((await rig.call("infra.apply", { session: rig.owner, body: { workers: [] } })).status).toBe(200);
  expect(rig.toDeployer[0]).toMatchObject({ url: "https://deployer.internal/xrpc/com.lopecode.brain.infra.apply", body: '{"workers":[]}' });
  expect(rig.toDeployer[0].headers["x-brain-caller"]).toBe("owner");
  expect(rig.toDeployer[0].headers["x-brain-key"]).toBe("kernel-key");
  expect(rig.toDeployer[0].headers.cookie).toBeUndefined();
  return "401, 403, then forwarded with the kernel's key";
}
// %%
test_service_jwt_claims_are_checked_first = {
  const rig = await kernelRig();
  const b64 = (o) => btoa(JSON.stringify(o)).replace(/=+$/, "");
  const jwt = (claims) => `${b64({ alg: "ES256K" })}.${b64({ iss: "did:plc:owner", aud: "did:web:cb.sub.workers.dev", exp: Date.now() / 1000 + 60, lxm: "com.lopecode.brain.secret.list", ...claims })}.AAAA`;
  expect((await rig.call("secret.list", { bearer: jwt({ aud: "did:web:other.example" }) })).data.error).toBe("BadJwtAudience");
  expect((await rig.call("secret.list", { bearer: jwt({ exp: 1 }) })).data.error).toBe("JwtExpired");
  expect((await rig.call("secret.list", { bearer: jwt({ lxm: "com.lopecode.brain.inbox.list" }) })).data.error).toBe("BadJwtLexiconMethod");
  expect((await rig.call("inbox.list", { bearer: jwt({}) })).data.error).toBe("BadJwtLexiconMethod");
  expect(rig.seen.length).toBe(0);
  return "aud, exp and lxm";
}
// %%
test_a_strangers_jwt_makes_no_request_and_sign_in_starts_are_counted = {
  const rig = await kernelRig();
  const b64 = (o) => btoa(JSON.stringify(o)).replace(/=+$/, "");
  const jwt = (iss) => `${b64({ alg: "ES256K" })}.${b64({ iss, aud: "did:web:cb.sub.workers.dev", exp: Date.now() / 1000 + 60, lxm: "com.lopecode.brain.secret.list" })}.AAAA`;
  // Not the owner, not a member, no grant: refused before any DID document is fetched.
  const stranger = await rig.call("secret.list", { bearer: jwt("did:web:stranger.example") });
  expect([stranger.status, stranger.data.error]).toEqual([401, "AuthRequired"]);
  expect(rig.seen.length).toBe(0);
  // A sign-in start past the count for 10 minutes is refused before anything is resolved.
  rig.sim.rows.set("logins/" + Math.floor(Date.now() / 600000), 60);
  expect((await rig.call("/auth/login?handle=someone.example")).status).toBe(429);
  // A member's handle is counted apart: not refused by that count, and refused by its own at 600.
  rig.sim.rows.set("member/did:plc:ada", { did: "did:plc:ada", added: 1 });
  rig.sim.rows.set("handle/did:plc:ada", "Ada.example");
  const known = "logins-known/" + Math.floor(Date.now() / 600000);
  expect((await rig.call("/auth/login?handle=ada.example").catch(() => ({ status: 0 }))).status).not.toBe(429);
  expect(rig.sim.rows.get(known)).toBe(1);
  // One who signed in once and is no member is counted with everyone.
  rig.sim.rows.set("handle/did:plc:gone", "gone.example");
  expect((await rig.call("/auth/login?handle=gone.example")).status).toBe(429);
  rig.sim.rows.set(known, 600);
  expect((await rig.call("/auth/login?handle=ada.example")).status).toBe(429);
  return "401 AuthRequired; 429";
}
// %%
test_a_method_of_another_lexicon_is_passed_on_as_anonymous = {
  const rig = await kernelRig();
  const F = "/xrpc/app.bsky.feed.getFeedSkeleton?feed=at%3A%2F%2Fdid%3Aplc%3Abrain%2Fapp.bsky.feed.generator%2Freading";
  // No token, the owner's session, a token nobody made and a service JWT that would be refused: all the same caller.
  for (const auth of [{}, { session: rig.owner }, { bearer: "nobody-made-this" }, { bearer: "aaaa.bbbb.cccc" }]) {
    rig.seen.length = 0;
    expect((await rig.call(F, auth)).status).toBe(200);
    expect([rig.seen[0].url, rig.seen[0].headers["x-brain-caller"]]).toEqual(["https://core.internal" + F, "anonymous"]);
  }
  // A method of this Brain is still refused with a token nobody made.
  expect((await rig.call("inbox.list", { bearer: "nobody-made-this" })).status).toBe(401);
  return "4 callers, all anonymous";
}
// %%
test_did_document_and_page = {
  const rig = await kernelRig();
  const doc = (await rig.call("/.well-known/did.json")).data;
  expect(doc.id).toBe("did:web:cb.sub.workers.dev");
  expect(doc.service).toEqual([{ id: "#brain", type: "CloudBrain", serviceEndpoint: "https://cb.sub.workers.dev" }, { id: "#bsky_fg", type: "BskyFeedGenerator", serviceEndpoint: "https://cb.sub.workers.dev" }, { id: "#deployer", type: "CloudBrainDeployer", serviceEndpoint: "https://cb-deployer.sub.workers.dev" }]);
  // The page is a service like any other: the kernel passes "/" to the core as anonymous or as whoever asked.
  await rig.call("/");
  expect(rig.seen.at(-1)).toMatchObject({ url: "https://core.internal/" });
  rig.seen.length = 0;
  // The kernel's manifest and source are answered to anyone; a question about another Worker goes to the core.
  expect((await rig.call("getInfo")).data).toMatchObject({ name: "brain", role: "kernel" });
  expect((await rig.call("getSource?worker=brain")).data.module).toBe("@tomlarkworthy/brain-kernel");
  await rig.call("getSource?worker=brain-x-echo");
  expect(rig.seen.at(-1).url).toBe("https://core.internal/xrpc/com.lopecode.brain.getSource?worker=brain-x-echo");
  return "did:web, the installed page, its own source";
}
// %%
test_a_member_reaches_their_own_services_and_the_deployer_hears_who = {
  const rig = await kernelRig();
  const body = { module: "@other/todo", source: "export default function define() {}" };
  // Signed in and not added: nothing.
  expect((await rig.call("member.deploy", { session: rig.other, body })).status).toBe(403);
  expect((await rig.call("people.put", { session: rig.owner, body: { did: "did:plc:other", name: "Ada", quota: { workers: 5, nonsense: 1 }, tags: [{ tag: "family", access: "read" }] } })).status).toBe(200);
  // The core was told who is a member, with the kernel's own name for itself.
  const sync = rig.seen.filter((s) => s.url.endsWith(".people.sync")).at(-1);
  expect(sync.headers["x-brain-caller"]).toBe("kernel");
  expect(JSON.parse(sync.body)).toEqual({ people: [{ did: "did:plc:other", quota: { workers: 5 }, tags: [{ tag: "family", access: "read" }] }] });
  expect((await rig.call("member.deploy", { session: rig.other, body })).status).toBe(200);
  const heard = rig.toDeployer.at(-1);
  expect(heard.url).toBe("https://deployer.internal/xrpc/com.lopecode.brain.member.deploy");
  expect(heard.headers["x-brain-caller"]).toBe("member");
  expect(JSON.parse(heard.body)).toEqual({ author: "did:plc:other", quota: { workers: 5 }, request: body });
  // An author named in the body is not heard.
  await rig.call("member.remove", { session: rig.other, body: { name: "todo", author: "did:plc:owner" } });
  expect(JSON.parse(rig.toDeployer.at(-1).body).author).toBe("did:plc:other");
  expect((await rig.call("member.deploy", { session: rig.owner, body })).status).toBe(403);
  expect((await rig.call("member.deploy", { body })).status).toBe(403);
  // Any member's method goes to the core, which decides by its rule. Nothing else does without a grant.
  expect((await rig.call("m.0123456789.list", { session: rig.other })).status).toBe(200);
  expect(rig.seen.at(-1).headers["x-brain-caller"]).toBe("did:plc:other");
  expect((await rig.call("member.whoami", { session: rig.other })).status).toBe(200);
  expect((await rig.call("static.list", { session: rig.other })).status).toBe(200);
  expect((await rig.call("member.switch", { session: rig.other, body: {} })).status).toBe(403);
  expect((await rig.call("library.list", { session: rig.other })).status).toBe(403);
  expect((await rig.call("grant.put", { session: rig.owner, body: { did: "did:plc:other", methods: ["member.switch"] } })).status).toBe(400);
  // A member opens a file as themselves; any other page is served to them as to anyone.
  await rig.call("/static/u/a/b.png", { session: rig.other });
  expect(rig.seen.at(-1).headers["x-brain-caller"]).toBe("did:plc:other");
  await rig.call("/hooks/x", { session: rig.other });
  expect(rig.seen.at(-1).headers["x-brain-caller"]).toBe("anonymous");
  // Switched off for this member, by the owner.
  await rig.call("people.put", { session: rig.owner, body: { did: "did:plc:other", services: false } });
  expect((await rig.call("member.deploy", { session: rig.other, body })).data.message).toBe("the owner has switched services off for this member");
  expect((await rig.call("people.list", { session: rig.owner })).data.people.find((p) => p.did === "did:plc:other")).toMatchObject({ name: "Ada", services: false, quota: { workers: 5 }, tags: [{ tag: "family", access: "read" }] });
  // Removed: the core is told and the deployer deletes their Workers.
  await rig.call("people.remove", { session: rig.owner, body: { did: "did:plc:other" } });
  expect(JSON.parse(rig.seen.filter((s) => s.url.endsWith(".people.sync")).at(-1).body)).toEqual({ people: [] });
  expect(rig.toDeployer.at(-1).url).toBe("https://deployer.internal/xrpc/com.lopecode.brain.member.purge");
  expect(JSON.parse(rig.toDeployer.at(-1).body)).toEqual({ author: "did:plc:other" });
  expect((await rig.call("member.deploy", { session: rig.other, body })).status).toBe(403);
  return "a member reaches their own services, and the deployer hears who";
}
// %%
test_a_member_reads_their_own_spending = {
  const rig = await kernelRig();
  const asked = () => rig.seen.filter((s) => s.url.includes(".quota.")).map((s) => [s.url.split("brain.").pop(), s.headers["x-brain-caller"]]);
  // Signed in and not a member: the kernel refuses, and the core is not asked.
  expect((await rig.call("quota.get", { session: rig.other })).data).toMatchObject({ error: "Forbidden", message: "did:plc:other has no grant for com.lopecode.brain.quota.get" });
  expect(asked()).toEqual([]);
  await rig.call("people.put", { session: rig.owner, body: { did: "did:plc:other", name: "Ada" } });
  // A member: sent to the core under their own DID, with no grant. The rest of quota.* is the owner's.
  expect((await rig.call("quota.get", { session: rig.other })).status).toBe(200);
  expect([(await rig.call("quota.list", { session: rig.other })).status, (await rig.call("quota.ledger", { session: rig.other })).status, (await rig.call("quota.put", { session: rig.other, body: { who: "did:plc:other", daily: 9 } })).status]).toEqual([403, 403, 403]);
  expect(asked()).toEqual([["quota.get", "did:plc:other"]]);
  // A member makes, lists and revokes delegations: the core answers, and is told it is their own session. A token
  // with every method is not sent on.
  expect((await rig.call("delegation.list", { session: rig.other })).status).toBe(200);
  expect(rig.seen.at(-1).headers).toMatchObject({ "x-brain-caller": "did:plc:other", "x-brain-via": "session" });
  const wide = (await rig.call("token.create", { session: rig.owner, body: { name: "wide", methods: ["*"] } })).data.token;
  expect([(await rig.call("delegation.list", { bearer: wide })).status, (await rig.call("delegation.create", { bearer: wide, body: {} })).status]).toEqual([403, 403]);
  return "quota.get, and delegation.* in their own session";
}
// %%
test_a_token_is_the_callers_to_send_from_anywhere = {
  const rig = await kernelRig();
  const sibling = "https://cb-m-0123456789-todo.sub.workers.dev";
  // No cookie is read, so a page on another address has nothing of this Brain's to send. With a session it was
  // given, it is that session, from any origin, and the answer is readable there.
  expect((await rig.call("token.list", { cookie: rig.owner, headers: { origin: sibling, "sec-fetch-site": "same-site" } })).status).toBe(401);
  const refused = await rig.call("token.list", { headers: { origin: "null" } });
  // A refusal is readable there too: a page sees the 401, not a network error.
  expect([refused.status, refused.headers.get("access-control-allow-origin"), refused.headers.get("access-control-expose-headers")]).toEqual([401, "*", "x-brain-price, x-ai-usd, x-ai-neurons, x-proxy-upstream"]);
  const there = await rig.call("token.list", { session: rig.owner, headers: { origin: sibling } });
  expect([there.status, there.headers.get("access-control-allow-origin")]).toEqual([200, "*"]);
  // A preflight is told the headers it asked for, so a client library that adds its own is not stopped.
  const pre = (asked) => rig.call("ai.v1/chat/completions", { method: "OPTIONS", headers: { origin: sibling, "access-control-request-method": "POST", ...(asked ? { "access-control-request-headers": asked } : {}) } });
  expect([(await pre("authorization, content-type, x-stainless-os, http-referer, x-title")).status, (await pre("authorization, content-type, x-stainless-os, http-referer, x-title")).headers.get("access-control-allow-headers")]).toEqual([204, "authorization, content-type, x-stainless-os, http-referer, x-title"]);
  expect((await pre()).headers.get("access-control-allow-headers")).toBe("authorization, content-type");
  expect((await pre("x-a; b=(c)")).headers.get("access-control-allow-headers")).toBe("authorization, content-type");
  expect((await pre("x_trace_id")).headers.get("access-control-allow-headers")).toBe("authorization, content-type");
  // What a page on another origin may read of an answer.
  expect(there.headers.get("access-control-expose-headers")).toBe("x-brain-price, x-ai-usd, x-ai-neurons, x-proxy-upstream");
  return "401 without a token, whatever the origin";
}
// %%
test_a_portal_token_reaches_one_members_services_as_the_viewer = {
  const rig = await kernelRig();
  const A = "did:plc:alice", B = "did:plc:other", ida = (await sha256(A)).slice(0, 10), idb = (await sha256(B)).slice(0, 10);
  for (const did of [A, B]) await rig.call("people.put", { session: rig.owner, body: { did } });
  const alice = await sessionToken.make("cookie-key", A);
  // Minted for a signed-in session only, and only for a member's services.
  expect((await rig.call("portal.token", { body: { author: A } })).status).toBe(401);
  expect((await rig.call("portal.token", { bearer: await turnToken.make("cookie-key", "did:plc:owner", 1), body: { author: A } })).status).toBe(401);
  expect((await rig.call("portal.token", { session: await sessionToken.make("cookie-key", "did:plc:stranger"), body: { author: A } })).status).toBe(403);
  expect((await rig.call("portal.token", { session: rig.owner, body: { author: "did:plc:nobody" } })).status).toBe(404);
  const made = (await rig.call("portal.token", { session: rig.owner, body: { author: A } })).data;
  expect(made).toMatchObject({ author: A, id: ida });
  expect(await portalToken.read("cookie-key", made.token)).toEqual({ did: "did:plc:owner", author: A, id: ida });
  // The owner looking at A's services: A's methods as the owner, A's modules, and nothing else the owner can do.
  rig.seen.length = 0;
  expect((await rig.call(`m.${ida}.list`, { bearer: made.token })).status).toBe(200);
  expect(rig.seen[0].headers).toMatchObject({ "x-brain-caller": "owner", "x-brain-via": "portal:" + ida });
  expect((await rig.call("portal.modules", { bearer: made.token, body: {} })).status).toBe(200);
  expect(rig.toDeployer.at(-1).url).toBe("https://deployer.internal/xrpc/com.lopecode.brain.member.modules");
  expect(JSON.parse(rig.toDeployer.at(-1).body).author).toBe(A);
  for (const m of [`m.${idb}.list`, "secret.list", "secret.get", "people.list", "people.put", "infra.getState", "inbox.list", "inbox.poll", "blob.list", "static.list", "token.create", "portal.token", "member.deploy", "member.services", "library.list"])
    expect([m, (await rig.call(m, { bearer: made.token, body: {} })).status]).toEqual([m, 403]);
  expect((await rig.call("/static/shell/index.html", { bearer: made.token })).status).toBe(403);
  expect((await rig.call("/auth/session", { bearer: made.token })).status).toBe(403);
  // B looking at A's: A's methods as B. The Worker's rule in the core decides which.
  const forB = (await rig.call("portal.token", { session: rig.other, body: { author: A } })).data.token;
  await rig.call(`m.${ida}.list`, { bearer: forB });
  expect(rig.seen.at(-1).headers).toMatchObject({ "x-brain-caller": B, "x-brain-via": "portal:" + ida });
  expect((await rig.call("member.deploy", { bearer: forB, body: {} })).status).toBe(403);
  expect((await rig.call("blob.list", { bearer: forB })).status).toBe(403);
  // A looking at their own: their own services too, so the frame can deploy what was edited in it.
  const own = (await rig.call("portal.token", { session: alice, body: { author: A } })).data.token;
  expect((await rig.call("member.deploy", { bearer: own, body: { module: "@a/x", source: "s" } })).status).toBe(200);
  expect(JSON.parse(rig.toDeployer.at(-1).body).author).toBe(A);
  expect((await rig.call("blob.list", { bearer: own })).status).toBe(403);
  // Refused: changed, expired, another key, a session or a turn relabelled, the viewer or the author removed, signed out everywhere.
  expect((await rig.call(`m.${ida}.list`, { bearer: made.token.slice(0, -2) + "xx" })).status).toBe(401);
  expect((await rig.call(`m.${ida}.list`, { bearer: await portalToken.make("cookie-key", "did:plc:owner", A, ida, { ttl: -1 }) })).status).toBe(401);
  expect((await rig.call(`m.${ida}.list`, { bearer: await portalToken.make("other-key", "did:plc:owner", A, ida) })).status).toBe(401);
  expect((await rig.call(`m.${ida}.list`, { bearer: "p1." + rig.owner.split(".").slice(1).join(".") })).status).toBe(401);
  expect(await sessionToken.read("cookie-key", "v1." + made.token.split(".").slice(1).join("."))).toBe(null);
  await rig.call("people.remove", { session: rig.owner, body: { did: B } });
  expect((await rig.call(`m.${ida}.list`, { bearer: forB })).status).toBe(403);
  await rig.call("people.remove", { session: rig.owner, body: { did: A } });
  expect((await rig.call(`m.${ida}.list`, { bearer: made.token })).data.message).toBe(A + " is not a member");
  await rig.call("people.put", { session: rig.owner, body: { did: A } });
  expect((await rig.call(`m.${ida}.list`, { bearer: made.token })).status).toBe(200);
  await rig.call("/auth/logout?everywhere=true", { session: rig.owner, method: "POST" });
  expect((await rig.call(`m.${ida}.list`, { bearer: made.token })).status).toBe(401);
  return "one member's methods and modules, as the viewer";
}
// %%
import {cloudflare, secrets, rows, config, core, deployer, hono, library, simulate, sha256, matches, may, neverHeld} from "@tomlarkworthy/cloudflare-iac"
// %%
import {expect} from "@tomlarkworthy/jest-expect-standalone"
// %%
import {plugins} from "@tomlarkworthy/plugin-registry"
