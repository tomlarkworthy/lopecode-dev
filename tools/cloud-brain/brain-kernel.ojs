    if (done.status !== 200) { said.textContent = done.data.message || ("refused: " + done.status); go.disabled = no.disabled = false; return; }
    go.remove(); no.remove();
    said.textContent = (done.data.status === "denied" ? "Denied." : "Approved: " + done.data.granted.name + ". The program picks it up by itself.") + " Closing this tab…";
