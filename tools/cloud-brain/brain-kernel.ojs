  app.get("/auth/request", (c) =>
    new Response(`<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Request for access</title><body style="font:16px/1.5 system-ui,sans-serif;max-width:34em;margin:3em auto;padding:0 1em"><div id="app"></div><scr` + `ipt>const ID = ${JSON.stringify(requestId(c.req.query("id")) || null)};${requestScript}</scr` + `ipt></body>`, { headers: { "content-type": "text/html; charset=utf-8", "cache-control": "no-store", "referrer-policy": "no-referrer", "x-frame-options": "DENY", "content-security-policy": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'" } }));
  // How a program asks for more, as text: the refusal of a method a token does not name points here.
  app.get("/auth/ask", (c) =>
    c.text(`Asking the owner of the Cloud Brain at https://${config.host} for more methods or caps.

A token calls only the methods it names. A refusal "this token does not name ..." means: ask, do not work
around it. Below, d is the directory that holds the brain.json your sign-in link gave you. curl, jq and openssl.

1. A key, and the request. List the methods you need, by whole name where you can (issue.get, issue.list) or by
   prefix (issue.*), and say why in 3 to 300 characters. Add "caps":["session"] for a method only the owner's own
   tab may call (logs.*, rule.put, ...) and "caps":["deploy"] to deploy. Never infra, secret, token, grant, people
   or delegation methods.

  (umask 077; openssl genpkey -algorithm RSA -pkeyopt rsa_keygen_bits:2048 -out "$d/ask.pem")
  pub=$(openssl pkey -in "$d/ask.pem" -pubout -outform DER | base64 -w0)
  curl -sS -X POST "https://${config.host}/xrpc/com.lopecode.brain.token.request" -H "Authorization: Bearer $(jq -r .token "$d/brain.json")" -H "content-type: application/json" -d "$(jq -n --arg p "$pub" '{methods:["issue.*"], reason:"read and update the issue I was given", publicKey:$p}')" | tee "$d/ask.json"

   With no token at all, leave out the Authorization header and add "name":"a-short-name" to the body.

2. Show your user the url and the code from the answer. Only the owner of this Brain can answer: they open
   the url, signed in, and approve only when the page shows the same code. A user who is not the owner sends
   the owner both. The owner may give less than you asked.

3. Poll every 5 seconds until status is not "pending". A request lasts 60 minutes.

  curl -sS "https://${config.host}/xrpc/com.lopecode.brain.token.requested?id=$(jq -r .id "$d/ask.json")" > "$d/answer.json"; jq -r .status "$d/answer.json"

4. When it is "approved", open the sealed link with your key and spend it once, as you did the first:

  link=$(jq -r .sealed "$d/answer.json" | base64 -d | openssl pkeyutl -decrypt -inkey "$d/ask.pem" -pkeyopt rsa_padding_mode:oaep -pkeyopt rsa_oaep_md:sha256 -pkeyopt rsa_mgf1_md:sha256)
  (umask 077; curl -sS -X POST "$link" -o "$d/brain.json") && rm "$d/ask.pem"

The new token has what the old one had and what was granted, and the old one stops working once the new one is
made. Read "methods" and "caps" in brain.json for what you have now. "denied": stop and ask your user.
`)
  );
  app.get(NS + "grant.list", session, async (c) => c.json({ grants: (await grants()).map((d) => ({ did: d.holder.did, methods: d.scope, granted: d.created })) }));
  // The core checks a member's Worker as its author, and cannot ask the kernel who that is: it is told, whole, each
  // time a member changes. What each was granted is the core's own row.
  const syncPeople = async () => {
    const people = [];
    for (const { value: m } of await rows.list("member/")) people.push({ did: m.did, quota: m.quota || null, tags: m.tags || [] });
    await core.fetch(new Request("https://core.internal/xrpc/com.lopecode.brain.people.sync", { method: "POST", headers: { "content-type": "application/json", "x-brain-caller": "kernel" }, body: JSON.stringify({ people }) }));
    // A channel that knows senders by DID is told the whole list too; one that is not deployed does not answer.
    for (const channel of NATIVE) await toChannel(channel, "know", { all: people.map((p) => p.did) }).catch(() => null);
  };
  const ungrant = async (did) => {
    let deleted = await rows.delete("grant/" + did);
    for (const d of await delegations()) if (d.holder && d.holder.did === did) deleted = !!((await asOwnerSession("delegation.revoke", { id: d.id })).data || {}).revoked || deleted;
    return deleted;
  };
  app.post(NS + "grant.put", session, async (c) => {
    const { did, methods = [] } = await c.req.json();
    const named = methods.map(full);
    if (!/^did:(plc|web):[A-Za-z0-9.:%-]+$/.test(did || "")) return fail(c, 400, "InvalidRequest", "did");
    if (named.some((m) => m.includes("*"))) return fail(c, 400, "InvalidRequest", "a grant names whole methods; a prefix is for a token");
    if (named.some(never) || named.some((m) => m.startsWith("com.lopecode.brain.member."))) return fail(c, 400, "InvalidRequest", "a grant cannot name infra, secret, token, grant, people, delegation or member methods");
    const made = await asOwnerSession("delegation.create", { name: "grant", holder: { did }, scope: named });
    if (made.status !== 200) return c.json(made.data || { error: "UpstreamFailure", message: "the core did not answer" }, made.status);
    await rows.delete("grant/" + did);
    await syncPeople();
    return c.json({ did, methods: named });
  });
  app.post(NS + "grant.delete", session, async (c) => {
    const { did } = await c.req.json(), deleted = await ungrant(did);
    await syncPeople();
    return c.json({ deleted });
  });

  // Who is calling, then the core. Nothing the caller sent says who they are.
  const toCore = async (c) => {
    const url = new URL(c.req.url), who = c.get("who");
    const headers = new Headers(c.req.raw.headers);
    for (const name of [...headers.keys()]) if (name === "cookie" || name === "authorization" || name.startsWith("x-brain-")) headers.delete(name);
    headers.set("x-brain-caller", who.caller);
    headers.set("x-brain-via", who.via);
    // A token's delegation. The core reads the row, and says from it who the call is by and whether it is their tab.
    if (who.delegation) headers.set("x-brain-delegation", who.delegation);
    // The ray Cloudflare gave this call. The core writes it in its log line, and a caller already has it as cf-ray.
    if (c.req.header("cf-ray")) headers.set("x-brain-ray", c.req.header("cf-ray"));
    const bodied = !["GET", "HEAD"].includes(c.req.method);
    return core.fetch(new Request("https://core.internal" + url.pathname + url.search, { method: c.req.method, headers, body: bodied ? await bodyOf(c) : undefined, duplex: bodied ? "half" : undefined, redirect: "manual" }));
  };
  // People: members, and which DID an address on a channel belongs to.
  const DID = /^did:(plc|web):[A-Za-z0-9.:%-]+$/, CHANNEL = /^[a-z0-9-]{1,30}$/;
  const addressOk = (a) => typeof a === "string" && a.length > 0 && a.length <= 200 && !a.includes("/");
  const roleOf = async (did) => (did === config.owner ? "owner" : (await rows.get("member/" + did)) ? "member" : null);
  // Channels on which a sender's address is their DID. Nobody links there: a member has the address from the moment
  // they are added, and the owner always.
  const NATIVE = ["bluesky"];
  // A call the kernel makes for itself. Only the Worker named for the channel may answer it.
  const toChannel = async (channel, method, body) => {
    const r = await core.fetch(new Request(`https://core.internal/xrpc/com.lopecode.brain.${channel}.${method}`, { method: "POST", headers: { "content-type": "application/json", "x-brain-caller": "kernel" }, body: JSON.stringify(body) }));
    const by = (r.headers.get("x-brain-served-by") || "").split(",")[0].trim();
    if (!r.ok || !by.startsWith(`brain-x-${channel}@`)) return null;
    return r.json().catch(() => null);
  };
  app.get(NS + "people.list", owner, async (c) => {
    const people = new Map();
    const at = (did) => people.get(did) || people.set(did, { did, handle: null, role: null, name: null, added: null, addresses: [], methods: [] }).get(did);
    if (config.owner) at(config.owner).role = "owner";
    for (const { value: m } of await rows.list("member/")) Object.assign(at(m.did), { role: "member", name: m.name || null, added: m.added, services: m.services !== false, quota: m.quota || null, tags: m.tags || [] });
    for (const { value: a } of await rows.list("address/")) at(a.did).addresses.push({ channel: a.channel, address: a.address, linked: a.linked });
    for (const g of await grants()) if (people.has(g.holder.did)) at(g.holder.did).methods = g.scope;
    for (const p of people.values()) p.handle = await rows.get("handle/" + p.did);
    return c.json({ people: [...people.values()] });
  });
  app.post(NS + "people.put", session, async (c) => {
    const { did, name, services, quota, tags } = await c.req.json();
    if (!DID.test(did || "")) return fail(c, 400, "InvalidRequest", "did");
    if (did === config.owner) return fail(c, 400, "InvalidRequest", "the owner is not a member");
    const was = (await rows.get("member/" + did)) || {};
    // quota: { workers, bytes, calls, deploys }, each a whole number; a name left out keeps the Brain's default.
    const limits = quota === undefined ? was.quota || null : quota && Object.fromEntries(["workers", "bytes", "calls", "deploys"].filter((k) => Number.isInteger(quota[k]) && quota[k] >= 0).map((k) => [k, quota[k]]));
    // tags: [{ tag, access: "read" | "write" }], the labels on files this member may read or change beside their own.
    if (tags !== undefined && !(Array.isArray(tags) && tags.length <= 20 && tags.every((g) => g && typeof g.tag === "string" && /^[a-z0-9-]{1,40}$|^(by|worker):[A-Za-z0-9.:%-]{1,120}$/.test(g.tag) && ["read", "write"].includes(g.access)))) return fail(c, 400, "InvalidRequest", "tags: [{ tag, access: read | write }]");
    await rows.put("member/" + did, { tags: tags === undefined ? was.tags || [] : tags.map((g) => ({ tag: g.tag, access: g.access })), did, name: name === undefined ? was.name || null : name ? String(name).slice(0, 80) : null, added: was.added || Date.now(), services: services === undefined ? was.services !== false : !!services, quota: limits && Object.keys(limits).length ? limits : null });
    for (const channel of NATIVE) if (!(await rows.get(`address/${channel}/${did}`))) await rows.put(`address/${channel}/${did}`, { channel, address: did, did, linked: Date.now() });
    await syncPeople();
    return c.json({ did, role: "member" });
  });
  const unlink = async (channel, address) => {
    const gone = await rows.delete(`address/${channel}/${address}`);
    await toChannel(channel, "know", { address, forget: true });
    return gone;
  };
  app.post(NS + "people.remove", session, async (c) => {
    const { did } = await c.req.json();
    if (!DID.test(did || "") || did === config.owner) return fail(c, 400, "InvalidRequest", "did");
    const removed = await rows.delete("member/" + did);
    // Their grant is revoked too, or a removed person would keep the methods it gave.
    await ungrant(did);
    // From here the core refuses every call into and out of their Workers; the deployer then deletes them.
    await syncPeople();
    await deployer.fetch(new Request("https://deployer.internal/xrpc/com.lopecode.brain.member.purge", { method: "POST", headers: { "content-type": "application/json", "x-brain-caller": "owner" }, body: JSON.stringify({ author: did }) })).catch(() => null);
    for (const { value: a } of await rows.list("address/")) if (a.did === did) await unlink(a.channel, a.address);
    return c.json({ removed: !!removed });
  });
  app.post(NS + "people.link", session, async (c) => {
    const { channel, address, did } = await c.req.json();
    if (!CHANNEL.test(channel || "") || !addressOk(address) || !DID.test(did || "")) return fail(c, 400, "InvalidRequest", "channel, address and did");
    if (!(await toChannel(channel, "know", { address }))) return fail(c, 502, "UpstreamError", `brain-x-${channel} did not answer ${channel}.know`);
    await rows.put(`address/${channel}/${address}`, { channel, address, did, linked: Date.now() });
    return c.json({ channel, address, did, role: await roleOf(did) });
  });
  app.post(NS + "people.unlink", session, async (c) => {
    const { channel, address } = await c.req.json();
    if (!CHANNEL.test(channel || "") || !addressOk(address)) return fail(c, 400, "InvalidRequest", "channel and address");
    return c.json({ unlinked: !!(await unlink(channel, address)) });
  });

  // The page a channel's link opens. Signing in proves the DID, the code proves the address, pressing Link joins them.
  // The page is the same for everyone: its script holds the session, if there is one, and asks with it.
  const linkOf = (q) => (q && CHANNEL.test(q.channel || "") && /^[A-Za-z0-9-]{8,64}$/.test(q.code || "") ? { channel: q.channel, code: q.code } : null);
  const linkScript = `
const app = document.getElementById("app");
const el = (tag, text, attrs) => { const e = document.createElement(tag); if (text) e.textContent = text; for (const k in attrs || {}) e.setAttribute(k, attrs[k]); return e; };
const show = (...nodes) => app.replaceChildren(...nodes);
let token = null; try { token = localStorage.getItem("brain_session"); } catch (e) {}
const call = async (path, more) => { const r = await fetch(path, { method: "POST", headers: { "content-type": "application/json", authorization: "Bearer " + token }, body: JSON.stringify(Object.assign({}, LINK, more)) }); return { status: r.status, data: await r.json().catch(() => ({})) }; };
const expired = () => show(el("p", "This link has expired or was already used. Send the Brain another message to get a new one."));
const signIn = () => {
  const form = el("form", "", { method: "get", action: "/auth/login" });
  form.append(el("input", "", { type: "hidden", name: "next", value: "/link?channel=" + LINK.channel + "&code=" + LINK.code }), el("input", "", { name: "handle", placeholder: "you.bsky.social", autocapitalize: "off", autocomplete: "username", style: "font:inherit;padding:6px;width:16em" }), " ", el("button", "Sign in", { style: "font:inherit;padding:6px 12px" }));
  show(el("h3", "Link this " + LINK.channel + " address to a Cloud Brain"), el("p", "Sign in with your atproto (Bluesky) account. You are sent to your own provider to do it; this page never sees your password."), form);
};
const run = async () => {
  if (!LINK) return expired();
  if (!token) return signIn();
  const found = await call("/link/peek");
  if (found.status === 401) return signIn();
  if (found.status !== 200) return expired();
  const go = el("button", "Link", { style: "font:inherit;padding:6px 12px" });
  const said = el("p", "", { style: "color:#b3261e" });
  const typed = found.data.owner ? el("input", "", { placeholder: "last 4 characters of the address", autocomplete: "off", style: "font:inherit;padding:6px;width:16em" }) : null;
  go.onclick = async () => {
    go.disabled = true;
    const done = await call("/link", typed ? { confirm: typed.value.trim() } : {});
    if (done.status === 400) { go.disabled = false; said.textContent = done.data.message || ""; return; }
    if (done.status !== 200) return expired();
    show(el("h3", "Linked"), el("p", done.data.role ? "Messages from " + done.data.address + " are now answered." : done.data.address + " is linked to your account. The owner of this Brain has to add you before it answers."));
  };
  show(el("h3", "Link " + LINK.channel + " " + found.data.address + "?"), el("p", "Messages from " + found.data.address + " will be answered as " + found.data.as + "."), el("p", "Only do this if that address is yours and you asked for this link yourself."), ...(typed ? [el("p", "You own this Brain: whoever writes from this address will be answered as you. Type the last 4 characters of the address to go on."), typed, " "] : []), go, said);
};
run();`;
  app.get("/link", (c) =>
    new Response(`<!doctype html><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Link to this Cloud Brain</title><body style="font:16px/1.5 system-ui,sans-serif;max-width:30em;margin:3em auto;padding:0 1em"><div id="app"></div><scr` + `ipt>const LINK = ${JSON.stringify(linkOf(c.req.query()))};${linkScript}</scr` + `ipt></body>`, { headers: { "content-type": "text/html; charset=utf-8", "cache-control": "no-store", "referrer-policy": "no-referrer", "content-security-policy": "default-src 'none'; style-src 'unsafe-inline'; script-src 'unsafe-inline'; connect-src 'self'; form-action 'self'; frame-ancestors 'none'" } }));
  for (const [path, peek] of [["/link/peek", true], ["/link", false]])
    app.post(path, async (c) => {
      const who = c.get("who");
      if (who.via !== "session" || !who.did) return fail(c, 401, "AuthRequired", "sign in first");
      const body = await c.req.json().catch(() => null), link = linkOf(body);
      // An address bound to the owner is answered as the owner. The owner types its end, so a press on a link that someone else asked for binds nothing; the code is kept.
      const seen = link && !peek && who.caller === "owner" ? await toChannel(link.channel, "claim", { code: link.code, peek: true }) : null;
      if (seen && addressOk(seen.address) && String((body && body.confirm) || "") !== seen.address.slice(-4)) return fail(c, 400, "InvalidRequest", "type the last 4 characters of the address");
      const found = link ? await toChannel(link.channel, "claim", peek ? { code: link.code, peek: true } : { code: link.code }) : null;
      if (!found || !addressOk(found.address)) return fail(c, 404, "NotFound", "this link has expired or was already used");
      if (peek) return c.json({ address: found.address, as: ((handle) => (handle ? "@" + handle : who.did))(await rows.get("handle/" + who.did)), ...(who.caller === "owner" ? { owner: true } : {}) });
      await rows.put(`address/${link.channel}/${found.address}`, { channel: link.channel, address: found.address, did: who.did, linked: Date.now() });
      return c.json({ linked: true, address: found.address, role: await roleOf(who.did) });
    });

  // A portal: one member's services, shown to whoever is signed in, in a frame that holds this token and nothing
  // else of theirs. The viewer is named; the reach is that member's Workers.
  app.post(NS + "portal.token", async (c) => {
    const who = c.get("who");
    if (who.via !== "session" || !who.did) return fail(c, 401, "AuthRequired", "a signed-in session");
    const { author } = await c.req.json().catch(() => ({}));
    if (!DID.test(author || "") || !(await rows.get("member/" + author))) return fail(c, 404, "NotFound", "no member " + String(author).slice(0, 80));
    const id = (await sha256(author)).slice(0, 10), ttl = 600000;
    return c.json({ token: await portalToken.make(await signingKey(), who.did, author, id, { ttl, epoch: (await rows.get("epoch")) || 0 }), author, id, expires: Date.now() + ttl });
  });
  app.post(NS + "portal.modules", async (c) => {
    const who = c.get("who");
    if (!who.portal) return fail(c, 401, "AuthRequired", "a portal token");
    return deployer.fetch(new Request("https://deployer.internal/xrpc/com.lopecode.brain.member.modules", { method: "POST", headers: { "content-type": "application/json", "x-brain-caller": "member" }, body: JSON.stringify({ author: who.portal.author, quota: {}, request: {} }) }));
  });

  // A member's own services go to the deployer with the DID that signed in, in a session, a turn, their own portal or through a PDS.
  // The deployer distils the source and decides; nothing here or in a tab evaluates it.
  for (const name of ["deploy", "remove", "modules"])
    app.post(NS + "member." + name, async (c) => {
      const who = c.get("who");
      const member = who.did && who.caller !== "owner" ? await rows.get("member/" + who.did) : null;
      if (!member) return fail(c, 403, "Forbidden", "a member's own services; the owner deploys with infra.apply");
      if (name === "deploy" && member.services === false) return fail(c, 403, "Forbidden", "the owner has switched services off for this member");
      const request = await c.req.json().catch(() => ({}));
      return deployer.fetch(new Request("https://deployer.internal/xrpc/com.lopecode.brain.member." + name, { method: "POST", headers: { "content-type": "application/json", "x-brain-caller": "member" }, body: JSON.stringify({ author: who.did, quota: member.quota || {}, request }) }));
    });
  // Deploys go to the deployer, for the owner's own session, and for a token of a sign-in link the owner made
  // with deploy. The deployer is told the owner; which token it was is logged here, and the deployer is told too
  // when the link was made to deploy with no approval.
  app.all(NS + "infra.*", async (c) => {
    const who = c.get("who");
    if (!(who.caller === "owner" && who.via === "session") && !(who.via === "token" && who.deploy && deploys(who).includes(c.get("nsid")))) return fail(c, 401, "AuthRequired", "the owner's own session, or a sign-in link made with deploy");
    const url = new URL(c.req.url), bodied = c.req.method === "POST";
    // A deploy does not pass the core, so its line there does not say which token it was. This one does.
    if (who.via === "token") console.log(JSON.stringify({ event: "infra.by.link", token: "d:" + who.delegation, method: c.get("nsid").slice("com.lopecode.brain.".length), at: Date.now() }));
    return deployer.fetch(new Request("https://deployer.internal" + url.pathname + url.search, { method: c.req.method, headers: { "content-type": c.req.header("content-type") || "application/json", "x-brain-caller": "owner", ...(who.via === "token" && who.unattended ? { "x-brain-unattended": "token:" + who.name } : {}) }, body: bodied ? await bodyOf(c) : undefined, duplex: bodied ? "half" : undefined }));
  });
  // The inbox as a tab reads it: each entry gains who its address belongs to, and for the owner's own
  // session a poll gains a turn token for each entry the owner or a member sent. An entry written in a room
  // gains who is in it, and its token is capped by them.
  for (const [verb, name] of [["get", "inbox.list"], ["post", "inbox.poll"]])
    app[verb](NS + name, async (c) => {
      const r = await toCore(c), who = c.get("who");
      if (!r.ok) return r;
      const data = await r.json().catch(() => null);
      const mint = name === "inbox.poll" && who.caller === "owner" && who.via === "session";
      const key = await signingKey(), epoch = (await rows.get("epoch")) || 0;
      const boundOn = async (channel, address) => (addressOk(address) ? (NATIVE.includes(channel) && address === config.owner ? { did: address } : await rows.get(`address/${channel}/${address}`)) : null);
      for (const e of (data && data.entries) || []) {
        const channel = /^worker:brain-x-([a-z0-9-]+)$/.exec(e.from || ""), address = e.body && e.body.address;
        const bound = channel ? await boundOn(channel[1], address) : null;
        const role = bound ? await roleOf(bound.did) : null;
        e.who = bound ? { did: bound.did, role, handle: await rows.get("handle/" + bound.did) } : null;
        delete e.room;
        const said = channel && e.body && e.body.room != null ? e.body.room : null;
        if (said) {
          const id = typeof said.id === "string" && said.id && said.id.length <= 200 ? said.id : null;
          // Who is in the room when the turn is handed out, from the channel. For a list only, what the entry says.
          const now = mint && id ? await toChannel(channel[1], "room", { id }) : null;
          const fresh = !!(now && now.known && Array.isArray(now.members));
          const list = fresh ? now.members : Array.isArray(said.members) ? said.members : [];
          const sure = (fresh || !mint) && id && (fresh ? now : said).complete !== false && list.length <= 50 && list.includes(address);
          const people = [];
          for (const a of list.slice(0, 50)) {
            const b = await boundOn(channel[1], a);
            people.push({ address: String(a).slice(0, 200), did: b ? b.did : null, role: b ? await roleOf(b.did) : null, handle: b ? await rows.get("handle/" + b.did) : null });
          }
          if (!sure) people.push({ address: null, did: null, role: null, handle: null });
          e.room = { id, name: String((fresh ? now.name : said.name) || "").slice(0, 100), served: !fresh || now.served !== false, people };
        }
        if (mint && role && !(e.room && !e.room.served)) e.turn = await turnToken.make(key, bound.did, e.id, { epoch, ...(e.room ? { room: [...new Set(e.room.people.map((p) => p.did))] } : {}) });
      }
      const headers = new Headers(r.headers);
      headers.delete("content-length");
      return new Response(JSON.stringify(data), { status: r.status, headers });
    });
  // Everything else goes to the core as it came.
  app.all("*", (c) => toCore(c));
  return app;
}

// %%
md`## Tests

The kernel runs under \`simulate\` with the core and the deployer replaced by recorders. Sign-in itself needs a PDS and is checked on a deployed kernel.`
// %%
kernelRig = async ({ core, secrets = { SESSION_KEY: "cookie-key", COOKIE_KEY: "cookie-key" } } = {}) => {
  const seen = [], toDeployer = [];
  const record = (list) => async (request) => {
    const body = ["GET", "HEAD"].includes(request.method) ? null : new TextDecoder().decode(await request.arrayBuffer());
    list.push({ url: request.url, method: request.method, headers: Object.fromEntries(request.headers), body });
    return request.url.endsWith("/go") ? new Response(null, { status: 302, headers: { location: "https://example.com/" } }) : Response.json({ ok: true });
  };
  // The core's delegation methods, as far as the kernel uses them: a secret holder made by the owner's session,
  // found by its hash by the kernel. These calls are not in `seen`.
  const held = new Map(), inner = core || record(seen), hexOf = (n) => [...crypto.getRandomValues(new Uint8Array(n))].map((b) => b.toString(16).padStart(2, "0")).join("");
  const withDelegations = async (request) => {
    const m = new URL(request.url).pathname.split("com.lopecode.brain.delegation.")[1], h = request.headers;
    // Anyone else's call is passed on like any other: a member's own delegation.list.
    if (!m || !(h.get("x-brain-caller") === "kernel" || (h.get("x-brain-caller") === "owner" && h.get("x-brain-via") === "session"))) return inner(request);
    const b = request.method === "POST" ? await request.json() : {};
    if (m === "adopt") {
      const d = { id: hexOf(6), name: b.name, from: "owner", holder: { secret: b.sha256 }, scope: b.scope, caps: b.caps, until: b.until, daily: null, note: b.note, created: b.created };
      return (held.set(d.id, d), Response.json(d));
    }
    if (m === "resolve" && b.did) return Response.json({ delegation: [...held.values()].find((d) => d.holder.did === b.did) || null });
    if (m === "create" && b.holder.did) {
      for (const [k, d] of held) if (d.holder.did === b.holder.did) held.delete(k);
      const d = { id: hexOf(6), name: "grant", from: "owner", holder: { did: b.holder.did }, scope: b.scope, caps: [], until: null, daily: null, note: "", created: Date.now() };
      return (held.set(d.id, d), Response.json(d));
    }
    if (m === "resolve") return Response.json({ delegation: [...held.values()].find((d) => d.holder.secret === b.sha256) || null });
    if (m === "list") return Response.json({ delegations: [...held.values()] });
    if (m === "revoke") return Response.json({ revoked: held.delete(b.id) });
    if ([...held.values()].some((d) => !d.holder.did && d.name === b.name && !(d.until && d.until < Date.now()))) return Response.json({ error: "InvalidRequest", message: `a delegation named ${b.name} exists; revoke it first` }, { status: 400 });
    const secret = hexOf(32), d = { id: hexOf(6), name: b.name, from: "owner", holder: { secret: await sha256(secret) }, scope: b.scope, caps: b.caps || [], until: b.until ?? null, daily: b.daily ?? null, note: b.note || "", created: Date.now() };
    held.set(d.id, d);
    return Response.json({ ...d, secret });
  };
  const sim = await simulate(kernel_service, {
    secrets: { ...secrets, BRAIN_KEY: "kernel-key" },
    config: { host: "cb.sub.workers.dev", owner: "did:plc:owner", deployer: "https://cb-deployer.sub.workers.dev" },
    core: withDelegations,
    deployer: record(toDeployer)
  });
  const B = "https://cb.sub.workers.dev";
  // session: a page's session token. bearer: any other token. cookie: sent as a cookie, which nothing reads.
  const call = async (path, { session, cookie, bearer, body, headers = {}, method } = {}) => {
    const r = await sim.fetch(B + (path.startsWith("/") ? path : "/xrpc/com.lopecode.brain." + path), {
      method: method || (body === undefined ? "GET" : "POST"),
      headers: { ...headers, ...(cookie ? { cookie: "theme=dark; brain_session=" + cookie } : {}), ...(bearer || session ? { authorization: "Bearer " + (bearer || session) } : {}), ...(body === undefined ? {} : { "content-type": "application/json" }) },
      body: body === undefined ? undefined : typeof body === "string" ? body : JSON.stringify(body),
      redirect: "manual"
    });
    const text = await r.text();
    let data = text;
    try { data = JSON.parse(text); } catch {}
    return { status: r.status, data, headers: r.headers };
  };
  return { sim, seen, toDeployer, held, call, owner: await sessionToken.make("cookie-key", "did:plc:owner"), other: await sessionToken.make("cookie-key", "did:plc:other") };
}
// %%
test_the_signing_key_is_read_under_either_name = {
  const status = async (rig, token) => (await rig.call("/auth/session", { session: token })).status;
  const old = await sessionToken.make("cookie-key", "did:plc:owner"), fresh = await sessionToken.make("session-key", "did:plc:owner");
  // A Brain installed before the rename: only COOKIE_KEY is bound.
  expect(await status(await kernelRig({ secrets: { COOKIE_KEY: "cookie-key" } }), old)).toBe(200);
  // Only the new name.
  const renamed = await kernelRig({ secrets: { SESSION_KEY: "session-key" } });
  expect([await status(renamed, fresh), await status(renamed, old)]).toEqual([200, 401]);
  // Both names, one value: what a deploy sends from 2026-10-07.
  const both = await kernelRig({ secrets: { SESSION_KEY: "cookie-key", COOKIE_KEY: "cookie-key" } });
  expect(await status(both, old)).toBe(200);
  // Both names, two values: a session made under the old name is still read, and a new token is signed with SESSION_KEY.
  const split = await kernelRig({ secrets: { SESSION_KEY: "session-key", COOKIE_KEY: "cookie-key" } });
  expect([await status(split, old), await status(split, fresh), await status(split, await sessionToken.make("another-key", "did:plc:owner"))]).toEqual([200, 200, 401]);
  await split.call("people.put", { session: old, body: { did: "did:plc:alice" } });
  const made = (await split.call("portal.token", { session: old, body: { author: "did:plc:alice" } })).data;
  expect([!!(await portalToken.read("session-key", made.token)), await portalToken.read("cookie-key", made.token)]).toEqual([true, null]);
  // Neither bound: nothing is signed with an empty key.
  expect(await status(await kernelRig({ secrets: {} }), old)).toBe(401);
  expect((await kernel_service.emit()).meta.secrets.filter((n) => /^(COOKIE|SESSION)_KEY$/.test(n))).toEqual(["COOKIE_KEY", "SESSION_KEY"]);
  return "SESSION_KEY first, COOKIE_KEY still read";
}
// %%
test_session_token = {
  const good = await sessionToken.make("k", "did:plc:a");
  expect(await sessionToken.read("k", good)).toBe("did:plc:a");
  expect(await sessionToken.read("other", good)).toBe(null);
  expect(await sessionToken.read("k", good.slice(0, -2) + "xx")).toBe(null);
  expect(await sessionToken.read("k", await sessionToken.make("k", "did:plc:a", { ttl: -1 }))).toBe(null);
  expect(await sessionToken.read("k", good, 1)).toBe(null);
  const [, payload] = good.split(".");
  const forged = "v1." + btoa(JSON.stringify({ did: "did:plc:owner", exp: Date.now() + 1e6 })) + "." + good.split(".")[2];
  expect(await sessionToken.read("k", forged)).toBe(null);
  const rig = await kernelRig();
  expect((await rig.call("/auth/session")).data).toEqual({ signedIn: false, ownerSet: true });
  expect((await rig.call("/auth/session", { session: rig.owner })).data).toEqual({ signedIn: true, did: "did:plc:owner", handle: null, owner: true });
  expect((await rig.call("/auth/session", { session: rig.other })).data.owner).toBe(false);
  // The same value as a cookie is nobody: nothing a browser attaches by itself is read.
  expect((await rig.call("/auth/session", { cookie: rig.owner })).data).toEqual({ signedIn: false, ownerSet: true });
  expect((await rig.call("token.list", { cookie: rig.owner })).status).toBe(401);
  await rig.call("inbox.list", { cookie: rig.owner });
  expect(rig.seen.at(-1).headers["x-brain-caller"]).toBe("anonymous");
  // A session that has expired, or from before "sign out everywhere", is refused, not treated as nobody.
  expect((await rig.call("/auth/session", { session: await sessionToken.make("cookie-key", "did:plc:owner", { ttl: -1 }) })).status).toBe(401);
  expect((await rig.call("/auth/logout?everywhere=true", { session: rig.owner, method: "POST" })).status).toBe(204);
  expect((await rig.call("/auth/session", { session: rig.owner })).status).toBe(401);
  return "signed, expiring, tied to an epoch, and not a cookie";
}
// %%
test_forged_caller_is_dropped = {
  const rig = await kernelRig();
  await rig.call("inbox.list", { headers: { "x-brain-caller": "owner", "x-brain-via": "session", "x-brain-key": "kernel-key" } });
  expect(rig.seen[0].headers["x-brain-caller"]).toBe("anonymous");
  expect(rig.seen[0].headers["x-brain-via"]).toBe("");
  await rig.call("inbox.list", { session: rig.owner });
  expect(rig.seen[1].headers["x-brain-caller"]).toBe("owner");
  expect(rig.seen[1].headers["x-brain-via"]).toBe("session");
  // The kernel proves itself to the core with its own key, not one the caller sent.
  expect(rig.seen[0].headers["x-brain-key"]).toBe("kernel-key");
  return "anonymous without a session";
}
// %%
test_credentials_are_not_forwarded = {
  const rig = await kernelRig();
  await rig.call("/hooks/whatsapp", { session: rig.owner, headers: { cookie: "a=b", "x-hub-signature-256": "sha256=abc" }, body: '{"raw":  "bytes"}' });
  const got = rig.seen[0];
  expect(got.headers.cookie).toBeUndefined();
  expect(got.headers.authorization).toBeUndefined();
  expect(got.headers["x-hub-signature-256"]).toBe("sha256=abc");
  expect(got.url).toBe("https://core.internal/hooks/whatsapp");
  // The body reaches the core byte for byte: a webhook's signature is over the raw bytes.
  expect(got.body).toBe('{"raw":  "bytes"}');
  return "cookie and authorization removed, body untouched";
}
// %%
test_redirect_from_a_recipe_reaches_the_client = {
  const rig = await kernelRig();
  const r = await rig.call("/go");
  expect(r.status).toBe(302);
  expect(r.headers.get("location")).toBe("https://example.com/");
  return "302";
}
// %%
test_tokens_reach_only_their_methods = {
  const rig = await kernelRig();
  expect((await rig.call("token.create", { body: { name: "laptop", methods: ["proxy.fetch"] } })).status).toBe(401);
  const made = await rig.call("token.create", { session: rig.owner, body: { name: "laptop", methods: ["proxy.fetch"] } });
  expect(made.data.token).toMatch(/^[0-9a-f]{64}$/);
  expect(JSON.stringify([...rig.sim.rows])).not.toContain(made.data.token);
  expect((await rig.call("proxy.fetch", { bearer: made.data.token, body: {} })).status).toBe(200);
  // The core is sent the delegation's id, and from the row says who the call is by.
  expect([rig.seen[0].headers["x-brain-caller"], rig.seen[0].headers["x-brain-delegation"], rig.held.size]).toEqual(["owner", [...rig.held.values()][0].id, 1]);
  // Another origin can read the answer to a call that carried a token.
  expect((await rig.call("proxy.fetch", { bearer: made.data.token, body: {} })).headers.get("access-control-allow-origin")).toBe("*");
  expect((await rig.call("inbox.list", { bearer: made.data.token })).status).toBe(403);
  expect((await rig.call("/notebooks/private", { bearer: made.data.token })).status).toBe(403);
  expect((await rig.call("infra.getState", { bearer: made.data.token })).status).toBe(403);
  expect((await rig.call("token.create", { bearer: made.data.token, body: { name: "more", methods: [] } })).status).toBe(403);
  expect((await rig.call("inbox.list", { bearer: "f".repeat(64) })).status).toBe(401);
  // A token cannot be given the methods that deploy, read secrets or mint access.
  for (const m of ["infra.apply", "secret.get", "token.create", "grant.put"])
    expect((await rig.call("token.create", { session: rig.owner, body: { name: "bad", methods: [m] } })).status).toBe(400);
  // A sign-in link: the owner's session makes it, a GET spends nothing, the first POST is given the token.
  expect((await rig.call("token.link", { bearer: made.data.token, body: { name: "web", methods: ["proxy.fetch"] } })).status).toBe(403);
  expect((await rig.call("token.link", { session: rig.owner, body: { name: "web", methods: ["infra.apply"] } })).status).toBe(400);
  // A link that deploys is good 8 hours and its token a day; one that does not, a week each.
  for (const [more, status] of [[{ hours: 25, deploy: true }, 400], [{ minutes: 481, deploy: true }, 400], [{ hours: 169 }, 400], [{ minutes: 10081 }, 400], [{ daily: "1" }, 400], [{ daily: -1 }, 400]])
    expect([more, (await rig.call("token.link", { session: rig.owner, body: { name: "web", methods: [], ...more } })).status]).toEqual([more, status]);
  // Not a name a token has.
  expect((await rig.call("token.link", { session: rig.owner, body: { name: "laptop", methods: [] } })).status).toBe(400);
  const link = (await rig.call("token.link", { session: rig.owner, body: { name: "web", methods: ["proxy.fetch"], hours: 1 } })).data;
  const at = link.link.slice(link.link.indexOf("/auth/link"));
  expect(JSON.stringify([...rig.sim.rows])).not.toContain(at.split("code=")[1]);
  expect((await rig.call(at)).status).toBe(200);
  const both = await Promise.all([rig.call(at, { method: "POST" }), rig.call(at, { method: "POST" })]);
  expect(both.map((r) => r.status).sort()).toEqual([200, 401]);
  const web = both.find((r) => r.status === 200).data;
  expect([web.name, web.methods]).toEqual(["web", ["com.lopecode.brain.proxy.fetch"]]);
  expect((await rig.call("proxy.fetch", { bearer: web.token, body: {} })).status).toBe(200);
  expect((await rig.call("inbox.list", { bearer: web.token })).status).toBe(403);
  expect((await rig.call("/llms.txt", { bearer: web.token })).status).toBe(403);
  expect(JSON.stringify([...rig.sim.rows])).not.toContain(web.token);
  const listed = async () => (await rig.call("token.list", { session: rig.owner })).data.tokens.map((t) => [t.name, t.by || null]).sort();
  expect(await listed()).toEqual([["laptop", null], ["web", "link"]]);
  expect(Math.abs((web.until - Date.now()) / 60000 - 60)).toBeLessThan(2);
  // The token ends by itself, and so does a link nobody used.
  for (const d of rig.held.values()) if (d.note === "sign-in link") d.until = Date.now() - 1;
  expect((await rig.call("proxy.fetch", { bearer: web.token, body: {} })).data.message).toBe("this token has expired");
  expect(await listed()).toEqual([["laptop", null]]);
  const madeLate = (await rig.call("token.link", { session: rig.owner, body: { name: "late", methods: [] } })).data;
  const late = madeLate.link;
  // Left alone, a link is good for 8 hours.
  expect(Math.round((madeLate.until - Date.now()) / 60000)).toBe(480);
  for (const [k, v] of rig.sim.rows) if (v && v.name === "late") rig.sim.rows.set(k, { ...v, until: Date.now() - 1 });
  expect((await rig.call(late.slice(late.indexOf("/auth/link")), { method: "POST" })).status).toBe(401);
  // A link made with deploy: its token reaches infra.* as the owner's session does, and still no secret or token method.
  expect((await rig.call("token.link", { session: rig.owner, body: { name: "dep", methods: [], deploy: "yes" } })).status).toBe(400);
  expect((await rig.call("infra.getState", { bearer: made.data.token })).status).toBe(403);
  const dep = (await rig.call("token.link", { session: rig.owner, body: { name: "dep", methods: [], deploy: true } })).data;
  const ship = (await rig.call(dep.link.slice(dep.link.indexOf("/auth/link")), { method: "POST" })).data;
  expect([ship.deploy, web.deploy]).toEqual([true, false]);
  const lines = [], was = console.log;
  console.log = (line) => lines.push(line);
  try {
    expect((await rig.call("infra.getState", { bearer: ship.token })).status).toBe(200);
  } finally {
    console.log = was;
  }
  // The kernel says which token it was: the deployer is told the owner.
  expect(lines.filter((l) => typeof l === "string" && l.includes("infra.by.link")).map((l) => JSON.parse(l)).map((l) => [l.event, l.token, l.method])).toEqual([["infra.by.link", "d:" + [...rig.held.values()].find((d) => d.name === "dep").id, "infra.getState"]]);
  for (const m of ["infra.confirm", "infra.redistil"]) expect((await rig.call(m, { bearer: ship.token, body: {} })).status).toBe(200);
  // Not the page at /, and no other infra name.
  for (const m of ["infra.shell", "infra.distil", "infra.rollback"]) expect((await rig.call(m, { bearer: ship.token, body: {} })).status).toBe(403);
  expect((await rig.call("infra.apply", { bearer: ship.token, body: { workers: [], reason: "a test" } })).status).toBe(200);
  expect(rig.toDeployer.at(-1).headers["x-brain-caller"]).toBe("owner");
  for (const m of ["secret.get", "token.list", "people.list", "inbox.list"]) expect((await rig.call(m, { bearer: ship.token })).status).toBe(403);
  expect((await rig.call("token.create", { bearer: ship.token, body: { name: "more", methods: [] } })).status).toBe(403);
  await rig.call("token.revoke", { session: rig.owner, body: { name: "dep" } });
  expect((await rig.call("infra.getState", { bearer: ship.token })).status).toBe(401);
  // A link made to deploy with no approval: the deployer is told which token, and the page at / is in reach.
  expect((await rig.call("token.link", { session: rig.owner, body: { name: "free", methods: [], unattended: true } })).status).toBe(400);
  const free = (await rig.call("token.link", { session: rig.owner, body: { name: "free", methods: [], deploy: true, unattended: true } })).data;
  const run = (await rig.call(free.link.slice(free.link.indexOf("/auth/link")), { method: "POST" })).data;
  expect([run.deploy, run.unattended]).toEqual([true, true]);
  expect((await rig.call("infra.apply", { bearer: run.token, body: { workers: [], reason: "a test" } })).status).toBe(200);
  expect(rig.toDeployer.at(-1).headers["x-brain-unattended"]).toBe("token:free");
  expect((await rig.call("infra.shell", { bearer: run.token, body: "<p>page</p>" })).status).toBe(200);
  expect((await rig.call("infra.distil", { bearer: run.token, body: {} })).status).toBe(403);
  expect((await rig.call("secret.get", { bearer: run.token })).status).toBe(403);
  // The owner's session, and a link made with deploy alone, send no such header; a caller cannot send it either.
  await rig.call("infra.getState", { session: rig.owner, headers: { "x-brain-unattended": "token:free" } });
  expect(rig.toDeployer.at(-1).headers["x-brain-unattended"]).toBe(undefined);
  await rig.call("token.revoke", { session: rig.owner, body: { name: "free" } });
  // Such a token's delegation has the cap session.
  expect((await rig.call("token.link", { session: rig.owner, body: { name: "bad", methods: ["pro*"] } })).status).toBe(400);
  const wide = (await rig.call("token.link", { session: rig.owner, body: { name: "wide", methods: ["proxy.*", "logs.query"], deploy: true, unattended: true } })).data;
  const all = (await rig.call(wide.link.slice(wide.link.indexOf("/auth/link")), { method: "POST" })).data;
  const said = [], plain = console.log;
  console.log = (...a) => said.push(a[0]);
  try { expect((await rig.call("proxy.fetch", { bearer: all.token, body: {} })).status).toBe(200); } finally { console.log = plain; }
  // No rewrite and no line of the kernel's: the core reads the cap session from the row, and its line has the id.
  expect(said.filter((l) => typeof l === "string" && l.includes("call.by.link"))).toEqual([]);
  expect([rig.seen.at(-1).headers["x-brain-caller"], rig.seen.at(-1).headers["x-brain-via"], rig.seen.at(-1).headers["x-brain-delegation"]]).toEqual(["owner", "token", [...rig.held.values()].find((d) => d.name === "wide").id]);
  expect([...rig.held.values()].find((d) => d.name === "wide").caps).toEqual(["deploy", "unattended", "session"]);
  expect((await rig.call("inbox.list", { bearer: all.token })).status).toBe(403);
  await rig.call("token.revoke", { session: rig.owner, body: { name: "wide" } });
  // A prefix: every method under it, none beside it, and never a name a token may not have.
  for (const bad of ["secret.*", "infra.*", "infra/*", "secret/x", "pro*", "*.fetch", "proxy.*.x", "", "ai.v1/", "ai.v1//x", "ai/v1.x", "ai.v1/*/x", "/x"]) expect((await rig.call("token.create", { session: rig.owner, body: { name: "bad", methods: [bad] } })).status).toBe(400);
  const star = (await rig.call("token.create", { session: rig.owner, body: { name: "star", methods: ["proxy.*"] } })).data.token;
  expect((await rig.call("proxy.fetch", { bearer: star, body: {} })).status).toBe(200);
  expect(rig.seen.at(-1).headers["x-brain-caller"]).toBe("owner");
  expect((await rig.call("proxyx.fetch", { bearer: star, body: {} })).status).toBe(403);
  // A link whose name a token took since it was made: no token is made, and the link is not spent.
  const twice = (await rig.call("token.link", { session: rig.owner, body: { name: "twice", methods: [] } })).data.link;
  await rig.call("token.create", { session: rig.owner, body: { name: "twice", methods: [] } });
  const links = () => [...rig.sim.rows.keys()].filter((k) => k.startsWith("link/")).length;
  expect([(await rig.call(twice.slice(twice.indexOf("/auth/link")), { method: "POST" })).status, links(), (await rig.call("token.revoke", { session: rig.owner, body: { name: "twice" } })).data, links()]).toEqual([409, 1, { revoked: 2 }, 0]);
  // A token made before 2026-10-10 is a row of the kernel until it is first met. It is then handed to the core by
  // its hash, with the caps its row had, and the row goes. A row that is never met is handed over when tokens are listed.
  const H = "com.lopecode.brain.", rowsOf = () => [...rig.sim.rows.keys()].filter((k) => k.startsWith("token/")).length;
  rig.sim.rows.set("token/" + (await sha256("made-before")), { name: "old", methods: [H + "proxy.fetch"], created: 1 });
  rig.sim.rows.set("token/" + (await sha256("made-free")), { name: "oldfree", methods: [H + "proxy.*"], created: 2, until: Date.now() + 60000, by: "link", deploy: true, unattended: true });
  rig.sim.rows.set("token/" + (await sha256("made-twin")), { name: "old", methods: [], created: 4 });
  rig.sim.rows.set("token/" + (await sha256("made-ended")), { name: "oldended", methods: [], created: 3, until: Date.now() - 1, by: "link" });
  expect([(await rig.call("proxy.fetch", { bearer: "made-before", body: {} })).status, rig.seen.at(-1).headers["x-brain-caller"], rig.seen.at(-1).headers["x-brain-delegation"], (await rig.call("inbox.list", { bearer: "made-before" })).status, rowsOf()]).toEqual([200, "owner", [...rig.held.values()].find((d) => d.name === "old").id, 403, 3]);
  expect((await rig.call("proxy.fetch", { bearer: "made-ended", body: {} })).data.message).toBe("this token has expired");
  expect([(await listed()).filter((t) => t[0].startsWith("old")), rowsOf(), [...rig.held.values()].find((d) => d.name === "oldfree").caps]).toEqual([[["old", null], ["old", null], ["oldfree", "link"]], 0, ["deploy", "unattended", "session"]]);
  expect([(await rig.call("infra.shell", { bearer: "made-free", body: "<p>page</p>" })).status, rig.toDeployer.at(-1).headers["x-brain-unattended"]]).toEqual([200, "token:oldfree"]);
  // Two tokens from before could have one name. Each keeps it, and token.revoke ends both, as it did.
  expect([(await rig.call("token.revoke", { session: rig.owner, body: { name: "old" } })).data, (await rig.call("proxy.fetch", { bearer: "made-before", body: {} })).status, (await rig.call("proxy.fetch", { bearer: "made-twin", body: {} })).status]).toEqual([{ revoked: 2 }, 401, 401]);
  const every = (await rig.call("token.create", { session: rig.owner, body: { name: "every", methods: ["*"] } })).data.token;
  expect((await rig.call("inbox.list", { bearer: every })).status).toBe(200);
  for (const m of ["secret.get", "token.list", "infra.getState", "people.list"]) expect((await rig.call(m, { bearer: every })).status).toBe(403);
  // A name with a /: the whole name, or everything under the part before a /*. Neither reaches the names beside it.
  const whole = (await rig.call("token.create", { session: rig.owner, body: { name: "whole", methods: ["ai.v1/chat/completions"] } })).data.token;
  const under = (await rig.call("token.create", { session: rig.owner, body: { name: "under", methods: ["ai.v1/*"] } })).data.token;
  expect(await Promise.all(["ai.v1/chat/completions", "ai.v1/models", "ai.run", "ai.v1x/models"].map(async (m) => (await rig.call(m, { bearer: whole, body: {} })).status))).toEqual([200, 403, 403, 403]);
  expect(await Promise.all(["ai.v1/chat/completions", "ai.v1/models", "ai.run", "ai.v1x/models"].map(async (m) => (await rig.call(m, { bearer: under, body: {} })).status))).toEqual([200, 200, 403, 403]);
  for (const n of ["whole", "under"]) await rig.call("token.revoke", { session: rig.owner, body: { name: n } });
  // A member's method: its id is hex and may begin with a digit. A grant to a DID takes no prefix.
  expect((await rig.call("token.create", { session: rig.owner, body: { name: "mem", methods: ["m.0a1b2c3d4e.hello", "m.0a1b2c3d4e.*"] } })).status).toBe(200);
  for (const m of ["proxy.*", "*"]) expect((await rig.call("grant.put", { session: rig.owner, body: { did: "did:plc:other", methods: [m] } })).status).toBe(400);
  for (const n of ["star", "every", "mem"]) await rig.call("token.revoke", { session: rig.owner, body: { name: n } });
  // A link pasted in the wrong place is ended by its name, before anyone uses it.
  const wrong = (await rig.call("token.link", { session: rig.owner, body: { name: "wrong", methods: [] } })).data.link;
  expect((await rig.call("token.revoke", { session: rig.owner, body: { name: "wrong" } })).data).toEqual({ revoked: 1 });
  expect((await rig.call(wrong.slice(wrong.indexOf("/auth/link")), { method: "POST" })).status).toBe(401);
  expect((await rig.call("token.revoke", { session: rig.owner, body: { name: "laptop" } })).data).toEqual({ revoked: 1 });
  expect((await rig.call("proxy.fetch", { bearer: made.data.token, body: {} })).status).toBe(401);
  return "one method, then revoked";
}
// %%
test_a_token_with_the_cap_delegate_reaches_the_delegation_methods = {
  const rig = await kernelRig(), P = "com.lopecode.brain.proxy.fetch";
  const put = async (name, secret, more) => {
    const d = { id: (await sha256(secret)).slice(0, 12), name, from: "owner", holder: { secret: await sha256(secret) }, scope: [P], caps: [], until: null, daily: null, parent: null, note: "", created: Date.now(), ...more };
    return (rig.held.set(d.id, d), d);
  };
  const agent = await put("agent", "agent-secret", { caps: ["delegate"] });
  await put("plain", "plain-secret");
  await put("sub", "sub-secret", { parent: agent.id });
  await put("theirs", "their-secret", { from: "did:plc:other" });
  // The three methods pass the kernel to the core with the id, where the core says what may be made. No other
  // method of the never kind does, and a token without the cap reaches none of them.
  const status = async (bearer, m) => (await rig.call(m, { bearer, ...(m.endsWith("list") ? {} : { body: {} }) })).status;
  expect([await status("agent-secret", "delegation.list"), rig.seen.at(-1).headers["x-brain-delegation"], await status("agent-secret", "delegation.create"), await status("agent-secret", "delegation.revoke"), await status("agent-secret", "token.list"), await status("agent-secret", "grant.list")]).toEqual([200, agent.id, 200, 200, 403, 403]);
  expect([await status("plain-secret", "delegation.list"), await status("sub-secret", "delegation.create"), await status("plain-secret", "proxy.fetch")]).toEqual([403, 403, 200]);
  // token.list is the owner's own tokens: not one made under another, and not a member's.
  expect((await rig.call("token.list", { session: rig.owner })).data.tokens.map((t) => [t.name, !!t.delegate]).sort()).toEqual([["agent", true], ["plain", false]]);
  return "delegate: three methods reach the core";
}
// %%
test_a_program_asks_for_more = {
  const rig = await kernelRig();
  const pair = await crypto.subtle.generateKey({ name: "RSA-OAEP", modulusLength: 2048, publicExponent: new Uint8Array([1, 0, 1]), hash: "SHA-256" }, true, ["encrypt", "decrypt"]);
  const publicKey = btoa(String.fromCharCode(...new Uint8Array(await crypto.subtle.exportKey("spki", pair.publicKey))));
  const open = async (id) => new TextDecoder().decode(await crypto.subtle.decrypt({ name: "RSA-OAEP" }, pair.privateKey, Uint8Array.from(atob((await rig.call("token.requested?id=" + id)).data.sealed), (ch) => ch.charCodeAt(0))));
  const redeem = async (link) => (await rig.call(link.slice(link.indexOf("/auth/link")), { method: "POST" })).data;
  const held = () => [...rig.held.values()].map((d) => [d.name.replace(/-[0-9a-f]{4}$/, "-x"), d.scope.map((m) => m.split(".").pop()), d.caps]);
  // No token: anyone asks, with a key. Only the owner's own tab answers, with no more than was asked.
  expect((await rig.call("token.request", { body: { name: "cc", methods: [], reason: "start", publicKey: "AAAA" } })).status).toBe(400);
  expect((await rig.call("token.request", { body: { name: "cc", methods: [], reason: "start", publicKey, caps: ["unattended"] } })).status).toBe(400);
  const first = (await rig.call("token.request", { body: { name: "cc", methods: ["proxy.fetch"], reason: "start", publicKey, caps: ["session"] } })).data;
  expect([first.kind, first.url]).toEqual(["new", "https://cb.sub.workers.dev/auth/request?id=" + first.id]);
  expect(first.code).toMatch(/^[0-9A-F]{3}-[0-9A-F]{3}$/);
  expect([401, 403]).toContain((await rig.call("token.approve", { session: rig.other, body: { id: first.id } })).status);
  expect((await rig.call("token.requests", { session: rig.owner })).data.requests.map((r) => r.name)).toEqual(["cc"]);
  expect((await rig.call("token.approve", { session: rig.owner, body: { id: first.id, hours: 9 } })).status).toBe(400);
  expect((await rig.call("token.approve", { session: rig.owner, body: { id: first.id, caps: ["session", "deploy"] } })).data.granted.caps).toEqual(["session"]);
  expect((await rig.call("token.approve", { session: rig.owner, body: { id: first.id } })).status).toBe(409);
  const link = await open(first.id);
  expect(JSON.stringify([...rig.sim.rows])).not.toContain(link.split("code=")[1]);
  const cc = await redeem(link);
  expect(cc.name).toMatch(/^cc-[0-9a-f]{4}$/);
  expect(held()).toEqual([["cc-x", ["fetch"], ["session"]]]);
  // A token asks for more, whatever it names, and only for itself.
  expect((await rig.call("inbox.list", { bearer: cc.token })).status).toBe(403);
  expect((await rig.call("token.request", { bearer: cc.token, body: { methods: ["token.create"], reason: "more power", publicKey } })).status).toBe(400);
  const more = (await rig.call("token.request", { bearer: cc.token, body: { methods: ["inbox.list"], reason: "read the inbox", publicKey, hours: 2 } })).data;
  expect([more.kind, more.name]).toEqual(["upgrade", cc.name]);
  expect((await rig.call("token.approve", { bearer: cc.token, body: { id: more.id } })).status).toBe(403);
  expect((await rig.call("token.requested?id=" + more.id, { bearer: cc.token })).data.status).toBe("pending");
  expect((await rig.call("token.requested?id=" + more.id, { session: rig.owner })).data.token.caps).toEqual(["session"]);
  await rig.call("token.approve", { session: rig.owner, body: { id: more.id } });
  // The old token works until the new link is used, and using it ends the old one.
  expect((await rig.call("proxy.fetch", { bearer: cc.token, body: {} })).status).toBe(200);
  const cc2 = await redeem(await open(more.id));
  expect(held()).toEqual([["cc-x", ["fetch", "list"], ["session"]]]);
  expect([(await rig.call("proxy.fetch", { bearer: cc.token, body: {} })).status, (await rig.call("inbox.list", { bearer: cc2.token })).status]).toEqual([401, 200]);
  expect((await rig.call("/auth/request?id=" + more.id)).headers.get("content-security-policy")).toContain("frame-ancestors 'none'");
  // A guest's link: a week, with a cap on what it spends a day, which the token that replaces it keeps.
  const invite = (await rig.call("token.link", { session: rig.owner, body: { name: "guest-bo", methods: ["proxy.fetch"], minutes: 10080, hours: 168, daily: 0.1 } })).data;
  expect([invite.daily, invite.until > Date.now() + 6 * 86400000]).toEqual([0.1, true]);
  const bo = await redeem(invite.link);
  expect([bo.daily, bo.deploy, bo.until > Date.now() + 6 * 86400000, [...rig.held.values()].find((d) => d.name === "guest-bo").daily]).toEqual([0.1, false, true, 0.1]);
  const wider = (await rig.call("token.request", { bearer: bo.token, body: { methods: ["inbox.list"], reason: "a guest asks", publicKey } })).data;
  await rig.call("token.approve", { session: rig.owner, body: { id: wider.id } });
  const bo2 = await redeem(await open(wider.id));
  expect(bo2.until >= bo.until).toBe(true);
  expect([bo2.daily, [...rig.held.values()].filter((d) => d.name.startsWith("guest-bo")).map((d) => d.daily)]).toEqual([0.1, [0.1]]);
  expect((await rig.call("/auth/ask")).data).toContain("Only the owner of this Brain can answer");
  // A refusal says where to ask, and that page says how.
  expect((await rig.call("knowledge.put", { bearer: cc2.token, body: {} })).data.message).toContain("/auth/ask");
  expect((await rig.call("/auth/ask")).data).toContain("token.request");
  return "a sealed link, a token replaced by a wider one, and only the owner's tab answers";
}
// %%
test_another_did_needs_a_grant = {
  const rig = await kernelRig();
  expect((await rig.call("index.search", { session: rig.other })).status).toBe(403);
  await rig.call("grant.put", { session: rig.owner, body: { did: "did:plc:other", methods: ["index.search"] } });
  expect((await rig.call("index.search", { session: rig.other })).status).toBe(200);
  expect(rig.seen.find((s) => s.url.endsWith(".index.search")).headers["x-brain-caller"]).toBe("did:plc:other");
  expect((await rig.call("inbox.list", { session: rig.other })).status).toBe(403);
  // A page is not a method: a signed-in visitor is anonymous there.
  await rig.call("/notebooks/x", { session: rig.other });
  expect(rig.seen.at(-1).headers["x-brain-caller"]).toBe("anonymous");
  expect((await rig.call("grant.put", { session: rig.other, body: { did: "did:plc:other", methods: ["inbox.list"] } })).status).toBe(403);
  // The grant is a delegation that the DID holds, in the core; the kernel keeps no row. A second takes its place.
  const grantsOf = () => [...rig.held.values()].filter((d) => d.holder.did === "did:plc:other").map((d) => d.scope);
  expect([grantsOf(), [...rig.sim.rows.keys()].filter((k) => k.startsWith("grant/")), (await rig.call("grant.list", { session: rig.owner })).data.grants.map((g) => [g.did, g.methods])]).toEqual([[["com.lopecode.brain.index.search"]], [], [["did:plc:other", ["com.lopecode.brain.index.search"]]]]);
  await rig.call("grant.put", { session: rig.owner, body: { did: "did:plc:other", methods: ["inbox.list"] } });
  expect([grantsOf(), (await rig.call("index.search", { session: rig.other })).status, (await rig.call("inbox.list", { session: rig.other })).status]).toEqual([[["com.lopecode.brain.inbox.list"]], 403, 200]);
  expect([(await rig.call("grant.delete", { session: rig.owner, body: { did: "did:plc:other" } })).data, (await rig.call("inbox.list", { session: rig.other })).status, (await rig.call("grant.delete", { session: rig.owner, body: { did: "did:plc:other" } })).data]).toEqual([{ deleted: true }, 403, { deleted: false }]);
  // A grant from before 2026-10-10 is a row here until the DID next calls, and is then made in the core.
  rig.sim.rows.set("grant/did:plc:other", { did: "did:plc:other", methods: ["com.lopecode.brain.index.search"], granted: 1 });
  expect([(await rig.call("index.search", { session: rig.other })).status, rig.sim.rows.has("grant/did:plc:other"), grantsOf()]).toEqual([200, false, [["com.lopecode.brain.index.search"]]]);
  return "403 until granted";
}
// %%
// A core with an inbox and one channel, brain-x-loop, for the people tests.
peopleCore = () => {
  const seen = [], codes = new Map([["code-1234", "+100"], ["code-5678", "+100"]]), known = new Set();
  const entry = (id, from, body) => ({ id, source: "loop", from, key: "k" + id, received_at: 1, body, done_at: null });
  const entries = [
    entry(1, "worker:brain-x-loop", { text: "hi", address: "+100" }),
    entry(2, "worker:brain-x-loop", { text: "hi", address: "+200" }),
    entry(3, "worker:brain-x-loop", { text: "hi", address: "+300" }),
    entry(4, "worker:brain-x-loop", { text: "hi", address: "+999", who: { did: "did:plc:owner", role: "owner" }, turn: "t1.x.y" }),
    entry(5, "worker:brain-x-evil", { text: "hi", address: "+100" }),
    entry(6, "deployer", { event: "deployed", address: "+100" })
  ];
  const core = async (request) => {
    const url = new URL(request.url), nsid = url.pathname.replace("/xrpc/com.lopecode.brain.", "");
    const caller = request.headers.get("x-brain-caller"), via = request.headers.get("x-brain-via");
    const body = request.method === "POST" ? await request.json().catch(() => null) : null;
    seen.push({ nsid, caller, via, body });
    const by = { "x-brain-served-by": "brain-x-loop@abc, brain-core@def" };
    if (nsid === "inbox.poll" || nsid.startsWith("inbox.list")) return Response.json({ held: true, entries: JSON.parse(JSON.stringify(entries)), waiting: entries.length });
    if (nsid === "loop.claim" || nsid === "evil.claim") {
      const address = caller === "kernel" ? codes.get(body.code) : null;
      if (!address) return Response.json({ error: "NotFound" }, { status: 404, headers: by });
      if (!body.peek) (codes.delete(body.code), known.add(address));
      return Response.json({ address }, { headers: by });
    }
    if (nsid === "loop.know") return (body.forget ? known.delete(body.address) : known.add(body.address), Response.json({ known: !body.forget }, { headers: by }));
    return Response.json({ ok: true });
  };
  return { core, seen, codes, known };
}
// %%
peopleRig = async () => {
  const fake = peopleCore();
  const rig = await kernelRig({ core: fake.core });
  const bind = (address, did) => rig.sim.rows.set("address/loop/" + address, { channel: "loop", address, did, linked: 1 });
  bind("+100", "did:plc:owner");
  bind("+200", "did:plc:other");
  bind("+300", "did:plc:guest");
  rig.sim.rows.set("member/did:plc:other", { did: "did:plc:other", name: "Ada", added: 1 });
  return { ...rig, ...fake, bind };
}
// %%
test_turn_token = {
  const good = await turnToken.make("k", "did:plc:a", 7);
  expect(await turnToken.read("k", good)).toEqual({ did: "did:plc:a", entry: 7 });
  expect(await turnToken.read("other", good)).toBe(null);
  expect(await turnToken.read("k", good.slice(0, -2) + "xx")).toBe(null);
  expect(await turnToken.read("k", await turnToken.make("k", "did:plc:a", 7, { ttl: -1 }))).toBe(null);
  expect(await turnToken.read("k", good, 1)).toBe(null);
  // Same key, different label: a session is not a turn token and a turn token is not a session.
  const session = await sessionToken.make("k", "did:plc:a");
  expect(await turnToken.read("k", "t1." + session.split(".").slice(1).join("."))).toBe(null);
  expect(await sessionToken.read("k", "v1." + good.split(".").slice(1).join("."))).toBe(null);
  return "signed, expiring, tied to an epoch, not a session";
}
// %%
test_poll_names_the_sender_and_hands_the_owner_turn_tokens = {
  const rig = await peopleRig();
  const poll = (await rig.call("inbox.poll", { session: rig.owner, body: { tab: "a" } })).data;
  // Owner, member, linked but not added, not linked, the owner's address on another channel, not a channel.
  expect(poll.entries.map((e) => e.who && [e.who.did, e.who.role])).toEqual([["did:plc:owner", "owner"], ["did:plc:other", "member"], ["did:plc:guest", null], null, null, null]);
  expect(poll.entries.map((e) => typeof e.turn)).toEqual(["string", "string", "undefined", "undefined", "undefined", "undefined"]);
  // What a channel wrote about the sender is still in the body and is not what the kernel says.
  expect(poll.entries[3].body.who.role).toBe("owner");
  expect(await turnToken.read("cookie-key", poll.entries[1].turn)).toEqual({ did: "did:plc:other", entry: 2 });
  expect(poll.held).toBe(true);
  // inbox.list names the sender and carries no token. Nor does a poll by a named token.
  const list = (await rig.call("inbox.list?all=true", { session: rig.owner })).data;
  expect(list.entries.map((e) => [e.who && e.who.role, e.turn])).toEqual([["owner", undefined], ["member", undefined], [null, undefined], [null, undefined], [null, undefined], [null, undefined]]);
  const { token } = (await rig.call("token.create", { session: rig.owner, body: { name: "poller", methods: ["inbox.poll"] } })).data;
  const byToken = (await rig.call("inbox.poll", { bearer: token, body: { tab: "b" } })).data;
  expect(byToken.entries.some((e) => e.turn)).toBe(false);
  return "2 tokens for 6 entries";
}
// %%
test_a_turn_is_made_as_its_sender = {
  const rig = await peopleRig();
  const poll = (await rig.call("inbox.poll", { session: rig.owner, body: { tab: "a" } })).data;
  const member = poll.entries[1].turn, own = poll.entries[0].turn;
  rig.seen.length = 0;
  expect((await rig.call("inbox.reply", { bearer: member, body: { id: 2, text: "hello" } })).status).toBe(200);
  expect(rig.seen[0]).toMatchObject({ nsid: "inbox.reply", caller: "did:plc:other", via: "turn:2" });
  for (const m of ["library.list", "inbox.list", "secret.list", "whatsapp.send", "people.list", "people.put", "grant.put", "infra.getState"])
    expect([m, (await rig.call(m, { bearer: member, body: {} })).status]).toEqual([m, 403]);
  // A grant widens that member by the methods it names and no others.
  await rig.call("grant.put", { session: rig.owner, body: { did: "did:plc:other", methods: ["library.list"] } });
  expect((await rig.call("library.list", { bearer: member, body: {} })).status).toBe(200);
  expect((await rig.call("secret.list", { bearer: member, body: {} })).status).toBe(403);
  // The owner's turn is the owner without the owner's own session.
  rig.seen.length = 0;
  expect((await rig.call("library.list", { bearer: own, body: {} })).status).toBe(200);
  expect(rig.seen[0]).toMatchObject({ caller: "owner", via: "turn:1" });
  for (const m of ["token.create", "grant.put", "people.put", "people.remove", "infra.apply"])
    expect([m, (await rig.call(m, { bearer: own, body: { did: "did:plc:x", methods: [] } })).status]).toEqual([m, 401]);
  // Refused: a changed token, an expired one, one for a DID that is not a member, one from before "sign out everywhere".
  expect((await rig.call("inbox.reply", { bearer: member.slice(0, -2) + "xx", body: {} })).status).toBe(401);
  expect((await rig.call("inbox.reply", { bearer: await turnToken.make("cookie-key", "did:plc:other", 2, { ttl: -1 }), body: {} })).status).toBe(401);
  expect((await rig.call("inbox.reply", { bearer: await turnToken.make("other-key", "did:plc:owner", 1), body: {} })).status).toBe(401);
  expect((await rig.call("inbox.reply", { bearer: await turnToken.make("cookie-key", "did:plc:guest", 3), body: {} })).data.message).toBe("did:plc:guest is not a member");
  await rig.call("people.remove", { session: rig.owner, body: { did: "did:plc:other" } });
  expect((await rig.call("inbox.reply", { bearer: member, body: {} })).status).toBe(403);
  expect((await rig.call("library.list", { bearer: member, body: {} })).status).toBe(403);
  await rig.call("/auth/logout?everywhere=true", { session: rig.owner, method: "POST" });
  expect((await rig.call("library.list", { bearer: own, body: {} })).status).toBe(401);
  return "member: 1 method, then 2 with a grant; owner: no session-only method";
}
// %%
test_link_joins_an_address_to_the_signed_in_did = {
  const rig = await peopleRig();
  const link = { channel: "loop", code: "code-1234" };
  // The page is the same for everyone and looks at no code: its script asks, with the session the browser kept.
  const pageOf = await rig.call("/link?channel=loop&code=code-1234");
  expect(pageOf.status).toBe(200);
  expect(pageOf.data).toContain('const LINK = {"channel":"loop","code":"code-1234"};');
  expect((await rig.call("/link?channel=loop&code=<b>")).data).toContain("const LINK = null;");
  expect(rig.seen.length).toBe(0);
  // Not signed in: nothing is looked up.
  expect((await rig.call("/link/peek", { body: link })).status).toBe(401);
  expect((await rig.call("/link", { body: link })).status).toBe(401);
  expect((await rig.call("/link", { cookie: rig.other, body: link })).status).toBe(401);
  expect(rig.seen.length).toBe(0);
  // Signed in: shown the address, and nothing is bound until Link is pressed.
  expect((await rig.call("/link/peek", { session: rig.other, body: link })).data).toEqual({ address: "+100", as: "did:plc:other" });
  expect(rig.codes.has("code-1234")).toBe(true);
  expect(rig.sim.rows.get("address/loop/+100").did).toBe("did:plc:owner");
  // A code for one channel, answered by another channel's Worker, binds nothing.
  expect((await rig.call("/link", { session: rig.other, body: { channel: "evil", code: "code-5678" } })).status).toBe(404);
  expect([...rig.sim.rows.keys()].filter((k) => k.startsWith("address/evil"))).toEqual([]);
  expect((await rig.call("/link", { session: rig.other, body: link })).data).toEqual({ linked: true, address: "+100", role: "member" });
  expect(rig.sim.rows.get("address/loop/+100")).toMatchObject({ channel: "loop", address: "+100", did: "did:plc:other" });
  expect(rig.known.has("+100")).toBe(true);
  expect((await rig.call("/link", { session: rig.other, body: link })).status).toBe(404);
  // Linked is not added: someone the owner has not added is told so.
  rig.codes.set("code-9999", "+400");
  const guest = await sessionToken.make("cookie-key", "did:plc:stranger");
  expect((await rig.call("/link", { session: guest, body: { channel: "loop", code: "code-9999" } })).data).toEqual({ linked: true, address: "+400", role: null });
  // A turn or a portal is not a sign-in.
  rig.codes.set("code-7777", "+700");
  expect((await rig.call("/link", { bearer: await turnToken.make("cookie-key", "did:plc:owner", 1), body: { channel: "loop", code: "code-7777" } })).status).toBe(401);
  expect((await rig.call("inbox.poll", { session: rig.owner, body: { tab: "a" } })).data.entries[0].who).toMatchObject({ did: "did:plc:other", role: "member" });
  return "bound on Link, by the signed-in DID, once";
}
// %%
test_the_owner_types_the_end_of_an_address_before_it_is_bound = {
  const rig = await peopleRig();
  rig.codes.set("code-4242", "+4915112345678");
  const link = { channel: "loop", code: "code-4242" };
  expect((await rig.call("/link/peek", { session: rig.owner, body: link })).data).toMatchObject({ address: "+4915112345678", owner: true });
  // One press, as a link from someone else would get: nothing is bound and the code is not used.
  expect((await rig.call("/link", { session: rig.owner, body: link })).status).toBe(400);
  expect((await rig.call("/link", { session: rig.owner, body: { ...link, confirm: "0000" } })).status).toBe(400);
  expect(rig.codes.has("code-4242")).toBe(true);
  expect(rig.sim.rows.has("address/loop/+4915112345678")).toBe(false);
  expect((await rig.call("/link", { session: rig.owner, body: { ...link, confirm: "5678" } })).data).toEqual({ linked: true, address: "+4915112345678", role: "owner" });
  expect(rig.sim.rows.get("address/loop/+4915112345678").did).toBe("did:plc:owner");
  // The page cannot be put in a frame.
  expect((await rig.call("/link?channel=loop&code=code-4242")).headers.get("content-security-policy")).toContain("frame-ancestors 'none'");
  return "400 until the last 4 characters are typed";
}
// %%
test_people_are_the_owners_to_change = {
  const rig = await peopleRig();
  const turn = await turnToken.make("cookie-key", "did:plc:owner", 1);
  expect((await rig.call("people.put", { body: { did: "did:plc:new" } })).status).toBe(401);
  expect((await rig.call("people.put", { session: rig.other, body: { did: "did:plc:other" } })).status).toBe(403);
  expect((await rig.call("people.put", { bearer: turn, body: { did: "did:plc:new" } })).status).toBe(401);
  expect((await rig.call("people.put", { session: rig.owner, body: { did: "not a did" } })).status).toBe(400);
  expect((await rig.call("people.put", { session: rig.owner, body: { did: "did:plc:owner" } })).status).toBe(400);
  expect((await rig.call("people.put", { session: rig.owner, body: { did: "did:plc:new", name: "Bo" } })).data).toEqual({ did: "did:plc:new", role: "member" });
  expect((await rig.call("people.link", { session: rig.owner, body: { channel: "loop", address: "+500", did: "did:plc:new" } })).data).toMatchObject({ role: "member" });
  expect(rig.seen.at(-1)).toMatchObject({ nsid: "loop.know", caller: "kernel", body: { address: "+500" } });
  // A channel nobody runs cannot be linked to.
  expect((await rig.call("people.link", { session: rig.owner, body: { channel: "nochannel", address: "+1", did: "did:plc:new" } })).status).toBe(502);
  await rig.call("grant.put", { session: rig.owner, body: { did: "did:plc:new", methods: ["library.list"] } });
  const { people } = (await rig.call("people.list", { session: rig.owner })).data;
  expect(people.map((p) => [p.did, p.role, p.addresses.map((a) => a.address).join(), p.methods.length])).toEqual([["did:plc:owner", "owner", "+100", 0], ["did:plc:new", "member", "did:plc:new,+500", 1], ["did:plc:other", "member", "+200", 0], ["did:plc:guest", null, "+300", 0]]);
  expect((await rig.call("people.remove", { session: rig.owner, body: { did: "did:plc:new" } })).data).toEqual({ removed: true });
  // The grant goes with the member: it is a delegation in the core, and is revoked there.
  expect([...["member/did:plc:new", "address/loop/+500"].map((k) => rig.sim.rows.has(k)), [...rig.held.values()].filter((d) => d.holder.did === "did:plc:new").length]).toEqual([false, false, 0]);
  expect(rig.known.has("+500")).toBe(false);
  expect((await rig.call("people.remove", { session: rig.owner, body: { did: "did:plc:owner" } })).status).toBe(400);
  for (const kind of ["token.create", "grant.put"])
    expect((await rig.call(kind, { session: rig.owner, body: { name: "x", did: "did:plc:other", methods: ["people.put"] } })).status).toBe(400);
  return "added, linked, granted, removed";
}
// %%
test_a_member_has_their_did_as_a_bluesky_address = {
  const told = [];
  const entry = (id, from, address) => ({ id, source: "x", from, key: "k" + id, received_at: 1, body: { text: "hi", address }, done_at: null });
  const entries = [entry(1, "worker:brain-x-bluesky", "did:plc:owner"), entry(2, "worker:brain-x-bluesky", "did:plc:new"), entry(3, "worker:brain-x-bluesky", "did:plc:stranger"), entry(4, "worker:brain-x-evil", "did:plc:owner"), entry(5, "worker:brain-x-evil", "did:plc:new"), entry(6, "worker:brain-x-whatsapp", "did:plc:owner")];
  const rig = await kernelRig({
    core: async (request) => {
      const nsid = new URL(request.url).pathname.replace("/xrpc/com.lopecode.brain.", "");
      if (nsid === "inbox.poll") return Response.json({ held: true, entries: JSON.parse(JSON.stringify(entries)), waiting: entries.length });
      if (nsid === "bluesky.know") return told.push([request.headers.get("x-brain-caller"), await request.json()]), Response.json({ known: 1 }, { headers: { "x-brain-served-by": "brain-x-bluesky@abc, brain-core@def" } });
      return Response.json({ ok: true });
    }
  });
  const who = async () => (await rig.call("inbox.poll", { session: rig.owner, body: { tab: "a" } })).data.entries.map((e) => e.who && e.who.role);
  // The owner needs no row. Nobody else is anybody yet, and the owner's DID on another channel is nobody's.
  expect(await who()).toEqual(["owner", null, null, null, null, null]);
  await rig.call("people.put", { session: rig.owner, body: { did: "did:plc:new" } });
  expect(rig.sim.rows.get("address/bluesky/did:plc:new")).toMatchObject({ channel: "bluesky", address: "did:plc:new", did: "did:plc:new" });
  expect(told).toEqual([["kernel", { all: ["did:plc:new"] }]]);
  expect(await who()).toEqual(["owner", "member", null, null, null, null]);
  // The rows are written by the owner's own session alone.
  for (const [caller, options] of [["nobody", {}], ["another account", { session: rig.other }], ["a turn", { bearer: await turnToken.make("cookie-key", "did:plc:owner", 1) }]]) {
    expect([caller, (await rig.call("people.put", { ...options, body: { did: "did:plc:x" } })).status >= 400]).toEqual([caller, true]);
    expect([caller, (await rig.call("people.link", { ...options, body: { channel: "bluesky", address: "did:plc:x", did: "did:plc:owner" } })).status >= 400]).toEqual([caller, true]);
  }
  expect([...rig.sim.rows.keys()].filter((k) => k.startsWith("address/"))).toEqual(["address/bluesky/did:plc:new"]);
  await rig.call("people.remove", { session: rig.owner, body: { did: "did:plc:new" } });
  expect(rig.sim.rows.has("address/bluesky/did:plc:new")).toBe(false);
  expect(told.slice(1)).toEqual([["kernel", { all: [] }], ["kernel", { address: "did:plc:new", forget: true }]]);
  expect(await who()).toEqual(["owner", null, null, null, null, null]);
  return "owner without a row, a member from people.put, nobody from another Worker";
}
// %%
// A core with one channel, brain-x-loop, whose entries were written in rooms. `rooms` is what the channel
// answers to loop.room now; `entries` carry what it said when each message arrived.
roomRig = async (rooms, entries) => {
  const seen = [];
  const rig = await kernelRig({
    core: async (request) => {
      const nsid = new URL(request.url).pathname.replace("/xrpc/com.lopecode.brain.", ""), caller = request.headers.get("x-brain-caller");
      const body = request.method === "POST" ? await request.json().catch(() => null) : null;
      seen.push({ nsid, caller, via: request.headers.get("x-brain-via") });
      const by = { "x-brain-served-by": "brain-x-loop@abc, brain-core@def" };
      if (nsid === "inbox.poll") return Response.json({ held: true, entries: JSON.parse(JSON.stringify(entries)), waiting: entries.length });
      if (nsid === "loop.room") return caller === "kernel" && rooms[body.id] ? Response.json({ id: body.id, known: true, complete: true, served: true, ...rooms[body.id] }, { headers: by }) : Response.json({ error: "NotFound" }, { status: 404, headers: by });
      // Another channel's Worker answers for a room of loop's: not heard.
      if (nsid === "evil.room") return Response.json({ id: body.id, known: true, members: ["+100"], complete: true, served: true }, { headers: by });
      return Response.json({ ok: true });
    }
  });
  for (const [address, did] of [["+100", "did:plc:owner"], ["+200", "did:plc:ada"], ["+300", "did:plc:bo"], ["+400", "did:plc:guest"]]) rig.sim.rows.set("address/loop/" + address, { channel: "loop", address, did, linked: 1 });
  for (const did of ["did:plc:ada", "did:plc:bo"]) rig.sim.rows.set("member/" + did, { did, added: 1 });
  const grant = (did, methods) => rig.call("grant.put", { session: rig.owner, body: { did, methods } });
  const poll = async () => (await rig.call("inbox.poll", { session: rig.owner, body: { tab: "a" } })).data.entries;
  // The statuses a turn's token gets for each method.
  const reach = async (turn, methods) => Object.fromEntries(await Promise.all(methods.map(async (m) => [m, (await rig.call(m, { bearer: turn, body: { id: 1, text: "x" } })).status])));
  return { ...rig, seen, grant, poll, reach };
}
// %%
roomEntry = (id, address, room, from = "worker:brain-x-loop") => ({ id, source: "loop", from, key: "k" + id, received_at: 1, body: { text: "hi", address, ...(room === undefined ? {} : { room }) }, done_at: null })
// %%
test_a_room_turn_reaches_what_everyone_in_the_room_may_call = {
  const X = "library.list", M = ["inbox.reply", X, "people.list", "secret.list", "blob.list", "static.list", "member.whoami", "m.0123456789.list"];
  const rooms = { all: { members: ["+100", "+200", "+300"] }, owners: { members: ["+100"] }, guest: { members: ["+100", "+200", "+400"] }, stranger: { members: ["+100", "+200", "+999"] }, two: { members: ["+200", "+300"] } };
  const rig = await roomRig(rooms, [roomEntry(1, "+100", { id: "all" }), roomEntry(2, "+200", { id: "all" }), roomEntry(3, "+100", { id: "owners" }), roomEntry(4, "+100", { id: "guest" }), roomEntry(5, "+200", { id: "stranger" }), roomEntry(6, "+200", { id: "two" }), roomEntry(7, "+200")]);
  await rig.grant("did:plc:ada", [X]);
  let e = await rig.poll();
  expect(e.map((x) => x.room && x.room.people.map((p) => p.role))).toEqual([["owner", "member", "member"], ["owner", "member", "member"], ["owner"], ["owner", "member", null], ["owner", "member", null], ["member", "member"], undefined]);
  // The owner, a member with a grant for X and a member without: X is refused to the owner's turn and to the member's.
  const none = { "inbox.reply": 200, [X]: 403, "people.list": 403, "secret.list": 403, "blob.list": 403, "static.list": 403, "member.whoami": 403, "m.0123456789.list": 403 };
  expect(await rig.reach(e[0].turn, M)).toEqual(none);
  expect(await rig.reach(e[1].turn, M)).toEqual(none);
  expect((await rig.call(X, { bearer: e[0].turn, body: {} })).data.message).toBe("a turn in a room reaches inbox.reply and what everyone in the room has a grant for; did:plc:bo has none for com.lopecode.brain.library.list");
  // The same member writing alone has their grant and what every member has.
  expect(await rig.reach(e[6].turn, M)).toEqual({ ...none, [X]: 200, "blob.list": 200, "static.list": 200, "member.whoami": 200, "m.0123456789.list": 200 });
  // Both members granted X: the tokens already issued now pass it, made as their sender, and still nothing else.
  await rig.grant("did:plc:bo", [X]);
  rig.seen.length = 0;
  expect(await rig.reach(e[0].turn, M)).toEqual({ ...none, [X]: 200 });
  expect(await rig.reach(e[1].turn, M)).toEqual({ ...none, [X]: 200 });
  expect(await rig.reach(e[5].turn, M)).toEqual({ ...none, [X]: 200 });
  expect(rig.seen.filter((s) => s.nsid === X).map((s) => [s.caller, s.via])).toEqual([["owner", "turn:1"], ["did:plc:ada", "turn:2"], ["did:plc:ada", "turn:6"]]);
  // A room of the owner alone: the owner's turn as it is in a direct conversation.
  expect(await rig.reach(e[2].turn, M)).toEqual({ "inbox.reply": 200, [X]: 200, "people.list": 200, "secret.list": 200, "blob.list": 200, "static.list": 200, "member.whoami": 200, "m.0123456789.list": 200 });
  expect((await rig.call("people.put", { bearer: e[2].turn, body: { did: "did:plc:x" } })).status).toBe(401);
  // One participant who linked and was never added, or whom nobody knows: the reply and nothing else, with every grant in place.
  expect(await rig.reach(e[3].turn, M)).toEqual(none);
  expect(await rig.reach(e[4].turn, M)).toEqual(none);
  // No page or file is served to a room's turn.
  expect((await rig.call("/static/u/a.png", { bearer: e[1].turn })).status).toBe(403);
  expect((await rig.call("/static/u/a.png", { bearer: e[6].turn })).status).toBe(200);
  // A grant withdrawn, then a member removed, while the tokens are live.
  await rig.call("grant.delete", { session: rig.owner, body: { did: "did:plc:bo" } });
  expect((await rig.reach(e[0].turn, [X]))[X]).toBe(403);
  await rig.grant("did:plc:bo", [X]);
  await rig.call("people.remove", { session: rig.owner, body: { did: "did:plc:bo" } });
  expect((await rig.reach(e[0].turn, [X, "inbox.reply"]))).toEqual({ [X]: 403, "inbox.reply": 200 });
  return "7 turns: 4 rooms capped, the owner alone and a member alone are not";
}
// %%
test_a_room_is_read_again_when_the_turn_is_handed_out = {
  const X = "library.list";
  const rooms = { r: { members: ["+100", "+200"] } };
  // The entry says who was there when the message arrived. That is not what the token is made from.
  const rig = await roomRig(rooms, [roomEntry(1, "+100", { id: "r", members: ["+100", "+200"] })]);
  await rig.grant("did:plc:ada", [X]);
  const before = (await rig.poll())[0];
  expect((await rig.reach(before.turn, [X]))[X]).toBe(200);
  // Somebody who is not a member joins. The next poll's token is for the room as it is now.
  rooms.r.members.push("+999");
  const after = (await rig.poll())[0];
  expect(after.room.people.map((p) => [p.address, p.role])).toEqual([["+100", "owner"], ["+200", "member"], ["+999", null]]);
  expect(await rig.reach(after.turn, [X, "inbox.reply"])).toEqual({ [X]: 403, "inbox.reply": 200 });
  // The channel says the room is longer than it lists, or lists it without the sender: counted as one more nobody.
  for (const now of [{ members: ["+100", "+200"], complete: false }, { members: ["+200"] }, { members: Array.from({ length: 51 }, (_, i) => (i ? "+200" : "+100")) }]) {
    rooms.r = now;
    expect((await rig.reach((await rig.poll())[0].turn, [X]))[X]).toBe(403);
  }
  // The channel no longer serves the room: no turn.
  rooms.r = { members: ["+100", "+200"], served: false };
  expect((await rig.poll())[0]).toMatchObject({ who: { role: "owner" }, room: { served: false } });
  expect((await rig.poll())[0].turn).toBeUndefined();
  // The channel does not answer: the entry's own list, and one more nobody.
  delete rooms.r;
  const blind = (await rig.poll())[0];
  expect(blind.room.people.map((p) => p.role)).toEqual(["owner", "member", null]);
  expect(await rig.reach(blind.turn, [X, "inbox.reply"])).toEqual({ [X]: 403, "inbox.reply": 200 });
  return "the token follows the room, and what is not known counts against it";
}
// %%
test_a_channel_can_narrow_a_turn_and_not_widen_one = {
  const X = "library.list", owners = { id: "r", members: ["+100"] };
  const rooms = { r: { members: ["+100"] } };
  const rig = await roomRig(rooms, [
    // Another channel's Worker, with the owner's address and a room of the owner alone.
    roomEntry(1, "+100", owners, "worker:brain-x-evil"),
    // loop itself, saying a member wrote in a room of the owner alone.
    roomEntry(2, "+200", owners),
    // A room that is not an object, and one with no id.
    roomEntry(3, "+100", "r"),
    roomEntry(4, "+100", { members: ["+100"] }),
    // A member with no grant, in a room with the owner.
    roomEntry(5, "+300", { id: "ob" })
  ]);
  rooms.ob = { members: ["+100", "+300"] };
  const e = await rig.poll();
  // evil's entry is nobody's: the address is looked up under evil, and evil.room is not what loop's room is.
  expect([e[0].who, e[0].turn]).toEqual([null, undefined]);
  // The member's turn is the member's, less what the room takes away: never the owner's.
  await rig.grant("did:plc:ada", [X]);
  expect(await rig.reach(e[1].turn, [X, "people.list", "inbox.reply"])).toEqual({ [X]: 403, "people.list": 403, "inbox.reply": 200 });
  expect(await turnToken.read("cookie-key", e[1].turn)).toEqual({ did: "did:plc:ada", entry: 2, room: ["did:plc:owner", null] });
  // A malformed room is still a room.
  for (const i of [2, 3]) expect([i, await rig.reach(e[i].turn, [X, "people.list", "inbox.reply"])]).toEqual([i, { [X]: 403, "people.list": 403, "inbox.reply": 200 }]);
  expect(await rig.reach(e[4].turn, [X, "people.list", "blob.list", "inbox.reply"])).toEqual({ [X]: 403, "people.list": 403, "blob.list": 403, "inbox.reply": 200 });
  // A token whose room was edited is not this Brain's.
  const [v, payload, sig] = e[4].turn.split(".");
  const forged = `${v}.${btoa(JSON.stringify({ ...JSON.parse(atob(payload.replace(/-/g, "+").replace(/_/g, "/"))), did: "did:plc:owner", room: [] })).replace(/=+$/, "")}.${sig}`;
  expect((await rig.call("people.list", { bearer: forged })).status).toBe(401);
  return "5 entries: 1 nobody's, 4 turns no wider than their sender";
}
