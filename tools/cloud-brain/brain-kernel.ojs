    if (d && d.until && d.until <= Date.now()) return { refused: { error: "AuthRequired", message: "this token has expired" } };
    return d ? { caller: d.from, via: "token", name: d.name, methods: d.scope, deploy: d.caps.includes("deploy"), unattended: d.caps.includes("unattended"), delegate: d.caps.includes("delegate"), delegation: d.id } : { refused: { error: "AuthRequired", message: "unknown token" } };
  };
  // Calls the kernel makes to the core's delegation methods: as itself to ask whose secret a hash is, and as the
  // owner's session for a route below that its own session guard has passed, or for a link the owner's session made.
  const DELEGATE = ["create", "list", "revoke"].map((m) => "com.lopecode.brain.delegation." + m);
  const coreCall = async (headers, method, body) => {
    const r = await core.fetch(new Request("https://core.internal/xrpc/com.lopecode.brain." + method, { method: body === undefined ? "GET" : "POST", headers: { "content-type": "application/json", ...headers }, body: body === undefined ? undefined : JSON.stringify(body) })).catch(() => null);
    return { status: r ? r.status : 502, data: r ? await r.json().catch(() => null) : null };
  };
  // The row, null when no delegation has that hash, undefined when the core gave no answer.
  const resolve = async (hash) => {
    const r = await coreCall({ "x-brain-caller": "kernel" }, "delegation.resolve", { sha256: hash });
    return r.status === 200 && r.data ? r.data.delegation || null : undefined;
  };
  const move = async (key, t) => {
    const caps = t.unattended ? ["deploy", "unattended", "session"] : t.deploy ? ["deploy"] : [];
    const r = await coreCall({ "x-brain-caller": "kernel" }, "delegation.adopt", { sha256: key.slice("token/".length), name: t.name, scope: t.methods, caps, until: t.until || null, created: t.created, note: t.by === "link" ? "sign-in link" : "" });
    if (r.status !== 200 || !r.data) return undefined;
    await rows.delete(key);
    return r.data;
  };
  // Every row that is left, before the tokens are listed, revoked or a name is checked. One that has ended goes.
  const moveAll = async () => {
    for (const r of await rows.list("token/")) r.value.until < Date.now() ? await rows.delete(r.key) : await move(r.key, r.value);
  };
  // What the owner granted a DID: a delegation that DID holds, in the core. A grant from before 2026-10-10 is a
  // row here until it is first read, and is then made in the core as the owner's session made it.
  const moveGrant = async (g) => {
    const r = await asOwnerSession("delegation.create", { name: "grant", holder: { did: g.did }, scope: g.methods });
    if (r.status !== 200) return;
    await rows.delete("grant/" + g.did);
    // The core kept what a kernel from before told it each member was granted. Told again, it keeps none.
    await syncPeople();
  };
  const grantOf = async (did) => {
    const old = await rows.get("grant/" + did);
    if (old) await moveGrant(old);
    const d = ((await coreCall({ "x-brain-caller": "kernel" }, "delegation.resolve", { did })).data || {}).delegation;
    return d ? { did, methods: d.scope, granted: d.created } : null;
  };
  const grants = async () => {
    for (const { value: g } of await rows.list("grant/")) await moveGrant(g);
    return (await delegations()).filter((d) => d.holder && d.holder.did);
  };
  const asOwnerSession = (method, body) => coreCall({ "x-brain-caller": "owner", "x-brain-via": "session" }, method, body);
  const delegations = async () => ((await asOwnerSession("delegation.list")).data || {}).delegations || [];
  app.use("*", async (c, next) => {
    const path = new URL(c.req.url).pathname;
    const nsid = path.startsWith("/xrpc/") ? path.slice("/xrpc/".length) : null;
    // A method outside com.lopecode.brain is another service's lexicon, which this Brain answers to anyone
    // (app.bsky.feed.getFeedSkeleton). Whatever token comes with it is not read, so the caller is anonymous.
    const who = nsid && !nsid.startsWith("com.lopecode.brain.") ? { caller: "anonymous", via: "" } : await identify(c.req.raw, nsid);
    if (who.refused) return fail(c, who.refused.status || 401, who.refused.error, who.refused.message);
    // A token or another DID reaches only the methods it was given, and no path that is not a method.
    // A token of a sign-in link the owner made with deploy reaches infra.* too.
    // One with the cap delegate reaches the three delegation methods; the core says what it may make there.
    if (who.via === "token" && !(nsid && (ASKS.includes(nsid) || names(who.methods, nsid) || (who.deploy && deploys(who).includes(nsid)) || (who.delegate && DELEGATE.includes(nsid))))) return fail(c, 403, "Forbidden", "this token does not name " + (nsid || path) + ". To ask the owner for it: GET https://" + config.host + "/auth/ask");
    // A portal shows one member's services to whoever opened it. Its token reaches the methods of that member's
    // Workers and the list of their modules, as the viewer; when the viewer is that member, their own services too.
    if (who.portal) {
      const mine = MEMBER_NS + who.portal.id + ".";
      const reach = nsid && (nsid.startsWith(mine) || nsid === "com.lopecode.brain.portal.modules" || (who.portal.did === who.portal.author && PORTAL_OWN.includes(nsid)));
      if (!reach) return fail(c, 403, "Forbidden", `a portal token reaches ${mine}* and nothing else`);
      if (!(await rows.get("member/" + who.portal.author))) return fail(c, 403, "Forbidden", `${who.portal.author} is not a member`);
    }
    // A turn whose answer others read: inbox.reply, and what the sender and every one of them has. The owner has
    // every method, a member their grant, anyone else nothing. Read now, not when the token was made.
    const others = who.turn && who.room ? who.room.filter((d) => d !== who.did) : [];
    // A turn copies a secret only when the owner alone reads the answer.
    if (who.turn && who.room && nsid === "com.lopecode.brain.secret.copy") return fail(c, 403, "Forbidden", "a turn in a room does not copy a secret");
    if (others.length && nsid !== "com.lopecode.brain.inbox.reply")
      for (const did of [who.did, ...others]) {
        if (did && did === config.owner) continue;
        const grant = did && (await rows.get("member/" + did)) ? await grantOf(did) : null;
        if (!(grant && matches(grant.methods, nsid))) return fail(c, 403, "Forbidden", `a turn in a room reaches inbox.reply and what everyone in the room has a grant for; ${did === who.did ? "its sender" : did || "someone who is not a member"} has none for ${nsid || path}`);
      }
    if (who.caller.startsWith("did:")) {
      const member = await rows.get("member/" + who.caller);
      // A turn is run for a member. Once they are removed, a token already issued stops working.
      if ((who.turn || who.portal) && !member) return fail(c, 403, "Forbidden", `${who.caller} is not a member`);
      const grant = nsid ? await grantOf(who.caller) : null;
      if (nsid && !may({ member, grant: grant && grant.methods }, nsid)) return fail(c, 403, "Forbidden", `${who.caller} has no grant for ${nsid}`);
      // A member is still themselves when they open a file; every other page is served to them as to anyone.
      if (!nsid && !(member && path.startsWith("/static/"))) who.caller = "anonymous";
    }
    c.set("who", who);
    c.set("nsid", nsid);
    await next();
