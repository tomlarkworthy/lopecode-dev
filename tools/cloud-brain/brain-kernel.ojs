  if (!owner) return show(...head, ...body, ...signIn());
  const hours = el("input", "", { type: "number", min: "1", max: String(r.hours), value: String(r.hours), style: "font:inherit;width:4em;padding:4px" });
  const boxes = {};
  const capRows = r.caps.map((cap) => { const box = el("input", "", { type: "checkbox" }); box.checked = true; boxes[cap] = box; const p = el("p", "", { style: "color:#b3261e" }); p.append(box, " " + CAP[cap]); return p; });
  const tie = () => { if (boxes.unattended && boxes.unattended.checked) { if (boxes.deploy) boxes.deploy.checked = true; if (boxes.session) boxes.session.checked = true; } };
  for (const cap in boxes) boxes[cap].onchange = () => { if (cap !== "unattended" && !boxes[cap].checked && boxes.unattended) boxes.unattended.checked = false; tie(); };
  const go = el("button", "Approve", { style: "font:inherit;font-weight:700;padding:8px 16px" });
  const no = el("button", "Deny", { style: "font:inherit;padding:8px 16px" });
