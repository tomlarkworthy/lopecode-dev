  go.onclick = () => answer({ hours: Number(hours.value), caps: Object.keys(boxes).filter((k) => boxes[k].checked) });
  no.onclick = () => answer({ deny: true });
  const hoursRow = el("p"); hoursRow.append("The token lasts ", hours, " hours (at most " + r.hours + ")");
  const btns = el("p"); btns.append(go, " ", no);
  show(...head, ...body, capRows.length ? label("Asks also to") : null, ...capRows, hoursRow, btns, said);
};
