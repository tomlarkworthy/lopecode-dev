  return [el("p", "Sign in as the owner of this Brain to answer. You are sent to your own provider; this page never sees your password."), form];
};
const wide = (m) => m === "*" || m === "com.lopecode.brain.*" || /[.\\/]\\*$/.test(m);
const short = (m) => m.replace(/^com\\.lopecode\\.brain\\./, "");
const chips = (list, isNew) => { const ul = el("ul", "", { style: "list-style:none;padding:0;margin:4px 0 12px;display:flex;flex-wrap:wrap;gap:6px" }); for (const m of list) { const fresh = isNew && isNew(m); ul.append(el("li", short(m) + (fresh ? "  new" : ""), { style: "font:13px ui-monospace,Menlo,monospace;border:1px solid " + (wide(m) ? "#b3261e" : "#bbb") + ";border-radius:6px;padding:2px 8px" + (fresh ? ";font-weight:700" : "") })); } return ul; };
const label = (t) => el("div", t, { style: "font-size:12px;text-transform:uppercase;letter-spacing:.05em;opacity:.7;margin-top:12px" });
const when = (ms) => new Date(ms).toLocaleString();
const CAP = {
  session: "Your own tab: it acts as you signed in here, on the methods it names. Methods that only * reaches stay closed.",
  deploy: "Deploy: it can deploy and remove this Brain's Workers, each change held for your approval.",
  unattended: "Unattended: nothing it deploys waits for you, the kernel included. It is you, in effect, until it ends."
};
const closeSoon = (said) => setTimeout(() => { window.close(); setTimeout(() => { said.textContent = said.textContent.replace("Closing this tab…", "You can close this tab."); }, 300); }, 1200);
const run = async () => {
  if (!ID) {
    if (!token) return show(el("h3", "Requests for access"), ...signIn());
