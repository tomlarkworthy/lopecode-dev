    if (all.status !== 200) return show(el("h3", "Requests for access"), ...signIn());
    if (!all.data.requests.length) return show(el("h3", "Requests for access"), el("p", "None are waiting."));
    const list = el("div");
    for (const r of all.data.requests) list.append(el("a", (r.kind === "upgrade" ? "More for " : "New token ") + r.name + " · " + r.code + " · " + r.methods.length + " methods" + (r.caps.length ? " · " + r.caps.join(", ") : ""), { href: "/auth/request?id=" + r.id, style: "display:block;padding:6px 0" }));
    return show(el("h3", "Requests for access"), list);
  }
  let got = await ask("token.requested?id=" + ID);
  if (got.status === 401) { token = null; got = await ask("token.requested?id=" + ID); }
  if (got.status !== 200) return show(el("h3", "Request for access"), el("p", "This request has ended or does not exist."));
  const r = got.data;
  const owner = token ? (await fetch("/auth/session", { headers: { authorization: "Bearer " + token } }).then((x) => x.json()).catch(() => ({}))).owner === true : false;
  const has = r.token ? new Set(r.token.methods) : null;
  const head = [
    el("h3", r.kind === "upgrade" ? "Token " + r.name + " asks for more" : "A program asks for a new token"),
    el("p", r.kind === "upgrade" ? "Only the holder of " + r.name + (r.token ? ", made " + when(r.token.created) : "") + ", could ask this. Approving gives it a new token with what it has and what it asks for; the old one is revoked when the new one is picked up." : "Anyone can ask for a new token. Approve only if you started this, or know who did."),
    el("div", r.code, { style: "font:600 32px ui-monospace,Menlo,monospace;letter-spacing:.08em;margin:8px 0 0" }),
    el("p", "It must match the code shown by the program that asked. If a guest asked, they sent it to you.", { style: "margin-top:4px" })
