  const requestScript = `
const app = document.getElementById("app");
const X = "/xrpc/com.lopecode.brain.";
const el = (tag, text, attrs) => { const e = document.createElement(tag); if (text != null) e.textContent = String(text); for (const k in attrs || {}) e.setAttribute(k, attrs[k]); return e; };
const show = (...nodes) => app.replaceChildren(...nodes.filter(Boolean));
let token = null; try { token = localStorage.getItem("brain_session"); } catch (e) {}
const ask = async (name, body) => {
