    label(r.kind === "upgrade" ? "Methods asked for" : "Methods"), r.methods.length ? chips(r.methods, has ? (m) => !has.has(m) : null) : el("p", "none"),
    has ? label("It holds now") : null, has ? chips(r.token.methods) : null,
