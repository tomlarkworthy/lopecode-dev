    const who = c.get("who");
    if (who.via !== "session") return c.json({ signedIn: false, ownerSet: !!config.owner });
    return c.json({ signedIn: true, did: who.did, handle: await rows.get("handle/" + who.did), owner: who.caller === "owner" });
  });

  // Tokens for callers with no session, and grants for other DIDs. Each names the methods it may call.
  const full = (m) => (m.startsWith("com.") ? m : "com.lopecode.brain." + m);
  // What the token of a sign-in link made with deploy reaches of infra. Not infra.shell: it puts HTML at / with no
  // reason, no was and no approval, and that page runs where the owner's session is kept.
  const DEPLOYS = ["apply", "getState", "redistil", "confirm"].map((m) => "com.lopecode.brain.infra." + m);
  // A link made to deploy with no approval can deploy a kernel with nobody asked, so keeping the page at / from it
  // would keep nothing: it reaches infra.shell too, and finishes a deploy of the page.
  const deploys = (who) => (who.unattended ? [...DEPLOYS, "com.lopecode.brain.infra.shell"] : DEPLOYS);
  const never = neverHeld;
  // A token's list holds whole names and prefixes: "browser.*" is every method of that service, "*" every method
  // of this Brain. No prefix reaches a name a token may not have.
  // A name may go on in segments after a / (ai.v1/chat/completions); "ai.v1/*" is every method under ai.v1/.
  const listed = (m) => /^[A-Za-z0-9]+(\.[A-Za-z0-9]+)*(\/[A-Za-z0-9]+)*([./]\*)?$/.test(m);
  const names = (methods, nsid) => !never(nsid) && matches(methods, nsid);
  // A token is a delegation with a secret holder, in the core.
  const LINK = "sign-in link";
  const shown = (d) => ({ name: d.name, methods: d.scope, created: d.created, id: d.id, ...(d.until ? { until: d.until } : {}), ...(d.note === LINK ? { by: "link" } : {}), ...(d.caps.includes("delegate") ? { delegate: true } : {}), ...(d.caps.includes("deploy") ? { deploy: true } : {}), ...(d.caps.includes("unattended") ? { unattended: true } : {}), ...(d.daily === null ? {} : { daily: d.daily }) });
  // The owner's own: a member's token, and one made under another, are read with delegation.list.
  const tokens = async () => (await moveAll(), (await delegations()).filter((d) => d.holder && d.holder.secret && d.from === "owner" && !d.parent));
  app.get(NS + "token.list", session, async (c) => c.json({ tokens: (await tokens()).map(shown).filter((t) => !(t.until < Date.now())) }));
  app.post(NS + "token.create", session, async (c) => {
    const { name, methods = [], daily = null } = await c.req.json();
    const named = methods.map(full);
    if (!/^[a-z0-9-]{1,40}$/.test(name || "")) return fail(c, 400, "InvalidRequest", "name is lower case letters, digits and -");
    if (!named.every(listed)) return fail(c, 400, "InvalidRequest", "a method is a name, or a prefix that ends .* or /* (browser.*, ai.v1/*), or *");
    if (named.some(never)) return fail(c, 400, "InvalidRequest", "a token cannot name infra, secret, token, grant, people or delegation methods");
    const made = await asOwnerSession("delegation.create", { name, holder: { secret: true }, scope: named, daily });
    if (made.status !== 200) return c.json(made.data || { error: "UpstreamFailure", message: "the core did not answer" }, made.status);
    return c.json({ name, token: made.data.secret });
  });
  // A sign-in link, for a program with no browser (Claude Code on the web). The owner makes one and pastes it;
  // whoever POSTs it first is given a token for the methods it names, and the link is gone. A GET explains and
  // spends nothing, so a preview of a pasted link does not use it. The token ends by itself.
  const hex = () => [...crypto.getRandomValues(new Uint8Array(32))].map((b) => b.toString(16).padStart(2, "0")).join("");
  app.post(NS + "token.link", session, async (c) => {
    const { name, methods = [], minutes = 480, hours = 8, deploy = false, unattended = false, daily = null } = await c.req.json();
    if (typeof deploy !== "boolean" || typeof unattended !== "boolean") return fail(c, 400, "InvalidRequest", "deploy and unattended are true or false");
    if (unattended && !deploy) return fail(c, 400, "InvalidRequest", "unattended is for a link made with deploy");
    const named = methods.map(full);
    if (!/^[a-z0-9-]{1,40}$/.test(name || "")) return fail(c, 400, "InvalidRequest", "name is lower case letters, digits and -");
    if (!named.every(listed)) return fail(c, 400, "InvalidRequest", "a method is a name, or a prefix that ends .* or /* (browser.*, ai.v1/*), or *");
