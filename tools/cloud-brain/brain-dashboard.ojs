test_dashboard_declares_two_cloudflare_permissions_its_rows_and_its_tail = {
  const { meta, parts, source } = await dashboard_service.emit();
  expect(meta.worker).toBe("brain-x-dashboard");
  // The reference the Worker serves holds the prose cells with their holes filled: a row a definition, and both rules.
  expect(source.reference.startsWith("# brain-dashboard")).toBe(true);
  for (const d of metricDefinitions) expect(source.reference).toContain("| `" + d.name + "` | `" + d.worker + "` |");
  expect(source.reference).toContain("| `metric.query` | `" + metricRules.query + "` |");
  expect(source.reference).toContain("| `metric.list` | `" + metricRules.list + "` |");
  expect(source.reference).toContain("| `metric.put` | `" + metricRules.put + "` |");
  expect(source.reference).toContain("| `metric.delete` | `" + metricRules.delete + "` |");
  expect(source.reference).toContain("A member keeps " + metricLimits.kept + " metrics.");
  // The dashboards: the four rules, a row a panel of each built-in one, the draws and the limits.
  for (const name of ["list", "get", "put", "delete"]) expect(source.reference).toContain("| `dashboard." + name + "` | `" + dashboardRules[name] + "` |");
  for (const d of dashboardDefinitions) for (const p of d.panels) expect(source.reference).toContain("| `" + d.name + "` | " + d.title + " | " + p.title + " | `" + p.metric + "` | " + p.by.map((k) => "`" + k + "`").join(", ") + " | `" + p.draw + "` |");
  expect(source.reference).toContain("// one of calls, faults, methods, bars, table, points, share\n");
  expect(source.reference).toContain("// 1 to " + dashboardLimits.panels + "\n");
  expect(source.reference).toContain("A caller keeps " + dashboardLimits.kept + " dashboards");
  // Who the service answers: a member's Worker is the member (review 1615), and the reference says so.
  expect(source.reference).toContain("So a member's Worker is answered as the member is: it writes, lists, reads and deletes its author's metrics and dashboards");
  expect(source.reference).not.toContain("a member's Worker included");
  // What a query costs: the memory's time and bound are the module's values, and the shape of cost is named.
  expect(source.reference).toContain("for " + metricMemoryDefaults.ms / 1000 + " s from when Cloudflare answered");
  expect(source.reference).toContain("is over " + metricMemoryDefaults.characters + " characters");
  expect(source.reference).toContain("stands in for the " + metricMemoryDefaults.ms + " ms");
  expect(source.reference).toContain('`cost` is `{ "ms": 0, "queries": 0, "cached": true }`');
  expect(source.reference).toContain("| `{ metric, since, until, step, groups, sampled, series, cost }`");
  expect(source.reference).not.toContain("the memory of an answer and the page");
  // What was counted on cb4 (dsv-4-cost-on-cb4) is said, and the sentences that waited for it are gone.
  // metric-query-sampled-unsaid: the answer says a sample, and the parts' length and count are the module's values.
  expect(source.reference).toContain("An answer says whether Cloudflare made it from a sample of the lines: `sampled`.");
  expect(source.reference).toContain("the span is longer than " + metricPieceDefaults.ms / 3600000 + " hours");
  expect(source.reference).toContain("a span of more than " + metricPieceDefaults.most + " parts");
  expect(source.reference).toContain("or up to " + (1 + metricPieceDefaults.most) + " for a span Cloudflare sampled");
  for (const gone of ["nothing in it says so", "The service does not read whether Cloudflare sampled", "that has to be whole is asked a day at a time"]) expect(source.reference).not.toContain(gone);
  expect(source.reference).toContain("| 24 hours | 854 to 1095 |");
  for (const waited of ["not counted yet", "Whether Cloudflare samples", "and none is kept", "an ask does not wait for another's (read in"]) expect(source.reference).not.toContain(waited);
  expect(source.reference).not.toMatch(/\$\{/);
  // The metrics store: what the index holds and why, what is measured and what is not, and the setting.
  expect(source.reference).toContain("## The metrics store\n\nWritten 2026-10-13");
  expect(source.reference).toContain('{ index: "core.calls/brain-x-inbox/inbox.poll/200",');
  // ds-ingestion-tail-to-analytics-engine, review 6248: the sentence is the measurement's, of the 5 Workers its script kept.
  expect(source.reference).toContain("the count by Worker was exact and the sum of the value was within 4.2%, for the 5 of 20 Workers the script kept");
  for (const gone of ["the count of every breakdown was exact", "within 3%"]) expect(source.reference).not.toContain(gone);
  expect(source.reference).toContain("Since 2026-10-13 08:41 CEST cb4 runs it");
  expect(source.reference).toContain("A point was readable 35 to 70 s after its line.");
  expect(source.reference).toContain("read as `config.engine ?? []`");
  expect(source.reference).toContain("Cloudflare takes " + tailLimits.points + " points from one invocation.");
  expect(source.reference).toContain("cut to " + tailLimits.index + " bytes");
  // The SQL the reference shows is the one the service writes for that ask.
  const calls = metricDefinitions.find((d) => d.name === "core.calls");
  expect(source.reference).toContain(engineSql(calls, metricAsk(calls, new URLSearchParams("by=worker,status&method=inbox.poll&since=1791676800000&until=1791680400000"), 0), analyticsDataset("cb4")).sql);
  expect(meta.cloudflare).toEqual(["Account Analytics Read", "Workers Observability Read"]);
  // Rows for a member's definitions, beside the Cloudflare token: the first service with both. The dataset and the tail since 2026-10-13.
  expect([meta.resources, meta.secrets, meta.calls, meta.tail]).toEqual([["analytics", "rows"], [], [], true]);
  expect(meta.bindings.map((b) => b.type + ":" + b.name)).toEqual(["d1:SQL", "analytics_engine:METRICS"]);
  // The token is read from the binding the deployer made, and the script filter is brain-logs' own cell, carried into this Worker.
  expect(parts[0].text).toContain("__rt.platform.secrets.CF_TOKEN");
  expect(parts[0].text).toContain("$workers.scriptName");
  expect(parts[0].text).toMatch(/const logsScope = /);
  expect(parts[0].text).toMatch(/const logsScript = /);
  // Every definition is over a Worker of the Brain, with at most 8 dimensions, none of them who called.
  for (const d of metricDefinitions) {
    expect([d.name, logsScript("cb4", d.worker) !== null, d.dims.length <= 8, /^[a-z]+\.[a-z-]+$/.test(d.name)]).toEqual([d.name, true, true, true]);
    expect(d.dims.map((x) => x.key).filter((k) => ["caller", "holder", "delegation", "by", "origin", "via", "ray", "reason"].includes(k))).toEqual([]);
  }
  return meta.cloudflare[0];
}
