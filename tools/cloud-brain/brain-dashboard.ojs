test_a_dashboard_is_read_with_one_metric_query_for_each_distinct_metric_by_and_filter = {
  const range = { since: Date.UTC(2026, 9, 11, 7, 0), until: Date.UTC(2026, 9, 11, 8, 0) };
  const panel = (draw, more = {}) => ({ title: draw, metric: "deploys.confirmed", by: ["target"], filter: {}, draw, ...more });
  // Three panels over one metric, by and filter are one query, as the two of `health` are.
  expect(dashboardQueries([panel("bars"), panel("table"), panel("bars", { title: "again" })]).map((q) => q.key)).toEqual(['["deploys.confirmed",["target"],[]]']);
  // Another by, another filter and another metric are each another query; the order of a filter's names is not.
  const five = [panel("bars"), panel("table", { by: [] }), panel("bars", { filter: { target: "brain-x-git", a: 1 } }), panel("table", { filter: { a: 1, target: "brain-x-git" } }), panel("bars", { metric: "deploys.put-back" })];
  expect(dashboardQueries(five).map((q) => [q.metric, q.by.join(), JSON.stringify(q.filter)])).toEqual([["deploys.confirmed", "target", "{}"], ["deploys.confirmed", "", "{}"], ["deploys.confirmed", "target", '{"a":1,"target":"brain-x-git"}'], ["deploys.put-back", "target", "{}"]]);
  expect(dashboardQueries(null)).toEqual([]);
  const seen = [];
  const answer = (metric) => ({ metric, since: range.since, until: range.until, step: 60000, groups: 1, series: [{ t: range.since, target: "brain-x-git", n: 2, sum: null, max: null }], cost: { ms: 300, queries: 1, cached: metric === "deploys.put-back" } });
  const client = { query: async (name, params) => (seen.push([name, params]), name === "dashboard.get" ? { dashboard: { name: params.name, title: "Deploys", panels: five } } : params.target ? Promise.reject(new Error("AuthRequired")) : answer(params.metric)) };
  // The dashboard: one dashboard.get, none with no name or no client.
  const got = await dashboardGet({ client, name: "deploys" });
  expect(seen).toEqual([["dashboard.get", { name: "deploys" }]]);
  expect(got).toEqual({ name: "deploys", title: "Deploys", panels: five });
  expect([await dashboardGet({ client, name: null }), await dashboardGet({ client: null, name: "deploys" }), seen.length]).toEqual([null, null, 1]);
  expect(await dashboardGet({ client: { query: async () => { throw new Error("no dashboard x"); } }, name: "x" })).toEqual({ name: "x", title: "x", panels: [], error: "no dashboard x" });
  // An answer with no dashboard in it, and a dashboard with no panels: the name and no panels, which is read with no query.
  const bare = await dashboardGet({ client: { query: async () => ({}) }, name: "x" });
  expect([bare, await dashboardGet({ client: { query: async () => ({ dashboard: { name: "x", title: "X" } }) }, name: "x" })]).toEqual([{ name: "x", title: "x", panels: [] }, { name: "x", title: "X", panels: [] }]);
  const none = await dashboardRead({ client, dashboard: bare, range });
  expect([seen.length, none.answers.size, dashboardNote(none)]).toEqual([1, 0, "The last hour: 0 panels from 0 queries."]);
  // Its data: one metric.query a query, over the range, with by joined and a filter as parameters.
  seen.length = 0;
  const three = await dashboardRead({ client, dashboard: { name: "d", title: "D", panels: [panel("bars"), panel("table"), panel("bars")] }, range });
  expect(seen).toEqual([["metric.query", { metric: "deploys.confirmed", since: range.since, until: range.until, by: "target" }]]);
  expect([...three.answers.keys()]).toEqual(['["deploys.confirmed",["target"],[]]']);
  seen.length = 0;
  const data = await dashboardRead({ client, dashboard: got, range });
  expect(seen.map(([name, p]) => name + " " + JSON.stringify(p))).toEqual([
    'metric.query {"metric":"deploys.confirmed","since":' + range.since + ',"until":' + range.until + ',"by":"target"}',
    'metric.query {"metric":"deploys.confirmed","since":' + range.since + ',"until":' + range.until + "}",
    'metric.query {"a":1,"target":"brain-x-git","metric":"deploys.confirmed","since":' + range.since + ',"until":' + range.until + ',"by":"target"}',
    'metric.query {"metric":"deploys.put-back","since":' + range.since + ',"until":' + range.until + ',"by":"target"}'
  ]);
  // A query that failed is that query's error; the others are answered. Each panel finds its answer by its key.
  expect(five.map((p) => ((a) => (a.error ? a.error : a.metric + " " + a.series.length))(data.answers.get(panelQuery(p).key)))).toEqual(["deploys.confirmed 1", "deploys.confirmed 1", "AuthRequired", "AuthRequired", "deploys.put-back 1"]);
  expect([data.dashboard, data.range]).toEqual([got, range]);
  // A filter stands in for none of the parameters the page writes.
  seen.length = 0;
  await dashboardRead({ client, dashboard: { panels: [panel("bars", { filter: { metric: "core.calls", since: 1, by: "caller" } })] }, range });
  expect(seen[0][1]).toEqual({ metric: "deploys.confirmed", since: range.since, until: range.until, by: "target" });
  // No client (a visitor) and no dashboard: nothing is sent.
  seen.length = 0;
  expect([await dashboardRead({ client: null, dashboard: got, range }), await dashboardRead({ client, dashboard: null, range }), seen.length]).toEqual([null, null, 0]);
  // The note counts what was drawn from what.
  expect(dashboardNote(three)).toBe("The last hour: 3 panels from 1 query.");
  expect(dashboardNote(data)).toBe("The last hour: 5 panels from 4 queries, 1 answered from the service's memory, 1 failed.");
  expect(dashboardNote({ dashboard: { name: "x", panels: [], error: "no dashboard x" }, range, answers: new Map() })).toBe("dashboard.get failed: no dashboard x");
  return "1 metric.query for 3 panels, 4 for 5";
}
// %%
test_the_address_names_the_dashboard_and_keeps_its_other_pairs = {
  const layout = "#view=C100(S70(@tomlarkworthy/cloud-brain),S30(@tomlarkworthy/claude-code-pairing))";
  expect([dashboardOf(layout), dashboardOf(""), dashboardOf(null), dashboardOf("#dashboard="), dashboardOf("#dashboard=%E0%A4%A")]).toEqual([null, null, null, null, null]);
  expect([dashboardOf(layout + "&dashboard=deploys"), dashboardOf("dashboard=m-0123456789-x&cc=LOPE-1-AB"), dashboardOf("#view=x&dashboard=a%20b&r=1")]).toEqual(["deploys", "m-0123456789-x", "a b"]);
  // Added last when the address names none; put in the place of the one it names. The layout and a token stay as they are.
  expect(dashboardHash(layout + "&cc=LOPE-1-AB", "deploys")).toBe(layout + "&cc=LOPE-1-AB&dashboard=deploys");
  expect(dashboardHash(layout + "&dashboard=health&cc=LOPE-1-AB", "deploys")).toBe(layout + "&dashboard=deploys&cc=LOPE-1-AB");
  expect(dashboardHash("#dashboard=a&x=1&dashboard=b", "c")).toBe("#dashboard=c&x=1");
  expect([dashboardHash("", "health"), dashboardHash(null, "health")]).toEqual(["#dashboard=health", "#dashboard=health"]);
  expect(dashboardOf(dashboardHash(layout, "m-0123456789-x"))).toBe("m-0123456789-x");
  return "the pair dashboard=NAME";
}
// %%
test_the_select_opens_on_the_address_and_writes_a_choice_to_it = {
  const list = [{ name: "health", title: "Health" }, { name: "deploys", title: "Deploys" }, { name: "m-0123456789-deploys", title: "Deploys" }];
  const rig = (start, given = list) => {
    const r = { hash: start, went: [], heard: null };
    r.el = dashboardPick({ list: given, hash: () => r.hash, go: (h) => (r.went.push(h), (r.hash = h)), listen: (fn) => (r.heard = fn) });
    r.choose = (name) => ((r.el.value = name), r.el.dispatchEvent(new Event("input", { bubbles: true })));
    return r;
  };
  // With no pair in the address: the first of the list, and the address is not written.
  const a = rig("#view=C100(S100(@tomlarkworthy/cloud-brain))&cc=LOPE-1-AB");
  expect([...a.el.querySelectorAll("option")].map((o) => o.textContent)).toEqual(["Health", "Deploys (deploys)", "Deploys (m-0123456789-deploys)"]);
  expect([a.el.value, a.went]).toEqual(["health", []]);
  // A choice is written once, beside the pairs the address has.
  a.choose("deploys");
  expect(a.went).toEqual(["#view=C100(S100(@tomlarkworthy/cloud-brain))&cc=LOPE-1-AB&dashboard=deploys"]);
  // navigate says the address changed: it names the choice, so nothing is written again.
  a.heard();
  expect([a.el.value, a.went.length]).toEqual(["deploys", 1]);
  // The address changes under the select (back, a link): it is followed with one input event, and not written.
  let inputs = 0;
  a.el.addEventListener("input", () => inputs++);
  a.hash = "#view=C100(S100(@tomlarkworthy/cloud-brain))&dashboard=health";
  a.heard();
  expect([a.el.value, inputs, a.went.length]).toEqual(["health", 1, 1]);
  // A name the list does not have leaves the choice as it is.
  a.choose("deploys");
  a.hash = "#dashboard=gone";
  a.heard();
  expect([a.el.value, inputs, a.went.length]).toEqual(["deploys", 2, 2]);
  // An address with no pair (back, to before a choice) is the first of the list again, and is not written.
  a.hash = "#view=x";
  a.heard();
  expect([a.el.value, inputs, a.went.length, a.hash]).toEqual(["health", 3, 2, "#view=x"]);
  // Opened with the pair: that one is chosen. With a name that is not listed: the first, and the address is left.
  expect(rig("#view=x&dashboard=deploys").el.value).toBe("deploys");
  const gone = rig("#view=x&dashboard=gone");
  expect([gone.el.value, gone.went, gone.hash]).toEqual(["health", [], "#view=x&dashboard=gone"]);
  // Nothing to choose: a line, and the value null.
  expect([null, { error: "AuthRequired" }, []].map((given) => ((el) => [el.value, el.textContent, el.querySelector("select")])(rig("#dashboard=health", given).el))).toEqual([
    [null, "Sign in as the owner to see the dashboards.", null],
    [null, "dashboard.list failed: AuthRequired", null],
    [null, "This Brain keeps no dashboard.", null]
  ]);
  return "3 dashboards, 1 write";
}
// %%
test_bars_and_a_table_draw_any_metric_and_a_panel_says_what_it_cannot_draw = {
  const since = Date.UTC(2026, 9, 11, 7, 0), until = Date.UTC(2026, 9, 11, 8, 0);
  const row = (minute, target, n, sum = null, max = null) => ({ t: since + minute * 60000, target, n, sum, max });
  const counted = { metric: "deploys.confirmed", since, until, step: 60000, groups: 2, series: [row(1, "brain-x-git", 2), row(1, "brain-x-page", 1), row(5, "brain-x-git", 1)], cost: { ms: 300, queries: 1, cached: false } };
  const marks = (el, sel) => Math.max(...[el, ...el.querySelectorAll("svg")].map((n) => n.querySelectorAll(sel).length));
  // Bars: one a step and group of the first dimension; with no dimension, one a step.
  expect(marks(barsChart(counted, { by: ["target"] }), "rect")).toBeGreaterThan(2);
  expect(marks(barsChart(counted), "rect")).toBeGreaterThan(1);
  // A table: one row a group, most lines first. A counted metric has no sum and max.
  const cells = (el) => [...el.querySelectorAll("tbody tr")].map((tr) => [...tr.querySelectorAll("td")].slice(1).map((td) => td.textContent));
  const heads = (el) => [...el.querySelectorAll("thead th")].slice(1).map((th) => th.textContent.trim());
  const table = groupTable(counted, { by: ["target"] });
  expect([heads(table), cells(table)]).toEqual([["target", "n"], [["brain-x-git", "3"], ["brain-x-page", "1"]]]);
  expect(cells(groupTable(counted))).toEqual([["4"]]);
  const valued = { ...counted, metric: "m.0123456789.ms", series: [row(1, "a", 2, 80, 50), row(2, "a", 1, 900, 900), row(2, "b", 1, 3, 3)] };
  const sums = groupTable(valued, { by: ["target"] });
  expect([heads(sums), cells(sums)]).toEqual([["target", "n", "sum", "max"], [["a", "3", "980", "900"], ["b", "1", "3", "3"]]]);
  // A panel's body by its draw.
  const panel = (draw, by = ["target"]) => ({ title: draw, metric: counted.metric, by, filter: {}, draw });
  expect(marks(panelBody(panel("bars"), counted, { width: 600 }), "rect")).toBeGreaterThan(2);
  expect(cells(panelBody(panel("table"), counted)).length).toBe(2);
  // The three draws made for Health take the rows of core.calls, with the sum as `ms`.
  const calls = { metric: "core.calls", since, until, step: 60000, groups: 2, series: [{ t: since + 60000, worker: "brain-x-inbox", method: "inbox.poll", status: 200, n: 2, sum: 80, max: 50 }, { t: since + 120000, worker: "brain-x-inbox", method: "inbox.poll", status: 502, n: 1, sum: 900, max: 900 }, { t: since + 60000, worker: "brain-core", method: "rule.list", status: 401, n: 1, sum: 3, max: 3 }] };
  const health = ["worker", "method", "status"];
  expect(marks(panelBody(panel("calls", health), calls), "rect")).toBeGreaterThan(2);
  expect(marks(panelBody(panel("faults", health), calls), "rect")).toBeGreaterThan(2);
  expect(cells(panelBody(panel("methods", health), calls))).toEqual([["brain-x-inbox", "inbox.poll", "3", "0", "1", "327", "900"], ["brain-core", "rule.list", "1", "1", "0", "3", "3"]]);
  // What is said in a panel's place.
  expect([
    panelBody(panel("bars"), { error: "AuthRequired" }),
    panelBody(panel("bars"), undefined),
    panelBody(panel("pie"), counted),
    panelBody(panel("methods", ["worker"]), calls),
    panelBody(panel("bars"), { ...counted, series: [] })
  ].map((el) => el.textContent)).toEqual([
    "metric.query failed: AuthRequired",
    "metric.query was not asked.",
    'This page has no draw "pie".',
    'The draw "methods" takes rows by worker, method, status, and this panel\'s by has no method, status.',
    "No lines in this span."
  ]);
  // An answer with as many groups as one answer holds says it may be short.
  expect(dashboardGroupLimit).toBe(500);
  expect(panelBody(panel("table"), { ...counted, groups: 500 }).textContent).toContain("500 groups is the limit of one answer: some lines may be missing.");
  expect(panelBody(panel("table"), { ...counted, groups: 499 }).textContent).not.toContain("limit");
  // dashboard-panel-does-not-say-sampled: an answer Cloudflare made from a sample says so, and one counted from every line does not.
  const sampled = "Cloudflare answered this from a sample of the lines (sampled 10): each number is its estimate, and a group with few lines may be missing.";
  expect([1, undefined, null, 0].map((n) => panelBody(panel("table"), { ...counted, sampled: n }).textContent.includes("sample"))).toEqual([false, false, false, false]);
  expect(panelBody(panel("table"), { ...counted, sampled: 10 }).textContent).toContain(sampled);
  expect(marks(panelBody(panel("bars"), { ...counted, sampled: 10 }, { width: 600 }), "rect")).toBeGreaterThan(2);
  expect(panelBody(panel("bars"), { ...counted, sampled: 10 }, { width: 600 }).textContent).toContain(sampled);
  expect(panelBody(panel("bars"), { ...counted, sampled: 10, series: [] }).textContent).toBe("No lines in this span. " + sampled);
  // Both lines under one panel, the limit first.
  expect([...panelBody(panel("table"), { ...counted, groups: 500, sampled: 2 }).querySelectorAll(":scope > div")].map((d) => d.textContent)).toEqual(["500 groups is the limit of one answer: some lines may be missing.", sampled.replace("sampled 10", "sampled 2")]);
  return "2 draws for any metric, 3 for core.calls, 5 lines";
}
// %%
// The dashboard `flow` of plan/cloud-brain-flow-metrics.md ("The dashboard, as data"): its eleven rows, the last since fm-6-restores.
// It is a row on a Brain, put with dashboard.put, and no value of this module: the tests below hold that the service keeps it
// and that each of its panels has the dimensions its draw takes.
flowDashboardBody = ({
  name: "flow",
  title: "Flow",
  panels: [
    { title: "Feedback to deploy", metric: "flow.lead", by: ["id", "for"], filter: { kind: "feedback", to: "deploy" }, draw: "points" },
    { title: "Opened to deploy", metric: "flow.lead", by: ["id", "kind"], filter: { to: "deploy" }, draw: "points" },
    { title: "Opened to done", metric: "flow.lead", by: ["id", "kind"], filter: { to: "done" }, draw: "points" },
    { title: "Done a day", metric: "flow.lead", by: ["kind"], filter: { to: "done" }, draw: "bars" },
    { title: "Open work, by state", metric: "flow.open", by: ["state", "waits"], draw: "table" },
    { title: "Open work, by age", metric: "flow.open", by: ["waits", "kind"], draw: "table" },
    { title: "Hours by state", metric: "flow.stays", by: ["waits", "state"], draw: "table" },
    { title: "Sent back at review", metric: "flow.submits", by: ["move"], draw: "share" },
    { title: "Deploys, by Worker", metric: "deploys.confirmed", by: ["target"], draw: "bars" },
    { title: "Put back, by Worker", metric: "deploys.put-back", by: ["target"], draw: "table" },
    { title: "Time to restore", metric: "deploys.restore", by: ["id", "target"], draw: "points" }
  ]
})
// %%
// fm-5-page-and-dashboard, R8 of plan/cloud-brain-flow-metrics.md: a panel whose metric starts flow. is asked of the tracker's
// issue.flow, every other of metric.query, and the service keeps the draws points and share.
test_a_flow_panel_is_asked_of_issue_flow_and_the_service_keeps_points_and_share = {
  const range = { since: Date.UTC(2026, 9, 11, 7, 0) + 123, until: Date.UTC(2026, 9, 12, 7, 0) + 456 };
  const panels = [
    { title: "Opened to deploy", metric: "flow.lead", by: ["id", "kind"], filter: { to: "deploy" }, draw: "points" },
    { title: "Deploys, by Worker", metric: "deploys.confirmed", by: ["target"], filter: {}, draw: "bars" },
    { title: "Sent back at review", metric: "flow.submits", by: ["move"], filter: {}, draw: "share" },
    { title: "Again", metric: "flow.lead", by: ["id", "kind"], filter: { to: "deploy" }, draw: "table" },
    { title: "A member's", metric: "m.0123456789.flow.x", by: [], filter: {}, draw: "table" }
  ];
  expect(panels.map((p) => panelMethod(p.metric))).toEqual(["issue.flow", "metric.query", "issue.flow", "issue.flow", "metric.query"]);
  // Only a name that starts flow. is the tracker's.
  expect([undefined, null, "", "flow", "xflow.lead", "Flow.lead", "deploys.flow.x", 5].map(panelMethod)).toEqual(Array(8).fill("metric.query"));
  const seen = [];
  const client = { query: async (name, params) => (seen.push([name, params]), params.metric === "flow.submits" ? Promise.reject(new Error("AuthRequired")) : { from: name, metric: params.metric, series: [] }) };
  const data = await dashboardRead({ client, dashboard: { name: "flow", title: "Flow", panels }, range });
  // One call a distinct metric, by and filter, with the same parameters whichever method it is sent to; the span is sent as it is.
  expect(seen).toEqual([
    ["issue.flow", { to: "deploy", metric: "flow.lead", since: range.since, until: range.until, by: "id,kind" }],
    ["metric.query", { metric: "deploys.confirmed", since: range.since, until: range.until, by: "target" }],
    ["issue.flow", { metric: "flow.submits", since: range.since, until: range.until, by: "move" }],
    ["metric.query", { metric: "m.0123456789.flow.x", since: range.since, until: range.until }]
  ]);
  // Both kinds of answer are in the one Map, and a call that failed is that query's error.
  expect(panels.map((p) => ((a) => a.error || a.from)(data.answers.get(panelQuery(p).key)))).toEqual(["issue.flow", "metric.query", "AuthRequired", "issue.flow", "metric.query"]);
  expect(dashboardNote(data)).toBe("The last 24 hours: 5 panels from 4 queries, 1 failed.");
  // The service: seven draws, each with the dimensions it takes.
  expect(dashboardDraws).toEqual(["calls", "faults", "methods", "bars", "table", "points", "share"]);
  expect(Object.keys(panelNeeds)).toEqual(dashboardDraws);
  expect([panelNeeds.points, panelNeeds.share]).toEqual([["id"], []]);
  // The dashboard `flow` is kept as it was put, with points and share, and read back the same.
  const rig = await dashboardRig();
  const post = (body) => rig.call("dashboard.put", "", { verb: "POST", body });
  const kept = { ...flowDashboardBody, panels: flowDashboardBody.panels.map((p) => ({ title: p.title, metric: p.metric, by: p.by, filter: p.filter || {}, draw: p.draw })) };
  expect(await post(flowDashboardBody)).toEqual({ status: 200, data: { dashboard: kept } });
  expect(await rig.call("dashboard.get", "?name=flow")).toEqual({ status: 200, data: { dashboard: kept } });
  expect(kept.panels.map((p) => p.draw)).toEqual(["points", "points", "points", "bars", "table", "table", "table", "share", "bars", "table", "points"]);
  // Each of its panels has what its draw takes; eight of the eleven are the tracker's and the last is read from logs.deploys.
  expect(kept.panels.filter((p) => !panelNeeds[p.draw].every((k) => p.by.includes(k))).map((p) => p.title)).toEqual([]);
  expect(kept.panels.filter((p) => panelMethod(p.metric) === "issue.flow").length).toBe(8);
  expect(kept.panels.filter((p) => panelMethod(p.metric) === "logs.deploys").map((p) => p.title)).toEqual(["Time to restore"]);
  expect(dashboardQueries(kept.panels).length).toBe(11);
  // A draw that is none of the seven is still refused, and the refusal names the seven.
  const pie = await post({ name: "wrong", title: "Wrong", panels: [{ title: "Pie", metric: "flow.lead", draw: "pie" }] });
  expect([pie.status, pie.data.message]).toEqual([400, "panel 1: draw is one of calls, faults, methods, bars, table, points, share"]);
  for (const draw of ["Points", "point", "", null, ["points"]]) expect([JSON.stringify(draw), (await post({ name: "wrong", title: "Wrong", panels: [{ title: "x", metric: "flow.lead", by: ["id"], draw }] })).status]).toEqual([JSON.stringify(draw), 400]);
  expect([...rig.sim.rows.keys()]).toEqual(["dashboard/flow"]);
  expect(rig.seen.length).toBe(0);
  return "2 issue.flow and 2 metric.query for 5 panels; 7 draws";
}
// %%
// fm-5-page-and-dashboard: what points, share and a table draw from an answer of issue.flow. The median and the 85th percentile
// drawn are the answer's own `summaries`; this page computes neither.
test_points_share_and_hours_are_drawn_from_an_answer_of_issue_flow = {
  const H = 3600000, since = Date.UTC(2026, 9, 11, 7, 0), until = since + 24 * H;
  const flow = (metric, unit, series, summaries) => ({ metric, since, until, step: H, groups: (summaries || []).length, sampled: 1, unit, series, ...(summaries ? { summaries } : {}), cost: { ms: 400, events: 3652 } });
  const one = (hour, id, kind, hours) => ({ t: since + hour * H, id, kind, n: 1, sum: hours * H, max: hours * H });
  const lead = flow("flow.lead", "ms", [one(1, "a", "bug", 1.5), one(2, "b", "bug", 3), one(5, "c", "task", 0.5)], [{ kind: "bug", n: 2, median: 1.5 * H, p85: 3 * H, max: 3 * H }, { kind: "task", n: 1, median: 0.5 * H, p85: 0.5 * H, max: 0.5 * H }]);
  const count = (el, sel) => Math.max(...[el, ...el.querySelectorAll("svg")].map((n) => n.querySelectorAll(sel).length));
  const under = (el) => [...el.querySelectorAll(":scope > div")].map((d) => d.textContent);
  const panel = (draw, metric, by) => ({ title: draw, metric, by, filter: {}, draw });
  // points: a dot a row, a rule at the median and one at the 85th percentile of each of the answer's summaries, and a line for each.
  const points = pointsChart(lead, { by: ["id", "kind"], width: 600 });
  expect([count(points, "circle"), count(points, 'g[aria-label="rule"] line')]).toEqual([3, 4]);
  // A dot is at its row's value in hours, and names its id.
  expect([...points.querySelectorAll("circle title")].map((t) => t.textContent)).toEqual(["a\n1.5 h", "b\n3.0 h", "c\n0.5 h"]);
  expect(under(points)).toEqual(["bug: n 2, median 1.5 h, 85th percentile 3.0 h, longest 3.0 h", "task: n 1, median 0.5 h, 85th percentile 0.5 h, longest 0.5 h"]);
  // With id alone there is one summary and no name before its line; a value that is not ms is written as it is.
  const whole = pointsChart({ ...lead, summaries: [{ n: 3, median: 1.5 * H, p85: 3 * H, max: 3 * H }] }, { by: ["id"], width: 600 });
  expect([count(whole, "circle"), count(whole, 'g[aria-label="rule"] line'), under(whole)]).toEqual([3, 2, ["n 3, median 1.5 h, 85th percentile 3.0 h, longest 3.0 h"]]);
  expect(under(pointsChart(flow("flow.submits", "count", [{ t: since + H, id: "a", n: 1, sum: 1, max: 1 }], [{ n: 1, median: 1, p85: 1, max: 1 }]), { by: ["id"] }))).toEqual(["n 1, median 1, 85th percentile 1, most 1"]);
  // An answer with no summaries is dots, with n and the longest of its rows under them, and no rule.
  const bare = pointsChart(flow("deploys.restore", "ms", lead.series), { by: ["id"], width: 600 });
  expect([count(bare, "circle"), count(bare, 'g[aria-label="rule"] line'), under(bare)]).toEqual([3, 0, ["n 3, longest 3.0 h"]]);
  // As a panel: the same drawing; without id in by the panel says so.
  const drawn = panelBody(panel("points", "flow.lead", ["id", "kind"]), lead, { width: 600 });
  expect([count(drawn, "circle"), count(drawn, 'g[aria-label="rule"] line'), under(drawn).length]).toEqual([3, 4, 2]);
  expect(panelBody(panel("points", "flow.lead", ["kind"]), lead).textContent).toBe('The draw "points" takes rows by id, and this panel\'s by has no id.');
  // share: a line a group with n, sum and sum / n.
  const cells = (el) => [...el.querySelectorAll("tbody tr")].map((tr) => [...tr.querySelectorAll("td")].slice(1).map((td) => td.textContent));
  const heads = (el) => [...el.querySelectorAll("thead th")].slice(1).map((th) => th.textContent.trim());
  const sent = (hour, move, n, sum) => ({ t: since + hour * H, move, n, sum, max: sum ? 1 : 0 });
  const submits = flow("flow.submits", "count", [sent(1, "submit", 8, 4), sent(2, "submit", 2, 1), sent(1, "submit-spec", 3, 0)], [{ move: "submit", n: 10, median: 0.5, p85: 1, max: 1 }, { move: "submit-spec", n: 3, median: 0, p85: 0, max: 0 }]);
  const share = shareTable(submits, { by: ["move"] });
  expect([heads(share), cells(share)]).toEqual([["move", "n", "sum", "share"], [["submit", "10", "5", "0.50"], ["submit-spec", "3", "0", "0.00"]]]);
  expect(cells(shareTable(submits))).toEqual([["13", "5", "0.38"]]);
  expect(cells(panelBody(panel("share", "flow.submits", ["move"]), submits))).toEqual(cells(share));
  // A counted metric has no value to take a share of, and the panel says so.
  const counted = { metric: "deploys.confirmed", since, until, step: H, groups: 1, series: [{ t: since + H, target: "brain-x-git", n: 2, sum: null, max: null }] };
  expect(panelBody(panel("share", "deploys.confirmed", ["target"]), counted).textContent).toBe('The draw "share" takes a metric with a value, and deploys.confirmed is counted.');
  // A table of an answer in ms is in hours with one decimal, with the median and the 85th of each group from the answer's summaries.
  const stay = (hour, state, waits, n, sum, max) => ({ t: since + hour * H, state, waits, n, sum: sum * H, max: max * H });
  const open = flow("flow.open", "ms", [stay(1, "open", "start", 3, 9, 4), stay(2, "open", "start", 1, 1, 1), stay(1, "building", "work", 1, 2.5, 2.5)], [{ state: "open", waits: "start", n: 4, median: 2 * H, p85: 4 * H, max: 4 * H }, { state: "building", waits: "work", n: 1, median: 2.5 * H, p85: 2.5 * H, max: 2.5 * H }]);
  const table = panelBody(panel("table", "flow.open", ["state", "waits"]), open);
  expect([heads(table), cells(table)]).toEqual([["state", "waits", "n", "sum h", "max h", "median h", "p85 h"], [["open", "start", "4", "10.0", "4.0", "2.0", "4.0"], ["building", "work", "1", "2.5", "2.5", "2.5", "2.5"]]]);
  // A group the summaries do not have has no median; with id in by a row is an issue and there is no column for them.
  expect(cells(groupTable({ ...open, summaries: [open.summaries[1]] }, { by: ["state", "waits"] })).map((r) => r.slice(-2))).toEqual([["", ""], ["2.5", "2.5"]]);
  expect(heads(groupTable(lead, { by: ["id", "kind"] }))).toEqual(["id", "kind", "n", "sum h", "max h"]);
  // An answer of metric.query has no unit and no summaries, and is written as before.
  expect(heads(groupTable({ ...counted, series: [{ ...counted.series[0], sum: 80, max: 50 }] }, { by: ["target"] }))).toEqual(["target", "n", "sum", "max"]);
  // What is said in the place of a panel of the tracker's names the method that was asked.
  expect([
    panelBody(panel("points", "flow.lead", ["id"]), { error: "AuthRequired" }),
    panelBody(panel("points", "flow.lead", ["id"]), undefined),
    panelBody(panel("points", "flow.lead", ["id"]), { ...lead, series: [] }),
    panelBody(panel("table", "deploys.confirmed", ["target"]), { ...counted, series: [] })
  ].map((el) => el.textContent)).toEqual(["issue.flow failed: AuthRequired", "issue.flow was not asked.", "No rows in this span.", "No lines in this span."]);
  // The limit of 500 groups is Cloudflare's, of metric.query: an answer of issue.flow leaves no row out and says nothing of it.
  expect(panelBody(panel("table", "flow.open", ["state", "waits"]), { ...open, groups: 500 }).textContent).not.toContain("limit");
  expect(panelBody(panel("table", "deploys.confirmed", ["target"]), { ...counted, groups: 500 }).textContent).toContain("500 groups is the limit of one answer");
  // Bars count rows of the tracker's answer, and lines of a log for metric.query.
  const done = flow("flow.lead", "ms", [{ t: since + H, kind: "bug", n: 2, sum: 3 * H, max: 2 * H }, { t: since + 2 * H, kind: "task", n: 1, sum: H, max: H }], []);
  const label = (el) => [...el.querySelectorAll("svg text")].map((t) => t.textContent).filter((t) => /rows|lines/.test(t)).join();
  expect([count(panelBody(panel("bars", "flow.lead", ["kind"]), done, { width: 600 }), "rect") >= 2, label(panelBody(panel("bars", "flow.lead", ["kind"]), done, { width: 600 })), label(panelBody(panel("bars", "deploys.confirmed", ["target"]), counted, { width: 600 }))]).toEqual([true, "↑ rows", "↑ lines"]);
  return "3 dots and 4 rules; 2 shares; a table in hours";
}
// %%
// fm-6-restores, R6 of plan/cloud-brain-flow-metrics.md: the metric deploys.restore is read from logs.deploys of brain-logs, with
// the range as from and to, and restoreRows makes its `restores` the rows a panel draws: one for each restore that has an end.
test_time_to_restore_is_read_from_logs_deploys_and_drawn_as_points = {
  const H = 3600000, range = { since: Date.UTC(2026, 9, 5, 7, 0) + 123, until: Date.UTC(2026, 9, 12, 7, 0) + 123 };
  const restore = (target, letter, putBack, hours) => ({ target, hash: letter.repeat(64), putBack, restored: hours == null ? null : putBack + hours * H, ms: hours == null ? null : hours * H });
  const deploys = { from: range.since, to: range.until, queries: 5, lines: [], workers: [], tests: [], restores: [restore("brain-x-git", "a", range.since + H, 1.5), restore("brain-x-git", "b", range.since + 3 * H, 3), restore("brain-x-page", "c", range.since + 4 * H, 0.5), restore("brain-x-page", "d", range.until - H, null)] };
  // Only that name is read from the logs service: the other deploys. metrics are metric.query's.
  expect(["deploys.restore", "deploys.restores", "deploys.restore.x", "deploys.confirmed", "deploys.put-back", "flow.deploys.restore", "m.0123456789.deploys.restore"].map(panelMethod)).toEqual(["logs.deploys", "metric.query", "metric.query", "metric.query", "metric.query", "issue.flow", "metric.query"]);
  // A row for each restore that has an end, at its end, with the Worker and the first 8 of the hash put back as its id. The
  // put-back with no end has no row and is counted. No summaries: this page computes no percentile.
  const row = (target, id, t, hours) => ({ t, id, target, n: 1, sum: hours * H, max: hours * H });
  const series = [row("brain-x-git", "brain-x-git@aaaaaaaa", range.since + 2.5 * H, 1.5), row("brain-x-git", "brain-x-git@bbbbbbbb", range.since + 6 * H, 3), row("brain-x-page", "brain-x-page@cccccccc", range.since + 4.5 * H, 0.5)];
  expect(restoreRows(deploys)).toEqual({ metric: "deploys.restore", since: range.since, until: range.until, step: H, unit: "ms", series, unrestored: 1 });
  // A panel's filter is taken on the rows, the count of those with no end too; a name no row has keeps none.
  expect(((a) => [a.series, a.unrestored])(restoreRows(deploys, { target: "brain-x-page" }))).toEqual([[series[2]], 1]);
  expect(((a) => [a.series, a.unrestored])(restoreRows(deploys, { target: "brain-x-git", id: "brain-x-git@bbbbbbbb" }))).toEqual([[series[1]], 0]);
  expect(((a) => [a.series, a.unrestored])(restoreRows(deploys, { kind: "bug" }))).toEqual([[], 0]);
  expect(restoreRows({ ...deploys, restores: [] })).toEqual({ metric: "deploys.restore", since: range.since, until: range.until, step: H, unit: "ms", series: [], unrestored: 0 });
  // An answer with no restores (a brain-x-logs from before this) is an error of the query, not rows.
  const none = { error: "its answer has no restores" };
  expect([restoreRows({ from: 1, to: 2, lines: [] }), restoreRows(null), restoreRows({ restores: "x" }), restoreRows({ error: "AuthRequired" })]).toEqual([none, none, none, none]);
  // dashboardRead: one logs.deploys for the dashboard, with from and to and nothing of the panel; every other query as before.
  const seen = [];
  const client = { query: async (name, params) => (seen.push([name, params]), name === "logs.deploys" ? deploys : { from: name, metric: params.metric, series: [] }) };
  const panels = [
    { title: "Time to restore", metric: "deploys.restore", by: ["id", "target"], filter: {}, draw: "points" },
    { title: "Put back, by Worker", metric: "deploys.put-back", by: ["target"], filter: {}, draw: "table" },
    { title: "The page", metric: "deploys.restore", by: ["id"], filter: { target: "brain-x-page" }, draw: "points" },
    { title: "By Worker", metric: "deploys.restore", by: ["target"], filter: {}, draw: "table" }
  ];
  const data = await dashboardRead({ client, dashboard: { name: "flow", title: "Flow", panels }, range });
  expect(seen).toEqual([["logs.deploys", { from: range.since, to: range.until }], ["metric.query", { metric: "deploys.put-back", since: range.since, until: range.until, by: "target" }]]);
  const answer = (i) => data.answers.get(panelQuery(panels[i]).key);
  expect([answer(0), answer(1), answer(2), answer(3)]).toEqual([restoreRows(deploys), { from: "metric.query", metric: "deploys.put-back", series: [] }, restoreRows(deploys, { target: "brain-x-page" }), restoreRows(deploys)]);
  expect(dashboardNote(data)).toBe("The last 7 days: 4 panels from 4 queries.");
  // A read that failed is the error of each query that is drawn from it, and the others are answered.
  const refused = await dashboardRead({ client: { query: async (name, params) => (name === "logs.deploys" ? Promise.reject(new Error("AuthRequired")) : { from: name, metric: params.metric, series: [] }) }, dashboard: { panels }, range });
  expect(panels.map((p) => ((a) => a.error || a.from)(refused.answers.get(panelQuery(p).key)))).toEqual(["AuthRequired", "metric.query", "AuthRequired", "AuthRequired"]);
  const old = await dashboardRead({ client: { query: async () => ({ from: range.since, to: range.until, lines: [] }) }, dashboard: { panels: [panels[0]] }, range });
  expect(panelBody(panels[0], old.answers.get(panelQuery(panels[0]).key)).textContent).toBe("logs.deploys failed: its answer has no restores");
  // Drawn: a dot a restore in hours, named by its id, with n and the longest under them and no rule; then the put-backs with no end.
  const count = (el, sel) => Math.max(...[el, ...el.querySelectorAll("svg")].map((n) => n.querySelectorAll(sel).length));
  const open = "Put-backs of this span with no later deploy that stood by its end, and so no row: 1.";
  const drawn = panelBody(panels[0], answer(0), { width: 600 });
  expect([count(drawn, "circle"), count(drawn, 'g[aria-label="rule"] line')]).toEqual([3, 0]);
  expect([...drawn.querySelectorAll("circle title")].map((t) => t.textContent)).toEqual(["brain-x-git@aaaaaaaa\n1.5 h", "brain-x-git@bbbbbbbb\n3.0 h", "brain-x-page@cccccccc\n0.5 h"]);
  expect([drawn.firstElementChild.lastElementChild.textContent, drawn.lastElementChild.textContent]).toEqual(["n 3, longest 3.0 h", open]);
  // With every put-back restored nothing is said under the dots.
  expect(panelBody(panels[0], restoreRows(deploys, { target: "brain-x-git" }), { width: 600 }).textContent).not.toContain("Put-backs");
  // No restore in the span, and one put-back that has none yet: both said in the panel's place, with the method's name where it failed.
  const cells = (el) => [...el.querySelectorAll("tbody tr")].map((tr) => [...tr.querySelectorAll("td")].slice(1).map((td) => td.textContent));
  const heads = (el) => [...el.querySelectorAll("thead th")].slice(1).map((th) => th.textContent.trim());
  expect([
    panelBody(panels[0], restoreRows({ ...deploys, restores: [] })),
    panelBody(panels[0], restoreRows({ ...deploys, restores: [deploys.restores[3]] })),
    panelBody(panels[0], { error: "AuthRequired" }),
    panelBody(panels[0], undefined),
    panelBody({ ...panels[0], by: ["target"] }, answer(0))
  ].map((el) => el.textContent)).toEqual(["No rows in this span.", "No rows in this span. " + open, "logs.deploys failed: AuthRequired", "logs.deploys was not asked.", 'The draw "points" takes rows by id, and this panel\'s by has no id.']);
  // As a table: hours by Worker, and no median. As bars: rows. Neither says the limit of metric.query's groups.
  const table = panelBody(panels[3], { ...answer(3), groups: 500 });
  expect([heads(table), cells(table)]).toEqual([["target", "n", "sum h", "max h"], [["brain-x-git", "2", "4.5", "3.0"], ["brain-x-page", "1", "0.5", "0.5"]]]);
  expect([table.textContent.includes("limit"), table.lastElementChild.textContent]).toEqual([false, open]);
  const bars = panelBody({ ...panels[3], draw: "bars" }, answer(3), { width: 600 });
  expect([count(bars, "rect") >= 2, [...bars.querySelectorAll("svg text")].map((t) => t.textContent).filter((t) => /rows|lines/.test(t)).join()]).toEqual([true, "↑ rows"]);
  return "1 logs.deploys for 3 panels; 3 dots of 4 put-backs";
}
