test_apply_takes_source_and_deploys_what_it_distils = {
  const rig = await deployerRig({ acceptEmitted: false });
  // Code made elsewhere is refused, whoever sends it.
  const made = await rig.made("brain-x-a", "recipe", "a");
  expect((await rig.recover({ workers: [made] })).results).toEqual([{ worker: "brain-x-a", state: "refused", reason: "send the module's source: this deployer deploys only what it distils" }]);
  expect(rig.fake.scripts.size).toBe(0);
  const source = (await exportModuleJS("@tomlarkworthy/brain-deployer")).source;
  const out = await rig.recover({ workers: [{ module: "@tomlarkworthy/brain-deployer", source, cell: "deployer_probe_service" }] });
  const here = await deployer_probe_service.emit();
  expect(out.results.map((r) => [r.worker, r.state, r.hash])).toEqual([["brain-x-probe", "deployed", here.hash]]);
  expect([...rig.fake.scripts.keys()]).toEqual(["cb-x-probe"]);
  expect(rig.sim.rows.get("source/@tomlarkworthy/brain-deployer")).toMatchObject({ text: source, worker: "brain-x-probe", hash: here.hash });
  // Source that does not load is refused by name and nothing is uploaded for it.
  const bad = await rig.recover({ workers: [{ module: "@tomlarkworthy/nothing", source: "export default function define() { throw new Error('boom'); }" }] });
  expect(bad.results).toEqual([{ worker: "@tomlarkworthy/nothing", state: "refused", reason: "cannot distil: boom" }]);
  expect(rig.fake.scripts.size).toBe(1);
  return out.results[0].hash.slice(0, 12);
}
// %%
test_redistil_after_a_deployer_update_and_source_follows_a_put_back = {
  const rig = await deployerRig({ acceptEmitted: false });
  const U = "https://cb-deployer.sub.workers.dev/xrpc/com.lopecode.brain.infra.redistil";
  const redistil = async (body = {}) => (await rig.sim.fetch(U, { method: "POST", headers: { "content-type": "application/json", authorization: "Bearer rk" }, body: JSON.stringify(body) })).json();
  const source = (await exportModuleJS("@tomlarkworthy/brain-deployer")).source;
  const M = "@tomlarkworthy/brain-deployer", one = { module: M, source, cell: "deployer_probe_service" };
  const h1 = (await rig.recover({ workers: [one] })).results[0].hash;
  // The same deployer distils the same code: nothing to do, and nothing is uploaded.
  const uploads = () => rig.fake.log.filter((l) => l.startsWith("POST") && l.includes("/versions")).length;
  const before = uploads();
  const same = await redistil({ apply: true });
  expect(same.results).toEqual([{ worker: "brain-x-probe", module: M, state: "same", hash: h1 }]);
  expect(uploads()).toBe(before);
  expect((await rig.state()).distiller.last.hash).toBe((await rig.state()).distiller.now);
  // A script from before logs gets them from redistil, with nothing uploaded.
  rig.fake.scripts.get("cb-x-probe").observability = null;
  await redistil({ apply: true });
  expect([rig.fake.scripts.get("cb-x-probe").observability, uploads()]).toEqual([{ enabled: true, logs: { enabled: true, invocation_logs: false } }, before]);
  // A record whose hash this deployer does not reproduce stands for a Worker distilled by an older deployer.
  const rec = rig.sim.rows.get("worker/brain-x-probe"), kept = rig.sim.rows.get("source/" + M);
  rig.sim.rows.set("worker/brain-x-probe", { ...rec, hash: "0".repeat(64) });
  rig.sim.rows.set("source/" + M, { ...kept, hash: "0".repeat(64) });
  expect((await redistil()).results).toEqual([{ worker: "brain-x-probe", module: M, state: "changes", from: "0".repeat(64), hash: h1 }]);
  expect(uploads()).toBe(before);
  expect((await redistil({ apply: true })).results[0]).toMatchObject({ state: "changes", applied: "deployed", hash: h1 });
  expect(rig.fake.running("cb-x-probe")).toBe(h1);
  // A second version, put back: the source kept is again the first one's.
  const two = { ...one, source: source.replace('"com.lopecode.brain.probe.ping"', '"com.lopecode.brain.probe.pong"') };
  const h2 = (await rig.recover({ workers: [two] })).results[0].hash;
  expect(h2).not.toBe(h1);
  expect(rig.sim.rows.get("source/" + M)).toMatchObject({ text: two.source, hash: h2, prev: { hash: h1 } });
  rig.fake.unhealthy.add(h2);
  await rig.sim.scheduled();
  await rig.sim.scheduled();
  expect(rig.fake.running("cb-x-probe")).toBe(h1);
  expect(rig.sim.rows.get("source/" + M)).toMatchObject({ text: source, hash: h1, prev: null });
  expect((await redistil({ apply: true })).results[0]).toMatchObject({ state: "same", hash: h1 });
  return h1.slice(0, 12);
}
// %%
md`## Moving to a new Worker name

Until 2026-10-08 the deployer's Worker was \`BASE-guard\`. A Worker cannot be renamed: \`BASE-deployer\` is a new Worker, and its Durable Object holds no rows. The move is five steps, each one command of \`brain.ts\`, and no step deletes anything.

| step | what | check |
|---|---|---|
| 1 | Update \`BASE-guard\` in place to this module, so that it has \`exportRows\`. | \`infra.getState\` answers as before |
| 2 | Install \`BASE-deployer\` with the same recovery key and \`config.self\`. Send it the rows of the old one. | \`infra.rowsDigest\` is equal on both |
| 3 | Install \`BASE-guard\` again with \`config.replacedBy\`. It then changes nothing: no apply, no tick, no approval. | an apply to it answers 409 \`Replaced\` |
| 4 | Apply every service through \`BASE-deployer\`. The kernel and the core are then bound to it as \`DEPLOYER\`. | every Worker is \`same\` under \`redistil\` |
| 5 | Put a stub on \`BASE-guard\` with no Cloudflare token and no recovery key. Its rows stay as they were. | its bindings are \`ROWS\` and \`BRAIN_CONFIG\` |

\`exportRows\`, \`importRows\` and \`rowsDigest\` need the recovery key. The rows hold the key of every Worker, so the kernel cannot ask for them and \`brain.ts\` prints none of them. \`importRows\` refuses a deployer that holds a row. The rows \`tick\` and \`distiller\` are each deployer's own and are not copied or counted.

Between step 2 and step 3 two deployers hold the token and tick. Step 3 follows step 2 at once. The copy is of one moment: a deploy through the old deployer after step 2 is not in the new one.`
// %%
test_rows_move_to_a_deployer_that_holds_none = {
  const old = await deployerRig({ config: { self: undefined } });
  await old.recover({ workers: [await old.made("brain-core", "core", "a"), await old.made("brain", "kernel", "a", { resources: ["deployer"] }), await old.made("brain-x-a", "recipe", "a")] });
  await old.form({ key: "rk", action: "approval:off" });
  const U = (rig, m) => "https://cb-deployer.sub.workers.dev/xrpc/com.lopecode.brain.infra." + m;
  const get = async (rig, m, headers = { authorization: "Bearer rk" }) => { const r = await rig.sim.fetch(U(rig, m), { headers }); return { status: r.status, data: await r.json() }; };
  const post = async (rig, m, body, headers = { authorization: "Bearer rk" }) => { const r = await rig.sim.fetch(U(rig, m), { method: "POST", headers: { "content-type": "application/json", ...headers }, body: JSON.stringify(body) }); return { status: r.status, data: await r.json() }; };
  // Only the recovery key: not the kernel for the owner, and not a wrong key.
  expect((await get(old, "exportRows", { authorization: "Bearer wrong" })).status).toBe(401);
  expect((await old.asOwner("exportRows")).error).toBe("AuthRequired");
  expect((await old.asOwner("importRows", { rows: [] })).error).toBe("AuthRequired");
  const out = (await get(old, "exportRows")).data;
  expect(out.rows.map((r) => r.key).filter((k) => k.startsWith("worker/")).sort()).toEqual(["worker/brain", "worker/brain-core", "worker/brain-x-a"]);
  expect(out.rows.some((r) => r.key === "tick" || r.key.startsWith("__"))).toBe(false);
  const next = await deployerRig();
  // Its own tick has run: that row does not make it "not empty".
  next.sim.rows.set("tick", { at: 1 });
  expect((await post(next, "importRows", { rows: [{ key: "__tick_origin", value: "x" }] })).status).toBe(400);
  const done = await post(next, "importRows", out);
  expect(done.status).toBe(200);
  expect(done.data.imported).toBe(out.rows.length);
  expect(done.data.classes).toEqual((await get(old, "rowsDigest")).data.classes);
  expect(Object.keys(done.data.classes).sort()).toEqual(["confirmed", "kernelstate", "settings", "worker"]);
  // The keys came with the rows: the new deployer reaches the same Workers, and the setting is the old one.
  expect(next.sim.rows.get("worker/brain").key).toBe(old.sim.rows.get("worker/brain").key);
  expect((await next.state()).approval).toBe(false);
  // A second import is refused, and so is one row changed on either side.
  expect((await post(next, "importRows", out)).data.error).toBe("NotEmpty");
  next.sim.rows.set("settings", { approval: true });
  expect((await get(next, "rowsDigest")).data.classes.settings).not.toEqual((await get(old, "rowsDigest")).data.classes.settings);
  return `${out.rows.length} rows moved, 4 classes equal`;
}
// %%
test_a_replaced_deployer_changes_nothing = {
  const store = new Map();
  const live = await deployerRig({ store });
  await live.recover({ workers: [await live.made("brain-core", "core", "a"), await live.made("brain", "kernel", "a"), await live.made("brain-x-a", "recipe", "a")] });
  const old = await deployerRig({ store, config: { replacedBy: "https://cb-deployer.sub.workers.dev" } });
  const b = await old.made("brain-x-a", "recipe", "b");
  expect(await old.recover({ workers: [b] })).toMatchObject({ error: "Replaced", deployer: "https://cb-deployer.sub.workers.dev" });
  expect((await old.asOwner("confirm", {})).error).toBe("Replaced");
  expect((await old.form({ key: "rk", action: "approval:off" })).status).toBe(409);
  // Its tick checks nothing: a Worker that fails is not put back by it.
  old.fake.unhealthy.add(store.get("worker/brain-x-a").hash);
  const calls = old.fake.log.length;
  await old.sim.scheduled();
  await old.sim.scheduled();
  expect(old.fake.log.length).toBe(calls);
  // It still says what it holds, and where the deployer is.
  expect((await old.state()).replacedBy).toBe("https://cb-deployer.sub.workers.dev");
  expect(await (await old.sim.fetch("https://cb-deployer.sub.workers.dev/")).text()).toContain("This deployer was replaced");
  expect(store.get("worker/brain-x-a").hash).not.toBe(b.hash);
  return "apply, confirm and approval refused with 409";
}
