test_the_shell_is_passed_on_to_static_and_needs_a_key = {
  const rig = await deployerRig();
  const U = "https://cb-deployer.sub.workers.dev/xrpc/com.lopecode.brain.infra.shell";
  const send = (headers) => rig.sim.fetch(U, { method: "POST", headers, body: "<html>shell</html>" });
  expect((await send({})).status).toBe(401);
  // Before a core exists there is nowhere to pass it.
  expect((await send({ authorization: "Bearer rk" })).status).toBe(503);
  await rig.recover({ workers: [await rig.made("brain-core", "core", "a")] });
  const before = rig.fake.calls.length;
  expect((await send({ authorization: "Bearer rk" })).status).toBe(200);
  const passed = rig.fake.calls.slice(before).filter((c) => c.nsid === "static.put");
  expect(passed.map((c) => [c.worker, c.body, new URLSearchParams(c.query).get("path"), new URLSearchParams(c.query).get("public")])).toEqual([["brain-core", "<html>shell</html>", "shell/index.html", "true"]]);
  return "passed on";
}
