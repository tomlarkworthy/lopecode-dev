test_the_deployer_binds_itself_under_its_own_script_name = {
  const bound = async (config, resource) => {
    const rig = await deployerRig({ config });
    await rig.recover({ workers: [await rig.made("brain-core", "core", "a"), await rig.made("brain", "kernel", "a", { resources: [resource] })] });
    const b = rig.fake.live("cb").metadata.bindings;
    return { service: (b.find((x) => x.name === "DEPLOYER") || {}).service, told: b.find((x) => x.name === "BRAIN_CONFIG").json.deployer, old: b.some((x) => x.name === "GUARD"), rig };
  };
  // A Brain installed before 2026-10-08 has no config.self: its deployer is BASE-guard.
  expect(await bound({ self: undefined }, "deployer")).toMatchObject({ service: "cb-guard", told: "https://cb-guard.sub.workers.dev", old: false });
  const now = await bound({}, "deployer");
  expect(now).toMatchObject({ service: "cb-deployer", told: "https://cb-deployer.sub.workers.dev" });
  // A source distilled before 2026-10-08 names the cell guard.
  expect((await bound({}, "guard")).service).toBe("cb-deployer");
  const rig = await deployerRig();
  await rig.recover({ workers: [await rig.made("brain-core", "core", "a")] });
  for (const name of ["brain-deployer", "brain-guard"]) expect((await rig.recover({ workers: [await rig.made(name, "recipe", "a")] })).results[0].reason).toBe('resource name "brain-deployer" is reserved');
  return "cb-guard with no config.self, cb-deployer with it";
}
