// A small service of this module, for the distil test.
deployer_probe_service = cloudflare.Service("probe", async () => new Response("ok"), { methods: { "com.lopecode.brain.probe.ping": { type: "query", who: "anyone" } } })
// %%
md`## A member's Worker

\`member.deploy\`, \`member.remove\` and \`member.purge\` are reached through the kernel only, which names the member. There is no approval and no recovery key on this path, so everything is decided by rule:

| | |
|---|---|
| Name | \`brain-m-ID-NAME\`. \`ID\` is the first ten hex digits of the SHA-256 of the member's DID; \`NAME\` is the name given to \`cloudflare.Service\`, 1 to 20 lower case letters and digits. A recipe may not be named \`brain-x-m-…\` and a system Worker may not be named \`brain-m-…\`. |
| Source | Distilled here, in QuickJS, with no other module's kept source. At most 200,000 characters of source and 1,000,000 of code. |
| Taken from what was distilled | The code, the Worker's name, and for each method its type and \`who\`. Nothing else: the bindings, the role, the flags and the rules are written here. |
| Bindings | \`CORE\`, its own key, and its manifest. No database, no bucket, no secret, no other Worker. |
| Platform cells | \`sql\` and \`xrpc\`. Any other is refused, as are a secret, a path, a cron and a flag. |
| Methods | Named \`com.lopecode.brain.m.ID.…\`. \`who\` is \`"author"\` (the member, and the owner) or \`"members"\` (any signed-in member, and the owner). |
| Address | None: its \`workers.dev\` address is switched off, and its health is asked through the core. |
| Limit | 3 Workers a member, or the number the owner set for them. |
| Source kept | Under \`msource/\`, apart from the modules \`infra.getModules\` lists. \`member.modules\` answers \`cloudflare-iac\` and the calling member's modules, for a page served to that member; nothing serves one yet. |

A member's Worker is not distilled again by \`redistil\`.`
// %%
memberRig = async () => {
  const rig = await deployerRig();
  await rig.recover({ workers: [await rig.made("brain-core", "core", "c"), await rig.made("brain", "kernel", "k")] });
  const key = rig.sim.rows.get("worker/brain").key;
  const as = async (method, caller, body, k = key) => {
    const r = await rig.sim.fetch("https://deployer.internal/xrpc/com.lopecode.brain.member." + method, { method: "POST", headers: { "content-type": "application/json", "x-brain-key": k, "x-brain-caller": caller }, body: JSON.stringify(body) });
    return { status: r.status, ...(await r.json()) };
  };
  const A = "did:plc:alice", id = (await sha256(A)).slice(0, 10), ns = `com.lopecode.brain.m.${id}.`;
  const service = async (name, salt, extra = {}) => {
    const e = await rig.made("brain-x-" + name, "recipe", salt, extra);
    return { parts: e.parts, meta: e.meta };
  };
  const deploy = async (name, salt, extra, author = A, quota = {}) => as("deploy", "member", { author, quota, request: await service(name, salt, extra) });
  return { ...rig, as, A, id, ns, service, deploy, key };
}
// %%
test_a_member_deploys_with_no_approval_and_only_the_core_bound = {
  const rig = await memberRig(), { id, ns, A } = rig;
  expect((await rig.state()).approval).toBe(true);
  const out = await rig.deploy("todo", "a", { resources: ["sql", "xrpc"], access: { [ns + "add"]: { type: "procedure", who: "author" }, [ns + "list"]: { type: "query", who: "members" } } });
  expect(out).toMatchObject({ worker: `brain-m-${id}-todo`, state: "deployed", methods: [ns + "add", ns + "list"] });
  const script = `cb-m-${id}-todo`;
  expect(rig.fake.live(script).metadata.bindings.map((b) => b.name)).toEqual(["CORE", "BRAIN_KEY", "BRAIN_CONFIG", "BRAIN_INFO"]);
  expect(rig.fake.scripts.get(script).subdomain).toBe(false);
  const registered = rig.fake.calls.filter((c) => c.nsid === "service.register" && c.body.worker === `brain-m-${id}-todo`).at(-1).body;
  expect(registered).toMatchObject({ role: "member", author: A, paths: [], secrets: [] });
  expect(registered.methods[ns + "add"].allow).toBe('caller.kind == "owner" || caller.did == "did:plc:alice"');
  expect(registered.methods[ns + "list"].allow).toBe('caller.kind in ["owner", "did"]');
  expect((await rig.state()).pending).toEqual([]);
  // The same again is unchanged; a change goes live and keeps the key.
  expect((await rig.deploy("todo", "a", { resources: ["sql", "xrpc"], access: { [ns + "add"]: { type: "procedure", who: "author" }, [ns + "list"]: { type: "query", who: "members" } } })).state).toBe("unchanged");
  const at = (lines) => lines.filter((l) => l.target === `brain-m-${id}-todo`).map((l) => l.at);
  expect(at(await logged(async () => expect((await rig.deploy("todo", "b")).state).toBe("deployed")))).toContain("deploy.deployed");
  // A version that does not answer is put back.
  const bad = await rig.service("todo", "c");
  rig.fake.unhealthy.add(await partsHash(bad.parts, { worker: `brain-m-${id}-todo`, role: "member", author: A, module: null, calls: [], crons: [], flags: [], methods: [], access: {}, paths: [], secrets: [], resources: [], bindings: [] }));
  expect(at(await logged(async () => expect((await rig.as("deploy", "member", { author: A, request: bad })).state).toBe("put-back")))).toContain("deploy.put-back");
  expect((await rig.as("remove", "member", { author: "did:plc:bob", request: { name: "todo" } })).state).toBe("refused");
  expect((await rig.as("remove", "member", { author: A, request: { name: "todo" } })).state).toBe("removed");
  expect(rig.fake.scripts.has(script)).toBe(false);
  return "deployed and removed";
}
// %%
test_a_member_deploy_is_refused_outside_its_tier = {
  const rig = await memberRig(), { ns, A, id } = rig;
  const no = async (name, extra, author = A, quota) => (await rig.deploy(name, "x", extra, author, quota)).reason;
  expect(await no("a", { resources: ["rows"] })).toBe('a member service may not use the platform cell "rows"');
  for (const cell of ["blobs", "database", "deployer", "assets", "inbox", "core", "workers", "browser"]) expect(await no("a", { resources: [cell] })).toBe(`a member service may not use the platform cell "${cell}"`);
  expect(await no("a", { secrets: ["WA_TOKEN"] })).toBe("a member service may not name a secret");
  expect(await no("a", { paths: [{ path: "/hooks/a", who: "anyone" }] })).toBe("a member service has no paths");
  expect(await no("a", { crons: ["* * * * *"] })).toBe("a member service has no schedule and no flags");
  expect(await no("a", { access: { "com.lopecode.brain.library.list": { type: "query", who: "author" } } })).toMatch("a method of this member is named " + ns);
  expect(await no("a", { access: { [ns + "x"]: { type: "query", who: "anyone" } } })).toMatch('who is "author" or "members"');
  expect(await no("a", { access: { [ns + "x"]: { type: "query", who: "owner" } } })).toMatch('who is "author" or "members"');
  expect(await no("a", { access: { [ns + "x"]: { type: "query", who: "author", allow: "true" } } })).toMatch('who is "author" or "members"');
  expect(await no("has-dash", {})).toMatch("NAME is 1 to 20 lower case letters and digits");
  expect((await rig.as("deploy", "member", { author: A, request: { parts: [{ path: "worker.js", text: "x" }], meta: { worker: "brain-core", role: "core", resources: [], secrets: [] } } })).reason).toMatch("with no role");
  expect((await rig.as("deploy", "member", { author: A, request: { parts: [{ path: "quickjs.wasm", base64: "AA" }], meta: (await rig.service("a", "x")).meta } })).reason).toBe("the parts are worker.js, source.js and lib/NAME.js");
  expect((await rig.as("deploy", "member", { author: "did:plc:owner", request: await rig.service("a", "x") })).reason).toBe("a member");
  // Only the kernel is heard, and only as a member for a deploy.
  expect((await rig.as("deploy", "member", { author: A, request: await rig.service("a", "x") }, "not-the-key")).status).toBe(401);
  expect((await rig.as("deploy", "owner", { author: A, request: await rig.service("a", "x") })).status).toBe(501);
  expect((await rig.sim.fetch("https://cb-deployer.sub.workers.dev/xrpc/com.lopecode.brain.member.deploy", { method: "POST", headers: { authorization: "Bearer rk", "x-brain-caller": "member", "content-type": "application/json" }, body: "{}" })).status).toBe(401);
  // Three Workers a member, or what the owner set; another member's count is their own.
  for (const n of ["a", "b", "c"]) expect((await rig.deploy(n, n)).state).toBe("deployed");
  expect(await no("d", {})).toBe("3 services are deployed, at most 3");
  expect((await rig.deploy("d", "d", {}, A, { workers: 4 })).state).toBe("deployed");
  expect((await rig.deploy("a", "a", {}, "did:plc:bob")).state).toBe("deployed");
  // A recipe and a system Worker cannot take a member's name.
  const taken = await rig.recover({ workers: [await rig.made(`brain-x-m-${id}-a`, "recipe", "r"), await rig.made(`brain-m-${id}-zz`, "system", "s")] });
  expect(taken.results.map((r) => r.state)).toEqual(["refused", "refused"]);
  // Removing the member removes all of theirs and nobody else's.
  expect((await rig.as("purge", "member", { author: A })).status).toBe(501);
  expect((await rig.as("purge", "owner", { author: A })).removed.length).toBe(4);
  expect([...rig.fake.scripts.keys()].filter((k) => k.startsWith("cb-m-")).length).toBe(1);
  return "refused outside the tier";
}
// %%
test_getModules_keeps_a_members_module_out_of_the_brains_list = {
  const rig = await memberRig(), { id, A } = rig;
  rig.sim.rows.set(`msource/brain-m-${id}-todo`, { module: "@alice/todo", text: "export default function define() {}", author: A, hash: "h" });
  const list = async (query = "") => (await (await rig.sim.fetch("https://cb-deployer.sub.workers.dev/xrpc/com.lopecode.brain.infra.getModules" + query)).json()).modules.map((m) => m.module);
  expect(await list()).not.toContain("@alice/todo");
  // Naming a member in the public list changes nothing: a member's source is given to that member only.
  expect(await list("?member=" + encodeURIComponent(A))).not.toContain("@alice/todo");
  const mine = async (author) => (await rig.as("modules", "member", { author })).modules.map((m) => m.module);
  expect(await mine(A)).toEqual(["@tomlarkworthy/cloudflare-iac", "@alice/todo"]);
  expect(await mine("did:plc:bob")).toEqual(["@tomlarkworthy/cloudflare-iac"]);
  return "a member sees its own modules";
}
