test_a_cloudflare_permission_is_refused_off_the_list_and_outside_a_recipe = {
  const rig = await deployerRig();
  const reason = async (w) => (await rig.recover({ workers: [w] })).results[0].reason;
  expect(await reason(await rig.made("brain-x-greedy", "recipe", "g", { cloudflare: ["Workers Observability Read", "Workers Scripts Write"] }))).toBe('"Workers Scripts Write" is not a Cloudflare permission a service may declare. A service may declare: Workers Observability Read, Workers Tail Read');
  expect(await reason(await rig.made("brain-core", "core", "c", { cloudflare: ["Workers Observability Read"] }))).toBe("only a recipe declares Cloudflare permissions");
  expect(rig.fake.tokens.size).toBe(0);
  const members = await memberRig();
  expect((await members.deploy("a", "x", { cloudflare: ["Workers Observability Read"] })).reason).toBe("a member service may not declare Cloudflare permissions");
  expect(members.fake.tokens.size).toBe(0);
  return "3 refusals, no token";
}
// %%
test_a_version_put_back_gets_a_token_that_works = {
  const rig = await deployerRig();
  const bound = () => rig.fake.live("cb-x-logs").metadata.bindings.find((b) => b.name === "CF_TOKEN");
  const v1 = await rig.made("brain-x-logs", "recipe", "one", { cloudflare: ["Workers Observability Read"] });
  const v2 = await rig.made("brain-x-logs", "recipe", "two", { cloudflare: ["Workers Observability Read", "Workers Tail Read"] });
  await rig.recover({ workers: [v1] });
  const first = bound().text;
  await rig.recover({ workers: [v2] });
  // The token of v1 was deleted when v2 went live. v2 fails twice and v1 is put back with a new one.
  expect(rig.fake.tokens.size).toBe(1);
  rig.fake.unhealthy.add(v2.hash);
  await rig.sim.scheduled();
  await rig.sim.scheduled();
  expect(rig.fake.running("cb-x-logs")).toBe(v1.hash);
  const [now] = [...rig.fake.tokens.values()];
  expect([rig.fake.tokens.size, bound().text === now.value, bound().text === first, now.policies[0].permission_groups]).toEqual([1, true, false, [{ id: "g-obs" }]]);
  expect(rig.sim.rows.get("token/brain-x-logs")).toMatchObject({ id: now.id, groups: ["Workers Observability Read"] });
  expect(rig.sim.rows.get("worker/brain-x-logs")).toMatchObject({ hash: v1.hash, token: now.id, cloudflare: ["Workers Observability Read"] });
  // The mint is refused at the next put-back. The row says what is live and that it holds no token; a later tick mints.
  const v4 = await rig.made("brain-x-logs", "recipe", "four", { cloudflare: ["Workers Observability Read", "Workers Tail Read"] });
  await rig.recover({ workers: [v4] });
  rig.fake.unhealthy.add(v4.hash);
  rig.fake.stored.noMint = true;
  const lines = await logged(async () => {
    await rig.sim.scheduled();
    await rig.sim.scheduled();
  });
  expect(rig.fake.running("cb-x-logs")).toBe(v1.hash);
  expect(rig.sim.rows.get("worker/brain-x-logs")).toMatchObject({ hash: v1.hash, state: "deployed", token: null, failedHash: v4.hash });
  expect([rig.fake.tokens.size, rig.sim.rows.has("token/brain-x-logs")]).toEqual([0, false]);
  expect(lines.filter((l) => l.target === "brain-x-logs" && l.at === "token.mint-failed").length).toBe(1);
  rig.fake.stored.noMint = false;
  await rig.sim.scheduled();
  const [later] = [...rig.fake.tokens.values()];
  expect([rig.fake.tokens.size, bound().text === later.value, rig.fake.running("cb-x-logs")]).toEqual([1, true, v1.hash]);
  expect(rig.sim.rows.get("worker/brain-x-logs")).toMatchObject({ hash: v1.hash, token: later.id });
  const now2 = later;
  // A version put back that holds the same token keeps it.
  const v3 = await rig.made("brain-x-logs", "recipe", "three", { cloudflare: ["Workers Observability Read"] });
  await rig.recover({ workers: [v3] });
  rig.fake.unhealthy.add(v3.hash);
  await rig.sim.scheduled();
  await rig.sim.scheduled();
  expect([rig.fake.running("cb-x-logs"), [...rig.fake.tokens.keys()]]).toEqual([v1.hash, [now2.id]]);
  return "re-minted, and again after a refused mint";
}
