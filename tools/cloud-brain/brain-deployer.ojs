test_getModules_lists_what_the_deployer_owns_and_what_runs = {
  const rig = await deployerRig({ acceptEmitted: false });
  const U = "https://cb-deployer.sub.workers.dev/xrpc/com.lopecode.brain.infra.getModules";
  const list = async () => (await (await rig.sim.fetch(U)).json()).modules;
  // Nobody has to sign in. Before any deploy: the two modules of the deployer.
  const first = await list();
  expect(first.map((m) => [m.module, m.worker])).toEqual([["@tomlarkworthy/cloudflare-iac", "brain-deployer"], ["@tomlarkworthy/brain-deployer", "brain-deployer"]]);
  expect(Object.keys(first[0].files).sort()).toEqual(["acorn-walk.js", "acorn.js", "cel.js", "hono.js", "observable-runtime.js", "quickjs.js", "quickjs.wasm.b64"]);
  expect(first[0].text).toBe((await exportModuleJS("@tomlarkworthy/cloudflare-iac")).source);
  expect(first[1].text).toBe((await exportModuleJS("@tomlarkworthy/brain-deployer")).source);
  // A deployed Worker's module is added with the hash that runs. The fixture has one module for two Workers.
  const source = (await exportModuleJS("@tomlarkworthy/brain-static")).source;
  const out = await rig.recover({ workers: [{ module: "@tomlarkworthy/brain-static", source }] });
  expect((await list()).slice(2).map((m) => [m.module, m.worker, m.hash, m.text === source])).toEqual([["@tomlarkworthy/brain-static", "brain-x-static", out.results[0].hash, true]]);
  // The key the deployer made for that Worker is not in the answer.
  expect(JSON.stringify(await list()).includes(rig.sim.rows.get("worker/brain-x-static").key)).toBe(false);
  expect((await rig.sim.fetch(U, { method: "POST" })).status).toBe(401);
  return first.length + " then 3";
}
