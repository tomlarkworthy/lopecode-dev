test_distil_answers_the_tabs_hash_and_deploys_nothing = {
  const rig = await deployerRig();
  const U = "https://cb-deployer.sub.workers.dev/xrpc/com.lopecode.brain.infra.distil";
  const ask = (body, headers = { authorization: "Bearer rk" }) => rig.sim.fetch(U, { method: "POST", headers: { "content-type": "application/json", ...headers }, body: JSON.stringify(body) });
  const source = (await exportModuleJS("@tomlarkworthy/brain-deployer")).source;
  const before = rig.fake.log.length;
  const r = await ask({ module: "@tomlarkworthy/brain-deployer", source, cell: "deployer_probe_service" });
  const out = await r.json();
  expect(out.message).toBe(undefined);
  expect(r.status).toBe(200);
  expect(out.hash).toBe((await deployer_probe_service.emit()).hash);
  expect(rig.fake.log.length).toBe(before);
  expect((await ask({}, {})).status).toBe(401);
  const bad = await ask({ module: "@tomlarkworthy/brain-deployer", source: "export default function define() { throw new Error('boom'); }" });
  expect(bad.status).toBe(400);
  expect((await bad.json()).message).toContain("boom");
  // This module has two services, so the cell has to be named; and the deployer's own is refused.
  expect((await (await ask({ module: "@tomlarkworthy/brain-deployer", source })).json()).message).toContain("name the cell");
  expect((await (await ask({ module: "@tomlarkworthy/brain-deployer", source, cell: "deployer_service" })).json()).message).toBe("the deployer is not distilled by a deployer");
  return out.hash.slice(0, 12);
}
