md`Worked cases on the 2026-10-27 test snapshot (the \`snapshot\` cell, not drawn on this page), the edge core.route → bar ×4 of the first checked by \`test_fold_lift\` and the rest of it not asserted, the last by \`test_drag_writes_one_row\`:`
// %%
examples = [
  { given: "fold [3] (services)", expect: "one bar 'services · 5 methods', edge core.route → bar ×4, bar → cb4-sql edges lifted" },
  { given: "fold [3] and [4]", expect: "services and storage rows each one bar; storage bar shows its inbound edges lifted (not asserted by a test)" },
  { given: "drag kernel.xrpc to the left of kernel.session", expect: "order gains 2 rows (cell keyed), kernel.xrpc first; a second drag in that cell changes 1 row" }
]
