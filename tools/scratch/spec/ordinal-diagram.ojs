md`*X-axis fold, drawn from this snapshot's ranks: depths 1–3 hold 11 methods in rows edge to storage (drain.run, tab.ui and kernel.health are depth 0; rows.append and rows.get are depth 4; r2.get is depth 2). The bar is one box over rows, so on a real x fold the y rows it crosses would have to give up those cells. Folding both axes at once can make two groups claim the same cells; the prototype folds y only.*`
// %%
states = [
  { state: "open", drawing: "chapter_runs", when: "no folds" },
  { state: "folded", drawing: "chapter_deploys", when: "a y-level label clicked (chapter 4 starts folded)" },
  { state: "reordered", drawing: "step8", when: "a box dragged inside its cell" },
  { state: "excluded rows", drawing: "chapter_calls", when: "a row has no value for an axis level (Workers that list no methods in service.list, and brain-deployer, which is not in it)" },
  { state: "data cycle", drawing: "chapter_calls", when: "rows reach each other along a rank relation (fly ⇄ loop, dashed red outline per member)" },
  { state: "linked hover", drawing: "step11", when: "the pointer is over a box in any view" },
  { state: "x-axis fold", drawing: "artboard_x_fold", when: "a column prefix folded" }
]
// %%
statesTable = htl.html`<table style="font-size:.9em">
  <thead><tr><th>state</th><th>when</th><th>drawing</th></tr></thead>
  <tbody>${states.map((s) => htl.html`<tr data-state=${s.state}><td>${s.state}</td><td>${s.when}</td><td>${s.drawing ? htl.html`<code>${s.drawing}</code>` : htl.html`<em>not drawn</em>`}</td></tr>`)}</tbody>
</table>`
