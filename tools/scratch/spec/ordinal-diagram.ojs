ources":["rows","xrpc"],"role":"recipe","secrets":[]},{"calls":["com.lopecode.brain.topic.append"],"cloudflare":[],"deployedAt":"2026-10-31T19:37:09.313Z","hash":"48fe1ee4c6c1ea5ceb82594802e08baeb8f365446d3f148cd44b89cd109e7932","module":"@tomlarkworthy/brain-issues","name":"brain-x-issues","paths":[],"resources":["blobs","sql","xrpc"],"role":"recipe","secrets":["ISSUES_SIGNING_KEY"]},{"calls":["com.lopecode.brain.ai.v1/embeddings"],"cloudflare":[],"deployedAt":"2026-10-29T08:52:23.553Z","hash":"42cbf7ca5258c8b566639086da9f79431dffe18f7aff1524897d4776391a456f","module":"@tomlarkworthy/brain-knowledge","name":"brain-x-knowledge","paths":[],"resources":["database","vectors","xrpc"],"role":"recipe","secrets":[]},{"calls":["com.lopecode.brain.knowledge.delete","com.lopecode.brain.knowledge.put","com.lopecode.brain.static.delete","com.lopecode.brain.static.get","com.lopecode.brain.static.put"],"cloudflare":[],"deployedAt":"2026-10-29T08:52:40.938Z","hash":"63493cdee9ed1ba89f39bba551a9a8b45836f75560c16aaa8d085221ebdac91b","module":"@tomlarkworthy/brain-library","name":"brain-x-library","paths":[{"path":"/library/*","who":"anyone"}],"resources":["rows","xrpc"],"role":"recipe","secrets":[]},{"calls":[],"cloudflare":["Workers Observability Read"],"deployedAt":"2026-10-29T08:52:58.576Z","hash":"c4aace2ee66c22290f3f5ad8bc6719970b005dfa2af88a07b993457ac0299901","module":"@tomlarkworthy/brain-logs","name":"brain-x-logs","paths":[],"resources":[],"role":"recipe","secrets":[]},{"calls":["com.lopecode.brain.fly.down","com.lopecode.brain.fly.run","com.lopecode.brain.fly.status","com.lopecode.brain.fly.stop","com.lopecode.brain.fly.up","com.lopecode.brain.issue.get","com.lopecode.brain.issue.list","com.lopecode.brain.issue.policy","com.lopecode.brain.issue.queue"],"cloudflare":[],"deployedAt":"2026-10-30T02:31:57.119Z","hash":"320bff7fa92d0505e6beec0ea721b7d0ac7a7396ad5961dc4c3d1e9fd4c49e1c","module":"@tomlarkworthy/brain-loop","name":"brain-x-loop","paths":[],"resources":["rows","xrpc"],"role":"recipe","secrets":["LOOP_DELEGATE"]},{"calls":["com.lopecode.brain.static.get"],"cloudflare":[],"deployedAt":"2026-10-29T08:57:22.376Z","hash":"54e87a41436b05bd0e8c876fcb5a8707a12d046aed7b293b00c0885f5730c2a3","module":"@tomlarkworthy/cloud-brain","name":"brain-x-page","paths":[{"path":"/","who":"anyone"}],"resources":["xrpc"],"role":"recipe","secrets":[]},{"calls":[],"cloudflare":[],"deployedAt":"2026-10-29T08:53:47.756Z","hash":"73aa740954439eec8a4a0cf23103ec99925562767a6e6207375b8a0075c03aba","module":"@tomlarkworthy/brain-pds","name":"brain-x-pds","paths":[{"allow":"true","path":"/.well-known/atproto-did","who":"anyone"}],"resources":[],"role":"recipe","secrets":["PDS_WRAP_KEY"]},{"calls":[],"cloudflare":[],"deployedAt":"2026-10-29T08:54:08.542Z","hash":"d9f45f5543897f91890f41445eac59c2c89273a4ba1857b891e3224aa8ab50d4","module":"@tomlarkworthy/brain-proxy","name":"brain-x-proxy","paths":[],"resources":[],"role":"recipe","secrets":["ANTHROPIC_API_KEY","OPENROUTER_API_KEY"]},{"calls":["com.lopecode.brain.issue.open","com.lopecode.brain.knowledge.put","com.lopecode.brain.static.delete","com.lopecode.brain.static.put"],"cloudflare":[],"deployedAt":"2026-10-29T08:54:24.261Z","hash":"2f68582f3c46291ffd1fb469da3dcb7421590cf82777675afc432c53ec539c9c","module":"@tomlarkworthy/brain-snapshot","name":"brain-x-snapshot","paths":[],"resources":["rows","xrpc"],"role":"recipe","secrets":[]},{"calls":[],"cloudflare":[],"deployedAt":"2026-10-29T09:00:32.135Z","hash":"2e6e2fe8967c358f1695f6952442c6f89096ec05c95a4a9ee0419861f8157288","module":"@tomlarkworthy/brain-static","name":"brain-x-static","paths":[{"path":"/static/*","who":"anyone"}],"resources":["blobs","rows"],"role":"recipe","secrets":[]},{"calls":[],"cloudflare":[],"deployedAt":"2026-10-31T14:54:57.006Z","hash":"d41f16b78bc68dadde5590ec894af7e25fe82cfb3c326cb2001f8064e51f53d7","module":"@tomlarkworthy/brain-topic","name":"brain-x-topic","paths":[],"resources":["sql","xrpc"],"role":"recipe","secrets":[]},{"calls":[],"cloudflare":["Billing Read"],"deployedAt":"2026-10-29T08:56:45.358Z","hash":"5fe6f69cd7f8b621fe777b8be0ee46355eba2fab4f4e9132c102a7986e5fcfb6","module":"@tomlarkworthy/brain-usage","name":"brain-x-usage","paths":[],"resources":[],"role":"recipe","secrets":[]},{"calls":["com.lopecode.brain.lease.get","com.lopecode.brain.static.put"],"cloudflare":[],"deployedAt":"2026-10-29T08:57:03.554Z","hash":"1aadf7d412d6707ad00a672f824a00ec49782fbe7969120326a451d0b446f406","module":"@tomlarkworthy/brain-whatsapp","name":"brain-x-whatsapp","paths":[{"path":"/hooks/whatsapp","who":"anyone"}],"resources":["inbox","rows","xrpc"],"role":"recipe","secrets":["WHATSAPP_ACCESS_TOKEN","WHATSAPP_APP_SECRET","WHATSAPP_PHONE_ID","WHATSAPP_VERIFY_TOKEN"]}],"depInfo":{"access":{},"calls":["com.lopecode.brain.blob.upload"],"cloudflare":[],"crons":["* * * * *"],"deployedAt":"2026-10-31T19:23:39.673Z","flags":["global_fetch_strictly_public"],"hash":"6cb2e71105557efd6ce8f6591b9ca96249a018240c31aaba616f8f6c1e1a642c","methods":[],"module":"@tomlarkworthy/brain-deployer","name":"brain-deployer","paths":[],"resources":["rows"],"role":"deployer","secrets":["CF_API_TOKEN","RECOVERY_KEY"],"worker":"brain-deployer"},"depRef":"| method | caller | what it does |\n|---|---|---|\n| `infra.apply` (POST) | the owner's session, the recovery key | Distils, checks, holds, tests, deploys and removes Workers. The sections below give each step. |\n| `infra.getState` (GET) | the owner's session, the recovery key | The Workers, their probation, the confirmed versions, the held deploys and the approvals that stand. |\n| `infra.approvalRequests`, `infra.approvalRequest`, `infra.approveRequest` | see Asking the owner | The requests of held deploys. |\n| `infra.confirm` (POST) | the owner's session, the recovery key | Ends the probation of one Worker. |\n| `infra.redistil` (POST) | the owner's session, the recovery key | Distils the kept source of every Worker again with this deployer. With `apply: true` it deploys each Worker whose code changes. |\n| `infra.tokenWorkers` (GET, POST) | the owner's session, the recovery key | The Workers that a sign-in link's token may change. |\n| `infra.canaryKey` (GET, POST) | the owner's session, the recovery key | The SHA-256 of the canary key. See The canary key. |\n| `infra.reviewKey` (GET, POST) | the owner's session, the recovery key | The SHA-256 of the review key. See The review key. |\n| `infra.shell` (POST) | the owner's session, the recovery key | Passes the body to brain-static as `shell/index.html`, or with `?name=verify` as `shell/verify.html`. Both files are public. |\n| `infra.distil` (POST) | the owner's session, the recovery key | Answers what a source distils to. It deploys nothing. |\n| `infra.exportRows`, `infra.importRows`, `infra.rowsDigest` | the recovery key | See Moving to a new Worker name. |\n| `infra.getModules` (GET) | anyone | The source of each module of a Worker of this Brain, and cloudflare-iac. `?dry=ID` gives the modules of that dry apply in place of the kept ones. |\n| `member.deploy`, `member.remove`, `member.modules` | the kernel, for a member | See A member's Worker. |\n| `member.purge` | the kernel, for the owner | Removes every Worker of one member. |\nThe installer deploys `deployer_service`, and nothing on the Brain can change it: `deployerAllows` and the role check in `refusal` refuse any apply that names it. Its cron calls `tick` once a minute. Its `calls` names `blob.upload`, for the docs of a service (see Docs of a service). The core checks `calls` only for a Worker known by its key, not for the deployer, so the list says what the deployer may call and gates nothing; brain-x-blob decides on the caller `deployer`.\n| declared | binding |\n|---|---|\n| `rows` | `SQL`, the one D1 database of the Brain |\n| `database` | `DB`, a D1 database of the Worker's own |\n| `vectors` | `VECTORS`, a Vectorize index `SCRIPT-NAME` |\n| `analytics` | `METRICS`, the Analytics Engine dataset of the Brain |\n| `blobs` | `BLOBS`, the R2 bucket `BASE-blobs` |\n| `inbox`, `xrpc`, `sql` or `core`, or a secret of a Worker that is not the kernel or the core | `CORE`, the core |\n| `deployer` | `DEPLOYER`, the deployer |\n| `assets` | `ASSETS`, the page that the apply sends |\n| `browser` | `X_CF_BROWSER_RUN` |\n| a container image | `BOX_NAME`, a Durable Object class |\n| `objects`, each a binding and a class name | that binding, a Durable Object class of the Worker's own |\n| Cloudflare permissions | `CF_TOKEN` |\n| every Worker | `BRAIN_KEY`, `BRAIN_CONFIG`, `BRAIN_INFO` |\n| line | when |\n|---|---|\n| `deploy.reason` | before a change, with `reason`, `by`, `targets` |\n| `deploy.uploaded`, `deploy.deployed`, `deploy.probation` | the steps of a deploy |\n| `deploy.unhealthy` | a health check that failed for 60 seconds, with `last`, what the last check answered |\n| `deploy.put-back` | a version put back, with `reason` and, after a test run, `run` |\n| `deploy.refused`, `deploy.waiting` | an apply's refused and held Workers |\n| `deploy.approved`, `deploy.confirmed` | an approval by `infra.approveRequest`, the end of a probation |\n| `deploy.canary-key` | a set or a delete of the canary key's SHA-256, with `set` |\n| `deploy.review-key` | a set or a delete of the review key's SHA-256, with `set` |\n| `deploy.removed`, `deploy.failing` | a removal; two failed health checks with no version before |\n| `deploy.lease-taken-over`, `deploy.over-unverified` | a take-over of a change; a deploy over a Worker on probation |\n| `deploy.logs-on`, `deploy.tail` | `ensureLogs` changed a script's settings |\n| `deploy.index-made`, `deploy.index-found` | a Vectorize index |\n| `deploy.application-made`, `deploy.application-set`, `deploy.application-removed` | a container application |\n| `deploy.verify`, `deploy.verified`, `deploy.failed`, `deploy.verify.none`, `deploy.verify.stale`, `deploy.run.none`, `deploy.issue.none` | the test run after a deploy |\n| `deploy.dry.run`, `deploy.dry.tests`, `deploy.dry.none` | the test run of a dry apply or a held deploy |\n| `deploy.shared`, `deploy.shared.not-stored` | the shared modules of the page |\n| `deploy.topic.failed` | an append of a line to the topic below that failed, with `kind` (the line's `at`), `topic` and `reason` |\n| `token.mint`, `token.roll`, `token.delete`, `token.mint-failed` | Cloudflare tokens |\n| the run gave | the deployer | the result's `state` | log line |\n|---|---|---|---|\n| a pass for the hash that runs | ends the probation and tells the core (`deploy.report`) | `verified`, `tests`, `run` | `deploy.verified` |\n| a fail for the hash that runs, with a version before | puts the version before back at once and opens an issue (below) | `put-back`, `previous`, `reason`, `failures: [{ test }]`, `run` | `deploy.failed`, `deploy.put-back` with `run` |\n| a fail, and no version before | leaves the version running, tells the core, and opens an issue | `failing`, `failed`, `failures`, `run` | `deploy.failed` |\n| a verdict for another hash | nothing | the state of the deploy | `deploy.verify.stale` |\n| no verdict: no browser, no time bought, the wait passed, or the page could not judge | nothing | the state of the deploy | `deploy.verify.none` with the reason |\n| the run gave | fields of the answer |\n|---|---|\n| a pass | `tests`, `ms`; `state` stays `ready` or `unchanged` |\n| a fail | `state: \"tests-failed\"`, `tests`, `failed: [{ name, message, stack }]`, `reason`, `ms` |\n| no verdict, or a verdict for another hash | `none` with the reason; `state` stays |\n| the apply gave | the answer for the entry |\n|---|---|\n| the page holds the new text after the write | `state: \"verified\"` (or the Worker's `deployed` or `probation`), `tests`, `ms`, `shared` |\n| the page held the new text before the apply | the Worker's state, `shared` |\n| a dry apply with passing tests | `state: \"ready\"` (or the Worker's state), `tests`, `ms`, `shared` |\n| failed tests | `state: \"tests-failed\"` as in A dry run runs the tests; the page stays as it is |\n| no verdict, a write that does not reach the page, or a page that changed after the read | `state: \"not-stored\"` with `reason`; the page stays as it is. A dry apply with no verdict answers `none` and keeps the state. |\n| field | holds |\n|---|---|\n| `docs` | the manifest of the docs after the change: NAME.md to `{ sha256, size }` |\n| `wasDocs` | the manifest the caller synced, before the change |\n| `docText` | NAME.md to text, for each doc whose sha256 differs from `wasDocs` |\n| step | what | check |\n|---|---|---|\n| 1 | Update `BASE-guard` in place to this module, so that it has `exportRows`. | `infra.getState` answers as before |\n| 2 | Install `BASE-deployer` with the same recovery key and `config.self`. Send it the rows of the old one. | `infra.rowsDigest` is equal on both |\n| 3 | Install `BASE-guard` again with `config.replacedBy`. It then changes nothing: no apply, no tick, no approval. | an apply to it answers 409 `Replaced` |\n| 4 | Apply every service through `BASE-deployer`. The kernel and the core then bind it as `DEPLOYER`. | every Worker is `same` under `redistil` |\n| 5 | Put a stub on `BASE-guard` with no Cloudflare token and no recovery key. Its rows stay. | its bindings are `ROWS` and `BRAIN_CONFIG` |\n| | |\n|---|---|\n| Name | `brain-m-ID-NAME`. `ID` is the first ten hex digits of the SHA-256 of the member's DID. `NAME` is the name given to `cloudflare.Service`, 1 to 20 lower case letters and digits. A recipe cannot have a name `brain-x-m-…`, and a system Worker cannot have a name `brain-m-…`. |\n| Source | The deployer distils it in QuickJS, with no other module's kept source. The source has at most 200,000 characters and the code at most 1,000,000. The sandbox stops a source that does not end (see `distilIn` in `cloudflare-iac`). |\n| What the deployer takes from the distil | The code, the Worker's name, and for each method its type and `who`. The deployer writes the bindings, the role, the flags and the rules itself. |\n| Bindings | `CORE`, its own key, `BRAIN_CONFIG` and its manifest. No database, no bucket, no secret, no other Worker. |\n| Platform cells | `sql` and `xrpc`. The deployer refuses any other, and a secret, a path, a cron, a flag, a tail and Cloudflare permissions. |\n| Methods | Named `com.lopecode.brain.m.ID.…`. `who` is `\"author\"` (the member, and the owner) or `\"members\"` (any signed-in member, and the owner). |\n| Address | None: its `workers.dev` address is off, and the core asks it for its health. |\n| Limit | 3 Workers a member, or the number the owner set for them. 60 calls of `member.deploy` a member an hour, or the owner's number. The count is under `mdeploys/DID/HOUR`, before the distil. A call that the deployer refuses, or that changes nothing, counts. |\n| Name held | Two DIDs can share an `ID`. The deployer refuses a deploy to a name that holds a Worker of another member. |\n| Source kept | Under `msource/`, apart from the modules that `infra.getModules` lists. `member.modules` answers `cloudflare-iac` and the calling member's modules, for a page served to that member. |","lexicons":{"brain":[{"id":"com.lopecode.brain.grant.delete","defs":{"main":{"type":"procedure","input":{"encoding":"application/json","schema":{"properties":{"did":{}}}}}}},{"id":"com.lopecode.brain.grant.list","defs":{"main":{"type":"query"}}},{"id":"com.lopecode.brain.grant.put","defs":{"main":{"type":"procedure","input":{"encoding":"application/json","schema":{"properties":{"did":{},"methods":{}}}}}}},{"id":"com.lopecode.brain.people.link","defs":{"main":{"type":"procedure","input":{"encoding":"application/json","schema":{"properties":{"channel":{},"address":{},"did":{}}}}}}},{"id":"com.lopecode.brain.people.list","defs":{"main":{"type":"query"}}},{"id":"com.lopecode.brain.people.put","defs":{"main":{"type":"procedure","input":{"encoding":"application/json","schema":{"properties":{"did":{},"name":{},"services":{},"quota":{},"tags":{}}}}}}},{