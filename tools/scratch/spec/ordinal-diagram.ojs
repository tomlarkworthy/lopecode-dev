","test_a_workers_variable_does_not_grow_with_its_methods","test_the_page_worker_is_on_timed_probation","test_failed_selftest_is_put_back","test_failing_twice_after_go_live_is_put_back","test_deployer_an_applied_worker_is_on_probation_after_a_deploy","test_deployer_unverified_worker_is_put_back_at_the_limit","test_deployer_refuses_a_deploy_over_an_unverified_one","test_deployer_starts_one_verify_run_per_deploy","test_deployer_opens_the_verify_page_while_static_has_it","test_deployer_a_put_back_names_the_verify_page_it_ran","test_deployer_drops_a_verdict_for_another_hash","test_deployer_pass_ends_probation","test_deployer_fail_puts_back_at_once","test_deployer_keeps_the_whole_result_of_a_test_run_in_a_file","test_deployer_a_failed_write_of_a_test_run_does_not_fail_the_deploy","test_deployer_makes_no_file_where_static_does_not_let_it","test_deployer_appends_each_deploy_line_to_the_topic","test_deployer_a_topic_that_fails_does_not_fail_the_deploy","test_deployer_no_verdict_changes_nothing","test_deployer_first_deploy_is_verified_with_nothing_to_put_back","test_deployer_a_module_with_no_tests_is_verified","test_deployer_a_dry_apply_runs_the_tests_and_deploys_nothing","test_deployer_a_held_deploy_runs_its_tests_before_it_asks_the_owner","test_deployer_an_apply_of_the_page_stores_the_shared_modules_in_it","test_deployer_a_change_of_the_shared_modules_waits_for_approval","test_deployer_a_dry_apply_answers_each_failed_test_whole","test_getModules_with_dry_answers_the_modules_of_that_run","test_deployer_recovery_key_deploys_over_an_unverified_worker","test_deployer_confirm_names_its_worker","test_kernel_probation","test_the_signing_key_is_not_made_anew_under_its_new_name","test_a_links_token_deploys_a_service_and_not_the_owners_four","test_a_token_with_a_list_deploys_and_removes_only_the_workers_of_the_list","test_a_link_made_to_deploy_with_no_approval_is_not_held","test_approval_holds_an_apply","test_a_change_says_why_and_the_reason_is_logged","test_a_change_names_the_hash_