+    const t = O.F.types.get(x.nid), o = O.F.types.get(x.object.nid);
+    if (t !== undefined && o !== undefined && owTopMut(t) && isNamed(o, "Mut")) owErr(W, x, "mut-field-assign", "an owned field of a group is made once, by mut(...) in the group's literal; it is not assigned or deleted");
+  }
+};
