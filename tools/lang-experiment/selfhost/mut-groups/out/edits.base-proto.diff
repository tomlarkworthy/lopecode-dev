+// Owned groups (proposal, selfhost/mut-groups): mut({ f: mut(fresh), ... }) bound to a local const owns the containers
+// its fields hold. A field of a Mut that is itself Mut stands only where a Mut name may stand; a group is not spread
+// or borrowed whole; an owned field is not assigned or deleted.
+
+// t is or holds a Mut, not looking into function types; memo by type object
+export const owHoldsMut = (isNamed) => {
+  function holds(R: IxRegCore, M: Mut<Map<Ty, boolean>>, t: Ty, depth: number): boolean {
+    const hit = M.get(t);
+    if (hit !== undefined) return hit;
+    if (depth > 8) return false;
+    const kids: Ty[] = t.k === "arr" ? [t.el] : t.k === "tup" ? t.els : t.k === "union" ? t.ts
+      : t.k === "rec" ? [...[...t.props.values()].map((p) => p.t), ...(t.index ? [t.index] : [])]
+      : t.k === "named" && !isNamed(t, "Mut") ? (R.isAlias(t.n) ? [R.expand(t)] : t.args) : [];
+    let r = isNamed(t, "Mut");
+    for (const k of kids) if (!r) r = holds(R, M, k, depth + 1);
+    M.set(t, r);
+    return r;
+  }
+  return holds;
+};
+// a group: a Mut whose first level holds a Mut
+export const owIsGroup = (owHoldsMut, unwrap, isNamed) => (R: IxRegCore, t: Ty): boolean => {
+  const M: Mut<Map<Ty, boolean>> = mut(new Map());
+  return isNamed(t, "Mut") && owHoldsMut(R, M, unwrap(t), 0);
+};
+// a Mut, or a union with a Mut member (an optional or nullable field)
+export const owTopMut = (isNamed) => (t: Ty): boolean => isNamed(t, "Mut") || (t.k === "union" && t.ts.some((m) => isNamed(m, "Mut")));
+// an assignment's target or delete's operand: owFieldAssign reports it
+export const owFieldWritten = () => (O: OwCtx, n: AstNode): boolean => {
+  const p = O.T.parent.get(n.nid);
+  if (p === undefined) return false;
+  return (p.type === "AssignmentExpression" && p.left.nid === n.nid) || (p.type === "UnaryExpression" && p.operator === "delete");
+};
+// a field of a Mut that is itself Mut, where a Mut name may stand (a computed key: a literal reads as the name, any other is a type error)
+export const owFieldPos = (owPosition, owFieldWritten) => (O: OwCtx, W: OwW, n: MemberExpression): string | null => {
+  if (owFieldWritten(O, n)) return null;
+  const pos = owPosition(O, W, n, "mut", null);
+  return pos === null ? null : `field ${n.property.type === "Identifier" ? n.property.name : "?"} of a group ${pos}`;
+};
+// a group as an argument: lent to a parameter declared as a group (a Mut<T> with T a type variable would see its
+// fields as T), frozen or compared; borrow and every other function (Object.values gives the fields back) would not
+export const owGroupArg = (owPrelude, owArgIndex, owDeclParam, owIsGroup) => (O: OwCtx, p: CallExpression | NewExpression, n: AstNode): string | null => {
+  const i = owArgIndex(p.arguments, n), pre = owPrelude(O, p);
+  if (i < 0 || pre === "freeze" || pre === "equals" || pre === "messageOf") return null;
+  const dp = pre === null ? owDeclParam(O, p, i, false) : undefined;
+  if (dp !== undefined && owIsGroup(O.R, dp)) return null;
+  return pre === "borrow" ? "borrowed whole: a reader could write its fields" : "passed where its fields could come back out";
+};
+// a group spread, or given to a function it may not be given to; keyed on the operand's type, so a group inside a
+// conditional, a logical or a chain is one too
+export const owGroupRef = (owIsGroup, owGroupArg) => (O: OwCtx, n: AstNode): string | null => {
