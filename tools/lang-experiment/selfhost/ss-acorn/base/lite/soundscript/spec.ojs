test_spec_S6_12_latestWins = {
  spec_is(spec_okCells(spec_s6_latestWins), "asked:ok,ask:ok,loaded:ok,arrived:ok,greeting:ok,store:ok,onArrived:ok");
  const asks = [];
  const fetch = (url) => new Promise((resolve, reject) => asks.push({ url, answer: (text) => resolve({ ok: true, status: 200, text: () => Promise.resolve(text) }), fail: () => reject(new Error("offline")) }));
  const L = await spec_load(spec_s6_latestWins, { ss_fetch: [[], () => fetch] });
  // every value greeting is read with, once per frame waited: a stored "second" would stay until "third" replaced it
  const seen = new Set();
  const greeting = async () => { const g = await L.value("greeting"); seen.add(g); return g; };
  const wait = async (what, f) => { if (!(await spec_frames(f))) throw new Error(`${what}: ${asks.length} fetches, greeting ${JSON.stringify(await greeting())}`); };
  try {
    await wait("the first fetch", () => asks.length === 1);
    asks[0].answer("hello");
    await wait("hello stored", async () => (await greeting()) === "hello");
    const ask = await L.value("ask");
    ask();
    await wait("the first ask's fetch", () => asks.length === 2);
    ask();
    // the answer to request 1 arrives after request 2 was made: delivered, and dropped by store
    asks[1].answer("second");
    await wait("the fetch for request 2", () => asks.length === 3);
    const kept = await greeting();
    asks[2].answer("third");
    await wait("third stored", async () => (await greeting()) === "third");
    spec_is([kept, [...seen].includes("second"), asks.map((a) => a.url.replace(/.*\?/, ""))], ["hello", false, ["n=0", "n=1", "n=2"]]);
    return `the answer to request 1 arrived after request 2 was made; when request 2 was fetched greeting was still "hello", and the answer to request 2 was stored`;
  } finally { asks.forEach((a) => a.answer("")); L.dispose(); }
}
