test_spec_S6_14 = {
  const E = await spec_editor([
    "const a = (): StateCell<number> => state(0);",
    "const b = (): StateCell<number> => state(0);",
    "const load = (a: State<number>, b: State<number>) => action((v: number) => {\n  a.set(1);\n  b.set(read(a) + v);\n  a.update((x) => x + 1);\n});",
