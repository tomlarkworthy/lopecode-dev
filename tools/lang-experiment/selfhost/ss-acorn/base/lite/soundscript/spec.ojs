test_spec_S6_12 = {
  spec_is(spec_okCells(spec_s6_fetchThenStore), "asked:ok,ask:ok,loaded:ok,arrived:ok,greeting:ok,store:ok,onArrived:ok");
  // the example, run with a fetch whose answers the test releases one at a time
  const asks = [];
  const fetch = (url) => new Promise((resolve, reject) => asks.push({ url, answer: (text) => resolve({ ok: true, status: 200, text: () => Promise.resolve(text) }), fail: () => reject(new Error("offline")) }));
  const L = await spec_load(spec_s6_fetchThenStore, { ss_fetch: [[], () => fetch] });
  const greeting = () => L.value("greeting");
  const wait = async (what, f) => { if (!(await spec_frames(f))) throw new Error(`${what}: ${asks.length} fetches, greeting ${JSON.stringify(await greeting())}`); };
  try {
    await wait("the first fetch", () => asks.length === 1);
    asks[0].answer("hello");
    await wait("hello stored", async () => (await greeting()) === "hello");
    // two asks while a fetch is pending: the pending answer is delivered and stored, then one more fetch is made
    const ask = await L.value("ask");
    ask();
    await wait("the first ask's fetch", () => asks.length === 2);
    ask();
    asks[1].answer("second");
    await wait("the pending answer stored", async () => (await greeting()) === "second");
    await wait("the fetch after it", () => asks.length === 3);
    asks[2].answer("third");
    await wait("third stored", async () => (await greeting()) === "third");
    const handle = await L.value("arrived");
    // a failed fetch stores nothing; the next ask fetches and stores again, with one listener
    ask();
    await wait("the third ask's fetch", () => asks.length === 4);
    asks[3].fail();
    const failed = await L.value("loaded").then(() => false, () => true);
    const afterFail = await greeting();
    ask();
    await wait("the fourth ask's fetch", () => asks.length === 5);
    asks[4].answer("fourth");
    await wait("fourth stored", async () => (await greeting()) === "fourth");
    const handle2 = await L.value("arrived");
    spec_is([failed, afterFail, soundscript.running([handle, handle2])], [true, "third", 1]);
    return `fetch then store in dataflow: ask, then loaded waits, arrived yields, store writes; two asks made while a fetch was pending: its answer "second" was stored, then one more fetch was made, and "third" stored; a failed fetch stored nothing, and the next ask stored "fourth" with one listener`;
  } finally { asks.forEach((a) => a.answer("")); L.dispose(); }
}
