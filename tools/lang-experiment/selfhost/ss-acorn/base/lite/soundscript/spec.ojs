  { statement: "S4.6", rule: "mut-after-freeze", source: "const a = () => {\n  const out = mut([0]);\n  const f = () => {\n    out[0] = 1;\n  };\n  const r = freeze(out);\n  f();\n  return r;\n};" },
  { statement: "S4.7", rule: "mut-deep-write", source: "const a = () => {\n  const m = mut({ a: { b: 1 }, xs: [1] });\n  m.a.b = 2;\n  m.xs.push(2);\n  return freeze(m);\n};" },
  { statement: "S4.8", rule: "mut-view", source: "const a = () => {\n  const t = mut(new Float32Array(4));\n  const v = t.subarray(0, 2);\n  return freeze(t);\n};" },
  { statement: "S4.8", rule: "mut-view", source: "const a = () => {\n  const m = mut(new Map<string, number>());\n  const set = (k: string) => m.set(k, 1);\n  set(\"a\");\n  return freeze(m).size;\n};" },
  { statement: "S4.9", rule: "mut-freeze-param", source: "const a = () => {\n  const g = (m: Mut<number[]>) => freeze(m);\n  return 1;\n};" }
]
// %%
spec_rejects_4_view = spec_rejectsTable(spec_rejects_4)
// %%
test_spec_S4_1 = {
  spec_is(spec_okCells("const a = () => {\n  const t = mut(new Float32Array(3));\n  t.fill(0);\n  t[1] = 2;\n  t[2] += 1;\n  t[0]++;\n  const m = mut(new Map<string, number>());\n  m.set(\"a\", 1);\n  m.delete(\"a\");\n  const o = mut({ a: 1, b: 2 });\n  delete o.a;\n  const xs = mut([3, 1]);\n  xs.push(2);\n  xs.sort((p, q) => p - q);\n  const r: number[] = freeze(xs);\n  return [freeze(t), freeze(m).size, freeze(o), r];\n};"), "a:ok");
  const blur = Array.from(await spec_module.value("s4_blur"), (v) => Math.round(v * 1e6) / 1e6);
  spec_is(blur, [0, 1, 1, 1, 0]);
  spec_is(await spec_module.value("s4_record"), { b: 3 });
  return `writes, mutating methods and delete on a Mut are accepted; s4_blur is ${JSON.stringify(blur)}, s4_record {"b":3}`;
}
