// %%
md`## 7. Events and listeners

An events cell is a generator whose values are delivered one at a time. A listener is a cell that ties an events cell to an action.`
// %%
md`**S7.1** An input \`t: Events<T>\` gets a handle to the sync generator cell \`t\` yielding \`T\`, not its values, and is not a dependency on them. \`Events<T>\` on a cell that is not a sync generator yielding \`T\`, an async generator included, is \`[inject-events]\`. Once a cell takes \`t\` as \`Events\`, an input that reads \`t\` without \`Events\` is \`[inject-events]\`.`
// %%
md`**S7.2** \`on(t, a)\` has type \`Listener\`. \`a\` must be an \`Action\` that accepts what \`t\` yields; otherwise it is \`[type]\`.`
// %%
md`**S7.3** A \`Listener\` is only the whole value of a sync, non-generator cell: what it returns, or a branch of a conditional it returns when every branch is one. In an array, a record or a state cell, as an argument, in a nested function, in a union with another type, in an async or generator cell, and as the input of another cell, it is \`[listener-placement]\`.`
// %%
md`**S7.4** While a listener is the value of its cell, its action runs once for each value the events cell yields, in order. The listener ends when its cell is deleted or rejected, when its module's variables are deleted, or when its cell runs again with other events or another action; a run with the same events and the same action keeps it. A listener cell that runs again, for any reason, leaves one listener, and no value is lost or delivered twice, whichever of that run, a commit and the value comes first.`
// %%
md`**S7.5** Starting and stopping events is dataflow: the events cell takes inputs and yields nothing when it should not run. When an input changes (\`Object.is\`, as in S6.2), the events cell runs again from its start and keeps its handle; run again with the same inputs it keeps its generator. An events cell writes nothing (S6.5).`
// %%
md`**S7.6** When a listener's action throws, that call keeps none of its writes (S6.10), the next value is still delivered, and the console reports the error naming the listener, the action and the events cell.`
// %%
md`**S7.7** Two listener cells on one events cell get each value in the order the cells appear in their module. An edit of the first does not change that.`
// %%
md`**S7.8** An \`Events<T>\` and a \`Listener\` have no members. Reading one, by a member, \`?.\`, an index or a destructuring pattern, is \`[type]\`. A \`Listener\` is only the whole value of a cell (S7.3), so a member read on one is also \`[listener-placement]\`.`
// %%
md`The cells of this section. \`s7_onBeat\` runs \`s7_add\` for each of the three values \`s7_beats\` yields, so \`s7_seen\` becomes \`[1, 2, 3]\`.`
// %%
//ss: ./spec-7.ts
// %%
spec_rejects_7 = [
  { statement: "S7.1", rule: "inject-events", source: "const ticks = async function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = (ticks: Events<number>, tick: Action<[number]>) => on(ticks, tick);" },
  { statement: "S7.1", rule: "inject-events", source: "const ticks = () => 1;\nconst on1 = (ticks: Events<number>) => 1;" },
  { statement: "S7.1", rule: "inject-events", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = (ticks: Events<number>, tick: Action<[number]>) => on(ticks, tick);\nconst reader = (ticks: number) => ticks;" },
  { statement: "S7.2", rule: "type", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((s: string) => {});\nconst on1 = (ticks: Events<number>, tick: Action<[string]>) => on(ticks, tick);" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = (ticks: Events<number>, tick: Action<[number]>) => [on(ticks, tick)];" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst on1 = (ticks: Events<number>) => () => on(ticks, action((n: number) => {}));" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = (ticks: Events<number>, tick: Action<[number]>) => ({ l: on(ticks, tick) });" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = (ticks: Events<number>, tick: Action<[number]>) => state(on(ticks, tick));" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst g = () => (x: unknown) => 1;\nconst on1 = (ticks: Events<number>, tick: Action<[number]>, g: (x: unknown) => number) => g(on(ticks, tick));" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst flag = () => true;\nconst on1 = (ticks: Events<number>, tick: Action<[number]>, flag: boolean) => (flag ? on(ticks, tick) : null);" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = async (ticks: Events<number>, tick: Action<[number]>) => on(ticks, tick);" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = function* (ticks: Events<number>, tick: Action<[number]>) {\n  yield on(ticks, tick);\n};" },
  { statement: "S7.3", rule: "listener-placement", source: "const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = (ticks: Events<number>, tick: Action<[number]>) => on(ticks, tick);\nconst x = (on1) => 1;" },
  { statement: "S7.8", rule: "type", source: "const ticks = function* () {\n  yield 1;\n};\nconst n = (ticks: Events<number>) => ticks.events;" },
  { statement: "S7.8", rule: "type", source: "const ticks = function* () {\n  yield 1;\n};\nconst n = (ticks: Events<number>) => {\n  const { events } = ticks;\n  return events;\n};" }
]
// %%
spec_rejects_7_view = spec_rejectsTable(spec_rejects_7)
// %%
spec_stream = (n, { throwEvery = 0 } = {}) => [
  // the cells of a module whose listener records each value of nums: count, last, gaps (a value that is
  // not the last plus one) and sum; toggle stops and starts nums; throwEvery makes every k-th call throw
  "type S = { readonly count: number; readonly last: number; readonly gaps: number; readonly sum: number };",
  "const seen = (): StateCell<S> => state<S>({ count: 0, last: 0, gaps: 0, sum: 0 });",
  "const running = (): StateCell<boolean> => state(true);",
  `const nums = function* (running: boolean) {\n  if (!running) return;\n  for (let i = 1; i <= ${n}; i++) yield i;\n};`,
  "const weight = () => (v: number) => v;",
  throwEvery
    ? `const record = (seen: State<S>, weight: (v: number) => number) =>\n  action((v: number) => {\n    seen.update((s) => ({ count: s.count + 1, last: v, gaps: s.gaps + (v === s.last + 1 ? 0 : 1), sum: s.sum + weight(v) }));\n    if (v % ${throwEvery} === 0) throw new Error(\`no \${v}\`);\n  });`
    : "const record = (seen: State<S>, weight: (v: number) => number) =>\n  action((v: number) => seen.update((s) => ({ count: s.count + 1, last: v, gaps: s.gaps + (v === s.last + 1 ? 0 : 1), sum: s.sum + weight(v) })));",
  "const onNum = (nums: Events<number>, record: Action<[number]>) => on(nums, record);",
  "const toggle = (running: State<boolean>) => action(() => running.update((r) => !r));"
]
// %%
test_spec_S7_1 = {
  spec_is(spec_okCells("const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst on1 = (ticks: Events<number>, tick: Action<[number]>) => on(ticks, tick);\nconst s = (): StateCell<number> => state(0);\nconst t = (s: State<number>, ticks: Events<number>) => action(() => s.set(1));"), "ticks:ok,tick:ok,on1:ok,s:ok,t:ok");
  return `${spec_rejectsFor("S7.1")}; a handle may also be taken by a cell that is not a listener`;
}
// %%
test_spec_S7_2 = spec_rejectsFor("S7.2")
// %%
test_spec_S7_3 = {
  spec_is(spec_okCells("const ticks = function* () {\n  yield 1;\n};\nconst tick = () => action((n: number) => {});\nconst flag = () => true;\nconst on1 = (ticks: Events<number>, tick: Action<[number]>, flag: boolean) => (flag ? on(ticks, tick) : on(ticks, tick));"), "ticks:ok,tick:ok,flag:ok,on1:ok");
  if (!(await spec_frames(async () => JSON.stringify(await spec_module.value("s7_seen")) === "[1,2,3]"))) throw new Error(`s7_seen is ${JSON.stringify(await spec_module.value("s7_seen"))}`);
  return `${spec_rejectsFor("S7.3")}; a conditional of two listeners is accepted; s7_seen is [1,2,3]`;
}
// %%
test_spec_S7_4 = {
  const A = await spec_editor(spec_stream(60));
  try {
    if (!(await spec_frames(async () => (await A.value("seen")).count >= 60))) throw new Error(`seen ${JSON.stringify(await A.value("seen"))}`);
    for (let i = 0; i < 10; i++) await new Promise((r) => requestAnimationFrame(r));
    await spec_flush();
    spec_is(await A.value("seen"), { count: 60, last: 60, gaps: 0, sum: 1830 });
  } finally { A.dispose(); }
  // a long stream: the listener edited, its action's input edited, an input of nums run again with the same
  // value (nums keeps its generator and handle, and onNum runs again on equal inputs), then the listener deleted
  const long = spec_stream(1000000).flatMap((t) => soundscript.declaredName(t) !== "nums" ? [t] : ["const limit = () => 1000000;", "const nums = function* (running: boolean, limit: number) {\n  if (!running) return;\n  for (let i = 1; i <= limit; i++) yield i;\n};"]);
  const B = await spec_editor(long);
  try {
    const count = async () => (await B.value("seen")).count;
    const exact = async () => { const s = await B.value("seen"); if (s.gaps !== 0 || s.count !== s.last) throw new Error(`a value lost or doubled: ${JSON.stringify(s)}`); return s.count; };
    await spec_frames(async () => (await count()) >= 10);
    await B.edit("onNum", "const onNum = (nums: Events<number>, record: Action<[number]>) => /* again */ on(nums, record);");
    const at1 = await count();
    await spec_frames(async () => (await count()) >= at1 + 10);
    await exact();
    await B.edit("weight", "const weight = () => (v: number) => v * 1;");
    const at2 = await count();
    await spec_frames(async () => (await count()) >= at2 + 10);
    await exact();
    const handle = await B.value("nums"), onNum0 = await B.evals("onNum");
    await B.edit("limit", "const limit = () => /* again */ 1000000;");
    const at3 = await count();
    await spec_frames(async () => (await count()) >= at3 + 10);
    const n = await exact();
    const again = (await B.evals("onNum")) - onNum0;
    spec_is([again > 0, (await B.value("nums")) === handle, soundscript.running([handle])], [true, true, 1]);
    B.variable("onNum").delete();
    // the deletion reaches the listener through onCodeChange, at a later runtime compute; until then it is pulled
    if (!(await spec_frames(async () => soundscript.running([handle]) === 0))) throw new Error("onNum deleted, its listener still attached");
    await spec_flush();
    const stopped = await count();
    for (let i = 0; i < 10; i++) await new Promise((r) => requestAnimationFrame(r));
    spec_is(await count(), stopped);
    return `60 values, each once in order; after three edits (the last ran onNum again ${again} times on equal inputs) ${n} values with none lost or delivered twice, one listener; deleted, it delivers nothing`;
  } finally { B.dispose(); }
}
// %%
test_spec_S7_5 = {
  const E = await spec_editor(spec_stream(1000000));
  try {
    const seen = () => E.value("seen");
    await spec_frames(async () => (await seen()).count >= 10);
    const listener = await E.evals("onNum"), events = await E.evals("nums"), handle = await E.value("nums");
    const toggle = await E.value("toggle");
    toggle();
    await spec_flush();
    const c1 = (await seen()).count;
    for (let i = 0; i < 10; i++) await new Promise((r) => requestAnimationFrame(r));
    spec_is((await seen()).count, c1);
    toggle();
    await spec_flush();
    if (!(await spec_frames(async () => (await seen()).count >= c1 + 10))) throw new Error("did not start again");
    const s = await seen();
    // started again from 1: one gap, where the values went back to 1
    spec_is(s.gaps, 1);
    spec_is([(await E.evals("nums")) - events, (await E.value("nums")) === handle], [2, true]);
    return `stopped at ${c1}; started again from 1; nums ran twice more and kept its handle (onNum ran ${(await E.evals("onNum")) - listener} more times)`;
  } finally { E.dispose(); }
}
