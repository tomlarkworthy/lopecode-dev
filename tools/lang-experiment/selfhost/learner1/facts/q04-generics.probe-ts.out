literal-inference-generic-fn-cell (.ts): REJECT a:rejected[type]
    a[type] 0 is not assignable to 3 | 4
generic-fn-cell-no-comma (.ts): REJECT a:rejected[type]
    a[type] 0 is not assignable to 3 | 4
literal-inference-untyped-param (.ts): REJECT a:rejected[type]
    a[type] "y" is not assignable to "x"
reject-generic-inferred-wrong-use (.ts): REJECT a:rejected[type][type]
    a[type] "y" is not assignable to "x" || a[type] string used as a number
reject-as-in-generic-alias-use (.ts): REJECT s:rejected[no-cast]
    s[no-cast] as cast
accept-generic-alias-annotated-empty (.ts): ACCEPT
explicit-type-argument (.ts): ACCEPT
extends-bound (.ts): REJECT eqKey:rejected[strict-eq-object] s:blocked
    eqKey[strict-eq-object] === on two non-primitive operands; use equals(a, b) || eqKey{unsupported type parameter constraint/default}
strict-eq-on-type-param (.ts): REJECT same:rejected[strict-eq-object]
    same[strict-eq-object] === on two non-primitive operands; use equals(a, b)
eq-undefined-on-type-param (.ts): ACCEPT
accept-groupBy-inferred (.ts): ACCEPT
generic-function-declaration-cell (.ts): ACCEPT
generic-local-helper (.ts): ACCEPT
accept-generic-fn-cell-explicit-arg (.ts): ACCEPT
accept-generic-fn-cell-typed-arg (.ts): ACCEPT
accept-generic-alias-push (.ts): ACCEPT
