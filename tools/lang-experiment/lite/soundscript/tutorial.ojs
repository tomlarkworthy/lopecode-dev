//ss: 08-reject-jsx.tsx -bad_free_component
// %%
md`\`bad_free_component\` uses a component that does not exist. As a live cell it would name a variable the module does not define, so it is checked on its own:`
// %%
viewof src_free_component = sourceBox(examples.rejectJsx.split("\n").find((l) => l.includes("bad_free_component")))
// %%
checkBox(src_free_component, { tsx: true })
