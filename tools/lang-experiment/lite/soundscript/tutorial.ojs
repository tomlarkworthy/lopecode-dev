style = htl.html`<style>
.lite-panel { border-collapse: collapse; font-size: 13px; width: 100%; max-width: 100%; }
.lite-panel th { text-align: left; color: var(--theme-foreground-muted); font-weight: 600; }
.lite-panel td, .lite-panel th { padding: 2px 8px 2px 0; vertical-align: top; border-bottom: 1px solid var(--theme-foreground-faintest); }
.lite-panel td.v { font-family: var(--monospace, monospace); word-break: break-all; }
.lite-panel tr.lite-rejected td:nth-child(2), .lite-err b { color: var(--theme-error, #c33); }
.lite-panel tr.lite-unsupported td:nth-child(2), .lite-panel tr.lite-blocked td:nth-child(2) { color: var(--theme-foreground-muted); }
.lite-panel tr.lite-err td { border-bottom: none; color: var(--theme-foreground-muted); font-size: 12px; }
.lite-summary, .lite-readout { font-size: 13px; margin: 6px 0; color: var(--theme-foreground-muted); }
.lite-readout { font-family: var(--monospace, monospace); color: var(--theme-foreground); }
.lite-app { padding: 8px; margin: 6px 0; border: 1px solid var(--theme-foreground-faint); border-radius: 4px; background: var(--theme-background-alt); }
.lite-mandel { display: block; max-width: 100%; margin: 6px 0; }
.lite-vars { margin-top: 10px; }
.lite-app input[type=range] { vertical-align: middle; margin-left: 6px; }
.lite-src { font-size: 12px; max-height: 320px; overflow: auto; background: var(--theme-background-alt); padding: 6px; }
.lite-box textarea { font-size: 12px; }
</style>`
// %%
viewof tutorial_module = thisModule()
// %%
liveTable = (values) => {
  // the cells as inputs, so the table follows them
  const { result } = ss_check(tutorial_module);
  const shown = { ...Object.fromEntries(Object.entries(values).map(([k, v]) => [k, fmt(v)])) };
  const body = htl.html`<tbody>`;
  for (const name of Object.keys(shown)) {
    const c = result.cells.find((x) => x.name === name);
    body.append(htl.html`<tr class=${"lite-" + (c?.status ?? "blocked")}><td><code>${name}</code></td><td>${c?.status ?? "not a SoundScript cell"}</td><td><code>${c?.value ?? ""}</code></td><td class="v">${shown[name]}</td></tr>`);
    const problems = c ? [...c.errors, ...c.unsupported.map((u) => ({ ...u, rule: "unsupported" }))] : [];
    for (const e of problems) body.append(htl.html`<tr class="lite-err"><td></td><td colspan="3"><b>[${e.rule}]</b> ${e.msg}</td></tr>`);
  }
  return htl.html`<table class="lite-panel"><thead><tr><th>cell</th><th>check</th><th>type</th><th>value</th></tr></thead>${body}</table>`;
}
// %%
test_ss_roundtrip = {
  tests_on;
  const n = ss_roundtrip(tutorial_module);
  if (n < 33) throw new Error(`only ${n} SoundScript variables found`);
  return `${n} variables recompile to the same text and inputs`;
}
// %%
test_ss_module_checks = {
  tests_on;
  const { result } = ss_check(tutorial_module);
  const got = Object.fromEntries(result.cells.map((c) => [c.name, c.status]));
  const want = { width: "ok", height: "ok", area: "ok", aspect: "ok", scale: "ok", half: "ok", test_half: "ok", samples: "ok", histogram: "ok", leak: "rejected", late: "rejected", count: "ok", increment: "ok", clear: "ok", app: "ok", n: "ok", inc: "ok", setN: "ok", Badge: "ok", NotElem: "ok", bad_attr_type: "rejected", bad_unknown_attr: "rejected", bad_unknown_element: "rejected", bad_handler_not_action: "rejected", bad_handler_wrong_args: "rejected", bad_component_props: "rejected", bad_component_missing_prop: "rejected", bad_component_not_elem: "rejected", bad_mut_in_jsx: "rejected", bad_child_object: "rejected", ok_all: "ok" };
  if (JSON.stringify(got) !== JSON.stringify(want)) throw new Error(`verdicts ${JSON.stringify(got)}`);
  if (result.module.length) throw new Error(`module errors ${JSON.stringify(result.module)}`);
  return `${result.cells.length} cells: leak, late and the ten bad_* rejected, the rest ok`;
}
