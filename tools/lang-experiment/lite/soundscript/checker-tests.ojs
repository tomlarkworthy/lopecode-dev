// %%
test_checker_roundtrip = {
  const ss = soundscript;
  const source = [
    "const width = () => 3;",
    "// a comment kept with its cell\nconst area = (width: number): number => width * width;",
    "const count = (): StateCell<number> => state(0);",
    "const increment = (count: State<number>) => action(() => count.update((c) => c + 1));",
  ].join("\n\n");
  const result = ss.checkSources({ cells: source, tsx: true });
  const notOk = result.cells.filter((c) => c.status !== "ok" || c.errors.length);
  if (notOk.length) throw new Error(`does not check: ${notOk.map((c) => `${c.name} ${c.status} ${JSON.stringify(c.errors)}`).join("; ")}`);
  const ctx = ss.contextFromCheck(result, source, true);
  const texts = ss.splitCells(source, true);
  const variables = texts.map((t) => ss.compileCell(t, true, ctx));
  const back = variables.map((vs) => vs.map((v) => ss.decompileVariable(v.definition)).filter((x) => x !== null));
  const lost = texts.filter((t, i) => back[i].length !== 1 || back[i][0] !== t);
  if (lost.length) throw new Error(`not recovered exactly: ${lost.join(" | ")}`);
  // run the plain cells, each with the values of the cells it takes
  const values = {};
  for (const v of variables.flat().filter((v) => ["width", "area"].includes(v.name))) values[v.name] = new Function(`return (${v.definition});`)()(...v.inputs.map((n) => values[n]));
  if (values.area !== 9) throw new Error(`area is ${values.area}, expected 9`);
  return `${texts.length} cells checked, compiled and recovered; area ${values.area}`;
}
// %%
test_checker_on_as_a_property_is_not_a_listener = {
  const ss = soundscript;
  const source = "const cfg = () => ({ on: true, n: 1 });\n\nconst use = (cfg: { readonly on: boolean; readonly n: number }) => cfg.n + 1;";
  const result = ss.checkSources({ cells: source, tsx: true });
  if (result.cells.some((c) => c.status !== "ok")) throw new Error(JSON.stringify(result.cells.map((c) => [c.name, c.status])));
  const ctx = ss.contextFromCheck(result, source, true);
  const [cfg, use] = ss.splitCells(source, true).map((t) => ss.compileCell(t, true, ctx)[0]);
  // both are plain cells: the function applied to its inputs, with no ss
  const run = (v, ...args) => new Function(`return (${v.definition});`)()(...args);
  const value = run(cfg);
  const n = run(use, value);
  const kinds = [cfg, use].map((v) => ss.compiledKind(v.definition)?.callee);
  if (value?.on !== true || n !== 2 || kinds.some((k) => k !== "plain")) throw new Error(`cfg ${JSON.stringify(value)}, use ${n}, compiled as ${kinds}`);
  return n;
}
// %%
test_checker_action_capture_by_binding = {
  // S6.9 by binding: a let, a loop binding, a Mut, a parameter of an enclosing function and what is computed from them, against consts and functions made from inputs with no state
  const cases = [["const s = () => state(0);\nconst c = (now: Clock, s: State<number>) => { let q = () => 1; q = now; return action(() => s.set(q())); };",["action-capture"]],
    ["const s = () => state(0);\nconst c = (now: Clock, s: State<number>) => { for (const q of [now]) return action(() => s.set(q())); return action(() => s.set(0)); };",["action-capture"]],
    ["const s = () => state(0);\nconst mk = (s: State<number>) => (h: () => number) => action(() => s.set(h()));\nconst c = (now: Clock, mk: (h: () => number) => Action<[]>) => mk(now);",["action-capture"]],
    ["const s = () => state(0);\nconst c = (now: Clock, s: State<number>) => { const mk = (h: () => number = now) => action(() => s.set(h())); return mk(); };",["action-capture"]],
    ["const s = () => state(0);\nconst c = (random: Random, s: State<number>) => [random].map((h) => action(() => s.set(h())));",["action-capture"]],
    ["const s = () => state(0);\nconst c = (now: Clock, s: State<number>) => { const m = mut(new Map<string, () => number>()); m.set(\"k\", now); const f = m.get(\"k\") ?? (() => 0); return action(() => s.set(f())); };",["action-capture"]],
    ["const s = () => state(0);\nconst c = (now: Clock, s: State<number>) => { function f(h: () => number = now): () => number { return h; } const q = f(); return action(() => s.set(q())); };",["action-capture"]],
    ["const s = () => state(0);\nconst c = (now: Clock, s: State<number>) => action(() => { { const now = 1; s.set(now); } s.set(now()); });",["action-capture"]],
    ["const s = () => state(0);\nconst mk = (s: State<number>) => (f: () => number) => { const q = f(); return action(() => s.set(q)); };",["action-capture"]],
    ["const s = () => state(0);\nconst c = (now: Clock, s: State<number>) => { let z = 0; z = now(); function f(n: number): number { return n <= 0 ? z : g(n - 1); } function g(n: number): number { return f(n); } return action(() => s.set(g(1))); };",["action-capture"]],
    ["const k = () => 3;\nconst s = () => state(0);\nconst c = (k: number, s: State<number>) => { const j = k + 1; const g = (x: number) => x + j; return action(() => s.set(g(1))); };",[]],
    ["const s = () => state(0);\nconst c = (s: State<number>) => { for (const k of [1, 2]) return action(() => s.set(k)); return action(() => s.set(0)); };",[]],
    ["const s = () => state(0);\nconst c = (s: State<number>) => { const f = (n: number): number => (n <= 0 ? 0 : f(n - 1)); return action(() => s.set(f(3))); };",[]],
    ["const s = () => state(0);\nconst c = (s: State<number>) => action((k: number) => { const g = () => s.set(k); g(); });",[]],
    ["const s = () => state(0);\nconst c = (log: Log, s: State<number>) => action(() => { log(1); s.set(1); });",[]]];
  const bad = [];
  for (const [source, want] of cases) {
    const r = soundscript.checkSources({ cells: source, tsx: true });
    const got = [...new Set([...r.module, ...r.cells.flatMap((c) => c.errors)].map((e) => e.rule))].sort();
    if (JSON.stringify(got) !== JSON.stringify(want)) bad.push(`${JSON.stringify(source)} gave ${JSON.stringify(got)}, expected ${JSON.stringify(want)}`);
  }
  if (bad.length) throw new Error(bad.join("; "));
  return `${cases.length} sources give the expected rules`;
}
// %%
test_checker_iterator_rules = {
  // S3.19: what may hold an iterator is not captured or a cell's value; arrays, strings, Maps, a function returning an iterator, a copy and unknown are
  const cases = [["const y = () => { const it = new Set([1]).keys(); return () => [...it].length; };",["iterator-capture"]],
    ["const y = () => { const its = [[1].values()]; return () => its.length; };",["iterator-capture"]],
    ["interface Box { readonly it: Iterable<number> }\nconst y = () => { const b: Box = { it: [1].values() }; return () => [...b.it].length; };",["iterator-capture"]],
    ["const y = () => { const it = new Float64Array(2).values(); return () => [...it].length; };",["iterator-capture"]],
    ["const y = () => { const gen = function* () { yield 1; }; const it = gen(); return () => it; };",["iterator-capture"]],
    ["const s = () => state(0);\nconst c = (s: State<number>) => { const it = [1, 2].values(); return action(() => s.set([...it].length)); };",["iterator-capture"]],
    ["const a = async () => [1].values();",["iterator-cell"]],
    ["const g = () => { const gen = function* () { yield 1; }; return gen(); };",["iterator-cell"]],
    ["const xs = (): Iterable<number> => [1, 2];",["iterator-cell"]],
    ["const y = () => { const xs = [1, 2]; const s = \"ab\"; const m = new Map([[\"a\", [1]]]); return () => [...xs].length + [...s].length + m.size; };",[]],
    ["const f = () => (xs: readonly number[]) => xs.values();\nconst a = (f: (xs: readonly number[]) => Iterable<number>) => [...f([1])].length;",[]],
    ["const y = () => { const it = [1, 2].values(); const xs = [...it]; return () => xs.length; };",[]],
    ["const y = () => { const u: unknown = [1].values(); return () => u; };",[]]];
  const bad = [];
  for (const [source, want] of cases) {
    const r = soundscript.checkSources({ cells: source, tsx: true });
    const got = [...new Set([...r.module, ...r.cells.flatMap((c) => c.errors)].map((e) => e.rule))].sort();
    if (JSON.stringify(got) !== JSON.stringify(want)) bad.push(`${JSON.stringify(source)} gave ${JSON.stringify(got)}, expected ${JSON.stringify(want)}`);
  }
  if (bad.length) throw new Error(bad.join("; "));
  return `${cases.length} sources give the expected rules`;
}
