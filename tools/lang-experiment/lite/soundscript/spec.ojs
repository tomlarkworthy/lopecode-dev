test_spec_S6_13 = {
  const L = await spec_load(`const x = (): StateCell<number> => state(0);
const slow = (x: State<number>) => action(async (p: Promise<number>) => { const v = await p; x.update((c) => c * 10 + v); });
const tag = (x: State<number>) => action((k: number) => x.update((c) => c * 10 + k));`, {});
  const g = spec_gate();
  try {
    const [slow, tag] = [await L.value("slow"), await L.value("tag")];
    const order = [];
    const q = await spec_act(() => {
      soundscript.entry(null, () => { slow(g.p); order.push("slow called"); });
      order.push("after slow");
      soundscript.entry(null, () => tag(1));
      soundscript.entry(null, () => tag(2));
      return soundscript.actionQueue();
    });
    spec_is([q, order], [{ inFlight: true, waiting: 2 }, ["slow called", "after slow"]]);
    g.open(3);
    await spec_act(() => {});
    await spec_flush();
    spec_is(await L.value("x"), 312);
    return "slow started at once; tag(1) and tag(2) waited and ran after it, in call order (x is 312)";
  } finally { g.open(0); L.dispose(); }
}
