md`# SoundScript specification

PROSE PENDING`
// %%
md`PROSE PENDING (how to read this page: statement numbers, tests named after statements, the coverage table)`
// %%
spec_coverage_view = {
  const rows = spec_coverage.rows.map((r) => r.statements === 0
    ? htl.html`<tr><td>${r.section}</td><td>${r.title}</td><td colspan="4">no statements yet</td></tr>`
    : htl.html`<tr><td>${r.section}</td><td>${r.title}</td><td>${r.statements}</td><td>${r.tested}</td><td>${r.passing}/${r.tests}</td><td>${r.untested.join(", ")}</td></tr>`);
  const unknown = spec_coverage.unknown.length ? htl.html`<p>Tests naming a statement that does not exist: ${spec_coverage.unknown.join(", ")}</p>` : "";
  return htl.html`<table><thead><tr><th>§</th><th>section</th><th>statements</th><th>with a test</th><th>tests passing</th><th>statements with no test</th></tr></thead><tbody>${rows}</tbody></table>${unknown}`;
}
// %%
md`## 1. Cells and the top level

PROSE PENDING`
// %%
md`**S1.1** A cell is a top-level \`function\`, \`function*\`, \`async function\` or \`async function*\` declaration, or one declarator of a top-level \`const\` or \`let\` whose initializer is an arrow or function expression. The declared name is the cell's name.`
// %%
md`**S1.2** \`export\` before a cell or a type declaration is accepted and changes nothing.`
// %%
md`**S1.3** The top level may also hold \`type\` and \`interface\` declarations and \`import type\`. They are not cells.`
// %%
md`**S1.4** Any other top-level statement is \`[module-level]\`, except \`var\`, \`class\`, \`enum\` and \`namespace\`, which are \`[no-var]\`, \`[no-class]\`, \`[no-enum]\` and \`[no-namespace]\` (section 3).`
// %%
md`**S1.5** A top-level \`const\` or \`let\` that is not a function is \`[cell-not-function]\`. That includes a declaration with no initializer and one that destructures.`
// %%
md`**S1.6** A name declared by more than one cell belongs to the first. Each later cell with that name is \`[duplicate-cell]\` ("a is already defined at line 1") and is reported as \`a (2)\`, \`a (3)\` and so on. The first is checked as usual, and a cell that takes the name reads the first. In a notebook module, an edit that gives a cell the name of another cell is stored under \`a (2)\` and does not run.`
// %%
md`**S1.7** A cell with the name of a shell cell is \`[duplicate-cell]\`. A shell cell is an unchecked cell the checker is given beside the checked ones (section 9); a notebook module gives it none.`
// %%
md`**S1.8** One \`const\` or \`let\` statement may declare several cells: \`const a = () => 1, b = () => 2;\` is two cells.`
// %%
md`The cells of this section, written in SoundScript. \`s1_exported\` keeps its \`export\` (S1.2), and the editor marks it "export is not needed".`
// %%
//ss: ./spec.ts
// %%
md`Rejected sources. Each is checked when the page loads; the fourth column is what the checker reports and the last whether that is the rule given.`
// %%
spec_rejects_1 = [
  { statement: "S1.4", rule: "module-level", source: "for (;;) {}\nlet a = () => 1;" },
  { statement: "S1.4", rule: "module-level", source: "1 + 1;" },
  { statement: "S1.5", rule: "cell-not-function", source: "let a = () => 1;\nlet x = 42;" },
  { statement: "S1.5", rule: "cell-not-function", source: "let x;" },
  { statement: "S1.5", rule: "cell-not-function", source: "const { a } = { a: () => 1 };" },
  { statement: "S1.6", rule: "duplicate-cell", source: "const a = () => 1;\nconst a = () => 2;" },
  { statement: "S1.7", rule: "duplicate-cell", source: "let a = () => 1;", shell: "export let a = () => 2;" }
]
// %%
spec_rejects_1_view = spec_rejectsTable(spec_rejects_1)
// %%
spec_rejects = [...spec_rejects_1, ...spec_rejects_2, ...spec_rejects_3, ...spec_rejects_4, ...spec_rejects_5, ...spec_rejects_11]
// %%
spec_rulesOf = (c) => {
  // the rule ids the checker reports for a reject case, sorted and without repeats. outside: the cells in
  // other languages the case's module has (section 11)
  const r = ss.checkSources({ cells: c.source, shell: c.shell, tsx: true, outside: c.outside });
  return [...new Set([...r.module, ...r.cells.flatMap((x) => x.errors)].map((e) => e.rule))].sort();
}
// %%
spec_rejectsTable = (cases) => htl.html`<table><thead><tr><th></th><th>source</th><th>rule</th><th>checker</th><th></th></tr></thead><tbody>${cases.map((c) => {
  const got = spec_rulesOf(c);
  const same = got.length === 1 && got[0] === c.rule;
  const notes = [c.shell ? "// shell: " + c.shell : "", c.outside ? "// other languages: " + (c.outside.map((o) => (o.view ? "viewof " : "") + o.name).join(", ") || "none") : ""].filter(Boolean);
  return htl.html`<tr><td>${c.statement}</td><td><pre style="margin:0">${[c.source, ...notes].join("\n")}</pre></td><td>[${c.rule}]</td><td>${got.map((r) => `[${r}]`).join(" ")}</td><td>${same ? "same" : "DIFFERENT"}</td></tr>`;
})}</tbody></table>`
// %%
spec_rejectsFor = (statement) => {
  // every reject case of a statement gives exactly its rule
  const cases = spec_rejects.filter((c) => c.statement === statement);
  if (!cases.length) throw new Error(`${statement} has no reject case`);
  for (const c of cases) {
    const got = spec_rulesOf(c);
    if (got.length !== 1 || got[0] !== c.rule) throw new Error(`${JSON.stringify(c.source)} gave ${JSON.stringify(got)}, expected exactly [${c.rule}]`);
  }
  return `${cases.length} source(s) give exactly [${[...new Set(cases.map((c) => c.rule))].join(", ")}]`;
}
// %%
spec_okCells = (source) => {
  // the cells of an accepted source, name:status; throws if the source is rejected
  const r = ss.check(source);
  const rules = [...r.module, ...r.cells.flatMap((x) => x.errors)].map((e) => e.rule);
  if (rules.length) throw new Error(`${JSON.stringify(source)} gave ${JSON.stringify(rules)}`);
  return r.cells.map((c) => `${c.name}:${c.status}`).join(",");
}
// %%
spec_is = (got, want) => {
  // throws unless got and want are the same JSON
  if (JSON.stringify(got) !== JSON.stringify(want)) throw new Error(`gave ${JSON.stringify(got)}, expected ${JSON.stringify(want)}`);
  return got;
}
// %%
spec_okCellsWith = (source, outside) => {
  // spec_okCells for a module that also has cells in other languages
  const r = ss.checkSources({ cells: source, tsx: true, outside });
  const rules = [...r.module, ...r.cells.flatMap((x) => x.errors)].map((e) => e.rule);
  if (rules.length) throw new Error(`${JSON.stringify(source)} gave ${JSON.stringify(rules)}`);
  return r.cells.map((c) => `${c.name}:${c.status}`).join(",");
}
// %%
test_spec_S1_1 = {
  const forms = "const a = () => 1;\nlet b = (a: number) => a + 1;\nconst g = function (a: number) { return a; };\nfunction c(b: number) { return b * 2; }\nfunction* d() { yield 1; }\nasync function e() { return 1; }\nasync function* f() { yield 1; }";
  const got = spec_okCells(forms);
  if (got !== "a:ok,b:ok,g:ok,c:ok,d:ok,e:ok,f:ok") throw new Error(got);
  const values = await Promise.all(["s1_arrow", "s1_let", "s1_declared", "s1_generator", "s1_async"].map((n) => spec_module.value(n)));
  if (JSON.stringify(values) !== "[1,2,4,1,4]") throw new Error(`the live cells gave ${JSON.stringify(values)}`);
  return `7 forms check as cells; the live cells give ${JSON.stringify(values)}`;
}
// %%
test_spec_S1_2 = {
  const plain = "const a = () => 1;\nfunction c(a: number) { return a; }\ntype T = number;\ninterface I { x: number }";
  const exported = plain.replace(/^/gm, "export ");
  const a = spec_okCells(plain), b = spec_okCells(exported);
  if (a !== b) throw new Error(`${a} without export, ${b} with`);
  if ((await spec_module.value("s1_exported")) !== 5) throw new Error("s1_exported is not 5");
  return `the same cells with and without export (${a}); s1_exported is 5`;
}
// %%
test_spec_S1_3 = {
  const got = spec_okCells('type T = number;\ninterface I { x: number }\nimport type { X } from "./x";\nconst a = (): T => 1;');
  if (got !== "a:ok") throw new Error(got);
  if (JSON.stringify(await spec_module.value("s1_typed")) !== '{"a":1,"b":2}') throw new Error("s1_typed");
  return "type, interface and import type are accepted and are not cells";
}
// %%
test_spec_S1_4 = {
  const own = [["var a = () => 1;", "no-var"], ["class A {}", "no-class"], ["enum E { A }", "no-enum"], ["namespace N {}", "no-namespace"]];
  for (const [source, rule] of own) {
    const got = spec_rulesOf({ source });
    if (got.length !== 1 || got[0] !== rule) throw new Error(`${source} gave ${JSON.stringify(got)}, expected [${rule}]`);
  }
  return `${spec_rejectsFor("S1.4")}; var, class, enum and namespace give their own rules`;
}
// %%
test_spec_S1_5 = spec_rejectsFor("S1.5")
// %%
test_spec_S1_6 = {
  const r = ss.check('const a = () => 1;\nconst b = (a: number) => a + 1;\nconst a = () => "x";\nconst a = () => 3;');
  const got = r.cells.map((c) => `${c.name}:${c.status}:${c.errors.map((e) => e.msg).join("|")}`).join(",");
  if (got !== "a:ok:,b:ok:,a (2):rejected:a is already defined at line 1,a (3):rejected:a is already defined at line 1") throw new Error(got);
  if (r.cells[1].value !== "number") throw new Error(`b reads ${r.cells[1].value}, not the first a`);
  // an edit naming another cell is stored, rejected, under the next free name
  const e = ss_language.check("const s1_arrow = () => 9;", [], { module: { module: spec_module } });
  if (!e.store || e.state !== "rejected" || e.defs.map((d) => d.name).join() !== "s1_arrow (2)" || !e.problems.some((p) => p.rule === "duplicate-cell")) throw new Error(`the edit gave store ${e.store}, ${e.state}, ${e.defs?.map((d) => d.name)}, ${JSON.stringify(e.problems)}`);
  return `${spec_rejectsFor("S1.6")}; b reads the first a; an edit naming s1_arrow is stored as s1_arrow (2), rejected`;
}
// %%
test_spec_S1_7 = spec_rejectsFor("S1.7")
// %%
test_spec_S1_8 = {
  const got = spec_okCells("const a = () => 1, b = (a: number) => a + 1;");
  if (got !== "a:ok,b:ok") throw new Error(got);
  return "one statement, two cells";
}
// %%
md`## 2. Inputs and names

PROSE PENDING`
// %%
md`**S2.1** A cell's parameters are its inputs, taken by name. A parameter that names no cell of the module, foreign declaration, shell cell or capability (or, section 11, a variable in another language) is \`[inject-unknown]\`. Only the cell's own parameter list is its input list, so a cell whose value is a function is two arrows: \`const double = () => (n: number) => n * 2\`.`
// %%
md`**S2.2** An input is a plain identifier. A destructuring pattern, a default value or a rest parameter is \`[inject-pattern]\`.`
// %%
md`**S2.3** An input with no type annotation has the value type of the cell it names. An annotated input must accept that value type; otherwise it is \`[inject-type]\`.`
// %%
md`**S2.4** The value type of a cell is its return type \`T\`, except that \`Promise<T>\` gives \`T\`, a generator or async generator yielding \`Y\` gives \`Y\`, and \`RefCell<T>\` gives \`T\`. Annotating the input with the wrapped type, such as \`Promise<number>\`, is \`[inject-type]\`.`
// %%
md`**S2.5** The capabilities are the inputs \`now: Clock\`, \`random: Random\`, \`fetch: Fetch\`, \`log: Log\`, \`invalidation: Invalidation\`, \`compile: Compile\` and \`pool: Pool\`. \`Clock\` and \`Random\` are \`() => number\`. Any other annotation on a capability, such as \`now: number\`, is \`[inject-type]\`.`
// %%
md`**S2.6** A body may name its parameters, its own locals, the prelude functions \`ref action mut freeze borrow snapshot equals on read\`, and the intrinsics \`Object Array Math JSON Number String Boolean BigInt Map Set Error TypeError RangeError RegExp Promise ArrayBuffer URL URLSearchParams Infinity NaN undefined isNaN isFinite parseInt parseFloat encodeURIComponent decodeURIComponent encodeURI decodeURI atob btoa structuredClone\` and the typed arrays. Any other free name is \`[free-name]\`: \`Date\`, \`console\`, \`window\`, \`globalThis\`, \`setTimeout\`, \`eval\`, \`Function\`.`
// %%
md`**S2.7** Reading \`Math.random\`, \`Object.defineProperty\`, \`Object.defineProperties\`, \`Object.setPrototypeOf\` or a \`prototype\` member is \`[banned-member]\`, also through a local bound to \`Math\` or \`Object\` and through a computed key such as \`Math["random"]\`.`
// %%
md`**S2.8** A body that uses a cell by its name instead of taking it as a parameter is \`[cell-by-name]\`. That includes a cell calling itself. A local with a cell's name is a local.`
// %%
md`The cells of this section. \`s2_answer\` takes \`s2_base\` and the function \`s2_double\` with no annotations; \`s2_read\` takes an async cell, a generator and a ref cell by their value types.`
// %%
//ss: ./spec-2.ts
// %%
spec_rejects_2 = [
  { statement: "S2.1", rule: "inject-unknown", source: "const double = (n: number) => n * 2;" },
  { statement: "S2.2", rule: "inject-pattern", source: "const a = () => ({ x: 1 });\nconst b = ({ x }: { x: number }) => x;" },
  { statement: "S2.2", rule: "inject-pattern", source: "const a = () => 1;\nconst c = (a = 1) => a;" },
  { statement: "S2.2", rule: "inject-pattern", source: "const d = (...xs: number[]) => xs.length;" },
  { statement: "S2.3", rule: "inject-type", source: "const a = () => \"s\";\nconst b = (a: number) => a + 1;" },
  { statement: "S2.4", rule: "inject-type", source: "const a = async () => 1;\nconst b = (a: Promise<number>) => 1;" },
  { statement: "S2.4", rule: "inject-type", source: "const c = () => ref(true);\nconst d = (c: RefCell<boolean>) => 1;" },
  { statement: "S2.4", rule: "inject-type", source: "const g = async function* () { yield \"x\"; };\nconst d = (g: number) => g;" },
  { statement: "S2.5", rule: "inject-type", source: "const roll = (now: number) => now;" },
  { statement: "S2.6", rule: "free-name", source: "const a = () => Date.now();" },
  { statement: "S2.6", rule: "free-name", source: "const b = () => typeof globalThis;" },
  { statement: "S2.6", rule: "free-name", source: "const c = () => console;" },
  { statement: "S2.6", rule: "free-name", source: "const c = () => setTimeout;" },
  { statement: "S2.6", rule: "free-name", source: "const c = () => eval(\"1\");" },
  { statement: "S2.7", rule: "banned-member", source: "const a = () => Math.random();" },
  { statement: "S2.7", rule: "banned-member", source: "const b = () => {\n  const M = Math;\n  return M.random() + Math[\"random\"]();\n};" },
  { statement: "S2.7", rule: "banned-member", source: "const b = () => Object.defineProperty({}, \"a\", {});" },
  { statement: "S2.7", rule: "banned-member", source: "const b = () => Object.prototype;" },
  { statement: "S2.8", rule: "cell-by-name", source: "const a = () => 1;\nconst b = () => a() + 1;" },
  { statement: "S2.8", rule: "cell-by-name", source: "function f(): number {\n  return f();\n}" }
]
// %%
spec_rejects_2_view = spec_rejectsTable(spec_rejects_2)
// %%
test_spec_S2_1 = {
  spec_is(spec_okCells("const double = () => (n: number) => n * 2;\nconst four = (double) => double(2);"), "double:ok,four:ok");
  spec_is(await spec_module.value("s2_answer"), 42);
  return `${spec_rejectsFor("S2.1")}; a function-valued cell is two arrows; s2_answer is 42`;
}
// %%
test_spec_S2_2 = spec_rejectsFor("S2.2")
// %%
test_spec_S2_3 = {
  spec_is(spec_okCells("const a = () => \"s\";\nconst b = (a) => a.length;\nconst c = (a: string | number) => a;"), "a:ok,b:ok,c:ok");
  return `${spec_rejectsFor("S2.3")}; an unannotated input and a wider annotation are accepted`;
}
// %%
test_spec_S2_4 = {
  spec_is(spec_okCells("const a = async () => 1;\nconst b = function* () { yield \"x\"; };\nconst g = async function* () { yield true; };\nconst c = () => ref(true);\nconst d = (a: number, b: string, g: boolean, c: boolean) => 1;"), "a:ok,b:ok,g:ok,c:ok,d:ok");
  spec_is(await spec_module.value("s2_read"), [43, "tea", 3]);
  return `${spec_rejectsFor("S2.4")}; s2_read gets ${JSON.stringify(await spec_module.value("s2_read"))}`;
}
// %%
test_spec_S2_5 = {
  spec_is(spec_okCells("const a = (now: Clock, random: Random, fetch: Fetch, log: Log, invalidation: Invalidation) => now() + random();\nconst b = (now, random, fetch, log, invalidation, compile, pool) => now() + random();"), "a:ok,b:ok");
  return `${spec_rejectsFor("S2.5")}; every capability is accepted, annotated or not`;
}
// %%
test_spec_S2_6 = {
  const names = "Object Array Math JSON Number String Boolean BigInt Map Set Error TypeError RangeError RegExp Promise ArrayBuffer URL URLSearchParams Infinity NaN undefined isNaN isFinite parseInt parseFloat encodeURIComponent decodeURIComponent encodeURI decodeURI atob btoa structuredClone Float32Array Uint8ClampedArray".split(" ");
  const bad = names.filter((n) => spec_okCells(`const a = () => ${n};`) !== "a:ok");
  if (bad.length) throw new Error(`not accepted as a value: ${bad.join(", ")}`);
  spec_is(spec_okCells("const n = () => ref(0);\nconst a = (n: Ref<number>) => { const m = mut([1]); const f = freeze(m); return [equals(f, [1]), action(() => n.set(read(n) + 1))]; };"), "n:ok,a:ok");
  return `${spec_rejectsFor("S2.6")}; ${names.length} intrinsics and the prelude functions accepted`;
}
// %%
test_spec_S2_7 = spec_rejectsFor("S2.7")
// %%
test_spec_S2_8 = {
  spec_is(spec_okCells("const a = () => 1;\nconst b = () => { const a = 2; return a; };"), "a:ok,b:ok");
  spec_is(await spec_module.value("s2_shadow"), 2);
  return `${spec_rejectsFor("S2.8")}; a local named like a cell is the local (s2_shadow is 2)`;
}
// %%
md`## 3. Immutable by default

PROSE PENDING`
// %%
md`**S3.1** Writing a member of a value that is not \`Mut\` (section 4) is \`[member-write]\`: assignment, compound assignment, \`++\` and \`--\`, and a member as the target of a destructuring assignment. An object literal bound to a local \`const\` is not \`Mut\` either.`
// %%
md`**S3.2** Calling a mutating method on a receiver that is not \`Mut\` is \`[mutating-method]\`: \`push pop shift unshift splice sort reverse fill copyWithin\` on an array, those of them a typed array has and \`set\`, \`set delete clear\` on a \`Map\`, \`add delete clear\` on a \`Set\`. The copying methods (\`toSorted\`, \`toReversed\`, \`slice\`, \`map\`, \`filter\`) and spreads are accepted.`
// %%
md`**S3.3** \`Object.assign\` with an existing value as its first argument is \`[object-assign]\`. A spread, \`{ ...o, b: 2 }\`, builds the new value.`
// %%
md`**S3.4** \`delete\` on a value that is not \`Mut\` is \`[no-delete]\`. On a \`Mut\` it is accepted (S4.1).`
// %%
md`**S3.5** \`var\`, \`class\` (a declaration or an expression), \`this\` and \`arguments\` are \`[no-var]\`, \`[no-class]\`, \`[no-this]\` and \`[no-arguments]\`.`
// %%
md`**S3.6** \`new\` on anything but an allowed intrinsic (S2.6) is \`[new-non-intrinsic]\`. That includes \`new Date()\` and \`new C()\` where \`C\` is a local bound to an intrinsic.`
// %%
md`**S3.7** The type \`any\` is \`[no-any]\`. An \`as\` cast other than \`as const\` is \`[no-cast]\`. A non-null assertion \`x!\` is \`[no-non-null]\`. A \`@ts-ignore\`, \`@ts-expect-error\` or \`@ts-nocheck\` comment is \`[no-ts-ignore]\`.`
// %%
md`**S3.8** \`import(...)\` is \`[no-dynamic-import]\`.`
// %%
md`**S3.9** \`enum\` and \`const enum\` are \`[no-enum]\`. \`namespace\`, \`module\` and \`declare module\` are \`[no-namespace]\`.`
// %%
md`**S3.10** \`throw\`, \`try\`/\`catch\`/\`finally\`, loops and assigning a local \`let\` are accepted.`
// %%
md`**S3.11** A local \`let\` may be assigned from a nested function only when every function from the assignment out to the \`let\` is a local helper: bound to a local \`const\` or declared with \`function\`, and every use of its name a direct call. Otherwise it is \`[let-capture]\`: the helper is returned, passed as an argument, put in a literal, bound to a second name, or called from a function that escapes. Reading a captured \`let\` is accepted.`
// %%
md`**S3.12** \`===\`, \`!==\`, \`==\` and \`!=\` with two operands that may both be non-primitive is \`[strict-eq-object]\`. \`equals(a, b)\` compares structurally. Comparing with a primitive, \`null\` included, is accepted.`
// %%
md`The cells of this section. \`s3_parse\` is a recursive-descent parser whose helpers share the cursor \`let i\` (S3.11); \`s3_moved\` builds a new point with a spread.`
// %%
//ss: ./spec-3.ts
// %%
spec_rejects_3 = [
  { statement: "S3.1", rule: "member-write", source: "const o = () => ({ a: 1, xs: [1] });\nconst w = (o) => {\n  o.a = 2;\n  o.xs[0] = 3;\n  o.a += 1;\n  o.a++;\n  --o.a;\n  return o;\n};" },
  { statement: "S3.1", rule: "member-write", source: "const o = () => ({ a: 1 });\nconst d = (o) => {\n  [o.a] = [5];\n  ({ k: o.a } = { k: 6 });\n  return o;\n};" },
  { statement: "S3.1", rule: "member-write", source: "const w = () => {\n  const l = { a: 1 };\n  l.a = 2;\n  return l;\n};" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => [xs.push(1), xs.pop(), xs.shift(), xs.unshift(1), xs.splice(0, 1), xs.sort(), xs.reverse(), xs.fill(0), xs.copyWithin(0, 1)];" },
  { statement: "S3.2", rule: "mutating-method", source: "const t = () => new Float32Array(2);\nconst w = (t) => {\n  t.set([1], 0);\n  t.fill(1);\n  return t.length;\n};" },
  { statement: "S3.2", rule: "mutating-method", source: "const m = () => new Map<string, number>();\nconst s = () => new Set<number>();\nconst w = (m, s) => {\n  m.set(\"a\", 1);\n  m.delete(\"a\");\n  m.clear();\n  s.add(1);\n  s.delete(1);\n  s.clear();\n  return s.size;\n};" },
  { statement: "S3.3", rule: "object-assign", source: "const o = () => ({ a: 1 });\nconst w = (o) => Object.assign(o, { b: 2 });" },
  { statement: "S3.4", rule: "no-delete", source: "const o = (): { a?: number } => ({});\nconst d = (o) => {\n  delete o.a;\n  return o;\n};" },
  { statement: "S3.5", rule: "no-var", source: "const a = () => {\n  var x = 1;\n  return x;\n};" },
  { statement: "S3.5", rule: "no-class", source: "const a = () => {\n  class A {}\n  return typeof A;\n};" },
  { statement: "S3.5", rule: "no-class", source: "const b = () => {\n  const K = class {};\n  return typeof K;\n};" },
  { statement: "S3.5", rule: "no-this", source: "const a = () => {\n  const o = { v: 1, get() { return this.v; } };\n  return o.get();\n};" },
  { statement: "S3.5", rule: "no-arguments", source: "const a = () => {\n  function g(..._xs: number[]) {\n    return arguments.length;\n  }\n  return g(1);\n};" },
