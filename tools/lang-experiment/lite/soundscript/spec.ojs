  { statement: "S3.12", rule: "strict-eq-object", source: "const xs = (): number[] | string => [1];\nconst ys = (): number[] | string => \"a\";\nconst same = (xs, ys) => xs === ys;" },
  { statement: "S3.12", rule: "strict-eq-object", source: "const xs = () => [[1]];\nconst has = (xs) => xs.includes([1]);" },
  { statement: "S3.12", rule: "strict-eq-object", source: "const ps = () => [{ x: 1 }];\nconst at = (ps) => ps.indexOf({ x: 1 });" },
  { statement: "S3.12", rule: "strict-eq-object", source: "const ps = (): ({ x: number } | null)[] => [{ x: 1 }, null];\nconst last = (ps) => ps.lastIndexOf(ps[0] ?? null);" },
  { statement: "S3.13", rule: "strict-eq-object", source: "const f = () => (a: readonly number[], b: readonly number[]): number => {\n  switch (a) {\n    case b: return 1;\n  }\n  return 0;\n};" },
  { statement: "S3.13", rule: "type", source: "const f = () => (a: number): number => {\n  switch (a) {\n    case \"x\": return 1;\n  }\n  return 0;\n};" },
  { statement: "S3.13", rule: "type", source: "const f = () => (a: \"x\" | \"y\"): number => {\n  switch (a) {\n    case \"x\": return 1;\n    case \"x\": return 2;\n  }\n  return 0;\n};" },
  { statement: "S3.13", rule: "type", source: "const g = () => (): \"x\" | \"y\" => \"x\";\nconst f = (g: () => \"x\" | \"y\") => (): number => {\n  switch (g()) {\n    case \"x\": return 1;\n    case \"x\": return 2;\n  }\n  return 0;\n};" },
  { statement: "S3.14", rule: "no-member", source: "type T = { readonly k: \"n\"; readonly v: number } | { readonly k: \"s\"; readonly s: string };\nconst f = () => (t: T): number => {\n  switch (t.k) {\n    case \"s\": return t.v;\n  }\n  return 0;\n};" },
  { statement: "S3.14", rule: "possibly-undefined", source: "const f = () => (a: number | undefined): number => {\n  switch (a) {\n    case 1: return 1;\n    default: return a + 1;\n  }\n};" },
  { statement: "S3.15", rule: "switch-fallthrough", source: "const f = () => (a: number): number => {\n  let n = 0;\n  switch (a) {\n    case 1: n = 1;\n    case 2: n = 2; break;\n  }\n  return n;\n};" },
  { statement: "S3.15", rule: "switch-fallthrough", source: "const f = () => (a: number, b: boolean): number => {\n  switch (a) {\n    case 1: if (b) break;\n    default: return 2;\n  }\n  return 1;\n};" },
  { statement: "S3.16", rule: "switch-declaration", source: "const f = () => (a: number): number => {\n  switch (a) {\n    case 1: const x = 2; return x;\n  }\n  return 0;\n};" },
