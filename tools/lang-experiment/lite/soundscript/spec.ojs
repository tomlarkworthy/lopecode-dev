md`## 4. Mut locals

PROSE PENDING`
// %%
md`**S4.1** \`const out = mut(e)\` gives \`out\` the type \`Mut<T>\`, where \`e\` has type \`T\`. On a \`Mut\` receiver, member writes, mutating methods and \`delete\` are accepted (S3.1, S3.2, S3.4). \`freeze(out)\` has type \`T\`.`
// %%
md`**S4.2** \`mut(...)\` is accepted only as the initializer of a local \`const\`. Anywhere else, a \`let\`, an argument or an array element, it is \`[mut-bind]\`.`
// %%
md`**S4.3** The argument of \`mut\` must be fresh: a literal, a spread copy, \`new\` on an intrinsic, or an intrinsic that returns a new value (\`Array.from\`, \`slice\`, \`map\`, \`structuredClone\`). A parameter, another binding or a frozen value is \`[mut-not-fresh]\`.`
// %%
md`**S4.4** A \`Mut\` may be read, written, passed to a parameter typed \`Mut<…>\` and passed to \`freeze\`. Returning it, yielding it, binding it to a second name, placing it in an array or object literal, or passing it to a parameter not typed \`Mut<…>\` is \`[mut-escape]\`.`
// %%
md`**S4.5** A nested function that uses a \`Mut\` of an enclosing function is \`[mut-capture]\`, unless it is a local helper in the sense of S3.11: bound to a local \`const\` or declared with \`function\`, and only called.`
// %%
md`**S4.6** Using a \`Mut\` after \`freeze\` of it, including by calling a helper that uses it, is \`[mut-after-freeze]\`.`
// %%
md`**S4.7** Only the first level of a \`Mut\` is writable. A write to, or a mutating method of, a value held inside it is \`[mut-deep-write]\`.`
// %%
md`**S4.8** A view of a \`Mut\` buffer (\`subarray\`, \`buffer\`, \`values()\`, or the receiver a mutating method returns) may only be consumed at once as an argument. Binding or returning one is \`[mut-view]\`.`
// %%
md`**S4.9** \`freeze\` of a \`Mut<…>\` parameter is \`[mut-freeze-param]\`. Only the function that called \`mut\` freezes it.`
// %%
md`The cells of this section. \`s4_blur\` writes a box blur into a \`Mut\` buffer; \`s4_counts\` writes a \`Mut\` map through a local helper (S4.5); \`s4_record\` deletes from a \`Mut\` object.`
// %%
//ss: ./spec-4.ts
// %%
spec_rejects_4 = [
  { statement: "S4.2", rule: "mut-bind", source: "const a = () => {\n  let out = mut([0]);\n  out[0] = 1;\n  return freeze(out);\n};" },
  { statement: "S4.2", rule: "mut-bind", source: "const a = () => freeze(mut([0]));" },
  { statement: "S4.2", rule: "mut-bind", source: "const a = () => [mut([0])];" },
  { statement: "S4.3", rule: "mut-not-fresh", source: "const xs = () => [1, 2, 3];\nconst bad = (xs) => {\n  const m = mut(xs);\n  m[0] = 9;\n  return freeze(m);\n};" },
  { statement: "S4.3", rule: "mut-not-fresh", source: "const bad = () => {\n  const a = mut([1]);\n  const f = freeze(a);\n  const b = mut(f);\n  b[0] = 2;\n  return freeze(b);\n};" },
  { statement: "S4.4", rule: "mut-escape", source: "const sum = () => (xs: number[]) => xs.reduce((p, q) => p + q, 0);\nconst a = (sum) => {\n  const out = mut([0, 1]);\n  const alias = out;\n  const arr = [out];\n  sum(out);\n  return out;\n};" },
  { statement: "S4.4", rule: "mut-escape", source: "const b = () => {\n  const out = mut([0]);\n  return { out };\n};" },
  { statement: "S4.4", rule: "mut-escape", source: "const g = function* () {\n  const out = mut([0, 1]);\n  yield out;\n};" },
  { statement: "S4.5", rule: "mut-capture", source: "const a = () => {\n  const out = mut([0]);\n  const f = () => out.length;\n  return f;\n};" },
  { statement: "S4.5", rule: "mut-capture", source: "const a = () => {\n  const out = mut([0]);\n  [1].forEach(() => {\n    out[0] = 1;\n  });\n  return freeze(out);\n};" },
  { statement: "S4.6", rule: "mut-after-freeze", source: "const a = () => {\n  const out = mut([0]);\n  const r = freeze(out);\n  out[0] = 2;\n  return r;\n};" },
  { statement: "S4.6", rule: "mut-after-freeze", source: "const a = () => {\n  const out = mut([0]);\n  const f = () => {\n    out[0] = 1;\n  };\n  const r = freeze(out);\n  f();\n  return r;\n};" },
  { statement: "S4.7", rule: "mut-deep-write", source: "const a = () => {\n  const m = mut({ a: { b: 1 }, xs: [1] });\n  m.a.b = 2;\n  m.xs.push(2);\n  return freeze(m);\n};" },
  { statement: "S4.8", rule: "mut-view", source: "const a = () => {\n  const t = mut(new Float32Array(4));\n  const v = t.subarray(0, 2);\n  return freeze(t);\n};" },
  { statement: "S4.8", rule: "mut-view", source: "const a = () => {\n  const m = mut(new Map<string, number>());\n  const set = (k: string) => m.set(k, 1);\n  set(\"a\");\n  return freeze(m).size;\n};" },
  { statement: "S4.9", rule: "mut-freeze-param", source: "const a = () => {\n  const g = (m: Mut<number[]>) => freeze(m);\n  return 1;\n};" }
]
// %%
spec_rejects_4_view = spec_rejectsTable(spec_rejects_4)
// %%
test_spec_S4_1 = {
  spec_is(spec_okCells("const a = () => {\n  const t = mut(new Float32Array(3));\n  t.fill(0);\n  t[1] = 2;\n  t[2] += 1;\n  t[0]++;\n  const m = mut(new Map<string, number>());\n  m.set(\"a\", 1);\n  m.delete(\"a\");\n  const o = mut({ a: 1, b: 2 });\n  delete o.a;\n  const xs = mut([3, 1]);\n  xs.push(2);\n  xs.sort((p, q) => p - q);\n  const r: number[] = freeze(xs);\n  return [freeze(t), freeze(m).size, freeze(o), r];\n};"), "a:ok");
  const blur = Array.from(await spec_module.value("s4_blur"), (v) => Math.round(v * 1e6) / 1e6);
  spec_is(blur, [0, 1, 1, 1, 0]);
  spec_is(await spec_module.value("s4_record"), { b: 3 });
  return `writes, mutating methods and delete on a Mut are accepted; s4_blur is ${JSON.stringify(blur)}, s4_record {"b":3}`;
}
// %%
test_spec_S4_2 = spec_rejectsFor("S4.2")
// %%
test_spec_S4_3 = {
  spec_is(spec_okCells("const xs = () => [1, 2, 3];\nconst o = () => ({ a: 1 });\nconst a = (xs, o) => {\n  const p = mut([...xs]);\n  const q = mut({ ...o });\n  const r = mut(Array.from(xs));\n  const s = mut(xs.slice(1));\n  const t = mut(xs.map((x) => x * 2));\n  const u = mut(structuredClone(xs));\n  const v = mut(new Map<string, number>());\n  p.push(4); q.a = 2; r.push(5); s.push(6); t.reverse(); u.reverse(); v.set(\"k\", 1);\n  return [freeze(p), freeze(q), freeze(r), freeze(s), freeze(t), freeze(u), freeze(v).size];\n};"), "xs:ok,o:ok,a:ok");
  return `${spec_rejectsFor("S4.3")}; literals, spreads, new and fresh intrinsics are accepted`;
}
// %%
test_spec_S4_4 = {
  spec_is(spec_okCells("const a = () => {\n  const set0 = (m: Mut<number[]>) => {\n    m[0] = 5;\n  };\n  const out = mut([0, 1]);\n  set0(out);\n  const s = JSON.stringify(out);\n  return [freeze(out), s];\n};"), "a:ok");
  return `${spec_rejectsFor("S4.4")}; a Mut<…> parameter and a read by JSON.stringify are accepted`;
}
