  { statement: "S3.19", rule: "handle-pass", source: "const v = async (fetch: Fetch) => {\n  const res = await fetch(\"https://example.invalid/\");\n  const u: unknown = res;\n  return u;\n};" },
  { statement: "S3.19", rule: "member-write", source: "const f = async (fetch: Fetch) => {\n  const res = await fetch(\"https://example.invalid/\");\n  res.ok = false;\n  return 1;\n};" },
