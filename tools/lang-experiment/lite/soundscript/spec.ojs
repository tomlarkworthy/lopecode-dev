  { statement: "S3.6", rule: "new-non-intrinsic", source: "const a = () => new Date();" },
  { statement: "S3.7", rule: "no-any", source: "const a = () => {\n  const y: any = 1;\n  return y;\n};" },
  { statement: "S3.7", rule: "no-any", source: "const a = (): any => 1;" },
  { statement: "S3.7", rule: "no-cast", source: "const a = () => (1 as number) + 1;" },
