// %%
test_spec_S2_6 = {
  // the names are read from S2.6's own text, so the list and the test cannot drift apart
  const statement = [...runtime._variables].filter((v) => v._module === spec_module).map((v) => String(v._definition)).find((d) => d.includes("**S2.6**"));
  const names = /the intrinsics \\`([^`\\]+)\\`/.exec(statement)[1].split(" ");
  const bad = names.filter((n) => spec_okCells(`const a = () => ${n};`) !== "a:ok");
  if (bad.length) throw new Error(`not accepted as a value: ${bad.join(", ")}`);
  spec_is(spec_okCells("const n = () => state(0);\nconst a = (n: State<number>) => { const m = [1]; const f = m; return [equals(f, [1]), action(() => n.set(read(n) + 1))]; };"), "n:ok,a:ok");
  // each listed prelude name is one the checker treats as a prelude function: as a value it is refused
  const prelude = /the prelude functions \\`([^`\\]+)\\`/.exec(statement)[1].split(" ");
  const asValue = (n) => soundscript.check(`const a = () => { const v = ${n}; return 1; };`, true).cells[0].errors.map((e) => e.rule);
  const notPrelude = prelude.filter((n) => !asValue(n).some((r) => ["prelude-value", "removed-call", "read-outside-action", "listener-placement"].includes(r)));
  if (notPrelude.length) throw new Error(`listed in S2.6 but not a prelude function: ${notPrelude.join(", ")}`);
  return `${spec_rejectsFor("S2.6")}; ${names.length} intrinsics accepted as values; ${prelude.length} prelude functions, each refused as a value`;
}
