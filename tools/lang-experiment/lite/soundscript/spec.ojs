test_spec_S6_12 = {
  spec_is(spec_okCells(`const n = (): StateCell<number> => state(0);
const viaAwait = (n: State<number>) => action(async (p: Promise<number>) => { n.set(1); const v = await p; n.set(read(n) + v); });
const viaThen = (n: State<number>) => action((p: Promise<number>) => p.then((v) => n.set(v)));
const viaAll = (n: State<number>) => action(async (p: Promise<number>, q: Promise<number>) => { const vs = await Promise.all([p, q]); n.set(vs.reduce((a, b) => a + b, 0)); });`), "n:ok,viaAwait:ok,viaThen:ok,viaAll:ok");
  const L = await spec_load(`const n = (): StateCell<number> => state(0);
const viaAwait = (n: State<number>) => action(async (p: Promise<number>) => { n.set(1); const v = await p; n.set(read(n) + v); });
const viaThen = (n: State<number>) => action((p: Promise<number>) => p.then((v) => n.set(read(n) * v)));`, {});
  const gs = [spec_gate(), spec_gate()];
  try {
    const [viaAwait, viaThen] = [await L.value("viaAwait"), await L.value("viaThen")];
    for (const [f, k, g] of [[viaAwait, 4, gs[0]], [viaThen, 3, gs[1]]]) {
      await spec_act(() => f(g.p));
      g.open(k);
      await spec_act(() => {});
      await spec_flush();
    }
    spec_is(await L.value("n"), 15);
    return "an async action, one returning a promise and one using Promise.all check; viaAwait and then viaThen leave n at (1 + 4) * 3";
  } finally { gs.forEach((g) => g.open(0)); L.dispose(); }
}
