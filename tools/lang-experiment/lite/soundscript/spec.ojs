// %%
spec_rejects_3_view = spec_rejectsTable(spec_rejects_3)
// %%
test_spec_S3_1 = `${spec_rejectsFor("S3.1")}; ${spec_acceptsFor("S3.1")}`
// %%
test_spec_S3_2 = {
  spec_is(spec_okCells("const xs = () => [3, 1, 2];\nconst w = (xs) => [xs.toSorted(), xs.toReversed(), xs.slice(), xs.map((x) => x + 1), xs.filter((x) => x > 1), [...xs, 4]];"), "xs:ok,w:ok");
  spec_is(await spec_module.value("s3_sorted"), [1, 2, 3]);
  // a g or y regexp where it is made, and a held regexp without them, are accepted
  spec_is(spec_okCells("const r = () => {\n  const re = /^a/;\n  const f = (s: string) => [/a/g.test(s), s.replace(/a/g, \"b\"), s.split(/,/g).length, re.test(s), re.exec(s) === null];\n  return f(\"a,b\");\n};"), "r:ok");
  return `${spec_rejectsFor("S3.2")}; the copying methods are accepted; s3_sorted is [1,2,3]; a g regexp is accepted where it is made`;
}
// %%
test_spec_S3_3 = {
  spec_is(await spec_module.value("s3_moved"), { x: 2, y: 2 });
  spec_is(await spec_module.value("s3_point"), { x: 1, y: 2 });
  return `${spec_rejectsFor("S3.3")}; s3_moved is a new point, s3_point is unchanged`;
}
// %%
test_spec_S3_4 = spec_rejectsFor("S3.4")
// %%
test_spec_S3_5 = spec_rejectsFor("S3.5")
// %%
test_spec_S3_6 = spec_rejectsFor("S3.6")
// %%
test_spec_S3_7 = {
  spec_is(spec_okCells("const b = () => [\"x\"] as const;"), "b:ok");
  return `${spec_rejectsFor("S3.7")}; as const is accepted`;
}
// %%
test_spec_S3_8 = spec_rejectsFor("S3.8")
// %%
test_spec_S3_9 = spec_rejectsFor("S3.9")
// %%
test_spec_S3_10 = {
  spec_is(spec_okCells("const a = () => {\n  let n = 0;\n  for (let i = 0; i < 3; i++) n += i;\n  while (n > 100) n--;\n  for (const x of [1]) n += x;\n  do { n += 1; } while (n < 0);\n  try {\n    if (n < 0) throw new Error(\"x\");\n  } catch (e) {\n    n = -1;\n  } finally {\n    n += 0;\n  }\n  return n;\n};"), "a:ok");
  spec_is(await spec_module.value("s3_steps"), -6);
  return "statements accepted; s3_steps is -6";
}
// %%
test_spec_S3_11 = {
  spec_is(spec_okCells("const a = () => {\n  let n = 0;\n  const inc = () => {\n    n++;\n  };\n  function add(k: number) {\n    n += k;\n  }\n  inc();\n  add(2);\n  const read = () => n;\n  return read();\n};"), "a:ok");
  spec_is(await spec_module.value("s3_tree"), [1, [2, 30], []]);
  return `${spec_rejectsFor("S3.11")}; ${spec_acceptsFor("S3.11")}; helpers only called may assign; s3_tree is ${JSON.stringify(await spec_module.value("s3_tree"))}`;
}
// %%
test_spec_S3_12 = {
  spec_is(spec_okCells("const xs = (): number[] | null => [1];\nconst a = (xs) => xs === null || xs?.length === 1 || \"a\" === \"a\";"), "xs:ok,a:ok");
  spec_is(await spec_module.value("s3_same"), [true, false]);
  // includes and indexOf with a primitive element or argument are accepted
  spec_is(spec_okCells("const a = () => {\n  const xs = [1, 2];\n  const ys: (number[] | null)[] = [null];\n  return [xs.includes(2), xs.indexOf(1), ys.includes(null), \"ab\".includes(\"a\")];\n};"), "a:ok");
  return `${spec_rejectsFor("S3.12")}; equals compares structurally (s3_same is [true,false]); includes and indexOf with a primitive are accepted`;
}
// %%
test_spec_S3_13 = {
  spec_is(spec_okCells("const f = () => (a: number, b: string): number => {\n  switch (a) {\n    case 1: return 1;\n    case 2: { if (b === \"x\") return 3; break; }\n    default: return 0;\n  }\n  return 2;\n};\nconst g = () => (s: string | null): number => {\n  switch (s) {\n    case null: return 0;\n    case \"\": return 1;\n  }\n  return s.length;\n};"), "f:ok,g:ok");
  spec_is(await spec_module.value("s3_kinds"), ["vowel", "space", "digit", "other"]);
  return `${spec_rejectsFor("S3.13")}; switch on a number and on string | null is accepted; s3_kinds is ${JSON.stringify(await spec_module.value("s3_kinds"))}`;
}
// %%
test_spec_S3_14 = {
  // a switch and the if chain of the same tests give the same verdict and rules
  const pairs = [
    ["switch (t.k) { case \"n\": return t.v; case \"s\": return t.s.length; } return 0;", "if (t.k === \"n\") return t.v; if (t.k === \"s\") return t.s.length; return 0;"],
    ["switch (t.k) { case \"s\": return t.v; } return 0;", "if (t.k === \"s\") return t.v; return 0;"],
    ["switch (t.k) { case \"n\": return 1; default: return t.s.length; }", "if (t.k === \"n\") return 1; return t.s.length;"],
    ["switch (t.k) { case \"n\": case \"s\": return t.k.length; } return 0;", "if (t.k === \"n\" || t.k === \"s\") return t.k.length; return 0;"],
    ["switch (u) { case undefined: return 0; default: return u.length; }", "if (u === undefined) return 0; return u.length;"],
  ];
  const head = "type T = { readonly k: \"n\"; readonly v: number } | { readonly k: \"s\"; readonly s: string };\nconst f = () => (t: T, u: string | undefined): number => {\n";
  for (const [sw, chain] of pairs) spec_is(spec_rulesOf({ source: head + sw + "\n};" }), spec_rulesOf({ source: head + chain + "\n};" }));
  return `${spec_rejectsFor("S3.14")}; ${pairs.length} switches give the rules of their if chains`;
}
// %%
test_spec_S3_15 = {
  spec_is(spec_okCells("const f = () => (a: number): number => {\n  let n = 0;\n  switch (a) {\n    case 1: case 2: n = 1; break;\n    case 3: throw new Error(\"3\");\n    case 4: return 4;\n    default: n = 5;\n  }\n  return n;\n};\nconst g = () => (xs: readonly number[]): number => {\n  let n = 0;\n  for (const x of xs) {\n    switch (x) {\n      case 0: continue;\n      default: n += x;\n    }\n  }\n  return n;\n};"), "f:ok,g:ok");
  return `${spec_rejectsFor("S3.15")}; empty cases, break, throw, return, continue and a last body that reaches its end are accepted`;
}
// %%
test_spec_S3_16 = {
  spec_is(spec_okCells("const f = () => (a: number): number => {\n  switch (a) {\n    case 1: { const x = 2; return x; }\n    default: { const x = 3; return x; }\n  }\n};"), "f:ok");
  return `${spec_rejectsFor("S3.16")}; a declaration in a block inside a case is accepted`;
}
// %%
test_spec_S3_17 = {
  spec_is(spec_okCells("const f = () => (a: \"x\" | \"y\" | null): number => {\n  switch (a) {\n    case \"x\": return 1;\n    case \"y\": return 2;\n    case null: return 3;\n  }\n};\nconst g = () => (b: boolean): string => {\n  switch (b) {\n    case true: return \"t\";\n    case false: return \"f\";\n  }\n};"), "f:ok,g:ok");
  spec_is(await spec_module.value("s3_areas"), [9, 10, 0]);
  return `${spec_rejectsFor("S3.17")}; cases covering a union of literals and null, and true and false, need no return after; s3_areas is [9,10,0]`;
}
// %%
test_spec_S3_18 = {
  spec_is(spec_okCells("const f = () => (a: number): readonly number[] => {\n  const m = [1];\n  switch (a) {\n    case 1: m.push(2); break;\n    case 2: { m.push(3); break; }\n    default: m.push(4);\n  }\n  return m;\n};\nconst n = () => state(0);\nconst bump = (n: State<number>) => action((a: number) => {\n  switch (a) {\n    case 1: n.set(1); break;\n    default: n.update((x) => x + a);\n  }\n});"), "f:ok,n:ok,bump:ok");
  return `${spec_rejectsFor("S3.18")}; ${spec_acceptsFor("S3.18")}; a Mut written in cases and returned after, and a State written in a case inside an action, are accepted`;
}
// %%
test_spec_S3_19 = {
  spec_is(spec_okCells("const xs = () => [1, 2, 3];\nconst sum = () => (it: Iterable<number>) => {\n  let s = 0;\n  for (const x of it) s += x;\n  return s;\n};\nconst later = (xs: readonly number[], sum: (it: Iterable<number>) => number) => {\n  const made = new Map([[\"a\", 1]]);\n  const m: Map<string, number> = made;\n  const values = () => [...m.values()].length;\n  return () => sum(xs) + values() + [...\"ab\"].length;\n};"), "xs:ok,sum:ok,later:ok");
  spec_is(spec_okCells("const data = async (fetch: Fetch) => (await fetch(\"https://example.invalid/\")).json();\nconst rows = async (fetch: Fetch) => {\n  const res = await fetch(\"https://example.invalid/\");\n  if (!res.ok) return null;\n  const ok = res.status === 200;\n  return ok ? res.json() : null;\n};"), "data:ok,rows:ok");
  return `${spec_rejectsFor("S3.19")}; a function that captures an array, a Map or a function taking an Iterable, one that copies an iterator into an array, and a cell that reads the response it fetched, are accepted`;
}
// %%
test_spec_S3_20 = {
  spec_is(spec_okCells("const p = () => Object.freeze({ x: 1, ys: [2] });\nconst q = (p) => Object.freeze([p.x, ...p.ys]);"), "p:ok,q:ok");
  return `${spec_rejectsFor("S3.20")}; Object.freeze of an object literal and of an array literal is accepted`;
}
// %%
md`## 4. Local writes

Only the cell that made a value can write it in place. A local bound to a fresh value is writable. Everything that a cell publishes is frozen when it leaves the cell (S4.6). Thus no cell sees a value that it holds change. The static rules of this section report the common mistakes at the line of the mistake. The guarantee depends on the freeze at run time. If a program passes the rules and then writes a published value, the write throws a \`TypeError\`.`
// %%
md`**S4.1** A local (\`const\` or \`let\`) with no annotation whose initializer is a fresh value (S4.3) of type \`T\` has the type \`Mut<T>\`. On a \`Mut\` receiver, member writes, mutating methods and \`delete\` are accepted (S3.1, S3.2, S3.4). A \`Mut<T>\` is assignable to \`T\`. A \`T\` is not assignable to \`Mut<T>\`.

Since 2026-11-23, a local bound to a fresh value with one of these annotations \`T\` has the type \`Mut<T>\`:

- an array type or a tuple type;
- a type literal with no \`readonly\` member, which includes an index signature \`{ [k: string]: T }\`;
- \`Array\`, \`Map\`, \`Set\`, \`WeakMap\`, \`WeakSet\`, \`Record\` or a typed array.

A fresh value assigned to such a \`let\` keeps it writable. Any other annotation makes the local read-only: \`readonly T[]\`, \`ReadonlyArray<T>\`, \`Readonly<…>\`, a type literal with a \`readonly\` member, a union, a type alias, \`typeof\`. A local bound to a value that is not fresh is not writable.`
// %%
md`**S4.2** There is no marker call. \`mut(...)\`, \`freeze(...)\` and \`borrow(...)\` were removed from the language on 2026-11-22. A call to one of them is \`[removed-call]\`.`
// %%
md`**S4.3** A fresh value is a literal, a spread copy, \`new\` on an intrinsic, the result of an intrinsic that returns a new value (\`Array.from\`, \`slice\`, \`map\`, \`structuredClone\`), or \`snapshot(v)\` (S5.5). These are not fresh: a cell input, a parameter that is not typed \`Mut<…>\`, and the result of a call whose return type is not \`Mut<…>\`. A write through one of these, or through a local bound to one, is \`[member-write]\` or \`[mutating-method]\`. One of these given to a parameter typed \`Mut<…>\` is \`[type]\`.

Since 2026-11-23, a member write or a mutating method is accepted when its receiver is a fresh value made in the same expression (\`[...xs].sort()\`, \`xs.slice().reverse()\`, \`[...xs][0] = 1\`). No other name holds that value. Only the fresh value itself is such a receiver. These are not: a member of it, a conditional or \`??\` with a fresh branch, the result of a function that returns its argument, and the result of a mutating method (\`[...xs].sort().reverse()\`).

\`toSorted\`, \`toReversed\`, \`toSpliced\` and \`with\` return a new array. Typed arrays have \`toSorted\`, \`toReversed\` and \`with\`. The message of a write to a value that is not Mut names the applicable method.`
// %%
md`**S4.4** A \`Mut\` can be bound to a second name, put in an array or object literal, given to a parameter typed \`Mut<…>\` (which can write it), and given to any parameter of its plain type. Every name is the same value, and a write through one name is seen through the others.

The value that a cell exposes is read with every \`Mut\` removed. A cell that takes it gets a read-only value, and a write there is \`[member-write]\` or \`[mutating-method]\`. The \`Mut\` is removed at each place where S5.8 finds one. Since 2026-11-23, this includes the result of a function that the cell exposes. A cell that calls such a function gets a read-only result, even when the function made the result fresh. A parameter of an exposed function keeps its \`Mut\`, so a cell that calls the function gives a value of its own. \`Mut\` in the type of a cell input is \`[mut-cell]\`.`
// %%
md`**S4.5** A function is kept when it is returned, yielded, stored, or given to code that can call it later. These are not kept: a helper that is bound to a local \`const\` or declared with \`function\` and only called (S3.11), and a callback that an intrinsic calls before it returns. A kept function does not capture a \`Mut\` or a \`let\` of an enclosing function (S4.10). A capture of a \`Mut\` is always \`[mut-capture]\`. The message names the case when:

- the kept function writes the \`Mut\`, returns it or yields it;
- the \`Mut\` is written after the function is made: later in the text, in a loop that makes the function, or inside another function;
- the \`Mut\` is a typed array or a \`URL\` that a name in the cell can still write;
- in a generator cell or in a nested async or generator function, any \`Mut\` is written after the function is made.`
// %%
md`**S4.6** At run time, every value that a cell publishes is frozen when it is published, with everything that it reaches. A published value is:

- the value that a cell returns;
- each value that a generator cell yields;
- the value that a returned promise resolves to;
- a value written to a state cell;
- the arguments of an action;
- the arguments of a memoised function on a call with a new key (S2.13);
- the result of a worker.

A write to a published value, from any code, throws a \`TypeError\`. Before the freeze, a value written to a state cell and the arguments of an action are checked for a function or a promise made in a body that still runs (S4.12).

How values are frozen:

- Arrays, records, \`Error\`s and JSX elements are frozen.
- A \`Map\`, \`Set\` or \`URL\` made in a cell is an instance of a subclass. Its writing methods throw after it is frozen.
- The locals that a published function uses are frozen with it.
- A typed array or an \`ArrayBuffer\` is published as a copy. A container that reaches one is published as a frozen copy. The cell keeps its original.
- The \`searchParams\` of a \`URL\` is a copy made when it is read.

The publish throws, and the cell is in error, for:

- an iterator or a sync generator object (a cell whose value is one is \`[iterator-cell]\` first);
- a value with a callable \`then\` that is not a promise (as the full value of a cell, this is also \`[type]\`);
- a function, an \`Error\` or an already frozen value that reaches a typed array;
- a function that uses a binding that is not yet initialised.

Since 2026-11-24 (y1), a publish, the arguments of an action call and a value written to a state cell also throw for a response (from \`fetch\`), an async iterator or an async generator object, anywhere in the value. The checker gives each compiled cell one fact: whether the value type of the cell names a promise. When it names no promise, the value of the cell throws for:

- a promise anywhere in it;
- a promise as its full value, when the cell is not async;
- a generator object as its full value, when the cell is not a generator.

The type that the value had on its way makes no difference. This includes \`unknown\`, \`object\` and a type parameter, which the checker does not follow (S2.9, S9.6). The message names the value and the place, for example \`a response cannot leave its cell: … (the value of g, at value[0].r)\`. A publish that throws changes no value.`
// %%
md`**S4.7** Only the first level of an inferred \`Mut\` is writable. A write to a value held inside it, or a mutating method of such a value (\`m.a.b = 2\`, \`m.xs.push(2)\`, \`m.get(k).push(2)\`), is \`[member-write]\` or \`[mutating-method]\`. To write a value held inside a \`Mut\`, use a \`Mut\` local or parameter for that value. A written type holds a \`Mut\` only as its full type (S4.9).`
// %%
md`**S4.8** A view of a local buffer (\`subarray\`, \`buffer\`) can be bound and read. A write through it is \`[member-write]\`. A freeze does not stop a write to a typed array or the setters of a \`URL\`. Thus a generator cell that yields a typed array or a \`URL\` that it can still write is \`[mut-yield]\`, also when the value is inside a literal. These are accepted: a fresh copy (\`buf.slice()\` for a typed array, \`new URL(u.href)\` for a \`URL\`), a cell input, or a read-only \`const\` made from one.`
// %%
md`**S4.9** Since 2026-11-23, \`Mut<T>\` can be written only as:

- the full type of a parameter of a function or of a function type;
- the full type of a local;
- the full body of a type alias.

An alias whose body is \`Mut<…>\`, or another such alias, is a \`Mut\` and follows the same rule. \`Mut\` in any other position is \`[mut-nested]\`: in a record field, an array or tuple element, a type argument, a union member, the result of a function, the bound of a type parameter, or the body of an alias that is not \`Mut<…>\` itself. A \`typeof\` type in any position other than the allowed ones is also \`[mut-nested]\`, because it can hold a \`Mut\`. In the type of a cell input a \`Mut\` is \`[mut-cell]\` (S4.4). A function can return a \`Mut<…>\` parameter, and the checker then infers its result type.`
// %%
md`**S4.10** A kept function (S4.5) does not capture these, also when it only reads them:

- A \`Mut\` local of an enclosing function. This is \`[mut-capture]\` (since 2026-11-22).
- A local or a parameter of an enclosing function whose type holds a \`Mut\` (S5.8). This is \`[mut-capture]\` (since 2026-11-23). Such a type is inferred: \`[xs, 1] as const\`, \`{ k: xs } as const\`, \`xs.length > 0 ? xs : null\`, or the result of a generic helper called with \`xs\`, for a \`Mut\` local \`xs\`.
- A \`let\` of an enclosing function, of any type. This is \`[let-capture]\` (since 2026-11-22).
- A local that holds a promise. This is \`[mut-capture]\`.

A call of a helper that uses the local counts as a capture of the local.

A kept function can capture a \`const\` bound before the function, if S4.1 does not make the \`const\` writable, or the \`const\` has a primitive type: \`const c: [number[], 1] = t\`, \`const c: readonly number[] = out\`, \`const m: Map<string, number> = made\`, \`const c = n\` for a \`let n\`. \`const m: Map<string, number> = new Map()\` is writable (S4.1), and a capture of it is \`[mut-capture]\`.

Such a \`const\` names the same value as the \`Mut\`, and a write to \`out\` is seen through \`c\`. The capture is safe only because every write to \`out\` comes before the function is published. When the cell returns, the function of the cell has ended. While a function still runs, a function that it made cannot be given to a state cell or an action: that throws at run time (S4.12).`
// %%
md`**S4.11** A function does not write a local whose type holds a \`Mut\` (S5.8), or a \`Mut\` that it owns, after a point where it gives a value to a holder while it still runs.

Such a point is:

- a call of \`set\` or \`update\` of a state, or one of them read as a value (\`const st = s.set\`, \`[f].forEach(s.set)\`);
- a call of an action with arguments, or an action given to a call.

A call of a helper that has such a point puts the point at that call, when the helper is bound to a local \`const\` or declared with \`function\`. A callback that a built-in calls immediately does the same.

A write is after the point in the same sense as a use is after a \`yield\` in S5.6: later in the text, in an expression that holds the point, or in a loop around the point when the local is declared outside the body of that loop.

A write is a member write, an update, a \`delete\`, a mutating method, the local given to a parameter typed \`Mut<…>\`, or a call of a helper that writes the local. Such a write is \`[member-write]\`, or \`[mutating-method]\` when it is a call. Finish every write before the point. A new local declared after the point does not correct this, because it can be a second name for the same value.

The rule does not look at the value that is given. It finds points and writes by name. It does not see:

- a setter taken by destructuring (\`const { set } = s\`) or by a computed member (\`s['set']\`);
- a write through a name bound after the point (\`const ys = xs; ys.push(1)\`);
- a write through the result of a helper (\`get().push(1)\`);
- a write in a callback that a built-in calls more than one time.

In those programs the value of a holder still does not change. A function given while the body runs throws (S4.12), and data given there is frozen (S4.6), so the write throws.

A call of a memoised function is not such a point, because a call whose arguments reach a function stores nothing (S2.13).`
// %%
md`**S4.12** Since 2026-11-23, a function made while a body runs does not leave that body before the body ends.

At run time, two kinds of value are checked before they are frozen: a value written to a state cell (by \`set\`, or the result of the function of \`update\`), and the arguments of an action call. The check looks through arrays, records, \`Map\`s, \`Set\`s and \`Error\`s. If the value reaches a function or a promise that no finished cell has published, the check throws a \`TypeError\`, and nothing is frozen or written.

A finished cell has published a function or a promise when it is in the value of the cell, in the initial value of a state cell, or in a value that a generator cell yields. Thus these can be stored:

- a cell input: \`current.set(dec)\` for an input \`dec: Action<[]>\`;
- a function that the cell made before it returned and that its action captures, because that function was published with the action (S4.6).

The check does not read the captures of a function. The check does not go into a promise: the value that a promise settles to is frozen only when it settles, and the body can write that value before then.

This guarantee is a throw at run time, not a rejection at check time. A holder can get a function through a name that the checker does not follow, such as \`const st = s.set\`, \`const { set } = s\`, \`s['set']\`, a record field or a spread. The checker reports the cases that it sees as \`[fn-publish]\`. These are a \`set\` of a state, an \`update\` whose arrow returns the value, or an action call, that gets a function literal of the calling function at a parameter whose declared type holds a function. The literal can be inline, in an array, object or conditional expression, or a \`const\` of that function bound to a literal. The checker does not report a parameter type that hides a function by width, such as \`{ readonly n: number }\`. The throw still applies.

The arguments of a memoised call are not checked: a call whose arguments reach a function stores nothing (S2.13). S5.6 and S5.7 apply to the yields of a generator. The return of a cell ends its body.`
// %%
md`These are the cells of this section. \`s4_blur\` writes a box blur into a local buffer. \`s4_counts\` writes a local map through a helper that is only called (S4.5). \`s4_record\` deletes an optional member from a local object.`
// %%
