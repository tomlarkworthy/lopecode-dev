// %%
test_spec_S2_1 = {
  spec_is(spec_okCells("const double = () => (n: number) => n * 2;\nconst four = (double) => double(2);"), "double:ok,four:ok");
  spec_is(spec_okCells("const valueOf = () => 1;\nconst toString = (valueOf) => valueOf + 1;"), "valueOf:ok,toString:ok");
  spec_is(await spec_module.value("s2_answer"), 42);
  return `${spec_rejectsFor("S2.1")}; a function-valued cell is two arrows; cells named valueOf and toString are taken by name; s2_answer is 42`;
}
