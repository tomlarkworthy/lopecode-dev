  const fixed = "(a thrown value whose text cannot be read)";
  const m = soundscript.messageOf;
  const getter = Object.defineProperty(new Error("x"), "message", { get() { throw new Error("getter"); } });
  const toText = { toString() { throw new Error("toString"); } };
  spec_is([m(new TypeError("t")), m("s"), m(42), m(null), m(getter), m(toText), m(Object.create(null))], ["t", "s", "42", "null", fixed, fixed, fixed]);
