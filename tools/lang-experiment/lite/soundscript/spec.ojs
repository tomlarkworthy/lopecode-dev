  { statement: "S3.9", rule: "no-namespace", source: "namespace N {\n  const x = 1;\n}\nconst a = () => 1;" },
  { statement: "S3.9", rule: "no-namespace", source: "module M { const x = 1; }" },
  { statement: "S3.9", rule: "no-namespace", source: "declare module \"x\" {}" },
  { statement: "S3.11", rule: "let-capture", source: "const returned = () => {\n  let n = 0;\n  const inc = () => {\n    n = n + 1;\n  };\n  return inc;\n};" },
  { statement: "S3.11", rule: "let-capture", source: "const passed = () => {\n  let n = 0;\n  [1, 2].forEach((x) => {\n    n += x;\n  });\n  return n;\n};" },
  { statement: "S3.11", rule: "let-capture", source: "const stored = () => {\n  let [n] = [0];\n  const set = () => {\n    n = 1;\n  };\n  return { set };\n};" },
  { statement: "S3.11", rule: "let-capture", source: "const aliased = () => {\n  let n = 0;\n  const inc = () => {\n    n++;\n  };\n  const again = inc;\n  again();\n  return n;\n};" },
  { statement: "S3.11", rule: "let-capture", source: "const viaEscapingOuter = () => {\n  let n = 0;\n  const outer = () => {\n    const inner = () => {\n      n = 2;\n    };\n    inner();\n  };\n  return [outer];\n};" },
  { statement: "S3.12", rule: "strict-eq-object", source: "const xs = () => [1];\nconst ys = () => [1];\nconst same = (xs, ys) => xs === ys;" },
  { statement: "S3.12", rule: "strict-eq-object", source: "const xs = () => [1];\nconst ys = () => [1];\nconst loose = (xs, ys) => xs == ys || xs != ys || xs !== ys;" },
