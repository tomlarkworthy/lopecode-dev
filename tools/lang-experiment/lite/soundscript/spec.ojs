  { statement: "S3.11", rule: "possibly-undefined", source: "const a = () => {\n  let r: number | null = 1;\n  const clear = () => {\n    r = null;\n  };\n  if (r !== null) {\n    clear();\n    return r + 1;\n  }\n  return 0;\n};" },
  { statement: "S3.11", rule: "possibly-undefined", source: "const a = () => {\n  let r: { readonly n: number } | null = { n: 1 };\n  if (r !== null) {\n    clear();\n    return r.n;\n  }\n  function clear() {\n    r = null;\n  }\n  return 0;\n};" },
  { statement: "S3.11", rule: "no-member", source: "type U = { readonly ok: true; readonly value: number } | { readonly ok: false };\nconst a = () => {\n  const mk = (b: boolean): U => (b ? { ok: true, value: 1 } : { ok: false });\n  let r = mk(true);\n  const fail = () => {\n    r = mk(false);\n  };\n  if (r.ok) {\n    fail();\n    return r.value;\n  }\n  return 0;\n};" },
  { statement: "S3.11", rule: "let-capture", source: "const viaEscapingOuter = () => {\n  let n = 0;\n  const outer = () => {\n    const inner = () => {\n      n = 2;\n    };\n    inner();\n  };\n  return [outer];\n};" },
  { statement: "S3.11", rule: "type", source: "const g = async () => {\n  let r: number | string = 1;\n  const get = async () => {\n    if (typeof r === \"number\") {\n      await null;\n      return r + 1;\n    }\n    return 0;\n  };\n  const p = get();\n  r = \"s\";\n  return await p;\n};" },
  { statement: "S3.12", rule: "strict-eq-object", source: "const xs = () => [1];\nconst ys = () => [1];\nconst same = (xs, ys) => xs === ys;" },
