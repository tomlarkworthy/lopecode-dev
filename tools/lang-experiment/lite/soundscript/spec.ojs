// %%
spec_rejects_11_view = spec_rejectsTable(spec_rejects_11)
// %%
spec_load = async (source, outside) => {
  // source's SoundScript cells compiled and run in a module of their own beside outside, {name: [inputs,
  // function]}, plain variables standing for cells in other languages, or {name: {from: module}}, an
  // import of name from module; every variable observed
  const m = runtime.module();
  ss_instances.add(m);
  for (const n of soundscript.RUNTIME_CELLS) m.define(soundscript.INPUTS[n], [], () => soundscript[n]);
  for (const [n, x] of Object.entries(outside)) if (Array.isArray(x)) m.define(n, x[0], x[1]); else m.import(n, x.from);
  const list = ss_outside(m);
  const texts = soundscript.splitCells(source, true);
  const ctx = { ...soundscript.contextFromCheck(soundscript.checkCells(texts, true, list).result), module: ss_moduleName(m) };
  const defs = texts.flatMap((t) => soundscript.compileCell(t, true, ctx));
  const fns = await realize(defs.map((d) => d.definition), runtime);
  const vars = defs.map((d, i) => m.variable({}).define(d.name, d.inputs, fns[i]));
  return { module: m, value: (n) => m.value(n), dispose: () => { for (const v of [...runtime._variables]) if (v._module === m) { soundscript.release(v._value); v.delete(); } } };
}
// %%
test_spec_S11_1 = {
  const ok = spec_okCellsWith("const a = (rows: number[]) => rows.length;", [{ name: "rows" }]);
  if (ok !== "a:ok") throw new Error(ok);
  // now is the capability, a Clock, not the other language's number
  const cap = spec_rulesOf({ source: "const a = (now: number) => now;", outside: [{ name: "now" }] });
  if (JSON.stringify(cap) !== '["inject-type"]') throw new Error(`a capability named like another variable gave ${JSON.stringify(cap)}`);
  // count is the SoundScript cell, a number, not the other language's string (t1: a cell may not be named now, S2.10)
  const wins = spec_rulesOf({ source: "const count = () => 1;\nconst a = (count: string) => count;", outside: [{ name: "count" }] });
  if (JSON.stringify(wins) !== '["inject-type"]') throw new Error(`a cell named like another variable gave ${JSON.stringify(wins)}`);
  if ((await spec_module.value("s11_area")) !== 13) throw new Error("s11_area is not 13");
  return `${spec_rejectsFor("S11.1")}; a capability and a SoundScript cell named like another variable win; s11_area reads the raw s11_raw_area`;
}
// %%
test_spec_S11_2 = spec_rejectsFor("S11.2")
// %%
test_spec_S11_3 = {
  const ok = spec_okCellsWith('type R = { a: number; b?: string[] };\nconst f = (x: R | null, y: unknown, z: [number, "a" | "b"], w: boolean, u: undefined) => 1;', ["x", "y", "z", "w", "u"].map((name) => ({ name })));
  if (ok !== "f:ok") throw new Error(ok);
  const fns = spec_okCellsWith("type R = { n: number };\ntype F = (s: string) => R;\nconst f = (a: () => number, b: (s: string, n?: number) => R, c: (x: R[]) => Promise<R | null>, d: F, e: () => void) => 1;", ["a", "b", "c", "d", "e"].map((name) => ({ name })));
  if (fns !== "f:ok") throw new Error(fns);
  return `${spec_rejectsFor("S11.3")}; primitives, literals, unknown, tuples, optional properties and unions are accepted; a function type as the whole annotation, with an optional parameter, a Promise result, through an alias, and returning void, is accepted`;
}
// %%
test_spec_S11_3_recursive = {
  const ok = spec_okCellsWith("type Tree = { v: number; kids: Tree[] };\ntype Expr = Bin | Num;\ntype Bin = { type: \"bin\"; l: Expr; r: Expr };\ntype Num = { type: \"num\"; v: number };\nconst f = (x: Tree, y: Expr, z: Tree[] | null) => 1;", ["x", "y", "z"].map((name) => ({ name })));
  if (ok !== "f:ok") throw new Error(ok);
  return "a recursive alias, a mutually recursive union and an array of one are accepted";
}
// %%
test_spec_S11_4 = {
  let rows = [{ price: 1 }, { price: 2 }];
  const L = await spec_load("const total = (rows: { price: number }[]) => rows.reduce((a, r) => a + r.price, 0);\nconst other = (rows: unknown) => 7;", { rows: [[], () => rows] });
  try {
    if ((await L.value("total")) !== 3) throw new Error("total is not 3");
    L.module.redefine("rows", [], () => [{ price: 1 }, { price: "12" }]);
    let msg = null;
    try { await L.value("total"); } catch (e) { msg = e.message; if (!(e instanceof TypeError)) throw e; }
    if (msg !== 'rows[1].price: expected number, found string "12"') throw new Error(`gave ${msg}`);
    if ((await L.value("other")) !== 7) throw new Error("other is affected");
    L.module.redefine("rows", [], () => [{ price: 4 }]);
    if ((await L.value("total")) !== 4) throw new Error("total did not run again");
    if ((await spec_module.value("s11_total")) !== 3.5) throw new Error("s11_total is not 3.5");
    return msg;
  } finally { L.dispose(); }
}
// %%
test_spec_S11_4_cycle = {
  const loop = { v: 1, kids: [] };
  loop.kids.push({ v: 2, kids: [loop] });
  const L = await spec_load("type Tree = { v: number; kids: Tree[] };\nconst size = (tree: Tree) => tree.kids.length;", { tree: [[], () => loop] });
  try {
    let msg = null;
    try { await L.value("size"); } catch (e) { msg = e.message; if (!(e instanceof TypeError)) throw e; }
    if (msg !== "tree.kids[0].kids[0]: a cycle") throw new Error(`gave ${msg}`);
    return msg;
  } finally { L.dispose(); }
}
// %%
test_spec_S11_4_function = {
  const L = await spec_load("type M = { n: number };\nconst sized = (measure: (s: string) => M) => { try { return measure(\"abc\").n; } catch (e) { return typeof e === \"object\" && e !== null && \"message\" in e ? String(e.message) : \"no message\"; } };\nconst later = async (fetchM: (s: string) => Promise<M>) => (await fetchM(\"abc\")).n;", { measure: [[], () => () => ({ n: "3" })], fetchM: [[], () => async () => ({ n: 3 })] });
  try {
    spec_is(await L.value("sized"), 'measure(...).n: expected number, found string "3"');
    spec_is(await L.value("later"), 3);
    const boom = new Error("boom");
    L.module.redefine("measure", [], () => () => { throw boom; });
    spec_is(await L.value("sized"), "measure(...) threw: boom");
    const R = await spec_load("const raw = (measure: (s: string) => { n: number }) => measure(\"abc\").n;", { measure: [[], () => () => { throw boom; }] });
    try {
      let caught = null;
      try { await R.value("raw"); } catch (e) { caught = e; }
      if (!(caught instanceof TypeError) || caught === boom) throw new Error(`the uncaught throw is ${caught}`);
    } finally { R.dispose(); }
    L.module.redefine("fetchM", [], () => async () => ({ n: "3" }));
    let msg = null;
    try { await L.value("later"); } catch (e) { msg = e.message; if (!(e instanceof TypeError) || e === boom) throw e; }
    spec_is(msg, 'fetchM(...).n: expected number, found string "3"');
    L.module.redefine("measure", [], () => () => ({ get n() { throw boom; } }));
    spec_is(await L.value("sized"), "measure(...): reading the result threw: boom");
    return `a wrong result and a throw reach the cell as a TypeError: ${msg}; the async result resolves to 3 and rejects on a wrong one`;
  } finally { L.dispose(); }
}
// %%
test_spec_S11_4_function_reject = {
  // the rest of S11.4's function sentences; test_spec_S11_4_function is at the cell size limit
  const boom = new Error("no");
  const M = "type M = { n: number };\n";
  const A = await spec_load(M + "const later = async (fetchM: (s: string) => Promise<M>) => (await fetchM(\"abc\")).n;", { fetchM: [[], () => async () => { throw boom; }] });
  const S = await spec_load(M + "const atCall = (fetchM: (s: string) => Promise<M>) => { try { fetchM(\"a\"); return \"no throw\"; } catch (e) { return messageOf(e); } };\nconst uncaught = (fetchM: (s: string) => Promise<M>) => { fetchM(\"a\"); return 1; };", { fetchM: [[], () => () => { throw boom; }] });
  try {
    let caught = null;
    try { await A.value("later"); } catch (e) { caught = e; }
    if (!(caught instanceof TypeError) || caught === boom) throw new Error(`the rejection is ${caught}`);
    spec_is(caught.message, "fetchM(...) threw: no");
    spec_is(await S.value("atCall"), "fetchM(...) threw: no");
    caught = null;
    try { await S.value("uncaught"); } catch (e) { caught = e; }
    if (!(caught instanceof TypeError) || caught === boom) throw new Error(`the synchronous throw is ${caught}`);
    return "a rejected promise rejects the cell's promise with a TypeError naming the function; a synchronous throw from a function typed as returning a promise is thrown at the call as a TypeError";
  } finally { A.dispose(); S.dispose(); }
}
// %%
test_spec_S11_5_function_this = {
  // strict: the function sees this as undefined; sloppy (new Function): JavaScript gives it globalThis instead
  const L = await spec_load("const strict = (probe: () => boolean) => probe();\nconst sloppy = (loose: () => boolean) => loose();", { probe: [[], () => function () { "use strict"; return this === undefined; }], loose: [[], () => new Function("return this === undefined")] });
  try {
    spec_is(await L.value("strict"), true);
    spec_is(await L.value("sloppy"), false);
    return "the function is called with this undefined: a strict function sees undefined, a sloppy one globalThis";
  } finally { L.dispose(); }
}
// %%
test_spec_S11_5 = {
  const L = await spec_load("const keep = (o: { xs: number[] }) => o;\nconst whole = (u: unknown) => u;\nconst fn = (f: unknown) => 1;\nconst either = (e: { a: number } | { a: string }, q: number[] | string[]) => [e.a, q.length];", { o: [[], () => ({ xs: [1], extra: 2 })], u: [[], () => ({ a: [1, { b: 2 }] })], f: [[], () => () => 1], e: [[], () => ({ a: "x" })], q: [[], () => ["y"]] });
  try {
    const o = await L.value("keep"), u = await L.value("whole");
    if (!Object.isFrozen(o) || !Object.isFrozen(o.xs) || "extra" in o) throw new Error(`o is ${JSON.stringify(o)}, frozen ${Object.isFrozen(o)}`);
    if (!Object.isFrozen(u.a[1]) || JSON.stringify(u) !== '{"a":[1,{"b":2}]}') throw new Error(`u is ${JSON.stringify(u)}`);
    let msg = null;
    try { await L.value("fn"); } catch (e) { msg = e.message; }
    if (msg !== "f: expected data, found a function") throw new Error(`f gave ${msg}`);
    const ev = await L.value("either");
    if (JSON.stringify(ev) !== '["x",1]') throw new Error(`a union of objects or of arrays gave ${JSON.stringify(ev)}`);
    return `a frozen copy with the declared properties; unknown copied whole; ${msg}`;
  } finally { L.dispose(); }
}
// %%
test_spec_S11_5_recursive = {
  let shared = { v: 0, kids: [] };
  for (let i = 1; i <= 30; i++) shared = { v: i, kids: [shared, shared] };
  let deep = { v: 0, kids: [] };
  for (let i = 1; i <= 10000; i++) deep = { v: i, kids: [deep] };
  const L = await spec_load("type Tree = { v: number; kids: Tree[] };\nconst keep = (t: Tree) => t;\nconst depth = (d: Tree) => d;", { t: [[], () => shared], d: [[], () => deep] });
  try {
    const t = await L.value("keep");
    if (t === shared || !Object.isFrozen(t) || !Object.isFrozen(t.kids) || !Object.isFrozen(t.kids[0].kids[1])) throw new Error("not a frozen copy");
    if (t.kids[0] !== t.kids[1] || t.kids[0].kids[0] !== t.kids[0].kids[1]) throw new Error("a shared object was copied twice");
    let n = 0;
    for (let at = await L.value("depth"); at.kids.length; at = at.kids[0]) { if (!Object.isFrozen(at)) throw new Error(`not frozen at depth ${n}`); n++; }
    if (n !== 10000) throw new Error(`the copy is ${n} deep`);
    return "a tree of 2^30 paths over 31 objects is copied once per object, frozen, with its sharing; a tree 10000 deep crosses";
  } finally { L.dispose(); }
}
// %%
test_spec_S11_5_function = {
  let got = null;
  const L = await spec_load("type Box = { xs: number[] };\nconst box = (): Box => ({ xs: [1, 2] });\nconst kept = (store: (b: Box) => number, box: Box) => [store(box), box.xs.length];", { store: [[], () => (b) => { got = b; return b.xs.length; }] });
  try {
    spec_is(await L.value("kept"), [2, 2]);
    if (got === (await L.value("box")) || !Object.isFrozen(got) || !Object.isFrozen(got.xs)) throw new Error("the argument is not a frozen copy");
    const m = await spec_module.value("s11_measured");
    spec_is(m, { n: 3, s: "tea" });
    if (!Object.isFrozen(m)) throw new Error("s11_measured is not frozen");
    return "the function gets a frozen copy of the argument, not the cell's value; s11_measured, calling the Observable JavaScript s11_measure, is a frozen {n: 3, s: \"tea\"}";
  } finally { L.dispose(); }
}
// %%
test_spec_S11_6_function = {
  const raw = (s) => ({ n: s.length });
  const L = await spec_load("type M = { n: number };\nconst w = (f: (s: string) => M) => f;", { tick: [[], () => 0], f: [["tick"], () => raw] });
  try {
    const a = await L.value("w");
    L.module.redefine("tick", [], () => 1);
    const b = await L.value("w");
    L.module.redefine("f", [], () => (s) => ({ n: 0 }));
    const c = await L.value("w");
    L.module.redefine("f", ["tick"], () => raw);
    const d = await L.value("w");
    if (a !== b || a === c || a === raw || d === a || d === c) throw new Error(`same ${a === b}, new ${a !== c}, raw ${a === raw}, back ${d !== a}`);
    // a second module with a cell and parameter of the same names, delivering its own function in turn with L's
    const other = (s) => ({ n: 1 });
    const M = await spec_load("type M = { n: number };\nconst w = (f: (s: string) => M) => f;", { tick: [[], () => 0], f: [["tick"], () => other] });
    try {
      const m1 = await M.value("w");
      L.module.redefine("tick", [], () => 2);
      const d2 = await L.value("w");
      M.module.redefine("tick", [], () => 1);
      if (d2 !== d || (await M.value("w")) !== m1 || m1 === d) throw new Error(`per module: L ${d2 === d}, M ${(await M.value("w")) === m1}`);
    } finally { M.dispose(); }
    return "the same function delivered again is the same function to the cell, also when another module's cell and parameter of the same names is delivered one in between; another function is a new one, and so is the first one delivered after it; none is the raw function";
  } finally { L.dispose(); }
}
// %%
test_spec_S11_6 = {
  const rows = [{ price: 1 }];
  const L = await spec_load("const total = (rows: { price: number }[]) => rows.reduce((a, r) => a + r.price, 0);", { rows: [[], () => rows] });
  try {
    await L.value("total");
    const v = [...runtime._variables].find((x) => x._module === L.module && x._name === "total");
    const runs = await spec_runs(v);
    rows[0].price = 5;
    L.module.redefine("rows", [], () => rows);
    if ((await L.value("total")) !== 5) throw new Error("a value changed in place was not seen");
    L.module.redefine("rows", [], () => [{ price: 5 }]);
    if ((await L.value("total")) !== 5) throw new Error("total");
    const more = (await spec_runs(v)) - runs;
    // the runtime runs a cell again when an input's variable runs again, equal value or not
    if (more !== 2) throw new Error(`total ran ${more} more times, expected 2`);
    return "changed in place: seen; equal again: run again, and still 5";
  } finally { L.dispose(); }
}
// %%
test_spec_S11_7 = {
  const bump = [...runtime._variables].find((v) => v._module === spec_module && v._name === "s11_bump");
  const inputs = bump._inputs.map((i) => i._name);
  if (!inputs.includes("viewof s11_level") || typeof (await spec_module.value("s11_bump")) !== "function" || typeof (await spec_module.value("s11_shown")) !== "number") throw new Error(`s11_bump takes ${inputs.join(", ")}`);
  // a state cell imported from another module
  const A = await spec_load("const count = (): StateCell<number> => state(0);", {});
  try {
    const B = await spec_load("const add = (count: State<number>) => action((k: number) => count.update((c) => c + k));\nconst seen = (count: number) => count;", { count: { from: A.module }, "viewof count": { from: A.module } });
    try {
      spec_is(ss_outside(B.module).find((o) => o.name === "count"), { name: "count", view: true });
      const add = await B.value("add");
      add(5);
      await spec_flush();
      spec_is([await A.value("count"), await B.value("seen")], [5, 5]);
    } finally { B.dispose(); }
  } finally { A.dispose(); }
  return `${spec_rejectsFor("S11.7")}; s11_bump takes viewof s11_level as State<number> through an input on it, s11_shown its value; add, in another module, takes the imported state cell count as State<number> through its imported viewof count and writes it (5)`;
}
// %%
test_spec_S11_8 = {
  const el = await spec_module.value("viewof s11_level");
  const bump = await spec_module.value("s11_bump"), big = await spec_module.value("s11_big");
  const handle = soundscript.viewRef(el, { k: "num" }, "s11_level");
  const readNow = () => { let v; soundscript.action(() => { v = soundscript.read(handle); })(); return v; };
  const was = el.value;
  const flushed = () => new Promise((r) => setTimeout(r, 0)).then(() => new Promise((r) => setTimeout(r, 0)));
  // a change on the control
  el.value = 2; el.dispatchEvent(new Event("input", { bubbles: true }));
  await flushed();
  if (readNow() !== 2) throw new Error(`after the control's change the State holds ${readNow()}`);
  let inputs = 0;
  const count = () => inputs++;
  el.addEventListener("input", count);
  try {
    bump();
    await flushed();
    if (el.value !== 5 || inputs !== 1 || readNow() !== 5) throw new Error(`after bump: control ${el.value}, ${inputs} input events, State ${readNow()}`);
    big();
    await flushed();
    if (el.value !== 10 || readNow() !== 10) throw new Error(`after big: control ${el.value}, State ${readNow()}`);
  } finally {
    el.removeEventListener("input", count);
    el.value = was; el.dispatchEvent(new Event("input", { bubbles: true }));
  }
  return "the control's change reaches the State; a write sets the control and dispatches one input; set(99) holds 10";
}
// %%
test_spec_S11_8_object = {
  // a view whose value is an array: a change on the control is not echoed back; a write dispatches one input
  const el = Object.assign(new EventTarget(), { value: [1, 2] });
  const L = await spec_load("const len = (picked: number[]) => picked.length;\nconst clear = (picked: State<number[]>) => action(() => picked.set([]));", { "viewof picked": [[], () => el], picked: [["viewof picked"], async function* (v) { yield v.value; for (;;) yield await new Promise((r) => v.addEventListener("input", () => r(v.value), { once: true })); }] });
  try {
    let inputs = 0;
    el.addEventListener("input", () => inputs++);
    el.value = [1, 2, 3]; el.dispatchEvent(new Event("input"));
    await spec_flush();
    spec_is([inputs, await L.value("len")], [1, 3]);
    const clear = await L.value("clear");
    clear();
    await spec_flush();
    spec_is([inputs, el.value, await L.value("len")], [2, [], 0]);
    return "the control's change: one input event, len 3; clear: one more input event, the control holds [], len 0";
  } finally { L.dispose(); }
}
// %%
test_spec_S11_9 = {
  // a state cell made from the function is refused; one made from its result is read inside an action
  const r = soundscript.checkSources({ cells: "const box = (g: () => number) => state(g);\nconst n = () => state(0);\nconst run = (box: State<() => number>, n: State<number>) => action(() => n.set(read(box)()));", tsx: true, outside: [{ name: "g" }] });
  const got = r.cells.map((c) => `${c.name}:${c.status}${c.errors.map((e) => ` [${e.rule}]`).join("")}`).join(",");
  if (got !== "box:rejected [action-capture],n:ok,run:ok") throw new Error(got);
  const ok = spec_okCellsWith("const box = (g: () => number) => state(g());\nconst n = () => state(0);\nconst run = (box: State<number>, n: State<number>) => action(() => n.set(read(box)));", [{ name: "g" }]);
  if (ok !== "box:ok,n:ok,run:ok") throw new Error(ok);
  return `${spec_rejectsFor("S11.9")}; a state cell made from a function of another language is [action-capture]; one made from its result, read inside an action, is accepted`;
}
// %%
test_spec_S11_10 = {
  const name = (n) => [...runtime._variables].find((v) => v._module === spec_module && v._name === n);
  const rejected = () => soundscript.compiledKind(String(name("s11_late_twice")?._definition))?.callee === "rejected";
  const until = async (f) => { for (let i = 0; i < 200 && !f(); i++) await new Promise((r) => setTimeout(r, 50)); return f(); };
  // edits run one at a time; the module is first settled, so the wait is for this test's change alone
  await ss_language.settle(spec_module);
  if (!rejected()) throw new Error("s11_late_twice runs before s11_late exists");
  const late = spec_module.variable({}).define("s11_late", [], () => 21);
  try {
    if (!(await until(() => !rejected()))) throw new Error("s11_late_twice was not checked again when s11_late was added");
    if ((await spec_module.value("s11_late_twice")) !== 42) throw new Error("s11_late_twice is not 42");
    // renamed: s11_late no longer exists
    late.define("s11_late_renamed", [], () => 21);
    if (!(await until(rejected))) throw new Error("s11_late_twice was not checked again when s11_late was renamed");
    late.define("s11_late", [], () => 21);
    if (!(await until(() => !rejected()))) throw new Error("s11_late_twice was not checked again when the name came back");
  } finally { late.delete(); }
  if (!(await until(rejected))) throw new Error("s11_late_twice was not checked again when s11_late was deleted");
  return "rejected; 42 once s11_late was added; rejected once it was renamed; 42 when renamed back; rejected once it was deleted";
}
// %%
test_spec_S11_11 = {
  let k = 0;
  const L = await spec_load("type M = { n: number };\nconst twice = (count: (s: string) => M) => [count(\"a\").n, count(\"a\").n];", { count: [[], () => () => ({ n: ++k })] });
  try {
    spec_is(await L.value("twice"), [1, 2]);
    return "two calls with equal arguments gave [1, 2]: equal results are trusted, not checked";
  } finally { L.dispose(); }
}
// %%
md`## Not specified

Behaviour the code has today that this page does not promise. Each item is undecided or unfinished, and none should be relied on.`
// %%
md`- A \`Mut\` in a parameter of a function's parameter is not removed (S4.4). A cell that takes \`(cb: (x: Mut<number[]>) => void) => void\` from another cell may write what that function passes to \`cb\`. Under S4.10 that value is fresh or one the calling cell gave, since a kept function cannot capture a shared \`Mut\`. Whether S4.4 should remove it is not decided. Found 2026-11-23.`
// %%
md`- A \`Mut\` in the result of a function from another language (section 11) is kept: \`lib.get().push(1)\` for a foreign \`get: () => Mut<number[]>\` is accepted, and so is a write to a \`Mut\` field of such a result. S4.4 removes a \`Mut\` only from what a SoundScript cell exposes. Out of scope by the owner's ruling (2026-11-23).`
// %%
md`- A function from another language is not a point of S4.11, and S4.12 does not check a call of one. A cell that passes a function over a read-only name, or the \`Mut\` itself, to such a function and writes the \`Mut\` later in the same body is accepted; whether the foreign function keeps what it was given is not known to the checker.`
// %%
md`- \`DataView\`, \`TextEncoder\`, \`TextDecoder\` and \`Symbol\` were on the first list of allowed intrinsics (the tutorial's rule list), but the checker has no signatures for them: reading one leaves the cell unsupported, and \`new\` on one is \`[new-non-intrinsic]\`.`
// %%
md`- \`BigInt64Array\` and \`BigUint64Array\` are \`[free-name]\`: the checker models the other nine typed arrays (S2.6) but not these two. Whether they should be allowed is not decided.`
// %%
md`- \`prototype\` read through a value's \`constructor\`, such as \`[].constructor.prototype\`, leaves the cell unsupported: neither \`[banned-member]\` (S2.7) nor another rule rejects it, and in a notebook module the cell is rejected (S8.2).`
// %%
md`- \`Object.assign\` onto a fresh literal (\`Object.assign({}, o)\`) and \`satisfies\` leave the cell unsupported: the checker neither accepts nor rejects it. In a notebook module such a cell is rejected (S8.2).`
// %%
md`- An angle-bracket cast \`<number>e\` is \`[no-cast]\` when the module is checked without JSX; a notebook module is checked with JSX, where it does not parse.`
// %%
md`- How many times a listener cell runs again when its events cell stops and starts again (S7.5). By S8.4 it runs at least once for each run of the events cell; \`test_spec_S7_5\` reports the count and does not assert it. The counts recorded on 2026-11-16 (once in one load, none in another) were taken while cells were memoised, which ended on 2026-11-19.`
// %%
md`- A write to a state cell while it is computing again, after an input changed and before the cell has run (S6.2). Today it goes to the state cell as it was, and is kept only if the cell runs again with the same inputs.`
// %%
md`- An \`Action\` held in a state cell (an undo stack, a current tool). The checker accepts it; what the state cell holds after the action's cell is edited or deleted is observed, not decided.`
// %%
md`- The order of listeners in different modules. The runtime orders them by module name and then by place; a module with no name, such as one made for a test, is given a random one.`
// %%
md`- An async generator as an events cell. The checker takes only a sync generator as \`Events\` (S7.1); the runtime also delivers an async generator's values.`
// %%
md`- A type declared twice: the first is used, and the second is a module-level \`[duplicate-cell]\` with no line of the first.`
// %%
md`- A top-level \`declare const\` is \`[module-level]\` today (S1.4). Whether an ambient declaration belongs in a module of cells is not decided.`
// %%
md`- A cell in another language read by an island of \`compile(...)\`. Today it is rejected: naming one, say \`k\`, as an island input is \`[compile-island]\` with the message "no cell k".`
// %%
md`- \`compile(...)\` and \`pool\` beyond S2.5 and S8.7. The checker has three rules for them that no statement gives: \`[compile-island]\` (an island that is not a set of ok, synchronous cells), \`[compile-options]\` (options other than \`{ runtime?: Pool }\`) and \`[compile-boundary]\` (an island input that cannot be sent to a worker, such as a function).`
// %%
md`- A dependency cycle that passes through a cell in another language. The checker is given only the names of those cells, not their inputs, so it cannot see one.`
// %%
md`- A DOM node from another language placed in JSX.`
// %%
md`- A listener while an input of its events cell throws. The events cell does not run again, and a listener that was waiting for that run keeps receiving what the old generator yields until the listener cell runs again or is deleted (measured 2026-11-20: 30 values over 30 rounds).`
// %%
md`- Which requests an async cell makes when its input changes while it is waiting. The Runtime runs only the latest input after the pending one, so a request can be skipped, and a request whose input is a state cell can be made twice. \`spec_s6_latestWins\` and \`spec_s6_everyAnswer\` are the two ways to write a program that does not depend on this.`
// %%
md`- A handler that makes several top-level calls, such as \`onClick={() => { begin(); load(); }}\`. An event attribute takes one action, so this is not provided.`
// %%
md`- A change the user makes on a view's control while an action call that wrote the view is waiting to commit. Today the commit replaces the user's change.`
// %%
md`- Which value a state cell ends with when two async cells each feed a listener that writes it: each writes when its fetch answers, so the state cell keeps the value of the response that arrived last, and that order is not specified.`
// %%
md`- An action taken before its state cell went into error, and called while the state cell is in error. Today it writes the state cell's last store, and the write is kept if the state cell is repaired with the same inputs.`
// %%
spec_coverage = Generators.observe((notify) => {
  // drawn again when a test settles and when a cell of this module is added, edited or deleted; a test that
  // has not settled is shown as running, so a hung test does not hold the table
  const status = new Map();
  let queued = false;
  const draw = () => { queued = false; notify(spec_coverageOf(status, redraw)); };
  const redraw = () => { if (!queued) { queued = true; queueMicrotask(draw); } };
  redraw();
  return onCodeChange(({ variable, previous }) => { if ((variable ?? previous)?._module === spec_module) redraw(); });
})
// %%
spec_coverageOf = (status, redraw) => {
  // statements are the **S<n>.<m>** marks in this module's cells; a test names the statements it checks
  // (test_spec_S1_2 checks S1.2); a test passes if its value resolves. status: name -> { definition, state }
  const vars = [...runtime._variables].filter((v) => v._module === spec_module);
  const titles = new Map(), statements = new Map();
  for (const v of vars) {
    const text = String(v._definition);
    for (const m of text.matchAll(/## (\d+)\. ([^\n`]+)/g)) titles.set(m[1], m[2].trim());
    for (const m of text.matchAll(/\*\*S(\d+)\.(\d+)\*\*/g)) statements.set(`S${m[1]}.${m[2]}`, m[1]);
  }
  const tests = vars.filter((v) => typeof v._name === "string" && v._name.startsWith("test_spec_"));
  for (const t of tests) {
    if (status.get(t._name)?.definition === t._definition) continue;
    const entry = { definition: t._definition, state: "running" };
    status.set(t._name, entry);
    const done = (state) => () => { if (status.get(t._name) === entry) { entry.state = state; redraw(); } };
    spec_module.value(t._name).then(done("pass"), done("fail"));
  }
  const names = new Map(tests.map((t) => [t._name, [...t._name.matchAll(/S(\d+)_(\d+)/g)].map((m) => `S${m[1]}.${m[2]}`)]));
  const rows = [...titles].map(([section, title]) => {
    const ids = [...statements].filter(([, s]) => s === section).map(([id]) => id);
    const own = tests.filter((t) => names.get(t._name).some((id) => statements.get(id) === section));
    const tested = ids.filter((id) => own.some((t) => names.get(t._name).includes(id)));
    const count = (state) => own.filter((t) => status.get(t._name)?.state === state).length;
    return { section, title, statements: ids.length, tested: tested.length, tests: own.length, passing: count("pass"), running: count("running"), untested: ids.filter((id) => !tested.includes(id)) };
  });
  const unknown = [...names].flatMap(([n, ids]) => ids.filter((id) => !statements.has(id)).map((id) => `${n} (${id})`));
  return { rows, unknown };
}
// %%
viewof spec_module = thisModule()
// %%
import { soundscript, ss_instances, ss_language, ss_check, ss_outside, ss_moduleName } from "@tomlarkworthy/soundscript"
// %%
import { thisModule, runtime, realize, onCodeChange, observe } from "@tomlarkworthy/runtime-sdk"
// %%
import { linkTo } from "@tomlarkworthy/lopepage-urls"
