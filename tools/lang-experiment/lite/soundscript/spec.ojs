  { statement: "S3.7", rule: "no-ts-ignore", source: "const a = () => {\n  // @ts-ignore\n  return 1;\n};" },
  { statement: "S3.7", rule: "no-ts-ignore", source: "const b = () => {\n  // @ts-expect-error\n  return 1;\n};" },
  { statement: "S3.7", rule: "no-ts-ignore", source: "const a = () => 1;\n// @ts-nocheck" },
