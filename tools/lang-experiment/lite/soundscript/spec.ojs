// %%
test_spec_S6_10 = {
  const L = await spec_load(`const p = (): StateCell<number> => state(100);
const q = (): StateCell<number> => state(0);
const r = (): StateCell<number> => state(0);
const s = (): StateCell<number> => state(1);
const setQ = (q: State<number>) => action(() => q.set(7));
const transfer = (p: State<number>) => action(() => { p.update((v) => v - 10); throw new Error("midway"); });
const failing = (r: State<number>) => action(() => { r.set(2); throw new Error("inner"); });
const catches = (q: State<number>, failing: Action<[]>) => action(() => { q.update((v) => v + 1); try { failing(); } catch (e) {} q.update((v) => v + 1); });
const breaks = (p: State<number>) => action(() => p.update((v) => { if (v > -1) throw new Error("in update"); return v; }));
const step = (s: State<number>) => action((k: number) => s.update((v) => v * 2 + k));
const wraps = (setQ: Action<[]>, r: State<number>) => action(() => { setQ(); r.update((v) => { if (v > -1) throw new Error("outer broke"); return v; }); });
const all = (p: number, q: number, r: number, s: number) => [p, q, r, s];`, {});
  try {
    const call = async (n, ...a) => { const f = await L.value(n); let msg = ""; try { await spec_act(() => f(...a)); } catch (e) { msg = e.message; } await spec_flush(); return msg; };
    spec_is(await call("setQ"), "");
    spec_is(await call("transfer"), "midway");
    spec_is(await L.value("all"), [100, 7, 0, 1]);
    spec_is(await call("catches"), "");
    spec_is(await L.value("all"), [100, 9, 2, 1]);
    spec_is(await call("breaks"), "in update");
    for (const k of [1, 2, 3]) await call("step", k);
    spec_is(await L.value("all"), [100, 9, 2, ((1 * 2 + 1) * 2 + 2) * 2 + 3]);
    spec_is(await call("wraps"), "outer broke");
    spec_is(await L.value("all"), [100, 9, 2, 19]);
    return "a throwing call keeps none of its writes or its callees' (transfer, wraps); a callee that throws inside a call that catches it keeps its writes (failing's r is 2); an earlier call's write stays; an update that throws throws at the call; calls apply in order (s is 19)";
  } finally { L.dispose(); }
}
// %%
test_spec_S6_11 = {
  const E = await spec_editor([
    "const base = () => 1;",
    "const n = (base: number): StateCell<number> => state(base);",
    "const other = (): StateCell<number> => state(0);",
    "const both = (n: State<number>, other: State<number>) => action(() => {\n  other.update((v) => v + 1);\n  n.update((v) => v + 1);\n});",
    "const pair = (n: number, other: number) => [n, other];"
  ]);
  try {
    const call = async () => { const f = await E.value("both"); if (typeof f !== "function") return f; await spec_act(() => f()); await spec_flush(); return ""; };
    const before = await E.value("both");
    spec_is([await call(), await E.value("pair")], ["", [2, 1]]);
    // made again from a new input: the handle is the same, so the State taken before writes the new state cell
    await E.edit("base", "const base = () => 5;");
    spec_is([(await E.value("both")) === before, await call(), await E.value("pair")], [true, "", [6, 2]]);
    // an input that throws: the cell holding n's State is blocked by it
    await E.edit("base", 'const base = (): number => {\n  throw new Error("broken base");\n};');
    spec_is(await call(), { error: "broken base" });
    // after the error n has a new handle, and its holder runs again with it
    await E.edit("base", "const base = () => 7;");
    spec_is([(await E.value("both")) === before, await call(), await E.value("pair")], [false, "", [8, 3]]);
    // the state cell does not check: the holder is blocked by it
    await E.edit("n", 'const n = (base: number): StateCell<number> => state("x");');
    spec_is([E.states().n, E.states().both, E.states().pair], ["rejected", "blocked by n", "blocked by n"]);
    const rejected = await call();
    if (!/^n does not check: \[/.test(rejected.error ?? "")) throw new Error(`with n rejected: ${JSON.stringify(rejected)}`);
    // not defined
    E.variable("n").delete();
    E.variable("viewof n").delete();
    const missing = await call();
    if (!/viewof n is not defined/.test(missing.error ?? "")) throw new Error(`with n deleted: ${JSON.stringify(missing)}`);
    spec_is(await E.value("other"), 3);
    return `the holder of n's State is blocked when an input threw, when n does not check (${rejected.error}) and when it is not defined (${missing.error}); a State taken before n was made again writes the new n`;
  } finally { E.dispose(); }
}
