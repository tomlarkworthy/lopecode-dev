// %%
test_spec_S9_1 = {
  for (const source of ["const b = (raw) => (typeof raw === \"number\" ? raw + 1 : 0);", "const b = (raw: unknown) => 1;", "const b = (raw: Js) => 1;"]) {
    const r = soundscript.checkSources({ cells: source, shell: "export let raw = () => JSON.parse(\"1\");", tsx: true });
    spec_is(r.cells.map((c) => `${c.name}:${c.status}:${c.errors.length}`), ["b:ok:0"]);
  }
  spec_is(spec_rulesOf({ source: "const b = (raw) => raw + 1;", shell: "export let raw = () => 1;" }), ["type"]);
  const fn = soundscript.checkSources({ cells: "type F = (s: string) => number;\nconst b = (raw: (s: string) => number) => raw(\"ab\");\nconst c = (raw: F) => raw(\"a\");", shell: "export let raw = (s) => s.length;", tsx: true });
  spec_is(fn.cells.map((c) => `${c.name}:${c.status}:${c.errors.length}`), ["b:ok:0", "c:ok:0"]);
  const inRec = soundscript.checkSources({ cells: "const b = (raw: { run: () => number }) => 1;", shell: "export let raw = (s) => s.length;", tsx: true });
  spec_is(inRec.cells[0].errors.map((e) => e.msg), ["raw: unknown is not assignable to { run: () => number }"]);
  return `${spec_rejectsFor("S9.1")}; no annotation, unknown and Js are accepted, and an unannotated input is unknown (raw + 1 is [type]); a function type, written out or as an alias, is accepted; a function inside an object is [inject-type]`;
}
// %%
test_spec_S9_2 = {
  spec_is(spec_okCellsWith("type S = { readonly w: number; readonly h: number };\nconst decode = () => (x: unknown): S => {\n  if (typeof x !== \"object\" || x === null) throw new Error(\"not an object\");\n  if (!(\"w\" in x) || typeof x.w !== \"number\") throw new Error(\"w\");\n  if (!(\"h\" in x) || typeof x.h !== \"number\") throw new Error(\"h\");\n  return { w: x.w, h: x.h };\n};\nconst n = () => (x: unknown) => (Array.isArray(x) ? x.length : 0);", []), "decode:ok,n:ok");
  spec_is(await spec_module.value("s9_size"), { w: 3, h: 1.5 });
  return `${spec_rejectsFor("S9.2")}; a decoder narrowing with typeof, in and Array.isArray is accepted; s9_size is {w:3,h:1.5}, without extra`;
}
// %%
test_spec_S9_3 = {
  const rules = (cells, foreign) => { const r = soundscript.checkSources({ cells, foreign, tsx: true }); return [...r.module, ...r.cells.flatMap((c) => c.errors)].map((e) => e.rule).sort(); };
  spec_is(rules("const a = () => 1;", "declare const thing: number;"), ["foreign-unmarked"]);
  spec_is(rules("const a = (send) => typeof send;", "/** effect */\ndeclare const send: (s: string) => void;"), ["foreign-effect"]);
  spec_is(rules("const a = (lib: number) => lib + 1;", "/** pure */\ndeclare const lib: number;"), []);
  spec_is(rules("const href = (location) => location.myHref;\nconst b = (href: string) => href;", "/** pure */\ndeclare const location: { readonly myHref: string };"), []);
  return "unmarked: [foreign-unmarked]; an effect foreign taken: [foreign-effect]; a pure one, and one named like a global, accepted";
}
