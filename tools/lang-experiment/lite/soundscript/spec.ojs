test_spec_S9_1 = {
  for (const source of ["const b = (raw) => (typeof raw === \"number\" ? raw + 1 : 0);", "const b = (raw: unknown) => 1;", "const b = (raw: Js) => 1;"]) {
    const r = soundscript.checkSources({ cells: source, shell: "export let raw = () => JSON.parse(\"1\");", tsx: true });
    spec_is(r.cells.map((c) => `${c.name}:${c.status}:${c.errors.length}`), ["b:ok:0"]);
  }
  spec_is(spec_rulesOf({ source: "const b = (raw) => raw + 1;", shell: "export let raw = () => 1;" }), ["type"]);
  const fn = soundscript.checkSources({ cells: "type F = (s: string) => number;\nconst b = (raw: (s: string) => number) => raw(\"ab\");\nconst c = (raw: F) => raw(\"a\");", shell: "export let raw = (s) => s.length;", tsx: true });
  spec_is(fn.cells.map((c) => `${c.name}:${c.status}:${c.errors.length}`), ["b:ok:0", "c:ok:0"]);
  const inRec = soundscript.checkSources({ cells: "const b = (raw: { run: () => number }) => 1;", shell: "export let raw = (s) => s.length;", tsx: true });
  spec_is(inRec.cells[0].errors.map((e) => e.msg), ["raw: unknown is not assignable to { run: () => number }"]);
  return `${spec_rejectsFor("S9.1")}; no annotation, unknown and Js are accepted, and an unannotated input is unknown (raw + 1 is [type]); a function type, written out or as an alias, is accepted; a function inside an object is [inject-type]`;
}
// %%
test_spec_S9_2 = {
  spec_is(spec_okCellsWith("type S = { readonly w: number; readonly h: number };\nconst decode = () => (x: unknown): S => {\n  if (typeof x !== \"object\" || x === null) throw new Error(\"not an object\");\n  if (!(\"w\" in x) || typeof x.w !== \"number\") throw new Error(\"w\");\n  if (!(\"h\" in x) || typeof x.h !== \"number\") throw new Error(\"h\");\n  return { w: x.w, h: x.h };\n};\nconst n = () => (x: unknown) => (Array.isArray(x) ? x.length : 0);", []), "decode:ok,n:ok");
  spec_is(await spec_module.value("s9_size"), { w: 3, h: 1.5 });
  return `${spec_rejectsFor("S9.2")}; a decoder narrowing with typeof, in and Array.isArray is accepted; s9_size is {w:3,h:1.5}, without extra`;
}
// %%
test_spec_S9_3 = {
  const rules = (cells, foreign) => { const r = soundscript.checkSources({ cells, foreign, tsx: true }); return [...r.module, ...r.cells.flatMap((c) => c.errors)].map((e) => e.rule).sort(); };
  spec_is(rules("const a = () => 1;", "declare const thing: number;"), ["foreign-unmarked"]);
  spec_is(rules("const a = (send) => typeof send;", "/** effect */\ndeclare const send: (s: string) => void;"), ["foreign-effect"]);
  spec_is(rules("const a = (lib: number) => lib + 1;", "/** pure */\ndeclare const lib: number;"), []);
  spec_is(rules("const href = (location) => location.myHref;\nconst b = (href: string) => href;", "/** pure */\ndeclare const location: { readonly myHref: string };"), []);
  return "unmarked: [foreign-unmarked]; an effect foreign taken: [foreign-effect]; a pure one, and one named like a global, accepted";
}
// %%
test_spec_S9_4 = {
  spec_is(spec_okCells("const a = () => (v: unknown): boolean => typeof v === \"object\" && v !== null && \"then\" in v;\nconst b = () => (v: unknown): boolean => v !== null && typeof v === \"object\" && \"then\" in v;\nconst c = () => (v: unknown): boolean => !!v && typeof v === \"object\" && \"then\" in v;\nconst d = () => (v: unknown): boolean => v != null && typeof v === \"object\" && \"then\" in v;\nconst e = () => (v: unknown): boolean => {\n  if (v === null) return false;\n  return typeof v === \"object\" && \"then\" in v;\n};\nconst g = () => (v: unknown): boolean => v === null || (typeof v === \"object\" && \"then\" in v);"), "a:ok,b:ok,c:ok,d:ok,e:ok,g:ok");
  return `${spec_rejectsFor("S9.4")}; the null test before or after typeof, !!, != null, an early return and || are accepted`;
}
// %%
test_spec_S9_5 = {
  spec_is(spec_okCells("type R = { readonly a?: number };\nconst f = () => (r: R): boolean => \"a\" in r;\nconst g = () => (v: unknown): boolean => typeof v === \"object\" && v !== null && \"a\" in v;"), "f:ok,g:ok");
  return `${spec_rejectsFor("S9.5")}; in on a record type, and on unknown after typeof "object" and !== null, is accepted`;
}
// %%
test_spec_S9_6 = {
  // w1 (2026-11-24): the cells that gave a function the type {} or { a?: number } are [forgets] now (S9.6 reject rows)
  spec_is(spec_okCells("const thenable = () => (r: unknown): boolean => (typeof r === \"object\" || typeof r === \"function\") && r !== null && \"then\" in r && typeof r.then === \"function\";"), "thenable:ok");
  spec_is(spec_okCells("interface G { (x: number): number }\nconst f = () => (g: G | number): number => (typeof g === \"function\" ? g(1) : g);\nconst j = () => (g: ((x: number) => number) | string): number => (typeof g === \"function\" ? g(2) : g.length);\nconst s = () => (u: unknown): string => (typeof u === \"symbol\" ? \"symbol\" : typeof u);"), "f:ok,j:ok,s:ok");
  spec_is(spec_okCells("type N = { readonly n: number };\nconst s = () => (v: N | string): number => (typeof v === \"string\" ? v.length : v.n);\nconst a = () => (v: N | number[]): number => (Array.isArray(v) ? v.length : v.n);\nconst z = () => (v: N | null): number => (v ? v.n : 0);"), "s:ok,a:ok,z:ok");
  spec_is(spec_okCells("type N = { readonly n: number };\nconst t = () => (v: N | (() => N)): N => (typeof v === \"function\" ? v() : v);\nconst o = () => (v: N | string): number => (typeof v === \"object\" ? v.n : v.length);\nconst k = () => (v: {} | number): number => (typeof v === \"string\" ? v.length : 0);"), "t:ok,o:ok,k:ok");
  return `${spec_rejectsFor("S9.6")}; the runtime's thenable test is accepted; a member with a call signature is called after typeof "function"; a record that takes no string, array or falsy value is narrowed away by typeof "string", Array.isArray and a truth test; a record with a required member holds no function, so a value-or-thunk and typeof "object" narrow; a kept record is the kind tested, with its members under typeof "function"`;
}
// %%
test_spec_S9_8 = {
  spec_is(spec_okCells("type Row = { readonly name: string; readonly price: number };\nconst g = async (fetch: Fetch) => {\n  const res = await fetch(\"rows.json\");\n  const r = cast<readonly Row[]>(await res.json());\n  return r.ok ? r.value.length : r.path;\n};"), "g:ok");
  // s9_raw is { w: 3, h: 1.5, extra: true }: the copy keeps w and h, and a wrong type names the place
  spec_is(await spec_module.value("s9_cast"), { ok: true, value: { w: 3, h: 1.5 } });
  const bad = await spec_module.value("s9_castWrong");
  spec_is([bad.ok, bad.path], [false, "value.w"]);
  if (!Object.isFrozen((await spec_module.value("s9_cast")).value)) throw new Error("the copy is not frozen");
  return `${spec_rejectsFor("S9.8")}; s9_cast keeps w and h of s9_raw, and s9_castWrong fails at value.w`;
}
// %%
test_spec_S9_7 = {
  spec_is(spec_okCells("const f = () => async (): Promise<number> => {\n  const r = { a: 1 };\n  return (await r).a + (await Promise.resolve(2));\n};"), "f:ok");
  return `${spec_rejectsFor("S9.7")}; await of a record with no then, and of a Promise, keeps the type`;
}
// %%
md`## 10. Tests

A test is a cell.`
// %%
md`**S10.1** A cell whose name starts with \`test_\` is a test. It is checked and compiled as any other cell.`
// %%
md`**S10.2** A test passes when its value resolves and fails when it throws or rejects. A test that has not settled has not passed.`
// %%
md`The cells of this section. \`test_s10_double\` is a test of \`s10_double\`, which it takes as a parameter.`
// %%
//ss: ./spec-10.ts
// %%
spec_rejects_10 = [
  { statement: "S10.1", rule: "free-name", source: "const test_log = () => console;" }
]
// %%
spec_rejects_10_view = spec_rejectsTable(spec_rejects_10)
// %%
test_spec_S10_1 = {
  spec_is(spec_okCells("const a = () => 1;\nconst test_a = (a: number) => {\n  if (a !== 1) throw new Error(\"a\");\n  return \"ok\";\n};"), "a:ok,test_a:ok");
  return `${spec_rejectsFor("S10.1")}; a test takes what it tests as a parameter`;
}
// %%
test_spec_S10_2 = {
  const L = await spec_load("const test_ok = () => \"fine\";\nconst test_fails = () => {\n  throw new Error(\"broken\");\n};\nconst test_later = async () => {\n  await Promise.resolve();\n  throw new Error(\"later\");\n};", {});
  try {
    spec_is(await L.value("test_ok"), "fine");
    const err = async (n) => { try { await L.value(n); return null; } catch (e) { return e.message; } };
    spec_is([await err("test_fails"), await err("test_later")], ["broken", "later"]);
    spec_is(await spec_module.value("test_s10_double"), "s10_double(21) is 42");
    return "test_ok resolves; test_fails throws and test_later rejects; test_s10_double passes";
  } finally { L.dispose(); }
}
// %%
md`## 11. Observable JavaScript and raw cells

A SoundScript cell reads a cell written in another language of the same module through a typed parameter. The value is checked and copied on the way in.`
// %%
md`**S11.1** A parameter that names no SoundScript cell, foreign declaration, shell cell or capability, but names another variable of the module (an Observable JavaScript cell, a raw cell or an import), takes that variable's value. A parameter that names none of these is \`[inject-unknown]\`.`
// %%
md`**S11.2** Such a parameter must have a type annotation; without one it is \`[boundary-unannotated]\`.`
// %%
md`**S11.3** The annotation may use \`number\`, \`string\`, \`boolean\`, \`null\`, \`undefined\`, literal types, \`unknown\`, arrays, tuples, object types and interfaces with no methods or index signature, unions, and aliases of these. A function type, or an alias of one, may be the whole annotation when it has no type parameters and no rest parameter, and its parameters and its result, or the \`T\` of a \`Promise<T>\` result, are annotations this statement accepts, or \`void\`, read as \`undefined\`; a parameter of it may be optional. Any other annotation is \`[boundary-type]\`: a function type inside an object, array or union, under \`State\`, or as a parameter or result of a function; \`Promise\`, \`Map\`, \`Set\` or another class; \`Events<T>\`. An alias may refer to itself, directly or through other aliases, when an object type, array or tuple lies on every path from the alias back to itself, as in \`type Tree = { v: number; kids: Tree[] }\`; \`type A = A | number\` is \`[type-cycle]\` (S1.10, since 2026-11-23; it was \`[boundary-type]\`), and a generic alias whose type arguments differ at every level, such as \`type N<T> = { next: N<T[]> | null }\`, is \`[boundary-type]\`. Since 2026-11-23 (a9) a literal type that is not a finite number (\`1e400\`) and an annotation whose run-time form has more than 10000 parts are \`[boundary-type]\`, as in S9.8; before, \`1e400\` was checked as \`null\`.`
// %%
md`**S11.4** Each value that arrives is checked against the annotation. A value that does not match makes the reading cell throw a \`TypeError\` that names the place, such as \`rows[1].price: expected number, found string "12"\`. A value that reaches itself again at a place the annotation checks does not match, such as \`tree.kids[0]: a cycle\`; a value is checked however deeply it is nested. Cells that do not depend on the reading cell are not affected, and the reading cell runs again on the next value. A function is checked at each call: a result that does not match, a throw from the function, or a throw while its result is read makes the call throw a new \`TypeError\` that names the function, such as \`measure(...).n: expected number, found string "3"\` or \`measure(...) threw: boom\`. With a \`Promise<T>\` result, a mismatch, a rejection or a throw while the result is read rejects the promise the cell receives with that \`TypeError\`; a throw from the call itself is thrown at the call.`
// %%
md`**S11.5** The cell is given a deep-frozen copy. An object keeps only the properties its type declares. Under a recursive alias, an object that the value reaches by two paths and that both read as the same type is copied once, and the copy is reached by both paths. \`unknown\` accepts primitives, arrays and plain objects, and copies them whole; a function, a promise or an instance of a class is a mismatch (S11.4). A hole in an array is read as \`undefined\`: it is a mismatch where the element type has no \`undefined\`, and the copy has an \`undefined\` there otherwise. A function is given as a frozen function of the boundary's own. At each call it gives the other language's function a deep-frozen copy of each argument, so the other language never holds a value the cell holds, calls it with no \`this\`, and gives the cell a deep-frozen copy of the result.`
// %%
md`**S11.6** A copy is made for each value that arrives, so a value changed in place by the other language and delivered again is seen. The reading cell runs for each value that arrives, as the runtime runs any cell whose input was computed again; an equal copy does not stop it. The same function delivered again with the same annotation is the same function to the cell; a function delivered after another one is a new function to the cell, even if it was delivered before.`
// %%
md`**S11.7** \`x: State<T>\` takes the view of an Observable JavaScript \`viewof x\`, or the handle of a SoundScript state cell imported from another module with \`import {viewof x} from …\`. Each write is checked against \`T\`. On any other cell in another language, and when two parameters in one module take the same view or state cell as \`State\` of different types, it is \`[boundary-state]\`.`
// %%
md`**S11.8** The view holds the value. A write through the \`State\` commits with its action: it sets the view's \`value\` and dispatches an \`input\` event. \`read\` inside an action gives what the control holds at that moment, which the control may have rounded or clamped, with the call's own earlier writes. A change the user makes on the control is not an action call.`
// %%
md`**S11.9** The value of a cell in another language is state: an action may not use it (\`[action-capture]\`, section 6). Take the view as \`State\` and \`read\` it inside the action; when the cell has no view, pass the value to the action as an argument. A function from another language is such a value: an action may not capture it, nor capture a cell that reads it. A cell that takes the function, or a cell that reads it, may not hold a value whose type may be or hold a function in a state cell, nor yield one from an events cell (\`[action-capture]\`). Since 2026-11-24 (w1) such a function given a record type (\`{}\`, a record of optional members, an empty interface) is \`[forgets]\` (S2.9) before the capture rule is reached.`
// %%
md`**S11.10** Adding, deleting or renaming a cell in another language checks the module's SoundScript cells again.`
// %%
md`**S11.11** A function from another language is trusted, and not checked, to give equal results for equal arguments, to end, to write nothing (by calling an action or in any other way), and to give values that mean what the cell takes them to mean. What is checked is S11.4 to S11.9: each result has the declared type and is a frozen copy, the function receives copies, nothing it throws reaches the cell as its own object, and no action captures it. A checked cell that calls such a function is only as pure as the function: two calls with equal arguments may give different results, and an action the function calls may run the calling cell again.`
// %%
md`The cells of this section: \`s11_rows\`, \`viewof s11_level\` and \`s11_measure\` are Observable JavaScript, \`s11_raw_area\` is raw, and the \`s11_\` cells after them are SoundScript. \`s11_measured\` calls the function \`s11_measure\`.`
// %%
md`\`s11_late_twice\` takes \`s11_late\`, which no cell of this module defines, so it shows an error: it is rejected until \`test_spec_S11_10\` defines \`s11_late\` for a while (S11.10).`
// %%
s11_rows = [{ price: 1, name: "tea" }, { price: 2.5, name: "cake" }]
// %%
viewof s11_level = Inputs.range([0, 10], { step: 1, value: 5, label: "s11_level" })
// %%
s11_measure = (s) => ({ n: s.length, s })
// %%
define("s11_raw_area", [], function () {
  return 12;
})
// %%
//ss: ./spec-11.ts
// %%
spec_rejects_11 = [
  { statement: "S11.1", rule: "inject-unknown", source: "const f = (nothing: number) => nothing;", outside: [] },
  { statement: "S11.2", rule: "boundary-unannotated", source: "const f = (rows) => 1;", outside: [{ name: "rows" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: { run: () => number }) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (p: Promise<number>) => 1;", outside: [{ name: "p" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (m: Map<string, number>) => 1;", outside: [{ name: "m" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (o: { at: number; get(): number }) => 1;", outside: [{ name: "o" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (x: 1e400) => 1;", outside: [{ name: "x" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (e: Events<number>) => 1;", outside: [{ name: "e" }] },
  { statement: "S11.3", rule: "boundary-type", source: "type T = { next: T | null; f: () => number };\nconst f = (t: T) => 1;", outside: [{ name: "t" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: (() => number)[]) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: (() => number) | null) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: State<() => number>) => 1;", outside: [{ name: "g", view: true }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: <T>(x: T) => T) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: (...xs: string[]) => number) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: (cb: () => number) => number) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: (s: string) => () => number) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: () => Map<string, number>) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.7", rule: "boundary-state", source: "const f = (rows: State<number[]>) => 1;", outside: [{ name: "rows" }] },
  { statement: "S11.7", rule: "boundary-state", source: "const f = (level: State<number>) => 1;\nconst g = (level: State<string>) => 1;", outside: [{ name: "level", view: true }] },
  { statement: "S11.9", rule: "action-capture", source: "const n = () => state(0);\nconst copy = (n: State<number>, level: number) => action(() => n.set(level));", outside: [{ name: "level", view: true }] },
  { statement: "S11.9", rule: "action-capture", source: "const n = () => state(0);\nconst copy = (n: State<number>, rows: number) => action(() => n.set(rows));", outside: [{ name: "rows" }] },
  { statement: "S11.9", rule: "action-capture", source: "const n = () => state(0);\nconst copy = (n: State<number>, constructor: number) => action(() => n.set(constructor));", outside: [{ name: "constructor" }] },
  { statement: "S11.9", rule: "action-capture", source: "const n = () => state(0);\nconst set = (n: State<number>, g: () => number) => action(() => n.set(g()));", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "action-capture", source: "const p = (g: () => number) => () => g();\nconst n = () => state(0);\nconst set = (n: State<number>, p: () => number) => action(() => n.set(p()));", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "action-capture", source: "const box = (g: () => number) => state({ f: g });", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "action-capture", source: "const hk = (g: () => number) => () => g();\nfunction* ev(hk: () => number) { yield hk; }", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "action-capture", source: "const hk = (g: () => number) => () => g();\nconst h2 = (hk: () => number) => () => hk();\nconst h3 = (h2: () => number) => () => h2();\nconst box = (h3: () => number) => state(h3);", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "forgets", source: "const box = (g: () => number) => state<{}>(g);", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "forgets", source: "const box = (g: () => number): StateCell<{ a?: number }> => state(g);", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "forgets", source: "const box = (g: () => number) => state<{ f: {} }>({ f: g });", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "forgets", source: "const box = (g: () => number) => state<{}[]>([g]);", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "forgets", source: "interface I {}\nconst box = (g: () => number) => state<I>(g);", outside: [{ name: "g" }] },
  { statement: "S11.9", rule: "forgets", source: "function* ev(g: () => number): Generator<{}> { yield g; }", outside: [{ name: "g" }] }
