test_spec_S6_11 = {
  const E = await spec_editor([
    "const base = () => 1;",
    "const n = (base: number): StateCell<number> => state(base);",
    "const other = (): StateCell<number> => state(0);",
    "const both = (n: State<number>, other: State<number>) => action(() => {\n  other.update((v) => v + 1);\n  n.update((v) => v + 1);\n});",
    "const pair = (n: number, other: number) => [n, other];"
  ]);
  try {
    const call = async () => { const f = await E.value("both"); if (typeof f !== "function") return f; f(); await spec_flush(); return ""; };
    const before = await E.value("both"), handle = await E.value("viewof n");
    spec_is([await call(), await E.value("pair")], ["", [2, 1]]);
    // made again from a new input: the handle is the same, so the State taken before (in before, the action
    // both returned then) writes the new state cell
    await E.edit("base", "const base = () => 5;");
    const callBefore = async () => { before(); await spec_flush(); return ""; };
    spec_is([(await E.value("viewof n")) === handle, await callBefore(), await E.value("pair")], [true, "", [6, 2]]);
    // an input that throws: the cell holding n's State is blocked by it
    await E.edit("base", 'const base = (): number => {\n  throw new Error("broken base");\n};');
    spec_is(await call(), { error: "broken base" });
    // after the error n is made again from the new input; whether its handle is a new one depends on the runtime (S8.5)
    await E.edit("base", "const base = () => 7;");
    spec_is([await call(), await E.value("pair")], ["", [8, 3]]);
    // the state cell does not check: the holder is blocked by it
    await E.edit("n", 'const n = (base: number): StateCell<number> => state("x");');
    spec_is([E.states().n, E.states().both, E.states().pair], ["rejected", "blocked by n", "blocked by n"]);
    const rejected = await call();
    if (!/^n does not check: \[/.test(rejected.error ?? "")) throw new Error(`with n rejected: ${JSON.stringify(rejected)}`);
    // not defined: both raises "viewof n is not defined" only until ss_lifecycle sees the deletion (onCodeChange
    // polls) and checks both again, which rejects it (S2.1); when call() lands in that window is timing, so the
    // test waits for the recheck, bounded only to fail with a message
    const def0 = String(E.variable("both")._definition);
    let off = () => {};
    const rechecked = Promise.race([
      new Promise((r) => { off = onCodeChange(() => { if (String(E.variable("both")?._definition) !== def0) r(true); }); }),
      new Promise((r) => setTimeout(() => r(false), 20000))
    ]);
    E.variable("n").delete();
    E.variable("viewof n").delete();
    const seen = await rechecked;
    off();
    if (!seen) throw new Error("with n deleted: both was not checked again in 20 s");
    const missing = await call();
    if (!/^both does not check: \[inject-unknown\] parameter n names no cell/.test(missing.error ?? "")) throw new Error(`with n deleted: ${JSON.stringify(missing)}`);
    spec_is(await E.value("other"), 3);
    return `the holder of n's State is blocked when an input threw, when n does not check (${rejected.error}) and, once checked again after n was deleted, rejected (${missing.error}); a State taken before n was made again writes the new n`;
  } finally { E.dispose(); }
}
