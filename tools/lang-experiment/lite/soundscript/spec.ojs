  try {
    const bumpThenCopy = await L.value("bumpThenCopy");
    await spec_act(() => bumpThenCopy());
    await spec_flush();
    spec_is(await L.value("pair"), [1, 2]);
    let msg = "";
    const [held] = await L.value("held");
    try { await spec_act(() => soundscript.read(held)); } catch (e) { msg = e.message; }
    if (!msg) throw new Error("read outside an action did not throw");
    const live = (n) => spec_module.value(n);
    const controls = await live("s6_controls");
    spec_is([controls.increment === (await live("s6_increment")), controls.bumpThenCopy === (await live("s6_bumpThenCopy"))], [true, true]);
    return `${spec_rejectsFor("S6.8")}; copy sees the write made before it in the same call ([1,2]); s6_controls holds s6_increment and s6_bumpThenCopy, which this test does not call, so the page's own counts stay at 0; read outside an action throws: ${msg}`;
  } finally { L.dispose(); }
}
