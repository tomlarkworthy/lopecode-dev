  { statement: "S6.19", rule: "action-call", source: "const c = (): StateCell<number> => state(0);\nconst a = (c: State<number>) => action(() => c.set(1));\nconst b = (a: Action<[]>) =>\n  action(() => {\n    Promise.resolve(1).then(() => a());\n  });" },
