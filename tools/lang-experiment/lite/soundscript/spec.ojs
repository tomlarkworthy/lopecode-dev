test_spec_S7_7 = {
  const E = await spec_editor([
    "const log = (): StateCell<readonly string[]> => state<readonly string[]>([]);",
    "const beats = function* () {\n  let i = 0;\n  while (true) yield i++;\n};",
    "const addFirst = (log: State<readonly string[]>) => action((v: number) => log.update((l) => [...l, `first ${v}`]));",
    "const addSecond = (log: State<readonly string[]>) => action((v: number) => log.update((l) => [...l, `second ${v}`]));",
    // placed first but named last, so place order and name order disagree
    "const zeta = (beats: Events<number>, addFirst: Action<[number]>) => on(beats, addFirst);",
    "const alpha = (beats: Events<number>, addSecond: Action<[number]>) => on(beats, addSecond);"
  ]);
  try {
    const log = () => E.value("log");
    // who ran on each beat, from the first beat both got (alpha attaches some beats after zeta)
    const runs = (l) => { const by = new Map(); for (const e of l) { const [who, v] = e.split(" "); by.set(v, [...(by.get(v) ?? []), who]); } const all = [...by.values()].map((w) => w.join(",")); return all.slice(all.indexOf("first,second")); };
    await spec_frames(async () => runs(await log()).length >= 4);
    await E.edit("zeta", "const zeta = (addFirst: Action<[number]>, beats: Events<number>) => on(beats, addFirst);");
    const n0 = runs(await log()).length;
    await spec_frames(async () => runs(await log()).length >= n0 + 10);
    const r = runs(await log());
    const off = r.filter((w) => w !== "first,second");
    if (off.length) throw new Error(`beats not run first then second: ${JSON.stringify(off)}`);
    return `zeta (placed first), then alpha, on each of ${r.length} beats, ${r.length - n0} of them after zeta was edited`;
  } finally { E.dispose(); }
}
// %%
md`## 8. Editing a module with broken cells

What the notebook does when an edit leaves cells that do not check. The edit is always stored, and a cell that does not check does not run.`
// %%
md`**S8.1** Every edit is stored, one that does not parse included, unless its text names no cell: no \`const <name>\`, \`let <name>\` or function declaration (S1.1) at its start, after comments and an optional \`export\`. An edit that takes the name of another cell is stored under another name (S1.6).`
// %%
md`**S8.2** After each edit every cell is ok, rejected or blocked. A rejected cell breaks a rule of its own, does not parse (\`[parse]\`), or uses a construct the checker has no rule for (\`[unsupported]\`, such as the array method \`with\`); a cell whose check fails because the type of an input changed is rejected with its own message. A blocked cell breaks no rule of its own but takes a cell that is not ok, as a value or as \`State<T>\`.`
// %%
md`**S8.3** Only ok cells run. An edit and every other cell whose compiled form it changes are defined in one step, so no cell runs in between on a mix of old and new definitions. A rejected cell raises \`<name> does not check: [rule] …\` and its body never runs, at load or after an edit; the body is kept only as source. A blocked cell fails with the error of the input that is not ok.`
// %%
md`**S8.4** A cell whose compiled text an edit did not change is not defined again, so cells outside the broken part do not run again, and a state cell that stays ok keeps its value.`
// %%
md`**S8.5** A state cell that was in error starts again from its initial value: one blocked by an input when the input comes back, whatever its value, one whose input threw when the input has a value again, and a rejected one when it is repaired. The runtime gives a variable in error no last value, and a state cell keeps its value only through its variable's last value (S6.2).`
// %%
md`**S8.6** A listener in the broken part ends when the edit is applied, and nothing is delivered to it after. When the part is repaired the listener attaches again, once.`
// %%
md`**S8.7** \`compile\` refuses an island that holds a cell that is not ok. An island of ok cells runs when another cell of the module does not parse.`
// %%
spec_editFirst = [
  "const width = () => 640;",
  "const height = () => 400;",
  "const area = (width: number, height: number) => width * height;",
  "const aspect = (width, height) => (width / height).toFixed(2);",
  "const half = (area: number) => area / 2;",
  "const count = (): StateCell<number> => state(0);",
  "const increment = (count: State<number>) => action(() => count.update((n) => n + 1));",
  "const label = (count: number) => `pressed ${count}`;",
  "const tall = (height: number) => height * 2;"
]
// %%
test_spec_S8_1 = {
  const E = await spec_editor(["const a = () => 1;"]);
  try {
    for (const text of ["1 + 1;", "a();", "// a comment"]) {
      const r = ss_language.check(text, [], E.at);
      if (r.store) throw new Error(`${JSON.stringify(text)} would be stored`);
    }
    for (const text of ["const b = () =>", "export const c = () => 2;", "/* note */ function d() { return 3; }"]) {
      const r = ss_language.check(text, [], E.at);
      if (!r.store) throw new Error(`${JSON.stringify(text)} would not be stored: ${JSON.stringify(r.problems)}`);
    }
    return "an edit naming no cell is not stored; an unparsable one, an exported one and one after a comment are";
  } finally { E.dispose(); }
}
// %%
test_spec_S8_2 = {
  const E = await spec_editor(spec_editFirst);
  try {
    await E.edit("width", 'const width = () => "800";');
    spec_is(E.states(), { width: "ok", height: "ok", area: "rejected", aspect: "rejected", half: "blocked by area", count: "ok", increment: "ok", label: "ok", tall: "ok" });
    await E.edit("tall", "const tall = (height: number) => height *;");
    spec_is(E.states().tall, "rejected");
    await ss_language.apply("const w = () => [1, 2].with(0, 3);", [], E.at);
    spec_is(E.states().w, "rejected");
    const w = (await E.value("w")).error ?? "";
    if (!/^w does not check: \[unsupported\]/.test(w)) throw new Error(`w: ${JSON.stringify(w)}`);
    return `area and aspect are rejected by their own checks when width became a string; half is blocked by area; tall does not parse and is rejected; w uses with and is rejected: ${w}`;
  } finally { E.dispose(); }
}
// %%
test_spec_S8_3 = {
  globalThis.__specSneak = 0;
  const E = await spec_editor([...spec_editFirst, "const sneak = (width: number) => { (globalThis as any).__specSneak++; return width; };"]);
  try {
    const sneak = await E.value("sneak");
    if (!/^sneak does not check: \[/.test(sneak.error ?? "") || globalThis.__specSneak !== 0) throw new Error(`at load: ${JSON.stringify(sneak)}, ran ${globalThis.__specSneak}`);
    const edited = "const sneak = (width: number, height: number) => { (globalThis as any).__specSneak++; return width + height; };";
    await E.edit("sneak", edited);
    if (!/^sneak does not check: \[/.test((await E.value("sneak")).error ?? "") || globalThis.__specSneak !== 0) throw new Error(`after an edit: ran ${globalThis.__specSneak}`);
    spec_is(E.text("sneak"), edited);
    await E.edit("width", 'const width = () => "800";');
    const area = (await E.value("area")).error ?? "", half = (await E.value("half")).error ?? "";
    if (!/^area does not check: \[inject-type\]/.test(area) || !/area does not check/.test(half)) throw new Error(`area ${area}, half ${half}`);
    await E.edit("tall", "const tall = (height: number) => height *;");
    if (!/^tall does not check: \[parse\]/.test((await E.value("tall")).error ?? "")) throw new Error("tall");
    spec_is(await E.value("label"), "pressed 0");
    await E.edit("tall", "const tall = (height: number) => height * 3;");
    spec_is(await E.value("tall"), 1200);
    return "a rejected body never ran and is kept as source; area raises its message and half fails with it; an unparsable edit raises [parse] while the rest run, and an edit repairs it";
  } finally { E.dispose(); delete globalThis.__specSneak; }
}
