// %%
test_spec_S5_7 = {
  spec_is(spec_okCells("const c = async () => {\n  const m = { n: 1 };\n  await 0;\n  m.n = 2;\n  return m.n;\n};\nconst s = () => async (xs: readonly Promise<number>[]): Promise<number> => {\n  let t = 0;\n  for (const x of xs) t += await x;\n  return t;\n};"), "c:ok,s:ok");
  return `${spec_rejectsFor("S5.7")}; an async cell's Mut and a kept async function's primitive let across an await are accepted; a nested async function's Mut across an await is rejected, awaited or not`;
}
