  { statement: "S6.3", rule: "inject-state", source: "const e = (now: State<number>) => 1;" },
  { statement: "S6.3", rule: "inject-state", source: "const c = (): StateCell<number> => state(0);\nconst t = (c: State<string>) => 1;" },
  { statement: "S6.4", rule: "no-member", source: "const c = (): StateCell<number> => state(0);\nconst b = (c: State<number>) => c.value;" },
  { statement: "S6.4", rule: "type", source: "const c = (): StateCell<number> => state(0);\nconst t = (c: State<number>) => action(() => c.set(\"x\"));" },
  { statement: "S6.5", rule: "state-write", source: "const c = (): StateCell<number> => state(0);\nconst w = (c: State<number>) => {\n  c.set(1);\n  return 1;\n};" },
  { statement: "S6.5", rule: "state-write", source: "const c = (): StateCell<number> => state(0);\nconst t = (c: State<number>) => () => c.set(1);" },
  { statement: "S6.5", rule: "state-write", source: "const c = (): StateCell<number> => state(0);\nconst g = function* (c: State<number>) {\n  c.set(1);\n  yield 1;\n};" },
  { statement: "S6.5", rule: "state-write", source: "const n = (): StateCell<number> => state(0);\nconst w = (n: State<number>) => {\n  const f = n.set;\n  f(5);\n  return 1;\n};" },
  { statement: "S6.5", rule: "state-write", source: "const n = (): StateCell<number> => state(0);\nconst w = (n: State<number>) => {\n  const { set } = n;\n  set(5);\n  return 1;\n};" },
