test_spec_S4_4 = {
  spec_is(spec_okCells("const a = () => {\n  const set0 = (m: Mut<number[]>) => {\n    m[0] = 5;\n  };\n  const out = [0, 1];\n  set0(out);\n  const s = JSON.stringify(out);\n  return [out, s];\n};"), "a:ok");
  // an owned group: fields written, lent whole to a parameter declared as the group, a helper that is only called, frozen
  spec_is(spec_okCells("type G = Mut<{ readonly t: readonly number[]; n: number }>;\nconst fill = () => (p: G, k: number): number => {\n  p.n = p.n + k;\n  return p.t.length;\n};\nconst a = (fill: (p: G, k: number) => number) => {\n  const g: G = { t: [1], n: 0 };\n  const put = (k: number) => {\n    g.n = g.n + k;\n  };\n  put(2);\n  fill(g, 3);\n  const f = g;\n  const xs: readonly number[] = f.t;\n  return xs.length + f.n;\n};"), "fill:ok,a:ok");
  spec_is(spec_okCells("const a = () => (ys: Mut<number[]>) => ys.length;\nconst b = (a) => {\n  const r = [0];\n  r.push(1);\n  return a(r);\n};"), "a:ok,b:ok");
  return `${spec_rejectsFor("S4.4")}; ${spec_acceptsFor("S4.4")}; a Mut<…> parameter, a read by JSON.stringify, and a cell passing its own fresh value to another cell's Mut<…> parameter are accepted`;
