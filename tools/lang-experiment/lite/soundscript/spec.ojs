// %%
test_spec_S2_9 = {
  spec_is(spec_okCells("const g = () => [1, 2].map((v) => v + 1);\nconst j = () => {\n  const xs: readonly number[] = [1];\n  const x = xs.find((v) => v > 0);\n  return x === undefined ? 0 : x + 1;\n};"), "g:ok,j:ok");
  // an optional parameter takes undefined, so one optional parameter can be passed on to another
  spec_is(spec_okCells("const k = () => {\n  function f(n?: number): number {\n    return n === undefined ? 0 : n;\n  }\n  const g = (n?: number): number => f(n);\n  return g(1);\n};"), "k:ok");
  // an object literal, and a rest without the member, may leave an optional member out; a record type that may have it may not
  spec_is(spec_okCells("const k = (p: { b: number; a: string }) => {\n  const l = { b: 1 };\n  const { a, ...rest } = p;\n  const r: { b: number; a?: number }[] = [{ b: 2 }, l, rest];\n  return [a, r.length];\n};\nconst p = () => ({ b: 1, a: \"x\" });"), "k:ok,p:ok");
  // ?? and || under an expected type: the left side's non-nullish or truthy part is checked, not its nullish or falsy part
  spec_is(spec_okCells("const k = () => (x: number | undefined, y: \"\" | number) => {\n  const r: number = x ?? 1;\n  const s: number = y || 1;\n  return r + s;\n};"), "k:ok");
  // x1 (2026-11-24): a forEach callback's result is unknown; a built-in that keeps nothing inspects any value; plain values
  spec_is(spec_okCells("const k = () => {\n  const out: number[] = [];\n  [1, 2].forEach((x) => out.push(x));\n  const o = { f: () => 1 };\n  const u: unknown = { n: [1] };\n  return out.length + Object.keys(o).length + Object.keys(Object.fromEntries([[\"then\", 1]])).length;\n};"), "k:ok");
  // x1: a block body that returns nothing is given where (x: T) => void is declared
  spec_is(spec_okCells("const k = () => {\n  const each = (xs: readonly number[], w: (x: number) => void) => {\n    for (const x of xs) w(x);\n  };\n  each([1], (x) => {\n    const y = x + 1;\n  });\n  return 1;\n};"), "k:ok");
  // open (2026-11-25): a function with fewer parameters than its type declares, or as many, is accepted
  spec_is(spec_okCells("const k = () => {\n  const f: (x: number, i: number) => string = (x: number) => String(x);\n  const g: (x: number, y?: number) => number = (x: number, y?: number) => x + (y ?? 0);\n  return [5].map(f).length + g(1) + [5].map(() => 1).length;\n};"), "k:ok");
  return `${spec_rejectsFor("S2.9")}; a function with fewer parameters than its type declares, or as many, is accepted; a callback parameter typed by map, a value narrowed by a check for undefined, and an optional parameter passed on to an optional parameter are accepted; an object literal and a rest leave out an optional member; a forEach callback's result, a value given a built-in that keeps none of its arguments, plain data given unknown and a block body returning nothing under a void result are accepted`;
}
// %%
md`## 3. Immutable by default

A value cannot change after it exists. This section lists the writes that the checker rejects. It also lists the parts of TypeScript that are not in the language because they can hide a write or a type error.`
// %%
md`**S3.1** A write to a member of a value that is not \`Mut\` (section 4) is \`[member-write]\`. A write is an assignment, a compound assignment, \`++\` or \`--\`, or a member as the target of a destructuring assignment. An object literal bound to a local \`const\` is \`Mut\` (S4.1).`
// %%
md`**S3.2** A call of a mutating method on a receiver that is not \`Mut\` is \`[mutating-method]\`. The mutating methods are:

- on an array: \`push pop shift unshift splice sort reverse fill copyWithin\`;
- on a typed array: those of the array methods that it has, and \`set\`;
- on a \`Map\`: \`set delete clear\`;
- on a \`Set\`: \`add delete clear\`.

The methods that copy (\`toSorted\`, \`toReversed\`, \`slice\`, \`map\`, \`filter\`) and spreads are accepted.`
// %%
md`**S3.3** \`Object.assign\` with an existing value as its first argument is \`[object-assign]\`. Use a spread, \`{ ...o, b: 2 }\`, to make the new value. A spread or a rest copies the own properties of a value. Thus a spread or a rest of an intrinsic such as \`Math\` is \`[type]\`. For the same reason, only a record is assignable to a record type with a required member. These are \`[type]\`: an array or a string where \`{ length: number }\` is expected, a \`Map\` where \`{ size: number }\` is expected, and \`Math\` where \`{ PI: number }\` is expected.`
// %%
md`**S3.4** \`delete\` on a value that is not \`Mut\` is \`[no-delete]\`. Since 2026-11-24, \`delete\` on a \`Mut\` is accepted (S4.1) only when it removes an optional member (\`a?: T\`) or an entry of an index signature with a literal key (S2.7). A \`delete\` of a required member, of an array element, or of a member of a value that is not a record is \`[no-delete]\`. A later read would find \`undefined\` where the type gives a value. Make the member optional, or make a new record without it (\`const { a: _, ...rest } = o\`).`
// %%
md`**S3.5** \`var\`, \`class\` (a declaration or an expression), \`this\` and \`arguments\` are \`[no-var]\`, \`[no-class]\`, \`[no-this]\` and \`[no-arguments]\`.`
// %%
md`**S3.6** \`new\` on anything other than an allowed intrinsic (S2.6) is \`[new-non-intrinsic]\`. This includes \`new Date()\`, and \`new C()\` where \`C\` is a local bound to an intrinsic.`
// %%
md`**S3.7** The type \`any\` is \`[no-any]\`. An \`as\` cast other than \`as const\` is \`[no-cast]\`. A non-null assertion \`x!\` is \`[no-non-null]\`. A \`@ts-ignore\`, \`@ts-expect-error\` or \`@ts-nocheck\` comment is \`[no-ts-ignore]\`. A mapped type (\`{ readonly [K in "a"]?: number }\`) is unsupported where it is used.`
// %%
md`**S3.8** \`import(...)\` is \`[no-dynamic-import]\`.`
// %%
md`**S3.9** \`enum\` and \`const enum\` are \`[no-enum]\`. \`namespace\`, \`module\` and \`declare module\` are \`[no-namespace]\`.`
// %%
md`**S3.10** \`throw\`, \`try\`/\`catch\`/\`finally\`, loops and an assignment to a local \`let\` are accepted.`
// %%
md`**S3.11** A nested function can assign a local \`let\` only when every function from the assignment out to the \`let\` is a local helper. A local helper is bound to a local \`const\` or declared with \`function\`, and every use of its name is a direct call. If not, the assignment is \`[let-capture]\`. This is the case when the helper is returned, passed as an argument, put in a literal, bound to a second name, or called from a function that escapes.

- A callback that an intrinsic calls before it returns (\`forEach\`, \`map\`) can assign the \`let\`, as a helper can. A callback that the intrinsic keeps (\`then\`) is \`[let-capture]\`.
- A helper that is only called can read a captured \`let\`. A kept function does not capture a \`let\` (S4.10).

Narrowing, since 2026-11-24:

- A \`let\` or a parameter is never narrowed if a function nested in its declaring function assigns it, at any depth. Such a function can be a helper, a \`function\` declaration before or after the use, an arrow in an initializer, or a method of an object literal. A check on it (\`if (r !== null)\`, \`if (r.ok)\`) and its initializer do not change its type, because a call between the check and the use can assign it. The checker rejects the use by the rule of its declared type (\`[possibly-undefined]\`, \`[no-member]\`), and the message gives the reason. To correct this, copy it to a \`const\` first (\`const y = r; if (y !== null) …\`).
- (t1) A \`let\` or a parameter that the declaring function assigns anywhere other than its declaration is never narrowed in a nested function. A check in the nested function does not apply to a later use, because the declaring function can assign it across an \`await\`, a \`yield\` or a call. In the declaring function it is narrowed as usual.`
// %%
md`**S3.12** \`===\`, \`!==\`, \`==\` and \`!=\` with two operands that can both be non-primitive is \`[strict-eq-object]\`. \`equals(a, b)\` compares structure. A comparison with a primitive, which includes \`null\`, is accepted.`
// %%
md`**S3.13** \`switch\` is accepted. The checker checks each case as the condition \`d === e\`, where \`d\` is the discriminant and \`e\` is the value of the case. Two operands that can both be non-primitive are \`[strict-eq-object]\`. A case value is \`[type]\` when it has nothing in common with the values of \`d\` that no earlier case took. This includes a repeated case.`
// %%
md`**S3.14** The checker checks the body of a case with the narrowings of a true test for that case and a false test for every earlier case, as in an \`if\` chain of the same tests. Empty cases before a body (\`case "a": case "b":\`) give the body the narrowings of either case. \`default\`, at any position, has every test false. In \`switch (t.k)\`, a case narrows \`t\` to the members whose \`k\` can equal its value.`
// %%
md`**S3.15** A case body is \`[switch-fallthrough]\` when it is not empty, another case follows it, and it can reach its end. A body ends with \`break\`, which ends the switch, or with \`return\`, \`throw\` or \`continue\`. The last body can reach its end.`
// %%
md`**S3.16** \`const\`, \`let\`, \`function\` or \`class\` directly in a case is \`[switch-declaration]\`, because it would be in scope in every case. In a block inside the case, \`case 1: { const x = 2; return x; }\`, it is accepted.`
// %%
md`**S3.17** A \`switch\` always takes a case when it has no \`default\` and its case values have literal, \`null\` or \`undefined\` types that together are every value of the type of the discriminant. If every body then ends in \`return\` or \`throw\`, the code after the switch is unreachable, and a function needs no \`return\` after it. If the type has a value that no case lists, such as any \`string\`, the switch can take no case.`
// %%
md`**S3.18** The rules of sections 3 to 7 apply in a case body as in the body of an \`if\`. A \`State\` written in a case outside an action is \`[state-write]\`. A case can return a writable local. A writable local can be written after a case bound it to a second name.`
// %%
md`**S3.19** A read of an iterator uses it up. Thus:

- a nested function that uses a binding of an enclosing function whose type can hold an iterator is \`[iterator-capture]\`;
- a cell whose value, state cell content or events value can hold an iterator is \`[iterator-cell]\`.

A type can hold an iterator when it is or contains \`Iterable<T>\` (the result of \`values()\`, \`keys()\` and \`entries()\`), \`Generator<T>\` or a type parameter. A function type, \`Action\`, \`State\` and \`Events\` hold no iterator. An array, a string, a \`Map\` and a \`Set\` can be kept, with a type that is not \`Mut<…>\` (S4.10). \`[...it]\` copies an iterator into an array.

Since 2026-11-24, the same two rules apply to a type that is or contains \`FetchResponse\`, because the body of a response can be read only one time. \`fetch(url)\` gives a \`Promise<Mut<FetchResponse>>\`. A response given a type that hides it (\`unknown\`, \`object\`) is \`[handle-pass]\` (S6.6). A write to one of its members is \`[member-write]\`, and a \`delete\` of one is \`[no-delete]\`. The function that awaited a response can read \`ok\`, \`status\` and the body (\`text()\`, \`json()\`, \`arrayBuffer()\`), and can give the response to a helper as an argument. S5.6 and S5.7 do not apply to a binding that holds a response, because no other code can reach it. Thus \`const data = async (fetch: Fetch) => (await fetch(url)).json();\` is accepted.`
// %%
md`**S3.20** \`Object.freeze(e)\`, where \`e\` is an object or array literal, is accepted and has the type of \`e\`. With any other argument it is \`[object-freeze]\`, because a freeze of a value that another cell holds would change that value. A read of \`Object.freeze\` other than in such a call is \`[no-member]\`.`
// %%
md`These are the cells of this section. \`s3_parse\` is a recursive-descent parser whose helpers share the cursor \`let i\` (S3.11). \`s3_moved\` makes a new point with a spread. \`s3_area\` is a switch on the tag of a union, with a case for each member and no \`default\`. \`s3_kind\` groups empty cases and has a \`default\` with a block.`
// %%
//ss: ./spec-3.ts
// %%
spec_rejects_3 = [
  { statement: "S3.1", rule: "member-write", source: "const o = () => ({ a: 1, xs: [1] });\nconst w = (o) => {\n  o.a = 2;\n  return o;\n};" },
  { statement: "S3.1", rule: "member-write", source: "const o = () => ({ a: 1, xs: [1] });\nconst w = (o) => {\n  o.xs[0] = 3;\n  return o;\n};" },
  { statement: "S3.1", rule: "member-write", source: "const o = () => ({ a: 1, xs: [1] });\nconst w = (o) => {\n  o.a += 1;\n  return o;\n};" },
  { statement: "S3.1", rule: "member-write", source: "const o = () => ({ a: 1, xs: [1] });\nconst w = (o) => {\n  o.a++;\n  return o;\n};" },
  { statement: "S3.1", rule: "member-write", source: "const o = () => ({ a: 1, xs: [1] });\nconst w = (o) => {\n  --o.a;\n  return o;\n};" },
  { statement: "S3.1", rule: "member-write", source: "const o = () => ({ a: 1 });\nconst d = (o) => {\n  [o.a] = [5];\n  ({ k: o.a } = { k: 6 });\n  return o;\n};" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.push(1);" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.pop();" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.shift();" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.unshift(1);" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.splice(0, 1);" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.sort();" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.reverse();" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.fill(0);" },
  { statement: "S3.2", rule: "mutating-method", source: "const xs = () => [3, 1, 2];\nconst w = (xs) => xs.copyWithin(0, 1);" },
  { statement: "S3.2", rule: "mutating-method", source: "const t = () => new Float32Array(2);\nconst w = (t) => {\n  t.set([1], 0);\n  t.fill(1);\n  return t.length;\n};" },
  { statement: "S3.2", rule: "mutating-method", source: "const m = () => new Map<string, number>();\nconst w = (m) => m.set(\"a\", 1);" },
  { statement: "S3.2", rule: "mutating-method", source: "const m = () => new Map<string, number>();\nconst w = (m) => m.delete(\"a\");" },
