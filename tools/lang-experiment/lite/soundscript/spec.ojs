  { statement: "S6.7", rule: "state-in-state", source: "const count = (): StateCell<number> => state(0);\nconst inFunction = (count: State<number>): StateCell<() => State<number>> => state(() => count);" },
  { statement: "S6.8", rule: "read-outside-action", source: "const c = (): StateCell<number> => state(0);\nconst r = (c: State<number>) => read(c);" },
  { statement: "S6.9", rule: "action-capture", source: "const count = (): StateCell<number> => state(0);\nconst other = (): StateCell<number> => state(0);\nconst copy = (other: State<number>, count: number) => action(() => other.set(count + 1));" },
  { statement: "S6.9", rule: "action-capture", source: "const count = (): StateCell<number> => state(0);\nconst doubled = (count: number) => count * 2;\nconst other = (): StateCell<number> => state(0);\nconst viaLocal = (other: State<number>, doubled: number) => {\n  const k = doubled + 1;\n  return action(() => other.set(k));\n};" },
  { statement: "S6.9", rule: "action-capture", source: "const c = (): StateCell<number> => state(0);\nconst d = (c: number) => c * 2;\nconst e = (d: number) => d + 1;\nconst o = (): StateCell<number> => state(0);\nconst t = (o: State<number>, e: number) => action(() => o.set(e));" },
  { statement: "S6.9", rule: "action-capture", source: "const other = (): StateCell<number> => state(0);\nconst roll = (other: State<number>, random: Random) => action(() => other.set(random()));" },
  { statement: "S6.9", rule: "action-capture", source: "const other = (): StateCell<number> => state(0);\nconst stamp = (other: State<number>, now: Clock) => action(() => other.set(now()));" },
  { statement: "S6.9", rule: "action-capture", source: "const other = (): StateCell<number> => state(0);\nconst load = (other: State<number>, fetch: Fetch) =>\n  action(() => {\n    fetch(\"https://example.invalid/\");\n    other.set(1);\n  });" },
  { statement: "S6.18", rule: "state-undefined", source: "const c = () => state(undefined);" },
  { statement: "S6.18", rule: "state-undefined", source: "const c = (): StateCell<number | undefined> => state<number | undefined>(1);" },
  { statement: "S6.18", rule: "state-undefined", source: "const c = (): StateCell<unknown> => state(1);" },
  { statement: "S6.18", rule: "state-undefined", source: "type N = number | undefined;\nconst c = (): StateCell<N> => state(1);" },
  { statement: "S6.18", rule: "type", source: "const c = (): StateCell => state(1);" }
]
