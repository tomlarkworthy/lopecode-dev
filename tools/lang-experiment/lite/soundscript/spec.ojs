test_spec_S4_11 = {
  spec_is(spec_okCells("const s = () => state(0);\nconst put = (s: State<number>) => action(() => {\n  const xs = [0];\n  xs.push(1);\n  s.set(xs.length);\n  const ys = [...xs];\n  ys.push(2);\n});\nconst f = () => {\n  const fib = memo((n: number): number => (n < 2 ? n : fib(n - 1) + fib(n - 2)));\n  const out: number[] = [];\n  for (let i = 0; i < 5; i++) out.push(fib(i));\n  return out;\n};"), "s:ok,put:ok,f:ok");
