// %%
test_spec_S5_5 = {
  // an owner yields once a frame; the copy never ends, so whichever frame is read first, a later one follows
  const frames = (f) => spec_frames(f, 240);
  const L = await spec_load("const frames = function* () {\n  for (let k = 1; ; k++) {\n    const buf = new Float32Array(3);\n    for (let i = 0; i < buf.length; i++) buf[i] = k * (i + 1);\n    yield buf.slice();\n  }\n};\nconst kept = (frames) => snapshot(frames);\nconst total = (frames) => {\n  let s = 0;\n  for (const v of frames) s += v;\n  return s;\n};", {});
  try {
    const kept0 = await L.value("kept"), was = Array.from(kept0), k = was[0];
    spec_is(was, [k, 2 * k, 3 * k]);
    if (!(await frames(async () => (await L.value("total")) > 6 * k))) throw new Error("the owner did not reach a later frame");
    // the copy taken at frame k is unchanged after the owner wrote a later frame into the same buffer
    spec_is(Array.from(kept0), was);
    const later = Array.from(await L.value("kept"));
    if (later[0] <= k) throw new Error(`kept is ${JSON.stringify(later)} after frame ${k}`);
  } finally { L.dispose(); }
  if (!(await frames(async () => (await spec_module.value("s5_total")) === 18))) throw new Error("s5_total did not reach 18");
  spec_is(Array.from(await spec_module.value("s5_kept")), [3, 6, 9]);
  return `${spec_acceptsFor("S5.5")}; a copy of an early frame is unchanged after the last; s5_kept is [3,6,9], s5_total 18`;
}
