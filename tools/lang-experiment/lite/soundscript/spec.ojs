  { statement: "S3.2", rule: "regexp-state", source: "const a = () => {\n  const re = /a/y;\n  return [re.test(\"aa\"), re.test(\"aa\")];\n};" },
  { statement: "S3.2", rule: "regexp-state", source: "const a = (s: string) => {\n  const re = new RegExp(\"a\", s);\n  return re.exec(\"aa\");\n};\nconst s = () => \"g\";" },
