test_spec_S5_8 = {
  spec_is(spec_okCells("const f = function* () {\n  for (let k = 0; k < 2; k++) {\n    const xs = [k];\n    const t = [xs, k] as const;\n    t[0].push(1);\n    yield t[0].length;\n  }\n};"), "f:ok");
  return `${spec_rejectsFor("S5.8")}; a local holding a Mut made in the loop body is accepted`;
