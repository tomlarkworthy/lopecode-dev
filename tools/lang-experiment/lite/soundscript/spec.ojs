test_spec_S6_10 = {
  const L = await spec_load(`const p = (): StateCell<number> => state(100);
const q = (): StateCell<number> => state(0);
const r = (): StateCell<number> => state(0);
const s = (): StateCell<number> => state(1);
const setQ = (q: State<number>) => action(() => q.set(7));
const transfer = (p: State<number>) => action(() => { p.update((v) => v - 10); throw new Error("midway"); });
const failing = (r: State<number>) => action(() => { r.set(2); throw new Error("inner"); });
const catches = (q: State<number>, failing: Action<[]>) => action(() => { q.update((v) => v + 1); try { failing(); } catch (e) {} q.update((v) => v + 1); });
const breaks = (p: State<number>) => action(() => p.update((v) => { if (v > -1) throw new Error("in update"); return v; }));
const step = (s: State<number>) => action((k: number) => s.update((v) => v * 2 + k));
const wraps = (setQ: Action<[]>, r: State<number>) => action(() => { setQ(); r.update((v) => { if (v > -1) throw new Error("outer broke"); return v; }); });
const all = (p: number, q: number, r: number, s: number) => [p, q, r, s];`, {});
  try {
    const call = async (n, ...a) => { const f = await L.value(n); let msg = ""; try { f(...a); } catch (e) { msg = e.message; } await spec_flush(); return msg; };
    spec_is(await call("setQ"), "");
    spec_is(await call("transfer"), "midway");
    spec_is(await L.value("all"), [100, 7, 0, 1]);
    spec_is(await call("catches"), "");
    spec_is(await L.value("all"), [100, 9, 2, 1]);
    spec_is(await call("breaks"), "in update");
    for (const k of [1, 2, 3]) await call("step", k);
    spec_is(await L.value("all"), [100, 9, 2, ((1 * 2 + 1) * 2 + 2) * 2 + 3]);
    spec_is(await call("wraps"), "outer broke");
    spec_is(await L.value("all"), [100, 9, 2, 19]);
    return "a throwing call keeps none of its writes or its callees' (transfer, wraps); a callee that throws inside a call that catches it keeps its writes (failing's r is 2); an earlier call's write stays; an update that throws throws at the call; calls apply in order (s is 19)";
  } finally { L.dispose(); }
}
