// %%
test_spec_S4_12 = {
  // f1 (2026-11-23): accepted, an input function and a function the cell made before it returned stored by an action
  const ok = "const s = () => state<() => number>(() => 0);\nconst three = () => () => 3;\nconst keep = (s: State<() => number>, three: () => number) => ({ go: action(() => s.set(three)) });\nconst mine = (s: State<() => number>) => {\n  const four = () => 4;\n  return { go: action(() => s.set(four)) };\n};\nconst v = (s: () => number) => s();";
  // accepted too: the setter read as a value and a record field are names the checker does not follow; both throw
  const hid = "const t = () => state<() => number>(() => 0);\nconst rec = (t: State<() => number>) => action((g: () => number) => t.set(g));\nconst put = (t: State<() => number>, rec: Action<[() => number]>) => ({\n  viaSetter: action(() => {\n    const st = t.set;\n    const xs = [0];\n    const c: readonly number[] = xs;\n    st(() => c.length);\n    xs.push(1);\n  }),\n  viaArg: action(() => {\n    const r = { g: () => 5 };\n    rec(r.g);\n  }),\n});\nconst u = (t: () => number) => t();";
  // w1 (2026-11-24): a promise made in the body, in a record given by width, was [forgets] at check time (S2.9); since
  // y1 it is accepted again and the write throws at run time (y1-attacks.ts y1-rm-width-promise-state)
  const prom = "const ps = () => state<{ readonly n: number }>({ n: 0 });\nconst putp = (ps: State<{ readonly n: number }>) => ({ go: action(() => {\n  const st = ps.set;\n  const r = { n: 1, p: Promise.resolve(2) };\n  st(r);\n}) });\nconst pn = (ps: { readonly n: number }) => ps.n;";
  const promRules = (() => { const r = soundscript.check(prom); return [...new Set([...r.module, ...r.cells.flatMap((x) => x.errors)].map((e) => e.rule))]; })();
  spec_is([spec_okCells(ok), spec_okCells(hid), promRules], ["s:ok,three:ok,keep:ok,mine:ok,v:ok", "t:ok,rec:ok,put:ok,u:ok", []]);
  const L = await spec_load(ok + "\n" + hid, {});
  try {
    const tries = (f) => { try { f(); return "no throw"; } catch (e) { return e instanceof TypeError && /S4\.12/.test(e.message) ? "TypeError (S4.12)" : String(e); } };
    const put = await L.value("put");
    const thrown = [tries(() => put.viaSetter()), tries(() => put.viaArg())];
    (await L.value("keep")).go();
    await spec_flush();
    const v1 = await L.value("v");
    (await L.value("mine")).go();
    await spec_flush();
    spec_is([...thrown, v1, await L.value("v"), await L.value("u")], ["TypeError (S4.12)", "TypeError (S4.12)", 3, 4, 0]);
  } finally { L.dispose(); }
  return `${spec_rejectsFor("S4.12")}; an input function and a function the cell made before it returned are stored by an action; a function made in the body given through a setter read as a value, or through a record field to an action, throw at run time; a promise made in the body in a record given by width is [forgets] (w1)`;
}
// %%
md`## 5. Generator cells and the values they give

A generator cell does not keep a writable value across its yields (S5.6). What it yields is frozen or a copy, and a cell that reads it may keep it.`
// %%
md`**S5.1** A generator cell, sync or async, may write a local and then yield it. Each value is frozen as it is yielded (S4.6). The local is not used after the yield (S5.6), so a generator that yields a new value each time makes it after the previous yield: in the body of the loop that holds the yield, or in a helper it calls. Yielding a typed array or \`URL\` it can still write is \`[mut-yield]\` (S4.8).`
// %%
md`**S5.2** A cell that takes a generator cell gets each yielded value, read-only. A write to it is \`[member-write]\`, and an annotation the yielded type is not assignable to is \`[inject-type]\`. \`Borrowed\` is still a name of the checker (S1.10), but no value has that type: on an input it is \`[inject-type]\`.`
// %%
md`**S5.3** The reader may keep the value: return it, bind it, place it in a literal, pass it to \`state\`, or use it in a nested function. The value does not change after the generator yields again.`
// %%
md`**S5.4** The reader may use the value after an \`await\`.`
// %%
md`**S5.5** \`snapshot(v)\` is a fresh copy of \`v\`, of the same type, and a local bound to it is writable (S4.3). The copy is made by \`slice\` for a typed array and by \`structuredClone\` for anything else, so \`snapshot\` of a function or a \`URL\` is accepted by the checker and throws at run time.`
// %%
md`**S5.6** In a generator, a local whose type holds a \`Mut\`, or a \`let\` whose type is not primitive, declared before a \`yield\` is not used after it, to read or to write. That is \`[mut-yield]\`. A use is after the \`yield\` when it is later in the text, when it writes the local in an expression that holds the \`yield\` (\`xs.push(yield 1)\`), or when it is in a loop that holds the \`yield\` and the local is declared outside that loop's body. A local declared in the loop body is a new binding in each iteration. A call of a function that uses the local is a use of it at the call. A \`let\` of a primitive type, such as a loop counter or the previous time, may be used across a \`yield\`. Since 2026-11-22.`
// %%
md`**S5.7** S5.6 holds for an \`await\` in a function whose values may be seen before it ends, and the rule is \`[mut-await]\`. Such a function is a generator, or any function made inside the cell's function, awaited or not. Only the body of an async cell itself may use a \`Mut\` across an \`await\`. Since 2026-11-22.`
// %%
md`**S5.8** A type holds a \`Mut\` when it is \`Mut<…>\` or has one in a record field, an array or tuple element, a type argument (\`Map<string, Mut<number[]>>\`), a union member, a type alias's expansion, a function type's result, or the result of a record's call or construct signature. A \`Mut\` in a function type's parameter is not held: it is what a caller gives. A type nested more deeply than the checker looks is taken to hold a \`Mut\`: more than 12 expansions of a generic alias on one path, or more than 200 levels. S4.10, S5.6 and S5.7 take a local or parameter whose type holds a \`Mut\`; a cell input, a global and a function declaration are not taken. A \`const\` bound under the same written type is as deep, so the rebinding that S4.10 accepts does not clear such a type. S4.4 removes each \`Mut\` that this finds. Since 2026-11-22; S4.10 and the depth since 2026-11-23. Since 2026-11-23 a written type holds a \`Mut\` only as its whole type (S4.9), so a type holds one inside its outermost type only when it is inferred: \`[xs, 1] as const\` for a \`Mut\` local \`xs\`, \`{ t: xs }\`, \`k > 0 ? xs : null\`, or a function whose inferred result is a \`Mut\`.`
// %%
md`The cells of this section. \`s5_frames\` makes a buffer for each \`k\` = 1, 2, 3, fills it with \`k * (1, 2, 3)\` and yields a copy; \`s5_total\` sums the frame it is given and \`s5_kept\` keeps a copy.`
// %%
//ss: ./spec-5.ts
// %%
spec_rejects_5 = [
  { statement: "S5.1", rule: "mut-yield", source: "const g = function* () {\n  const buf = new Float32Array(2);\n  buf[0] = 1;\n  yield buf;\n};" },
  { statement: "S5.6", rule: "mut-yield", source: "const g = function* () {\n  const xs: Mut<unknown[]> = [];\n  xs.push(yield 1);\n};" },
  { statement: "S5.6", rule: "mut-yield", source: "const g = function* () {\n  const r = { n: 0 };\n  yield 1;\n  r.n = 1;\n  yield r.n;\n};" },
  { statement: "S5.6", rule: "mut-yield", source: "const g = function* () {\n  const buf = new Float32Array(2);\n  for (let k = 0; k < 2; k++) {\n    buf[0] = k;\n    yield buf.slice();\n  }\n};" },
  { statement: "S5.6", rule: "mut-yield", source: "const g = function* () {\n  let xs: readonly number[] = [1];\n  yield xs.length;\n  xs = [2];\n  yield xs.length;\n};" },
  { statement: "S5.6", rule: "mut-yield", source: "const g = function* () {\n  const xs = [1];\n  const add = () => xs.push(2);\n  yield 1;\n  add();\n};" },
  { statement: "S5.7", rule: "mut-await", source: "const bad = () => async () => {\n  const bump = async (m: Mut<{ n: number }>): Promise<void> => {\n    await 0;\n    m.n = 2;\n  };\n  const m = { n: 1 };\n  const p = bump(m);\n  const v = m;\n  await p;\n  return v.n;\n};" },
  { statement: "S5.7", rule: "mut-await", source: "const a = () => {\n  const xs = [0];\n  const h = async () => {\n    await 0;\n    xs.push(1);\n  };\n  h();\n  return 1;\n};" },
  { statement: "S5.7", rule: "mut-await", source: "const a = async () => {\n  const xs = [0];\n  const h = async () => {\n    await 0;\n    xs.push(1);\n  };\n  await h();\n  return xs.length;\n};" },
  { statement: "S5.8", rule: "mut-yield", source: "const g = function* () {\n  const xs = [0];\n  const t = [xs, 1] as const;\n  yield 1;\n  t[0].push(1);\n};" },
  { statement: "S5.8", rule: "mut-yield", source: "const g = function* () {\n  const xs = [0];\n  const t = [xs] as const;\n  yield 1;\n  yield t[0].length;\n};" },
  { statement: "S5.8", rule: "mut-capture", source: "const a = () => {\n  const xs = [0];\n  const g = () => [xs] as const;\n  const t = g();\n  return () => t[0].length;\n};" },
  // the walk reaches a Mut 13 tuples deep; the next row holds no Mut and is past the limit on generic alias expansions
