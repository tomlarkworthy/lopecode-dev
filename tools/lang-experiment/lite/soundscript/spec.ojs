test_spec_S5_1 = {
  spec_is(spec_okCells("const g = function* () {\n  const b = [1];\n  b.push(2);\n  yield b;\n};\nconst j = async function* () {\n  const b = new Float32Array(1);\n  yield b.slice();\n};"), "g:ok,j:ok");
  return `${spec_rejectsFor("S5.1")}; ${spec_acceptsFor("S5.1")}; a generator yields an array (frozen as it is yielded) or a typed array's copy`;
}
// %%
test_spec_S5_2 = {
  const owner = "const frames = function* () {\n  const buf = new Float32Array(2);\n  yield buf.slice();\n};\n";
  spec_is(spec_okCells(owner + "const a = (frames: Float32Array) => frames.length;\nconst b = (frames) => frames.length;"), "frames:ok,a:ok,b:ok");
  return `${spec_rejectsFor("S5.2")}; ${spec_acceptsFor("S5.2")}; Float32Array and no annotation are accepted`;
}
// %%
test_spec_S5_3 = {
  const owner = "const frames = function* () {\n  const buf = new Float32Array(2);\n  yield buf.slice();\n};\n";
  spec_is(spec_okCells(owner + "const a = (frames) => {\n  let s = 0;\n  for (const v of frames) s += v;\n  return s + (frames.at(0) ?? 0);\n};"), "frames:ok,a:ok");
  return `${spec_acceptsFor("S5.3")}; reads during the evaluation are accepted`;
}
// %%
test_spec_S5_4 = {
  const first = await spec_module.value("s5_first");
  if (![1, 2, 3].includes(first)) throw new Error(`s5_first is ${first}`);
  const owner = "const frames = function* () {\n  const buf = new Float32Array(2);\n  yield buf.slice();\n};\n";
  spec_is(spec_okCells(owner + "const a = async (frames) => {\n  const x = frames.at(0) ?? 0;\n  await Promise.resolve();\n  return x;\n};"), "frames:ok,a:ok");
  return `${spec_acceptsFor("S5.4")}; a value read before the await is kept (s5_first is ${first})`;
}
// %%
test_spec_S5_5 = {
  // an owner yields once a frame; the copy never ends, so whichever frame is read first, a later one follows
  const frames = (f) => spec_frames(f, 240);
  const L = await spec_load("const frames = function* () {\n  for (let k = 1; ; k++) {\n    const buf = new Float32Array(3);\n    for (let i = 0; i < buf.length; i++) buf[i] = k * (i + 1);\n    yield buf.slice();\n  }\n};\nconst kept = (frames) => snapshot(frames);\nconst total = (frames) => {\n  let s = 0;\n  for (const v of frames) s += v;\n  return s;\n};", {});
  try {
    const kept0 = await L.value("kept"), was = Array.from(kept0), k = was[0];
    spec_is(was, [k, 2 * k, 3 * k]);
    if (!(await frames(async () => (await L.value("total")) > 6 * k))) throw new Error("the owner did not reach a later frame");
    // the copy taken at frame k is unchanged after the owner wrote a later frame into the same buffer
    spec_is(Array.from(kept0), was);
    const later = Array.from(await L.value("kept"));
    if (later[0] <= k) throw new Error(`kept is ${JSON.stringify(later)} after frame ${k}`);
  } finally { L.dispose(); }
  if (!(await frames(async () => (await spec_module.value("s5_total")) === 18))) throw new Error("s5_total did not reach 18");
  spec_is(Array.from(await spec_module.value("s5_kept")), [3, 6, 9]);
  return `${spec_acceptsFor("S5.5")}; a copy of an early frame is unchanged after the last; s5_kept is [3,6,9], s5_total 18`;
}
// %%
test_spec_S5_6 = {
  spec_is(spec_okCells("const t = function* (now: Clock) {\n  let t0 = now();\n  for (let i = 0; i < 2; i++) {\n    const t1 = now();\n    yield t1 - t0;\n    t0 = t1;\n  }\n};\nconst f = function* () {\n  for (let k = 0; k < 2; k++) {\n    const xs = [k];\n    xs.push(1);\n    yield xs;\n  }\n};"), "t:ok,f:ok");
  return `${spec_rejectsFor("S5.6")}; a primitive let across a yield and a local made in the loop body are accepted`;
