test_spec_S6_14 = {
  const E = await spec_editor([
    "const a = (): StateCell<number> => state(0);",
    "const b = (): StateCell<number> => state(0);",
    "const load = (a: State<number>, b: State<number>) => action(async (p: Promise<number>) => {\n  a.set(1);\n  const v = await p;\n  b.set(read(a) + v);\n  a.update((x) => x + 1);\n});",
    "const pair = (a: number, b: number) => [a, b];"
  ]);
  const g = spec_gate();
  try {
    spec_is(await E.value("pair"), [0, 0]);
    const load = await E.value("load"), runs = E.evals("pair");
    await spec_act(() => load(g.p));
    await spec_flush();
    spec_is([soundscript.actionQueue().inFlight, await E.value("pair"), E.evals("pair") - runs], [true, [0, 0], 0]);
    g.open(10);
    await spec_act(() => {});
    await spec_flush();
    spec_is([await E.value("pair"), E.evals("pair") - runs], [[2, 11], 1]);
    return "while the call waits nothing is committed; then a and b commit together, pair runs once, and read(a) after the await saw the call's own write (b is 11)";
  } finally { g.open(0); E.dispose(); }
}
// %%
test_spec_S6_15 = {
  const L = await spec_load(`const x = (): StateCell<number> => state(0);
const inner = (x: State<number>) => action(async (p: Promise<number>) => { const v = await p; x.update((c) => c + v); });
const later = (x: State<number>) => action(async (q: Promise<number>) => { const v = await q; x.update((c) => c + v); });
const outer = (inner: Action<[Promise<number>]>, later: Action<[Promise<number>]>, x: State<number>) =>
  action(async (p: Promise<number>, q: Promise<number>, done: () => void) => { later(q); await inner(p); x.update((c) => c * 10); done(); });`, {});
  const p = spec_gate(), q = spec_gate(), d = spec_gate();
  // later's write comes after the call committed: it throws, and its promise is a rejection no one handles
  const host = [], onRejection = (e) => { if (/outside an action/.test(e.reason?.message)) { host.push(e.reason.message); e.preventDefault(); } };
  window.addEventListener("unhandledrejection", onRejection);
  try {
    const outer = await L.value("outer");
    await spec_act(() => outer(p.p, q.p, d.open));
    p.open(1);
    await d.p;
    await spec_flush();
    spec_is([soundscript.actionQueue().inFlight, await L.value("x")], [false, 10]);
    q.open(100);
    await spec_frames(() => host.length > 0);
    await spec_flush();
    spec_is([await L.value("x"), host.length], [10, 1]);
    return "outer awaited inner and returned; the call committed x = (0 + 1) * 10 without waiting for later, which it did not await; later's write after the commit threw outside an action, as an unhandled rejection";
  } finally { p.open(0); q.open(0); window.removeEventListener("unhandledrejection", onRejection); L.dispose(); }
}
// %%
test_spec_S6_15_rejects = {
  test_spec_S6_16; // both replace console.error, so they run one after the other
  const said = [], was = console.error;
  // messages from this test's actions are kept; any other goes on to the console
  console.error = (...a) => {
    const m = a.map((x) => (x instanceof Error ? x.message : String(x))).join(" ");
    if (/action (detached|awaited|caught) threw/.test(m)) said.push(m); else was(...a);
  };
  // a rejection that reaches no call goes to the host
  const host = [], onRejection = (e) => { if (/inner rejected/.test(e.reason?.message)) { host.push(e.reason.message); e.preventDefault(); } };
  window.addEventListener("unhandledrejection", onRejection);
  const L = await spec_load(`const x = (): StateCell<number> => state(0);
const y = (): StateCell<number> => state(0);
const inner = (y: State<number>) => action(async (p: Promise<number>) => { y.set(5); await p; throw new Error("inner rejected"); });
const detached = (inner: Action<[Promise<number>]>, x: State<number>) => action((p: Promise<number>) => { x.set(1); inner(p); });
const awaited = (inner: Action<[Promise<number>]>, x: State<number>) => action(async (p: Promise<number>) => { x.set(1); await inner(p); });
const caught = (inner: Action<[Promise<number>]>, x: State<number>) => action(async (p: Promise<number>) => { x.set(1); try { await inner(p); } catch (e) { x.update((v) => v + 1); } });
const pair = (x: number, y: number) => [x, y];`, {});
  const gates = [spec_gate(), spec_gate(), spec_gate()];
  try {
    const got = [];
    for (const [i, n] of ["detached", "awaited", "caught"].entries()) {
      const f = await L.value(n);
      await spec_act(() => f(gates[i].p));
      gates[i].open(0);
      if (n === "detached") await spec_frames(() => host.length > 0);
      await spec_act(() => {});
      await spec_flush();
      got.push(await L.value("pair"));
    }
    spec_is(got, [[1, 5], [1, 5], [2, 5]]);
    const count = (a) => said.filter((m) => m.includes(`action ${a} threw`) && m.includes("inner rejected")).length;
    spec_is([count("detached"), count("awaited"), count("caught"), host.length], [0, 1, 0, 1]);
    return "inner rejected: not awaited, the call committed x 1 and inner's y 5 when detached returned, and the rejection reached the host unhandled; awaited without catch, the call kept none of its writes and was reported once; awaited and caught, the call went on and kept x 2";
  } finally { gates.forEach((g) => g.open(0)); console.error = was; window.removeEventListener("unhandledrejection", onRejection); L.dispose(); }
}
