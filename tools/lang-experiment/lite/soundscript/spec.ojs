// %%
spec_rejects_3_view = spec_rejectsTable(spec_rejects_3)
// %%
test_spec_S3_1 = `${spec_rejectsFor("S3.1")}; ${spec_acceptsFor("S3.1")}`
// %%
test_spec_S3_2 = {
  spec_is(spec_okCells("const xs = () => [3, 1, 2];\nconst w = (xs) => [xs.toSorted(), xs.toReversed(), xs.slice(), xs.map((x) => x + 1), xs.filter((x) => x > 1), [...xs, 4]];"), "xs:ok,w:ok");
  spec_is(await spec_module.value("s3_sorted"), [1, 2, 3]);
  // a g or y regexp where it is made, and a held regexp without them, are accepted
  spec_is(spec_okCells("const r = () => {\n  const re = /^a/;\n  const f = (s: string) => [/a/g.test(s), s.replace(/a/g, \"b\"), s.split(/,/g).length, re.test(s), re.exec(s) === null];\n  return f(\"a,b\");\n};"), "r:ok");
  return `${spec_rejectsFor("S3.2")}; the copying methods are accepted; s3_sorted is [1,2,3]; a g regexp is accepted where it is made`;
}
// %%
test_spec_S3_3 = {
  spec_is(await spec_module.value("s3_moved"), { x: 2, y: 2 });
  spec_is(await spec_module.value("s3_point"), { x: 1, y: 2 });
  return `${spec_rejectsFor("S3.3")}; s3_moved is a new point, s3_point is unchanged`;
}
