test_spec_S6_12_everyAnswer = {
  spec_is(spec_okCells(spec_s6_everyAnswer), "current:ok,queue:ok,issued:ok,ask:ok,loaded:ok,arrived:ok,greeting:ok,store:ok,onArrived:ok");
  const asks = [];
  const fetch = (url) => new Promise((resolve, reject) => asks.push({ url, answer: (text) => resolve({ ok: true, status: 200, text: () => Promise.resolve(text) }), fail: () => reject(new Error("offline")) }));
  const L = await spec_load(spec_s6_everyAnswer, { ss_fetch: [[], () => fetch] });
  const greeting = () => L.value("greeting");
  const has = (xs) => async () => JSON.stringify(await greeting()) === JSON.stringify(xs);
  const wait = async (what, f) => { if (!(await spec_frames(f))) throw new Error(`${what}: ${asks.length} fetches, greeting ${JSON.stringify(await greeting())}`); };
  try {
    await wait("the first fetch", () => asks.length === 1);
    asks[0].answer("hello");
    await wait("hello stored", has(["hello"]));
    // three asks: one fetch in flight, two queued; the first fails, the others answer
    const ask = await L.value("ask");
    ask();
    await wait("request 1 fetched", () => asks.length === 2);
    ask();
    ask();
    asks[1].fail();
    await wait("request 2 fetched", () => asks.length === 3);
    asks[2].answer("second");
    await wait("request 3 fetched", () => asks.length === 4);
    asks[3].answer("third");
    await wait("every answer stored", has(["hello", "(failed)", "second", "third"]));
    spec_is([asks.map((a) => a.url.replace(/.*\?/, "")), await L.value("current"), await L.value("queue")], [["n=0", "n=1", "n=2", "n=3"], null, []]);
    return `three asks made while one fetch was pending were fetched one at a time, in order; the failed one was recorded as "(failed)"; every answer was stored once, in order`;
  } finally { asks.forEach((a) => a.answer("")); L.dispose(); }
}
