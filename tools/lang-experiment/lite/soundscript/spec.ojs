  { statement: "S4.9", rule: "mut-nested", source: "const a = () => {\n  const r: { readonly t: Mut<number[]> } = { t: [0] };\n  return 1;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "type Box = { readonly t: Mut<number[]> };\nconst a = () => 1;" },
  { statement: "S4.9", rule: "mut-nested", source: "type M = Mut<number[]>;\nconst a = () => {\n  const f = (m: readonly M[]) => m.length;\n  return 1;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "type M<T> = Mut<T>;\nconst a = () => {\n  const f = (m: M<number[]>[]) => m.length;\n  return 1;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "const a = () => {\n  const f = (): Mut<number[]> => [1];\n  return f().length;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "const a = () => {\n  const g = (mk: () => Mut<number[]>) => mk().length;\n  return 1;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "const a = () => {\n  const f = (m: Mut<number[]> | null) => (m === null ? 0 : m.length);\n  return 1;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "const a = () => {\n  const g = new Map<string, Mut<number[]>>();\n  return g.size;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "const a = () => {\n  const f = (p: Mut<{ t: Mut<number[]> | null }>) => 1;\n  return 1;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "const a = () => {\n  const m = [1];\n  const r: { readonly t: typeof m } = { t: m };\n  return r.t.length;\n};" },
  { statement: "S4.9", rule: "mut-nested", source: "const a = () => {\n  const f = <T extends Mut<number[]>,>(m: T) => 1;\n  return 1;\n};" },
  { statement: "S4.1", rule: "mutating-method", source: "const a = () => {\n  const c: ReadonlyArray<number> = [1];\n  c.push(2);\n  return c.length;\n};" },
  { statement: "S4.1", rule: "mutating-method", source: "type R = readonly number[];\nconst a = () => {\n  const c: R = [1];\n  c.push(2);\n  return c.length;\n};" }
]
// %%
spec_rejects_4_view = spec_rejectsTable(spec_rejects_4)
// %%
test_spec_S4_1 = {
  spec_is(spec_okCells("const a = () => {\n  const t = new Float32Array(3);\n  t.fill(0);\n  t[1] = 2;\n  t[2] += 1;\n  t[0]++;\n  const m = new Map<string, number>();\n  m.set(\"a\", 1);\n  m.delete(\"a\");\n  const o: { a?: number; b: number } = { a: 1, b: 2 };\n  delete o.a;\n  const xs = [3, 1];\n  xs.push(2);\n  xs.sort((p, q) => p - q);\n  const r: number[] = xs;\n  return [t, m.size, o, r];\n};"), "a:ok");
  const blur = Array.from(await spec_module.value("s4_blur"), (v) => Math.round(v * 1e6) / 1e6);
  spec_is(blur, [0, 1, 1, 1, 0]);
  spec_is(await spec_module.value("s4_record"), { b: 3 });
  spec_is(spec_okCells("const a = () => {\n  const xs: number[] = [];\n  xs.push(1);\n  let ys: number[] = [];\n  ys.push(1);\n  ys = [2];\n  ys.push(3);\n  const m: Map<string, number> = new Map();\n  m.set(\"k\", 1);\n  return xs.length + ys.length + m.size;\n};"), "a:ok");
  spec_is(spec_okCells("const a = () => {\n  const xs: number[] | null = [1];\n  return xs?.length ?? 0;\n};"), "a:ok");
  return `${spec_rejectsFor("S4.1")}; a local annotated with a union is read; writes, mutating methods and delete on a Mut, and on an annotated local bound to a fresh value, are accepted; s4_blur is ${JSON.stringify(blur)}, s4_record {"b":3}`;
}
