  { statement: "S6.20", rule: "type", source: "const v = () => {\n  const C = (p: { readonly k: number }) => ({ tag: \"b\", children: [] });\n  return <C k={1} />;\n};" }
]
// %%
spec_rejects_6_view = spec_rejectsTable(spec_rejects_6)
// %%
test_spec_S6_1 = {
  spec_is(spec_okCells("const a = () => state(0);\nconst b = (): StateCell<string> => {\n  return state(\"x\");\n};\nconst c = (a: number, b: string) => [a, b];"), "a:ok,b:ok,c:ok");
  // the source of this page's s6_count and s6_label, run in a module of its own, so the buttons of s6_view do not change what it reads
  const L = await spec_load("const s6_count = (): StateCell<number> => state(0);\nconst s6_label = (s6_count: number) => `count: ${s6_count}`;", {});
  try { spec_is(await L.value("s6_label"), "count: 0"); } finally { L.dispose(); }
  return `${spec_rejectsFor("S6.1")}; a state cell's readers get its content (s6_label, run on its own, is "count: 0")`;
}
// %%
test_spec_S6_2 = {
  const L = await spec_load("const seed = (): StateCell<number> => state(1);\nconst vars = (seed: number): StateCell<{ readonly n: number }> => state({ n: seed * 10 });\nconst label = (vars: { readonly n: number }) => `n=${vars.n}`;\nconst setN = (vars: State<{ readonly n: number }>) => action((n: number) => vars.set({ n }));\nconst bumpSeed = (seed: State<number>) => action(() => seed.update((s) => s + 1));", {});
  try {
    spec_is(await L.value("label"), "n=10");
    const made = await spec_evals(L.module, "vars");
    const setN = await L.value("setN");
    setN(5);
    await spec_flush();
    spec_is(await L.value("label"), "n=5");
    spec_is((await spec_evals(L.module, "vars")) - made, 0);
    const bumpSeed = await L.value("bumpSeed");
    bumpSeed();
    await spec_flush();
    spec_is(await L.value("label"), "n=20");
    spec_is((await spec_evals(L.module, "vars")) - made, 1);
    return "a write is kept (n=5) until the input changes; then the state cell is made again from it (n=20), once";
  } finally { L.dispose(); }
}
// %%
test_spec_S6_3 = {
  // names of its own: a run is counted per compiled text, and the tutorial has a count and an increment
  const L = await spec_load("const clicks = (): StateCell<number> => state(0);\nconst label = (clicks) => `count: ${clicks}`;\nconst increment = (clicks: State<number>) => action(() => clicks.update((c) => c + 1));", {});
  try {
    spec_is(await L.value("label"), "count: 0");
    const runs = () => Promise.all(["label", "increment", "clicks"].map((n) => spec_evals(L.module, n)));
    const [label0, inc0, count0] = await runs();
    const inc = await L.value("increment");
    inc();
    await spec_flush();
    spec_is(await L.value("label"), "count: 1");
    const [label1, inc1, count1] = await runs();
    spec_is([label1 - label0, inc1 - inc0, count1 - count0], [1, 0, 0]);
    inc(); inc();
    await spec_flush();
    spec_is(await L.value("label"), "count: 3");
    spec_is((await runs())[0] - label1, 1); // two calls finished before one commit: one run
    return `${spec_rejectsFor("S6.3")}; a write runs label again once, and neither increment nor the state cell`;
  } finally { L.dispose(); }
}
// %%
test_spec_S6_4 = spec_rejectsFor("S6.4")
// %%
test_spec_S6_5 = {
  const L = await spec_load("const count = (): StateCell<number> => state(0);\nconst held = (count: State<number>) => [count];", {});
  try {
    const [handle] = await L.value("held");
    let msg = "";
    try { handle.set(5); } catch (e) { msg = e.message; }
    if (!/outside an action/.test(msg)) throw new Error(`set outside an action gave ${JSON.stringify(msg)}`);
    await spec_flush();
    spec_is(await L.value("count"), 0);
    spec_is(spec_okCells("const n = (): StateCell<number> => state(0);\nconst a = (n: State<number>) => action(() => {\n  const f = n.set;\n  const { update } = n;\n  f(1);\n  update((x) => x + 1);\n});"), "n:ok,a:ok");
    return `${spec_rejectsFor("S6.5")}; set and update read in an action, as a value or by destructuring, are accepted; at run time: ${msg}`;
  } finally { L.dispose(); }
}
// %%
test_spec_S6_6 = {
  spec_is(spec_okCells("const c = (): StateCell<number> => state(0);\nconst t = (c: State<number>) => action((n: number) => c.set(n));\nconst u = (t: Action<[number]>) => action(() => t(1));\nconst rec = (t: Action<[number]>) => ({ go: t });\nconst lst = (t: Action<[number]>) => [t];\nconst pass = (u: Action<[]>, t: Action<[number]>) => ({ u, t });"), "c:ok,t:ok,u:ok,rec:ok,lst:ok,pass:ok");
  spec_is(spec_rulesOf({ source: "const c = (): StateCell<number> => state(0);\nconst t = (c: State<number>) => action((n: number) => c.set(n));\nconst u = (t: Action<[string]>) => 1;" }), ["inject-type"]);
  // an intrinsic's type parameter keeps the Action's type; a record parameter that says Action holds one
  spec_is(spec_okCells("const c = (): StateCell<number> => state(0);\nconst a = (c: State<number>) => action(() => c.set(1));\nconst b = (a: Action<[]>) => [1, 2].map(() => a);\nconst m = (a: Action<[]>) => new Map([[\"a\", a]]);\nconst p = (a: Action<[]>) => Promise.resolve({ go: a });\nconst k = (a: Action<[]>) => {\n  const keep = (r: { readonly go: Action<[]> }) => r.go;\n  return keep({ go: a });\n};"), "c:ok,a:ok,b:ok,m:ok,p:ok,k:ok");
  return `${spec_rejectsFor("S6.6")}; an Action returned, in a record, in an array, through map, new Map and Promise.resolve, or called in an action is accepted; Action<[number]> taken as Action<[string]> is [inject-type]`;
}
// %%
test_spec_S6_18 = spec_rejectsFor("S6.18")
// %%
test_spec_S6_19 = {
  spec_is(spec_okCells("const c = (): StateCell<number> => state(0);\nconst a = (c: State<number>) => action(() => c.set(1));\nconst b = (c: State<number>, a: Action<[]>) =>\n  action(() => {\n    const twice = () => {\n      a();\n      a();\n    };\n    twice();\n    [1, 2].forEach((k) => c.update((v) => v + k));\n    const { set } = c;\n    [3].forEach((k) => set(k));\n    (() => c.set(4))();\n  });"), "c:ok,a:ok,b:ok");
  // at run time: a function kept from a call, as JavaScript can keep one, throws when it writes or reads later
  const L = await spec_load("const n = (): StateCell<number> => state(0);\nconst held = (n: State<number>) => [n];", {});
  try {
    const [h] = await L.value("held");
    const kept = [];
    soundscript.action(() => { kept.push(() => h.set(2), () => soundscript.read(h)); })();
    const later = await Promise.resolve().then(() => kept.map((f) => { try { f(); return "ran"; } catch (e) { return e.message; } }));
    if (!later.every((m) => /outside an action/.test(m))) throw new Error(`the kept functions gave ${JSON.stringify(later)}`);
    await spec_flush();
    spec_is(await L.value("n"), 0);
    return `${spec_rejectsFor("S6.19")}; a function made in an action and called there, through a local, by forEach or by update, and set taken by destructuring and called by forEach, are accepted; at run time a kept write and read throw: ${later[0]}`;
  } finally { L.dispose(); }
}
// %%
test_spec_S6_20 = {
  spec_is(spec_okCells("const c = (): StateCell<number> => state(0);\nconst a = (c: State<number>) => action(() => c.set(1));\nconst v = (a: Action<[]>): Elem => <button onClick={a}>+</button>;\nconst w = (v: Elem) => <div>{v}</div>;"), "c:ok,a:ok,v:ok,w:ok");
  // a record shaped like an element, from a cell the checker never saw, given to the renderer
  let called = 0;
  const forged = { tag: "button", children: [], props: { onClick: () => { called++; } }, toString: () => { called++; return "forged"; } };
  const node = soundscript.mount(forged, null);
  node.dispatchEvent(new Event("click"));
  spec_is([node.nodeType, called], [Node.TEXT_NODE, 0]);
  return `${spec_rejectsFor("S6.20")}; ${spec_acceptsFor("S6.20")}; JSX elements are Elem; a forged record is mounted as a text node, and neither its toString nor a click calls anything`;
}
// %%
test_spec_S6_7 = {
  spec_is(spec_okCells("type Item = { readonly id: number; readonly tags: readonly string[] };\nconst items = (): StateCell<{ readonly list: readonly Item[]; readonly picked: Item | null }> => state({ list: [{ id: 1, tags: [\"a\"] }], picked: null });"), "items:ok");
  return `${spec_rejectsFor("S6.7")}; nested records, arrays and unions with no State are accepted`;
}
// %%
test_spec_S6_8 = {
  const L = await spec_load("const count = (): StateCell<number> => state(0);\nconst other = (): StateCell<number> => state(0);\nconst copy = (other: State<number>, count: State<number>) => action(() => other.set(read(count) + 1));\nconst bumpThenCopy = (count: State<number>, copy: Action<[]>) =>\n  action(() => {\n    count.update((c) => c + 1);\n    copy();\n  });\nconst pair = (count: number, other: number) => [count, other];\nconst held = (count: State<number>) => [count];", {});
  try {
    const bumpThenCopy = await L.value("bumpThenCopy");
    bumpThenCopy();
    await spec_flush();
    spec_is(await L.value("pair"), [1, 2]);
    let msg = "";
    const [held] = await L.value("held");
    try { soundscript.read(held); } catch (e) { msg = e.message; }
    if (!msg) throw new Error("read outside an action did not throw");
    const live = (n) => spec_module.value(n);
    const controls = await live("s6_controls");
    spec_is([controls.increment === (await live("s6_increment")), controls.bumpThenCopy === (await live("s6_bumpThenCopy"))], [true, true]);
    return `${spec_rejectsFor("S6.8")}; copy sees the write made before it in the same call ([1,2]); s6_controls holds s6_increment and s6_bumpThenCopy, which this test does not call, so the page's own counts stay at 0; read outside an action throws: ${msg}`;
  } finally { L.dispose(); }
}
