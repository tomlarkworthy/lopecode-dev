  spec_is(spec_okCells("const k = () => 5;\nconst o = (): StateCell<number> => state(0);\nconst t = (o: State<number>, k: number, log: Log, invalidation: Invalidation) => action((n: number) => {\n  log(\"set\");\n  o.set(k + n);\n});"), "k:ok,o:ok,t:ok");
  return `${spec_rejectsFor("S6.9")}; a cell with no state, log, invalidation, the action's argument, and a const or function computed from a cell with no state, are accepted`;
