  { statement: "S5.8", rule: "mut-capture", source: "type N<T> = { readonly n: T };\ntype D = N<N<N<N<N<N<N<N<N<N<N<N<N<number>>>>>>>>>>>>>;\nconst a = () => (p: D) => () => p.n;" },
