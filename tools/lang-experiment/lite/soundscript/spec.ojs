test_spec_S7_6 = {
  const said = [], was = console.error;
  let E;
  try {
    // messages from this test's listener are kept; any other goes on to the console
    console.error = (...a) => {
      const m = a.map((x) => (x instanceof Error ? x.message : String(x))).join(" ");
      if (m.includes("listener onNum") && m.includes("events nums")) said.push(m); else was(...a);
    };
    E = await spec_editor(spec_stream(60, { throwEvery: 10 }));
    await spec_frames(async () => (await E.value("seen")).last >= 59);
    for (let i = 0; i < 10; i++) await new Promise((r) => requestAnimationFrame(r));
    await spec_flush();
    const s = await E.value("seen");
    spec_is([s.count, s.last], [54, 59]);
    const named = said.filter((m) => m.includes("listener onNum") && m.includes("action record") && m.includes("events nums"));
    spec_is(named.length, 6);
    return `6 of 60 calls threw and kept nothing; the rest were delivered (count 54, last 59); ${JSON.stringify(named[0].slice(0, 80))}`;
  } finally { console.error = was; E?.dispose(); }
}
