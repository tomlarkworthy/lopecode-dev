// %%
test_spec_S8_5 = {
  const E = await spec_editor([
    "const base = () => 5;",
    "const seeded = (base: number): StateCell<number> => state(base);",
    "const own = (): StateCell<number> => state(0);",
    "const bump = (seeded: State<number>, own: State<number>) => action(() => { seeded.update((n) => n + 1); own.update((n) => n + 1); });",
    "const sq = (base: number) => base * base;",
    "const fromSq = (sq: number): StateCell<number> => state(sq);",
    "const bumpSq = (fromSq: State<number>) => action(() => fromSq.update((n) => n + 1));"
  ]);
  try {
    (await E.value("bumpSq"))();
    (await E.value("bump"))(); (await E.value("bump"))();
    await spec_flush();
    spec_is([await E.value("seeded"), await E.value("own"), await E.value("fromSq")], [7, 2, 26]);
    await E.edit("base", 'const base = () => "5";');
    await E.edit("own", 'const own = (): StateCell<number> => state("0");');
    spec_is([E.states().fromSq, E.states().own], ["blocked by sq", "rejected"]);
    await E.edit("base", "const base = () => 5;");
    await E.edit("own", "const own = (): StateCell<number> => state(0);");
    spec_is([await E.value("fromSq"), await E.value("own"), await E.value("seeded")], [25, 0, 5]);
    await E.edit("base", "const base = () => 6;");
    spec_is(await E.value("fromSq"), 36);
    return "fromSq, blocked by sq at 26, started again at 25 when base came back as 5, and at 36 from 6; own and seeded, rejected, started again";
  } finally { E.dispose(); }
}
// %%
test_spec_S8_6 = {
  const E = await spec_editor([
    "const seen = (): StateCell<{ readonly count: number; readonly last: number; readonly sum: number }> => state({ count: 0, last: 0, sum: 0 });",
    "const by = () => 1;",
    "const nums = function* () {\n  for (let i = 1; i < 1000000; i++) yield i;\n};",
    "const add = (seen: State<{ readonly count: number; readonly last: number; readonly sum: number }>, by: number) => action((v: number) => seen.update((s) => ({ count: s.count + 1, last: v, sum: s.sum + by })));",
    "const onNum = (nums: Events<number>, add: Action<[number]>) => on(nums, add);"
  ]);
  try {
    const seen = () => E.value("seen");
    await spec_frames(async () => (await seen()).count >= 5);
    const before = await seen();
    await E.edit("by", 'const by = () => "1";');
    spec_is([E.states().add, E.states().onNum], ["rejected", "blocked by add"]);
    await spec_flush();
    const broken = await seen();
    // a string sum would mean add ran with by already "1": the edit and add's rejected definition are one step (S8.3)
    if (typeof broken.sum !== "number") throw new Error(`add ran on the edited input: ${JSON.stringify(broken)}`);
    const during = `${broken.count - before.count} call(s) from the start of the edit to its end, sum ${broken.sum}`;
    for (let i = 0; i < 10; i++) await new Promise((r) => requestAnimationFrame(r));
    spec_is(await seen(), broken);
    await E.edit("by", "const by = () => 2;");
    await spec_frames(async () => (await seen()).count >= broken.count + 10);
    const s = await seen();
    // once each: as many calls as values since the repair, each adding by = 2
    if (s.count - broken.count > s.last - broken.last) throw new Error(`more calls than values since the repair: ${JSON.stringify([broken, s])}`);
    return `nothing delivered while add was rejected (count held at ${broken.count}); after the repair one listener, ${s.count - broken.count} calls for ${s.last - broken.last} values; ${during}`;
  } finally { E.dispose(); }
}
// %%
test_spec_S8_7 = {
  const texts = ["const x = () => 1;", "const y = (x: number) => x + 1;", "const bad = (x: number) => x +;", "const z = (bad: number) => bad;", "const go = (compile: Compile) => compile({ inputs: [\"x\"], refs: [], outputs: [\"y\"] });"];
  const c = soundscript.compiler(() => soundscript.joinCells(texts));
  const r = await c.for("go", {})({ inputs: ["x"], refs: [], outputs: ["y"] })({ x: 41 });
  spec_is(r.y, 42);
  let refused = "";
  try { c.for("go", {})({ inputs: ["bad"], refs: [], outputs: ["z"] }); } catch (e) { refused = e.message; }
  if (!/not ok by the checker/.test(refused)) throw new Error(`gave ${JSON.stringify(refused)}`);
  return `the island x, y runs (y is 42) beside an unparsable cell; ${refused}`;
}
// %%
md`## 9. Foreign values and the shell

Values from code the checker does not check, for a tool that runs the checker outside a notebook. A notebook module has no shell cells; its boundary to other code is section 11.`
// %%
md`**S9.1** A shell cell is an unchecked cell the checker is given beside the checked ones; a notebook module has none (S1.7). To a checked cell its value is \`unknown\`: an input with no annotation, or annotated \`unknown\` or its alias \`Js\`, gets \`unknown\`; \`any\` is \`[no-any]\`, and any other annotation is \`[inject-type]\`.`
// %%
md`**S9.2** A checked function from \`unknown\` that narrows with \`typeof\`, \`Array.isArray\` and \`in\` and builds a new value is accepted. It turns a value from a shell cell, or from another language (section 11), into a typed one.`
// %%
md`**S9.3** A foreign declaration (\`declare const\` or \`declare function\`, given to the checker beside the cells) is the trusted signature of an imported cell or library. Each is marked \`/** pure */\` or \`/** effect */\`; an unmarked one is \`[foreign-unmarked]\`, and a checked cell that takes an \`effect\` one is \`[foreign-effect]\`. A foreign declaration's name is used before a global of the same name. A notebook module has none.`
// %%
md`The cells of this section. \`s9_raw\` is Observable JavaScript; \`s9_size\` takes it as \`unknown\` and \`s9_decodeSize\` builds a typed \`{ w, h }\` from it.`
// %%
s9_raw = ({ w: 3, h: 1.5, extra: true })
// %%
//ss: ./spec-9.ts
// %%
spec_rejects_9 = [
  { statement: "S9.1", rule: "inject-type", source: "const b = (raw: number) => raw + 1;", shell: "export let raw = () => JSON.parse(\"1\");" },
  { statement: "S9.1", rule: "inject-type", source: "const b = (raw: string[]) => raw.length;", shell: "export let raw = () => JSON.parse(\"1\");" },
  { statement: "S9.1", rule: "no-any", source: "const b = (raw: any) => 1;", shell: "export let raw = () => JSON.parse(\"1\");" }
]
// %%
spec_rejects_9_view = spec_rejectsTable(spec_rejects_9)
// %%
test_spec_S9_1 = {
  for (const source of ["const b = (raw) => (typeof raw === \"number\" ? raw + 1 : 0);", "const b = (raw: unknown) => 1;", "const b = (raw: Js) => 1;"]) {
    const r = soundscript.checkSources({ cells: source, shell: "export let raw = () => JSON.parse(\"1\");", tsx: true });
    spec_is(r.cells.map((c) => `${c.name}:${c.status}:${c.errors.length}`), ["b:ok:0"]);
  }
  spec_is(spec_rulesOf({ source: "const b = (raw) => raw + 1;", shell: "export let raw = () => 1;" }), ["type"]);
  return `${spec_rejectsFor("S9.1")}; no annotation, unknown and Js are accepted, and an unannotated input is unknown (raw + 1 is [type])`;
}
// %%
test_spec_S9_2 = {
  spec_is(spec_okCellsWith("type S = { readonly w: number; readonly h: number };\nconst decode = () => (x: unknown): S => {\n  if (typeof x !== \"object\" || x === null) throw new Error(\"not an object\");\n  if (!(\"w\" in x) || typeof x.w !== \"number\") throw new Error(\"w\");\n  if (!(\"h\" in x) || typeof x.h !== \"number\") throw new Error(\"h\");\n  return { w: x.w, h: x.h };\n};\nconst n = () => (x: unknown) => (Array.isArray(x) ? x.length : 0);", []), "decode:ok,n:ok");
  spec_is(await spec_module.value("s9_size"), { w: 3, h: 1.5 });
  return "a decoder narrowing with typeof, in and Array.isArray is accepted; s9_size is {w:3,h:1.5}, without extra";
}
// %%
test_spec_S9_3 = {
  const rules = (cells, foreign) => { const r = soundscript.checkSources({ cells, foreign, tsx: true }); return [...r.module, ...r.cells.flatMap((c) => c.errors)].map((e) => e.rule).sort(); };
  spec_is(rules("const a = () => 1;", "declare const thing: number;"), ["foreign-unmarked"]);
  spec_is(rules("const a = (send) => typeof send;", "/** effect */\ndeclare const send: (s: string) => void;"), ["foreign-effect"]);
  spec_is(rules("const a = (lib: number) => lib + 1;", "/** pure */\ndeclare const lib: number;"), []);
  spec_is(rules("const href = (location) => location.myHref;\nconst b = (href: string) => href;", "/** pure */\ndeclare const location: { readonly myHref: string };"), []);
  return "unmarked: [foreign-unmarked]; an effect foreign taken: [foreign-effect]; a pure one, and one named like a global, accepted";
}
// %%
md`## 10. Tests

A test is a cell.`
// %%
md`**S10.1** A cell whose name starts with \`test_\` is a test. It is checked and compiled as any other cell.`
// %%
md`**S10.2** A test passes when its value resolves and fails when it throws or rejects. A test that has not settled has not passed.`
// %%
md`The cells of this section. \`test_s10_double\` is a test of \`s10_double\`, which it takes as a parameter.`
// %%
//ss: ./spec-10.ts
// %%
spec_rejects_10 = [
  { statement: "S10.1", rule: "free-name", source: "const test_log = () => console;" }
]
// %%
spec_rejects_10_view = spec_rejectsTable(spec_rejects_10)
// %%
test_spec_S10_1 = {
  spec_is(spec_okCells("const a = () => 1;\nconst test_a = (a: number) => {\n  if (a !== 1) throw new Error(\"a\");\n  return \"ok\";\n};"), "a:ok,test_a:ok");
  return `${spec_rejectsFor("S10.1")}; a test takes what it tests as a parameter`;
}
// %%
test_spec_S10_2 = {
  const L = await spec_load("const test_ok = () => \"fine\";\nconst test_fails = () => {\n  throw new Error(\"broken\");\n};\nconst test_later = async () => {\n  await Promise.resolve();\n  throw new Error(\"later\");\n};", {});
  try {
    spec_is(await L.value("test_ok"), "fine");
    const err = async (n) => { try { await L.value(n); return null; } catch (e) { return e.message; } };
    spec_is([await err("test_fails"), await err("test_later")], ["broken", "later"]);
    spec_is(await spec_module.value("test_s10_double"), "s10_double(21) is 42");
    return "test_ok resolves; test_fails throws and test_later rejects; test_s10_double passes";
  } finally { L.dispose(); }
}
// %%
md`## 11. Observable JavaScript and raw cells

A SoundScript cell reads a cell written in another language of the same module through a typed parameter. The value is checked and copied on the way in.`
// %%
md`**S11.1** A parameter that names no SoundScript cell, foreign declaration, shell cell or capability, but names another variable of the module (an Observable JavaScript cell, a raw cell or an import), takes that variable's value. A parameter that names none of these is \`[inject-unknown]\`.`
// %%
md`**S11.2** Such a parameter must have a type annotation; without one it is \`[boundary-unannotated]\`.`
// %%
md`**S11.3** The annotation may use \`number\`, \`string\`, \`boolean\`, \`null\`, \`undefined\`, literal types, \`unknown\`, arrays, tuples, object types and interfaces with no methods or index signature, unions, and aliases of these. Any other annotation is \`[boundary-type]\`: a function type, \`Promise\`, \`Map\`, \`Set\` or another class, \`Events<T>\`.`
// %%
md`**S11.4** Each value that arrives is checked against the annotation. A value that does not match makes the reading cell throw a \`TypeError\` that names the place, such as \`rows[1].price: expected number, found string "12"\`. Cells that do not depend on the reading cell are not affected, and the reading cell runs again on the next value.`
// %%
md`**S11.5** The cell is given a deep-frozen copy. An object keeps only the properties its type declares. \`unknown\` accepts primitives, arrays and plain objects, and copies them whole; a function, a promise or an instance of a class is a mismatch (S11.4).`
// %%
md`**S11.6** A copy is made for each value that arrives, so a value changed in place by the other language and delivered again is seen. A copy equal to the last one the same parameter was given is that one, so the reading cell is not run again.`
// %%
md`**S11.7** \`x: State<T>\` takes the view of an Observable JavaScript \`viewof x\`, or the handle of a SoundScript state cell imported from another module with \`import {viewof x} from …\`. Each write is checked against \`T\`. On any other cell in another language, and when two parameters in one module take the same view or state cell as \`State\` of different types, it is \`[boundary-state]\`.`
// %%
md`**S11.8** The view holds the value. A write through the \`State\` commits with its action: it sets the view's \`value\` and dispatches an \`input\` event. \`read\` inside an action gives what the control holds at that moment, which the control may have rounded or clamped, with the call's own earlier writes. A change the user makes on the control is not an action call.`
// %%
md`**S11.9** The value of a cell in another language is state: an action may not use it (\`[action-capture]\`, section 6). Take the view as \`State\` and \`read\` it inside the action; when the cell has no view, pass the value to the action as an argument.`
// %%
md`**S11.10** Adding, deleting or renaming a cell in another language checks the module's SoundScript cells again.`
// %%
md`The cells of this section: \`s11_rows\` and \`viewof s11_level\` are Observable JavaScript, \`s11_raw_area\` is raw, and the \`s11_\` cells after them are SoundScript.`
// %%
md`\`s11_late_twice\` takes \`s11_late\`, which no cell of this module defines, so it shows an error: it is rejected until \`test_spec_S11_10\` defines \`s11_late\` for a while (S11.10).`
// %%
s11_rows = [{ price: 1, name: "tea" }, { price: 2.5, name: "cake" }]
// %%
viewof s11_level = Inputs.range([0, 10], { step: 1, value: 5, label: "s11_level" })
// %%
define("s11_raw_area", [], function () {
  return 12;
})
// %%
//ss: ./spec-11.ts
// %%
spec_rejects_11 = [
  { statement: "S11.1", rule: "inject-unknown", source: "const f = (nothing: number) => nothing;", outside: [] },
  { statement: "S11.2", rule: "boundary-unannotated", source: "const f = (rows) => 1;", outside: [{ name: "rows" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (g: () => number) => 1;", outside: [{ name: "g" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (p: Promise<number>) => 1;", outside: [{ name: "p" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (m: Map<string, number>) => 1;", outside: [{ name: "m" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (o: { at: number; get(): number }) => 1;", outside: [{ name: "o" }] },
  { statement: "S11.3", rule: "boundary-type", source: "const f = (e: Events<number>) => 1;", outside: [{ name: "e" }] },
  { statement: "S11.7", rule: "boundary-state", source: "const f = (rows: State<number[]>) => 1;", outside: [{ name: "rows" }] },
  { statement: "S11.7", rule: "boundary-state", source: "const f = (level: State<number>) => 1;\nconst g = (level: State<string>) => 1;", outside: [{ name: "level", view: true }] },
  { statement: "S11.9", rule: "action-capture", source: "const n = () => state(0);\nconst copy = (n: State<number>, level: number) => action(() => n.set(level));", outside: [{ name: "level", view: true }] },
  { statement: "S11.9", rule: "action-capture", source: "const n = () => state(0);\nconst copy = (n: State<number>, rows: number) => action(() => n.set(rows));", outside: [{ name: "rows" }] }
]
// %%
spec_rejects_11_view = spec_rejectsTable(spec_rejects_11)
// %%
spec_load = async (source, outside) => {
  // source's SoundScript cells compiled and run in a module of their own beside outside, {name: [inputs,
  // function]}, plain variables standing for cells in other languages, or {name: {from: module}}, an
  // import of name from module; every variable observed
  const m = runtime.module();
  ss_instances.add(m);
  m.define("ss", [], () => ss);
  for (const [n, x] of Object.entries(outside)) if (Array.isArray(x)) m.define(n, x[0], x[1]); else m.import(n, x.from);
  const list = ss_outside(m);
  const texts = soundscript.splitCells(source, true);
  const ctx = soundscript.contextFromCheck(soundscript.checkCells(texts, true, list).result);
  const defs = texts.flatMap((t) => soundscript.compileCell(t, true, ctx));
  const fns = await realize(defs.map((d) => d.definition), runtime);
  const vars = defs.map((d, i) => m.variable({}).define(d.name, d.inputs, fns[i]));
  return { module: m, value: (n) => m.value(n), dispose: () => { for (const v of [...runtime._variables]) if (v._module === m) { soundscript.release(v._value); v.delete(); } } };
}
// %%
test_spec_S11_1 = {
  const ok = spec_okCellsWith("const a = (rows: number[]) => rows.length;", [{ name: "rows" }]);
  if (ok !== "a:ok") throw new Error(ok);
  // now is the capability, a Clock, not the other language's number
  const cap = spec_rulesOf({ source: "const a = (now: number) => now;", outside: [{ name: "now" }] });
  if (JSON.stringify(cap) !== '["inject-type"]') throw new Error(`a capability named like another variable gave ${JSON.stringify(cap)}`);
  // now is the SoundScript cell, a number, not the other language's string
  const wins = spec_rulesOf({ source: "const now = () => 1;\nconst a = (now: string) => now;", outside: [{ name: "now" }] });
  if (JSON.stringify(wins) !== '["inject-type"]') throw new Error(`a cell named like another variable gave ${JSON.stringify(wins)}`);
  if ((await spec_module.value("s11_area")) !== 13) throw new Error("s11_area is not 13");
  return `${spec_rejectsFor("S11.1")}; a capability and a SoundScript cell named like another variable win; s11_area reads the raw s11_raw_area`;
}
// %%
test_spec_S11_2 = spec_rejectsFor("S11.2")
// %%
test_spec_S11_3 = {
  const ok = spec_okCellsWith('type R = { a: number; b?: string[] };\nconst f = (x: R | null, y: unknown, z: [number, "a" | "b"], w: boolean, u: undefined) => 1;', ["x", "y", "z", "w", "u"].map((name) => ({ name })));
  if (ok !== "f:ok") throw new Error(ok);
  return `${spec_rejectsFor("S11.3")}; primitives, literals, unknown, tuples, optional properties and unions are accepted`;
}
// %%
test_spec_S11_4 = {
  let rows = [{ price: 1 }, { price: 2 }];
  const L = await spec_load("const total = (rows: { price: number }[]) => rows.reduce((a, r) => a + r.price, 0);\nconst other = (rows: unknown) => 7;", { rows: [[], () => rows] });
  try {
    if ((await L.value("total")) !== 3) throw new Error("total is not 3");
    L.module.redefine("rows", [], () => [{ price: 1 }, { price: "12" }]);
    let msg = null;
    try { await L.value("total"); } catch (e) { msg = e.message; if (!(e instanceof TypeError)) throw e; }
    if (msg !== 'rows[1].price: expected number, found string "12"') throw new Error(`gave ${msg}`);
    if ((await L.value("other")) !== 7) throw new Error("other is affected");
    L.module.redefine("rows", [], () => [{ price: 4 }]);
    if ((await L.value("total")) !== 4) throw new Error("total did not run again");
    if ((await spec_module.value("s11_total")) !== 3.5) throw new Error("s11_total is not 3.5");
    return msg;
  } finally { L.dispose(); }
}
// %%
test_spec_S11_5 = {
  const L = await spec_load("const keep = (o: { xs: number[] }) => o;\nconst whole = (u: unknown) => u;\nconst fn = (f: unknown) => 1;\nconst either = (e: { a: number } | { a: string }, q: number[] | string[]) => [e.a, q.length];", { o: [[], () => ({ xs: [1], extra: 2 })], u: [[], () => ({ a: [1, { b: 2 }] })], f: [[], () => () => 1], e: [[], () => ({ a: "x" })], q: [[], () => ["y"]] });
  try {
    const o = await L.value("keep"), u = await L.value("whole");
    if (!Object.isFrozen(o) || !Object.isFrozen(o.xs) || "extra" in o) throw new Error(`o is ${JSON.stringify(o)}, frozen ${Object.isFrozen(o)}`);
    if (!Object.isFrozen(u.a[1]) || JSON.stringify(u) !== '{"a":[1,{"b":2}]}') throw new Error(`u is ${JSON.stringify(u)}`);
    let msg = null;
    try { await L.value("fn"); } catch (e) { msg = e.message; }
    if (msg !== "f: expected data, found a function") throw new Error(`f gave ${msg}`);
    const ev = await L.value("either");
    if (JSON.stringify(ev) !== '["x",1]') throw new Error(`a union of objects or of arrays gave ${JSON.stringify(ev)}`);
    return `a frozen copy with the declared properties; unknown copied whole; ${msg}`;
  } finally { L.dispose(); }
}
// %%
test_spec_S11_6 = {
  const rows = [{ price: 1 }];
  const L = await spec_load("const total = (rows: { price: number }[]) => rows.reduce((a, r) => a + r.price, 0);", { rows: [[], () => rows] });
  try {
    await L.value("total");
    const v = [...runtime._variables].find((x) => x._module === L.module && x._name === "total");
    const runs = soundscript.evals(soundscript.idOf(String(v._definition)));
    rows[0].price = 5;
    L.module.redefine("rows", [], () => rows);
    if ((await L.value("total")) !== 5) throw new Error("a value changed in place was not seen");
    L.module.redefine("rows", [], () => [{ price: 5 }]);
    if ((await L.value("total")) !== 5) throw new Error("total");
    const more = soundscript.evals(soundscript.idOf(String(v._definition))) - runs;
    if (more !== 1) throw new Error(`total ran ${more} more times, expected 1`);
    return "changed in place: seen; equal again: not run again";
  } finally { L.dispose(); }
}
// %%
test_spec_S11_7 = {
  const bump = [...runtime._variables].find((v) => v._module === spec_module && v._name === "s11_bump");
  const inputs = bump._inputs.map((i) => i._name);
  if (!inputs.includes("viewof s11_level") || typeof (await spec_module.value("s11_bump")) !== "function" || typeof (await spec_module.value("s11_shown")) !== "number") throw new Error(`s11_bump takes ${inputs.join(", ")}`);
  // a state cell imported from another module
  const A = await spec_load("const count = (): StateCell<number> => state(0);", {});
  try {
    const B = await spec_load("const add = (count: State<number>) => action((k: number) => count.update((c) => c + k));\nconst seen = (count: number) => count;", { count: { from: A.module }, "viewof count": { from: A.module } });
    try {
      spec_is(ss_outside(B.module).find((o) => o.name === "count"), { name: "count", view: true });
      const add = await B.value("add");
      await spec_act(() => add(5));
      await spec_flush();
      spec_is([await A.value("count"), await B.value("seen")], [5, 5]);
    } finally { B.dispose(); }
  } finally { A.dispose(); }
  return `${spec_rejectsFor("S11.7")}; s11_bump takes viewof s11_level as State<number> through an input on it, s11_shown its value; add, in another module, takes the imported state cell count as State<number> through its imported viewof count and writes it (5)`;
}
// %%
test_spec_S11_8 = {
  const el = await spec_module.value("viewof s11_level");
  const bump = await spec_module.value("s11_bump"), big = await spec_module.value("s11_big");
  const handle = soundscript.viewRef(el, { k: "num" }, "s11_level");
  const readNow = () => { let v; soundscript.action(() => { v = soundscript.read(handle); })(); return v; };
  const was = el.value;
  const flushed = () => new Promise((r) => setTimeout(r, 0)).then(() => new Promise((r) => setTimeout(r, 0)));
  // a change on the control
  await spec_act(() => { el.value = 2; el.dispatchEvent(new Event("input", { bubbles: true })); });
  await flushed();
  if (readNow() !== 2) throw new Error(`after the control's change the State holds ${readNow()}`);
  let inputs = 0;
  const count = () => inputs++;
  el.addEventListener("input", count);
  try {
    await spec_act(() => bump());
    await flushed();
    if (el.value !== 5 || inputs !== 1 || readNow() !== 5) throw new Error(`after bump: control ${el.value}, ${inputs} input events, State ${readNow()}`);
    await spec_act(() => big());
    await flushed();
    if (el.value !== 10 || readNow() !== 10) throw new Error(`after big: control ${el.value}, State ${readNow()}`);
  } finally {
    el.removeEventListener("input", count);
    await spec_act(() => { el.value = was; el.dispatchEvent(new Event("input", { bubbles: true })); });
  }
  return "the control's change reaches the State; a write sets the control and dispatches one input; set(99) holds 10";
}
// %%
test_spec_S11_8_object = {
  // a view whose value is an array: a change on the control is not echoed back; a write dispatches one input
  const el = Object.assign(new EventTarget(), { value: [1, 2] });
  const L = await spec_load("const len = (picked: number[]) => picked.length;\nconst clear = (picked: State<number[]>) => action(() => picked.set([]));", { "viewof picked": [[], () => el], picked: [["viewof picked"], async function* (v) { yield v.value; for (;;) yield await new Promise((r) => v.addEventListener("input", () => r(v.value), { once: true })); }] });
  try {
    let inputs = 0;
    el.addEventListener("input", () => inputs++);
    await spec_act(() => { el.value = [1, 2, 3]; el.dispatchEvent(new Event("input")); });
    await spec_flush();
    spec_is([inputs, await L.value("len")], [1, 3]);
    const clear = await L.value("clear");
    await spec_act(() => clear());
    await spec_flush();
    spec_is([inputs, el.value, await L.value("len")], [2, [], 0]);
    return "the control's change: one input event, len 3; clear: one more input event, the control holds [], len 0";
  } finally { L.dispose(); }
}
// %%
test_spec_S11_9 = spec_rejectsFor("S11.9")
// %%
test_spec_S11_10 = {
  const name = (n) => [...runtime._variables].find((v) => v._module === spec_module && v._name === n);
  const rejected = () => soundscript.compiledKind(String(name("s11_late_twice")?._definition))?.callee === "rejected";
  const until = async (f) => { for (let i = 0; i < 200 && !f(); i++) await new Promise((r) => setTimeout(r, 50)); return f(); };
  // edits run one at a time; the module is first settled, so the wait is for this test's change alone
  await ss_language.settle(spec_module);
  if (!rejected()) throw new Error("s11_late_twice runs before s11_late exists");
  const late = spec_module.variable({}).define("s11_late", [], () => 21);
  try {
    if (!(await until(() => !rejected()))) throw new Error("s11_late_twice was not checked again when s11_late was added");
    if ((await spec_module.value("s11_late_twice")) !== 42) throw new Error("s11_late_twice is not 42");
    // renamed: s11_late no longer exists
    late.define("s11_late_renamed", [], () => 21);
    if (!(await until(rejected))) throw new Error("s11_late_twice was not checked again when s11_late was renamed");
    late.define("s11_late", [], () => 21);
    if (!(await until(() => !rejected()))) throw new Error("s11_late_twice was not checked again when the name came back");
  } finally { late.delete(); }
  if (!(await until(rejected))) throw new Error("s11_late_twice was not checked again when s11_late was deleted");
  return "rejected; 42 once s11_late was added; rejected once it was renamed; 42 when renamed back; rejected once it was deleted";
}
// %%
md`## Not specified

Behaviour the code has today that this page does not promise. Each item is undecided or unfinished, and none should be relied on.`
// %%
md`- \`DataView\`, \`TextEncoder\`, \`TextDecoder\` and \`Symbol\` were on the first list of allowed intrinsics (the tutorial's rule list), but the checker has no signatures for them: reading one leaves the cell unsupported, and \`new\` on one is \`[new-non-intrinsic]\`.`
// %%
md`- \`BigInt64Array\` and \`BigUint64Array\` are \`[free-name]\`: the checker models the other nine typed arrays (S2.6) but not these two. Whether they should be allowed is not decided.`
// %%
md`- \`prototype\` read through a value's \`constructor\`, such as \`[].constructor.prototype\`, leaves the cell unsupported: neither \`[banned-member]\` (S2.7) nor another rule rejects it, and in a notebook module the cell is rejected (S8.2).`
// %%
md`- \`Object.assign\` onto a fresh literal (\`Object.assign({}, o)\`), \`satisfies\` and the array method \`with\` leave the cell unsupported: the checker neither accepts nor rejects it. In a notebook module such a cell is rejected (S8.2).`
// %%
md`- A prelude function used as a value, such as \`const f = () => mut\` or \`() => borrow\`, is accepted. Only \`on\` is rejected as a value (\`[listener-placement]\`). Whether passing \`mut\` or \`borrow\` around should be allowed is not decided.`
// %%
md`- An angle-bracket cast \`<number>e\` is \`[no-cast]\` when the module is checked without JSX; a notebook module is checked with JSX, where it does not parse.`
// %%
md`- Whether a listener cell runs again when its events cell stops and starts again (S7.5). In the notebook the count differs from load to load: on 2026-11-16 \`onNum\` ran once more after a stop and a start in one load and not at all in another; the value of \`test_spec_S7_5\` gives this load's count. The stdlib's own test harness counts none.`
// %%
md`- A write to a state cell while it is computing again, after an input changed and before the cell has run (S6.2). Today it goes to the state cell as it was, and is kept only if the cell runs again with the same inputs.`
// %%
md`- An \`Action\` held in a state cell (an undo stack, a current tool). The checker accepts it; what the state cell holds after the action's cell is edited or deleted is observed, not decided.`
// %%
md`- The order of listeners in different modules. The runtime orders them by module name and then by place; a module with no name, such as one made for a test, is given a random one.`
// %%
md`- An async generator as an events cell. The checker takes only a sync generator as \`Events\` (S7.1); the runtime also delivers an async generator's values.`
// %%
md`- A type declared twice: the first is used, and the second is a module-level \`[duplicate-cell]\` with no line of the first.`
// %%
md`- A top-level \`declare const\` is \`[module-level]\` today (S1.4). Whether an ambient declaration belongs in a module of cells is not decided.`
// %%
md`- A cell in another language read by an island of \`compile(...)\`. Today it is rejected: naming one, say \`k\`, as an island input is \`[compile-island]\` with the message "no cell k".`
// %%
md`- \`compile(...)\` and \`pool\` beyond S2.5 and S8.7. The checker has three rules for them that no statement gives: \`[compile-island]\` (an island that is not a set of ok, synchronous cells), \`[compile-options]\` (options other than \`{ runtime?: Pool }\`) and \`[compile-boundary]\` (an island input that cannot be sent to a worker, such as a function).`
// %%
md`- A dependency cycle that passes through a cell in another language. The checker is given only the names of those cells, not their inputs, so it cannot see one.`
// %%
md`- A DOM node from another language placed in JSX.`
// %%
md`- A promise started in an action that is neither awaited nor returned, and writes to a state cell when it settles. Today the write throws if no call is in flight; otherwise it is counted as part of the call in flight, whichever action that call belongs to.`
// %%
md`- A call that never finishes. Today it holds every later top-level call, on the whole page, and nothing ends it.`
// %%
md`- A handler that makes several top-level calls, such as \`onClick={() => { begin(); load(); }}\`. An event attribute takes one action, so this is not provided.`
// %%
md`- A change the user makes on a view's control while an action call that wrote the view is waiting to commit. Today the commit replaces the user's change.`
// %%
md`- An action taken before its state cell went into error, and called while the state cell is in error. Today it writes the state cell's last store, and the write is kept if the state cell is repaired with the same inputs.`
// %%
md`- \`set\`, \`update\` or \`read\` on a handle from outside an action, such as Observable JavaScript holding \`viewof c\`, while a call is in flight. Today it does not throw and is counted as part of the call in flight.`
// %%
md`- An action called directly from Observable JavaScript, outside an event handler or a listener, while a call is in flight. Today it is counted as part of the call in flight, not queued.`
// %%
spec_coverage = Generators.observe((notify) => {
  // drawn again when a test settles and when a cell of this module is added, edited or deleted; a test that
  // has not settled is shown as running, so a hung test does not hold the table
  const status = new Map();
  let queued = false;
  const draw = () => { queued = false; notify(spec_coverageOf(status, redraw)); };
  const redraw = () => { if (!queued) { queued = true; queueMicrotask(draw); } };
  redraw();
  return onCodeChange(({ variable, previous }) => { if ((variable ?? previous)?._module === spec_module) redraw(); });
})
// %%
spec_coverageOf = (status, redraw) => {
  // statements are the **S<n>.<m>** marks in this module's cells; a test names the statements it checks
  // (test_spec_S1_2 checks S1.2); a test passes if its value resolves. status: name -> { definition, state }
  const vars = [...runtime._variables].filter((v) => v._module === spec_module);
  const titles = new Map(), statements = new Map();
  for (const v of vars) {
    const text = String(v._definition);
    for (const m of text.matchAll(/## (\d+)\. ([^\n`]+)/g)) titles.set(m[1], m[2].trim());
    for (const m of text.matchAll(/\*\*S(\d+)\.(\d+)\*\*/g)) statements.set(`S${m[1]}.${m[2]}`, m[1]);
  }
  const tests = vars.filter((v) => typeof v._name === "string" && v._name.startsWith("test_spec_"));
  for (const t of tests) {
    if (status.get(t._name)?.definition === t._definition) continue;
    const entry = { definition: t._definition, state: "running" };
    status.set(t._name, entry);
    const done = (state) => () => { if (status.get(t._name) === entry) { entry.state = state; redraw(); } };
    spec_module.value(t._name).then(done("pass"), done("fail"));
  }
  const names = new Map(tests.map((t) => [t._name, [...t._name.matchAll(/S(\d+)_(\d+)/g)].map((m) => `S${m[1]}.${m[2]}`)]));
  const rows = [...titles].map(([section, title]) => {
    const ids = [...statements].filter(([, s]) => s === section).map(([id]) => id);
    const own = tests.filter((t) => names.get(t._name).some((id) => statements.get(id) === section));
    const tested = ids.filter((id) => own.some((t) => names.get(t._name).includes(id)));
    const count = (state) => own.filter((t) => status.get(t._name)?.state === state).length;
    return { section, title, statements: ids.length, tested: tested.length, tests: own.length, passing: count("pass"), running: count("running"), untested: ids.filter((id) => !tested.includes(id)) };
  });
  const unknown = [...names].flatMap(([n, ids]) => ids.filter((id) => !statements.has(id)).map((id) => `${n} (${id})`));
  return { rows, unknown };
}
// %%
viewof spec_module = thisModule()
