// %%
test_spec_S4_6 = {
  // a cell's value is deep-frozen when the cell returns: its array, its Map and its Set refuse a write from any code.
  // a sync cell's value is frozen too (B7's unfrozen quick path was removed 2026-11-22)
  const V = await spec_load("const v = async () => ({ xs: [1], m: new Map<string, number[]>([[\"k\", [1]]]), s: new Set([1]) });\nconst q = () => ({ xs: [1] });", {});
  try {
    const v = await V.value("v"), q = await V.value("q");
    const tries = [() => v.xs.push(2), () => v.m.set("j", []), () => v.m.get("k").push(2), () => v.s.add(2), () => { v.n = 1; }];
    const got = tries.map((f) => { try { f(); return "no throw"; } catch (e) { return e instanceof TypeError ? "TypeError" : String(e); } });
    spec_is([...got, v.m instanceof Map, JSON.stringify([...v.m])], ["TypeError", "TypeError", "TypeError", "TypeError", "TypeError", true, '[["k",[1]]]']);
    spec_is(Object.isFrozen(q.xs), true);
  } finally { V.dispose(); }
  return `${spec_acceptsFor("S4.6")}; an async cell's array, record, Map and Set refuse a write; a sync cell's value is frozen`;
}
// %%
test_spec_S4_6_reach = {
  // holes6 (2026-11-22): what a published function captures is frozen when it is published (the compiler registers
  // each closure's captured locals); an Error is frozen; a URL is the guarded SsURL; a typed array is published as a copy
  const V = await spec_load("const f = () => { const xs: readonly number[] = [1]; const h = () => xs; return () => h(); };\nconst e = () => new Error(\"x\");\nconst u = () => new URL(\"https://x.test/a\");\nconst t = () => { const a = new Uint8Array(2); return { a, b: a }; };", {});
  try {
    const f = await V.value("f"), e = await V.value("e"), u = await V.value("u"), t = await V.value("t");
    const tries = [() => f().push(2), () => { e.message = "y"; }, () => { e.name = "Y"; }, () => { u.pathname = "/b"; }];
    const got = tries.map((g) => { try { g(); return "no throw"; } catch (x) { return x instanceof TypeError ? "TypeError" : String(x); } });
    spec_is([...got, u.href, t.a === t.b, t.a instanceof Uint8Array], ["TypeError", "TypeError", "TypeError", "TypeError", "https://x.test/a", true, true]);
  } finally { V.dispose(); }
  return "a published function's captures, an Error and a URL refuse a write; a typed array published twice in one value is one copy";
}
// %%
test_spec_S4_6_host = {
  // holes7 (2026-11-22): the two host behaviours the bun runs cannot show. The notebook's runtime would adopt a cell
  // value with a callable then: at the top the checker rejects it ([type]); nested, where the checker does not look,
  // deepFreeze throws at publish. And a URL's searchParams is a snapshot, not bound to its URL
  const V = await spec_load("const p = () => ({ n: 1, then: (r: (v: string) => void) => r(\"str\") });\nconst q = () => ({ x: { then: (r: (v: string) => void) => r(\"str\") } });", {});
  const why = (n) => V.value(n).then((v) => `fulfilled with ${JSON.stringify(v)}`, (x) => (/does not check: \[banned-member\]/.test(x?.message) ? "[banned-member]" : !/callable then/.test(x?.message) ? String(x) : /does not check: \[type\]/.test(x.message) ? "[type]" : x instanceof TypeError ? "TypeError" : String(x)));
  let got;
  try { got = [await why("p"), await why("q")]; } finally { V.dispose(); }
  const x = new soundscript.SsURL("https://x.test/?q=1"), q = x.searchParams;
  x.search = "?q=2";
  // w1 (2026-11-24): a key named then is [banned-member] (S2.7), so the checker refuses both cells now
  spec_is([...got, q.get("q"), x.searchParams.get("q")], ["[banned-member]", "[banned-member]", "1", "2"]);
  return "a cell value with a then member, at the top or nested, is rejected by the checker ([banned-member] since w1); searchParams read before a write keeps the value it had";
}
// %%
test_spec_S4_6_holes8 = {
  // holes8 (2026-11-22): a function the cell keeps that captures a promise is [mut-capture], and (x1, 2026-11-24) a
  // promise given the type unknown is [forgets]; a rejection reason is deep-frozen,
  // one reason for every reader; a native Map from structuredClone is published as a frozen copy; a match array's
  // groups and indices are frozen; an action's arguments are frozen all or none; an island on the page takes and
  // gives structured clones, as a worker does
  const V = await spec_load("const k = () => { const p = Promise.resolve([1]); return () => p; };\nconst k2 = () => { const p: unknown = Promise.resolve([1]); return () => p; };\nconst n = () => ({ m: structuredClone(new Map([[\"k\", 1]])) });\nconst g = () => ({ m: /(?<g>a)/d.exec(\"ab\") });\nconst s = () => state(0);\nconst add = (s: State<number>) => action((a: number[], b: Iterable<number>) => { s.set(a.length); });", {});
  const tries = (fs) => fs.map((f) => { try { f(); return "no throw"; } catch (x) { return x instanceof TypeError ? "TypeError" : String(x); } });
  let got;
  try {
    const why = (n) => V.value(n).then(() => "fulfilled", (x) => (/does not check: \[mut-capture\] p holds a promise/.test(x?.message) ? "[mut-capture]" : /does not check: \[forgets\] Promise<number\[\]> is given the type unknown/.test(x?.message) ? "[forgets]" : /promise where it cannot be replaced/.test(x?.message) && x instanceof TypeError ? "TypeError" : String(x)));
    const k = [await why("k"), await why("k2")];
    // the rejection through deepFreeze directly, a catch attached at once: a cell's rejected promise read by this test
    // later than its task is an unhandled rejection the browser reports as a page error
    const rp = soundscript.deepFreeze({ p: Promise.reject(new Error("x")) }).p, c1 = rp.catch((x) => x), c2 = rp.catch((x) => x);
    const e1 = await c1, e2 = await c2;
    const n = await V.value("n"), g = await V.value("g"), add = await V.value("add");
    const xs = [0];
    try { add(xs, [1].values()); } catch {}
    got = [...k, e1 === e2, ...tries([() => { e1.message = "y"; }, () => n.m.set("j", 2)]), Object.isFrozen(g.m.groups), Object.isFrozen(g.m.indices), Object.isFrozen(xs)];
  } finally { V.dispose(); }
  const c = soundscript.compiler(() => soundscript.joinCells(["const x = () => [1];", "const y = (x: number[]) => x;", "const go = (compile: Compile) => compile({ inputs: [\"x\"], refs: [], outputs: [\"y\"] });"]));
  const ys = [0], out = await c.for("go", {})({ inputs: ["x"], refs: [], outputs: ["y"] })({ x: ys });
  spec_is([...got, out.y === ys, Object.isFrozen(ys), Object.isFrozen(out.y)], ["[mut-capture]", "[forgets]", true, "TypeError", "TypeError", true, true, false, false, false, true]);
  return "a captured promise is [mut-capture], and one typed unknown is [forgets]; a rejection reason is frozen and the same for two readers; a structuredClone Map, a match array's groups and indices are frozen; an action that throws on an argument freezes none; an island on the page clones in and out";
}
