test_spec_S2_13 = {
  spec_is(await spec_module.value("s2_fib"), [832040, 1, [2, 2], 3, 6]);
  const m = soundscript.memo;
  let calls = 0;
  const sq = m((x) => { calls++; return typeof x === "number" ? x * x : x.length; });
  const xs = [1, 2], bytes = new Uint8Array(2);
  const got = [sq(3), sq(3), sq(0), sq(-0), sq(xs), sq(xs), sq(bytes), sq(bytes)];
  spec_is([got, calls, Object.isFrozen(xs)], [[9, 9, 0, 0, 2, 2, 2, 2], 6, true]);
  let tries = 0;
  const flaky = m((n) => { tries++; if (tries === 1) throw new Error("once"); return n; });
  spec_is([(() => { try { return flaky(1); } catch (e) { return e.message; } })(), flaky(1), flaky(1), tries], ["once", 1, 1, 2]);
  const st = await spec_module.value("viewof s2_counter"), act = soundscript.action(() => {});
  const inMemo = (g) => m(() => { try { g(); return "no throw"; } catch (e) { return e.message.split(" while ")[0]; } })();
  spec_is([inMemo(() => act()), inMemo(() => st.set(1)), inMemo(() => soundscript.read(st))], ["an action called", "a state written", "read(...) called"]);
  spec_is(spec_okCells("const sq = () => memo((n: number): number => n * n);\nconst twice = (sq: (n: number) => number) => ({ f: sq, v: sq(3) + sq(3) });"), "sq:ok,twice:ok");
  spec_is(soundscript.check("const f = () => { const g = (n: number) => n; return memo(g); };", true).cells[0].status, "unsupported");
  spec_is(soundscript.check("const f = () => { const fib = memo((n: number) => (n < 2 ? n : fib(n - 1))); return fib(3); };", true).cells[0].status, "unsupported");
  spec_is(spec_okCells("const f = () => {\n  const sq = memo((xs: readonly number[]) => xs.length);\n  const m = [1];\n  const k = sq(snapshot(m));\n  m.push(2);\n  return k + m.length;\n};"), "f:ok");
  let fcalls = 0;
  const nOf = m((o) => { fcalls++; return o.n; });
  const withFn = { n: 1, f: () => 1 }, deep = [{ n: 2, g: [() => 2] }], plain = { n: 3 };
  spec_is([nOf(withFn), nOf(withFn), nOf(deep), nOf(deep), nOf(plain), nOf(plain), fcalls], [1, 1, undefined, undefined, 3, 3, 5]);
  return `${spec_rejectsFor("S2.13")}; a Mut written after a memoised call that was given snapshot(m) is accepted; s2_fib is ${JSON.stringify(await spec_module.value("s2_fib"))}; a hit does not call f, 0 and -0 are two keys, an array argument is frozen, a typed array argument is not stored, an argument that reaches a function is not stored, a throw stores nothing; an action call, a state write and read inside f throw; a memoised function crosses to another cell; memo of a named function and an unannotated recursive memo are unsupported`;
}
