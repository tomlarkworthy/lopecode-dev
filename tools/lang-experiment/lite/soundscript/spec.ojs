test_spec_S3_8 = spec_rejectsFor("S3.8")
// %%
test_spec_S3_9 = spec_rejectsFor("S3.9")
// %%
test_spec_S3_10 = {
  spec_is(spec_okCells("const a = () => {\n  let n = 0;\n  for (let i = 0; i < 3; i++) n += i;\n  while (n > 100) n--;\n  for (const x of [1]) n += x;\n  do { n += 1; } while (n < 0);\n  try {\n    if (n < 0) throw new Error(\"x\");\n  } catch (e) {\n    n = -1;\n  } finally {\n    n += 0;\n  }\n  return n;\n};"), "a:ok");
  spec_is(await spec_module.value("s3_steps"), -6);
  return "statements accepted; s3_steps is -6";
}
// %%
test_spec_S3_11 = {
  spec_is(spec_okCells("const a = () => {\n  let n = 0;\n  const inc = () => {\n    n++;\n  };\n  function add(k: number) {\n    n += k;\n  }\n  inc();\n  add(2);\n  const read = () => n;\n  return read();\n};"), "a:ok");
  spec_is(await spec_module.value("s3_tree"), [1, [2, 30], []]);
  return `${spec_rejectsFor("S3.11")}; ${spec_acceptsFor("S3.11")}; helpers only called may assign; s3_tree is ${JSON.stringify(await spec_module.value("s3_tree"))}`;
}
// %%
test_spec_S3_12 = {
  spec_is(spec_okCells("const xs = (): number[] | null => [1];\nconst a = (xs) => xs === null || xs?.length === 1 || \"a\" === \"a\";"), "xs:ok,a:ok");
  spec_is(await spec_module.value("s3_same"), [true, false]);
  // includes and indexOf with a primitive element or argument are accepted
  spec_is(spec_okCells("const a = () => {\n  const xs = [1, 2];\n  const ys: (number[] | null)[] = [null];\n  return [xs.includes(2), xs.indexOf(1), ys.includes(null), \"ab\".includes(\"a\")];\n};"), "a:ok");
  return `${spec_rejectsFor("S3.12")}; equals compares structurally (s3_same is [true,false]); includes and indexOf with a primitive are accepted`;
}
// %%
test_spec_S3_13 = {
  spec_is(spec_okCells("const f = () => (a: number, b: string): number => {\n  switch (a) {\n    case 1: return 1;\n    case 2: { if (b === \"x\") return 3; break; }\n    default: return 0;\n  }\n  return 2;\n};\nconst g = () => (s: string | null): number => {\n  switch (s) {\n    case null: return 0;\n    case \"\": return 1;\n  }\n  return s.length;\n};"), "f:ok,g:ok");
  spec_is(await spec_module.value("s3_kinds"), ["vowel", "space", "digit", "other"]);
  return `${spec_rejectsFor("S3.13")}; switch on a number and on string | null is accepted; s3_kinds is ${JSON.stringify(await spec_module.value("s3_kinds"))}`;
}
// %%
test_spec_S3_14 = {
  // a switch and the if chain of the same tests give the same verdict and rules
  const pairs = [
    ["switch (t.k) { case \"n\": return t.v; case \"s\": return t.s.length; } return 0;", "if (t.k === \"n\") return t.v; if (t.k === \"s\") return t.s.length; return 0;"],
    ["switch (t.k) { case \"s\": return t.v; } return 0;", "if (t.k === \"s\") return t.v; return 0;"],
    ["switch (t.k) { case \"n\": return 1; default: return t.s.length; }", "if (t.k === \"n\") return 1; return t.s.length;"],
    ["switch (t.k) { case \"n\": case \"s\": return t.k.length; } return 0;", "if (t.k === \"n\" || t.k === \"s\") return t.k.length; return 0;"],
    ["switch (u) { case undefined: return 0; default: return u.length; }", "if (u === undefined) return 0; return u.length;"],
  ];
  const head = "type T = { readonly k: \"n\"; readonly v: number } | { readonly k: \"s\"; readonly s: string };\nconst f = () => (t: T, u: string | undefined): number => {\n";
  for (const [sw, chain] of pairs) spec_is(spec_rulesOf({ source: head + sw + "\n};" }), spec_rulesOf({ source: head + chain + "\n};" }));
  return `${spec_rejectsFor("S3.14")}; ${pairs.length} switches give the rules of their if chains`;
}
// %%
test_spec_S3_15 = {
  spec_is(spec_okCells("const f = () => (a: number): number => {\n  let n = 0;\n  switch (a) {\n    case 1: case 2: n = 1; break;\n    case 3: throw new Error(\"3\");\n    case 4: return 4;\n    default: n = 5;\n  }\n  return n;\n};\nconst g = () => (xs: readonly number[]): number => {\n  let n = 0;\n  for (const x of xs) {\n    switch (x) {\n      case 0: continue;\n      default: n += x;\n    }\n  }\n  return n;\n};"), "f:ok,g:ok");
  return `${spec_rejectsFor("S3.15")}; empty cases, break, throw, return, continue and a last body that reaches its end are accepted`;
}
// %%
test_spec_S3_16 = {
  spec_is(spec_okCells("const f = () => (a: number): number => {\n  switch (a) {\n    case 1: { const x = 2; return x; }\n    default: { const x = 3; return x; }\n  }\n};"), "f:ok");
  return `${spec_rejectsFor("S3.16")}; a declaration in a block inside a case is accepted`;
}
// %%
test_spec_S3_17 = {
  spec_is(spec_okCells("const f = () => (a: \"x\" | \"y\" | null): number => {\n  switch (a) {\n    case \"x\": return 1;\n    case \"y\": return 2;\n    case null: return 3;\n  }\n};\nconst g = () => (b: boolean): string => {\n  switch (b) {\n    case true: return \"t\";\n    case false: return \"f\";\n  }\n};"), "f:ok,g:ok");
  spec_is(await spec_module.value("s3_areas"), [9, 10, 0]);
  return `${spec_rejectsFor("S3.17")}; cases covering a union of literals and null, and true and false, need no return after; s3_areas is [9,10,0]`;
}
// %%
test_spec_S3_18 = {
  spec_is(spec_okCells("const f = () => (a: number): readonly number[] => {\n  const m = [1];\n  switch (a) {\n    case 1: m.push(2); break;\n    case 2: { m.push(3); break; }\n    default: m.push(4);\n  }\n  return m;\n};\nconst n = () => state(0);\nconst bump = (n: State<number>) => action((a: number) => {\n  switch (a) {\n    case 1: n.set(1); break;\n    default: n.update((x) => x + a);\n  }\n});"), "f:ok,n:ok,bump:ok");
  return `${spec_rejectsFor("S3.18")}; ${spec_acceptsFor("S3.18")}; a Mut written in cases and returned after, and a State written in a case inside an action, are accepted`;
}
// %%
test_spec_S3_19 = {
  spec_is(spec_okCells("const xs = () => [1, 2, 3];\nconst sum = () => (it: Iterable<number>) => {\n  let s = 0;\n  for (const x of it) s += x;\n  return s;\n};\nconst later = (xs: readonly number[], sum: (it: Iterable<number>) => number) => {\n  const made = new Map([[\"a\", 1]]);\n  const m: Map<string, number> = made;\n  const values = () => [...m.values()].length;\n  return () => sum(xs) + values() + [...\"ab\"].length;\n};"), "xs:ok,sum:ok,later:ok");
  spec_is(spec_okCells("const data = async (fetch: Fetch) => (await fetch(\"https://example.invalid/\")).json();\nconst rows = async (fetch: Fetch) => {\n  const res = await fetch(\"https://example.invalid/\");\n  if (!res.ok) return null;\n  const ok = res.status === 200;\n  return ok ? res.json() : null;\n};"), "data:ok,rows:ok");
  return `${spec_rejectsFor("S3.19")}; a function that captures an array, a Map or a function taking an Iterable, one that copies an iterator into an array, and a cell that reads the response it fetched, are accepted`;
}
// %%
test_spec_S3_20 = {
  spec_is(spec_okCells("const p = () => Object.freeze({ x: 1, ys: [2] });\nconst q = (p) => Object.freeze([p.x, ...p.ys]);"), "p:ok,q:ok");
  return `${spec_rejectsFor("S3.20")}; Object.freeze of an object literal and of an array literal is accepted`;
}
// %%
md`## 4. Local writes

A value is written in place only in the cell that made it. A local bound to a fresh value is writable, and everything a cell publishes is frozen as it leaves the cell (S4.6), so no cell sees a value it holds change. The static rules of this section report the common mistakes at the line that makes them; the freeze at run time is what the guarantee rests on, and a program that passes the rules and still writes a published value stops with a \`TypeError\` at the write.`
// %%
md`**S4.1** An unannotated local, \`const\` or \`let\`, whose initializer is a fresh value (S4.3) of type \`T\` has the type \`Mut<T>\`. On a \`Mut\` receiver, member writes, mutating methods and \`delete\` are accepted (S3.1, S3.2, S3.4). A \`Mut<T>\` is assignable to \`T\`; a \`T\` is not assignable to \`Mut<T>\`. A local bound to a fresh value and annotated with an array type, a tuple type, a type literal with no \`readonly\` member (an index signature \`{ [k: string]: T }\` included, since 2026-11-23), or \`Array\`, \`Map\`, \`Set\`, \`WeakMap\`, \`WeakSet\`, \`Record\` or a typed array, has the type \`Mut<T>\` for its annotation \`T\`, since 2026-11-23. A fresh value assigned to such a \`let\` keeps it writable. Any other annotation leaves the local unwritable: \`readonly T[]\`, \`ReadonlyArray<T>\`, \`Readonly<…>\`, a type literal with a \`readonly\` member, a union, a type alias, \`typeof\`. A local bound to a value that is not fresh is not writable.`
// %%
md`**S4.2** There is no marker call. \`mut(...)\`, \`freeze(...)\` and \`borrow(...)\` were removed from the language on 2026-11-22, and a call to one is \`[removed-call]\`.`
// %%
md`**S4.3** A fresh value is a literal, a spread copy, \`new\` on an intrinsic, the result of an intrinsic that returns a new value (\`Array.from\`, \`slice\`, \`map\`, \`structuredClone\`), or \`snapshot(v)\` (S5.5). A cell input, a parameter not typed \`Mut<…>\` and the result of a call whose return type is not \`Mut<…>\` are not fresh. A write through one of these, or through a local bound to one, is \`[member-write]\` or \`[mutating-method]\`, and passing one to a parameter typed \`Mut<…>\` is \`[type]\`. Since 2026-11-23 a member write or a mutating method whose receiver is a fresh value written in the same expression is accepted (\`[...xs].sort()\`, \`xs.slice().reverse()\`, \`[...xs][0] = 1\`): no other name holds that value. Only the fresh value itself is such a receiver; a member of it, a conditional or \`??\` with a fresh branch, the result of a function that returns its argument, and the result of a mutating method (\`[...xs].sort().reverse()\`) are not. \`toSorted\`, \`toReversed\`, \`toSpliced\` and \`with\` (arrays; typed arrays have \`toSorted\`, \`toReversed\` and \`with\`) return a new array, and the message of a write to a value that is not Mut names the one that fits.`
// %%
md`**S4.4** A \`Mut\` may be bound to a second name, placed in an array or object literal, passed to a parameter typed \`Mut<…>\`, which may write it, and passed to any parameter of its plain type. Every name is the same value, and a write through one is seen through the others. What a cell exposes is read with every \`Mut\` removed: a cell that takes it gets a read-only value, and a write there is \`[member-write]\` or \`[mutating-method]\`. The \`Mut\` is removed wherever S5.8 finds one, also, since 2026-11-23, in the result of a function the cell exposes. A cell that calls such a function gets a read-only result, even when the function made it fresh. A parameter of an exposed function keeps its \`Mut\`, so a cell that calls it passes a value of its own. \`Mut\` in the type of a cell input is \`[mut-cell]\`.`
// %%
md`**S4.5** A function is kept when it is returned, yielded, stored, or passed to something that may call it later. A helper bound to a local \`const\` or declared with \`function\` and only called (S3.11) is not kept, nor is a callback of an intrinsic that calls it before returning. A kept function does not capture a \`Mut\` or a \`let\` of an enclosing function (S4.10). A capture of a \`Mut\` is \`[mut-capture]\` in every case; the message names the case when the kept function writes the \`Mut\`, returns it or yields it; when the \`Mut\` is written after the function is made, later in the text, in a loop that makes the function, or inside another function; when the \`Mut\` is a typed array or a \`URL\` that a name in the cell can still write; and, in a generator cell or in a nested async or generator function, when any \`Mut\` is written after the function is made.`
// %%
md`**S4.6** At run time every value a cell publishes is frozen, with everything it reaches, when it is published: the value a cell returns, each value a generator cell yields, the value a returned promise resolves to, a value written to a state cell, the arguments of an action, the arguments of a memoised function on a miss (S2.13), and the result of a worker. A write to a published value, from any code, throws a \`TypeError\`. A value written to a state cell and an action's arguments are first checked for a function or promise made in a body that still runs (S4.12). Arrays, records, \`Error\`s and JSX elements are frozen. A \`Map\`, \`Set\` or \`URL\` made in a cell is an instance of a subclass whose writing methods throw once it is frozen. The locals a published function uses are frozen with it. A typed array or \`ArrayBuffer\` is published as a copy, and a container that reaches one as a frozen copy; the cell keeps its original. The \`searchParams\` of a \`URL\` is a copy taken when it is read. Publishing throws, and the cell is in error, for: an iterator or a sync generator object (a cell whose value is one is \`[iterator-cell]\` first); a value with a callable \`then\` that is not a promise (as a cell's whole value also \`[type]\`); a function, \`Error\` or already frozen value that reaches a typed array; and a function that uses a binding not yet initialised. Since 2026-11-24 (y1) publishing, the arguments of an action call and a value written to a state cell also throw, anywhere in the value, for a response (\`fetch\`'s) and for an async iterator or async generator object; and when the cell's value type names no promise (the checker gives each compiled cell that fact), a cell's value throws for a promise anywhere in it, for a promise as its whole value when the cell is not async, and for a generator object as its whole value when the cell is not a generator. These refusals hold whatever type the value was given on the way, \`unknown\`, \`object\` or a type parameter included, which the checker does not follow (S2.9, S9.6). The message names the value and the place, such as \`a response cannot leave its cell: … (the value of g, at value[0].r)\`. A publish that throws changes no value.`
// %%
md`**S4.7** Only the first level of an inferred \`Mut\` is writable. A write to, or a mutating method of, a value held inside it (\`m.a.b = 2\`, \`m.xs.push(2)\`, \`m.get(k).push(2)\`) is \`[member-write]\` or \`[mutating-method]\`. A value held inside a \`Mut\` is written through a \`Mut\` local or parameter of its own, since a written type holds a \`Mut\` only as its whole type (S4.9).`
// %%
md`**S4.8** A view of a local buffer (\`subarray\`, \`buffer\`) may be bound and read; a write through it is \`[member-write]\`. Freezing does not stop a write to a typed array or a \`URL\`'s setters, so a generator cell that yields a typed array or a \`URL\` it can still write, also inside a literal, is \`[mut-yield]\`. A fresh copy (\`buf.slice()\` for a typed array, \`new URL(u.href)\` for a \`URL\`), a cell input, or a read-only \`const\` made from one is accepted.`
// %%
md`**S4.9** \`Mut<T>\` may be written only as the whole type of a parameter, of a function or of a function type, as the whole type of a local, or as the whole body of a type alias. An alias whose body is \`Mut<…>\`, or another such alias, stands for a \`Mut\` and follows the same rule. \`Mut\` anywhere else is \`[mut-nested]\`: in a record field, an array or tuple element, a type argument, a union member, a function's result, a type parameter's bound, or the body of an alias that is not \`Mut<…>\` itself. A \`typeof\` type anywhere but those places is \`[mut-nested]\` too, since it may hold a \`Mut\`. In the type of a cell input a \`Mut\` is \`[mut-cell]\` (S4.4). A function may return a \`Mut<…>\` parameter, and its result type is then inferred. Since 2026-11-23.`
// %%
md`**S4.10** A kept function (S4.5) does not capture a \`Mut\` local of an enclosing function, also only to read it. That is \`[mut-capture]\`. It does not capture a local or parameter of an enclosing function whose type holds a \`Mut\` (S5.8), also only to read it. That is \`[mut-capture]\` too. Such a type is inferred: \`[xs, 1] as const\`, \`{ k: xs } as const\`, \`xs.length > 0 ? xs : null\`, or the result of a generic helper called with \`xs\`, for a \`Mut\` local \`xs\`. A \`const\` of the same type with no \`Mut\` bound before the function may be captured: \`const c: [number[], 1] = t\`. It does not capture a \`let\` of an enclosing function, of any type. That is \`[let-capture]\`. A call of a helper that uses the local counts as a capture of it. A \`const\` that S4.1 does not make writable, or a \`const\` of a primitive type, bound before the function may be captured: \`const c: readonly number[] = out\`, \`const m: Map<string, number> = made\`, \`const c = n\` for a \`let n\`. A \`const m: Map<string, number> = new Map()\` is writable (S4.1), and capturing it is \`[mut-capture]\`. Such a \`const\` names the same value as the \`Mut\`, and a write to \`out\` is seen through \`c\`. The capture is safe only because every write to \`out\` comes before the function is published. When the cell returns, the cell's function has ended. While a function still runs, a function it made cannot be given to a state cell or an action: S4.12 makes that throw at run time. Even so, a kept function that captures a local holding a promise is \`[mut-capture]\`. Since 2026-11-22; a local whose type holds a \`Mut\` since 2026-11-23.`
// %%
md`**S4.11** A function does not write a local whose type holds a \`Mut\` (S5.8), or a \`Mut\` it owns, after a point where it gives a value to a holder while it still runs. Such a point is a call of a state's \`set\` or \`update\`, or either read as a value (\`const st = s.set\`, \`[f].forEach(s.set)\`); and a call of an action with arguments, or an action passed to a call. A call of a helper bound to a local \`const\` or declared with \`function\` that has such a point, and a callback that a built-in calls at once, put the point at that call. A write is after the point as a use is after a \`yield\` in S5.6: later in the text, in an expression that holds the point, or in a loop around the point when the local is declared outside that loop's body. A write is a member write, an update, a \`delete\`, a mutating method, passing the local to a parameter typed \`Mut<…>\`, or a call of a helper that writes it. Such a write is \`[member-write]\`, or \`[mutating-method]\` when it is a call. The rule does not look at what is given. It finds points and writes by name, so it does not see a setter taken by destructuring (\`const { set } = s\`) or by a computed member (\`s['set']\`), nor a write through a name bound after the point (\`const ys = xs; ys.push(1)\`), through a helper's result (\`get().push(1)\`), or in a callback a built-in calls more than once. In those programs a holder's value does not change because a function given while the body runs throws (S4.12), and data given there is frozen (S4.6), so the write throws. Finish every write before the point. A memoised function's call is not such a point, since a call whose arguments reach a function stores nothing (S2.13). A new local declared after the point is no fix: it may be a second name for the same value.`
// %%
md`**S4.12** A function made while a body runs does not leave that body before the body ends. At run time a value written to a state cell (by \`set\`, or what \`update\`'s function returns) and the arguments of an action call are checked before they are frozen. One that reaches, through arrays, records, \`Map\`s, \`Set\`s and \`Error\`s, a function or a promise that no finished cell has published throws a \`TypeError\`, and nothing is frozen or written. A finished cell has published a function or promise in its value, in a state cell's initial value, or in a value a generator cell yields. So a cell input may be stored: \`current.set(dec)\` for an input \`dec: Action<[]>\`. So may a function the cell made before it returned and that its action captures, since that function was published with the action (S4.6). A function's captures are not read by the check. A promise is not entered: what it settles to is frozen only when it settles, after the body may have written it. This guarantee is a run-time throw, not a check-time rejection: a holder can be given a function through a name the checker does not follow, such as \`const st = s.set\`, \`const { set } = s\`, \`s['set']\`, a record field or a spread. The checker reports the cases it sees as \`[fn-publish]\`: a state's \`set\`, an \`update\` whose arrow returns the value, or an action call, given at a parameter whose declared type holds a function, a function literal the calling function makes (inline, in an array, object or conditional expression, or a \`const\` of that function bound to one). A parameter type that hides a function by width, such as \`{ readonly n: number }\`, is not reported, and the throw still applies. A memoised call's arguments are not checked: a call whose arguments reach a function stores nothing (S2.13). A generator's yields are S5.6's and S5.7's, and a cell's return ends its body. Since 2026-11-23.`
// %%
md`The cells of this section. \`s4_blur\` writes a box blur into a local buffer; \`s4_counts\` writes a local map through a helper that is only called (S4.5); \`s4_record\` deletes an optional member from a local object.`
// %%
//ss: ./spec-4.ts
// %%
