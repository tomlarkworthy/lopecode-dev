md`# SoundScript, section 7: running cells on other threads

The cells of section 7 of \`@tomlarkworthy/soundscript-tutorial\`, as live SoundScript cells, in a module of their own because their names are used by other sections. \`inPool\` and \`onMain\` call \`compile\`, which reads this module's cells, so the module defines \`ss_compile\`; \`pool\` is the core's \`ss_pool\`.`
// %%
//ss: 07-workers.tsx
// %%
picture = {
  const canvas = this ?? document.createElement("canvas");
  canvas.width = width;
  canvas.height = height;
  canvas.style.maxWidth = "100%";
  const data = new ImageData(width, height);
  data.data.set(image);
  canvas.getContext("2d").putImageData(data, 0, 0);
  return canvas;
}
// %%
ss_compile = ss.compiler(() => ss_source(workers_module))
// %%
viewof workers_module = thisModule()
// %%
import { ss, ss_pool, ss_source } from "@tomlarkworthy/soundscript"
// %%
import { thisModule } from "@tomlarkworthy/runtime-sdk"
