md`# SoundScript, section 7: running cells on other threads

The cells of section 7 of \`@tomlarkworthy/soundscript-tutorial\`, as live SoundScript cells, in a module of their own because their names are used by other sections. \`inPool\` and \`onMain\` call \`compile\`, which reads this module's cells, so the module defines \`ss_compile\`; \`pool\` is \`ss_pool\`, imported from the add-on \`@tomlarkworthy/soundscript-workers\`.`
// %%
//ss: 07-workers.tsx
// %%
picture = {
  // the picture drawn from image, with clicks (a transparent canvas) on it to take the clicks
  const box = this ?? htl.html`<div style="position: relative; width: fit-content; max-width: 100%"><canvas style="display: block; max-width: 100%; height: auto"></canvas></div>`;
  const canvas = box.firstChild;
  canvas.width = width;
  canvas.height = height;
  const data = new ImageData(width, height);
  data.data.set(image);
  canvas.getContext("2d").putImageData(data, 0, 0);
  const layer = soundscript.mount(clicks, box.children[1] ?? null);
  if (box.children[1] !== layer) box.replaceChildren(canvas, layer);
  return box;
}
// %%
ss_compile = soundscript.compiler(() => ss_source(workers_module))
// %%
viewof workers_module = thisModule()
// %%
import { soundscript, ss_source } from "@tomlarkworthy/soundscript"
// %%
import { ss_pool } from "@tomlarkworthy/soundscript-workers"
// %%
import { thisModule } from "@tomlarkworthy/runtime-sdk"
