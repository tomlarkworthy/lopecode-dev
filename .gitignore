# Extracted/disassembled notebook data (regenerated from source notebooks)
.lope-extracted/
/notebooks/

# Python
__pycache__/
*.py[cod]
*$py.class

# OS
.DS_Store
Thumbs.db

# Node
node_modules/
package-lock.json
tools/node_modules/

# Debug artifacts
tools/*.png
tools/*.json
tools/*.env
tools/**/.env
tools/tmp-export/
tools/robocoop-4/eval/live/results/
# ...but the static preflight baseline is the corpus gate's reference point, not an
# artifact: without it committed, `--baseline` has nothing to compare against.
!tools/preflight-baseline.json

# Bulk export / smoke test artifacts
candidate-*
export_spec.json

# Screen recordings
*.mov

# Staging directories
tools/staging/
tools/screenshots/

# Channel server runtime files (the server itself now lives in ../lopecode-plugin)
tools/channel/.lopecode-port

# RISC-V build tree (kernel sources, tarballs, binaries)
tools/scratch/riscv/*

# File-sync workspace (per-notebook synced cell sources)
test-sync/

# Claude Code runtime locks
.claude/scheduled_tasks.lock

# robocoop-4 eval transcripts / sweep results (hold full conversations; key-prone — keep untracked)
tools/robocoop-4/eval/live/results/
scratch/blogs/**/data/*sweep*.json

# lope-sync working state: which modules are checked out and at what base sha.
# Per-developer session state, not a repo fact — committing it would recreate the
# stale-metadata problem the tool exists to solve. modules/canonical.json IS committed.
modules/.sync.json

# Module working copies: extracted on demand by `lope-sync.ts checkout` from the
# notebook declared in modules/canonical.json. Reproducible, so not committed —
# a tracked copy is what silently went stale before (190 frozen snapshots, e6a8bc5).
# Files already tracked are unaffected: the ones left are `prune`-flagged as
# UNIQUE (in-flight work not yet in any notebook) and stay versioned until pushed.
modules/**/*.js

# Preflight run artifacts: the boot baseline takes ~60min to regenerate and is
# obsolete after any corpus-wide change; the triage report is a transcript of one
# run against ObservableHQ. Only the static baseline above is worth versioning.
tools/preflight-boot.log
tools/minority-triage.txt

# Zig toolchain fetched for the WASM spike (45MB, reproducible from ziglang.org)
scratch/zigtc/
# spike build artefacts + the 20MB captured-input corpus (regenerate with
# capture-involution.ts / zigc.ts)
scratch/rmbt/involution-cases.json
scratch/rmbt/detectrow-cases.json
scratch/rmbt/involution-llvm-Debug.wasm
scratch/rmbt/*.wasm.o
scratch/binaryen/
scratch/as/
scratch/rmbt/caseimgs/
scratch/rmbt/clt.js
scratch/rmbt/clt2.js
tools/usb-probe
scratch/rmbt/calshots/*.gray
tools/.venv-unity/
